+class MoveContractTests(unittest.TestCase):
+    def offer(self):
+        return {
+            "schema": "podconnect.room_output_move_offer.v1",
+            "offer_id": "a" * 32,
+            "binding_id": "b" * 64,
+            "native_incarnation": "c" * 32,
+            "policy_revision": "d" * 64,
+            "session_volume_percent": 27,
+            "expires_after_ms": 5000,
+        }
