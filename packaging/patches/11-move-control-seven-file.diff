+    def move_result(self, suffix, state):
+        complete = state == "complete"
+        return {
+            "schema": "podconnect.room_move_" + suffix + ".v1",
+            "ok": complete,
+            "offer_id": self.move_offer_id,
+            "binding_id": "b" * 64,
+            "state": state,
+            "accepted_room_move": complete,
+            "move_operation_id": self.move_offer_id,
