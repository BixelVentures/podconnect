+                },
+                "native": self.native(),
+                "route": self.route(),
+                "action": "resume",
+                "volume_percent": 0,
+            },
+        )
+        self.assertEqual(self.room_posts[1][1], {"prepare_id": "a" * 32})
+        self.assertEqual(self._writes(), [])
+        self.assertEqual((self.native_prepares, self.native_commits), (0, 0))
