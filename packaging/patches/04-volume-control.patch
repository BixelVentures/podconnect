+            "target_id": "spotify-one",
+            "room_id": "room-alpha",
+            "homepod_id": "123",
+            **overrides,
+        }
+        return await self.hass.services.async_call(
+            "podconnect",
+            "get_room_volume_controls",
+            body,
+            blocking=True,
+            return_response=True,
