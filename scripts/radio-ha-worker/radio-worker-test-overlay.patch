@@ -0,0 +1,101 @@
+//go:build linux
+
+package main
+
+// Additional actual-worker fault paths. Only synthetic in-process provider and
+// loopback receiver edges are inert; sender death, pidfd and journals are real.
+import (
+	"context"
+	"encoding/json"
+	"os"
+	"path/filepath"
+	"syscall"
+	"testing"
+	"time"
+)
+
+func radioWorkerWriteFaultResult(t *testing.T, root, kind string, state radioState) {
+	t.Helper()
+	raw, _ := json.Marshal(map[string]any{"scenario": kind, "observed": state, "physical_verified": false})
+	if err := os.WriteFile(filepath.Join(root, "manager-chain-result.json"), raw, 0600); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func radioWorkerUnavailableRuntime(t *testing.T, ctx context.Context, opts radioProducerBootstrapOptions, native *radioProducerNativeClient, root string) bool {
+	if os.Getenv("PC_RADIO_CHAIN_UNAVAILABLE") != "1" {
+		return false
+	}
+	t.Helper()
+	_, err := native.Evidence(ctx)
+	if err != nil {
+		t.Fatal(err)
+	}
+	native.mu.Lock()
+	beforeProcess, beforeRevision := native.state.ProcessID, native.state.Revision
+	native.mu.Unlock()
+	if _, err = prepareConfiguredRadioProducer(ctx, opts, native); err == nil {
+		t.Fatal("unavailable worker unexpectedly admitted")
+	}
+	_, err = native.Evidence(ctx)
+	if err != nil {
+		t.Fatal(err)
+	}
+	native.mu.Lock()
+	afterProcess, afterRevision := native.state.ProcessID, native.state.Revision
+	native.mu.Unlock()
+	if beforeProcess != afterProcess || beforeRevision != afterRevision {
+		t.Fatal("unavailable radio changed actual Native owner/revision")
+	}
+	// No effectful radio command was issued. The unchanged actual Native owner and
+	// intent revision distinguish refusal from a hidden pause/restart/retry.
+	radioWorkerWriteFaultResult(t, root, "unavailable-zero-effects", radioState{State: "unavailable"})
+	t.Log("VERIFIED actual helper-unavailable bootstrap refuses radio before any Native owner/intent mutation; existing Spotify owner remains unchanged")
+	return true
+}
+
+func radioWorkerUnknownRuntime(t *testing.T, ctx context.Context, producer *radioProducer, native *radioProducerNativeClient, sender *radioSender, read func() radioState, root string, playing radioState) bool {
+	if os.Getenv("PC_RADIO_CHAIN_UNKNOWN") != "1" {
+		return false
+	}
+	t.Helper()
+	pid := sender.cmd.Process.Pid
+	if err := syscall.Kill(pid, syscall.SIGKILL); err != nil {
+		t.Fatal(err)
+	}
+	select {
+	case <-sender.done:
+	case <-time.After(3 * time.Second):
+		t.Fatal("killed worker not joined")
+	}
+	if sender.productionEvidence(pid) == nil {
+		t.Fatal("dead worker retained production authority")
+	}
+	unknown := read()
+	if unknown.State != "unknown" {
+		t.Fatalf("dead observed source was not UNKNOWN: %+v", unknown)
+	}
+	restored, err := newRadioProducer(native, producer.sender, producer.journal.directory, false)
+	if err != nil {
+		t.Fatal(err)
+	}
+	restored.runtimeReadinessOnly = true
+	if _, _, err = restored.Ready(ctx); err == nil || restored.active != "" || len(restored.retained) != 0 {
+		t.Fatal("restart adopted UNKNOWN custody")
+	}
+	for i := 0; i < 3; i++ {
+		after := read()
+		if after.State != "unknown" {
+			t.Fatal("passive read recovered dead source without new authority")
+		}
+	}
+	if sender.cmd.Process.Pid != pid {
+		t.Fatal("passive UNKNOWN automatically launched new worker")
+	}
+	if playing.PhysicalVerified || unknown.PhysicalVerified {
+		t.Fatal("inert fault acquired physical acceptance")
+	}
+	radioWorkerWriteFaultResult(t, root, "actual-worker-death-unknown-no-replay", unknown)
+	t.Log("VERIFIED actual sender SIGKILL -> joined dead pidfd -> UNKNOWN; restored manager remains blocked; passive reads do not replay or launch")
+	return true
+}
