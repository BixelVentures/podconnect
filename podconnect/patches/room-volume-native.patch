--- /dev/null
+++ b/daemon/room_volume_http.go
@@ -0,0 +1,390 @@
+package daemon
+
+import (
+	"context"
+	"encoding/json"
+	"io"
+	"net/http"
+	"strconv"
+	"strings"
+	"time"
+)
+
+type roomVolumeIDRequest struct {
+	NativePrepareID string `json:"native_prepare_id"`
+}
+type roomVolumeCPrepareRequest struct {
+	NativePrepareID         string          `json:"native_prepare_id"`
+	ArgsDigest              string          `json:"args_digest"`
+	Percent                 int             `json:"percent"`
+	ExpectedInputPathDigest string          `json:"expected_input_path_digest"`
+	ExpectedIdentity        roomVolumeRoute `json:"expected_identity"`
+	ExpectedVolumeState     roomVolumeState `json:"expected_volume_state"`
+}
+type roomVolumeCCommitRequest struct {
+	Token                   string `json:"token"`
+	NativePrepareID         string `json:"native_prepare_id"`
+	NativeReservationID     string `json:"native_reservation_id"`
+	ArgsDigest              string `json:"args_digest"`
+	Percent                 int    `json:"percent"`
+	ExpectedInputPathDigest string `json:"expected_input_path_digest"`
+}
+type roomVolumeCCancelRequest struct {
+	Token               string `json:"token"`
+	NativeReservationID string `json:"native_reservation_id"`
+}
+
+func (op *roomVolumeOperation) endpoint(suffix string) string {
+	return strings.TrimSuffix(op.OwnToneURL, "/") + "/api/outputs/" + op.Binding.Scope.HomePodID + "/volume/" + suffix
+}
+func (op *roomVolumeOperation) prepareResponse() roomVolumePrepareResponse {
+	return roomVolumePrepareResponse{"podconnect.native_room_volume_prepare.v1", op.ID, 5000, op.Binding.Scope, op.Binding.Native, op.Binding.Route, op.Binding.VolumeState, "volume", op.Binding.VolumePercent, false}
+}
+func (op *roomVolumeOperation) prepareOwner(ctx context.Context) error {
+	request := roomVolumeCPrepareRequest{op.ID, op.ArgsDigest, op.Binding.VolumePercent, op.InputDigest, op.Binding.Route, op.Binding.VolumeState}
+	var ack roomVolumePrepareACK
+	if err := roomVolumeHTTP(ctx, http.MethodPost, op.endpoint("prepare"), request, &ack); err != nil {
+		return err
+	}
+	if ack.Schema != "podconnect.output_room_volume_prepare.v1" || !ack.OK || !volumeHex32.MatchString(ack.Token) || ack.NativePrepareID != op.ID || ack.ArgsDigest != op.ArgsDigest || ack.Percent != op.Binding.VolumePercent || ack.Identity != op.Binding.Route || ack.VolumeState != op.Binding.VolumeState || ack.ExpiresAfterMS != 1000 || ack.Physical {
+		return ErrAliasConflict
+	}
+	op.mu.Lock()
+	defer op.mu.Unlock()
+	if op.Cancelled {
+		return ErrAliasConflict
+	}
+	op.CPrepare = &ack
+	op.PreparedSeenAt = time.Now()
+	return nil
+}
+func (op *roomVolumeOperation) validOwnerReceipt(ack roomVolumeOwnerReceipt, suffix string) bool {
+	op.mu.Lock()
+	prepared := op.CPrepare
+	reservation := op.ReservationID
+	op.mu.Unlock()
+	if prepared == nil || ack.Schema != "podconnect.output_room_volume_"+suffix+".v1" || !ack.OK || ack.Token != prepared.Token || ack.NativePrepareID != op.ID || ack.NativeReservationID != reservation || ack.ArgsDigest != op.ArgsDigest || ack.Percent != op.Binding.VolumePercent || ack.Identity != op.Binding.Route || !ack.VolumeState.valid() || ack.Physical || ack.PinRemainingMS < 0 || ack.PinRemainingMS > 10000 {
+		return false
+	}
+	switch ack.Outcome {
+	case "prepared", "pending", "admitted_pending", "protocol_accepted", "rejected_before_admission", "expired_before_admission", "cancelled_before_admission", "unknown":
+	default:
+		return false
+	}
+	if ack.PossibleEffect {
+		switch ack.Outcome {
+		case "prepared", "pending", "rejected_before_admission", "expired_before_admission", "cancelled_before_admission":
+			return false
+		}
+	}
+	if ack.PossibleEffect && ack.Outcome == "unknown" && ack.VolumeState == op.Binding.VolumeState {
+		return true
+	}
+	if !ack.PossibleEffect {
+		return ack.VolumeState == op.Binding.VolumeState && ack.Outcome != "protocol_accepted" && ack.Outcome != "admitted_pending"
+	}
+	before := op.Binding.VolumeState
+	after := ack.VolumeState
+	revision, err := strconv.ParseUint(before.BaseRevision, 10, 64)
+	if err != nil || revision == ^uint64(0) || after.BaseRevision != strconv.FormatUint(revision+1, 10) || after.AttentionRevision != before.AttentionRevision || after.BasePercent != op.Binding.VolumePercent {
+		return false
+	}
+	if before.EffectivePercent < before.BasePercent {
+		return after.EffectivePercent == min(op.Binding.VolumePercent, before.EffectivePercent)
+	}
+	return after.EffectivePercent >= min(op.Binding.VolumePercent, before.BasePercent) && after.EffectivePercent <= op.Binding.VolumePercent
+}
+func (op *roomVolumeOperation) recordOwnerReceipt(ack roomVolumeOwnerReceipt) roomVolumeReceipt {
+	op.mu.Lock()
+	defer op.mu.Unlock()
+	terminal := false
+	switch ack.Outcome {
+	case "protocol_accepted", "rejected_before_admission", "expired_before_admission", "cancelled_before_admission", "unknown":
+		terminal = ack.ContextsDrained
+	}
+	accepted := ack.Outcome == "protocol_accepted" && ack.PossibleEffect && terminal
+	state := ack.Outcome
+	if ack.Outcome == "protocol_accepted" && !accepted {
+		state = "unknown"
+	}
+	receipt := roomVolumeReceipt{NativePrepareID: op.ID, State: state, ReservationAccepted: op.ReservationID != "", OK: accepted, ProtocolAccepted: accepted, PossibleEffect: ack.PossibleEffect, Terminal: terminal, DeadlineRetired: ack.DeadlineRetired, ContextsDrained: ack.ContextsDrained}
+	// A terminal owner receipt is never relabelled by an older pending response.
+	if op.Latest.Terminal {
+		return op.Latest
+	}
+	op.Latest = receipt
+	return receipt
+}
+func (op *roomVolumeOperation) noCommitFailure(cancelled bool) roomVolumeReceipt {
+	op.mu.Lock()
+	defer op.mu.Unlock()
+	if op.Latest.Terminal {
+		return op.Latest
+	}
+	if op.Cancelled {
+		cancelled = true
+	}
+	if op.CommitDispatched {
+		op.Latest = nativeVolumeUnknown(op.ID, op.ReservationID != "")
+		return op.Latest
+	}
+	op.Cancelled = true
+	state := "rejected_before_admission"
+	if cancelled {
+		state = "cancelled_before_admission"
+	}
+	op.Latest = roomVolumeReceipt{NativePrepareID: op.ID, State: state, ReservationAccepted: op.ReservationID != "", Terminal: true, ContextsDrained: true}
+	return op.Latest
+}
+func (op *roomVolumeOperation) freezeCommit(receipt roomVolumeReceipt) roomVolumeReceipt {
+	op.mu.Lock()
+	defer op.mu.Unlock()
+	if op.CommitReceipt == nil {
+		copy := receipt
+		op.CommitReceipt = &copy
+	}
+	return *op.CommitReceipt
+}
+func (op *roomVolumeOperation) cancelAtOwner() {
+	op.mu.Lock()
+	op.Cancelled = true
+	if op.ReservationID == "" || op.CPrepare == nil {
+		if !op.CommitDispatched && !op.Latest.Terminal {
+			op.Latest = roomVolumeReceipt{NativePrepareID: op.ID, State: "cancelled_before_admission", Terminal: true, ContextsDrained: true}
+		}
+		op.mu.Unlock()
+		return
+	}
+	if op.CancelDispatched {
+		op.mu.Unlock()
+		return
+	}
+	op.CancelDispatched = true
+	payload := roomVolumeCCancelRequest{op.CPrepare.Token, op.ReservationID}
+	op.mu.Unlock()
+	ctx, cancel := context.WithTimeout(context.Background(), time.Second)
+	defer cancel()
+	var ack roomVolumeOwnerReceipt
+	if roomVolumeHTTP(ctx, http.MethodPost, op.endpoint("cancel"), payload, &ack) == nil && op.validOwnerReceipt(ack, "cancel") {
+		op.recordOwnerReceipt(ack)
+	}
+}
+func (op *roomVolumeOperation) commitOwner(ctx context.Context) roomVolumeReceipt {
+	op.mu.Lock()
+	if op.Cancelled {
+		op.mu.Unlock()
+		op.cancelAtOwner()
+		return op.receipt("")
+	}
+	if op.CPrepare == nil || op.ReservationID == "" {
+		op.mu.Unlock()
+		return op.noCommitFailure(false)
+	}
+	payload := roomVolumeCCommitRequest{op.CPrepare.Token, op.ID, op.ReservationID, op.ArgsDigest, op.Binding.VolumePercent, op.InputDigest}
+	op.CommitDispatched = true
+	op.Latest = nativeVolumeUnknown(op.ID, true)
+	op.mu.Unlock()
+	var ack roomVolumeOwnerReceipt
+	if err := roomVolumeHTTP(ctx, http.MethodPost, op.endpoint("commit"), payload, &ack); err != nil || !op.validOwnerReceipt(ack, "commit") {
+		return op.receipt("")
+	}
+	receipt := op.recordOwnerReceipt(ack)
+	// Read-only completion polling is bounded and cannot renew the C1s window.
+	until := time.Now().Add(1200 * time.Millisecond)
+	for !receipt.Terminal && ctx.Err() == nil && time.Now().Before(until) {
+		timer := time.NewTimer(75 * time.Millisecond)
+		select {
+		case <-timer.C:
+		case <-ctx.Done():
+			timer.Stop()
+			return op.receipt("")
+		}
+		receipt = op.resultOwner(ctx)
+	}
+	return receipt
+}
+func (op *roomVolumeOperation) resultOwner(ctx context.Context) roomVolumeReceipt {
+	op.mu.Lock()
+	prepared := op.CPrepare
+	reservation := op.ReservationID
+	dispatched := op.CommitDispatched
+	op.mu.Unlock()
+	if prepared == nil || reservation == "" || !dispatched {
+		return op.receipt("")
+	}
+	var ack roomVolumeOwnerReceipt
+	if roomVolumeHTTP(ctx, http.MethodGet, op.endpoint("result/"+prepared.Token), nil, &ack) != nil || !op.validOwnerReceipt(ack, "result") {
+		return op.receipt("")
+	}
+	return op.recordOwnerReceipt(ack)
+}
+func volumeHTTPBody(w http.ResponseWriter, r *http.Request, out any) bool {
+	if r.Method != http.MethodPost {
+		w.WriteHeader(405)
+		return false
+	}
+	if r.URL.RawQuery != "" {
+		w.WriteHeader(400)
+		return false
+	}
+	defer r.Body.Close()
+	raw, err := io.ReadAll(io.LimitReader(r.Body, 8193))
+	if err != nil || len(raw) > 8192 || strictVolumeJSON(raw, out) != nil {
+		w.WriteHeader(400)
+		return false
+	}
+	return true
+}
+func volumeWrite(w http.ResponseWriter, receipt roomVolumeReceipt, suffix string) {
+	receipt.Schema = "podconnect.native_room_volume_" + suffix + ".v1"
+	w.Header().Set("Content-Type", "application/json")
+	w.Header().Set("Cache-Control", "no-store")
+	_ = json.NewEncoder(w).Encode(receipt)
+}
+func (s *ConcreteApiServer) handleRoomVolumeState(w http.ResponseWriter, r *http.Request) {
+	if r.Method != http.MethodGet {
+		w.WriteHeader(405)
+		return
+	}
+	q := r.URL.Query()
+	if len(q) != 4 {
+		w.WriteHeader(400)
+		return
+	}
+	for _, key := range []string{"account_user_id", "target_id", "room_id", "homepod_id"} {
+		if len(q[key]) != 1 || q.Get(key) == "" || len(q.Get(key)) > 160 {
+			w.WriteHeader(400)
+			return
+		}
+	}
+	ctx, cancel := context.WithTimeout(r.Context(), 2*time.Second)
+	defer cancel()
+	data, err := s.roomTransportAsk(ctx, apiRoomVolumeState, roomTransportStateRequest{q.Get("account_user_id"), q.Get("target_id"), q.Get("room_id"), q.Get("homepod_id"), ctx})
+	roomTransportResponse(w, data, err)
+}
+func (s *ConcreteApiServer) handleRoomVolumePrepare(w http.ResponseWriter, r *http.Request) {
+	var binding roomVolumeBinding
+	if !volumeHTTPBody(w, r, &binding) {
+		return
+	}
+	if !binding.valid() {
+		w.WriteHeader(400)
+		return
+	}
+	ctx, cancel := context.WithTimeout(r.Context(), 2*time.Second)
+	defer cancel()
+	value, err := s.roomTransportAsk(ctx, apiRoomVolumePrepare, roomVolumePrepareActorRequest{binding, ctx})
+	if err != nil {
+		roomTransportResponse(w, nil, err)
+		return
+	}
+	op, ok := value.(*roomVolumeOperation)
+	if !ok || op == nil || !s.roomVolumes.put(op) {
+		roomTransportResponse(w, nil, ErrAliasConflict)
+		return
+	}
+	response := op.prepareResponse()
+	remaining := time.Until(op.Expires).Milliseconds()
+	if remaining < 1 {
+		roomTransportResponse(w, nil, ErrAliasConflict)
+		return
+	}
+	response.ExpiresAfterMS = int(min(remaining, 5000))
+	roomTransportResponse(w, response, nil)
+}
+func (s *ConcreteApiServer) handleRoomVolumeCommit(w http.ResponseWriter, r *http.Request) {
+	var request roomVolumeIDRequest
+	if !volumeHTTPBody(w, r, &request) {
+		return
+	}
+	if !volumeHex32.MatchString(request.NativePrepareID) {
+		w.WriteHeader(400)
+		return
+	}
+	op := s.roomVolumes.get(request.NativePrepareID)
+	if op == nil {
+		volumeWrite(w, nativeVolumeUnknown(request.NativePrepareID, false), "commit")
+		return
+	}
+	op.mu.Lock()
+	if op.Claimed {
+		receipt := op.Latest
+		if op.CommitReceipt != nil {
+			receipt = *op.CommitReceipt
+		}
+		op.mu.Unlock()
+		volumeWrite(w, receipt, "commit")
+		return
+	}
+	op.mu.Unlock()
+	ctx, cancel := context.WithTimeout(r.Context(), 4*time.Second)
+	defer cancel()
+	_, err := s.roomTransportAsk(ctx, apiRoomVolumeClaim, roomVolumeActorRequest{op, ctx})
+	if err != nil {
+		op.mu.Lock()
+		claimed := op.Claimed
+		receipt := op.Latest
+		if op.CommitReceipt != nil {
+			receipt = *op.CommitReceipt
+		}
+		op.mu.Unlock()
+		if claimed {
+			volumeWrite(w, receipt, "commit")
+		} else {
+			volumeWrite(w, op.freezeCommit(op.noCommitFailure(ctx.Err() != nil)), "commit")
+		}
+		return
+	}
+	defer func() {
+		if ctx.Err() != nil {
+			go op.cancelAtOwner()
+		}
+	}()
+	if op.prepareOwner(ctx) != nil {
+		volumeWrite(w, op.freezeCommit(op.noCommitFailure(ctx.Err() != nil)), "commit")
+		return
+	}
+	_, err = s.roomTransportAsk(ctx, apiRoomVolumeConsume, roomVolumeActorRequest{op, ctx})
+	if err != nil {
+		volumeWrite(w, op.freezeCommit(op.noCommitFailure(ctx.Err() != nil)), "commit")
+		return
+	}
+	receipt := op.commitOwner(ctx)
+	volumeWrite(w, op.freezeCommit(receipt), "commit")
+}
+func (s *ConcreteApiServer) handleRoomVolumeCancel(w http.ResponseWriter, r *http.Request) {
+	var request roomVolumeIDRequest
+	if !volumeHTTPBody(w, r, &request) {
+		return
+	}
+	if !volumeHex32.MatchString(request.NativePrepareID) {
+		w.WriteHeader(400)
+		return
+	}
+	op := s.roomVolumes.get(request.NativePrepareID)
+	if op == nil {
+		volumeWrite(w, nativeVolumeUnknown(request.NativePrepareID, false), "cancel")
+		return
+	}
+	op.cancelAtOwner()
+	volumeWrite(w, op.receipt(""), "cancel")
+}
+func (s *ConcreteApiServer) handleRoomVolumeResult(w http.ResponseWriter, r *http.Request) {
+	if r.Method != http.MethodGet {
+		w.WriteHeader(405)
+		return
+	}
+	q := r.URL.Query()
+	if len(q) != 1 || len(q["native_prepare_id"]) != 1 || !volumeHex32.MatchString(q.Get("native_prepare_id")) {
+		w.WriteHeader(400)
+		return
+	}
+	op := s.roomVolumes.get(q.Get("native_prepare_id"))
+	if op == nil {
+		volumeWrite(w, nativeVolumeUnknown(q.Get("native_prepare_id"), false), "result")
+		return
+	}
+	ctx, cancel := context.WithTimeout(r.Context(), time.Second)
+	defer cancel()
+	volumeWrite(w, op.resultOwner(ctx), "result")
+}
