+package daemon
+
+import (
+	"bytes"
+	"context"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"io"
+	"net/http"
+	"regexp"
+	"strconv"
+	"sync"
+	"time"
+)
+
+const (
+	apiRoomVolumeState            ApiRequestType = "room_volume_state"
+	apiRoomVolumePrepare          ApiRequestType = "room_volume_prepare"
+	apiRoomVolumeClaim            ApiRequestType = "room_volume_claim"
+	apiRoomVolumeConsume          ApiRequestType = "room_volume_consume"
+	roomVolumeReservationLifetime                = 3 * time.Second
+	roomVolumeOfferLifetime                      = 5 * time.Second
+	roomVolumeStoreLimit                         = 128
+)
+
+var volumeHex32 = regexp.MustCompile(`^[a-f0-9]{32}$`)
+var volumeHex64 = regexp.MustCompile(`^[a-f0-9]{64}$`)
+var volumeUUID = regexp.MustCompile(`^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$`)
+var volumeDecimal = regexp.MustCompile(`^(0|[1-9][0-9]*)$`)
+
+type roomVolumeScope struct {
+	AccountUserID string `json:"account_user_id"`
+	TargetID      string `json:"target_id"`
+	RoomID        string `json:"room_id"`
+	HomePodID     string `json:"homepod_id"`
+}
+type roomVolumeRoute struct {
+	Process           string `json:"process"`
+	DeviceID          string `json:"device_id"`
+	DeviceIncarnation string `json:"device_incarnation"`
+	SessionEpoch      string `json:"session_epoch"`
+	RouteRevision     string `json:"route_revision"`
+	SelectionRevision string `json:"selection_revision"`
+	InputGeneration   string `json:"input_generation"`
+	InputItemID       string `json:"input_item_id"`
+	InputPathDigest   string `json:"input_path_digest"`
+}
+type roomVolumeState struct {
+	BaseRevision      string `json:"base_revision"`
+	AttentionRevision string `json:"attention_revision"`
+	BasePercent       int    `json:"base_percent"`
+	EffectivePercent  int    `json:"effective_percent"`
+}
+type roomVolumeBinding struct {
+	Scope         roomVolumeScope       `json:"scope"`
+	Native        roomTransportIdentity `json:"native"`
+	Route         roomVolumeRoute       `json:"route"`
+	VolumeState   roomVolumeState       `json:"volume_state"`
+	Action        string                `json:"action"`
+	VolumePercent int                   `json:"volume_percent"`
+}
+type roomVolumePrepareResponse struct {
+	Schema          string                `json:"schema"`
+	NativePrepareID string                `json:"native_prepare_id"`
+	ExpiresAfterMS  int                   `json:"expires_after_ms"`
+	Scope           roomVolumeScope       `json:"scope"`
+	Native          roomTransportIdentity `json:"native"`
+	Route           roomVolumeRoute       `json:"route"`
+	VolumeState     roomVolumeState       `json:"volume_state"`
+	Action          string                `json:"action"`
+	VolumePercent   int                   `json:"volume_percent"`
+	Physical        bool                  `json:"physical_result_verified"`
+}
+type roomVolumeReceipt struct {
+	Schema              string `json:"schema"`
+	NativePrepareID     string `json:"native_prepare_id"`
+	OK                  bool   `json:"ok"`
+	State               string `json:"state"`
+	ReservationAccepted bool   `json:"reservation_accepted"`
+	ProtocolAccepted    bool   `json:"protocol_accepted"`
+	PossibleEffect      bool   `json:"possible_effect"`
+	Terminal            bool   `json:"terminal"`
+	DeadlineRetired     bool   `json:"deadline_retired"`
+	ContextsDrained     bool   `json:"contexts_drained"`
+	RetryAllowed        bool   `json:"retry_allowed"`
+	Physical            bool   `json:"physical_result_verified"`
+}
+type roomVolumePrepareACK struct {
+	Schema          string          `json:"schema"`
+	OK              bool            `json:"ok"`
+	Token           string          `json:"token"`
+	NativePrepareID string          `json:"native_prepare_id"`
+	ArgsDigest      string          `json:"args_digest"`
+	Percent         int             `json:"percent"`
+	Identity        roomVolumeRoute `json:"identity"`
+	VolumeState     roomVolumeState `json:"volume_state"`
+	ExpiresAfterMS  int             `json:"expires_after_ms"`
+	Physical        bool            `json:"physical_result_verified"`
+}
+type roomVolumeOwnerReceipt struct {
+	Schema              string          `json:"schema"`
+	OK                  bool            `json:"ok"`
+	Token               string          `json:"token"`
+	NativePrepareID     string          `json:"native_prepare_id"`
+	NativeReservationID string          `json:"native_reservation_id"`
+	ArgsDigest          string          `json:"args_digest"`
+	Percent             int             `json:"percent"`
+	Identity            roomVolumeRoute `json:"identity"`
+	VolumeState         roomVolumeState `json:"volume_state"`
+	Outcome             string          `json:"outcome"`
+	PossibleEffect      bool            `json:"possible_effect"`
+	DeadlineRetired     bool            `json:"deadline_retired"`
+	ContextsDrained     bool            `json:"contexts_drained"`
+	Physical            bool            `json:"physical_result_verified"`
+	PinRemainingMS      int             `json:"pin_remaining_ms"`
+}
+type roomVolumeOperation struct {
+	mu               sync.Mutex
+	Owner            *AppPlayer
+	Binding          roomVolumeBinding
+	Actor            *nativeTransportOffer
+	ID               string
+	ArgsDigest       string
+	OwnToneURL       string
+	InputDigest      string
+	Expires          time.Time
+	RetainUntil      time.Time
+	Claimed          bool
+	Cancelled        bool
+	CPrepare         *roomVolumePrepareACK
+	ReservationID    string
+	ReservationUntil time.Time
+	ReservedAt       time.Time
+	PreparedSeenAt   time.Time
+	CommitDispatched bool
+	CancelDispatched bool
+	CommitReceipt    *roomVolumeReceipt
+	Latest           roomVolumeReceipt
+}
+type nativeRoomVolumeReservation struct {
+	Operation *roomVolumeOperation
+	Until     time.Time
+}
+type roomVolumeActorRequest struct {
+	Operation *roomVolumeOperation
+	Context   context.Context
+}
+type roomVolumePrepareActorRequest struct {
+	Binding roomVolumeBinding
+	Context context.Context
+}
+type roomVolumeStore struct {
+	mu      sync.Mutex
+	records map[string]*roomVolumeOperation
+}
+
+func (store *roomVolumeStore) put(op *roomVolumeOperation) bool {
+	store.mu.Lock()
+	defer store.mu.Unlock()
+	if store.records == nil {
+		store.records = map[string]*roomVolumeOperation{}
+	}
+	for id, old := range store.records {
+		old.mu.Lock()
+		expired := !time.Now().Before(old.RetainUntil)
+		old.mu.Unlock()
+		if expired {
+			delete(store.records, id)
+		}
+	}
+	if len(store.records) >= roomVolumeStoreLimit {
+		return false
+	}
+	store.records[op.ID] = op
+	return true
+}
+func (store *roomVolumeStore) get(id string) *roomVolumeOperation {
+	store.mu.Lock()
+	defer store.mu.Unlock()
+	return store.records[id]
+}
+func volumeCounter(value string) bool {
+	if !volumeDecimal.MatchString(value) {
+		return false
+	}
+	_, err := strconv.ParseUint(value, 10, 64)
+	return err == nil
+}
+func (route roomVolumeRoute) valid() bool {
+	if !volumeUUID.MatchString(route.Process) || !volumeHex64.MatchString(route.InputPathDigest) {
+		return false
+	}
+	for _, v := range []string{route.DeviceID, route.DeviceIncarnation, route.SessionEpoch, route.RouteRevision, route.SelectionRevision, route.InputGeneration, route.InputItemID} {
+		if !volumeCounter(v) {
+			return false
+		}
+	}
+	return route.DeviceID != "0"
+}
+func (state roomVolumeState) valid() bool {
+	return volumeCounter(state.BaseRevision) && volumeCounter(state.AttentionRevision) && state.BasePercent >= 0 && state.BasePercent <= 100 && state.EffectivePercent >= 0 && state.EffectivePercent <= state.BasePercent
+}
+func (binding roomVolumeBinding) valid() bool {
+	scope := binding.Scope
+	native := binding.Native
+	return binding.Action == "volume" && binding.VolumePercent >= 0 && binding.VolumePercent <= 100 && scope.AccountUserID != "" && len(scope.AccountUserID) <= 160 && scope.TargetID != "" && len(scope.TargetID) <= 160 && scope.RoomID != "" && len(scope.RoomID) <= 128 && homePodIDPattern.MatchString(scope.HomePodID) && native.AccountUserID == scope.AccountUserID && native.TargetID == scope.TargetID && native.RoomID == scope.RoomID && native.HomePodID == scope.HomePodID && native.ConnectionID != "" && native.SessionID != "" && volumeHex32.MatchString(native.AliasIncarnation) && volumeHex64.MatchString(native.AliasRegistry) && native.AliasRevision < 1<<53 && binding.Route.valid() && binding.Route.DeviceID == scope.HomePodID && binding.VolumeState.valid()
+}
+func strictVolumeJSON(raw []byte, out any) error {
+	scan := json.NewDecoder(bytes.NewReader(raw))
+	scan.UseNumber()
+	var walk func(int) error
+	walk = func(depth int) error {
+		if depth > 16 {
+			return ErrBadRequest
+		}
+		token, err := scan.Token()
+		if err != nil {
+			return err
+		}
+		if delimiter, ok := token.(json.Delim); ok {
+			switch delimiter {
+			case '{':
+				seen := map[string]bool{}
+				for scan.More() {
+					key, err := scan.Token()
+					name, ok := key.(string)
+					if err != nil || !ok || seen[name] {
+						return ErrBadRequest
+					}
+					seen[name] = true
+					if err := walk(depth + 1); err != nil {
+						return err
+					}
+				}
+				end, err := scan.Token()
+				if err != nil || end != json.Delim('}') {
+					return ErrBadRequest
+				}
+			case '[':
+				for scan.More() {
+					if err := walk(depth + 1); err != nil {
+						return err
+					}
+				}
+				end, err := scan.Token()
+				if err != nil || end != json.Delim(']') {
+					return ErrBadRequest
+				}
+			default:
+				return ErrBadRequest
+			}
+		}
+		return nil
+	}
+	if err := walk(0); err != nil {
+		return err
+	}
+	if scan.Decode(new(any)) != io.EOF {
+		return ErrBadRequest
+	}
+	return decodeQueueJSON(raw, out)
+}
+func (op *roomVolumeOperation) receipt(schema string) roomVolumeReceipt {
+	op.mu.Lock()
+	defer op.mu.Unlock()
+	receipt := op.Latest
+	receipt.Schema = schema
+	receipt.NativePrepareID = op.ID
+	return receipt
+}
+func nativeVolumeUnknown(id string, reserved bool) roomVolumeReceipt {
+	return roomVolumeReceipt{NativePrepareID: id, State: "unknown", ReservationAccepted: reserved, PossibleEffect: true}
+}
+func (p *AppPlayer) roomVolumeReservedLocked() bool {
+	return p.roomVolumeReservation != nil && time.Now().Before(p.roomVolumeReservation.Until)
+}
+func (p *AppPlayer) roomVolumeBusy() bool {
+	p.aliasMu.Lock()
+	defer p.aliasMu.Unlock()
+	return p.roomVolumeClosing || p.roomVolumeReservedLocked()
+}
+func (p *AppPlayer) prepareRoomVolume(parent context.Context, request roomVolumePrepareActorRequest) (any, error) {
+	ctx, cancel := queueOperationContext(parent, request.Context)
+	defer cancel()
+	binding := request.Binding
+	if !binding.valid() || ctx.Err() != nil || parent.Err() != nil || p.roomVolumeBusy() {
+		return nil, ErrAliasConflict
+	}
+	identity, err := p.roomTransportIdentity(binding.Scope.AccountUserID, binding.Scope.TargetID, binding.Scope.RoomID, binding.Scope.HomePodID)
+	digest := sha256.Sum256([]byte(p.app.cfg.AudioOutputPipe))
+	inputDigest := hex.EncodeToString(digest[:])
+	if err != nil || identity != binding.Native || inputDigest != binding.Route.InputPathDigest {
+		return nil, ErrAliasConflict
+	}
+	id, err := randomQueueID(16)
+	if err != nil {
+		return nil, err
+	}
+	raw, err := json.Marshal(binding)
+	if err != nil {
+		return nil, err
+	}
+	sum := sha256.Sum256(raw)
+	actor := &nativeTransportOffer{Generation: p.roomTransportGeneration, OriginalPlayerState: p.state.player, QueueRevision: p.state.tracks.TransportRevision(), State: p.state, Session: p.sess, Player: p.player, Primary: p.primaryStream, Tracks: p.state.tracks, OwnToneURL: p.app.cfg.RoomTransportOwnToneURL, InputPath: p.app.cfg.AudioOutputPipe, Expires: time.Now().Add(roomVolumeOfferLifetime), Snapshot: roomTransportSnapshot{roomTransportIdentity: identity, PrepareID: id, Action: "volume", VolumePercent: binding.VolumePercent, ArgsDigest: hex.EncodeToString(sum[:])}}
+	op := &roomVolumeOperation{Owner: p, Binding: binding, Actor: actor, ID: id, ArgsDigest: actor.Snapshot.ArgsDigest, OwnToneURL: actor.OwnToneURL, InputDigest: inputDigest, Expires: actor.Expires, RetainUntil: actor.Expires.Add(15 * time.Second), Latest: roomVolumeReceipt{NativePrepareID: id, State: "prepared"}}
+	return op, nil
+}
+func (p *AppPlayer) claimRoomVolume(parent context.Context, request roomVolumeActorRequest) (any, error) {
+	op := request.Operation
+	if op == nil {
+		return nil, ErrAliasConflict
+	}
+	p.aliasMu.Lock()
+	defer p.aliasMu.Unlock()
+	op.mu.Lock()
+	defer op.mu.Unlock()
+	if op.Owner != p || op.Claimed || op.Cancelled || p.roomVolumeClosing || p.roomVolumeReservedLocked() || !p.transportOfferCurrentLocked(op.Actor, parent, request.Context) {
+		return nil, ErrAliasConflict
+	}
+	op.Claimed = true
+	op.Latest.State = "pending_claim"
+	return op, nil
+}
+func (p *AppPlayer) consumeRoomVolume(parent context.Context, request roomVolumeActorRequest) (any, error) {
+	op := request.Operation
+	if op == nil {
+		return nil, ErrAliasConflict
+	}
+	p.aliasMu.Lock()
+	defer p.aliasMu.Unlock()
+	op.mu.Lock()
+	defer op.mu.Unlock()
+	if op.Owner != p || !op.Claimed || op.Cancelled || op.CPrepare == nil || op.ReservationID != "" || p.roomVolumeClosing || p.roomVolumeReservedLocked() || !p.transportOfferCurrentLocked(op.Actor, parent, request.Context) {
+		return nil, ErrAliasConflict
+	}
+	id, err := randomQueueID(16)
+	if err != nil {
+		return nil, err
+	}
+	reservedAt := time.Now()
+	deadline := reservedAt.Add(roomVolumeReservationLifetime)
+	op.ReservedAt = reservedAt
+	op.ReservationID = id
+	op.ReservationUntil = deadline
+	op.RetainUntil = deadline.Add(15 * time.Second)
+	op.Latest = roomVolumeReceipt{NativePrepareID: op.ID, State: "reserved", ReservationAccepted: true}
+	p.roomVolumeReservation = &nativeRoomVolumeReservation{op, deadline}
+	return op, nil
+}
+func (p *AppPlayer) waitRoomVolumeReservation(ctx context.Context) bool {
+	p.aliasMu.Lock()
+	reservation := p.roomVolumeReservation
+	closing := p.roomVolumeClosing
+	p.aliasMu.Unlock()
+	if reservation != nil {
+		remaining := time.Until(reservation.Until)
+		if remaining > 0 {
+			timer := time.NewTimer(remaining)
+			select {
+			case <-timer.C:
+			case <-ctx.Done():
+				go p.Close()
+				<-timer.C
+			}
+			timer.Stop()
+		}
+		p.aliasMu.Lock()
+		if p.roomVolumeReservation == reservation {
+			p.roomVolumeReservation = nil
+		}
+		closing = p.roomVolumeClosing
+		p.aliasMu.Unlock()
+	}
+	if closing || ctx.Err() != nil {
+		return false
+	}
+	return true
+}
+func (p *AppPlayer) retireRoomVolumeOwner() {
+	p.aliasMu.Lock()
+	p.roomVolumeClosing = true
+	reservation := p.roomVolumeReservation
+	p.aliasMu.Unlock()
+	if reservation != nil {
+		reservation.Operation.cancelAtOwner()
+		if remaining := time.Until(reservation.Until); remaining > 0 {
+			timer := time.NewTimer(remaining)
+			<-timer.C
+			timer.Stop()
+		}
+	}
+	p.aliasMu.Lock()
+	p.aliasRetired = true
+	p.aliasMu.Unlock()
+}
+func roomVolumeHTTP(ctx context.Context, method, endpoint string, payload any, out any) error {
+	var body io.Reader
+	if payload != nil {
+		raw, err := json.Marshal(payload)
+		if err != nil {
+			return err
+		}
+		body = bytes.NewReader(raw)
+	}
+	request, err := http.NewRequestWithContext(ctx, method, endpoint, body)
+	if err != nil {
+		return err
+	}
+	if payload != nil {
+		request.Header.Set("Content-Type", "application/json")
+	}
+	client := &http.Client{Timeout: time.Second, CheckRedirect: func(*http.Request, []*http.Request) error { return errors.New("volume owner redirect denied") }}
+	response, err := client.Do(request)
+	if err != nil {
+		return err
+	}
+	defer response.Body.Close()
+	raw, err := io.ReadAll(io.LimitReader(response.Body, 8193))
+	if err != nil || len(raw) > 8192 || response.StatusCode != 200 {
+		return ErrAliasConflict
+	}
+	return strictVolumeJSON(raw, out)
+}
diff --git a/daemon/room_volume_http.go b/daemon/room_volume_http.go
