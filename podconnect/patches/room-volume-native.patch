+package daemon
+
+import (
+	"context"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"sync/atomic"
+	"testing"
+	"time"
+)
+
+// As in audio4: seed a locally admitted actor only; do not impersonate an actual
+// authenticated Spotify session or claim that fixture authority is provider proof.
+func roomVolumeFixture(t *testing.T) (*AppPlayer, *roomVolumeOperation) {
+	p, actor := roomTransportAdmittedFixture(t)
+	digest := sha256.Sum256([]byte(p.app.cfg.AudioOutputPipe))
+	input := hex.EncodeToString(digest[:])
+	scope := roomVolumeScope{"account", "engine", "r0", "101"}
+	route := roomVolumeRoute{"00000000-0000-0000-0000-000000000001", "101", "1", "1", "1", "1", "1", "1", input}
+	binding := roomVolumeBinding{scope, actor.Snapshot.roomTransportIdentity, route, roomVolumeState{"7", "2", 27, 27}, "volume", 45}
+	actor.Snapshot.Action = "volume"
+	actor.Snapshot.VolumePercent = 45
+	op := &roomVolumeOperation{Owner: p, Actor: actor, Binding: binding, ID: actor.Snapshot.PrepareID, ArgsDigest: strings.Repeat("b", 64), OwnToneURL: actor.OwnToneURL, InputDigest: input, Expires: actor.Expires, RetainUntil: time.Now().Add(time.Minute), Latest: roomVolumeReceipt{NativePrepareID: actor.Snapshot.PrepareID, State: "prepared"}}
+	return p, op
+}
+func volumeTestActor(t *testing.T, p *AppPlayer, server *ConcreteApiServer) func() {
+	t.Helper()
+	done := make(chan struct{})
+	go func() {
+		defer close(done)
+		for req := range server.requests {
+			data, err := p.handleApiRequest(context.Background(), req)
+			req.Reply(data, err)
+		}
+	}()
+	return func() { close(server.requests); <-done }
+}
+func volumeOwnerAck(op *roomVolumeOperation, suffix, outcome string, possible bool) roomVolumeOwnerReceipt {
+	op.mu.Lock()
+	defer op.mu.Unlock()
+	state := op.Binding.VolumeState
+	if possible {
+		state.BaseRevision = "8"
+		state.BasePercent = 45
+		state.EffectivePercent = 45
+	}
+	return roomVolumeOwnerReceipt{Schema: "podconnect.output_room_volume_" + suffix + ".v1", OK: true, Token: strings.Repeat("c", 32), NativePrepareID: op.ID, NativeReservationID: op.ReservationID, ArgsDigest: op.ArgsDigest, Percent: 45, Identity: op.Binding.Route, VolumeState: state, Outcome: outcome, PossibleEffect: possible, ContextsDrained: outcome != "pending" && outcome != "admitted_pending", PinRemainingMS: 9000}
+}
+func volumeTestC(t *testing.T, p *AppPlayer, op *roomVolumeOperation, onPrepare func(), ackMutation func(*roomVolumePrepareACK), commits *atomic.Int32) *httptest.Server {
+	t.Helper()
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		switch r.URL.Path {
+		case "/api/outputs/101/volume/prepare":
+			raw := map[string]json.RawMessage{}
+			if json.NewDecoder(r.Body).Decode(&raw) != nil || len(raw) != 6 {
+				t.Error("Cprepare not closed6")
+			}
+			encoded, _ := json.Marshal(raw)
+			var request roomVolumeCPrepareRequest
+			if strictVolumeJSON(encoded, &request) != nil || request.NativePrepareID != op.ID || request.ArgsDigest != op.ArgsDigest || request.Percent != 45 || request.ExpectedInputPathDigest != op.InputDigest || request.ExpectedIdentity != op.Binding.Route || request.ExpectedVolumeState != op.Binding.VolumeState {
+				t.Error("native immutable preparation binding not forwarded")
+			}
+			if onPrepare != nil {
+				onPrepare()
+			}
+			ack := roomVolumePrepareACK{"podconnect.output_room_volume_prepare.v1", true, strings.Repeat("c", 32), op.ID, op.ArgsDigest, 45, op.Binding.Route, op.Binding.VolumeState, 1000, false}
+			if ackMutation != nil {
+				ackMutation(&ack)
+			}
+			_ = json.NewEncoder(w).Encode(ack)
+		case "/api/outputs/101/volume/commit":
+			commits.Add(1)
+			var request roomVolumeCCommitRequest
+			if json.NewDecoder(r.Body).Decode(&request) != nil || request.Token != strings.Repeat("c", 32) || request.NativePrepareID != op.ID || request.NativeReservationID == "" || request.ArgsDigest != op.ArgsDigest || request.Percent != 45 || request.ExpectedInputPathDigest != op.InputDigest {
+				t.Error("Ccommit binding changed")
+			}
+			_ = json.NewEncoder(w).Encode(volumeOwnerAck(op, "commit", "protocol_accepted", true))
+		case "/api/outputs/101/volume/cancel":
+			_ = json.NewEncoder(w).Encode(volumeOwnerAck(op, "cancel", "cancelled_before_admission", false))
+		case "/api/outputs/101/volume/result/" + strings.Repeat("c", 32):
+			_ = json.NewEncoder(w).Encode(volumeOwnerAck(op, "result", "protocol_accepted", true))
+		default:
+			t.Error("unexpected provider/foreign-output request", r.URL.Path)
+			w.WriteHeader(404)
+		}
+	}))
+	op.OwnToneURL = server.URL
+	op.Actor.OwnToneURL = server.URL
+	p.app.cfg.RoomTransportOwnToneURL = server.URL
+	return server
+}
+func volumeCommitRequest(op *roomVolumeOperation) *http.Request {
+	return httptest.NewRequest("POST", "/player/room_volume/commit", strings.NewReader(`{"native_prepare_id":"`+op.ID+`"}`))
+}
+func TestRoomVolumeDirectOwnerPrepareThenConsumeAndOnePhysicalDispatch(t *testing.T) {
+	p, op := roomVolumeFixture(t)
+	var commits atomic.Int32
+	owner := volumeTestC(t, p, op, nil, nil, &commits)
+	defer owner.Close()
+	server := &ConcreteApiServer{requests: make(chan ApiRequest)}
+	if !server.roomVolumes.put(op) {
+		t.Fatal("store")
+	}
+	stop := volumeTestActor(t, p, server)
+	defer stop()
+	out := httptest.NewRecorder()
+	server.handleRoomVolumeCommit(out, volumeCommitRequest(op))
+	var receipt roomVolumeReceipt
+	if strictVolumeJSON(out.Body.Bytes(), &receipt) != nil || !receipt.OK || !receipt.ProtocolAccepted || !receipt.ReservationAccepted || !receipt.PossibleEffect || !receipt.Terminal || !receipt.ContextsDrained || receipt.Physical || receipt.RetryAllowed || commits.Load() != 1 {
+		t.Fatal("matching RTSP protocol receipt not retained", out.Body.String())
+	}
+	if op.ReservationID == "" || p.roomVolumeReservation == nil || op.ReservedAt.Before(op.PreparedSeenAt) || op.ReservationUntil.Sub(op.ReservedAt) != 3*time.Second {
+		t.Fatal("actual native CONSUME did not mint reservation")
+	}
+	// Duplicate is a read of the original immutable commit receipt, never a retry.
+	again := httptest.NewRecorder()
+	server.handleRoomVolumeCommit(again, volumeCommitRequest(op))
+	if again.Body.String() != out.Body.String() || commits.Load() != 1 {
+		t.Fatal("duplicate dispatched or relabelled")
+	}
+}
+func TestRoomVolumePendingClaimAliasABACancelAndMalformedOwnerDenyCommit(t *testing.T) {
+	for _, mode := range []string{"alias-aba", "cancel", "wrong-process", "wrong-pipe", "wrong-volume", "wrong-percent", "wrong-deadline"} {
+		t.Run(mode, func(t *testing.T) {
+			p, op := roomVolumeFixture(t)
+			var commits atomic.Int32
+			server := &ConcreteApiServer{requests: make(chan ApiRequest)}
+			server.roomVolumes.put(op)
+			entered := make(chan struct{})
+			release := make(chan struct{})
+			mutate := func(ack *roomVolumePrepareACK) {
+				switch mode {
+				case "wrong-process":
+					ack.Identity.Process = "00000000-0000-0000-0000-000000000002"
+				case "wrong-pipe":
+					ack.Identity.InputPathDigest = strings.Repeat("d", 64)
+				case "wrong-volume":
+					ack.VolumeState.BaseRevision = "8"
+				case "wrong-percent":
+					ack.Percent = 46
+				case "wrong-deadline":
+					ack.ExpiresAfterMS = 3000
+				}
+			}
+			owner := volumeTestC(t, p, op, func() { close(entered); <-release }, mutate, &commits)
+			defer owner.Close()
+			stop := volumeTestActor(t, p, server)
+			defer stop()
+			out := httptest.NewRecorder()
+			done := make(chan struct{})
+			go func() { defer close(done); server.handleRoomVolumeCommit(out, volumeCommitRequest(op)) }()
+			<-entered
+			if mode == "alias-aba" {
+				for _, room := range []string{"r1", "r0"} {
+					if _, err := p.selectLocalAlias(ApiRequestDataSelectAlias{room, p.aliasIncarnation, p.aliasFingerprint}); err != nil {
+						t.Fatal(err)
+					}
+				}
+			}
+			if mode == "cancel" {
+				cancelOut := httptest.NewRecorder()
+				server.handleRoomVolumeCancel(cancelOut, httptest.NewRequest("POST", "/player/room_volume/cancel", strings.NewReader(`{"native_prepare_id":"`+op.ID+`"}`)))
+			}
+			close(release)
+			<-done
+			if commits.Load() != 0 || p.roomVolumeReservation != nil {
+				t.Fatal("pending native claim became physical authority after invalidation", mode, out.Body.String())
+			}
+		})
+	}
+}
+func TestRoomVolumeDuplicatePendingClaimCannotCancelOrPrepareAgain(t *testing.T) {
+	p, op := roomVolumeFixture(t)
+	var commits atomic.Int32
+	entered := make(chan struct{})
+	release := make(chan struct{})
+	owner := volumeTestC(t, p, op, func() { close(entered); <-release }, nil, &commits)
