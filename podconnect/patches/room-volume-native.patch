+		t.Fatal("pending duplicate caused another or missing effect")
+	}
+}
+func TestRoomVolumeReservationRejectsDirectLegacyAliasAndCloseWaits(t *testing.T) {
+	p, op := roomVolumeFixture(t)
+	// Short fixture deadline tests ordering; production CONSUME fixed3s is tested above.
+	deadline := time.Now().Add(80 * time.Millisecond)
+	p.roomVolumeReservation = &nativeRoomVolumeReservation{op, deadline}
+	op.ReservationUntil = deadline
+	if _, err := p.selectLocalAlias(ApiRequestDataSelectAlias{"r1", p.aliasIncarnation, p.aliasFingerprint}); err == nil {
+		t.Fatal("direct alias mutator bypassed reservation")
+	}
+	if _, err := p.handleApiRequest(context.Background(), ApiRequest{Type: ApiRequestTypeResume}); err == nil {
+		t.Fatal("legacy transport bypassed reservation")
+	}
+	done := make(chan struct{})
+	go func() { p.retireAliases(); close(done) }()
+	for {
+		p.aliasMu.Lock()
+		closing, retired := p.roomVolumeClosing, p.aliasRetired
+		p.aliasMu.Unlock()
+		if closing {
+			if retired {
+				t.Fatal("retirement applied before reserved deadline")
+			}
+			break
+		}
+		time.Sleep(time.Millisecond)
+	}
+	select {
+	case <-done:
+		t.Fatal("Close released owner while reservation active")
+	default:
+	}
+	select {
+	case <-done:
+	case <-time.After(time.Second):
+		t.Fatal("bounded owner retirement did not complete")
+	}
+	if !p.aliasRetired {
+		t.Fatal("retired owner stayed ready")
+	}
+}
