+// Use the ordinary public content offer/prepare/commit handlers with the real
+// actor, guarded C START and existing inert provider decoder fixtures.
+func testPrimaryNewSpotifySelection(t *testing.T, ctx context.Context, p *AppPlayer, worker *player.Player,
+	incumbent *player.Stream, owner roomTransportIdentity, whileStaged func()) {
+	t.Helper()
+	app := p.app
+	app.mpris = mpris.DummyServer{}
+	server := &ConcreteApiServer{log: app.log, requests: make(chan ApiRequest)}
+	app.server = server
+	p.prefetchTimer = time.NewTimer(time.Hour)
+	defer p.prefetchTimer.Stop()
+	done := make(chan struct{})
+	go func() {
+		defer close(done)
+		for req := range server.requests {
+			if !p.dispatchAPIAndPark(ctx, req) {
+				return
+			}
+		}
+	}()
+	defer func() {
+		close(server.requests)
+		<-done
+	}()
+
+	scope := roomVolumeScope{owner.AccountUserID, owner.TargetID, owner.RoomID, owner.HomePodID}
+	query := url.Values{
+		"account_user_id": {scope.AccountUserID}, "target_id": {scope.TargetID},
+		"room_id": {scope.RoomID}, "homepod_id": {scope.HomePodID},
+	}
+	rec := httptest.NewRecorder()
+	server.handleContentControls(rec, httptest.NewRequestWithContext(ctx, http.MethodGet,
+		"/player/room_content/controls?"+query.Encode(), nil))
+	var control struct {
+		Ready bool         `json:"ready"`
+		Offer contentOffer `json:"start_offer"`
+	}
+	if err := json.Unmarshal(rec.Body.Bytes(), &control); err != nil || rec.Code != http.StatusOK || !control.Ready {
+		t.Fatalf("new Spotify content offer while radio plays returned HTTP %d: %v", rec.Code, err)
+	}
+	op := server.roomContents.get(control.Offer.OfferID, control.Offer.BindingID)
+	if op == nil || (incumbent == nil && op.Radio != nil) ||
+		(incumbent != nil && (op.Radio == nil || !op.Radio.Primary)) {
+		t.Fatal("new Spotify offer did not preserve the verified predecessor state")
+	}
+
+	const selectedURI = "spotify:track:0000000000000000000004"
+	post := func(path string, body any, handler http.HandlerFunc) *httptest.ResponseRecorder {
+		t.Helper()
+		raw, err := json.Marshal(body)
+		if err != nil {
+			t.Fatal(err)
+		}
+		w := httptest.NewRecorder()
+		handler(w, httptest.NewRequestWithContext(ctx, http.MethodPost, path, bytes.NewReader(raw)))
+		if w.Code != http.StatusOK {
+			t.Fatalf("new Spotify content %s returned HTTP %d", path, w.Code)
+		}
+		return w
+	}
+	post("/player/room_content/prepare", contentPrepareRequest{scope, control.Offer, "play_track",
+		contentArgs{TrackURI: selectedURI, MaxVolume: 35}}, server.handleContentPrepare)
+	tick := time.NewTicker(10 * time.Millisecond)
+	defer tick.Stop()
+	var fresh *player.Stream
+	for fresh == nil {
+		op.mu.Lock()
+		phase, selected := op.State, op.Stream
+		op.mu.Unlock()
+		if phase == "staged" && selected != nil {
+			fresh = selected
+			break
+		}
+		if phase != "staging" {
+			t.Fatalf("new Spotify media did not stage: %s", phase)
+		}
+		select {
+		case <-ctx.Done():
+			t.Fatal("new Spotify media did not stage before the existing fixture deadline")
+		case <-tick.C:
+		}
+	}
+	if fresh == incumbent || incumbent != nil && fresh.Source == incumbent.Source || fresh.Media == nil || fresh.Media.Id().Uri() != selectedURI {
+		t.Fatal("prepared Spotify media is not the explicitly selected new track")
+	}
+	whileStaged()
+
+	rec = post("/player/room_content/commit", contentIDRequest{control.Offer.OfferID, control.Offer.BindingID},
+		server.handleContentCommit)
+	var receipt contentReceipt
+	if err := json.Unmarshal(rec.Body.Bytes(), &receipt); err != nil || !receipt.Accepted || receipt.OperationID != control.Offer.OfferID {
+		if log, ok := app.log.(*contentFailureLog); ok {
+			log.mu.Lock()
+			for _, line := range log.lines {
+				if strings.HasPrefix(line, "content_start_failed stage=") {
+					t.Log(line)
+				}
+			}
+			log.mu.Unlock()
+		}
+		t.Fatalf("new Spotify content did not receive exact START acceptance: state=%s accepted=%t err=%v", receipt.State, receipt.Accepted, err)
+	}
+	// Join the production actor's commit before reading worker and session state.
+	_, _ = server.roomTransportAsk(ctx, ApiRequestType("fixture_noop"), nil)
+	source, err := worker.Start35CurrentSource(ctx)
+	if err != nil || source != fresh.Source || p.primaryStream != fresh || p.state.player.IsPaused ||
+		!p.state.player.IsPlaying || p.state.player.Track.GetUri() != selectedURI || p.state.player.SessionId == owner.SessionID ||
+		app.startCustody != op || app.radioOutputFence.Load() {
+		t.Fatalf("new Spotify media did not replace the original source under its own START: %v", err)
+	}
+}
