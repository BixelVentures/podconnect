+func testPrimaryRadioColdDetachmentActualOwnTone(t *testing.T, p *AppPlayer, worker *player.Player) {
+	t.Helper()
+	journal, endpoint := os.Getenv("PC_NATIVE_COLD_RADIO_JOURNAL"), os.Getenv("PC_NATIVE_PRIMARY_HTTP_URL")
+	fixture, fifo := os.Getenv("PC_NATIVE_START_URL"), os.Getenv("PC_NATIVE_START_PIPE")
+	token := os.Getenv("PC_PRIMARY_HTTP_TOKEN")
+	if !filepath.IsAbs(journal) || !filepath.IsAbs(fifo) || !radioWireLoopbackURL(endpoint) ||
+		!radioWireLoopbackURL(fixture) || !volumeHex64.MatchString(token) {
+		t.Fatal("missing isolated cold fixture inputs")
+	}
+	process, valid := nativeContentProcess()
+	if !valid {
+		t.Fatal("requires a real current Native process certificate")
+	}
+	app := p.app
+	app.cfg.RadioHandoffStatePath = journal
+	app.cfg.RadioHandoffControlToken = token
+	app.cfg.RoomTransportOwnToneURL, app.cfg.RadioHandoffOwnerURL = endpoint, endpoint
+	app.cfg.AudioOutputPipe = fifo
+	if err := app.initRadio(); err != nil {
+		t.Fatal(err)
+	}
+	var h *radioHold
+	for _, hold := range app.radio.Holds {
+		if hold.Phase == "unknown" && hold.WriterParked {
+			if h != nil {
+				t.Fatal("more than one prior parked hold")
+			}
+			h = hold
+		}
+	}
+	if h == nil || h.owner != nil || h.primary != nil || !app.radioOutputFence.Load() ||
+		h.Primary == nil || h.PrimaryPark == nil || h.PrimaryPending == nil || h.PrimaryStatus == nil ||
+		h.Request.ProcessID == radioProcessID(process) ||
+		h.PrimaryStatus.Request.Station != "p1" || h.PrimaryAction != "" ||
+		h.PrimaryPending.PriorRelease != nil && h.PrimaryPending.PriorRelease.radioPrimaryBinding == *h.Primary {
+		t.Fatal("missing cold P1 journal with unresolved old receiver and preserved Spotify park")
+	}
+	prior, priorIntent := *h.Primary, app.radio.Intent
+	oldCommand := h.PrimaryPending.Reserve
+	room, device := h.Request.TargetID, prior.DeviceID
+	app.cfg.DeviceAliases = []string{"fixture-main"}
+	app.cfg.DeviceAliasRoomIDs = []string{room}
+	app.cfg.DeviceAliasHomePodIDs = []string{device}
+	p.initAliasRegistry()
+	p.primaryStream, p.roomTransportOffer = nil, nil
+	p.primaryLoadOrdinal = 0
+	p.state.tracks, p.state.player.Track = nil, nil
+	p.state.player.SessionId = ""
+	p.state.active, p.state.player.IsPlaying, p.state.player.IsPaused = false, false, false
+	p.state.player.PositionAsOfTimestamp = 0
+	if source, err := worker.Start35CurrentSource(context.Background()); err != nil || source != nil || app.openedWriterOwner != nil {
+		t.Fatalf("new Native actor already has a source or writer: %v", err)
+	}
+
+	ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
+	defer cancel()
+	state := app.radioPrimaryReadiness(ctx, process)
+	if state.ColdDetachment == nil || state.ColdDetachment.Session != prior || state.ColdDetachment.Target.Process == prior.Process ||
+		state.ColdDetachment.Process != oldCommand.Process || state.ColdDetachment.Handoff != oldCommand.Handoff ||
+		state.ColdDetachment.Generation != oldCommand.Owner || state.ColdDetachment.Room != room ||
+		state.Observation != nil || state.Protocol != "" || state.IsolatedSession != nil || state.ReleasedSession != nil ||
+		app.radioOutputFence.Load() || app.radio.Intent != priorIntent+1 {
+		t.Fatalf("cold receipt failed to retire old Native custody without advertising source (proof=%t, revision changed=%t, current observation=%t)",
+			state.ColdDetachment != nil, app.radio.Intent != priorIntent, state.Observation != nil)
+	}
+	proof := *state.ColdDetachment
+	if err := app.initRadio(); err != nil {
+		t.Fatal(err)
+	}
+	if app.radioOutputFence.Load() || !primaryRadioColdDetached(app.radio.Holds[room]) ||
+		app.radio.Intent != priorIntent+1 || app.radio.Holds[room].owner != nil || app.radio.Holds[room].primary != nil {
+		t.Fatal("exact cold marker was not persisted independently of actor identity")
+	}
+
+	app.currentAPI, app.currentDone = make(chan ApiRequest), make(chan struct{})
+	actor, done := app.currentAPI, app.currentDone
+	go func() {
+		defer close(done)
+		for req := range actor {
+			if req.Type != apiRadioPrimaryActorState {
+				req.Reply(nil, ErrAliasConflict)
+				continue
+			}
+			value, err := p.radioPrimaryActorState(ctx, req.Data.(radioPrimaryActorStateRequest))
+			req.Reply(value, err)
+		}
+	}()
+	defer func() { close(actor); <-done }()
+	state = app.radioPrimaryReadiness(ctx, process)
+	if state.ColdDetachment == nil || *state.ColdDetachment != proof || state.Observation == nil ||
+		state.Observation.Source != "none" || state.Observation.State != "idle" ||
+		state.Protocol != "primary" || len(state.Missing) != 0 || len(state.Targets) != 1 || !state.Targets[0].Selectable ||
+		state.Session != nil || state.IsolatedSession != nil || state.ReleasedSession != nil || state.TeardownCSeq != nil {
+		t.Fatalf("current C idle owner was not independently observed (observation=%t, protocol=%s, missing=%v)",
+			state.Observation != nil, state.Protocol, state.Missing)
+	}
+	if manager := os.Getenv("PC_PRIMARY_MANAGER_TEST_BIN"); manager != "" && os.Getenv("PC_PRIMARY_MANAGER_COLD_DATA") != "" {
+		testColdPrimaryManagerRead(t, ctx, app, manager)
+	}
+	oldCommand.Phase, oldCommand.ForPhase, oldCommand.Station = "result", "start", "p1"
+	if _, err := p.radioPrimaryActor(ctx, oldCommand); err == nil {
+		t.Fatal("the previous Native process replayed its radio result")
+	}
+	pollRTP := func(expect func(before, radio int) bool) {
+		t.Helper()
+		for ctx.Err() == nil {
+			request, _ := http.NewRequestWithContext(ctx, http.MethodGet, fixture+"/fixture/rtp", nil)
+			response, err := http.DefaultClient.Do(request)
+			if err != nil {
+				t.Fatal(err)
+			}
+			var rtp struct {
+				Before int `json:"primary_before"`
+				Radio  int `json:"primary_radio"`
+			}
+			err = json.NewDecoder(response.Body).Decode(&rtp)
+			response.Body.Close()
+			if err != nil || response.StatusCode != http.StatusOK {
+				t.Fatal("missing fresh receiver observation", err)
+			}
+			if expect(rtp.Before, rtp.Radio) {
+				return
+			}
+			time.Sleep(20 * time.Millisecond)
+		}
+		t.Fatal("fresh action produced no authenticated loopback RTP")
+	}
+	if os.Getenv("PC_NATIVE_PRIMARY_COLD_FRESH_SPOTIFY") != "" {
+		if os.Getenv("PC_NATIVE_PRIMARY_NEW_SELECTION") == "" {
+			t.Fatal("cold Spotify test requires the selected offline media fixture")
+		}
+		testPrimaryNewSpotifySelection(t, ctx, p, worker, nil, h.PrimaryPark.Owner, func() {
+			if p.primaryStream != nil || app.openedWriterOwner != nil {
+				t.Fatal("staging a fresh Spotify choice reopened the old writer")
+			}
+		})
+		pollRTP(func(before, radio int) bool { return before > 0 && radio == 0 })
+		state = app.radioPrimaryReadiness(ctx, process)
+		if state.Observation == nil || state.Observation.Source != "spotify" ||
+			state.Observation.State != "playing" || state.Observation.Target != room || state.Protocol != "primary" {
+			t.Fatal("fresh Spotify START did not own current output after cold detachment")
+		}
+		t.Log("fresh explicit Spotify START acquired the new C output and delivered authenticated RTP")
+	}
+	if os.Getenv("PC_NATIVE_PRIMARY_COLD_FRESH_RADIO") != "" {
+		q := radioPrimaryCommand{Schema: nativePrimarySchema, Phase: "reserve", Process: radioProcessID(process),
+			Handoff: "af124cc3-29d2-4d15-9c6d-dca284a02fe1", Action: "32dc86c8-c852-4df7-bb7a-4656f3fae1a4",
+			Generation: strconv.FormatUint(app.radio.Generation+1, 10), Target: room, Intent: state.Revision}
+		ask := func(r radioPrimaryCommand) radioPrimaryReply {
+			t.Helper()
+			value, err := p.radioPrimaryActor(ctx, r)
+			ack, ok := value.(radioPrimaryReply)
+			if err != nil || !ok {
+				t.Fatalf("fresh Native %s failed: %v", r.Phase, err)
+			}
+			return ack
+		}
+		settle := func(q radioPrimaryCommand) radioPrimaryReply {
+			ack := ask(q)
+			q.Phase, q.ForPhase = "result", q.Phase
+			for ack.Phase == "pending" && ctx.Err() == nil {
+				time.Sleep(20 * time.Millisecond)
+				ack = ask(q)
+			}
+			return ack
+		}
+		q.Owner = ask(q).Owner
+		q.Phase, q.Station = "prepare_start", "p6-beat"
+		if settle(q).Phase != "prepared" {
+			t.Fatal("fresh decoder admission did not prepare")
+		}
+		q.Phase = "start"
+		playing := settle(q)
+		if playing.Phase != "playing" || playing.Session == nil || playing.Session.Process != proof.Target.Process ||
+			playing.Session.DeviceID != device || playing.Session.Operation != q.Action || *playing.Session == prior {
+			t.Fatal("explicit fresh start did not acquire distinct current C receiver custody")
+		}
+		pollRTP(func(_, radio int) bool { return radio > 0 })
+		if _, err := p.radioPrimaryActor(ctx, oldCommand); err == nil {
+			t.Fatal("old radio result reached the fresh station")
+		}
+	}
+	request, _ := http.NewRequestWithContext(ctx, http.MethodPost, fixture+"/fixture/done", strings.NewReader("{}"))
+	response, err := http.DefaultClient.Do(request)
+	if err != nil {
+		t.Fatal(err)
+	}
+	response.Body.Close()
+	if response.StatusCode != http.StatusOK {
+		t.Fatalf("fixture completion returned HTTP %d", response.StatusCode)
+	}
+	t.Log("actual C cold receipt retired old P1 without old STOP or replay; fresh owner independently proved")
+}
