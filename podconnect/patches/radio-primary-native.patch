+	ParkToken    string                       `json:"park_token,omitempty"`
+	Predecessor  *radioPrimaryBinding         `json:"predecessor,omitempty"`
+	PriorRelease *radioPrimaryPreviousRelease `json:"predecessor_release,omitempty"`
+	radioPrimaryTarget
+}
+
+type radioPrimaryStartReceipt struct {
+	radioPrimaryStartWire
+	Session *radioPrimaryBinding `json:"target_session,omitempty"`
+}
+
+type radioPrimaryActive struct {
+	Request         radioPrimaryStartWire `json:"request"`
+	OwnerGeneration string                `json:"owner_generation"`
+	SameTarget      bool                  `json:"same_target,omitempty"`
+}
+
+func primaryRadioActiveRead(wire radioPrimaryStartWire, ownerGeneration string, sameTarget bool) *radioPrimaryActive {
+	wire.Phase, wire.ParkToken = "result", ""
+	if wire.PriorRelease != nil && wire.PriorRelease.Action == wire.Action {
+		wire.PriorRelease = nil
+	}
+	return &radioPrimaryActive{wire, ownerGeneration, sameTarget}
+}
+
+type radioPrimaryPending struct {
+	Station             string                   `json:"station_id,omitempty"`
+	Reserve             radioPrimaryCommand      `json:"reserve"`
+	Target              *radioPrimaryTarget      `json:"c_target,omitempty"`
+	Started             *radioPrimaryCommand     `json:"started,omitempty"`
+	Stopped             *radioPrimaryCommand     `json:"stopped,omitempty"`
+	Released            int                      `json:"teardown_cseq,omitempty"`
+	SameTarget          bool                     `json:"same_target,omitempty"`
+	Decoded             bool                     `json:"decoded,omitempty"`
+	PriorRelease        *radioPrimaryStopReceipt `json:"predecessor_release,omitempty"`
+	ActivationSent      bool                     `json:"activation_sent,omitempty"`
+	ReplacementDone     bool                     `json:"replacement_done,omitempty"`
+	ReplacementRejected bool                     `json:"replacement_rejected,omitempty"`
+	ParkedRestart       bool                     `json:"parked_restart,omitempty"`
+}
+
+type radioPrimaryHTTPCall struct {
+	Token   string
+	Query   bool
+	Request radioPrimaryCommand
+	Context context.Context
+}
+
+func (s *ConcreteApiServer) handleRadioPrimaryHTTP(w http.ResponseWriter, r *http.Request) {
+	call := radioPrimaryHTTPCall{Token: r.Header.Get("X-PodConnect-Token"), Query: r.Method == http.MethodGet, Context: r.Context()}
+	if r.URL.RawQuery != "" {
+		w.WriteHeader(http.StatusBadRequest)
+		return
+	}
+	if !call.Query && !roomTransportBody(w, r, &call.Request) {
+		return
+	}
+	ctx, cancel := context.WithTimeout(r.Context(), 8*time.Second)
+	defer cancel()
+	data, err := s.roomTransportAsk(ctx, apiRadioPrimaryHTTP, call)
+	if err == ErrForbidden {
+		w.WriteHeader(http.StatusForbidden)
+		return
+	}
+	roomTransportResponse(w, data, err)
+}
+
+func (app *App) handleRadioPrimaryAPI(ctx context.Context, req ApiRequest) {
+	c, ok := req.Data.(radioPrimaryHTTPCall)
+	if !ok || app.cfg == nil || app.cfg.RadioHandoffControlToken == "" ||
+		subtle.ConstantTimeCompare([]byte(c.Token), []byte(app.cfg.RadioHandoffControlToken)) != 1 {
+		req.Reply(nil, ErrForbidden)
+		return
+	}
+	process, processOK := nativeContentProcess()
+	if !processOK {
+		req.Reply(nil, ErrAliasConflict)
+		return
+	}
+	if c.Query {
+		req.Reply(app.radioPrimaryReadiness(ctx, process), nil)
+		return
+	}
+	if !app.radioEnabled() || c.Request.Process != radioProcessID(process) ||
+		!validPrimaryCommandIdentity(c.Request) || c.Request.Phase != "result" && app.manualReleasePending() {
+		req.Reply(nil, ErrAliasConflict)
+		return
+	}
+	actionCtx, cancel := queueOperationContext(ctx, c.Context)
+	defer cancel()
+	data, err := app.primaryRadioActorAsk(actionCtx, apiRadioPrimaryActor, c.Request)
+	req.Reply(data, err)
+}
+
+func (t radioPrimaryTarget) valid() bool {
+	return volumeUUID.MatchString(t.Process) && volumeCounter(t.Device) && t.Device != "0" &&
+		volumeCounter(t.Incarnation) && t.Incarnation != "0" && volumeCounter(t.Epoch) && volumeCounter(t.Route)
+}
+
+func (p *AppPlayer) primaryRadioCStart(ctx context.Context, r radioPrimaryStartWire, sameTarget bool) (radioPrimaryStartReceipt, error) {
+	var ack radioPrimaryStartReceipt
+	endpoint := strings.TrimSuffix(p.app.cfg.RoomTransportOwnToneURL, "/") + "/api/outputs/" + r.Device + "/radio-handoff/reacquire"
+	if err := radioAuthenticatedHTTP(ctx, endpoint, p.app.cfg.RadioHandoffControlToken, r, &ack); err != nil {
+		return ack, err
+	}
+	if ack.Schema != r.Schema || !ack.radioPrimaryTarget.valid() || ack.Device != r.Device {
+		return ack, ErrAliasConflict
+	}
+	if (ack.Predecessor == nil) != (r.Predecessor == nil) || r.Predecessor != nil && *ack.Predecessor != *r.Predecessor ||
+		ack.PriorRelease != nil || ack.ParkToken != "" {
+		return ack, ErrAliasConflict
+	}
+	if r.Phase == "target" || r.Phase == "preflight_target" || r.Phase == "preflight_replace_target" {
+		if ack.Phase != "target_ready" || ack.Action != "" || ack.Station != "" || ack.Generation != "" || ack.Session != nil {
+			return ack, ErrAliasConflict
+		}
+	} else if ack.radioPrimaryTarget != r.radioPrimaryTarget || ack.Action != r.Action || ack.Station != r.Station ||
+		!volumeCounter(r.Generation) || r.Generation == "0" || ack.Generation != r.Generation ||
+		(ack.Phase == "playing" && (ack.Session == nil || !ack.Session.valid() || ack.Session.DeviceID != r.Device ||
+			ack.Session.Process != r.Process || ack.Session.Operation != r.Action ||
+			ack.Session.Incarnation != r.Incarnation)) ||
+		(ack.Phase != "playing" && ack.Session != nil) {
+		return ack, ErrAliasConflict
+	}
+	if ack.Phase == "playing" {
+		before, err := strconv.ParseUint(r.Epoch, 10, 64)
+		route, routeErr := strconv.ParseUint(r.Route, 10, 64)
+		epochDelta, routeDelta := uint64(1), uint64(0)
+		if r.Predecessor != nil && r.Predecessor.DeviceID == r.Device &&
+			(r.PriorRelease == nil || r.PriorRelease.Action == r.Action) {
+			epochDelta = 2
+		} else if sameTarget {
+			epochDelta, routeDelta = 2, 1
+		}
+		if err != nil || routeErr != nil || before > ^uint64(0)-epochDelta || route > ^uint64(0)-routeDelta ||
+			ack.Session.Epoch != strconv.FormatUint(before+epochDelta, 10) ||
+			ack.Session.Route != strconv.FormatUint(route+routeDelta, 10) {
+			return ack, ErrAliasConflict
+		}
+	}
+	return ack, nil
+}
+
+func validPrimaryCommandIdentity(r radioPrimaryCommand) bool {
+	return r.Schema == nativePrimarySchema && volumeHex64.MatchString(r.Process) &&
+		volumeUUID.MatchString(r.Handoff) && volumeUUID.MatchString(r.Action) &&
+		volumeCounter(r.Generation) && r.Generation != "0" &&
+		volumeCounter(r.Intent) && nativeOwnerASCII(r.Target, 255) &&
+		(r.From == "" || nativeOwnerASCII(r.From, 255))
+}
+
+func primaryCommandMatches(r, reserve radioPrimaryCommand) bool {
+	return r.Schema == reserve.Schema && r.Process == reserve.Process && r.Handoff == reserve.Handoff &&
+		r.Generation == reserve.Generation && r.Action == reserve.Action && r.Target == reserve.Target &&
+		r.Intent == reserve.Intent && r.Owner == reserve.Owner && r.From == reserve.From
+}
+
+func primaryObservation(r radioPrimaryCommand, state, source string) *radioPrimaryObservation {
+	generation, _ := strconv.ParseUint(r.Owner, 10, 64)
+	now := time.Now().Unix()
+	return &radioPrimaryObservation{State: state, Station: r.Station, Target: r.Target, Source: source,
+		OwnerGeneration: generation, ObservedAt: now, ValidUntil: now + 3}
+}
+
+func (p *AppPlayer) primaryRadioRoom(target string) string {
+	p.aliasMu.Lock()
+	defer p.aliasMu.Unlock()
+	if p.aliasRetired || !p.transportMappingCurrentLocked() {
+		return ""
+	}
+	for _, alias := range p.aliasRegistry {
+		if alias.RoomID == target && volumeCounter(alias.HomePodID) && alias.HomePodID != "0" {
+			return alias.HomePodID
+		}
+	}
+	return ""
+}
+
+func (p *AppPlayer) radioPrimaryActor(ctx context.Context, r radioPrimaryCommand) (any, error) {
+	app := p.app
+	process, ok := nativeContentProcess()
+	device := p.primaryRadioRoom(r.Target)
+	if !ok || device == "" || r.Process != radioProcessID(process) || !validPrimaryCommandIdentity(r) || ctx.Err() != nil {
+		return nil, ErrAliasConflict
+	}
+	app.radio.mu.Lock()
+	defer app.radio.mu.Unlock()
+	if app.radio.failed || strconv.FormatUint(app.radio.Intent, 10) != r.Intent {
+		return nil, ErrAliasConflict
+	}
+	h := app.radio.Holds[r.Target]
+	if r.Phase == "reserve" {
+		for _, hold := range app.radio.Holds {
+			if hold == nil || hold.PrimaryPending == nil {
+				return nil, ErrAliasConflict // A legacy hold still owns its source or receiver.
+			}
+			if hold != h && hold.WriterParked && primaryRadioReleased(hold) {
+				return nil, ErrAliasConflict // The parked writer pins the advertised room.
+			}
+		}
+		if r.Session != nil {
+			return p.reservePrimaryRadioReplacement(r, h)
+		}
+		generation, err := strconv.ParseUint(r.Generation, 10, 64)
+		if err != nil || generation <= app.radio.Generation || r.Owner != "" || r.ForPhase != "" || r.Session != nil || r.Station != "" {
+			return nil, ErrAliasConflict
+		}
+		if release, ok := primaryParkedStopReceipt(h); ok {
+			return p.reservePrimaryParkedRestart(r, h, release, generation)
+		}
+		if h == nil || primaryRadioRetired(h) && !h.WriterParked && !h.PauseUncertain {
+			h = &radioHold{owner: p, Phase: "primary_reserved", Actions: map[string]bool{},
+				Request: radioRequest{Schema: "podconnect.native_radio_primary_hold.v1", ProcessID: r.Process,
+					TargetID: r.Target, HandoffID: r.Handoff, Generation: r.Generation, ActionID: r.Action, ExpectedRevision: r.Intent}}
+		} else if h.owner != p || h.Primary == nil || h.Phase != "primary_active" || r.From != r.Target || primaryReplacementPending(h) {
+			return nil, ErrAliasConflict
+		}
+		r.Owner = r.Generation
+		h.PrimaryPending = &radioPrimaryPending{Reserve: r}
+		app.radio.Generation = generation
+		app.radio.Holds[r.Target] = h
+		if err = app.persistRadioLocked(); err != nil {
+			return nil, err
+		}
+		r.Phase = "reserved"
+		return radioPrimaryReply{radioPrimaryCommand: r}, nil
+	}
+	if h == nil || h.owner != p || h.PrimaryPending == nil || !primaryCommandMatches(r, h.PrimaryPending.Reserve) {
+		return nil, ErrAliasConflict
+	}
+	operation := h.PrimaryPending
+	if operation.ParkedRestart {
+		return p.primaryRadioParkedRestartActor(ctx, r, h, device)
+	}
+	if operation.Reserve.Session != nil {
+		return p.primaryRadioReplacementActor(ctx, r, h, device)
+	}
+	if r.Phase == "prepare_start" || r.Phase == "result" && r.ForPhase == "prepare_start" {
+		return p.primaryRadioPrepareStation(ctx, r, h, device)
+	}
+	start := r.Phase == "start"
+	if start || (r.Phase == "result" && r.ForPhase == "start") {
+		if operation.Target == nil || operation.Target.Device != device || operation.Station != r.Station || r.Session != nil {
+			return nil, ErrAliasConflict
+		}
+		wire := radioPrimaryStartWire{Schema: cPrimaryStartSchema, Phase: "result", Action: r.Action, Station: r.Station, Generation: r.Generation, radioPrimaryTarget: *operation.Target}
+		if start {
+			if h.Phase != "primary_reserved" || operation.Started != nil || r.ForPhase != "" ||
+				operation.SameTarget && !operation.Decoded {
+				return nil, ErrAliasConflict
+			}
+			admitted := r
+			operation.Started, h.Phase = &admitted, "primary_start_pending"
+			if err := app.persistRadioLocked(); err != nil {
+				return nil, err
+			}
+			wire.Phase = "start"
+		} else if operation.Started == nil {
+			return nil, ErrAliasConflict
+		}
+		var ack radioPrimaryStartReceipt
+		var err error
+		if operation.SameTarget {
+			ack, err = p.primaryRadioAdvancePark(ctx, h, r, wire, start)
+		} else {
+			ack, err = p.primaryRadioCStart(ctx, wire, false)
+		}
+		if err != nil {
+			return nil, err
+		}
+		switch ack.Phase {
+		case "pending":
+			r.Phase = "pending"
+		case "playing":
+			h.Primary, h.Phase = ack.Session, "primary_active"
+			h.PrimaryStatus = primaryRadioActiveRead(wire, r.Owner, operation.SameTarget)
+			r.Session, r.Phase = ack.Session, "playing"
+		case "rejected":
+			if operation.SameTarget {
+				h.Phase = "unknown"
+				_ = app.persistRadioLocked()
+				return nil, ErrAliasConflict
+			}
+			h.Phase, r.Phase = "primary_rejected", "rejected"
+		default:
+			h.Phase = "unknown"
+			_ = app.persistRadioLocked()
+			return nil, ErrAliasConflict
+		}
+		if err = app.persistRadioLocked(); err != nil {
+			return nil, err
+		}
+		reply := radioPrimaryReply{radioPrimaryCommand: r}
+		if r.Phase == "playing" {
+			reply.Observation = primaryObservation(r, "playing", "radio")
+		}
+		return reply, nil
+	}
+	return p.radioPrimaryActorStop(ctx, r, h)
+}
+
+func (p *AppPlayer) radioPrimaryActorStop(ctx context.Context, r radioPrimaryCommand, h *radioHold) (any, error) {
+	app, operation := p.app, h.PrimaryPending
+	stop := r.Phase == "stop"
+	if (!stop && !(r.Phase == "result" && r.ForPhase == "stop")) ||
+		h.Primary == nil || r.Session == nil || *r.Session != *h.Primary || r.Station != "" {
+		return nil, ErrAliasConflict
+	}
+	phase := "result"
+	if stop {
+		if operation.Stopped != nil || h.Phase != "primary_active" || r.ForPhase != "" {
+			return nil, ErrAliasConflict
+		}
+		admitted := r
+		operation.Stopped, h.Phase = &admitted, "primary_stop_pending"
+		if err := app.persistRadioLocked(); err != nil {
+			return nil, err
+		}
+		phase = "claim_stop"
+	} else if operation.Stopped == nil {
+		return nil, ErrAliasConflict
+	}
+	binding := *h.Primary
+	wire := radioPrimaryStopRequest{Schema: primaryRadioStopSchema, Phase: phase, Action: r.Action, radioPrimaryBinding: binding}
+	var ack radioPrimaryStopReceipt
+	endpoint := strings.TrimSuffix(app.cfg.RoomTransportOwnToneURL, "/") + "/api/outputs/" + binding.DeviceID + "/radio-handoff/reacquire"
+	if err := radioAuthenticatedHTTP(ctx, endpoint, app.cfg.RadioHandoffControlToken, wire, &ack); err != nil {
+		return nil, err
+	}
+	if ack.Schema != wire.Schema || ack.Action != wire.Action || ack.radioPrimaryBinding != binding {
+		return nil, ErrAliasConflict
+	}
+	r.Phase = "pending"
+	if ack.Phase == "pending" && ack.TeardownCSeq == 0 {
+		return radioPrimaryReply{radioPrimaryCommand: r}, nil
+	}
+	if ack.Phase != "released" || ack.TeardownCSeq <= 0 {
+		return nil, ErrAliasConflict
+	}
+	h.Phase, operation.Released = "primary_released", ack.TeardownCSeq
+	if err := app.persistRadioLocked(); err != nil {
+		return nil, err
+	}
+	r.Phase = "released"
+	return radioPrimaryReply{radioPrimaryCommand: r, CSeq: ack.TeardownCSeq, Observation: primaryObservation(r, "stopped", "none")}, nil
+}
+
+func primaryRadioReleased(h *radioHold) bool {
+	return h != nil && h.PrimaryPending != nil && h.Primary != nil && h.Primary.valid() &&
+		h.Phase == "primary_released" && h.PrimaryPending.Released > 0 &&
+		(volumeUUID.MatchString(h.PrimaryAction) || h.PrimaryPending.Stopped != nil &&
+			volumeUUID.MatchString(h.PrimaryPending.Stopped.Action) && h.PrimaryPending.Stopped.Session != nil &&
+			*h.PrimaryPending.Stopped.Session == *h.Primary)
+}
+
+func primaryRadioRetired(h *radioHold) bool {
+	return h != nil && !h.WriterParked && !h.PauseUncertain && (primaryRadioReleased(h) || h.PrimaryPending != nil && h.Phase == "primary_rejected")
+}
diff --git a/daemon/radio_primary_composed_test.go b/daemon/radio_primary_composed_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..04c6df65bc82cc3b3e9108e9e851125544af327e
--- /dev/null
+++ b/daemon/radio_primary_composed_test.go
@@ -0,0 +1,114 @@
+package daemon
+
+import (
+	"context"
+	"net/http"
+	"os"
+	"path/filepath"
+	"testing"
+	"time"
+)
+
+func TestPrimaryRadioActorOwnToneHTTP(t *testing.T) {
+	endpoint, token := os.Getenv("PC_PRIMARY_HTTP_URL"), os.Getenv("PC_PRIMARY_HTTP_TOKEN")
+	if endpoint == "" || token == "" {
+		t.Skip("requires the isolated production OwnTone HTTP fixture")
+	}
+	p, op := contentFixture(t)
+	p.app.radio.Holds = map[string]*radioHold{}
+	p.app.cfg.RadioHandoffStatePath = filepath.Join(t.TempDir(), "radio.json")
+	p.app.cfg.RadioHandoffControlToken = token
+	p.app.cfg.RoomTransportOwnToneURL = endpoint
+
+	ctx, cancel := context.WithTimeout(context.Background(), 8*time.Second)
+	defer cancel()
+	unauthorized, err := http.NewRequestWithContext(ctx, http.MethodPost,
+		endpoint+"/api/outputs/202/radio-handoff/reacquire", nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	response, err := http.DefaultClient.Do(unauthorized)
+	if err != nil {
+		t.Fatal(err)
+	}
+	response.Body.Close()
+	if response.StatusCode != http.StatusForbidden {
+		t.Fatalf("production OwnTone token gate returned %d", response.StatusCode)
+	}
+
+	ask := func(q radioPrimaryCommand) radioPrimaryReply {
+		t.Helper()
+		reply, err := p.radioPrimaryActor(ctx, q)
+		if err != nil {
+			t.Fatalf("%s/%s: %v", q.Phase, q.ForPhase, err)
+		}
+		ack, ok := reply.(radioPrimaryReply)
+		if !ok {
+			t.Fatalf("%s returned %T", q.Phase, reply)
+		}
+		return ack
+	}
+	wait := func(q radioPrimaryCommand, ack radioPrimaryReply, phase string) radioPrimaryReply {
+		t.Helper()
+		q.ForPhase, q.Phase = q.Phase, "result"
+		tick := time.NewTicker(25 * time.Millisecond)
+		defer tick.Stop()
+		for ack.Phase == "pending" {
+			select {
+			case <-ctx.Done():
+				t.Fatalf("timed out observing %s", q.ForPhase)
+			case <-tick.C:
+				ack = ask(q)
+			}
+		}
+		if ack.Phase != phase {
+			t.Fatalf("want %s, got %s", phase, ack.Phase)
+		}
+		return ack
+	}
+
+	const startAction = "b3919fea-955b-4d4c-a581-c71cb92712b2"
+	const stopAction = "87f6f7dd-2a03-4d75-9a62-6a7a2e089705"
+	q := radioPrimaryCommand{Schema: nativePrimarySchema, Phase: "reserve", Process: radioProcessID(op.Capture.Process),
+		Handoff: "a411aa42-8b70-4bf4-a37d-81b0519db7df", Generation: "1", Action: startAction, Target: "r1", Intent: "0", From: "r0"}
+	if ack := ask(q); ack.Phase == "reserved" && ack.Owner != "" {
+		q.Owner = ack.Owner
+	} else {
+		t.Fatal("native actor did not reserve exact start")
+	}
+	q.Phase, q.Station = "prepare_start", "p3"
+	if ack := ask(q); ack.Phase != "prepared" {
+		t.Fatalf("production C target did not prepare: %s", ack.Phase)
+	}
+	q.Phase = "start"
+	started := ask(q)
+	if _, err := p.radioPrimaryActor(ctx, q); err == nil {
+		t.Fatal("duplicate station effect accepted")
+	}
+	playing := wait(q, started, "playing")
+	if playing.Session == nil || !playing.Session.valid() || playing.Session.DeviceID != "202" ||
+		playing.Session.Operation != startAction || playing.Observation == nil || playing.Observation.Source != "radio" {
+		t.Fatal("missing exact observed production C radio session")
+	}
+
+	q.Phase, q.Station, q.Owner = "reserve", "", ""
+	q.Handoff, q.Generation, q.Action, q.From = "bdb0c4c5-df0e-4f42-a88e-44a8736ca5b8", "2", stopAction, q.Target
+	if ack := ask(q); ack.Phase == "reserved" && ack.Owner != "" {
+		q.Owner = ack.Owner
+	} else {
+		t.Fatal("native actor did not reserve exact stop")
+	}
+	q.Phase, q.Session = "stop", playing.Session
+	stopped := ask(q)
+	if _, err := p.radioPrimaryActor(ctx, q); err == nil {
+		t.Fatal("duplicate stop effect accepted")
+	}
+	released := wait(q, stopped, "released")
+	if released.Session == nil || *released.Session != *playing.Session || released.Action != stopAction ||
+		released.CSeq <= 0 || released.Observation == nil || released.Observation.Source != "none" {
+		t.Fatal("missing exact positive C teardown receipt")
+	}
+	if p.primaryStream != op.Capture.Primary || p.state.player != op.Capture.PlayerState {
+		t.Fatal("radio actor changed the disjoint Native Spotify owner")
+	}
+}
diff --git a/daemon/radio_primary_observation.go b/daemon/radio_primary_observation.go
new file mode 100644
index 0000000000000000000000000000000000000000..9e64ae1627b3c1cd4f0eff2d10147367f9284be8
--- /dev/null
+++ b/daemon/radio_primary_observation.go
@@ -0,0 +1,245 @@
+package daemon
+
+import (
+	"context"
+	"strconv"
+	"strings"
+	"time"
+)
+
+const (
+	apiRadioPrimaryActorState ApiRequestType = "radio_primary_actor_state"
+	cPrimaryOwnerSchema                      = "podconnect.output_primary_radio_owner_observation.v1"
+)
+
+type radioPrimaryOwnerRequest struct {
+	Schema  string                 `json:"schema"`
+	Source  string                 `json:"source_kind"`
+	Owner   *roomTransportIdentity `json:"native_owner,omitempty"`
+	Writer  *queueWriterWire       `json:"writer_proof,omitempty"`
+	Absence *radioAbsenceSource    `json:"source_absence,omitempty"`
+}
+
+type radioPrimaryOwnerReceipt struct {
+	radioPrimaryOwnerRequest
+	Output   *roomVolumeRoute    `json:"output_identity,omitempty"`
+	Target   *radioPrimaryTarget `json:"target_identity,omitempty"`
+	Physical *bool               `json:"physical_result_verified"`
+}
+
+type radioPrimaryActorStateRequest struct {
+	State     radioPrimaryReadinessState
+	CProcess  string
+	Receivers map[string]string
+}
+
+func (app *App) primaryRadioActorAsk(ctx context.Context, kind ApiRequestType, call any) (any, error) {
+	app.ownerMu.Lock()
+	ch, done := app.currentAPI, app.currentDone
+	app.ownerMu.Unlock()
+	if ch == nil || done == nil {
+		return nil, ErrAliasConflict
+	}
+	request, wait := NewApiRequest(kind, call)
+	select {
+	case ch <- request:
+		return wait(ctx)
+	case <-done:
+		return nil, ErrAliasConflict
+	case <-ctx.Done():
+		return nil, ctx.Err()
+	}
+}
+
+func (p *AppPlayer) primaryRadioReadOwner(ctx context.Context, device string, query radioPrimaryOwnerRequest) (radioPrimaryOwnerReceipt, error) {
+	var ack radioPrimaryOwnerReceipt
+	endpoint := strings.TrimSuffix(p.app.cfg.RoomTransportOwnToneURL, "/") + "/api/outputs/" + device + "/radio-handoff/primary-owner"
+	if err := radioAuthenticatedHTTP(ctx, endpoint, p.app.cfg.RadioHandoffControlToken, query, &ack); err != nil {
+		return ack, err
+	}
+	if ack.Schema != query.Schema || ack.Source != query.Source || ack.Physical == nil || *ack.Physical {
+		return ack, ErrAliasConflict
+	}
+	switch query.Source {
+	case "spotify":
+		if ack.Owner == nil || ack.Writer == nil || ack.Absence != nil || ack.Target != nil || ack.Output == nil ||
+			!ack.Output.valid() || ack.Output.DeviceID != device || *ack.Owner != *query.Owner || *ack.Writer != *query.Writer ||
+			ack.Output.InputPathDigest != query.Writer.InputDigest {
+			return ack, ErrAliasConflict
+		}
+	case "none":
+		if ack.Owner != nil || ack.Writer != nil || ack.Absence == nil || ack.Absence.Live != nil || ack.Output != nil ||
+			ack.Target == nil || !ack.Target.valid() || ack.Target.Device != device || *ack.Absence != *query.Absence {
+			return ack, ErrAliasConflict
+		}
+	default:
+		return ack, ErrAliasConflict
+	}
+	return ack, nil
+}
+
+// The same Native actor owns source observation and effects. No persisted hold
+// becomes a new authority after restart, and a paused writer remains Spotify.
+func (p *AppPlayer) radioPrimaryActorState(ctx context.Context, request radioPrimaryActorStateRequest) (any, error) {
+	app, state := p.app, request.State
+	if ctx.Err() != nil || p.state == nil || p.state.player == nil || app.manualReleasePending() {
+		return nil, ErrAliasConflict
+	}
+	app.radio.mu.Lock()
+	generation := app.radio.Generation
+	if app.radio.failed || state.Revision != strconv.FormatUint(app.radio.Intent, 10) {
+		app.radio.mu.Unlock()
+		return nil, ErrAliasConflict
+	}
+	var held *radioHold
+	var parked *radioHold
+	var parkedRelease radioPrimaryStopReceipt
+	var releaseBinding *radioPrimaryBinding
+	var releaseAction string
+	var releaseCSeq int
+	var releaseGeneration uint64
+	for _, h := range app.radio.Holds {
+		if primaryRadioReleased(h) {
+			if h.WriterParked {
+				release, ok := primaryParkedStopReceipt(h)
+				if !ok || parked != nil || h.owner != p || h.primary == nil || p.primaryStream != h.primary {
+					app.radio.mu.Unlock()
+					return nil, ErrAliasConflict
+				}
+				parked, parkedRelease = h, release
+			}
+			if h.Request.ProcessID != state.Process {
+				continue
+			}
+			candidateGeneration, _ := strconv.ParseUint(h.Request.Generation, 10, 64)
+			if candidateGeneration > releaseGeneration {
+				releaseGeneration = candidateGeneration
+				binding := *h.Primary
+				releaseBinding, releaseCSeq = &binding, h.PrimaryPending.Released
+				releaseAction = h.PrimaryAction
+				if releaseAction == "" && h.PrimaryPending.Stopped != nil {
+					releaseAction = h.PrimaryPending.Stopped.Action
+				}
+			}
+			continue
+		}
+		if primaryRadioRetired(h) {
+			continue
+		}
+		if h == nil || h.owner != p || h.PrimaryStatus == nil || h.Primary == nil || h.Phase != "primary_active" || held != nil {
+			app.radio.mu.Unlock()
+			return nil, ErrAliasConflict
+		}
+		held = h
+	}
+	app.radio.mu.Unlock()
+
+	source, playbackState, sourceRoom := "none", "idle", ""
+	var session *radioPrimaryBinding
+	if held != nil {
+		proof := held.PrimaryStatus
+		query := proof.Request
+		query.Phase = "readiness"
+		ack, err := p.primaryRadioCStart(ctx, query, proof.SameTarget)
+		if err != nil || ack.Phase != "playing" || ack.Session == nil || *ack.Session != *held.Primary ||
+			ack.Session.Process != request.CProcess || request.Receivers[ack.Session.DeviceID] != ack.Session.Incarnation {
+			return nil, ErrAliasConflict
+		}
+		source, playbackState, sourceRoom, session = "radio", "playing", held.Request.TargetID, ack.Session
+		generation, _ = strconv.ParseUint(proof.OwnerGeneration, 10, 64)
+	} else if parked != nil {
+		device := parkedRelease.DeviceID
+		ack, err := p.primaryRadioCStart(ctx, radioPrimaryStartWire{
+			Schema: cPrimaryStartSchema, Phase: "preflight_replace_target", radioPrimaryTarget: radioPrimaryTarget{Device: device},
+			Predecessor: &parkedRelease.radioPrimaryBinding, PriorRelease: primaryPreviousRelease(&parkedRelease),
+		}, false)
+		if err != nil || ack.Process != request.CProcess || request.Receivers[device] != ack.Incarnation {
+			return nil, ErrAliasConflict
+		}
+		source, playbackState, sourceRoom = "none", "stopped", parked.Request.TargetID
+	} else if p.primaryStream != nil {
+		owner, err := p.radioSourceOwner()
+		if err != nil {
+			return nil, err
+		}
+		writer, err := p.captureQueueWriter(ctx, owner, nil)
+		if err != nil {
+			return nil, err
+		}
+		ack, err := p.primaryRadioReadOwner(ctx, owner.HomePodID, radioPrimaryOwnerRequest{
+			Schema: cPrimaryOwnerSchema, Source: "spotify", Owner: &owner, Writer: &writer.Wire,
+		})
+		if err != nil || ack.Output.Process != request.CProcess || request.Receivers[ack.Output.DeviceID] != ack.Output.DeviceIncarnation {
+			return nil, ErrAliasConflict
+		}
+		source, playbackState, sourceRoom = "spotify", "playing", owner.RoomID
+		if p.state.player.IsPaused {
+			playbackState = "stopped"
+		}
+	} else {
+		proof, err := app.radioAbsenceSource()
+		if err != nil {
+			return nil, err
+		}
+		valid := false
+		for _, target := range state.Targets {
+			if request.Receivers[target.HomePodID] == "" {
+				continue
+			}
+			ack, err := p.primaryRadioReadOwner(ctx, target.HomePodID, radioPrimaryOwnerRequest{Schema: cPrimaryOwnerSchema, Source: "none", Absence: &proof})
+			if err == nil && ack.Target.Process == request.CProcess && request.Receivers[target.HomePodID] == ack.Target.Incarnation {
+				valid = true
+				break
+			}
+		}
+		if !valid {
+			return nil, ErrAliasConflict
+		}
+	}
+	for i, target := range state.Targets {
+		// A verified roster must distinguish unavailable outputs from the
+		// unverified protocol envelope. One refused receiver must not close
+		// other proven targets in the Manager's same-roster refresh.
+		state.Targets[i].Availability, state.Targets[i].Selectable = "unavailable", false
+		incarnation := request.Receivers[target.HomePodID]
+		if incarnation == "" || p.primaryRadioRoom(target.ID) != target.HomePodID {
+			continue
+		}
+		if parked != nil && held == nil {
+			if target.ID == sourceRoom && target.HomePodID == parkedRelease.DeviceID {
+				state.Targets[i].Availability, state.Targets[i].Selectable = "available", true
+			}
+			continue
+		}
+		query := radioPrimaryStartWire{Schema: cPrimaryStartSchema, Phase: "target", radioPrimaryTarget: radioPrimaryTarget{Device: target.HomePodID}}
+		if session != nil {
+			query.Phase, query.Predecessor = "preflight_replace_target", session
+		} else if source == "spotify" && target.ID == sourceRoom {
+			query.Phase = "preflight_target"
+		}
+		ack, err := p.primaryRadioCStart(ctx, query, false)
+		if err == nil && ack.Process == request.CProcess && ack.Incarnation == incarnation {
+			state.Targets[i].Availability, state.Targets[i].Selectable = "available", true
+		}
+	}
+	if ctx.Err() != nil {
+		return nil, ctx.Err()
+	}
+	app.radio.mu.Lock()
+	stable := !app.radio.failed && state.Revision == strconv.FormatUint(app.radio.Intent, 10) &&
+		(held == nil || app.radio.Holds[sourceRoom] == held && held.Phase == "primary_active" && held.Primary != nil && *held.Primary == *session)
+	app.radio.mu.Unlock()
+	if !stable {
+		return nil, ErrAliasConflict
+	}
+	now := time.Now().Unix()
+	state.Session = session
+	state.Observation = &radioPrimaryObservation{State: playbackState, Source: source, Target: sourceRoom, OwnerGeneration: generation, ObservedAt: now, ValidUntil: now + 3}
+	if held != nil {
+		state.Observation.Station = held.PrimaryStatus.Request.Station
+	}
+	if releaseBinding != nil && source != "radio" && volumeUUID.MatchString(releaseAction) && releaseCSeq > 0 {
+		state.ReleasedSession, state.ReleaseActionID, state.TeardownCSeq = releaseBinding, &releaseAction, &releaseCSeq
+	}
+	return state, nil
+}
diff --git a/daemon/radio_primary_park.go b/daemon/radio_primary_park.go
new file mode 100644
index 0000000000000000000000000000000000000000..3d05ad7201a0a5dbb1dfdb18ed4cbd06288f80ac
--- /dev/null
+++ b/daemon/radio_primary_park.go
@@ -0,0 +1,183 @@
+package daemon
+
+import (
+	"context"
+	"strconv"
+	"strings"
+)
+
+const cPrimaryParkSchema = "podconnect.output_primary_spotify_park.v1"
+
+type radioPrimaryParkWire struct {
+	Schema   string                `json:"schema"`
+	Phase    string                `json:"phase"`
+	Action   string                `json:"action"`
+	Revision string                `json:"native_revision"`
+	Owner    roomTransportIdentity `json:"native_owner"`
+	Writer   queueWriterWire       `json:"writer_proof"`
+	Route    *roomVolumeRoute      `json:"output_identity,omitempty"`
+	Token    string                `json:"token,omitempty"`
+}
+
+type radioPrimaryParkReceipt struct {
+	radioPrimaryParkWire
+	RequiresPause bool `json:"requires_native_pause"`
+	StopCSeq      int  `json:"stop_cseq,omitempty"`
+}
+
+func (p *AppPlayer) primaryRadioParkCall(ctx context.Context, wire radioPrimaryParkWire, target radioPrimaryTarget) (radioPrimaryParkReceipt, error) {
+	var ack radioPrimaryParkReceipt
+	endpoint := strings.TrimSuffix(p.app.cfg.RoomTransportOwnToneURL, "/") + "/api/outputs/" + target.Device + "/radio-handoff/reacquire"
+	err := radioAuthenticatedHTTP(ctx, endpoint, p.app.cfg.RadioHandoffControlToken, wire, &ack)
+	if err != nil {
+		return ack, err
+	}
+	if ack.Schema != wire.Schema || ack.Action != wire.Action || ack.Revision != wire.Revision ||
+		ack.Owner != wire.Owner || ack.Writer != wire.Writer || !ack.RequiresPause || !volumeHex32.MatchString(ack.Token) ||
+		ack.Route == nil || !ack.Route.valid() || ack.Route.Process != target.Process || ack.Route.DeviceID != target.Device ||
+		ack.Route.DeviceIncarnation != target.Incarnation || ack.Route.SessionEpoch != target.Epoch ||
+		ack.Route.RouteRevision != target.Route || ack.Route.InputPathDigest != wire.Writer.InputDigest {
+		return ack, ErrAliasConflict
+	}
+	if wire.Phase == "prepare" {
+		if ack.Phase != "prepared" || ack.StopCSeq != 0 {
+			return ack, ErrAliasConflict
+		}
+	} else if wire.Route == nil || *wire.Route != *ack.Route || wire.Token != ack.Token ||
+		(ack.Phase != "pending" || ack.StopCSeq != 0) && (ack.Phase != "parked" || ack.StopCSeq <= 0) {
+		return ack, ErrAliasConflict
+	}
+	return ack, nil
+}
+
+func (p *AppPlayer) primaryRadioPrepareStation(ctx context.Context, r radioPrimaryCommand, h *radioHold, device string) (any, error) {
+	op := h.PrimaryPending
+	if h.Phase == "primary_rejected" && r.Phase == "result" && r.ForPhase == "prepare_start" &&
+		op.Started == nil && r.Session == nil && op.Station == r.Station {
+		r.Phase = "rejected"
+		return radioPrimaryReply{radioPrimaryCommand: r}, nil
+	}
+	if h.Phase != "primary_reserved" || r.Session != nil || !nativeOwnerASCII(r.Station, 31) {
+		return nil, ErrAliasConflict
+	}
+	if r.Phase == "prepare_start" {
+		if r.ForPhase != "" || op.Target != nil {
+			return nil, ErrAliasConflict
+		}
+		phase := "target"
+		if room, err := p.radioIntentTarget(nil); p.primaryStream != nil && err == nil && room == r.Target {
+			phase, op.SameTarget = "preflight_target", true
+		}
+		ack, err := p.primaryRadioCStart(ctx, radioPrimaryStartWire{Schema: cPrimaryStartSchema, Phase: phase, radioPrimaryTarget: radioPrimaryTarget{Device: device}}, op.SameTarget)
+		if err != nil {
+			return nil, err
+		}
+		op.Target, op.Station = &ack.radioPrimaryTarget, r.Station
+		if err = p.app.persistRadioLocked(); err != nil {
+			return nil, err
+		}
+	}
+	if op.Target == nil || op.Station != r.Station || op.Target.Device != device {
+		return nil, ErrAliasConflict
+	}
+	r.Phase, op.Decoded = "prepared", !op.SameTarget
+	if !op.SameTarget {
+		return radioPrimaryReply{radioPrimaryCommand: r}, nil
+	}
+
+	phase := "result"
+	if r.ForPhase == "" {
+		phase = "preflight"
+	}
+	ack, err := p.primaryRadioCStart(ctx, radioPrimaryStartWire{
+		Schema: cPrimaryStartSchema, Phase: phase, Action: r.Action, Station: r.Station, Generation: r.Generation, radioPrimaryTarget: *op.Target,
+	}, true)
+	if err != nil {
+		return nil, err
+	}
+	switch ack.Phase {
+	case "pending":
+		r.Phase = "pending"
+	case "decoded":
+		op.Decoded = true
+		if err = p.app.persistRadioLocked(); err != nil {
+			return nil, err
+		}
+	case "rejected":
+		r.Phase, h.Phase = "rejected", "primary_rejected"
+		if err = p.app.persistRadioLocked(); err != nil {
+			return nil, err
+		}
+	default:
+		return nil, ErrAliasConflict
+	}
+	return radioPrimaryReply{radioPrimaryCommand: r}, nil
+}
+
+// Existing Native reservation owns exactly one preflight, park confirm and
+// decoder activation. Reads can settle a pending step, but never resend it.
+func (p *AppPlayer) primaryRadioAdvancePark(ctx context.Context, h *radioHold, r radioPrimaryCommand, wire radioPrimaryStartWire, begin bool) (radioPrimaryStartReceipt, error) {
+	op, app := h.PrimaryPending, p.app
+	if op.ActivationSent {
+		wire.Phase = "result"
+		return p.primaryRadioCStart(ctx, wire, true)
+	}
+
+	if begin {
+		owner, err := p.radioSourceOwner()
+		if err != nil || owner.RoomID != r.Target || owner.HomePodID != wire.Device || p.primaryStream == nil {
+			return radioPrimaryStartReceipt{}, ErrAliasConflict
+		}
+		writer, err := p.captureQueueWriter(ctx, owner, nil)
+		if err != nil {
+			return radioPrimaryStartReceipt{}, err
+		}
+		revision, err := p.nextNativeIntent()
+		if err != nil {
+			return radioPrimaryStartReceipt{}, err
+		}
+		ack, err := p.primaryRadioParkCall(ctx, radioPrimaryParkWire{
+			Schema: cPrimaryParkSchema, Phase: "prepare", Action: r.Action, Revision: revision, Owner: owner, Writer: writer.Wire,
+		}, *op.Target)
+		if err != nil {
+			return radioPrimaryStartReceipt{}, err
+		}
+		h.PrimaryPark, h.primary, h.RequiresPause, h.PauseUncertain = &ack.radioPrimaryParkWire, p.primaryStream, true, true
+		paused := p.state.player.IsPaused
+		h.PausedBefore = &paused
+		app.radioOutputFence.Store(true)
+		if err = app.persistRadioLocked(); err != nil {
+			return radioPrimaryStartReceipt{}, err
+		}
+		generation, _ := strconv.ParseUint(revision, 10, 64)
+		if err = p.pauseAndParkRadioWriter(ctx, h, ack.Token, generation, writer.Wire); err != nil {
+			return radioPrimaryStartReceipt{}, err
+		}
+	}
+	park := h.PrimaryPark
+	if park == nil || !h.WriterParked || h.PauseUncertain || h.primary == nil || p.primaryStream != h.primary {
+		return radioPrimaryStartReceipt{}, ErrAliasConflict
+	}
+	if owner, err := p.radioSourceOwner(); err != nil || owner != park.Owner {
+		return radioPrimaryStartReceipt{}, ErrAliasConflict
+	}
+	query := *park
+	query.Phase = "result"
+	if begin {
+		query.Phase = "confirm"
+	}
+	ack, err := p.primaryRadioParkCall(ctx, query, *op.Target)
+	if err != nil {
+		return radioPrimaryStartReceipt{}, err
+	}
+	if ack.Phase == "pending" {
+		return radioPrimaryStartReceipt{radioPrimaryStartWire: radioPrimaryStartWire{Phase: "pending"}}, nil
+	}
+
+	op.ActivationSent = true
+	if err = app.persistRadioLocked(); err != nil {
+		return radioPrimaryStartReceipt{}, err
+	}
+	wire.Phase, wire.ParkToken = "activate", park.Token
+	return p.primaryRadioCStart(ctx, wire, true)
+}
diff --git a/daemon/radio_primary_park_test.go b/daemon/radio_primary_park_test.go
