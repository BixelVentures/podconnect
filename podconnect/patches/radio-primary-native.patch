+package daemon
+
+import (
+	"context"
+	"strconv"
+	"strings"
+	"time"
+)
+
+const primaryRadioStopSchema = "podconnect.output_radio_primary_stop.v1"
+
+type radioPrimaryBinding struct {
+	Process     string `json:"process"`
+	Operation   string `json:"operation"`
+	DeviceID    string `json:"device_id"`
+	Incarnation string `json:"incarnation"`
+	Epoch       string `json:"session_epoch"`
+	Route       string `json:"route_revision"`
+}
+
+func (b radioPrimaryBinding) valid() bool {
+	return volumeUUID.MatchString(b.Process) && volumeUUID.MatchString(b.Operation) &&
+		volumeCounter(b.DeviceID) && b.DeviceID != "0" &&
+		volumeCounter(b.Incarnation) && b.Incarnation != "0" &&
+		volumeCounter(b.Epoch) && b.Epoch != "0" && volumeCounter(b.Route)
+}
+
+type radioPrimaryStopRequest struct {
+	Schema string `json:"schema"`
+	Phase  string `json:"phase"`
+	Action string `json:"action"`
+	radioPrimaryBinding
+}
+
+type radioPrimaryStopReceipt struct {
+	radioPrimaryStopRequest
+	TeardownCSeq int `json:"teardown_cseq"`
+}
+
+func validPrimaryRadioHold(h *radioHold) bool {
+	r := h.Request
+	return h.Primary != nil && h.Primary.valid() && r.Schema == "podconnect.native_radio_primary_hold.v1" &&
+		nativeOwnerASCII(r.TargetID, 255) && volumeHex64.MatchString(r.ProcessID) &&
+		volumeUUID.MatchString(r.ActionID) && volumeCounter(r.ExpectedRevision) &&
+		volumeUUID.MatchString(r.HandoffID) && volumeCounter(r.Generation) && r.Generation != "0" &&
+		r.ActionID == h.Primary.Operation &&
+		r.Peer == (radioPeer{}) && r.Token == "" && h.Actions != nil &&
+		(h.PrimaryAction == "" || volumeUUID.MatchString(h.PrimaryAction)) &&
+		h.Absence == nil && h.Parked == nil &&
+		(!h.WriterParked && !h.PauseUncertain && !h.RequiresPause ||
+			h.PrimaryPark != nil && h.WriterParked && !h.PauseUncertain && h.RequiresPause)
+}
+
+// Exactly one effectful claim is permitted. A pending result can be read
+// within the original action deadline. A lost reply is never sent again.
+func radioPrimaryDrain(ctx context.Context, endpoint, token string, binding radioPrimaryBinding, action string, current func() bool) (radioPrimaryStopReceipt, error) {
+	if !binding.valid() || !volumeUUID.MatchString(action) {
+		return radioPrimaryStopReceipt{}, ErrAliasConflict
+	}
+	r := radioPrimaryStopRequest{Schema: primaryRadioStopSchema, Phase: "claim_stop", Action: action, radioPrimaryBinding: binding}
+	tick := time.NewTicker(30 * time.Millisecond)
+	defer tick.Stop()
+	for {
+		if ctx.Err() != nil || !current() {
+			return radioPrimaryStopReceipt{}, ErrAliasConflict
+		}
+		var ack radioPrimaryStopReceipt
+		if err := radioAuthenticatedHTTP(ctx, endpoint, token, r, &ack); err != nil {
+			return radioPrimaryStopReceipt{}, err
+		}
+		if ctx.Err() != nil || !current() || ack.Schema != r.Schema || ack.Action != action || ack.radioPrimaryBinding != binding {
+			return radioPrimaryStopReceipt{}, ErrAliasConflict
+		}
+		if ack.Phase == "released" && ack.TeardownCSeq > 0 {
+			return ack, nil
+		}
+		if ack.Phase != "pending" || ack.TeardownCSeq != 0 {
+			return radioPrimaryStopReceipt{}, ErrAliasConflict
+		}
+		r.Phase = "result"
+		select {
+		case <-ctx.Done():
+			return radioPrimaryStopReceipt{}, ctx.Err()
+		case <-tick.C:
+		}
+	}
+}
+
+func (p *AppPlayer) preemptPrimaryRadio(parent context.Context, target string, h *radioHold) error {
+	app := p.app
+	app.radio.mu.Lock()
+	if app.radio.failed || app.radio.Holds[target] != h || h.owner != p || h.Phase != "primary_active" || h.PrimaryAction != "" || h.PrimaryPark != nil || !validPrimaryRadioHold(h) {
+		app.radio.mu.Unlock()
+		return ErrAliasConflict
+	}
+	binding, intent := *h.Primary, app.radio.Intent
+	app.radio.mu.Unlock()
+	owner, intended, err := p.radioOwnersForIntent(target)
+	if err != nil || intended.HomePodID != binding.DeviceID {
+		return ErrAliasConflict
+	}
+	revision, err := p.nextNativeIntent()
+	if err != nil {
+		return err
+	}
+	id, err := randomQueueID(16)
+	if err != nil {
+		return err
+	}
+	action := id[:8] + "-" + id[8:12] + "-" + id[12:16] + "-" + id[16:20] + "-" + id[20:]
+	app.radio.mu.Lock()
+	if app.radio.failed || app.radio.Intent != intent || app.radio.Holds[target] != h || h.owner != p ||
+		h.Phase != "primary_active" || h.PrimaryAction != "" || h.Primary == nil || *h.Primary != binding {
+		app.radio.mu.Unlock()
+		return ErrAliasConflict
+	}
+	h.Phase, h.PrimaryAction = "reacquiring", action
+	err = app.persistRadioLocked()
+	app.radio.mu.Unlock()
+	if err != nil {
+		return err
+	}
+	succeeded := false
+	defer func() {
+		if !succeeded {
+			app.radio.mu.Lock()
+			if app.radio.Holds[target] == h && h.PrimaryAction == action {
+				h.Phase = "unknown"
+				_ = app.persistRadioLocked()
+			}
+			app.radio.mu.Unlock()
+		}
+	}()
+	ctx, cancel := context.WithTimeout(parent, 8*time.Second)
+	defer cancel()
+	intentCurrentLocked := func() bool {
+		return !app.radio.failed && !p.aliasRetired && strconv.FormatUint(p.roomNativeIntent, 10) == revision &&
+			p.aliasRevision == owner.AliasRevision && p.aliasIncarnation == owner.AliasIncarnation &&
+			p.aliasFingerprint == owner.AliasRegistry && p.spotConnId == owner.ConnectionID &&
+			p.state != nil && p.state.player != nil && p.state.player.SessionId == owner.SessionID &&
+			app.radio.Intent == intent && app.radio.Holds[target] == h && h.Primary != nil && *h.Primary == binding &&
+			h.Phase == "reacquiring" && h.PrimaryAction == action
+	}
+	current := func() bool {
+		nowOwner, nowIntended, err := p.radioOwnersForIntent(target)
+		if err != nil || nowOwner != owner || nowIntended != intended {
+			return false
+		}
+		p.aliasMu.Lock()
+		defer p.aliasMu.Unlock()
+		app.radio.mu.Lock()
+		defer app.radio.mu.Unlock()
+		return intentCurrentLocked()
+	}
+	endpoint := strings.TrimSuffix(app.cfg.RoomTransportOwnToneURL, "/") + "/api/outputs/" + binding.DeviceID + "/radio-handoff/reacquire"
+	ack, err := radioPrimaryDrain(ctx, endpoint, app.cfg.RadioHandoffControlToken, binding, action, current)
+	if err != nil {
+		return err
+	}
+	p.aliasMu.Lock()
+	defer p.aliasMu.Unlock()
+	app.radio.mu.Lock()
+	defer app.radio.mu.Unlock()
+	if ctx.Err() != nil || !intentCurrentLocked() {
+		return ErrAliasConflict
+	}
+	h.Phase, h.PrimaryPending.Released = "primary_released", ack.TeardownCSeq
+	if err = app.persistRadioLocked(); err != nil {
+		h.Phase, h.PrimaryPending.Released = "reacquiring", 0
+		return err
+	}
+	succeeded = true
+	return nil
+}
