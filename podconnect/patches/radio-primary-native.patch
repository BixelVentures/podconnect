+		q.Phase, q.Station, q.Owner = "reserve", "", ""
+		q.Handoff, q.Generation, q.Action = "bdb0c4c5-df0e-4f42-a88e-44a8736ca5b8", "2", stopAction
+		q.Owner = wait(q, "reserved").Owner
