+	q := radioPrimaryCommand{Schema: nativePrimarySchema, Phase: "reserve", Process: radioProcessID(process),
+		Handoff: "a411aa42-8b70-4bf4-a37d-81b0519db7df", Generation: "1", Action: startAction,
+		Target: owner.RoomID, Intent: strconv.FormatUint(app.radio.Intent, 10), From: owner.RoomID}
