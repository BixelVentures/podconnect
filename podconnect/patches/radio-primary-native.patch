@@ -0,0 +1,200 @@
+package daemon
+
+import (
+	"context"
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"path/filepath"
+	"sync/atomic"
+	"testing"
+)
+
+func TestPrimaryRadioActorConsumesOnlyExactPeerIsolation(t *testing.T) {
+	p, op := contentFixture(t)
+	p.app.cfg.RadioHandoffStatePath = filepath.Join(t.TempDir(), "radio.json")
+	p.app.cfg.RadioHandoffControlToken = "inert-test-token"
+	p.state.player.IsPaused = true
+	queue := p.state.tracks
+	queueRevision := queue.TransportRevision()
+	const cProcess = "a411aa42-8b70-4bf4-a37d-81b0519db7df"
+	const oldAction = "b3919fea-955b-4d4c-a581-c71cb92712b2"
+	const newAction = "87f6f7dd-2a03-4d75-9a62-6a7a2e089705"
+	room, device := op.Capture.OldOwner.RoomID, op.Capture.OldOwner.HomePodID
+	binding := radioPrimaryBinding{Process: cProcess, DeviceID: device, Operation: oldAction, Incarnation: "4", Epoch: "9", Route: "8"}
+	isolation := radioPrimaryIsolation{binding, "rtsp_control_lost"}
+	idle := radioPrimaryTarget{Process: cProcess, Device: device, Incarnation: "4", Epoch: "10", Route: "8"}
+	successor := binding
+	successor.Operation, successor.Epoch = newAction, "11"
+	park := &radioPrimaryParkWire{Token: "retained-park-fixture"}
+	old := radioPrimaryCommand{Schema: nativePrimarySchema, Phase: "reserve", Process: radioProcessID(op.Capture.Process),
+		Handoff: cProcess, Generation: "1", Owner: "1", Action: oldAction, Target: room, Intent: "0", From: room}
+	h := &radioHold{Phase: "primary_active", owner: p, primary: p.primaryStream, Primary: &binding,
+		PrimaryStatus: &radioPrimaryActive{OwnerGeneration: "1", Request: radioPrimaryStartWire{
+			Schema: cPrimaryStartSchema, Action: oldAction, Station: "p3", Generation: "1", radioPrimaryTarget: idle}},
+		PrimaryPark: park, WriterParked: true, RequiresPause: true, Actions: map[string]bool{},
+		Request: radioRequest{Schema: "podconnect.native_radio_primary_hold.v1", ProcessID: old.Process, TargetID: room,
+			HandoffID: old.Handoff, Generation: old.Generation, ActionID: old.Action, ExpectedRevision: old.Intent},
+		PrimaryPending: &radioPrimaryPending{Reserve: old}}
+	p.app.radio.Holds, p.app.radio.Generation = map[string]*radioHold{room: h}, 1
+	var wrongProof atomic.Bool
+	var effects atomic.Int32
+	wrongProof.Store(true)
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, req *http.Request) {
+		var wire radioPrimaryStartWire
+		if req.URL.Path != "/api/outputs/"+device+"/radio-handoff/reacquire" ||
+			req.Header.Get("X-PodConnect-Token") != "inert-test-token" || json.NewDecoder(req.Body).Decode(&wire) != nil ||
+			wire.Device != device || wire.Schema != cPrimaryStartSchema {
+			t.Error("unexpected receiver or authority")
+			w.WriteHeader(http.StatusBadRequest)
+			return
+		}
+		ack := radioPrimaryStartReceipt{radioPrimaryStartWire: wire}
+		switch wire.Phase {
+		case "readiness":
+			w.WriteHeader(http.StatusConflict)
+			return
+		case "observe_isolation":
+			proof := isolation
+			if wrongProof.Load() {
+				proof.Operation = newAction
+			}
+			ack.Phase, ack.radioPrimaryTarget, ack.Isolation = "isolated", idle, &proof
+		case "preflight_replace_target", "preflight_replace", "activate_replace", "result":
+			if !wire.PriorIsolation.matches(&binding) || wire.Predecessor == nil || *wire.Predecessor != binding ||
+				wire.PriorRelease != nil {
+				t.Error("successor failed to bind exact predecessor isolation")
+				w.WriteHeader(http.StatusConflict)
+				return
+			}
+			switch wire.Phase {
+			case "preflight_replace_target":
+				ack.Phase, ack.radioPrimaryTarget = "target_ready", idle
+			case "preflight_replace":
+				effects.Add(1)
+				ack.Phase = "decoded"
+			case "activate_replace":
+				effects.Add(1)
+				if wire.ParkToken != park.Token {
+					t.Error("activation lost existing parked writer token")
+				}
+				ack.Phase, ack.ParkToken = "pending", ""
+			case "result":
+				ack.Phase, ack.Session = "playing", &successor
+			}
+		default:
+			t.Errorf("unexpected request phase %q", wire.Phase)
+			w.WriteHeader(http.StatusConflict)
+			return
+		}
+		_ = json.NewEncoder(w).Encode(ack)
+	}))
+	defer server.Close()
+	p.app.cfg.RoomTransportOwnToneURL = server.URL
+
+	ctx := context.Background()
+	state := radioPrimaryReadinessState{Revision: "0", Process: old.Process,
+		Targets: []radioTarget{{ID: room, HomePodID: device}}}
+	observe := func() (any, error) {
+		return p.radioPrimaryActorState(ctx, radioPrimaryActorStateRequest{
+			State: state, CProcess: cProcess, Receivers: map[string]string{device: binding.Incarnation}})
+	}
+	if _, err := observe(); err == nil || h.Phase != "primary_active" || effects.Load() != 0 {
+		t.Fatal("wrong-operation isolation changed the active hold")
+	}
+	wrongProof.Store(false)
+	raw, err := observe()
+	got, ok := raw.(radioPrimaryReadinessState)
+	if err != nil || !ok || got.Revision != "1" || got.Observation == nil || got.Observation.Source != "none" ||
+		got.Observation.State != "stopped" || got.Observation.OwnerGeneration != 1 || got.Session != nil ||
+		!got.IsolatedSession.matches(&binding) || got.ReleasedSession != nil || !got.Targets[0].Selectable ||
+		!primaryRadioIsolated(h) || !h.WriterParked || effects.Load() != 0 {
+		t.Fatalf("exact observation did not preserve custody and isolate at a new revision: %v", err)
+	}
+	state.Revision = got.Revision
+	if repeated, err := observe(); err != nil || repeated.(radioPrimaryReadinessState).Revision != state.Revision {
+		t.Fatal("repeated passive observation did not retain the isolated revision")
+	}
+	r := old
+	r.Action, r.Generation, r.Owner = newAction, "2", ""
+	if _, err := p.radioPrimaryActor(ctx, r); err == nil {
+		t.Fatal("old observation revision admitted an effect")
+	}
+	r.Intent = got.Revision
+	ask := func(phase string) radioPrimaryReply {
+		t.Helper()
+		raw, err := p.radioPrimaryActor(ctx, r)
+		ack, ok := raw.(radioPrimaryReply)
+		if err != nil || !ok || ack.Phase != phase {
+			t.Fatalf("wanted %s for %s, got %s (%v)", phase, r.Phase, ack.Phase, err)
+		}
+		return ack
+	}
+	r.Owner = ask("reserved").Owner
+	r.Phase, r.Station = "prepare_start", "p1"
+	ask("prepared")
+	r.Phase = "start"
+	ask("pending")
+	if _, err := p.radioPrimaryActor(ctx, r); err == nil {
+		t.Fatal("duplicate activation admitted")
+	}
+	r.Phase, r.ForPhase = "result", "start"
+	ack := ask("playing")
+	ask("playing")
+	if ack.Session == nil || *ack.Session != successor || effects.Load() != 2 || h.PrimaryIsolation != nil ||
+		!h.WriterParked || p.primaryStream != op.Capture.Primary || p.state.tracks != queue || queue.TransportRevision() != queueRevision ||
+		!p.state.player.IsPaused {
+		t.Fatal("successor replayed or disturbed parked Spotify custody")
+	}
+}
+
+func TestPrimaryRadioReturnRequiresExactIsolationWithoutStopReceipt(t *testing.T) {
+	p, op := contentFixture(t)
+	p.app.cfg.RadioHandoffControlToken = "inert-test-token"
+	const cProcess = "a411aa42-8b70-4bf4-a37d-81b0519db7df"
+	const radioAction = "b3919fea-955b-4d4c-a581-c71cb92712b2"
+	const returnIntent = "87f6f7dd-2a03-4d75-9a62-6a7a2e089705"
+	binding := radioPrimaryBinding{Process: cProcess, DeviceID: "101", Operation: radioAction, Incarnation: "4", Epoch: "9", Route: "8"}
+	proof := radioPrimaryIsolation{binding, "rtsp_control_lost"}
+	old := roomVolumeRoute{Process: cProcess, DeviceID: binding.DeviceID, DeviceIncarnation: "4",
+		SessionEpoch: "7", RouteRevision: "7", SelectionRevision: "5", InputGeneration: "1", InputItemID: "1",
+		InputPathDigest: op.Capture.PipeDigest}
+	next := old
+	next.SessionEpoch, next.RouteRevision, next.SelectionRevision = "11", "9", "8"
+	var wrongEcho atomic.Bool
+	var requests atomic.Int32
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, req *http.Request) {
+		requests.Add(1)
+		var wire radioPrimaryReturnWire
+		if req.URL.Path != "/api/outputs/101/radio-handoff/reacquire" ||
+			req.Header.Get("X-PodConnect-Token") != "inert-test-token" ||
+			json.NewDecoder(req.Body).Decode(&wire) != nil || wire.Release != nil ||
+			!wire.Isolation.matches(&binding) || wire.Intent != returnIntent || wire.Phase != "consume" {
+			t.Error("return lost exact isolation or introduced a STOP receipt")
+			w.WriteHeader(http.StatusConflict)
+			return
+		}
+		ack := radioPrimaryReturnReceipt{radioPrimaryReturnWire: wire, Route: &next}
+		ack.Phase = "route_ready"
+		if wrongEcho.Load() {
+			ack.Isolation.Operation = returnIntent
+		}
+		_ = json.NewEncoder(w).Encode(ack)
+	}))
+	defer server.Close()
+	p.app.cfg.RoomTransportOwnToneURL = server.URL
+	ctx := context.Background()
+	wire := radioPrimaryReturnWire{Schema: cPrimaryReturnSchema, Phase: "consume", Intent: returnIntent,
+		Revision: "5", Park: radioPrimaryParkWire{Route: &old}, Isolation: &proof}
+	if ack, err := p.primaryRadioReturnCall(ctx, wire); err != nil || ack.Phase != "route_ready" {
+		t.Fatalf("valid isolation return rejected: %v", err)
+	}
+	wrongEcho.Store(true)
+	if _, err := p.primaryRadioReturnCall(ctx, wire); err == nil {
+		t.Fatal("return accepted a different lost radio operation")
+	}
+	wire.Release = &radioPrimaryStopReceipt{TeardownCSeq: 42}
+	if _, err := p.primaryRadioReturnCall(ctx, wire); err == nil || requests.Load() != 2 {
+		t.Fatal("ambiguous dual proof reached C")
+	}
+}
diff --git a/daemon/radio_primary_observation.go b/daemon/radio_primary_observation.go
new file mode 100644
index 0000000..a82c78f
--- /dev/null
+++ b/daemon/radio_primary_observation.go
@@ -0,0 +1,289 @@
+package daemon
+
+import (
+	"context"
+	"strconv"
+	"strings"
+	"time"
+)
+
+const (
+	apiRadioPrimaryActorState ApiRequestType = "radio_primary_actor_state"
+	cPrimaryOwnerSchema                      = "podconnect.output_primary_radio_owner_observation.v1"
+)
+
+type radioPrimaryOwnerRequest struct {
+	Schema  string                 `json:"schema"`
+	Source  string                 `json:"source_kind"`
+	Owner   *roomTransportIdentity `json:"native_owner,omitempty"`
+	Writer  *queueWriterWire       `json:"writer_proof,omitempty"`
+	Absence *radioAbsenceSource    `json:"source_absence,omitempty"`
+}
+
+type radioPrimaryOwnerReceipt struct {
+	radioPrimaryOwnerRequest
+	Output   *roomVolumeRoute    `json:"output_identity,omitempty"`
+	Target   *radioPrimaryTarget `json:"target_identity,omitempty"`
+	Physical *bool               `json:"physical_result_verified"`
+}
+
+type radioPrimaryActorStateRequest struct {
+	State     radioPrimaryReadinessState
+	CProcess  string
+	Receivers map[string]string
+}
+
+func (app *App) primaryRadioActorAsk(ctx context.Context, kind ApiRequestType, call any) (any, error) {
+	app.ownerMu.Lock()
+	ch, done := app.currentAPI, app.currentDone
+	app.ownerMu.Unlock()
+	if ch == nil || done == nil {
+		return nil, ErrAliasConflict
+	}
+	request, wait := NewApiRequest(kind, call)
+	select {
+	case ch <- request:
+		return wait(ctx)
+	case <-done:
+		return nil, ErrAliasConflict
+	case <-ctx.Done():
+		return nil, ctx.Err()
+	}
+}
+
+func (p *AppPlayer) primaryRadioReadOwner(ctx context.Context, device string, query radioPrimaryOwnerRequest) (radioPrimaryOwnerReceipt, error) {
+	var ack radioPrimaryOwnerReceipt
+	endpoint := strings.TrimSuffix(p.app.cfg.RoomTransportOwnToneURL, "/") + "/api/outputs/" + device + "/radio-handoff/primary-owner"
+	if err := radioAuthenticatedHTTP(ctx, endpoint, p.app.cfg.RadioHandoffControlToken, query, &ack); err != nil {
+		return ack, err
+	}
+	if ack.Schema != query.Schema || ack.Source != query.Source || ack.Physical == nil || *ack.Physical {
+		return ack, ErrAliasConflict
+	}
+	switch query.Source {
+	case "spotify":
+		if ack.Owner == nil || ack.Writer == nil || ack.Absence != nil || ack.Target != nil || ack.Output == nil ||
+			!ack.Output.valid() || ack.Output.DeviceID != device || *ack.Owner != *query.Owner || *ack.Writer != *query.Writer ||
+			ack.Output.InputPathDigest != query.Writer.InputDigest {
+			return ack, ErrAliasConflict
+		}
+	case "none":
+		if ack.Owner != nil || ack.Writer != nil || ack.Absence == nil || ack.Absence.Live != nil || ack.Output != nil ||
+			ack.Target == nil || !ack.Target.valid() || ack.Target.Device != device || *ack.Absence != *query.Absence {
+			return ack, ErrAliasConflict
+		}
+	default:
+		return ack, ErrAliasConflict
+	}
+	return ack, nil
+}
+
+// The same Native actor owns source observation and effects. No persisted hold
+// becomes a new authority after restart, and a paused writer remains Spotify.
+func (p *AppPlayer) radioPrimaryActorState(ctx context.Context, request radioPrimaryActorStateRequest) (any, error) {
+	app, state := p.app, request.State
+	if ctx.Err() != nil || p.state == nil || p.state.player == nil || app.manualReleasePending() {
+		return nil, ErrAliasConflict
+	}
+	app.radio.mu.Lock()
+	generation := app.radio.Generation
+	if app.radio.failed || state.Revision != strconv.FormatUint(app.radio.Intent, 10) {
+		app.radio.mu.Unlock()
+		return nil, ErrAliasConflict
+	}
+	var held *radioHold
+	var parked *radioHold
+	var parkedRelease radioPrimaryStopReceipt
+	var releaseBinding *radioPrimaryBinding
+	var releaseAction string
+	var releaseCSeq int
+	var releaseGeneration uint64
+	for _, h := range app.radio.Holds {
+		if primaryRadioReleased(h) {
+			if h.WriterParked {
+				release, ok := primaryParkedStopReceipt(h)
+				if !ok || parked != nil || h.owner != p || h.primary == nil || p.primaryStream != h.primary {
+					app.radio.mu.Unlock()
+					return nil, ErrAliasConflict
+				}
+				parked, parkedRelease = h, release
+			}
+			if h.Request.ProcessID != state.Process {
+				continue
+			}
+			candidateGeneration, _ := strconv.ParseUint(h.Request.Generation, 10, 64)
+			if candidateGeneration > releaseGeneration {
+				releaseGeneration = candidateGeneration
+				binding := *h.Primary
+				releaseBinding, releaseCSeq = &binding, h.PrimaryPending.Released
+				releaseAction = h.PrimaryAction
+				if releaseAction == "" && h.PrimaryPending.Stopped != nil {
+					releaseAction = h.PrimaryPending.Stopped.Action
+				}
+			}
+			continue
+		}
+		if primaryRadioRetired(h) {
+			continue
+		}
+		if h == nil || h.owner != p || h.PrimaryStatus == nil || h.Primary == nil || h.Phase != "primary_active" && !primaryRadioIsolated(h) || held != nil {
+			app.radio.mu.Unlock()
+			return nil, ErrAliasConflict
+		}
+		held = h
+	}
+	app.radio.mu.Unlock()
+
+	source, playbackState, sourceRoom := "none", "idle", ""
+	var session *radioPrimaryBinding
+	var isolation *radioPrimaryIsolation
+	if held != nil {
+		proof := held.PrimaryStatus
+		query := proof.Request
+		query.Phase = "readiness"
+		generation, _ = strconv.ParseUint(proof.OwnerGeneration, 10, 64)
+		binding := held.Primary
+		if binding.Process != request.CProcess || request.Receivers[binding.DeviceID] != binding.Incarnation {
+			return nil, ErrAliasConflict
+		}
+		if !primaryRadioIsolated(held) {
+			ack, err := p.primaryRadioCStart(ctx, query, proof.SameTarget)
+			if err == nil && ack.Phase == "playing" && ack.Session != nil && *ack.Session == *binding {
+				source, playbackState, sourceRoom, session = "radio", "playing", held.Request.TargetID, ack.Session
+			}
+		}
+		if session == nil {
+			if held.PrimaryAction != "" || primaryReplacementPending(held) || !validPrimaryRadioHold(held) ||
+				held.PrimaryPark == nil || !held.WriterParked || held.primary == nil || p.primaryStream != held.primary ||
+				!p.state.player.IsPaused {
+				return nil, ErrAliasConflict
+			}
+			var err error
+			isolation, err = p.primaryRadioObserveIsolation(ctx, binding)
+			if err != nil {
+				return nil, ErrAliasConflict
+			}
+			playbackState, sourceRoom = "stopped", held.Request.TargetID
+		}
+	} else if parked != nil {
+		device := parkedRelease.DeviceID
+		ack, err := p.primaryRadioCStart(ctx, radioPrimaryStartWire{
+			Schema: cPrimaryStartSchema, Phase: "preflight_replace_target", radioPrimaryTarget: radioPrimaryTarget{Device: device},
+			Predecessor: &parkedRelease.radioPrimaryBinding, PriorRelease: primaryPreviousRelease(&parkedRelease),
+		}, false)
+		if err != nil || ack.Process != request.CProcess || request.Receivers[device] != ack.Incarnation {
+			return nil, ErrAliasConflict
+		}
+		source, playbackState, sourceRoom = "none", "stopped", parked.Request.TargetID
+	} else if p.primaryStream != nil {
+		owner, err := p.radioSourceOwner()
+		if err != nil {
+			return nil, err
+		}
+		writer, err := p.captureQueueWriter(ctx, owner, nil)
+		if err != nil {
+			return nil, err
+		}
+		ack, err := p.primaryRadioReadOwner(ctx, owner.HomePodID, radioPrimaryOwnerRequest{
+			Schema: cPrimaryOwnerSchema, Source: "spotify", Owner: &owner, Writer: &writer.Wire,
+		})
+		if err != nil || ack.Output.Process != request.CProcess || request.Receivers[ack.Output.DeviceID] != ack.Output.DeviceIncarnation {
+			return nil, ErrAliasConflict
+		}
+		source, playbackState, sourceRoom = "spotify", "playing", owner.RoomID
+		if p.state.player.IsPaused {
+			playbackState = "stopped"
+		}
+	} else {
+		proof, err := app.radioAbsenceSource()
+		if err != nil {
+			return nil, err
+		}
+		valid := false
+		for _, target := range state.Targets {
+			if request.Receivers[target.HomePodID] == "" {
+				continue
+			}
+			ack, err := p.primaryRadioReadOwner(ctx, target.HomePodID, radioPrimaryOwnerRequest{Schema: cPrimaryOwnerSchema, Source: "none", Absence: &proof})
+			if err == nil && ack.Target.Process == request.CProcess && request.Receivers[target.HomePodID] == ack.Target.Incarnation {
+				valid = true
+				break
+			}
+		}
+		if !valid {
+			return nil, ErrAliasConflict
+		}
+	}
+	for i, target := range state.Targets {
+		// A verified roster must distinguish unavailable outputs from the
+		// unverified protocol envelope. One refused receiver must not close
+		// other proven targets in the Manager's same-roster refresh.
+		state.Targets[i].Availability, state.Targets[i].Selectable = "unavailable", false
+		incarnation := request.Receivers[target.HomePodID]
+		if incarnation == "" || p.primaryRadioRoom(target.ID) != target.HomePodID {
+			continue
+		}
+		if parked != nil && held == nil {
+			if target.ID == sourceRoom && target.HomePodID == parkedRelease.DeviceID {
+				state.Targets[i].Availability, state.Targets[i].Selectable = "available", true
+			}
+			continue
+		}
+		query := radioPrimaryStartWire{Schema: cPrimaryStartSchema, Phase: "target", radioPrimaryTarget: radioPrimaryTarget{Device: target.HomePodID}}
+		if isolation != nil {
+			if target.ID != sourceRoom || target.HomePodID != isolation.DeviceID {
+				continue
+			}
+			query.Phase, query.Predecessor, query.PriorIsolation = "preflight_replace_target", held.Primary, isolation
+		} else if session != nil {
+			query.Phase, query.Predecessor = "preflight_replace_target", session
+		} else if source == "spotify" && target.ID == sourceRoom {
+			query.Phase = "preflight_target"
+		}
+		ack, err := p.primaryRadioCStart(ctx, query, false)
+		if err == nil && ack.Process == request.CProcess && ack.Incarnation == incarnation {
+			state.Targets[i].Availability, state.Targets[i].Selectable = "available", true
+		}
+	}
+	if ctx.Err() != nil {
+		return nil, ctx.Err()
+	}
+	app.radio.mu.Lock()
+	stable := !app.radio.failed && state.Revision == strconv.FormatUint(app.radio.Intent, 10)
+	if held != nil {
+		stable = stable && app.radio.Holds[sourceRoom] == held && held.Primary != nil &&
+			(session != nil && held.Phase == "primary_active" && *held.Primary == *session ||
+				isolation.matches(held.Primary) && (held.Phase == "primary_active" || primaryRadioIsolated(held)))
+	}
+	if stable && isolation != nil {
+		selectable := false
+		for _, target := range state.Targets {
+			selectable = selectable || target.ID == sourceRoom && target.Selectable
+		}
+		stable = selectable
+		if stable && !primaryRadioIsolated(held) {
+			if app.radio.Intent == ^uint64(0) {
+				stable = false
+			} else {
+				held.Phase, held.PrimaryIsolation = "primary_isolated", isolation
+				app.radio.Intent++
+				stable = app.persistRadioLocked() == nil
+			}
+		}
+		state.Revision = strconv.FormatUint(app.radio.Intent, 10)
+	}
+	app.radio.mu.Unlock()
+	if !stable {
+		return nil, ErrAliasConflict
+	}
+	now := time.Now().Unix()
+	state.Session, state.IsolatedSession = session, isolation
+	state.Observation = &radioPrimaryObservation{State: playbackState, Source: source, Target: sourceRoom, OwnerGeneration: generation, ObservedAt: now, ValidUntil: now + 3}
+	if session != nil {
+		state.Observation.Station = held.PrimaryStatus.Request.Station
+	}
+	if releaseBinding != nil && isolation == nil && source != "radio" && volumeUUID.MatchString(releaseAction) && releaseCSeq > 0 {
+		state.ReleasedSession, state.ReleaseActionID, state.TeardownCSeq = releaseBinding, &releaseAction, &releaseCSeq
+	}
+	return state, nil
+}
diff --git a/daemon/radio_primary_park.go b/daemon/radio_primary_park.go
new file mode 100644
index 0000000..3d05ad7
--- /dev/null
+++ b/daemon/radio_primary_park.go
@@ -0,0 +1,183 @@
+package daemon
+
+import (
+	"context"
+	"strconv"
+	"strings"
+)
+
+const cPrimaryParkSchema = "podconnect.output_primary_spotify_park.v1"
+
+type radioPrimaryParkWire struct {
+	Schema   string                `json:"schema"`
+	Phase    string                `json:"phase"`
+	Action   string                `json:"action"`
+	Revision string                `json:"native_revision"`
+	Owner    roomTransportIdentity `json:"native_owner"`
+	Writer   queueWriterWire       `json:"writer_proof"`
+	Route    *roomVolumeRoute      `json:"output_identity,omitempty"`
+	Token    string                `json:"token,omitempty"`
+}
+
+type radioPrimaryParkReceipt struct {
+	radioPrimaryParkWire
+	RequiresPause bool `json:"requires_native_pause"`
+	StopCSeq      int  `json:"stop_cseq,omitempty"`
+}
+
+func (p *AppPlayer) primaryRadioParkCall(ctx context.Context, wire radioPrimaryParkWire, target radioPrimaryTarget) (radioPrimaryParkReceipt, error) {
+	var ack radioPrimaryParkReceipt
+	endpoint := strings.TrimSuffix(p.app.cfg.RoomTransportOwnToneURL, "/") + "/api/outputs/" + target.Device + "/radio-handoff/reacquire"
+	err := radioAuthenticatedHTTP(ctx, endpoint, p.app.cfg.RadioHandoffControlToken, wire, &ack)
+	if err != nil {
+		return ack, err
+	}
+	if ack.Schema != wire.Schema || ack.Action != wire.Action || ack.Revision != wire.Revision ||
+		ack.Owner != wire.Owner || ack.Writer != wire.Writer || !ack.RequiresPause || !volumeHex32.MatchString(ack.Token) ||
+		ack.Route == nil || !ack.Route.valid() || ack.Route.Process != target.Process || ack.Route.DeviceID != target.Device ||
+		ack.Route.DeviceIncarnation != target.Incarnation || ack.Route.SessionEpoch != target.Epoch ||
+		ack.Route.RouteRevision != target.Route || ack.Route.InputPathDigest != wire.Writer.InputDigest {
+		return ack, ErrAliasConflict
+	}
+	if wire.Phase == "prepare" {
+		if ack.Phase != "prepared" || ack.StopCSeq != 0 {
+			return ack, ErrAliasConflict
+		}
+	} else if wire.Route == nil || *wire.Route != *ack.Route || wire.Token != ack.Token ||
+		(ack.Phase != "pending" || ack.StopCSeq != 0) && (ack.Phase != "parked" || ack.StopCSeq <= 0) {
+		return ack, ErrAliasConflict
+	}
+	return ack, nil
+}
+
+func (p *AppPlayer) primaryRadioPrepareStation(ctx context.Context, r radioPrimaryCommand, h *radioHold, device string) (any, error) {
+	op := h.PrimaryPending
+	if h.Phase == "primary_rejected" && r.Phase == "result" && r.ForPhase == "prepare_start" &&
+		op.Started == nil && r.Session == nil && op.Station == r.Station {
+		r.Phase = "rejected"
+		return radioPrimaryReply{radioPrimaryCommand: r}, nil
+	}
+	if h.Phase != "primary_reserved" || r.Session != nil || !nativeOwnerASCII(r.Station, 31) {
+		return nil, ErrAliasConflict
+	}
+	if r.Phase == "prepare_start" {
+		if r.ForPhase != "" || op.Target != nil {
+			return nil, ErrAliasConflict
+		}
+		phase := "target"
+		if room, err := p.radioIntentTarget(nil); p.primaryStream != nil && err == nil && room == r.Target {
+			phase, op.SameTarget = "preflight_target", true
+		}
+		ack, err := p.primaryRadioCStart(ctx, radioPrimaryStartWire{Schema: cPrimaryStartSchema, Phase: phase, radioPrimaryTarget: radioPrimaryTarget{Device: device}}, op.SameTarget)
+		if err != nil {
+			return nil, err
+		}
+		op.Target, op.Station = &ack.radioPrimaryTarget, r.Station
+		if err = p.app.persistRadioLocked(); err != nil {
+			return nil, err
+		}
+	}
+	if op.Target == nil || op.Station != r.Station || op.Target.Device != device {
+		return nil, ErrAliasConflict
+	}
+	r.Phase, op.Decoded = "prepared", !op.SameTarget
+	if !op.SameTarget {
+		return radioPrimaryReply{radioPrimaryCommand: r}, nil
+	}
+
+	phase := "result"
+	if r.ForPhase == "" {
+		phase = "preflight"
+	}
+	ack, err := p.primaryRadioCStart(ctx, radioPrimaryStartWire{
+		Schema: cPrimaryStartSchema, Phase: phase, Action: r.Action, Station: r.Station, Generation: r.Generation, radioPrimaryTarget: *op.Target,
+	}, true)
+	if err != nil {
+		return nil, err
+	}
+	switch ack.Phase {
+	case "pending":
+		r.Phase = "pending"
+	case "decoded":
+		op.Decoded = true
+		if err = p.app.persistRadioLocked(); err != nil {
+			return nil, err
+		}
+	case "rejected":
+		r.Phase, h.Phase = "rejected", "primary_rejected"
+		if err = p.app.persistRadioLocked(); err != nil {
+			return nil, err
+		}
+	default:
+		return nil, ErrAliasConflict
+	}
+	return radioPrimaryReply{radioPrimaryCommand: r}, nil
+}
+
+// Existing Native reservation owns exactly one preflight, park confirm and
+// decoder activation. Reads can settle a pending step, but never resend it.
+func (p *AppPlayer) primaryRadioAdvancePark(ctx context.Context, h *radioHold, r radioPrimaryCommand, wire radioPrimaryStartWire, begin bool) (radioPrimaryStartReceipt, error) {
+	op, app := h.PrimaryPending, p.app
+	if op.ActivationSent {
+		wire.Phase = "result"
+		return p.primaryRadioCStart(ctx, wire, true)
+	}
+
+	if begin {
+		owner, err := p.radioSourceOwner()
+		if err != nil || owner.RoomID != r.Target || owner.HomePodID != wire.Device || p.primaryStream == nil {
+			return radioPrimaryStartReceipt{}, ErrAliasConflict
+		}
+		writer, err := p.captureQueueWriter(ctx, owner, nil)
+		if err != nil {
+			return radioPrimaryStartReceipt{}, err
+		}
+		revision, err := p.nextNativeIntent()
+		if err != nil {
+			return radioPrimaryStartReceipt{}, err
+		}
+		ack, err := p.primaryRadioParkCall(ctx, radioPrimaryParkWire{
+			Schema: cPrimaryParkSchema, Phase: "prepare", Action: r.Action, Revision: revision, Owner: owner, Writer: writer.Wire,
+		}, *op.Target)
+		if err != nil {
+			return radioPrimaryStartReceipt{}, err
+		}
+		h.PrimaryPark, h.primary, h.RequiresPause, h.PauseUncertain = &ack.radioPrimaryParkWire, p.primaryStream, true, true
+		paused := p.state.player.IsPaused
+		h.PausedBefore = &paused
+		app.radioOutputFence.Store(true)
+		if err = app.persistRadioLocked(); err != nil {
+			return radioPrimaryStartReceipt{}, err
+		}
+		generation, _ := strconv.ParseUint(revision, 10, 64)
+		if err = p.pauseAndParkRadioWriter(ctx, h, ack.Token, generation, writer.Wire); err != nil {
+			return radioPrimaryStartReceipt{}, err
+		}
+	}
+	park := h.PrimaryPark
+	if park == nil || !h.WriterParked || h.PauseUncertain || h.primary == nil || p.primaryStream != h.primary {
+		return radioPrimaryStartReceipt{}, ErrAliasConflict
+	}
+	if owner, err := p.radioSourceOwner(); err != nil || owner != park.Owner {
+		return radioPrimaryStartReceipt{}, ErrAliasConflict
+	}
+	query := *park
+	query.Phase = "result"
+	if begin {
+		query.Phase = "confirm"
+	}
+	ack, err := p.primaryRadioParkCall(ctx, query, *op.Target)
+	if err != nil {
+		return radioPrimaryStartReceipt{}, err
+	}
+	if ack.Phase == "pending" {
+		return radioPrimaryStartReceipt{radioPrimaryStartWire: radioPrimaryStartWire{Phase: "pending"}}, nil
+	}
+
+	op.ActivationSent = true
+	if err = app.persistRadioLocked(); err != nil {
+		return radioPrimaryStartReceipt{}, err
+	}
+	wire.Phase, wire.ParkToken = "activate", park.Token
+	return p.primaryRadioCStart(ctx, wire, true)
+}
diff --git a/daemon/radio_primary_park_test.go b/daemon/radio_primary_park_test.go
new file mode 100644
index 0000000..dd70c64
--- /dev/null
+++ b/daemon/radio_primary_park_test.go
@@ -0,0 +1,109 @@
+package daemon
+
+import (
+	"context"
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"path/filepath"
+	"sync/atomic"
+	"testing"
+)
+
+func TestPrimaryRadioSameTargetRejectsStartUntilExactDecodedProof(t *testing.T) {
+	p, op := contentFixture(t)
+	p.app.radio.Holds = map[string]*radioHold{}
+	p.app.cfg.RadioHandoffStatePath = filepath.Join(t.TempDir(), "radio.json")
+	p.app.cfg.RadioHandoffControlToken = "inert-test-token"
+	const cProcess = "a411aa42-8b70-4bf4-a37d-81b0519db7df"
+	const action = "b3919fea-955b-4d4c-a581-c71cb92712b2"
+	target := radioPrimaryTarget{Process: cProcess, Device: op.Capture.OldOwner.HomePodID, Incarnation: "4", Epoch: "7", Route: "8"}
+	var prepare, results atomic.Int32
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, req *http.Request) {
+		var wire radioPrimaryStartWire
+		if req.Header.Get("X-PodConnect-Token") != "inert-test-token" ||
+			json.NewDecoder(req.Body).Decode(&wire) != nil || wire.Schema != cPrimaryStartSchema || wire.Device != target.Device {
+			t.Error("unexpected private C request")
+			w.WriteHeader(http.StatusBadRequest)
+			return
+		}
+		ack := radioPrimaryStartReceipt{radioPrimaryStartWire: wire}
+		switch wire.Phase {
+		case "preflight_target":
+			ack.Phase, ack.radioPrimaryTarget = "target_ready", target
+		case "preflight", "result":
+			if wire.radioPrimaryTarget != target || wire.Action != action || wire.Station != "p3" {
+				t.Error("decoder lost the exact captured Spotify target")
+				w.WriteHeader(http.StatusBadRequest)
+				return
+			}
+			if wire.Phase == "preflight" {
+				prepare.Add(1)
+				ack.Phase = "pending"
+			} else {
+				results.Add(1)
+				ack.Phase = "decoded"
+			}
+		default:
+			t.Errorf("unexpected effect before decoded proof: %s", wire.Phase)
+			w.WriteHeader(http.StatusConflict)
+			return
+		}
+		_ = json.NewEncoder(w).Encode(ack)
+	}))
+	defer server.Close()
+	p.app.cfg.RoomTransportOwnToneURL = server.URL
+
+	ctx := context.Background()
+	ask := func(r radioPrimaryCommand, phase string) radioPrimaryReply {
+		t.Helper()
+		reply, err := p.radioPrimaryActor(ctx, r)
+		ack, ok := reply.(radioPrimaryReply)
+		if err != nil || !ok || ack.Phase != phase {
+			t.Fatalf("want %s, got %#v (%v)", phase, reply, err)
+		}
+		return ack
+	}
+	r := radioPrimaryCommand{Schema: nativePrimarySchema, Phase: "reserve", Process: radioProcessID(op.Capture.Process),
+		Handoff: cProcess, Generation: "1", Action: action, Target: op.Capture.OldOwner.RoomID, Intent: "0", From: op.Capture.OldOwner.RoomID}
+	r.Owner = ask(r, "reserved").Owner
+	r.Phase, r.Station = "prepare_start", "p3"
+	ask(r, "pending")
+	if _, err := p.radioPrimaryActor(ctx, r); err == nil {
+		t.Fatal("decoder preflight replayed")
+	}
+	r.Phase = "start"
+	if _, err := p.radioPrimaryActor(ctx, r); err == nil {
+		t.Fatal("undecoded station was allowed to park Spotify")
+	}
+	r.Phase, r.ForPhase = "result", "prepare_start"
+	ask(r, "prepared")
+	h := p.app.radio.Holds[r.Target]
+	if prepare.Load() != 1 || results.Load() != 1 || !h.PrimaryPending.Decoded || h.PrimaryPending.Started != nil ||
+		h.WriterParked || h.PauseUncertain || p.app.radioOutputFence.Load() || p.primaryStream != op.Capture.Primary {
+		t.Fatal("decode-only preflight changed Spotify custody")
+	}
+}
+
+func TestPrimaryRadioReleaseDoesNotBlockLaterContentSelection(t *testing.T) {
+	p, op := contentFixture(t)
+	binding := &radioPrimaryBinding{
+		Process: "a411aa42-8b70-4bf4-a37d-81b0519db7df", DeviceID: "202",
+		Operation: "b3919fea-955b-4d4c-a581-c71cb92712b2", Incarnation: "1", Epoch: "3", Route: "4",
+	}
+	h := &radioHold{
+		Primary: binding, Phase: "primary_released",
+		PrimaryAction:  "87f6f7dd-2a03-4d75-9a62-6a7a2e089705",
+		PrimaryPending: &radioPrimaryPending{Released: 5},
+	}
+	p.app.radio.Holds = map[string]*radioHold{op.Capture.Scope.RoomID: h}
+	for attempt := 0; attempt < 2; attempt++ {
+		if stage, err := p.radioContentSnapshot(op.Capture.Scope); stage != nil || err != nil || p.radioHeld() {
+			t.Fatalf("released receiver incorrectly triggered radio content admission: stage %v, err %v", stage, err)
+		}
+	}
+	h.WriterParked = true
+	if !p.radioHeld() {
+		t.Fatal("a receiver release incorrectly dropped parked writer custody")
+	}
+}
diff --git a/daemon/radio_primary_parked_restart.go b/daemon/radio_primary_parked_restart.go
new file mode 100644
index 0000000..0b6ca00
--- /dev/null
+++ b/daemon/radio_primary_parked_restart.go
@@ -0,0 +1,129 @@
+package daemon
+
+import "context"
+
+func primaryParkedStopReceipt(h *radioHold) (radioPrimaryStopReceipt, bool) {
+	if !primaryRadioReleased(h) || h.PrimaryPark == nil || !h.WriterParked || h.PauseUncertain || !validPrimaryRadioHold(h) {
+		return radioPrimaryStopReceipt{}, false
+	}
+	action := h.PrimaryAction
+	if action == "" && h.PrimaryPending.Stopped != nil {
+		action = h.PrimaryPending.Stopped.Action
+	}
+	receipt := radioPrimaryStopReceipt{radioPrimaryStopRequest: radioPrimaryStopRequest{
+		Schema: primaryRadioStopSchema, Phase: "released", Action: action, radioPrimaryBinding: *h.Primary,
+	}, TeardownCSeq: h.PrimaryPending.Released}
+	return receipt, volumeUUID.MatchString(action) && receipt.TeardownCSeq > 0
+}
+
+func primaryPreviousRelease(receipt *radioPrimaryStopReceipt) *radioPrimaryPreviousRelease {
+	return &radioPrimaryPreviousRelease{receipt.radioPrimaryBinding, receipt.Action, receipt.TeardownCSeq}
+}
+
+func (p *AppPlayer) reservePrimaryParkedRestart(r radioPrimaryCommand, h *radioHold, release *radioPrimaryStopReceipt, generation uint64) (any, error) {
+	if h.owner != p || !h.WriterParked || h.PrimaryPark == nil || h.primary == nil || p.primaryStream != h.primary ||
+		h.PrimaryReturn != nil || r.Target != h.Request.TargetID || r.From != "" && r.From != r.Target ||
+		primaryReplacementPending(h) || p.state == nil || p.state.player == nil || !p.state.player.IsPaused ||
+		(release == nil && !primaryRadioIsolated(h)) {
+		return nil, ErrAliasConflict
+	}
+	r.Owner = r.Generation
+	h.Phase = "primary_reserved"
+	h.PrimaryPending = &radioPrimaryPending{Reserve: r, ParkedRestart: true, PriorRelease: release, PriorIsolation: h.PrimaryIsolation}
+	if release != nil {
+		h.PrimaryAction = release.Action
+		h.PrimaryPending.Released = release.TeardownCSeq
+	}
+	p.app.radio.Generation = generation
+	if err := p.app.persistRadioLocked(); err != nil {
+		return nil, err
+	}
+	r.Phase = "reserved"
+	return radioPrimaryReply{radioPrimaryCommand: r}, nil
+}
+
+func (p *AppPlayer) primaryRadioParkedRestartActor(ctx context.Context, r radioPrimaryCommand, h *radioHold, device string) (any, error) {
+	op := h.PrimaryPending
+	if r.Session != nil || op.PriorRelease == nil && op.PriorIsolation == nil || h.PrimaryPark == nil || !h.WriterParked {
+		return nil, ErrAliasConflict
+	}
+	if r.Phase == "start" || r.Phase == "result" && r.ForPhase == "start" {
+		if !op.Decoded || r.Station != op.Station {
+			return nil, ErrAliasConflict
+		}
+		return p.primaryRadioReplacementStart(ctx, r, h)
+	}
+	if r.Phase != "prepare_start" && !(r.Phase == "result" && r.ForPhase == "prepare_start") {
+		return nil, ErrAliasConflict
+	}
+	if !nativeOwnerASCII(r.Station, 31) || op.Station != "" && r.Station != op.Station {
+		return nil, ErrAliasConflict
+	}
+	if op.ReplacementRejected && r.Phase == "result" {
+		r.Phase = "rejected"
+		return radioPrimaryReply{radioPrimaryCommand: r}, nil
+	}
+	if h.Phase != "primary_reserved" && !(h.Phase == "primary_replacement_released" && r.Phase == "result") || op.Started != nil {
+		return nil, ErrAliasConflict
+	}
+
+	wire := radioPrimaryStartWire{Schema: cPrimaryStartSchema, Phase: "result", Action: r.Action,
+		Station: r.Station, Generation: r.Generation, PriorIsolation: op.PriorIsolation}
+	if op.PriorRelease != nil {
+		wire.Predecessor, wire.PriorRelease = &op.PriorRelease.radioPrimaryBinding, primaryPreviousRelease(op.PriorRelease)
+	} else {
+		wire.Predecessor = &op.PriorIsolation.radioPrimaryBinding
+	}
+	if r.Phase == "prepare_start" {
+		if r.ForPhase != "" || op.Target != nil {
+			return nil, ErrAliasConflict
+		}
+		target, err := p.primaryRadioCStart(ctx, radioPrimaryStartWire{
+			Schema: cPrimaryStartSchema, Phase: "preflight_replace_target",
+			radioPrimaryTarget: radioPrimaryTarget{Device: device}, Predecessor: wire.Predecessor, PriorRelease: wire.PriorRelease, PriorIsolation: wire.PriorIsolation,
+		}, false)
+		op.Station = r.Station
+		if err != nil {
+			return p.rejectPrimaryParkedRestart(r, h) // Only a read was attempted.
+		}
+		op.Target = &target.radioPrimaryTarget
+		if err = p.app.persistRadioLocked(); err != nil {
+			return nil, err
+		}
+		wire.Phase = "preflight_replace"
+	}
+	if op.Target == nil || op.Target.Device != device || op.Station != r.Station {
+		return nil, ErrAliasConflict
+	}
+	wire.radioPrimaryTarget = *op.Target
+	ack, err := p.primaryRadioCStart(ctx, wire, false)
+	if err != nil {
+		return nil, err
+	}
+	switch ack.Phase {
+	case "pending":
+		r.Phase = "pending"
+	case "decoded":
+		op.Decoded, h.Phase, r.Phase = true, "primary_replacement_released", "prepared"
+	case "rejected":
+		return p.rejectPrimaryParkedRestart(r, h)
+	default:
+		return nil, ErrAliasConflict
+	}
+	if err = p.app.persistRadioLocked(); err != nil {
+		return nil, err
+	}
+	return radioPrimaryReply{radioPrimaryCommand: r}, nil
+}
+
+func (p *AppPlayer) rejectPrimaryParkedRestart(r radioPrimaryCommand, h *radioHold) (any, error) {
+	h.PrimaryPending.ReplacementRejected, h.PrimaryPending.ReplacementDone = true, true
+	h.Phase, r.Phase = "primary_released", "rejected"
+	if h.PrimaryIsolation.matches(h.Primary) {
+		h.Phase = "primary_isolated"
+	}
+	if err := p.app.persistRadioLocked(); err != nil {
+		return nil, err
+	}
+	return radioPrimaryReply{radioPrimaryCommand: r}, nil
+}
diff --git a/daemon/radio_primary_readiness.go b/daemon/radio_primary_readiness.go
new file mode 100644
index 0000000..c1e8e22
--- /dev/null
+++ b/daemon/radio_primary_readiness.go
@@ -0,0 +1,127 @@
+package daemon
+
+import (
+	"context"
+	"errors"
+	"net/http"
+	"strconv"
+	"strings"
+)
+
+const primaryRadioCapabilitySchema = "podconnect.output_primary_radio_readiness.v1"
+
+var errPrimaryCapabilityUnsupported = errors.New("primary radio capability endpoint unsupported")
+
+type radioPrimaryCapability struct {
+	Schema      string `json:"schema"`
+	Effects     string `json:"effect_protocol"`
+	Process     string `json:"process_id"`
+	Device      string `json:"device_id"`
+	Incarnation string `json:"device_incarnation"`
+	LegacyOpen  *bool  `json:"legacy_admission_open"`
+	Physical    *bool  `json:"physical_result_verified"`
+}
+
+func (c radioPrimaryCapability) valid(device string) bool {
+	return c.Schema == primaryRadioCapabilitySchema && c.Effects == "primary_route_v1" && c.Device == device &&
+		volumeUUID.MatchString(c.Process) && volumeCounter(c.Incarnation) && c.Incarnation != "0" &&
+		c.LegacyOpen != nil && c.Physical != nil && !*c.Physical
+}
+
+type radioPrimaryReadinessState struct {
+	ColdDetachment  *radioPrimaryColdDetachment `json:"cold_detachment,omitempty"`
+	Schema          string                      `json:"schema"`
+	Protocol        string                      `json:"protocol,omitempty"`
+	Process         string                      `json:"process_id"`
+	Revision        string                      `json:"native_revision"`
+	Targets         []radioTarget               `json:"configured_targets"`
+	Missing         []string                    `json:"missing_proofs"`
+	Observation     *radioPrimaryObservation    `json:"observation"`
+	Session         *radioPrimaryBinding        `json:"target_session,omitempty"`
+	Capabilities    []string                    `json:"capabilities,omitempty"`
+	IsolatedSession *radioPrimaryIsolation      `json:"isolated_session,omitempty"`
+	ReleasedSession *radioPrimaryBinding        `json:"released_session,omitempty"`
+	ReleaseActionID *string                     `json:"release_action_id,omitempty"`
+	TeardownCSeq    *int                        `json:"teardown_cseq,omitempty"`
+}
+
+// Only the exact composed C build publishes the authenticated capability.
+// Capability and inventory alone are never a source observation. Until the
+// actor reports its matching current owner this path remains visibly closed.
+func (app *App) radioPrimaryReadiness(ctx context.Context, process contentProcess) radioPrimaryReadinessState {
+	app.radio.mu.Lock()
+	intent, failed := app.radio.Intent, app.radio.failed
+	app.radio.mu.Unlock()
+	s := radioPrimaryReadinessState{
+		Schema: nativePrimarySchema, Process: radioProcessID(process), Revision: strconv.FormatUint(intent, 10),
+		Targets: []radioTarget{}, Missing: []string{"primary_c_capability_unverified"},
+	}
+	if failed || !app.radioEnabled() || !roomTransportURL(app.cfg.RoomTransportOwnToneURL) ||
+		len(app.cfg.DeviceAliasRoomIDs) != len(app.cfg.DeviceAliases) || len(app.cfg.DeviceAliasHomePodIDs) != len(app.cfg.DeviceAliases) {
+		return s
+	}
+	rooms, devices := map[string]bool{}, map[string]bool{}
+	for i, id := range app.cfg.DeviceAliasRoomIDs {
+		device := app.cfg.DeviceAliasHomePodIDs[i]
+		if !nativeOwnerASCII(id, 255) || !homePodIDPattern.MatchString(device) || !volumeCounter(device) || device == "0" || rooms[id] || devices[device] {
+			return s
+		}
+		rooms[id], devices[device] = true, true
+		s.Targets = append(s.Targets, radioTarget{id, app.cfg.DeviceAliases[i], device, "unknown", false, i == 0, ""})
+	}
+	unsupported := 0
+	receivers := make(map[string]string, len(s.Targets))
+	cProcess := ""
+	base := strings.TrimSuffix(app.cfg.RoomTransportOwnToneURL, "/")
+	for _, target := range s.Targets {
+		var c radioPrimaryCapability
+		endpoint := base + "/api/outputs/" + target.HomePodID + "/radio-handoff/primary-readiness"
+		err := radioControlHTTP(ctx, http.MethodGet, endpoint, app.cfg.RadioHandoffControlToken, nil, &c)
+		if errors.Is(err, errPrimaryCapabilityUnsupported) {
+			// Released C maps an unrecognized JSON path to 400. Neither
+			// 400 nor 404 alone establishes an older working owner.
+			var legacy radioAvailabilityAdmission
+			legacyEndpoint := base + "/api/outputs/" + target.HomePodID + "/radio-admission"
+			if radioControlHTTP(ctx, http.MethodGet, legacyEndpoint, app.cfg.RadioHandoffControlToken, nil, &legacy) != nil ||
+				legacy.Schema != "podconnect.output_radio_admission.v1" || legacy.Physical || !legacy.Open ||
+				legacy.DeviceID != target.HomePodID || !volumeUUID.MatchString(legacy.Process) ||
+				!volumeCounter(legacy.Incarnation) || legacy.Incarnation == "0" || (cProcess != "" && legacy.Process != cProcess) {
+				return s
+			}
+			cProcess = legacy.Process
+			unsupported++
+			continue
+		}
+		if err != nil {
+			continue // This configured output remains unavailable.
+		}
+		if !c.valid(target.HomePodID) || (cProcess != "" && c.Process != cProcess) {
+			return s
+		}
+		receivers[target.HomePodID] = c.Incarnation
+		cProcess = c.Process
+	}
+	app.radio.mu.Lock()
+	stable := app.radio.Intent == intent && !app.radio.failed
+	app.radio.mu.Unlock()
+	if !stable || ctx.Err() != nil || len(s.Targets) == 0 {
+		return s
+	}
+	if unsupported == 0 && len(receivers) > 0 && cProcess != "" {
+		app.observePrimaryColdDetachment(ctx, process, cProcess, receivers, &s)
+	}
+	if unsupported == len(s.Targets) {
+		s.Protocol = "v1" // Manager still requires fresh v1 evidence from this Native process.
+	} else if unsupported == 0 && len(receivers) > 0 && cProcess != "" {
+		s.Missing = []string{"primary_current_owner_unverified"}
+		observed, err := app.primaryRadioActorAsk(ctx, apiRadioPrimaryActorState, radioPrimaryActorStateRequest{
+			State: s, CProcess: cProcess, Receivers: receivers,
+		})
+		if verified, ok := observed.(radioPrimaryReadinessState); err == nil && ok && verified.Observation != nil {
+			s = verified
+			s.Protocol, s.Missing = "primary", []string{}
+			s.Capabilities = []string{"replacement_decoder_preflight"}
+		}
+	}
+	return s
+}
diff --git a/daemon/radio_primary_readiness_test.go b/daemon/radio_primary_readiness_test.go
new file mode 100644
index 0000000..28e0b33
--- /dev/null
+++ b/daemon/radio_primary_readiness_test.go
@@ -0,0 +1,63 @@
+package daemon
+
+import (
+	"context"
+	"io"
+	"net/http"
+	"path/filepath"
+	"strings"
+	"testing"
+)
+
+func TestPrimaryRadioReadinessSeparatesCapabilityFromCurrentOwner(t *testing.T) {
+	const token = "0123456789abcdef0123456789abcdef"
+	process := contentProcess{BootID: "boot", PID: "31", StartTicks: "20"}
+	app := &App{cfg: &Config{
+		DeviceAliases: []string{"Kitchen"}, DeviceAliasRoomIDs: []string{"kitchen"}, DeviceAliasHomePodIDs: []string{"42"},
+		RadioHandoffControlToken: token, RadioHandoffOwnerURL: "http://127.0.0.1:4010",
+		RadioHandoffStatePath: filepath.Join(t.TempDir(), "radio.json"), RoomTransportOwnToneURL: "http://127.0.0.1:3689",
+	}}
+	const legacy = `{"schema":"podconnect.output_radio_admission.v1","process_id":"a411aa42-8b70-4bf4-a37d-81b0519db7df","device_id":"42","device_incarnation":"3","admission_open":true,"physical_result_verified":false}`
+	const capability = `{"schema":"podconnect.output_primary_radio_readiness.v1","effect_protocol":"primary_route_v1","process_id":"a411aa42-8b70-4bf4-a37d-81b0519db7df","device_id":"42","device_incarnation":"3","legacy_admission_open":true,"physical_result_verified":false}`
+	for _, tc := range []struct {
+		name, body, legacy, protocol, missing string
+		status                                int
+	}{
+		{"old C released route-miss and exact legacy owner", "", legacy, "v1", "primary_c_capability_unverified", http.StatusBadRequest},
+		{"old C route 404 and exact legacy owner", "", legacy, "v1", "primary_c_capability_unverified", http.StatusNotFound},
+		{"route miss alone is not old C", "", "", "", "primary_c_capability_unverified", http.StatusBadRequest},
+		{"new C alone is not owner proof", capability, "", "", "primary_current_owner_unverified", http.StatusOK},
+		{"different receiver", strings.Replace(capability, `"42"`, `"43"`, 1), "", "", "primary_c_capability_unverified", http.StatusOK},
+		{"truncated response", capability[:25], "", "", "primary_c_capability_unverified", http.StatusOK},
+		{"unavailable C is not old C", "", "", "", "primary_c_capability_unverified", http.StatusServiceUnavailable},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			old := http.DefaultTransport
+			defer func() { http.DefaultTransport = old }()
+			reads := 0
+			http.DefaultTransport = pc13RoundTrip(func(r *http.Request) (*http.Response, error) {
+				reads++
+				if r.Method != http.MethodGet || r.Header.Get("X-PodConnect-Token") != token {
+					t.Fatalf("unexpected capability request %s %s", r.Method, r.URL.Path)
+				}
+				if r.URL.Path == "/api/outputs/42/radio-admission" && reads == 2 {
+					return &http.Response{StatusCode: http.StatusOK, Body: io.NopCloser(strings.NewReader(tc.legacy))}, nil
+				}
+				if r.URL.Path != "/api/outputs/42/radio-handoff/primary-readiness" || reads != 1 {
+					t.Fatalf("unexpected capability path %s", r.URL.Path)
+				}
+				return &http.Response{StatusCode: tc.status, Body: io.NopCloser(strings.NewReader(tc.body))}, nil
+			})
+			got := app.radioPrimaryReadiness(context.Background(), process)
+			wantReads := 1
+			if tc.status == http.StatusBadRequest || tc.status == http.StatusNotFound {
+				wantReads++
+			}
+			if reads != wantReads || got.Process != radioProcessID(process) || got.Protocol != tc.protocol || got.Observation != nil ||
+				len(got.Missing) != 1 || got.Missing[0] != tc.missing || len(got.Targets) != 1 ||
+				got.Targets[0].Selectable || got.Targets[0].ReceiverDigest != "" {
+				t.Fatalf("unexpected readiness %v", got)
+			}
+		})
+	}
+}
diff --git a/daemon/radio_primary_replacement.go b/daemon/radio_primary_replacement.go
new file mode 100644
index 0000000..b48f327
--- /dev/null
+++ b/daemon/radio_primary_replacement.go
@@ -0,0 +1,293 @@
+package daemon
+
+import (
+	"context"
+	"strconv"
+	"strings"
+)
+
+type radioPrimaryPreviousRelease struct {
+	radioPrimaryBinding
+	Action       string `json:"action"`
+	TeardownCSeq int    `json:"teardown_cseq"`
+}
+
+func primaryReplacementPending(h *radioHold) bool {
+	return h != nil && h.PrimaryPending != nil && h.PrimaryPending.Reserve.Session != nil && !h.PrimaryPending.ReplacementDone
+}
+
+func (p *AppPlayer) reservePrimaryRadioReplacement(r radioPrimaryCommand, h *radioHold) (any, error) {
+	app := p.app
+	generation, err := strconv.ParseUint(r.Generation, 10, 64)
+	if err != nil || generation <= app.radio.Generation || r.Owner != "" || r.ForPhase != "" || r.Station != "" ||
+		r.From == "" || r.Session == nil || !r.Session.valid() {
+		return nil, ErrAliasConflict
+	}
+	old := app.radio.Holds[r.From]
+	if old == nil || old.owner != p || old.Phase != "primary_active" || old.Primary == nil || *old.Primary != *r.Session ||
+		p.primaryRadioRoom(r.From) != r.Session.DeviceID || old.PrimaryAction != "" {
+		return nil, ErrAliasConflict
+	}
+	for _, candidate := range app.radio.Holds {
+		if primaryReplacementPending(candidate) {
+			return nil, ErrAliasConflict
+		}
+	}
+	if h != old {
+		if h != nil && !primaryRadioRetired(h) {
+			return nil, ErrAliasConflict
+		}
+		h = &radioHold{owner: p, Phase: "primary_reserved", Actions: map[string]bool{},
+			Request: radioRequest{Schema: "podconnect.native_radio_primary_hold.v1", ProcessID: r.Process,
+				TargetID: r.Target, HandoffID: r.Handoff, Generation: r.Generation, ActionID: r.Action, ExpectedRevision: r.Intent}}
+	}
+	incumbent := *old.Primary
+	r.Session = &incumbent
+	r.Owner = r.Generation
+	h.PrimaryPending = &radioPrimaryPending{Reserve: r}
+	app.radio.Holds[r.Target], app.radio.Generation = h, generation
+	if err = app.persistRadioLocked(); err != nil {
+		return nil, err
+	}
+	r.Phase = "reserved"
+	return radioPrimaryReply{radioPrimaryCommand: r}, nil
+}
+
+func (p *AppPlayer) primaryRadioReplacementActor(ctx context.Context, r radioPrimaryCommand, h *radioHold, device string) (any, error) {
+	op := h.PrimaryPending
+	old := p.app.radio.Holds[op.Reserve.From]
+	if old == nil || old.owner != p {
+		return nil, ErrAliasConflict
+	}
+	if r.Phase == "prepare_replace" || r.Phase == "result" && r.ForPhase == "prepare_replace" {
+		return p.primaryRadioPrepareReplacement(ctx, r, h, old, device)
+	}
+	if r.Phase == "stop" || r.Phase == "result" && r.ForPhase == "stop" {
+		if op.ReplacementRejected && op.Stopped != nil && r.Phase == "result" && r.Session != nil && *r.Session == *op.Reserve.Session && r.Station == "" {
+			r.Phase = "replacement_rejected"
+			return radioPrimaryReply{radioPrimaryCommand: r}, nil
+		}
+		if op.Decoded && !op.ReplacementRejected {
+			return p.primaryRadioReplacementStop(ctx, r, h, old)
+		}
+		return nil, ErrAliasConflict
+	}
+	if !op.Decoded || op.ReplacementRejected {
+		return nil, ErrAliasConflict
+	}
+	if op.PriorRelease == nil || r.Station != op.Station || r.Session != nil {
+		return nil, ErrAliasConflict
+	}
+	if r.Phase == "prepare_start" || r.Phase == "result" && r.ForPhase == "prepare_start" {
+		r.Phase = "prepared"
+		return radioPrimaryReply{radioPrimaryCommand: r}, nil
+	}
+	if r.Phase != "start" && !(r.Phase == "result" && r.ForPhase == "start") {
+		return nil, ErrAliasConflict
+	}
+	return p.primaryRadioReplacementStart(ctx, r, h)
+}
+
+func (p *AppPlayer) primaryRadioPrepareReplacement(ctx context.Context, r radioPrimaryCommand, h, old *radioHold, device string) (any, error) {
+	op, app := h.PrimaryPending, p.app
+	if r.Session == nil || *r.Session != *op.Reserve.Session || !nativeOwnerASCII(r.Station, 31) ||
+		(op.Station != "" && op.Station != r.Station) {
+		return nil, ErrAliasConflict
+	}
+	if op.ReplacementRejected && r.Phase == "result" {
+		r.Phase = "replacement_rejected"
+		return radioPrimaryReply{radioPrimaryCommand: r}, nil
+	}
+	if op.ReplacementDone || old.Phase != "primary_active" || old.Primary == nil || *old.Primary != *r.Session {
+		return nil, ErrAliasConflict
+	}
+	wire := radioPrimaryStartWire{Schema: cPrimaryStartSchema, Phase: "result", Predecessor: r.Session,
+		Action: r.Action, Station: r.Station, Generation: r.Generation}
+	if r.Phase == "prepare_replace" {
+		if r.ForPhase != "" || op.Target != nil {
+			return nil, ErrAliasConflict
+		}
+		target, err := p.primaryRadioCStart(ctx, radioPrimaryStartWire{
+			Schema: cPrimaryStartSchema, Phase: "preflight_replace_target", Predecessor: r.Session,
+			radioPrimaryTarget: radioPrimaryTarget{Device: device},
+		}, false)
+		if err != nil {
+			// This was a read-only target lookup. Retire our unstarted
+			// candidate without touching the predecessor or receiver.
+			op.Station = r.Station
+			return p.rejectPrimaryRadioReplacement(r, h, old)
+		}
+		op.Target, op.Station = &target.radioPrimaryTarget, r.Station
+		if err = app.persistRadioLocked(); err != nil {
+			return nil, err
+		}
+		wire.Phase = "preflight_replace"
+	}
+	if op.Target == nil || op.Station != r.Station || op.Target.Device != device {
+		return nil, ErrAliasConflict
+	}
+	wire.radioPrimaryTarget = *op.Target
+	ack, err := p.primaryRadioCStart(ctx, wire, false)
+	if err != nil {
+		return nil, err
+	}
+	switch ack.Phase {
+	case "pending":
+		r.Phase = "pending"
+	case "decoded":
+		op.Decoded, r.Phase = true, "replacement_prepared"
+	case "rejected":
+		return p.rejectPrimaryRadioReplacement(r, h, old)
+	default:
+		return nil, ErrAliasConflict
+	}
+	if err = app.persistRadioLocked(); err != nil {
+		return nil, err
+	}
+	return radioPrimaryReply{radioPrimaryCommand: r}, nil
+}
+
+func (p *AppPlayer) rejectPrimaryRadioReplacement(r radioPrimaryCommand, h, old *radioHold) (any, error) {
+	op := h.PrimaryPending
+	op.ReplacementDone, op.ReplacementRejected, r.Phase = true, true, "replacement_rejected"
+	if h != old {
+		h.Phase = "primary_rejected"
+	}
+	if err := p.app.persistRadioLocked(); err != nil {
+		return nil, err
+	}
+	return radioPrimaryReply{radioPrimaryCommand: r}, nil
+}
+
+func (p *AppPlayer) primaryRadioReplacementStop(ctx context.Context, r radioPrimaryCommand, h, old *radioHold) (any, error) {
+	app, op := p.app, h.PrimaryPending
+	if r.Session == nil || *r.Session != *op.Reserve.Session || r.Station != "" || op.ReplacementDone ||
+		old.Primary == nil || *old.Primary != *r.Session || op.ActivationSent || old.PrimaryPending == nil {
+		return nil, ErrAliasConflict
+	}
+	if op.PriorRelease != nil {
+		if r.Phase != "result" {
+			return nil, ErrAliasConflict
+		}
+		return primaryRadioReplacementStopReply(r, *op.PriorRelease), nil
+	}
+	wire := radioPrimaryStopRequest{Schema: primaryRadioStopSchema, Phase: "result_stop_replace", Action: r.Action, radioPrimaryBinding: *r.Session}
+	if r.Phase == "stop" {
+		if r.ForPhase != "" || op.Stopped != nil || old.Phase != "primary_active" || old.PrimaryAction != "" {
+			return nil, ErrAliasConflict
+		}
+		admitted := r
+		op.Stopped, old.Phase, old.PrimaryAction = &admitted, "primary_stop_pending", r.Action
+		if err := app.persistRadioLocked(); err != nil {
+			return nil, err
+		}
+		wire.Phase = "claim_stop_replace"
+	} else if op.Stopped == nil || old.Phase != "primary_stop_pending" || old.PrimaryAction != r.Action {
+		return nil, ErrAliasConflict
+	}
+	var ack radioPrimaryStopReceipt
+	endpoint := strings.TrimSuffix(app.cfg.RoomTransportOwnToneURL, "/") + "/api/outputs/" + wire.DeviceID + "/radio-handoff/reacquire"
+	if err := radioAuthenticatedHTTP(ctx, endpoint, app.cfg.RadioHandoffControlToken, wire, &ack); err != nil {
+		return nil, err
+	}
+	if ack.Schema != wire.Schema || ack.Action != wire.Action || ack.radioPrimaryBinding != wire.radioPrimaryBinding {
+		return nil, ErrAliasConflict
+	}
+	if ack.Phase == "pending" && ack.TeardownCSeq == 0 {
+		r.Phase = "pending"
+		return radioPrimaryReply{radioPrimaryCommand: r}, nil
+	}
+	if ack.Phase == "replacement_rejected" && ack.TeardownCSeq == 0 {
+		old.Phase, old.PrimaryAction = "primary_active", ""
+		return p.rejectPrimaryRadioReplacement(r, h, old)
+	}
+	if ack.Phase != "released" || ack.TeardownCSeq <= 0 {
+		return nil, ErrAliasConflict
+	}
+	op.PriorRelease = &ack
+	if old != h {
+		old.Phase, old.PrimaryPending.Released = "primary_released", ack.TeardownCSeq
+	}
+	h.Phase = "primary_replacement_released"
+	if err := app.persistRadioLocked(); err != nil {
+		return nil, err
+	}
+	return primaryRadioReplacementStopReply(r, ack), nil
+}
+
+func primaryRadioReplacementStopReply(r radioPrimaryCommand, ack radioPrimaryStopReceipt) radioPrimaryReply {
+	r.Phase = "released"
+	source := r
+	source.Target = r.From
+	return radioPrimaryReply{radioPrimaryCommand: r, CSeq: ack.TeardownCSeq, Observation: primaryObservation(source, "stopped", "none")}
+}
+
+func (p *AppPlayer) primaryRadioReplacementStart(ctx context.Context, r radioPrimaryCommand, h *radioHold) (any, error) {
+	app, op := p.app, h.PrimaryPending
+	if op.Target == nil || op.PriorRelease == nil && op.PriorIsolation == nil {
+		return nil, ErrAliasConflict
+	}
+	wire := radioPrimaryStartWire{Schema: cPrimaryStartSchema, Phase: "result", Action: r.Action,
+		Station: r.Station, Generation: r.Generation, radioPrimaryTarget: *op.Target, Predecessor: op.Reserve.Session}
+	if op.ParkedRestart {
+		if op.PriorRelease != nil {
+			wire.Predecessor, wire.PriorRelease = &op.PriorRelease.radioPrimaryBinding, primaryPreviousRelease(op.PriorRelease)
+		} else {
+			wire.Predecessor, wire.PriorIsolation = &op.PriorIsolation.radioPrimaryBinding, op.PriorIsolation
+		}
+	}
+	if r.Phase == "start" {
+		if r.ForPhase != "" || h.Phase != "primary_replacement_released" || op.Started != nil || op.ReplacementDone {
+			return nil, ErrAliasConflict
+		}
+		admitted := r
+		op.Started, op.ActivationSent, h.Phase = &admitted, true, "primary_start_pending"
+		if err := app.persistRadioLocked(); err != nil {
+			return nil, err
+		}
+		if op.PriorRelease != nil {
+			wire.PriorRelease = primaryPreviousRelease(op.PriorRelease)
+		}
+		wire.Phase = "activate_replace"
+		if h.PrimaryPark != nil {
+			wire.ParkToken = h.PrimaryPark.Token
+		}
+	} else if op.Started == nil || h.Phase != "primary_start_pending" && h.Phase != "primary_active" {
+		return nil, ErrAliasConflict
+	}
+	alreadyObserved := h.Phase == "primary_active" && op.ReplacementDone
+	ack, err := p.primaryRadioCStart(ctx, wire, false)
+	if err != nil {
+		return nil, err
+	}
+	if alreadyObserved {
+		if ack.Phase != "playing" || ack.Session == nil || h.Primary == nil || *ack.Session != *h.Primary {
+			return nil, ErrAliasConflict
+		}
+		r.Session, r.Phase = ack.Session, "playing"
+		return radioPrimaryReply{radioPrimaryCommand: r, Observation: primaryObservation(r, "playing", "radio")}, nil
+	}
+	switch ack.Phase {
+	case "pending":
+		r.Phase = "pending"
+	case "playing":
+		h.Primary, h.PrimaryAction, h.Phase, h.PrimaryIsolation = ack.Session, "", "primary_active", nil
+		h.PrimaryStatus = primaryRadioActiveRead(wire, r.Owner, false)
+		h.Request = radioRequest{Schema: "podconnect.native_radio_primary_hold.v1", ProcessID: r.Process,
+			TargetID: r.Target, HandoffID: r.Handoff, Generation: r.Generation, ActionID: r.Action, ExpectedRevision: r.Intent}
+		op.ReplacementDone = true
+		r.Session, r.Phase = ack.Session, "playing"
+	default:
+		h.Phase = "unknown"
+		_ = app.persistRadioLocked()
+		return nil, ErrAliasConflict
+	}
+	if err = app.persistRadioLocked(); err != nil {
+		return nil, err
+	}
+	reply := radioPrimaryReply{radioPrimaryCommand: r}
+	if r.Phase == "playing" {
+		reply.Observation = primaryObservation(r, "playing", "radio")
+	}
+	return reply, nil
+}
diff --git a/daemon/radio_primary_return.go b/daemon/radio_primary_return.go
new file mode 100644
index 0000000..be5442a
--- /dev/null
+++ b/daemon/radio_primary_return.go
@@ -0,0 +1,361 @@
+package daemon
+
+import (
+	"context"
+	"strconv"
+	"strings"
+	"time"
+
+	"github.com/devgianlu/go-librespot/output"
+)
+
+const cPrimaryReturnSchema = "podconnect.output_primary_spotify_return.v1"
+
+type radioPrimaryReturnWire struct {
+	Schema    string                   `json:"schema"`
+	Phase     string                   `json:"phase"`
+	Intent    string                   `json:"intent"`
+	Revision  string                   `json:"native_revision"`
+	Park      radioPrimaryParkWire     `json:"park"`
+	Release   *radioPrimaryStopReceipt `json:"radio_release,omitempty"`
+	Isolation *radioPrimaryIsolation   `json:"radio_isolation,omitempty"`
+	Writer    *queueWriterWire         `json:"current_writer_proof,omitempty"`
+}
+
+type radioPrimaryReturnReceipt struct {
+	radioPrimaryReturnWire
+	Route *roomVolumeRoute `json:"route,omitempty"`
+}
+
+func (wire radioPrimaryReturnWire) predecessor() *radioPrimaryBinding {
+	if wire.Release != nil && wire.Isolation == nil && wire.Release.TeardownCSeq > 0 {
+		return &wire.Release.radioPrimaryBinding
+	}
+	if wire.Release == nil && wire.Isolation != nil && wire.Isolation.matches(&wire.Isolation.radioPrimaryBinding) {
+		return &wire.Isolation.radioPrimaryBinding
+	}
+	return nil
+}
+
+func (wire radioPrimaryReturnWire) predecessorMatches(other radioPrimaryReturnWire) bool {
+	if wire.Release != nil {
+		return other.Release != nil && *wire.Release == *other.Release && other.Isolation == nil
+	}
+	return wire.Isolation != nil && other.Release == nil && other.Isolation != nil && *wire.Isolation == *other.Isolation
+}
+
+func (p *AppPlayer) primaryRadioReturnCall(ctx context.Context, wire radioPrimaryReturnWire) (radioPrimaryReturnReceipt, error) {
+	var ack radioPrimaryReturnReceipt
+	predecessor := wire.predecessor()
+	if predecessor == nil {
+		return ack, ErrAliasConflict
+	}
+	device := predecessor.DeviceID
+	endpoint := strings.TrimSuffix(p.app.cfg.RoomTransportOwnToneURL, "/") + "/api/outputs/" + device + "/radio-handoff/reacquire"
+	if err := radioAuthenticatedHTTP(ctx, endpoint, p.app.cfg.RadioHandoffControlToken, wire, &ack); err != nil {
+		return ack, err
+	}
+	old := wire.Park.Route
+	if old == nil || ack.Park.Route == nil || ack.Schema != wire.Schema || ack.Intent != wire.Intent ||
+		ack.Revision != wire.Revision || !wire.predecessorMatches(ack.radioPrimaryReturnWire) ||
+		ack.Park.Schema != wire.Park.Schema || ack.Park.Phase != wire.Park.Phase || ack.Park.Action != wire.Park.Action ||
+		ack.Park.Revision != wire.Park.Revision || ack.Park.Owner != wire.Park.Owner || ack.Park.Writer != wire.Park.Writer ||
+		ack.Park.Token != wire.Park.Token || *ack.Park.Route != *old ||
+		(wire.Writer == nil) != (ack.Writer == nil) || wire.Writer != nil && *wire.Writer != *ack.Writer {
+		return ack, ErrAliasConflict
+	}
+	switch ack.Phase {
+	case "consumed", "connecting":
+		if ack.Route != nil {
+			return ack, ErrAliasConflict
+		}
+	case "route_ready", "barrier_ready", "opened":
+		if ack.Route == nil || !ack.Route.valid() || ack.Route.Process != old.Process || ack.Route.DeviceID != old.DeviceID ||
+			ack.Route.DeviceIncarnation != old.DeviceIncarnation || ack.Route.InputPathDigest != old.InputPathDigest ||
+			!primaryReturnCounter(ack.Route.SessionEpoch, predecessor.Epoch, 2) ||
+			!primaryReturnCounter(ack.Route.RouteRevision, old.RouteRevision, 2) ||
+			!primaryReturnCounter(ack.Route.SelectionRevision, old.SelectionRevision, 3) {
+			return ack, ErrAliasConflict
+		}
+	default:
+		return ack, ErrAliasConflict
+	}
+	return ack, nil
+}
+
+func primaryReturnCounter(actual, old string, delta uint64) bool {
+	parsed, err := strconv.ParseUint(old, 10, 64)
+	return err == nil && parsed <= ^uint64(0)-delta && actual == strconv.FormatUint(parsed+delta, 10)
+}
+
+// Reopen the retained writer only for an explicit Spotify command and after
+// reading the exact new ordinary AirPlay route. A failure leaves custody closed.
+func (p *AppPlayer) returnPrimarySpotify(parent context.Context, target string, h *radioHold, resume bool) error {
+	app := p.app
+	ctx, cancel := context.WithTimeout(parent, 8*time.Second)
+	defer cancel()
+
+	app.radio.mu.Lock()
+	if app.radio.failed || app.radio.Holds[target] != h || h.owner != p || !validPrimaryRadioHold(h) ||
+		!h.WriterParked || h.PauseUncertain || primaryReplacementPending(h) || h.PrimaryPark == nil || h.PrimaryReturn != nil ||
+		h.primary == nil || p.primaryStream != h.primary || h.Phase != "primary_active" && !primaryRadioReleased(h) && (resume || !primaryRadioIsolated(h)) {
+		app.radio.mu.Unlock()
+		return ErrAliasConflict
+	}
+	park, binding, primary, globalIntent := *h.PrimaryPark, *h.Primary, h.primary, app.radio.Intent
+	stopped := primaryRadioReleased(h)
+	isolated := primaryRadioIsolated(h)
+	var isolation *radioPrimaryIsolation
+	if isolated {
+		isolation = h.PrimaryIsolation
+	}
+	var release radioPrimaryStopReceipt
+	if stopped {
+		action := h.PrimaryAction
+		if action == "" && h.PrimaryPending.Stopped != nil {
+			action = h.PrimaryPending.Stopped.Action
+		}
+		release = radioPrimaryStopReceipt{radioPrimaryStopRequest: radioPrimaryStopRequest{
+			Schema: primaryRadioStopSchema, Phase: "released", Action: action, radioPrimaryBinding: binding,
+		}, TeardownCSeq: h.PrimaryPending.Released}
+	}
+	app.radio.mu.Unlock()
+
+	owner, err := p.radioSourceOwner()
+	if err != nil || owner != park.Owner || owner.RoomID != target || owner.HomePodID != binding.DeviceID ||
+		primary.Source == nil || p.state == nil || p.state.player == nil || !p.state.player.IsPaused {
+		return ErrAliasConflict
+	}
+	actualSource, err := p.player.Start35CurrentSource(ctx)
+	if err != nil || actualSource != primary.Source {
+		return ErrAliasConflict
+	}
+	revision, err := p.nextNativeIntent()
+	if err != nil {
+		return err
+	}
+	rawID, err := randomQueueID(16)
+	if err != nil {
+		return err
+	}
+	intent := rawID[:8] + "-" + rawID[8:12] + "-" + rawID[12:16] + "-" + rawID[16:20] + "-" + rawID[20:]
+	wire := radioPrimaryReturnWire{Schema: cPrimaryReturnSchema, Phase: "consume", Intent: intent, Revision: revision, Park: park, Isolation: isolation}
+
+	app.radio.mu.Lock()
+	if ctx.Err() != nil || app.radio.failed || app.radio.Intent != globalIntent || app.radio.Holds[target] != h || h.owner != p ||
+		h.PrimaryReturn != nil || h.Primary == nil || *h.Primary != binding || h.primary != primary || p.primaryStream != primary ||
+		stopped != primaryRadioReleased(h) || isolated != primaryRadioIsolated(h) ||
+		!stopped && !isolated && (h.Phase != "primary_active" || h.PrimaryAction != "") {
+		app.radio.mu.Unlock()
+		return ErrAliasConflict
+	}
+	saved := wire
+	h.Phase, h.ReacquirePhase, h.PrimaryReturn = "reacquiring", "primary_return_attempted", &saved
+	if !stopped && !isolated {
+		h.PrimaryAction = intent
+	}
+	err = app.persistRadioLocked()
+	app.radio.mu.Unlock()
+	if err != nil {
+		return err
+	}
+
+	succeeded := false
+	defer func() {
+		if !succeeded {
+			app.radio.mu.Lock()
+			if app.radio.Holds[target] == h && h.PrimaryReturn != nil && h.PrimaryReturn.Intent == intent {
+				h.Phase = "unknown"
+				_ = app.persistRadioLocked()
+			}
+			app.radio.mu.Unlock()
+		}
+	}()
+
+	currentLocked := func() bool {
+		return ctx.Err() == nil && !app.radio.failed && app.radio.Intent == globalIntent && app.radio.Holds[target] == h &&
+			h.owner == p && h.Phase == "reacquiring" && h.PrimaryReturn != nil && h.PrimaryReturn.Intent == intent &&
+			h.primary == primary && p.primaryStream == primary && p.state != nil && p.state.player != nil && p.state.player.IsPaused &&
+			p.state.player.SessionId == owner.SessionID && p.spotConnId == owner.ConnectionID &&
+			p.aliasRevision == owner.AliasRevision && p.aliasIncarnation == owner.AliasIncarnation && p.aliasFingerprint == owner.AliasRegistry &&
+			p.radioReacquiredAliasCurrentLocked(owner) && strconv.FormatUint(p.roomNativeIntent, 10) == revision
+	}
+	withCurrent := func(effect func() error) error {
+		observed, err := p.radioSourceOwner()
+		if err != nil || observed != owner {
+			return ErrAliasConflict
+		}
+		p.aliasMu.Lock()
+		defer p.aliasMu.Unlock()
+		app.radio.mu.Lock()
+		defer app.radio.mu.Unlock()
+		if !currentLocked() {
+			return ErrAliasConflict
+		}
+		if effect != nil {
+			return effect()
+		}
+		return nil
+	}
+	current := func() bool { return withCurrent(nil) == nil }
+	if !stopped && !isolated {
+		endpoint := strings.TrimSuffix(app.cfg.RoomTransportOwnToneURL, "/") + "/api/outputs/" + binding.DeviceID + "/radio-handoff/reacquire"
+		release, err = radioPrimaryDrain(ctx, endpoint, app.cfg.RadioHandoffControlToken, binding, intent, current)
+		if err != nil {
+			return err
+		}
+	}
+	if !isolated {
+		wire.Release = &release
+	}
+	checkpoint := func(phase string) error {
+		return withCurrent(func() error {
+			saved := wire
+			h.PrimaryReturn, h.ReacquirePhase = &saved, phase
+			h.PrimaryPending.Released = release.TeardownCSeq
+			return app.persistRadioLocked()
+		})
+	}
+	if err = checkpoint("primary_return_consume_attempted"); err != nil {
+		return err
+	}
+	receipt, err := p.primaryRadioReturnCall(ctx, wire)
+	ticker := time.NewTicker(30 * time.Millisecond)
+	defer ticker.Stop()
+	for err == nil && (receipt.Phase == "consumed" || receipt.Phase == "connecting") {
+		select {
+		case <-ctx.Done():
+			return ctx.Err()
+		case <-ticker.C:
+		}
+		if !current() {
+			return ErrAliasConflict
+		}
+		wire.Phase = "result"
+		receipt, err = p.primaryRadioReturnCall(ctx, wire)
+	}
+	if err != nil || receipt.Phase != "route_ready" || !current() {
+		return ErrAliasConflict
+	}
+	route := *receipt.Route
+
+	parkGeneration, err := strconv.ParseUint(park.Revision, 10, 64)
+	if err != nil || parkGeneration == 0 || checkpoint("primary_return_writer_open_attempted") != nil {
+		return ErrAliasConflict
+	}
+	oldWriter := output.MovePipeIdentity{PipeIdentity: park.Writer.Pipe, FD: park.Writer.FD}
+	pipe := output.RadioPipeBinding{Token: park.Token, Generation: parkGeneration, Writer: oldWriter}
+	guard := func() error {
+		if !current() {
+			return ErrAliasConflict
+		}
+		return nil
+	}
+	reopened, err := p.player.ReacquireRadio(ctx, pipe, guard, func(create func() (output.Output, error)) (output.Output, error) {
+		app.moveCustodyMu.Lock()
+		defer app.moveCustodyMu.Unlock()
+		if app.openedWriterOwner != p || app.openedWriter != oldWriter || strconv.FormatUint(app.openedWriterGeneration, 10) != park.Writer.Generation {
+			return nil, ErrAliasConflict
+		}
+		return app.openRegisteredOutputLocked(p, create)
+	})
+	if err != nil || !reopened.Suspended || reopened.WriterClosed || reopened.Binding != pipe {
+		return ErrAliasConflict
+	}
+	app.moveCustodyMu.Lock()
+	writer, generation, writerOwner := app.openedWriter, app.openedWriterGeneration, app.openedWriterOwner
+	app.moveCustodyMu.Unlock()
+	process, ok := nativeContentProcess()
+	oldGeneration, err := strconv.ParseUint(park.Writer.Generation, 10, 64)
+	if !ok || err != nil || process != park.Writer.Process || writerOwner != p || writer.PipeIdentity != park.Writer.Pipe || generation <= oldGeneration {
+		return ErrAliasConflict
+	}
+	fresh := queueWriterWire{process, writer.FD, writer.PipeIdentity, park.Writer.Epoch, strconv.FormatUint(generation, 10), park.Writer.InputDigest}
+	wire.Writer = &fresh
+	wire.Phase = "barrier"
+	if err = checkpoint("primary_return_barrier_attempted"); err != nil {
+		return err
+	}
+	barrier, err := p.primaryRadioReturnCall(ctx, wire)
+	if err != nil || barrier.Phase != "barrier_ready" || *barrier.Route != route || !current() {
+		return ErrAliasConflict
+	}
+	wire.Phase = "open"
+	if err = checkpoint("primary_return_open_attempted"); err != nil {
+		return err
+	}
+	opened, err := p.primaryRadioReturnCall(ctx, wire)
+	if err != nil || opened.Phase != "opened" || *opened.Route != route || !current() {
+		return ErrAliasConflict
+	}
+	if _, err = p.player.CompleteRadioReacquire(ctx, pipe, guard); err != nil || !current() {
+		return ErrAliasConflict
+	}
+	if err = p.commitPrimaryRadioReturn(ctx, h, opened, owner, globalIntent, generation, writer, resume); err != nil {
+		return err
+	}
+	succeeded = true
+	return nil
+}
+
+func (p *AppPlayer) commitPrimaryRadioReturn(ctx context.Context, h *radioHold, opened radioPrimaryReturnReceipt,
+	owner roomTransportIdentity, globalIntent, generation uint64, writer output.MovePipeIdentity, resume bool) error {
+	if ctx.Err() != nil || opened.Phase != "opened" || opened.Writer == nil || opened.Route == nil ||
+		p.primaryStream == nil || p.primaryStream != h.primary || p.primaryStream.Source == nil {
+		return ErrAliasConflict
+	}
+	predecessor := opened.predecessor()
+	if predecessor == nil {
+		return ErrAliasConflict
+	}
+	wire, primary, source, app := *opened.Writer, p.primaryStream, p.primaryStream.Source, p.app
+	_, _, err := p.player.RoomMove(ctx, "verify", source, writer, wire.Epoch, false, func(mutate func()) error {
+		p.aliasMu.Lock()
+		defer p.aliasMu.Unlock()
+		account, bound := p.sess.BoundUsername()
+		alias := p.aliasBindingLocked()
+		if ctx.Err() != nil || !bound || account != owner.AccountUserID || alias == nil || !alias.Ready || alias.RoomID != owner.RoomID ||
+			!p.radioReacquiredAliasCurrentLocked(owner) || p.aliasRevision != owner.AliasRevision || p.aliasIncarnation != owner.AliasIncarnation ||
+			p.aliasFingerprint != owner.AliasRegistry || p.spotConnId != owner.ConnectionID || p.state == nil || p.state.player == nil ||
+			p.state.player.SessionId != owner.SessionID || !p.state.player.IsPaused || p.primaryStream != primary || primary.Source != source ||
+			strconv.FormatUint(p.roomNativeIntent, 10) != opened.Revision {
+			return ErrAliasConflict
+		}
+		app.radio.mu.Lock()
+		defer app.radio.mu.Unlock()
+		if app.radio.failed || app.radio.Intent != globalIntent || app.radio.Holds[owner.RoomID] != h || h.owner != p ||
+			h.Phase != "reacquiring" || h.ReacquirePhase != "primary_return_open_attempted" || h.PrimaryReturn == nil ||
+			h.PrimaryReturn.Intent != opened.Intent || !h.PrimaryReturn.predecessorMatches(opened.radioPrimaryReturnWire) || h.PrimaryReturn.Writer == nil ||
+			*h.PrimaryReturn.Writer != wire || h.Primary == nil || *predecessor != *h.Primary {
+			return ErrAliasConflict
+		}
+		app.moveCustodyMu.Lock()
+		defer app.moveCustodyMu.Unlock()
+		if app.openedWriterOwner != p || app.openedWriter != writer || app.openedWriterGeneration != generation {
+			return ErrAliasConflict
+		}
+		mutate()
+		h.Phase, h.ReacquirePhase = "primary_released", "primary_return_opened"
+		if opened.Isolation != nil {
+			h.Phase = "primary_isolation_consumed"
+		}
+		h.WriterParked, h.RequiresPause = false, false
+		if err := app.persistRadioLocked(); err != nil {
+			h.Phase, h.WriterParked, h.RequiresPause = "unknown", true, true
+			return err
+		}
+		intent, _ := strconv.ParseUint(opened.Revision, 10, 64)
+		app.radioReacquiredWriter = &radioReacquiredWriter{
+			Intent: intent, GlobalIntent: globalIntent, Owner: p, Player: p.player, Session: p.sess,
+			Primary: primary, Source: source, Identity: owner, Wire: wire, Writer: writer, Process: wire.Process,
+			Generation: generation, StartAt: app.startCustody, MoveAt: app.moveCustody, PrimaryReturn: &opened,
+		}
+		app.radioParkedWriter, app.radioOtherWriter = nil, nil
+		if resume {
+			p.radioResume = &radioResumeMarker{Primary: primary, Source: source, Player: p.player, Session: p.sess, Owner: owner, Writer: wire}
+		}
+		app.refreshRadioOutputFenceLocked()
+		return nil
+	})
+	return err
+}
diff --git a/daemon/radio_primary_same_composed_test.go b/daemon/radio_primary_same_composed_test.go
new file mode 100644
index 0000000..ab6612a
--- /dev/null
+++ b/daemon/radio_primary_same_composed_test.go
@@ -0,0 +1,559 @@
+package daemon
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"net/url"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"strconv"
+	"strings"
+	"testing"
+	"time"
+
+	evtimpl "github.com/devgianlu/go-librespot/events/impl"
+	"github.com/devgianlu/go-librespot/mpris"
+	"github.com/devgianlu/go-librespot/player"
+	connectpb "github.com/devgianlu/go-librespot/proto/spotify/connectstate"
+)
+
+func testPrimarySameTargetWithActualSTART(t *testing.T, p *AppPlayer, worker *player.Player, stream *player.Stream) {
+	t.Helper()
+	endpoint, token := os.Getenv("PC_NATIVE_PRIMARY_HTTP_URL"), os.Getenv("PC_PRIMARY_HTTP_TOKEN")
+	if !radioWireLoopbackURL(endpoint) || !volumeHex64.MatchString(token) {
+		t.Fatal("missing isolated production OwnTone radio HTTP")
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), 13*time.Second)
+	defer cancel()
+	unauthorized, err := http.NewRequestWithContext(ctx, http.MethodPost, endpoint+"/api/outputs/1/radio-handoff/reacquire", nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	response, err := http.DefaultClient.Do(unauthorized)
+	if err != nil {
+		t.Fatal(err)
+	}
+	response.Body.Close()
+	if response.StatusCode != http.StatusForbidden {
+		t.Fatalf("production primary route token gate returned HTTP %d", response.StatusCode)
+	}
+	type counts struct {
+		Before   int    `json:"primary_before"`
+		Radio    int    `json:"primary_radio"`
+		After    int    `json:"primary_after"`
+		Selected int    `json:"primary_selected"`
+		Windows  [3]int `json:"primary_radio_windows"`
+	}
+	poll := func(check func(counts) bool) counts {
+		t.Helper()
+		client := &http.Client{Timeout: time.Second}
+		tick := time.NewTicker(20 * time.Millisecond)
+		defer tick.Stop()
+		for {
+			request, err := http.NewRequestWithContext(ctx, http.MethodGet, os.Getenv("PC_NATIVE_START_URL")+"/fixture/rtp", nil)
+			if err != nil {
+				t.Fatal(err)
+			}
+			response, err := client.Do(request)
+			if err != nil {
+				t.Fatal(err)
+			}
+			var observed counts
+			err = json.NewDecoder(response.Body).Decode(&observed)
+			response.Body.Close()
+			if err != nil || response.StatusCode != http.StatusOK {
+				t.Fatalf("RTP observation returned HTTP %d (%v)", response.StatusCode, err)
+			}
+			if check(observed) {
+				return observed
+			}
+			select {
+			case <-ctx.Done():
+				t.Fatalf("RTP window never observed: %#v", observed)
+			case <-tick.C:
+			}
+		}
+	}
+	poll(func(c counts) bool { return c.Before > 0 && c.Radio == 0 && c.After == 0 })
+
+	app := p.app
+	app.cfg.RoomTransportOwnToneURL = endpoint
+	app.cfg.RadioHandoffOwnerURL = endpoint
+	app.cfg.RadioHandoffControlToken = token
+	app.cfg.RadioHandoffStatePath = filepath.Join(t.TempDir(), "primary-radio.json")
+	if path := os.Getenv("PC_NATIVE_COLD_RADIO_JOURNAL"); path != "" {
+		if !filepath.IsAbs(path) {
+			t.Fatal("cold fixture requires an absolute journal path")
+		}
+		app.cfg.RadioHandoffStatePath = path
+	}
+	if err := app.initRadio(); err != nil {
+		t.Fatal(err)
+	}
+	owner, err := p.radioSourceOwner()
+	process, ok := nativeContentProcess()
+	if err != nil || !ok || owner.HomePodID != "1" {
+		t.Fatal("initial START35 did not retain the expected bound receiver", err)
+	}
+	originalTracks, originalSession, originalClient := p.state.tracks, p.state.player.SessionId, p.sess
+	originalGeneration := app.openedWriterGeneration
+	assertSource := func(paused bool) {
+		t.Helper()
+		source, err := worker.Start35CurrentSource(ctx)
+		if err != nil || source != stream.Source || p.primaryStream != stream ||
+			p.state.tracks != originalTracks || p.state.player.SessionId != originalSession || p.sess != originalClient ||
+			p.state.player.IsPaused != paused {
+			t.Fatalf("retained Native source, queue, session or pause state changed (want paused=%t): %v", paused, err)
+		}
+	}
+	if manager := os.Getenv("PC_PRIMARY_MANAGER_TEST_BIN"); manager != "" {
+		if originalTracks == nil || originalSession == "" {
+			t.Fatal("configured Manager scenario requires a real retained queue and Spotify session")
+		}
+		const nextURI = "spotify:track:0000000000000000000004"
+		queueRevision := originalTracks.TransportRevision()
+		if originalTracks.PeekNext(ctx).GetUri() != nextURI {
+			t.Fatal("configured Manager scenario requires an actual upcoming Spotify item")
+		}
+		testConfiguredManagerPrimaryResume(t, ctx, p, worker, manager)
+		if os.Getenv("PC_PRIMARY_MANAGER_COLD_PRIOR") != "" {
+			assertSource(true)
+			return
+		}
+		assertSource(false)
+		if originalTracks.TransportRevision() != queueRevision || originalTracks.PeekNext(ctx).GetUri() != nextURI {
+			t.Fatal("configured Manager handback changed the original queue occurrence")
+		}
+		if app.openedWriterOwner != p || app.openedWriterGeneration != originalGeneration+1 || app.radioOutputFence.Load() {
+			t.Fatal("configured Manager handback did not reopen the original Spotify writer exactly once")
+		}
+		poll(func(c counts) bool { return c.After > 0 })
+		return
+	}
+	ask := func(q radioPrimaryCommand) radioPrimaryReply {
+		t.Helper()
+		reply, err := p.radioPrimaryActor(ctx, q)
+		ack, ok := reply.(radioPrimaryReply)
+		if err != nil || !ok {
+			t.Fatalf("Native %s/%s failed: %v", q.Phase, q.ForPhase, err)
+		}
+		return ack
+	}
+	wait := func(q radioPrimaryCommand, expected string) radioPrimaryReply {
+		t.Helper()
+		ack := ask(q)
