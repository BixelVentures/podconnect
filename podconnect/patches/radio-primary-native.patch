+func TestPrimaryRadioColdDetachmentPreservesJournalUntilExactReceipt(t *testing.T) {
+	for _, mode := range []string{"missing", "wrong_predecessor", "wrong_park", "wrong_c_process", "persistence_failure", "interrupted_reply"} {
+		t.Run(mode, func(t *testing.T) {
+			p, op := contentFixture(t)
+			cfg := p.app.cfg
+			cfg.RadioHandoffControlToken = strings.Repeat("2", 64)
+			cfg.RadioHandoffStatePath = filepath.Join(t.TempDir(), "radio.json")
+			ctx := context.Background()
+			const oldC = "a411aa42-8b70-4bf4-a37d-81b0519db7df"
+			const newC = "6be0e1ce-092a-48b5-ab92-4a159ed2b7b2"
+			const p3 = "b3919fea-955b-4d4c-a581-c71cb92712b2"
+			const p1 = "87f6f7dd-2a03-4d75-9a62-6a7a2e089705"
+			const handoff = "ac0ff645-a01f-4d2a-85e3-b0011d786e6d"
+			oldNative := contentProcess{BootID: oldC, PID: "123", StartTicks: "42"}
+			oldProcess := radioProcessID(oldNative)
+			owner := *op.Capture.OldOwner
+			device, room := owner.HomePodID, owner.RoomID
+			digest := strings.Repeat("a", 64)
+			previous := radioPrimaryBinding{Process: oldC, DeviceID: device, Operation: p3, Incarnation: "4", Epoch: "9", Route: "8"}
+			incumbent := previous
+			incumbent.Operation, incumbent.Epoch = p1, "11"
+			park := radioPrimaryParkWire{Schema: cPrimaryParkSchema, Phase: "prepared", Action: p3, Revision: "2", Owner: owner,
+				Writer: queueWriterWire{Process: oldNative, FD: "3", Epoch: "5", Generation: "7", InputDigest: digest,
+					Pipe: output.PipeIdentity{Type: "fifo", Device: "1", Inode: "3"}},
+				Route: &roomVolumeRoute{Process: oldC, DeviceID: device, DeviceIncarnation: "4", SessionEpoch: "7",
+					RouteRevision: "7", SelectionRevision: "5", InputGeneration: "1", InputItemID: "1", InputPathDigest: digest},
+				Token: strings.Repeat("b", 32)}
+			reserve := radioPrimaryCommand{Schema: nativePrimarySchema, Phase: "reserve", Process: oldProcess, Handoff: handoff,
+				Generation: "2", Owner: "2", Action: p1, Target: room, Intent: "1", From: room, Session: &previous}
+			stop, start := reserve, reserve
+			stop.Phase, start.Phase, start.Station = "stop", "start", "p1"
+			h := &radioHold{
+				Request: radioRequest{Schema: "podconnect.native_radio_primary_hold.v1", ProcessID: oldProcess,
+					TargetID: room, HandoffID: handoff, ActionID: p1, ExpectedRevision: "1", Generation: "2"},
+				Phase: "primary_active", Actions: map[string]bool{}, WriterParked: true, RequiresPause: true,
+				Primary: &incumbent, PrimaryPark: &park,
+				PrimaryStatus: &radioPrimaryActive{OwnerGeneration: "2", Request: radioPrimaryStartWire{
+					Schema: cPrimaryStartSchema, Action: p1, Station: "p1", Generation: "2",
+					radioPrimaryTarget: radioPrimaryTarget{Process: oldC, Device: device, Incarnation: "4", Epoch: "9", Route: "8"}}},
+				PrimaryPending: &radioPrimaryPending{Reserve: reserve, Started: &start, Stopped: &stop, ReplacementDone: true,
+					PriorRelease: &radioPrimaryStopReceipt{radioPrimaryStopRequest: radioPrimaryStopRequest{
+						Schema: primaryRadioStopSchema, Phase: "released", Action: p1, radioPrimaryBinding: previous}, TeardownCSeq: 8}},
+			}
+
+			var reads atomic.Int32
+			var laterC atomic.Bool
+			server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, req *http.Request) {
+				if req.Header.Get("X-PodConnect-Token") != cfg.RadioHandoffControlToken {
+					t.Error("unauthenticated C request")
+					w.WriteHeader(http.StatusForbidden)
+					return
+				}
+				if req.Method == http.MethodGet && strings.HasSuffix(req.URL.Path, "/radio-handoff/primary-readiness") {
+					d := strings.Split(req.URL.Path, "/")[3]
+					process := newC
+					if laterC.Load() {
+						process = "b0587a71-b229-4c4c-a262-0677280feaa2"
+					}
+					physical := false
+					_ = json.NewEncoder(w).Encode(radioPrimaryCapability{Schema: primaryRadioCapabilitySchema,
+						Effects: "primary_route_v1", Process: process, Device: d, Incarnation: "4", LegacyOpen: &physical, Physical: &physical})
+					return
+				}
+				var wire radioPrimaryColdWire
+				if req.Method != http.MethodPost || req.URL.Path != "/api/outputs/"+device+"/radio-handoff/reacquire" ||
+					json.NewDecoder(req.Body).Decode(&wire) != nil || wire.Schema != cPrimaryColdDetachmentSchema ||
+					wire.Phase != "observe" || wire.Session != incumbent || wire.Park.Route == nil || *wire.Park.Route != *park.Route {
+					t.Error("unexpected request or old radio replay")
+					w.WriteHeader(http.StatusBadRequest)
+					return
+				}
+				wire.Park.Route = park.Route
+				if wire.Park != park {
+					t.Error("cold request did not preserve the original Spotify park")
+					w.WriteHeader(http.StatusBadRequest)
+					return
+				}
+				attempt := reads.Add(1)
+				ack := radioPrimaryColdReceipt{radioPrimaryColdWire: wire,
+					Target: radioPrimaryTarget{Process: newC, Device: device, Incarnation: "4", Epoch: "0", Route: "0"}}
+				ack.Phase = "isolated"
+				switch mode {
+				case "missing":
+					w.WriteHeader(http.StatusConflict)
+					return
+				case "wrong_predecessor":
+					ack.Session = previous
+				case "wrong_park":
+					ack.Park.Revision = "3"
+				case "wrong_c_process":
+					ack.Target.Process = oldC
+				case "interrupted_reply":
+					if attempt == 1 {
+						// The fixture owner has already durably isolated the old
+						// route. Lose only the first observation of that fact.
+						w.WriteHeader(http.StatusServiceUnavailable)
+						return
+					}
+				}
+				_ = json.NewEncoder(w).Encode(ack)
+			}))
+			defer server.Close()
+			cfg.RoomTransportOwnToneURL, cfg.RadioHandoffOwnerURL = server.URL, server.URL
+			seed := &App{cfg: cfg}
+			if err := seed.initRadio(); err != nil {
+				t.Fatal(err)
+			}
+			seed.radio.Holds[room], seed.radio.Intent, seed.radio.Generation = h, 2, 2
+			if err := seed.persistRadioLocked(); err != nil {
+				t.Fatal(err)
+			}
+			restart := &App{cfg: cfg}
+			if err := restart.initRadio(); err != nil {
+				t.Fatal(err)
+			}
+			if mode == "persistence_failure" {
+				if err := os.WriteFile(cfg.RadioHandoffStatePath+".pending", nil, 0600); err != nil {
+					t.Fatal(err)
+				}
+			}
+			first := restart.radioPrimaryReadiness(ctx, op.Capture.Process)
+			if first.ColdDetachment != nil || first.Protocol != "" || first.Observation != nil || first.Revision != "2" ||
+				!restart.radioOutputFence.Load() || restart.radio.Holds[room].Phase != "unknown" || reads.Load() != 1 {
+				t.Fatal("unproved or unpersisted detachment published authority")
+			}
+			if mode != "interrupted_reply" {
+				return
+			}
+			settled := restart.radioPrimaryReadiness(ctx, op.Capture.Process)
+			proof := settled.ColdDetachment
+			if proof == nil || proof.Session != incumbent || proof.Process != oldProcess || proof.Handoff != handoff ||
+				proof.Generation != "2" || proof.Room != room || proof.Target.Process != newC ||
+				settled.Revision != "3" || settled.Observation != nil || settled.Protocol != "" ||
+				settled.IsolatedSession != nil || settled.ReleasedSession != nil || settled.TeardownCSeq != nil ||
+				restart.radioOutputFence.Load() || !primaryRadioColdDetached(restart.radio.Holds[room]) || reads.Load() != 2 {
+				t.Fatal("exact passive receipt did not persist before dropping the old fence")
+			}
+			laterC.Store(true)
+			restartedAgain := &App{cfg: cfg}
+			if err := restartedAgain.initRadio(); err != nil {
+				t.Fatal(err)
+			}
+			again := restartedAgain.radioPrimaryReadiness(ctx, op.Capture.Process)
+			if again.ColdDetachment == nil || *again.ColdDetachment != *proof || again.Revision != "3" ||
+				again.Protocol != "" || again.Observation != nil || restartedAgain.radioOutputFence.Load() || reads.Load() != 2 ||
+				restartedAgain.radio.Holds[room].owner != nil || restartedAgain.radio.Holds[room].primary != nil {
+				t.Fatal("persisted detachment replayed or became a current owner on restart")
+			}
+		})
+	}
+}
