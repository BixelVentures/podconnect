+
+type radioPrimaryHTTPCall struct {
+	Token   string
+	Query   bool
+	Request radioPrimaryCommand
+	Context context.Context
+}
+
+func (s *ConcreteApiServer) handleRadioPrimaryHTTP(w http.ResponseWriter, r *http.Request) {
+	call := radioPrimaryHTTPCall{Token: r.Header.Get("X-PodConnect-Token"), Query: r.Method == http.MethodGet, Context: r.Context()}
+	if r.URL.RawQuery != "" {
+		w.WriteHeader(http.StatusBadRequest)
+		return
+	}
+	if !call.Query && !roomTransportBody(w, r, &call.Request) {
+		return
+	}
+	ctx, cancel := context.WithTimeout(r.Context(), 8*time.Second)
+	defer cancel()
+	data, err := s.roomTransportAsk(ctx, apiRadioPrimaryHTTP, call)
+	if err == ErrForbidden {
+		w.WriteHeader(http.StatusForbidden)
+		return
+	}
+	roomTransportResponse(w, data, err)
+}
+
+func (app *App) handleRadioPrimaryAPI(ctx context.Context, req ApiRequest) {
+	c, ok := req.Data.(radioPrimaryHTTPCall)
+	if !ok || app.cfg == nil || app.cfg.RadioHandoffControlToken == "" ||
+		subtle.ConstantTimeCompare([]byte(c.Token), []byte(app.cfg.RadioHandoffControlToken)) != 1 {
+		req.Reply(nil, ErrForbidden)
+		return
+	}
+	process, processOK := nativeContentProcess()
+	if !processOK {
+		req.Reply(nil, ErrAliasConflict)
+		return
+	}
+	if c.Query {
+		req.Reply(app.radioPrimaryReadiness(ctx, process), nil)
+		return
+	}
+	if !app.radioEnabled() || c.Request.Process != radioProcessID(process) ||
+		!validPrimaryCommandIdentity(c.Request) || c.Request.Phase != "result" && app.manualReleasePending() {
+		req.Reply(nil, ErrAliasConflict)
+		return
+	}
+	actionCtx, cancel := queueOperationContext(ctx, c.Context)
+	defer cancel()
+	data, err := app.primaryRadioActorAsk(actionCtx, apiRadioPrimaryActor, c.Request)
+	req.Reply(data, err)
+}
+
+func (t radioPrimaryTarget) valid() bool {
+	return volumeUUID.MatchString(t.Process) && volumeCounter(t.Device) && t.Device != "0" &&
+		volumeCounter(t.Incarnation) && t.Incarnation != "0" && volumeCounter(t.Epoch) && volumeCounter(t.Route)
+}
+
+type radioPrimaryIsolation struct {
+	radioPrimaryBinding
+	Reason string `json:"local_isolation"`
+}
+
+func (proof *radioPrimaryIsolation) matches(binding *radioPrimaryBinding) bool {
+	return proof != nil && binding != nil && binding.valid() && proof.radioPrimaryBinding == *binding &&
+		proof.Reason == "rtsp_control_lost"
+}
+
+func primaryRadioIsolated(h *radioHold) bool {
+	return h != nil && h.Phase == "primary_isolated" && h.PrimaryIsolation.matches(h.Primary)
+}
+
+func primaryRadioContentReady(h *radioHold) bool {
+	return primaryRadioReleased(h) || h != nil && h.Phase == "primary_isolation_consumed" &&
+		!h.WriterParked && !h.PauseUncertain && h.ReacquirePhase == "primary_return_opened" &&
+		h.PrimaryReturn != nil && h.PrimaryReturn.Phase == "open" && h.PrimaryReturn.Writer != nil &&
+		h.PrimaryReturn.Release == nil && h.PrimaryIsolation.matches(h.Primary) &&
+		h.PrimaryReturn.Isolation.matches(h.Primary)
+}
+
+func (p *AppPlayer) primaryRadioObserveIsolation(ctx context.Context, binding *radioPrimaryBinding) (*radioPrimaryIsolation, error) {
+	if binding == nil || !binding.valid() {
+		return nil, ErrAliasConflict
+	}
+	ack, err := p.primaryRadioCStart(ctx, radioPrimaryStartWire{
+		Schema: cPrimaryStartSchema, Phase: "observe_isolation",
+		radioPrimaryTarget: radioPrimaryTarget{Device: binding.DeviceID}, Predecessor: binding,
+	}, false)
+	return ack.Isolation, err
+}
+
+func (p *AppPlayer) primaryRadioCStart(ctx context.Context, r radioPrimaryStartWire, sameTarget bool) (radioPrimaryStartReceipt, error) {
+	var ack radioPrimaryStartReceipt
+	if r.PriorIsolation != nil && (r.PriorRelease != nil || !r.PriorIsolation.matches(r.Predecessor) ||
+		r.PriorIsolation.DeviceID != r.Device) {
+		return ack, ErrAliasConflict
+	}
+	endpoint := strings.TrimSuffix(p.app.cfg.RoomTransportOwnToneURL, "/") + "/api/outputs/" + r.Device + "/radio-handoff/reacquire"
+	if err := radioAuthenticatedHTTP(ctx, endpoint, p.app.cfg.RadioHandoffControlToken, r, &ack); err != nil {
+		return ack, err
+	}
+	if ack.Schema != r.Schema || !ack.radioPrimaryTarget.valid() || ack.Device != r.Device {
+		return ack, ErrAliasConflict
+	}
+	if (ack.Predecessor == nil) != (r.Predecessor == nil) || r.Predecessor != nil && *ack.Predecessor != *r.Predecessor ||
+		ack.PriorRelease != nil || ack.ParkToken != "" ||
+		(ack.PriorIsolation == nil) != (r.PriorIsolation == nil) ||
+		r.PriorIsolation != nil && *ack.PriorIsolation != *r.PriorIsolation {
+		return ack, ErrAliasConflict
+	}
+	if r.Phase == "observe_isolation" {
+		if !ack.Isolation.matches(r.Predecessor) || ack.Phase != "isolated" || ack.Session != nil ||
+			ack.Action != "" || ack.Station != "" || ack.Generation != "" ||
+			ack.Process != r.Predecessor.Process || ack.Incarnation != r.Predecessor.Incarnation ||
+			!primaryReturnCounter(ack.Epoch, r.Predecessor.Epoch, 1) || ack.Route != r.Predecessor.Route {
+			return ack, ErrAliasConflict
+		}
+		return ack, nil
+	}
+	if ack.Isolation != nil || r.PriorIsolation != nil &&
+		(ack.Process != r.PriorIsolation.Process || ack.Incarnation != r.PriorIsolation.Incarnation ||
+			!primaryReturnCounter(ack.Epoch, r.PriorIsolation.Epoch, 1) || ack.Route != r.PriorIsolation.Route) {
+		return ack, ErrAliasConflict
+	}
+	if r.Phase == "target" || r.Phase == "preflight_target" || r.Phase == "preflight_replace_target" {
+		if ack.Phase != "target_ready" || ack.Action != "" || ack.Station != "" || ack.Generation != "" || ack.Session != nil {
+			return ack, ErrAliasConflict
+		}
+	} else if ack.radioPrimaryTarget != r.radioPrimaryTarget || ack.Action != r.Action || ack.Station != r.Station ||
+		!volumeCounter(r.Generation) || r.Generation == "0" || ack.Generation != r.Generation ||
+		(ack.Phase == "playing" && (ack.Session == nil || !ack.Session.valid() || ack.Session.DeviceID != r.Device ||
+			ack.Session.Process != r.Process || ack.Session.Operation != r.Action ||
+			ack.Session.Incarnation != r.Incarnation)) ||
+		(ack.Phase != "playing" && ack.Session != nil) {
+		return ack, ErrAliasConflict
+	}
+	if ack.Phase == "playing" {
+		before, err := strconv.ParseUint(r.Epoch, 10, 64)
+		route, routeErr := strconv.ParseUint(r.Route, 10, 64)
+		epochDelta, routeDelta := uint64(1), uint64(0)
+		if r.Predecessor != nil && r.Predecessor.DeviceID == r.Device &&
+			r.PriorIsolation == nil && (r.PriorRelease == nil || r.PriorRelease.Action == r.Action) {
+			epochDelta = 2
+		} else if sameTarget {
+			epochDelta, routeDelta = 2, 1
+		}
+		if err != nil || routeErr != nil || before > ^uint64(0)-epochDelta || route > ^uint64(0)-routeDelta ||
+			ack.Session.Epoch != strconv.FormatUint(before+epochDelta, 10) ||
+			ack.Session.Route != strconv.FormatUint(route+routeDelta, 10) {
+			return ack, ErrAliasConflict
+		}
+	}
+	return ack, nil
+}
+
+func validPrimaryCommandIdentity(r radioPrimaryCommand) bool {
+	return r.Schema == nativePrimarySchema && volumeHex64.MatchString(r.Process) &&
+		volumeUUID.MatchString(r.Handoff) && volumeUUID.MatchString(r.Action) &&
+		volumeCounter(r.Generation) && r.Generation != "0" &&
+		volumeCounter(r.Intent) && nativeOwnerASCII(r.Target, 255) &&
+		(r.From == "" || nativeOwnerASCII(r.From, 255))
+}
+
+func primaryCommandMatches(r, reserve radioPrimaryCommand) bool {
+	return r.Schema == reserve.Schema && r.Process == reserve.Process && r.Handoff == reserve.Handoff &&
+		r.Generation == reserve.Generation && r.Action == reserve.Action && r.Target == reserve.Target &&
+		r.Intent == reserve.Intent && r.Owner == reserve.Owner && r.From == reserve.From
+}
+
+func primaryObservation(r radioPrimaryCommand, state, source string) *radioPrimaryObservation {
+	generation, _ := strconv.ParseUint(r.Owner, 10, 64)
+	now := time.Now().Unix()
+	return &radioPrimaryObservation{State: state, Station: r.Station, Target: r.Target, Source: source,
+		OwnerGeneration: generation, ObservedAt: now, ValidUntil: now + 3}
+}
+
+func (p *AppPlayer) primaryRadioRoom(target string) string {
+	p.aliasMu.Lock()
+	defer p.aliasMu.Unlock()
+	if p.aliasRetired || !p.transportMappingCurrentLocked() {
+		return ""
+	}
+	for _, alias := range p.aliasRegistry {
+		if alias.RoomID == target && volumeCounter(alias.HomePodID) && alias.HomePodID != "0" {
+			return alias.HomePodID
+		}
+	}
+	return ""
+}
+
+func (p *AppPlayer) radioPrimaryActor(ctx context.Context, r radioPrimaryCommand) (any, error) {
+	app := p.app
+	process, ok := nativeContentProcess()
+	device := p.primaryRadioRoom(r.Target)
+	if !ok || device == "" || r.Process != radioProcessID(process) || !validPrimaryCommandIdentity(r) || ctx.Err() != nil {
+		return nil, ErrAliasConflict
+	}
+	app.radio.mu.Lock()
+	defer app.radio.mu.Unlock()
+	if app.radio.failed || strconv.FormatUint(app.radio.Intent, 10) != r.Intent {
+		return nil, ErrAliasConflict
+	}
+	h := app.radio.Holds[r.Target]
+	if r.Phase == "reserve" {
+		for _, hold := range app.radio.Holds {
+			if hold == nil || hold.PrimaryPending == nil {
+				return nil, ErrAliasConflict // A legacy hold still owns its source or receiver.
+			}
+			if hold != h && hold.WriterParked && (primaryRadioReleased(hold) || primaryRadioIsolated(hold)) {
+				return nil, ErrAliasConflict // The parked writer pins the advertised room.
+			}
+		}
+		if r.Session != nil {
+			return p.reservePrimaryRadioReplacement(r, h)
+		}
+		generation, err := strconv.ParseUint(r.Generation, 10, 64)
+		if err != nil || generation <= app.radio.Generation || r.Owner != "" || r.ForPhase != "" || r.Session != nil || r.Station != "" {
+			return nil, ErrAliasConflict
+		}
+		if release, ok := primaryParkedStopReceipt(h); ok {
+			return p.reservePrimaryParkedRestart(r, h, &release, generation)
+		}
+		if primaryRadioIsolated(h) {
+			return p.reservePrimaryParkedRestart(r, h, nil, generation)
+		}
+		if h == nil || primaryRadioRetired(h) && !h.WriterParked && !h.PauseUncertain {
+			h = &radioHold{owner: p, Phase: "primary_reserved", Actions: map[string]bool{},
+				Request: radioRequest{Schema: "podconnect.native_radio_primary_hold.v1", ProcessID: r.Process,
+					TargetID: r.Target, HandoffID: r.Handoff, Generation: r.Generation, ActionID: r.Action, ExpectedRevision: r.Intent}}
+		} else if h.owner != p || h.Primary == nil || h.Phase != "primary_active" || r.From != r.Target || primaryReplacementPending(h) {
+			return nil, ErrAliasConflict
+		}
+		r.Owner = r.Generation
+		h.PrimaryPending = &radioPrimaryPending{Reserve: r}
+		app.radio.Generation = generation
+		app.radio.Holds[r.Target] = h
+		if err = app.persistRadioLocked(); err != nil {
+			return nil, err
+		}
+		r.Phase = "reserved"
+		return radioPrimaryReply{radioPrimaryCommand: r}, nil
+	}
+	if h == nil || h.owner != p || h.PrimaryPending == nil || !primaryCommandMatches(r, h.PrimaryPending.Reserve) {
+		return nil, ErrAliasConflict
+	}
+	operation := h.PrimaryPending
+	if operation.ParkedRestart {
+		return p.primaryRadioParkedRestartActor(ctx, r, h, device)
+	}
+	if operation.Reserve.Session != nil {
+		return p.primaryRadioReplacementActor(ctx, r, h, device)
+	}
+	if r.Phase == "prepare_start" || r.Phase == "result" && r.ForPhase == "prepare_start" {
+		return p.primaryRadioPrepareStation(ctx, r, h, device)
+	}
+	start := r.Phase == "start"
+	if start || (r.Phase == "result" && r.ForPhase == "start") {
+		if operation.Target == nil || operation.Target.Device != device || operation.Station != r.Station || r.Session != nil {
+			return nil, ErrAliasConflict
+		}
+		wire := radioPrimaryStartWire{Schema: cPrimaryStartSchema, Phase: "result", Action: r.Action, Station: r.Station, Generation: r.Generation, radioPrimaryTarget: *operation.Target}
+		if start {
+			if h.Phase != "primary_reserved" || operation.Started != nil || r.ForPhase != "" ||
+				operation.SameTarget && !operation.Decoded {
+				return nil, ErrAliasConflict
+			}
+			admitted := r
+			operation.Started, h.Phase = &admitted, "primary_start_pending"
+			if err := app.persistRadioLocked(); err != nil {
+				return nil, err
+			}
+			wire.Phase = "start"
+		} else if operation.Started == nil {
+			return nil, ErrAliasConflict
+		}
+		var ack radioPrimaryStartReceipt
+		var err error
+		if operation.SameTarget {
+			ack, err = p.primaryRadioAdvancePark(ctx, h, r, wire, start)
+		} else {
+			ack, err = p.primaryRadioCStart(ctx, wire, false)
+		}
+		if err != nil {
+			return nil, err
+		}
+		switch ack.Phase {
+		case "pending":
+			r.Phase = "pending"
+		case "playing":
+			h.Primary, h.Phase = ack.Session, "primary_active"
+			h.PrimaryStatus = primaryRadioActiveRead(wire, r.Owner, operation.SameTarget)
+			r.Session, r.Phase = ack.Session, "playing"
+		case "rejected":
+			if operation.SameTarget {
+				h.Phase = "unknown"
+				_ = app.persistRadioLocked()
+				return nil, ErrAliasConflict
+			}
+			h.Phase, r.Phase = "primary_rejected", "rejected"
+		default:
+			h.Phase = "unknown"
+			_ = app.persistRadioLocked()
+			return nil, ErrAliasConflict
+		}
+		if err = app.persistRadioLocked(); err != nil {
+			return nil, err
+		}
+		reply := radioPrimaryReply{radioPrimaryCommand: r}
+		if r.Phase == "playing" {
+			reply.Observation = primaryObservation(r, "playing", "radio")
+		}
+		return reply, nil
+	}
+	return p.radioPrimaryActorStop(ctx, r, h)
+}
+
+func (p *AppPlayer) radioPrimaryActorStop(ctx context.Context, r radioPrimaryCommand, h *radioHold) (any, error) {
+	app, operation := p.app, h.PrimaryPending
+	stop := r.Phase == "stop"
+	if (!stop && !(r.Phase == "result" && r.ForPhase == "stop")) ||
+		h.Primary == nil || r.Session == nil || *r.Session != *h.Primary || r.Station != "" {
+		return nil, ErrAliasConflict
+	}
+	phase := "result"
+	if stop {
+		if operation.Stopped != nil || h.Phase != "primary_active" || r.ForPhase != "" {
+			return nil, ErrAliasConflict
+		}
+		admitted := r
+		operation.Stopped, h.Phase = &admitted, "primary_stop_pending"
+		if err := app.persistRadioLocked(); err != nil {
+			return nil, err
+		}
+		phase = "claim_stop"
+	} else if operation.Stopped == nil {
+		return nil, ErrAliasConflict
+	}
+	binding := *h.Primary
+	wire := radioPrimaryStopRequest{Schema: primaryRadioStopSchema, Phase: phase, Action: r.Action, radioPrimaryBinding: binding}
+	var ack radioPrimaryStopReceipt
+	endpoint := strings.TrimSuffix(app.cfg.RoomTransportOwnToneURL, "/") + "/api/outputs/" + binding.DeviceID + "/radio-handoff/reacquire"
+	if err := radioAuthenticatedHTTP(ctx, endpoint, app.cfg.RadioHandoffControlToken, wire, &ack); err != nil {
+		return nil, err
+	}
+	if ack.Schema != wire.Schema || ack.Action != wire.Action || ack.radioPrimaryBinding != binding {
+		return nil, ErrAliasConflict
+	}
+	r.Phase = "pending"
+	if ack.Phase == "pending" && ack.TeardownCSeq == 0 {
+		return radioPrimaryReply{radioPrimaryCommand: r}, nil
+	}
+	if ack.Phase != "released" || ack.TeardownCSeq <= 0 {
+		return nil, ErrAliasConflict
+	}
+	h.Phase, operation.Released = "primary_released", ack.TeardownCSeq
+	if err := app.persistRadioLocked(); err != nil {
+		return nil, err
+	}
+	r.Phase = "released"
+	return radioPrimaryReply{radioPrimaryCommand: r, CSeq: ack.TeardownCSeq, Observation: primaryObservation(r, "stopped", "none")}, nil
+}
+
+func primaryRadioReleased(h *radioHold) bool {
+	return h != nil && h.PrimaryPending != nil && h.Primary != nil && h.Primary.valid() &&
+		h.Phase == "primary_released" && h.PrimaryPending.Released > 0 &&
+		(volumeUUID.MatchString(h.PrimaryAction) || h.PrimaryPending.Stopped != nil &&
+			volumeUUID.MatchString(h.PrimaryPending.Stopped.Action) && h.PrimaryPending.Stopped.Session != nil &&
+			*h.PrimaryPending.Stopped.Session == *h.Primary)
+}
+
+func primaryRadioRetired(h *radioHold) bool {
+	return h != nil && !h.WriterParked && !h.PauseUncertain && (primaryRadioContentReady(h) || primaryRadioColdDetached(h) || h.PrimaryPending != nil && h.Phase == "primary_rejected")
+}
