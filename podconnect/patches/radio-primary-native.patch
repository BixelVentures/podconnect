+func testColdPrimaryManagerRead(t *testing.T, ctx context.Context, app *App, manager string) {
+	t.Helper()
+	api, err := NewApiServer(app.log, "127.0.0.1", 0, "", "", "")
+	if err != nil {
+		t.Fatal(err)
+	}
+	server := api.(*ConcreteApiServer)
+	defer server.Close()
+	prior := app.server
+	app.server = server
+	dispatchCtx, cancel := context.WithCancel(ctx)
+	done := make(chan struct{})
+	go func() {
+		defer close(done)
+		app.forwardAPI(dispatchCtx)
+	}()
+	defer func() {
+		cancel()
+		<-done
+		app.server = prior
+	}()
+
+	endpoint := "http://" + server.listener.Addr().String()
+	cmd := exec.CommandContext(ctx, manager, "-test.v", "-test.timeout=18s", "-test.run", "^TestConfiguredPrimaryRadioColdDetachmentComposed$")
+	cmd.Env = append(os.Environ(), "PC_PRIMARY_MANAGER_NATIVE_URL="+endpoint)
+	result, err := cmd.CombinedOutput()
+	t.Logf("cold Manager result:\n%s", result)
+	if err != nil {
+		t.Fatal("actual Manager did not reconcile the old P1 journal", err)
+	}
+}
