+	poll(func(c counts) bool { return c.Radio > 0 && c.After == 0 })
+
+	if os.Getenv("PC_NATIVE_PRIMARY_NEW_SELECTION") != "" {
+		before := poll(func(c counts) bool { return c.Radio > 0 && c.After == 0 && c.Selected == 0 })
+		testPrimaryNewSpotifySelection(t, ctx, p, worker, stream, owner, func() {
+			assertSource(true)
+			poll(func(c counts) bool { return c.Radio > before.Radio && c.After == 0 && c.Selected == 0 })
+		})
+		poll(func(c counts) bool { return c.After == 0 && c.Selected > 0 })
