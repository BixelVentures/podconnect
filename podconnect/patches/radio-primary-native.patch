+package daemon
+
+import (
+	"context"
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"sync/atomic"
+	"testing"
+	"time"
+)
+
+func TestPrimaryRadioDrainBindsActionAndNeverReplays(t *testing.T) {
+	binding := radioPrimaryBinding{
+		Process: "a411aa42-8b70-4bf4-a37d-81b0519db7df", Operation: "b3919fea-955b-4d4c-a581-c71cb92712b2",
+		DeviceID: "2", Incarnation: "4", Epoch: "5", Route: "0",
+	}
+	const action = "87f6f7dd-2a03-4d75-9a62-6a7a2e089705"
+	for _, variant := range []string{"exact", "stale", "wrong_action", "lost_reply"} {
+		t.Run(variant, func(t *testing.T) {
+			var claims, observations atomic.Int32
+			var current atomic.Bool
+			current.Store(true)
+			server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				var request radioPrimaryStopRequest
+				if json.NewDecoder(r.Body).Decode(&request) != nil || request.Schema != primaryRadioStopSchema ||
+					request.Action != action || request.radioPrimaryBinding != binding || r.Header.Get("X-PodConnect-Token") != "inert-test-token" {
+					w.WriteHeader(http.StatusBadRequest)
+					return
+				}
+				ack := radioPrimaryStopReceipt{radioPrimaryStopRequest: request}
+				switch request.Phase {
+				case "claim_stop":
+					claims.Add(1)
+					if variant == "lost_reply" {
+						w.WriteHeader(http.StatusServiceUnavailable)
+						return
+					}
+					ack.Phase = "pending"
+				case "result":
+					observations.Add(1)
+					ack.Phase, ack.TeardownCSeq = "released", 7
+					if variant == "stale" {
+						current.Store(false)
+					}
+					if variant == "wrong_action" {
+						ack.Action = binding.Operation
+					}
+				default:
+					w.WriteHeader(http.StatusBadRequest)
+					return
+				}
+				_ = json.NewEncoder(w).Encode(ack)
+			}))
+			defer server.Close()
+
+			ctx, cancel := context.WithTimeout(context.Background(), time.Second)
+			defer cancel()
+			_, err := radioPrimaryDrain(ctx, server.URL, "inert-test-token", binding, action, current.Load)
+			if (err == nil) != (variant == "exact") || claims.Load() != 1 {
+				t.Fatalf("exact-action result err=%v, claims=%d", err, claims.Load())
+			}
+			if variant == "lost_reply" && observations.Load() != 0 || variant != "lost_reply" && observations.Load() != 1 {
+				t.Fatalf("unexpected status reads: %d", observations.Load())
+			}
+		})
+	}
+}
+
+func TestPrimaryRadioConnectTransferDoesNotClaimStop(t *testing.T) {
+	app := &App{}
+	p := &AppPlayer{app: app}
+	h := &radioHold{Primary: &radioPrimaryBinding{}, Phase: "primary_active", owner: p}
+	app.radio.Holds = map[string]*radioHold{"target": h}
+	if err := p.preemptRadioPolicy(context.Background(), "target", "transfer", false, false); err == nil || h.PrimaryAction != "" || h.Phase != "primary_active" {
+		t.Fatal("unproven transfer changed the primary radio hold")
+	}
+}
