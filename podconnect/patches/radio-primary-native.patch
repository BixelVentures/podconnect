+package daemon
+
+import (
+	"context"
+	"strconv"
+	"strings"
+)
+
+const cPrimaryColdDetachmentSchema = "podconnect.output_radio_primary_cold_detachment.v1"
+
+type radioPrimaryColdWire struct {
+	Schema  string               `json:"schema"`
+	Phase   string               `json:"phase"`
+	Park    radioPrimaryParkWire `json:"park"`
+	Session radioPrimaryBinding  `json:"prior_session"`
+}
+
+type radioPrimaryColdReceipt struct {
+	radioPrimaryColdWire
+	Target radioPrimaryTarget `json:"current_target"`
+}
+
+type radioPrimaryColdDetachment struct {
+	Process    string              `json:"prior_native_process_id"`
+	Handoff    string              `json:"prior_handoff_id"`
+	Generation string              `json:"prior_owner_generation"`
+	Room       string              `json:"target_id"`
+	Session    radioPrimaryBinding `json:"prior_session"`
+	Target     radioPrimaryTarget  `json:"current_target"`
+}
+
+// Use the completed operation and its retained park as one identity. A
+// reservation, claimed STOP, pending successor, or attempted return cannot
+// be rehabilitated by a receipt for another phase or receiver.
+func primaryColdHoldMatches(h *radioHold, room string) bool {
+	if h == nil || h.owner != nil || h.primary != nil || h.PrimaryPark == nil || h.PrimaryPark.Route == nil ||
+		h.PrimaryStatus == nil || h.PrimaryPending == nil || h.PrimaryReturn != nil ||
+		h.PrimaryAction != "" || h.ReacquirePhase != "" || h.PauseUncertain || !validPrimaryRadioHold(h) ||
+		primaryReplacementPending(h) || h.Request.TargetID != room {
+		return false
+	}
+	r, park, old := h.Request, h.PrimaryPark, h.Primary
+	reserve, status := h.PrimaryPending.Reserve, h.PrimaryStatus
+	if reserve.Process != r.ProcessID || reserve.Handoff != r.HandoffID || reserve.Action != r.ActionID ||
+		reserve.Target != room || reserve.Generation != r.Generation || reserve.Owner != r.Generation ||
+		reserve.Intent != r.ExpectedRevision ||
+		status.OwnerGeneration != r.Generation || status.Request.Action != old.Operation ||
+		status.Request.Generation != r.Generation || status.Request.Process != old.Process ||
+		status.Request.Device != old.DeviceID || status.Request.Incarnation != old.Incarnation ||
+		!nativeOwnerASCII(status.Request.Station, 31) {
+		return false
+	}
+	if stop := h.PrimaryPending.Stopped; stop != nil {
+		prior := h.PrimaryPending.PriorRelease
+		if !h.PrimaryPending.ReplacementDone || reserve.Session == nil || stop.Session == nil ||
+			*stop.Session != *reserve.Session || *stop.Session == *old || stop.Phase != "stop" ||
+			!primaryCommandMatches(*stop, reserve) || prior == nil || prior.TeardownCSeq <= 0 ||
+			prior.Action != reserve.Action || prior.radioPrimaryBinding != *stop.Session {
+			return false
+		}
+	}
+	if started := h.PrimaryPending.Started; started != nil &&
+		(started.Phase != "start" || started.Station != status.Request.Station || !primaryCommandMatches(*started, reserve)) {
+		return false
+	}
+	return park.Schema == cPrimaryParkSchema && park.Phase == "prepared" && volumeUUID.MatchString(park.Action) &&
+		volumeCounter(park.Revision) && park.Revision != "0" && volumeHex32.MatchString(park.Token) &&
+		park.Owner.RoomID == room && park.Owner.HomePodID == old.DeviceID && nativeBoundOwnerValid(park.Owner) &&
+		park.Route.valid() && park.Route.Process == old.Process && park.Route.DeviceID == old.DeviceID &&
+		park.Route.DeviceIncarnation == old.Incarnation && park.Route.InputPathDigest == park.Writer.InputDigest &&
+		radioProcessID(park.Writer.Process) == r.ProcessID
+}
+
+func primaryRadioColdDetached(h *radioHold) bool {
+	return h != nil && h.Phase == "primary_cold_detached" && !h.WriterParked && !h.RequiresPause &&
+		primaryColdHoldMatches(h, h.Request.TargetID) && h.PrimaryColdTarget != nil &&
+		h.PrimaryColdTarget.valid() && h.PrimaryColdTarget.Device == h.Primary.DeviceID &&
+		h.PrimaryColdTarget.Process != h.Primary.Process
+}
+
+func primaryColdEvidence(h *radioHold) *radioPrimaryColdDetachment {
+	return &radioPrimaryColdDetachment{Process: h.Request.ProcessID, Handoff: h.Request.HandoffID,
+		Generation: h.Request.Generation, Room: h.Request.TargetID, Session: *h.Primary, Target: *h.PrimaryColdTarget}
+}
+
+// Cold proof retires a historical journal entry. It is not an actor effect or
+// a current-owner grant, and does not require a new Spotify login.
+func (app *App) observePrimaryColdDetachment(ctx context.Context, process contentProcess, cProcess string,
+	receivers map[string]string, state *radioPrimaryReadinessState) {
+	if ctx.Err() != nil || app.manualReleasePending() {
+		return
+	}
+	app.radio.mu.Lock()
+	intent, generation := app.radio.Intent, app.radio.Generation
+	if app.radio.failed || state.Revision != strconv.FormatUint(intent, 10) {
+		app.radio.mu.Unlock()
+		return
+	}
+	var candidate *radioHold
+	var prior *radioPrimaryColdDetachment
+	var priorGeneration uint64
+	for room, hold := range app.radio.Holds {
+		if primaryRadioColdDetached(hold) {
+			oldGeneration, _ := strconv.ParseUint(hold.Request.Generation, 10, 64)
+			if oldGeneration == priorGeneration {
+				app.radio.mu.Unlock()
+				return
+			}
+			if oldGeneration > priorGeneration {
+				prior, priorGeneration = primaryColdEvidence(hold), oldGeneration
+			}
+		}
+		if primaryRadioRetired(hold) {
+			continue
+		}
+		if candidate != nil || hold == nil || hold.Phase != "unknown" || !hold.WriterParked ||
+			hold.PrimaryColdTarget != nil || !primaryColdHoldMatches(hold, room) ||
+			hold.Request.ProcessID == radioProcessID(process) || hold.Primary.Process == cProcess {
+			app.radio.mu.Unlock()
+			return
+		}
+		candidate = hold
+	}
+	if candidate == nil {
+		state.ColdDetachment = prior
+		app.radio.mu.Unlock()
+		return
+	}
+	room, device := candidate.Request.TargetID, candidate.Primary.DeviceID
+	configured := false
+	for _, target := range state.Targets {
+		if target.ID == room && target.HomePodID == device {
+			configured = true
+			break
+		}
+	}
+	candidateGeneration, _ := strconv.ParseUint(candidate.Request.Generation, 10, 64)
+	if candidateGeneration <= priorGeneration || !configured || receivers[device] == "" || intent == ^uint64(0) {
+		app.radio.mu.Unlock()
+		return
+	}
+	park := *candidate.PrimaryPark
+	route := *park.Route
+	park.Route = &route
+	wire := radioPrimaryColdWire{Schema: cPrimaryColdDetachmentSchema, Phase: "observe", Park: park, Session: *candidate.Primary}
+	app.radio.mu.Unlock()
+
+	var ack radioPrimaryColdReceipt
+	endpoint := strings.TrimSuffix(app.cfg.RoomTransportOwnToneURL, "/") + "/api/outputs/" + device + "/radio-handoff/reacquire"
+	if err := radioAuthenticatedHTTP(ctx, endpoint, app.cfg.RadioHandoffControlToken, wire, &ack); err != nil ||
+		ack.Schema != wire.Schema || ack.Phase != "isolated" || ack.Session != wire.Session ||
+		ack.Park.Route == nil || *ack.Park.Route != route || !ack.Target.valid() || ack.Target.Device != device ||
+		ack.Target.Process != cProcess || ack.Target.Incarnation != receivers[device] {
+		return
+	}
+	ack.Park.Route = &route
+	if ack.Park != park {
+		return
+	}
+
+	if app.manualReleasePending() {
+		return
+	}
+	app.radio.mu.Lock()
+	defer app.radio.mu.Unlock()
+	if ctx.Err() != nil || app.radio.failed || app.radio.Intent != intent || app.radio.Generation != generation || app.radio.Holds[room] != candidate ||
+		candidate.Phase != "unknown" || !candidate.WriterParked || !primaryColdHoldMatches(candidate, room) ||
+		*candidate.Primary != wire.Session || *candidate.PrimaryPark.Route != route {
+		return
+	}
+	currentPark := *candidate.PrimaryPark
+	currentPark.Route = &route
+	if currentPark != park {
+		return
+	}
+	for target, hold := range app.radio.Holds {
+		if target != room && !primaryRadioRetired(hold) {
+			return
+		}
+	}
+	closed := *candidate
+	closed.Phase, closed.WriterParked, closed.RequiresPause = "primary_cold_detached", false, false
+	closed.PrimaryColdTarget = &ack.Target
+	app.radio.Holds[room], app.radio.Intent = &closed, intent+1
+	if err := app.persistRadioLocked(); err != nil {
+		app.radio.Holds[room], app.radio.Intent = candidate, intent
+		return
+	}
+	app.refreshRadioOutputFenceLocked()
+	state.ColdDetachment, state.Revision = primaryColdEvidence(&closed), strconv.FormatUint(app.radio.Intent, 10)
+}
