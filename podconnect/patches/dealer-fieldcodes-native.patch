@@ -0,0 +1,41 @@
+package daemon
+
+import (
+	"testing"
+	"time"
+)
+
+func TestDealerBusyReasonAndEndpointCodes(t *testing.T) {
+	p := &AppPlayer{app: &App{}}
+	cases := []struct {
+		name, want string
+		setup      func()
+	}{
+		{"idle", "", func() {}},
+		{"expired", "", func() { p.roomVolumeReservation = &nativeRoomVolumeReservation{Until: time.Now().Add(-time.Minute)} }},
+		{"volume", "volume_reserved", func() { p.roomVolumeReservation = &nativeRoomVolumeReservation{Until: time.Now().Add(time.Minute)} }},
+		{"content", "content_reserved", func() { p.roomVolumeReservation = nil; p.roomContentReservation = &contentReservation{} }},
+		{"move", "move_busy", func() { p.roomContentReservation = nil; p.roomMoveQuarantined = true }},
+		{"content first", "content_quarantined", func() { p.roomContentQuarantined = true }},
+		{"closing first", "volume_closing", func() { p.roomVolumeClosing = true }},
+		{"manual release", "manual_release", func() {
+			p.roomVolumeClosing = false
+			p.roomContentQuarantined = false
+			p.roomMoveQuarantined = false
+			p.app.manualRelease = &nativeTransportOffer{}
+		}},
+	}
+	for _, tc := range cases {
+		tc.setup()
+		got := p.dealerAdmissionReason()
+		if got != tc.want {
+			t.Fatalf("%s: %s", tc.name, got)
+		}
+		if p.roomVolumeBusy() != (got != "" && got != "manual_release") {
+			t.Fatalf("%s: busy outcome", tc.name)
+		}
+	}
+	if dealerEndpointCode("skip_next") != "skip_next" || dealerEndpointCode("secret-user-data") != "other" {
+		t.Fatal("endpoint classification")
+	}
+}
