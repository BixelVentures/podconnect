+func TestRoomOptionsHTTPCommitOnlyReadsRouteAroundActualActorEffect(t *testing.T) {
+	for _, mode := range []string{"accepted", "foreign-before", "foreign-after", "source-after", "supplied-token"} {
+		t.Run(mode, func(t *testing.T) {
+			p, offer := roomOptionsActorFixture(t, "repeat")
+			request := roomTransportPrepareRequest{Action: "repeat", RepeatMode: "context", HomePodID: "101", OptionsRoute: roomOptionsFixtureRoute(p)}
+			if err := p.prepareRoomOptions(context.Background(), offer, &request); err != nil {
+				t.Fatal(err)
+			}
+			reads := 0
+			output := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				reads++
+				if r.Method != http.MethodPost || r.URL.Path != "/api/outputs/101/transport/bound-state" {
+					t.Error("options performed a C mutation", r.Method, r.URL.Path)
+				}
+				var body struct {
+					Owner roomTransportIdentity `json:"native_owner"`
+				}
+				if json.NewDecoder(r.Body).Decode(&body) != nil || body.Owner != offer.Snapshot.roomTransportIdentity {
+					t.Error("options route read lost exact native owner")
+				}
+				if mode == "source-after" && reads == 2 {
+					// The first actor effect has completed and the HTTP owner is
+					// awaiting this read; a successor replaces the captured source.
+					p.primaryStream.Source = &roomTransportClosableSource{}
+				}
+				route := *offer.OptionsRoute
+				if mode == "foreign-before" || mode == "foreign-after" && reads == 2 {
+					route.RouteRevision = "2"
+				}
+				_ = json.NewEncoder(w).Encode(directPauseOutputState{Schema: "podconnect.output_transport_state.v2", OK: true, Identity: route, Actions: []string{"pause", "resume"}})
+			}))
+			defer output.Close()
+			p.app.cfg.RoomTransportOwnToneURL, offer.OwnToneURL = output.URL, output.URL
+			server := &ConcreteApiServer{requests: make(chan ApiRequest)}
+			effects := 0
+			done := make(chan struct{})
+			go func() {
+				defer close(done)
+				for call := range server.requests {
+					switch call.Type {
+					case apiRoomBoundConsume:
+						value, err := p.consumeRoomTransportVersion(context.Background(), call.Data.(roomTransportConsumeRequest), true)
+						call.Reply(value, err)
+					case apiRoomTransportEffect:
+						effects++
+						value, err := p.effectRoomTransport(context.Background(), call.Data.(roomTransportEffectRequest))
+						call.Reply(value, err)
+					case apiRoomOptionsCurrent:
+						value, err := p.handleApiRequest(context.Background(), call)
+						call.Reply(value, err)
+					case apiRoomTransportAbort:
+						p.abortRoomTransport(call.Data.(*nativeTransportOffer))
+						call.Reply(nil, nil)
+					default:
+						t.Error("unexpected options actor call", call.Type)
+						call.Reply(nil, ErrBadRequest)
+					}
+				}
+			}()
+			commit := roomTransportCommitRequest{PrepareID: offer.Snapshot.PrepareID}
+			if mode == "supplied-token" {
+				commit.OwnToneToken = strings.Repeat("c", 32)
+			}
+			body, _ := json.Marshal(commit)
+			response := httptest.NewRecorder()
+			server.handleRoomTransportCommit(response, httptest.NewRequest(http.MethodPost, "/player/room_transport/bound-commit", strings.NewReader(string(body))))
+			close(server.requests)
+			<-done
+			wantEffects, wantReads := 0, 0
+			if mode == "accepted" || mode == "foreign-after" || mode == "source-after" {
+				wantEffects, wantReads = 1, 2
+			} else if mode == "foreign-before" {
+				wantReads = 1
+			}
+			if (response.Code == http.StatusOK) != (mode == "accepted") || effects != wantEffects || reads != wantReads || offer.Published != (wantEffects == 1) || p.roomTransportOffer != nil || p.roomTransportPending != nil {
+				t.Fatal("options bypassed route/one-use fence or misreported post-effect uncertainty", response.Code, effects, reads, offer.Published)
+			}
+			effect := p.currentRoomEffect(offer.Snapshot.roomTransportIdentity)
+			if mode == "accepted" {
+				if effect == nil || effect.PrepareID != offer.Snapshot.PrepareID || effect.Action != "repeat" || effect.Generation != p.roomTransportGeneration {
+					t.Fatal("accepted options missing exact final actor effect stamp", effect)
+				}
+			} else if effect != nil {
+				t.Fatal("uncertain options published an effect stamp", effect)
+			}
+		})
+	}
+}
