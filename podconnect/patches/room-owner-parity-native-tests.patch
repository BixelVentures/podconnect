+func TestLibraryContentAdmissionAndInitialPermutation(t *testing.T) {
+	const first = "spotify:track:0000000000000000000004"
+	const second = "spotify:track:0000000000000000000005"
+	shuffle := false
+	base := contentPrepareRequest{Action: "play_tracks", Args: contentArgs{TrackURIs: []string{first}, Shuffle: &shuffle, LibrarySource: "liked", MaxVolume: 35}}
+	for _, count := range []int{1, 50, 51} {
+		r := base
+		r.Args.TrackURIs = make([]string, count)
+		for i := range r.Args.TrackURIs {
+			r.Args.TrackURIs[i] = first
+		}
+		if validContentRequest(r) != (count <= 50) {
+			t.Fatalf("list bound %d", count)
+		}
+	}
+	for _, source := range []string{"liked", "top_tracks", "recent"} {
+		r := base
+		r.Args.LibrarySource = source
+		if !validContentRequest(r) {
+			t.Fatal("source", source)
+		}
+	}
+	for _, mutate := range []func(*contentArgs){
+		func(a *contentArgs) { a.TrackURIs = nil },
+		func(a *contentArgs) { a.TrackURIs = []string{} },
+		func(a *contentArgs) { a.TrackURIs = []string{"spotify:episode:0000000000000000000004"} },
+		func(a *contentArgs) { a.TrackURIs = []string{first + "?x=1"} },
+		func(a *contentArgs) { a.TrackURIs = []string{" " + first} },
+		func(a *contentArgs) { a.TrackURIs = []string{"spotify:track:ZZZZZZZZZZZZZZZZZZZZZZ"} },
+		func(a *contentArgs) { a.Shuffle = nil },
+		func(a *contentArgs) { a.LibrarySource = "" },
+		func(a *contentArgs) { a.LibrarySource = "foreign" },
+		func(a *contentArgs) { a.TrackURI = first },
+		func(a *contentArgs) { a.EpisodeURI = "spotify:episode:0000000000000000000004" },
+		func(a *contentArgs) { a.MaxVolume = 34 },
+	} {
+		r := base
+		mutate(&r.Args)
+		if validContentRequest(r) {
+			t.Fatal("malformed list admitted", r.Args)
+		}
+	}
+	// Exercise the real HTTP decoder, including explicit false, missing, null,
+	// unknown keys, foreign empty keys and foreign list keys on legacy actions.
+	wire := func(action, args string) bool {
+		t.Helper()
+		raw, _ := json.Marshal(contentPrepareRequest{Action: action})
+		var fields map[string]json.RawMessage
+		_ = json.Unmarshal(raw, &fields)
+		fields["args"] = json.RawMessage(args)
+		raw, _ = json.Marshal(fields)
+		var decoded contentPrepareRequest
+		rec := httptest.NewRecorder()
+		return contentBody(rec, httptest.NewRequest("POST", "/player/room_content/prepare", bytes.NewReader(raw)), &decoded) && validContentRequest(decoded)
+	}
+	args := `{"track_uris":["` + first + `"],"shuffle":false,"library_source":"liked","max_volume":35}`
+	if !wire("play_tracks", args) {
+		t.Fatal("explicit false list rejected")
+	}
+	for _, bad := range []string{
+		strings.Replace(args, `,"shuffle":false`, "", 1),
+		strings.Replace(args, `false`, `null`, 1),
+		strings.Replace(args, `false`, `"false"`, 1),
+		strings.Replace(args, `[`+`"`+first+`"`+`]`, `null`, 1),
+		strings.Replace(args, `[`+`"`+first+`"`+`]`, `[null]`, 1),
+		strings.Replace(args, `"liked"`, `null`, 1),
+		strings.Replace(args, `}`, `,"track_uri":""}`, 1),
+		strings.Replace(args, `}`, `,"context_uri":""}`, 1),
+		strings.Replace(args, `}`, `,"episode_uri":""}`, 1),
+		strings.Replace(args, `}`, `,"foreign":true}`, 1),
+	} {
+		if wire("play_tracks", bad) {
+			t.Fatal("malformed wire admitted", bad)
+		}
+	}
+	if wire("play_episode", `{"episode_uri":"spotify:episode:0000000000000000000004","max_volume":35,"library_source":""}`) {
+		t.Fatal("foreign empty list key admitted on episode")
+	}
+	if wire("play_track", `{"track_uri":"`+first+`","max_volume":35,"library_source":""}`) {
+		t.Fatal("foreign empty list key admitted on track")
+	}
+	if !wire("play_track", `{"track_uri":"`+first+`","max_volume":35}`) || !wire("play_context", `{"context_uri":"spotify:playlist:0000000000000000000004","max_volume":35}`) {
+		t.Fatal("legacy request changed")
+	}
+
+	base.Args.TrackURIs = []string{first, second, first}
+	ctx := contentTracksContext(base.Args)
+	rows := ctx.Pages[0].Tracks
+	if ctx.Uri != "" || ctx.Url != "" || rows[0].Uri != first || rows[1].Uri != second || rows[2].Uri != first || rows[0].Uid == rows[2].Uid {
+		t.Fatal("ordered duplicate materialization", rows)
+	}
+	shuffle = true
+	// Same first track is insufficient: order, duplicates, source and shuffle
+	// remain represented by the existing content digest's Args field.
+	original := contentDigest(base.Args)
+	for _, change := range []func(*contentArgs){
+		func(a *contentArgs) { a.TrackURIs = []string{first, first, second} },
+		func(a *contentArgs) { a.TrackURIs = []string{first, second} },
+		func(a *contentArgs) { a.LibrarySource = "recent" },
+		func(a *contentArgs) { no := false; a.Shuffle = &no },
+	} {
+		a := base.Args
+		change(&a)
+		if contentDigest(a) == original {
+			t.Fatal("args binding omitted list semantic")
+		}
+	}
+}
