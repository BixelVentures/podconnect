+func TestRoomOptionsEffectStampRequiresFinalCurrentRejoin(t *testing.T) {
+	for _, mode := range []string{"current", "intent", "generation", "source", "list", "owner", "cancel", "overflow"} {
+		t.Run(mode, func(t *testing.T) {
+			p, offer := roomOptionsActorFixture(t, "repeat")
+			request := roomTransportPrepareRequest{Action: "repeat", RepeatMode: "context", HomePodID: "101", OptionsRoute: roomOptionsFixtureRoute(p)}
+			if err := p.prepareRoomOptions(context.Background(), offer, &request); err != nil {
+				t.Fatal(err)
+			}
+			if _, err := p.consumeRoomTransportVersion(context.Background(), roomTransportConsumeRequest{offer.Snapshot.PrepareID, context.Background()}, true); err != nil {
+				t.Fatal(err)
+			}
+			if _, err := p.effectRoomTransport(context.Background(), roomTransportEffectRequest{offer, context.Background()}); err != nil {
+				t.Fatal(err)
+			}
+			if p.roomLastEffect != nil {
+				t.Fatal("options stamped before final route/rejoin")
+			}
+			ctx, cancel := context.WithCancel(context.Background())
+			defer cancel()
+			switch mode {
+			case "intent":
+				p.roomNativeIntent++
+			case "generation":
+				p.invalidateRoomTransportGeneration()
+			case "source":
+				p.primaryStream.Source = &roomTransportClosableSource{}
+			case "list":
+				p.state.tracks = &tracks.List{}
+			case "owner":
+				p.spotConnId = "successor"
+			case "cancel":
+				cancel()
+			case "overflow":
+				p.roomEffectRevision = ^uint64(0)
+			}
+			_, err := p.optionsEffectCurrent(ctx, offer)
+			if mode != "current" && mode != "overflow" {
+				if err == nil || p.roomLastEffect != nil {
+					t.Fatal("stale rejoin published a stamp", mode, err)
+				}
+				return
+			}
+			if err != nil {
+				t.Fatal(err)
+			}
+			if mode == "overflow" {
+				if p.roomLastEffect != nil || p.roomEffectRevision != ^uint64(0) {
+					t.Fatal("effect revision overflow minted a witness")
+				}
+				return
+			}
+			effect := p.currentRoomEffect(offer.Snapshot.roomTransportIdentity)
+			if effect == nil || effect.PrepareID != offer.Snapshot.PrepareID || effect.Action != "repeat" {
+				t.Fatal("final current rejoin lost exact effect", effect)
+			}
+			if _, err := p.optionsEffectCurrent(ctx, offer); err != nil || p.roomEffectRevision != 1 {
+				t.Fatal("duplicate rejoin minted another revision", err)
+			}
+		})
+	}
+}
