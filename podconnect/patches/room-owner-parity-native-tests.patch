+func TestRoomOptionsShufflePreparationDetachedAndReversible(t *testing.T) {
+	ctx := context.Background()
+	list := occurrenceFixture(t)
+	list.AddToQueue(&connectpb.ContextTrack{Uri: "spotify:track:9999999999999999999999", Metadata: map[string]string{"owner": "retained"}})
+	beforeTrack, beforeRevision, beforePosition := list.CurrentTrack().Uri, list.TransportRevision(), list.tracks.pos
+	beforeRows, beforeQueue := list.tracks.list, append([]*connectpb.ContextTrack(nil), list.queue...)
+	staged, err := list.PrepareShuffle(ctx, true)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !staged.shuffled || staged == list || staged.tracks == list.tracks || staged.CurrentTrack().Uri != beforeTrack {
+		t.Fatal("shuffle lost current occurrence or shared retained cursor")
+	}
+	if list.shuffled || list.TransportRevision() != beforeRevision || list.tracks.pos != beforePosition || !reflect.DeepEqual(list.tracks.list, beforeRows) || !reflect.DeepEqual(list.queue, beforeQueue) {
+		t.Fatal("shuffle preparation mutated retained state")
+	}
+	staged.queue[0].Metadata["owner"] = "staged"
+	if list.queue[0].Metadata["owner"] != "retained" {
+		t.Fatal("staged shuffle shares manual queue rows")
+	}
+	restored, err := staged.PrepareShuffle(ctx, false)
+	if err != nil || restored.shuffled || restored.CurrentTrack().Uri != beforeTrack || !staged.shuffled {
+		t.Fatal("unshuffle did not retain detached current occurrence", err)
+	}
+	for i, row := range restored.tracks.list {
+		if row.item.Uri != beforeRows[i].item.Uri {
+			t.Fatal("unshuffle changed original context order")
+		}
+	}
+}
