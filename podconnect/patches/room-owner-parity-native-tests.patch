+func TestRoomTransportSeekCapturedSourcePauseDurationAndConsumedOffer(t *testing.T) {
+	for _, boundary := range []string{"valid", "source", "pause", "duration", "generation", "expiry", "duplicate"} {
+		t.Run(boundary, func(t *testing.T) {
+			p, offer := roomTransportAdmittedFixture(t)
+			duration := int32(1000)
+			position := int64(500)
+			p.primaryStream.Source = &roomTransportClosableSource{}
+			p.primaryStream.Media = librespot.NewMediaFromTrack(&metadatapb.Track{Duration: &duration})
+			p.state.player.IsPaused = true
+			offer.Snapshot.Action = "seek"
+			offer.Snapshot.PositionMS = &position
+			offer.SeekSource = p.primaryStream.Source
+			offer.SeekDuration = 1000
+			offer.SeekPaused = true
+			switch boundary {
+			case "source":
+				p.primaryStream.Source = &roomTransportClosableSource{}
+			case "pause":
+				p.state.player.IsPaused = false
+			case "duration":
+				duration = 900
+			case "generation":
+				p.invalidateRoomTransportGeneration()
+			case "expiry":
+				offer.Expires = time.Now().Add(-time.Second)
