+func TestRoomOptionsActorRejectsChangesAfterPreparationAndConsumption(t *testing.T) {
+	for _, boundary := range []string{"options", "options-aba", "list", "list-owner", "source", "paused", "restrictions", "intent", "generation", "expiry", "cancel"} {
+		t.Run(boundary, func(t *testing.T) {
+			p, offer := roomOptionsActorFixture(t, "repeat")
+			request := roomTransportPrepareRequest{Action: "repeat", RepeatMode: "context", HomePodID: "101", OptionsRoute: roomOptionsFixtureRoute(p)}
+			if err := p.prepareRoomOptions(context.Background(), offer, &request); err != nil {
+				t.Fatal(err)
+			}
+			if _, err := p.consumeRoomTransportVersion(context.Background(), roomTransportConsumeRequest{offer.Snapshot.PrepareID, context.Background()}, true); err != nil {
+				t.Fatal(err)
+			}
+			ctx, cancel := context.WithCancel(context.Background())
+			defer cancel()
+			switch boundary {
+			case "options-aba":
+				before := proto.Clone(p.state.player.Options)
+				beforeGeneration := p.roomTransportGeneration
+				enabled := true
+				if err := p.setOptions(context.Background(), &enabled, nil, nil); err != nil {
+					t.Fatal(err)
+				}
+				enabled = false
+				if err := p.setOptions(context.Background(), &enabled, nil, nil); err != nil {
+					t.Fatal(err)
+				}
+				if !proto.Equal(before, p.state.player.Options) || p.roomTransportGeneration != beforeGeneration+2 {
+					t.Fatal("real options ABA fixture did not restore values with two generations")
+				}
+			case "options":
+				p.state.player.Options.Modes["fixture"] = "changed"
+			case "list":
+				p.state.tracks.AddToQueue(&connectpb.ContextTrack{Uri: "spotify:track:0000000000000000000008"})
+			case "list-owner":
+				staged, err := p.state.tracks.PrepareShuffle(context.Background(), false)
+				if err != nil {
+					t.Fatal(err)
+				}
+				p.state.tracks = staged
+			case "restrictions":
+				p.state.player.Restrictions = &connectpb.Restrictions{DisallowTogglingRepeatContextReasons: []string{"fixture-restriction"}}
+			case "source":
+				p.primaryStream.Source = &roomTransportClosableSource{}
+			case "paused":
+				p.state.player.IsPaused = false
+			case "intent":
+				p.roomNativeIntent++
+			case "generation":
+				p.invalidateRoomTransportGeneration()
+			case "expiry":
+				offer.Expires = time.Now().Add(-time.Second)
+			case "cancel":
+				cancel()
+			}
+			before := proto.Clone(p.state.player.Options)
+			if _, err := p.effectRoomTransport(ctx, roomTransportEffectRequest{offer, ctx}); err == nil || offer.Published || p.roomTransportPending != nil || !proto.Equal(before, p.state.player.Options) {
+				t.Fatal("late owner change published or retained reusable options")
+			}
+		})
+	}
