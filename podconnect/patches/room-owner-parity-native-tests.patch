+			revision := p.aliasRevision
+			value, err := p.idleLocalAliases(context.Background())
+			if err == nil || value != nil || reads.Load() != 1 || p.aliasRevision != revision || len(events.events) != 1 || creates.Load() != 0 {
+				t.Fatal("strict absence GET accepted cold/unknown C or changed local preference", err, reads.Load())
+			}
+		})
+	}
+}
