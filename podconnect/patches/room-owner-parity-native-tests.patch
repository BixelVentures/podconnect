+func TestRoomOptionsTypedWireClosedAndPreservesExplicitFalse(t *testing.T) {
+	for _, row := range []struct {
+		action, fields string
+		valid          bool
+	}{
+		{"shuffle", `,"shuffle_enabled":true`, true}, {"shuffle", `,"shuffle_enabled":false`, true},
+		{"repeat", `,"repeat_mode":"off"`, true}, {"repeat", `,"repeat_mode":"context"`, true}, {"repeat", `,"repeat_mode":"track"`, true},
+		{"shuffle", "", false}, {"shuffle", `,"shuffle_enabled":null`, false}, {"shuffle", `,"shuffle_enabled":1`, false}, {"shuffle", `,"shuffle_enabled":"true"`, false},
+		{"repeat", "", false}, {"repeat", `,"repeat_mode":null`, false}, {"repeat", `,"repeat_mode":"all"`, false}, {"repeat", `,"repeat_mode":true`, false},
+		{"shuffle", `,"shuffle_enabled":true,"repeat_mode":"off"`, false}, {"repeat", `,"repeat_mode":"off","shuffle_enabled":false`, false},
+		{"pause", `,"shuffle_enabled":false`, false}, {"pause", `,"repeat_mode":"off"`, false}, {"pause", `,"repeat_mode":""`, false}, {"shuffle", `,"shuffle_enabled":true,"repeat_mode":""`, false},
+		{"shuffle", `,"shuffle_enabled":true,"shuffle_enabled":false`, false}, {"repeat", `,"repeat_mode":"off","extra":true`, false},
+	} {
+		t.Run(row.action+row.fields, func(t *testing.T) {
+			server := &ConcreteApiServer{requests: make(chan ApiRequest)}
+			calls := 0
+			done := make(chan struct{})
+			go func() {
+				defer close(done)
+				for req := range server.requests {
+					calls++
+					req.Reply(req.Data, nil)
+				}
+			}()
+			body := `{"account_user_id":"account","target_id":"engine","room_id":"r0","homepod_id":"101","action":"` + row.action + `","volume_percent":0` + row.fields + `}`
+			response := httptest.NewRecorder()
+			server.handleRoomTransportPrepare(response, httptest.NewRequest("POST", "/player/room_transport/bound-prepare", strings.NewReader(body)))
+			close(server.requests)
+			<-done
+			if (response.Code == http.StatusOK) != row.valid || (!row.valid && calls != 0) || (row.valid && calls != 1) {
+				t.Fatal("typed options reached actor incorrectly", response.Code, calls)
+			}
+			if row.valid && row.action == "shuffle" {
+				var wire map[string]any
+				_ = json.Unmarshal(response.Body.Bytes(), &wire)
+				if _, present := wire["shuffle_enabled"]; !present {
+					t.Fatal("explicit shuffle false lost in wire")
+				}
+			}
+		})
+	}
+}
