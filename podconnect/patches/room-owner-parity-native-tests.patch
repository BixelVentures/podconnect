+// Extends the admitted content fixture with the real empty source worker. The AP
+// welcome only seeds the established account getter; it is not authentication.
+func idleAliasFixture(t *testing.T) (*AppPlayer, *aliasTestServer, *atomic.Int32) {
+	t.Helper()
+	p, _ := contentFixture(t)
+	p.state.active = false
+	p.state.player.IsPlaying = false
+	p.state.player.SessionId = ""
+	p.primaryStream = nil
+	p.roomTransportOffer = nil
+	p.hasSpotConnId, p.hasInitialConnectState = true, true
+	p.playbackReadyCh = make(chan struct{})
+	close(p.playbackReadyCh)
+	path := filepath.Join(t.TempDir(), "idle.fifo")
+	if err := syscall.Mkfifo(path, 0600); err != nil {
+		t.Fatal(err)
+	}
+	reader, err := os.OpenFile(path, os.O_RDONLY|syscall.O_NONBLOCK, 0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { reader.Close() })
+	p.app.cfg.AudioOutputPipe = path
+	creates := &atomic.Int32{}
+	worker, err := player.NewPlayer(&player.Options{Log: p.app.log, AudioBackend: "pipe", AudioOutputPipe: path, AudioOutputPipeFormat: "s16le", ExternalVolume: true, WithNewOutput: func(create func() (output.Output, error)) (output.Output, error) { creates.Add(1); return create() }})
+	if err != nil {
+		t.Fatal(err)
+	}
+	p.player = worker
+	t.Cleanup(worker.Close)
+	access := ap.NewAccesspoint(p.app.log, nil, "fixture")
+	left, right := net.Pipe()
+	t.Cleanup(func() { left.Close(); right.Close() })
+	fields := reflect.ValueOf(access).Elem()
+	for name, value := range map[string]reflect.Value{"conn": reflect.ValueOf(left), "encConn": reflect.New(fields.FieldByName("encConn").Type().Elem()), "welcome": reflect.ValueOf(&pb.APWelcome{CanonicalUsername: proto.String("account")})} {
+		f := fields.FieldByName(name)
+		reflect.NewAt(f.Type(), unsafe.Pointer(f.UnsafeAddr())).Elem().Set(value)
+	}
+	nextSessionField(p.sess, "ap", access)
+	server := p.app.server.(*aliasTestServer)
+	return p, server, creates
+}
