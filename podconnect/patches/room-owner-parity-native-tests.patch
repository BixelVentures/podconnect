+			select {
+			case <-entered:
+			case <-time.After(time.Second):
+				t.Fatal("actual HTTP/actor C-state await not reached")
+			}
+			cancel()
+			once.Do(func() { close(release) })
+			select {
+			case <-httpDone:
+			case <-time.After(2 * time.Second):
+				t.Fatal("HTTP cancellation did not join")
+			}
+			select {
+			case <-actorDone:
+			case <-time.After(time.Second):
+				t.Fatal("cancelled actor did not finish")
+			}
+			wantReads := int32(0)
+			if method == http.MethodGet {
