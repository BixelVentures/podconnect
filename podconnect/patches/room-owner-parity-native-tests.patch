+func TestLibraryContentStageRealFLACWithoutContextResolve(t *testing.T) {
+	for _, shuffle := range []bool{false, true} {
+		t.Run(strconv.FormatBool(shuffle), func(t *testing.T) {
+			// Existing startup seeds this package from time. Only this sequential fixture
+			// installs a deterministic seed, then restores the startup policy.
+			xrand.Seed(7)
+			t.Cleanup(func() { xrand.Seed(uint64(time.Now().UnixNano())) })
+			p, op := contentFixture(t)
+			options := &player.Options{Log: p.app.log, AudioBackend: "pipe", AudioOutputPipeFormat: "s16le", ExternalVolume: true}
+			transport := configureSelectedStage(t, p, options)
+			var contextReads atomic.Int32
+			var metadataReads atomic.Int32
+			var metadataURI string
+			wrapped := pc13RoundTrip(func(r *http.Request) (*http.Response, error) {
+				if strings.HasPrefix(r.URL.Path, "/context-resolve/") {
+					contextReads.Add(1)
+					return &http.Response{StatusCode: 404, Body: http.NoBody, Header: make(http.Header), Request: r}, nil
+				}
+				if r.URL.Path == "/extended-metadata/v0/extended-metadata" {
+					raw, _ := io.ReadAll(r.Body)
+					r.Body = io.NopCloser(bytes.NewReader(raw))
+					var request extpb.BatchedEntityRequest
+					if err := proto.Unmarshal(raw, &request); err != nil {
+						return nil, err
+					}
+					uri := request.EntityRequest[0].EntityUri
+					if metadataURI != "" && metadataURI != uri {
+						t.Error("first stream changed identity between metadata extensions")
+					}
+					metadataURI = uri
+					metadataReads.Add(1)
+				}
+				return transport.RoundTrip(r)
+			})
+			sp := pc13Spclient(t, wrapped)
+			nextSessionField(p.sess, "sp", sp)
+			options.Spclient = sp
+			p.app.client = &http.Client{Transport: wrapped}
+			worker, err := player.NewPlayer(options)
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer worker.Close()
+			p.player = worker
+			op.Loader = worker.CaptureStreamPreparation()
+			want := []string{"spotify:track:0000000000000000000004", "spotify:track:0000000000000000000005", "spotify:track:0000000000000000000004"}
+			op.Action, op.Args, op.URI, op.State = "play_tracks", contentArgs{TrackURIs: want, Shuffle: &shuffle, LibrarySource: "liked", MaxVolume: 35}, "", "staging"
+			op.stage()
+			defer op.discard()
+			if op.State != "staged" || op.Stream == nil || contextReads.Load() != 0 || metadataReads.Load() == 0 {
+				t.Fatal("actual list staging", op.State, contextReads.Load(), metadataReads.Load())
+			}
+			if op.Prepared.ContextUri != "" || op.Prepared.ContextUrl != "" || op.Prepared.Track.Uri != metadataURI || op.Prepared.Options.ShufflingContext != shuffle {
+				t.Fatal("staged context/first decoded selection")
+			}
+			buf := make([]float32, 2048)
+			n, err := op.Stream.Source.Read(buf)
+			if n == 0 || (err != nil && err != io.EOF) {
+				t.Fatal("real FLAC decoded no samples", n, err)
+			}
+			all, err := op.Tracks.AllTracksWithError(context.Background())
+			if err != nil || len(all) != len(want) {
+				t.Fatal("whole list", all, err)
+			}
+			seen := map[string]bool{}
+			for i, row := range all {
+				ordinal, err := strconv.Atoi(row.Uid)
+				if err != nil || ordinal < 0 || ordinal >= len(want) || seen[row.Uid] || row.Uri != want[ordinal] {
+					t.Fatal("lost or substituted occurrence", row)
+				}
+				seen[row.Uid] = true
+				if !shuffle && ordinal != i {
+					t.Fatal("ordered context changed order", i, ordinal)
+				}
+				if op.Tracks.CurrentTrack().Uri != row.Uri || op.Tracks.CurrentTrack().Uid != row.Uid {
+					t.Fatal("duplicate continuation changed occurrence", i)
+				}
+				if op.Tracks.GoNext(context.Background()) != (i < len(want)-1) {
+					t.Fatal("next/exhaustion", i)
+				}
+			}
+			if all[0].Uri != metadataURI || contextReads.Load() != 0 {
+				t.Fatal("first/continuation changed external context")
+			}
+			if shuffle {
+				if all[0].Uid == "0" {
+					t.Fatal("fixture did not expose first-selected shuffle retention", all)
+				}
+				current := op.Tracks.CurrentTrack().Uid
+				if err = op.Tracks.ToggleShuffle(context.Background(), false); err != nil {
+					t.Fatal(err)
+				}
+				restored, e := op.Tracks.AllTracksWithError(context.Background())
+				if e != nil || op.Tracks.CurrentTrack().Uid != current {
+					t.Fatal("unshuffle moved current occurrence", e)
+				}
+				for i, row := range restored {
+					if row.Uri != want[i] || row.Uid != strconv.Itoa(i) {
+						t.Fatal("unshuffle failed original order", restored)
+					}
+				}
+			}
+			t.Log("list -> production stage -> real metadata/key/storage/AES/FLAC; zero ContextResolve; every ordered/shuffled duplicate survives next/exhaustion")
+		})
+	}
+}
