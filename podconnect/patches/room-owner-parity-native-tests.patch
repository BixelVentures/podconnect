+func TestIdleAliasActualHandlerOnlySelectsLocalWithoutCRead(t *testing.T) {
+	p, events, creates := idleAliasFixture(t)
+	p.roomContentIncarnation, p.roomContentSteps = "", nil
+	var reads atomic.Int32
+	output := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		reads.Add(1)
+		if r.Method != http.MethodPost || r.URL.Path != "/api/outputs/202/start/state" {
+			t.Error("idle selection mutated C", r.Method, r.URL.Path)
+		}
+		var body map[string]json.RawMessage
+		if json.NewDecoder(r.Body).Decode(&body) != nil || len(body) != 6 || string(body["old_native_owner"]) != "null" || string(body["require_clean_absent"]) != "true" {
+			t.Error("idle state read invented prior owner", body)
+		}
+		var process contentProcess
+		_ = json.Unmarshal(body["native_process"], &process)
+		actual, ok := nativeContentProcess()
+		if !ok || process != actual {
+			t.Error("state read lost actual process")
+		}
+		var path, digest string
+		_ = json.Unmarshal(body["expected_input_path"], &path)
+		_ = json.Unmarshal(body["expected_input_path_digest"], &digest)
+		if path != p.app.cfg.AudioOutputPipe || digest != contentDigestBytes(path) {
+			t.Error("state read lost pipe binding")
+		}
+		_ = json.NewEncoder(w).Encode(idleAliasCReply())
+	}))
+	defer output.Close()
+	p.app.cfg.RoomTransportOwnToneURL = output.URL
+	before := proto.Clone(p.state.player)
+	state, owner, tracks, queue := p.state, p.player, p.state.tracks, p.state.queueID
+	request := idleAliasRequest(p)
+	result, err := p.handleApiRequest(context.Background(), ApiRequest{Type: ApiRequestTypeSelectAlias, Data: request})
+	if err != nil {
+		t.Fatal("fresh idle selection failed", err)
+	}
+	reply := result.(*ApiResponseSelectAlias)
+	if !reply.AcceptedLocal || !reply.IdleOnly || reply.ID != 2 || reply.Binding.RoomID != "r1" || reads.Load() != 0 || creates.Load() != 0 || len(events.events) != 1 || events.events[0].Type != "selected_alias" {
+		t.Fatal("idle selection not local-only", reply, reads.Load(), creates.Load(), len(events.events))
+	}
+	if !proto.Equal(before, p.state.player) || p.state != state || p.player != owner || p.state.tracks != tracks || p.state.queueID != queue || p.primaryStream != nil || p.app.openedWriterOwner != nil || p.roomContentIncarnation != "" || p.roomContentSteps != nil {
+		t.Fatal("idle alias selection changed retained playback")
+	}
+	source, err := p.player.Start35CurrentSource(context.Background())
+	if err != nil || source != nil {
+		t.Fatal("local selection created source", err)
+	}
+	raw, _ := json.Marshal(reply)
+	var wire map[string]any
+	_ = json.Unmarshal(raw, &wire)
+	if len(wire) != 4 || wire["accepted_local"] != true || wire["idle_only"] != true {
+		t.Fatal("local selection claimed native or physical acceptance", string(raw))
+	}
+}
