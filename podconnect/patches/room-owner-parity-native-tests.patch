+			var reads atomic.Int32
+			output := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				reads.Add(1)
+				state := idleAliasCReply()
+				if method == http.MethodGet {
+					state.Target.DeviceID = "101"
+				}
+				if r.Method != http.MethodPost || r.URL.Path != "/api/outputs/"+state.Target.DeviceID+"/start/state" {
+					t.Error("HTTP cancellation fixture performed C mutation", r.Method, r.URL.Path)
+				}
+				if method == http.MethodGet {
+					close(entered)
+					<-release
+				}
+				_ = json.NewEncoder(w).Encode(state)
+			}))
+			defer output.Close()
+			defer once.Do(func() { close(release) })
+			p.app.cfg.RoomTransportOwnToneURL = output.URL
+			server := &ConcreteApiServer{log: p.app.log, requests: make(chan ApiRequest)}
+			actorDone := make(chan struct{})
+			actorStop, stopActor := context.WithCancel(context.Background())
+			t.Cleanup(func() {
+				stopActor()
+				select {
+				case <-actorDone:
+				case <-time.After(time.Second):
+					t.Error("cancelled HTTP actor did not join")
+				}
+			})
+			go func() {
+				defer close(actorDone)
+				select {
+				case call := <-server.Receive():
+					if method == http.MethodPost {
+						raw, _ := json.Marshal(call.Data)
+						var fields map[string]json.RawMessage
+						_ = json.Unmarshal(raw, &fields)
+						if len(fields) != 4 || fields["Context"] != nil || fields["context"] != nil {
+							t.Error("request context leaked into strict POST wire", string(raw))
+						}
+					}
+					if method == http.MethodPost {
+						// No C await belongs to a local preference. Cancel the
+						// real queued request before its actual actor dispatch.
+						close(entered)
+						<-release
+					}
+					// Shutdown remains live. Only the originating HTTP request is
+					// cancelled; the real data/actor adapter must propagate it.
+					value, err := p.handleApiRequest(context.Background(), call)
+					call.Reply(value, err)
+				case <-actorStop.Done():
+				}
+			}()
+			ctx, cancel := context.WithCancel(context.Background())
+			defer cancel()
+			url, body := "/player/aliases?idle_only=1", ""
+			if method == http.MethodPost {
+				url = "/player/aliases"
+				raw, _ := json.Marshal(idleAliasRequest(p))
+				body = string(raw)
+			}
+			request := httptest.NewRequest(method, url, strings.NewReader(body)).WithContext(ctx)
+			response := httptest.NewRecorder()
+			httpDone := make(chan struct{})
