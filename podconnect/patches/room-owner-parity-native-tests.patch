+func TestIdleAliasHeldCReadRejectsSuccessorAndCancelledCapture(t *testing.T) {
+	for _, mode := range []string{"source", "session", "connection", "generation", "intent", "retirement", "writer-owner", "alias-aba", "registry", "cancel", "read-source", "read-session", "read-alias-aba", "read-intent", "read-cancel"} {
+		t.Run(mode, func(t *testing.T) {
+			p, events, creates := idleAliasFixture(t)
+			entered, release := make(chan struct{}), make(chan struct{})
+			var once sync.Once
+			t.Cleanup(func() { once.Do(func() { close(release) }) })
+			var reads atomic.Int32
+			output := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				reads.Add(1)
+				close(entered)
+				<-release
+				state := idleAliasCReply()
+				state.Target.DeviceID = "101"
+				if r.URL.Path != "/api/outputs/101/start/state" {
+					t.Error("idle read used another alias", r.URL.Path)
+				}
+				_ = json.NewEncoder(w).Encode(state)
+			}))
+			defer output.Close()
+			defer once.Do(func() { close(release) })
+			p.app.cfg.RoomTransportOwnToneURL = output.URL
+			ctx, cancel := context.WithCancel(context.Background())
+			defer cancel()
+			done := make(chan error, 1)
+			go func() {
+				var err error
+				var hasValue bool
+				// Only the physical-absence GET still awaits C. Its shared
+				// final Native/worker fences remain covered by every late event.
+				value, callErr := p.handleApiRequest(ctx, ApiRequest{Type: ApiRequestTypeAliases, Data: true})
+				err, hasValue = callErr, value != nil
+				if hasValue && err == nil {
+					done <- nil
+				} else {
+					done <- err
+				}
+			}()
+			select {
+			case <-entered:
+			case <-time.After(time.Second):
+				t.Fatal("fresh C read not reached")
+			}
+			switch strings.TrimPrefix(mode, "read-") {
+			case "source":
+				if err := p.player.SetPrimaryStream(&contentInertSource{}, true, false); err != nil {
+					t.Fatal(err)
+				}
+			case "session":
+				p.state.player.SessionId = "successor"
+			case "connection":
+				p.spotConnId = "successor"
+			case "generation":
+				p.invalidateRoomTransportGeneration()
+			case "intent":
+				p.roomNativeIntent++
+			case "retirement":
+				p.app.retirementPending = &retirementAttempt{}
+			case "writer-owner":
+				p.app.openedWriterOwner = p
+			case "alias-aba":
+				for _, room := range []string{"r1", "r0"} {
+					if _, err := p.selectLocalAlias(ApiRequestDataSelectAlias{RoomID: room, ExpectedIncarnation: p.aliasIncarnation, ExpectedRegistry: p.aliasFingerprint}); err != nil {
+						t.Fatal(err)
+					}
+				}
+			case "registry":
+				p.initAliasRegistry()
+			case "cancel":
+				cancel()
+			}
+			beforeCreates, beforeEvents := creates.Load(), len(events.events)
+			once.Do(func() { close(release) })
+			select {
+			case err := <-done:
+				if err == nil {
+					t.Fatal("stale idle capture accepted")
+				}
+			case <-time.After(2 * time.Second):
+				t.Fatal("held idle selection not joined")
+			}
+			if p.state.device.SelectedAliasId != 1 || len(events.events) != beforeEvents || reads.Load() != 1 || creates.Load() != beforeCreates {
+				t.Fatal("stale capture selected alias, retried or mutated output", reads.Load(), creates.Load())
+			}
+		})
+	}
+}
