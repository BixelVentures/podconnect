diff --git a/output/room_transport_test.go b/output/room_transport_test.go
index e2abb67..a163ead 100644
--- a/output/room_transport_test.go
+++ b/output/room_transport_test.go
@@ -2,6 +2,7 @@ package output
 
 import (
 	"context"
+	"errors"
 	"sync"
 	"testing"
 	"time"
@@ -76,3 +77,26 @@ func TestRoomTransportPipeHeldLockReturnsOnCancellation(t *testing.T) {
 	}
 	out.lock.Unlock()
 }
+
+func TestRoomTransportRejectedSourceChangePreservesPendingPCM(t *testing.T) {
+	out, _, _ := startPipeFixture(t, &startRead{})
+	out.lock.Lock()
+	out.pendingPCM = []byte{1, 2}
+	out.pendingErr = context.Canceled
+	out.lock.Unlock()
+	err := out.WithGuardedSourceChange(context.Background(), func(_ MovePipeIdentity, _ bool, _ func()) error { return context.Canceled })
+	if !errors.Is(err, context.Canceled) {
+		t.Fatal(err)
+	}
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	err = out.WithGuardedSourceChange(ctx, func(_ MovePipeIdentity, _ bool, _ func()) error {
+		t.Fatal("cancelled source change reached owner/drop callback")
+		return nil
+	})
+	out.lock.Lock()
+	defer out.lock.Unlock()
+	if !errors.Is(err, context.Canceled) || len(out.pendingPCM) != 2 || out.pendingErr != context.Canceled {
+		t.Fatal("rejected source change discarded retained current PCM", err, out.pendingPCM, out.pendingErr)
+	}
+}
diff --git a/player/room_transport_test.go b/player/room_transport_test.go
index d246bf6..6805f6d 100644
--- a/player/room_transport_test.go
+++ b/player/room_transport_test.go
@@ -6,6 +6,7 @@ import (
 	librespot "github.com/devgianlu/go-librespot"
 	"github.com/devgianlu/go-librespot/output"
 	"sync"
+	"sync/atomic"
 	"testing"
 	"time"
 )
@@ -190,3 +191,160 @@ func TestRoomTransportPublicationDisposesDisplacedSourcesOnly(t *testing.T) {
 		t.Fatal("player teardown did not close adopted raw/decoder owner")
 	}
 }
+
+// Instrumented decoder seam, not a claim of real FLAC or physical output.
+type transportSeekSource struct {
+	position         atomic.Int64
+	calls            atomic.Int32
+	entered, release chan struct{}
+}
+
+func (*transportSeekSource) Read(samples []float32) (int, error) {
+	for i := range samples {
+		samples[i] = 0.1
+	}
+	return len(samples), nil
+}
+func (s *transportSeekSource) PositionMs() int64 { return s.position.Load() }
+func (s *transportSeekSource) SetPositionMs(position int64) error {
+	s.calls.Add(1)
+	if s.entered != nil {
+		close(s.entered)
+		<-s.release
+	}
+	s.position.Store(position)
+	return nil
+}
+
+type transportSeekOutput struct {
+	output.Output
+	writer output.MovePipeIdentity
+}
+
+func (o *transportSeekOutput) WithGuardedSourceChange(ctx context.Context, apply func(output.MovePipeIdentity, bool, func()) error) error {
+	return o.Output.(interface {
+		WithGuardedSourceChange(context.Context, func(output.MovePipeIdentity, bool, func()) error) error
+	}).WithGuardedSourceChange(ctx, func(identity output.MovePipeIdentity, paused bool, drop func()) error {
+		if o.writer != (output.MovePipeIdentity{}) && o.writer != identity {
+			return errors.New("writer changed")
+		}
+		o.writer = identity
+		return apply(identity, paused, drop)
+	})
+}
+func TestRoomTransportGuardedSeekSameWriterAndPausedState(t *testing.T) {
+	for _, paused := range []bool{false, true} {
+		t.Run(map[bool]string{false: "playing", true: "paused"}[paused], func(t *testing.T) {
+			var backend *transportSeekOutput
+			p, err := NewPlayer(&Options{Log: &librespot.NullLogger{}, AudioBackend: "pipe", AudioOutputPipe: queueFIFO(t), AudioOutputPipeFormat: "s16le", ExternalVolume: true, WithNewOutput: func(create func() (output.Output, error)) (output.Output, error) {
+				out, e := create()
+				backend = &transportSeekOutput{Output: out}
+				return backend, e
+			}})
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer p.Close()
+			source := &transportSeekSource{}
+			if err = p.SetPrimaryStream(source, paused, false); err != nil {
+				t.Fatal(err)
+			}
+			publications := 0
+			checks := 0
+			guard := func(mutate func()) error {
+				checks++
+				if mutate != nil {
+					publications++
+					mutate()
+				}
+				return nil
+			}
+			if err = p.GuardedSeek(context.Background(), 500, paused, source, nil, guard); err != nil {
+				t.Fatal(err)
+			}
+			writer := backend.writer
+			if source.PositionMs() != 500 || source.calls.Load() != 1 || checks != 2 || publications != 1 {
+				t.Fatal("seek/publication missing", source.PositionMs(), checks, publications)
+			}
+			if err = p.GuardedSeek(context.Background(), 0, paused, source, &writer, guard); err != nil {
+				t.Fatal(err)
+			}
+			if source.PositionMs() != 0 || source.calls.Load() != 2 || backend.writer != writer {
+				t.Fatal("zero seek replaced writer or was lost")
+			}
+		})
+	}
+}
+func TestRoomTransportGuardedSeekRejectsStaleBeforeEffectAndAfterDecoder(t *testing.T) {
+	for _, boundary := range []string{"source", "owner", "pause", "writer", "deadline", "late-owner", "late-deadline"} {
+		t.Run(boundary, func(t *testing.T) {
+			p, err := NewPlayer(&Options{Log: &librespot.NullLogger{}, AudioBackend: "pipe", AudioOutputPipe: queueFIFO(t), AudioOutputPipeFormat: "s16le", ExternalVolume: true})
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer p.Close()
+			source := &transportSeekSource{}
+			if err = p.SetPrimaryStream(source, true, false); err != nil {
+				t.Fatal(err)
+			}
+			expected := librespot.AudioSource(source)
+			if boundary == "source" {
+				expected = &transportSeekSource{}
+			}
+			ctx, cancel := context.WithCancel(context.Background())
+			defer cancel()
+			var stale atomic.Bool
+			published := false
+			if boundary == "owner" {
+				stale.Store(true)
+			}
+			if boundary == "deadline" {
+				cancel()
+			}
+			if boundary == "late-owner" || boundary == "late-deadline" {
+				source.entered = make(chan struct{})
+				source.release = make(chan struct{})
+			}
+			done := make(chan error, 1)
+			paused := boundary != "pause"
+			var writer *output.MovePipeIdentity
+			if boundary == "writer" {
+				writer = &output.MovePipeIdentity{FD: "9999"}
+			}
+			go func() {
+				done <- p.GuardedSeek(ctx, 500, paused, expected, writer, func(mutate func()) error {
+					if stale.Load() {
+						return errors.New("owner changed")
+					}
+					if mutate != nil {
+						published = true
+						mutate()
+					}
+					return nil
+				})
+			}()
+			if source.entered != nil {
+				<-source.entered
+				if boundary == "late-owner" {
+					stale.Store(true)
+				} else {
+					cancel()
+				}
+				close(source.release)
+			}
+			if err = <-done; err == nil || published {
+				t.Fatal("stale seek published success", err, published)
+			}
+			expectedCalls := int32(0)
+			if source.entered != nil {
+				expectedCalls = 1
+			}
+			if source.entered != nil && source.PositionMs() != 500 {
+				t.Fatal("late rejection must retain actual possible effect, not invent rollback")
+			}
+			if source.calls.Load() != expectedCalls {
+				t.Fatal("unexpected decoder effect", source.calls.Load())
+			}
+		})
+	}
+}
