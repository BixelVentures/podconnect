+			}
+		})
+	}
+}
+
+func TestIdleAliasPreferenceDoesNotRequirePhysicalCAbsence(t *testing.T) {
+	for _, code := range []int{http.StatusConflict, http.StatusServiceUnavailable} {
+		t.Run(strconv.Itoa(code), func(t *testing.T) {
+			p, events, creates := idleAliasFixture(t)
+			var reads atomic.Int32
+			output := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) { reads.Add(1); w.WriteHeader(code) }))
+			defer output.Close()
+			p.app.cfg.RoomTransportOwnToneURL = output.URL
+			before := proto.Clone(p.state.player)
+			reply, err := p.selectLocalAlias(idleAliasRequest(p), context.Background())
+			if err != nil || reply == nil || !reply.AcceptedLocal || !reply.IdleOnly || reply.ID != 2 || reads.Load() != 0 || creates.Load() != 0 || len(events.events) != 1 || !proto.Equal(before, p.state.player) || p.primaryStream != nil || p.app.openedWriterOwner != nil {
+				t.Fatal("local preference depended on C availability or claimed physical effects", err, reply, reads.Load(), creates.Load())
