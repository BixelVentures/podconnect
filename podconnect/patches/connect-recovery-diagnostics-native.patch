+// Diagnostics only: never supplies an admission decision or exposes request data.
+func (p *AppPlayer) connectRecoveryOriginReason(req dealer.RequestPayload) string {
+	alias := req.TargetAliasId
+	if alias == nil {
+		alias = req.Command.TargetAliasId
+	}
+	switch {
+	case req.Command.Endpoint != "transfer":
+		return "not_transfer"
+	case req.Command.Options.SystemInitiated || req.Command.PlayOptions.SystemInitiated:
+		return "system_initiated"
+	case len(req.Command.Data) == 0:
+		return "empty_transfer"
+	case alias == nil || *alias == 0 || int(*alias) > len(p.app.cfg.DeviceAliases):
+		return "explicit_alias_missing"
+	case req.SentByDeviceId == "" || len(req.SentByDeviceId) > 160:
+		return "sender_invalid"
+	case p.state == nil || p.state.device == nil || p.state.device.SelectedAliasId != *alias:
+		return "alias_not_current"
+	default:
+		return "connection_missing"
+	}
+}
+
+// Called under aliasMu, only after the unchanged ledger guard rejected.
+func (p *AppPlayer) connectRecoveryLedgerReason(key [32]byte, binding *ApiAliasBinding) string {
+	switch {
+	case p.aliasRetired || binding == nil || !binding.Ready:
+		return "owner_not_ready"
+	case p.connectRecoverySeen[key]:
+		return "duplicate_request"
+	default:
+		return "ledger_capacity"
+	}
+}
diff --git a/daemon/connect_diagnostics_test.go b/daemon/connect_diagnostics_test.go
new file mode 100644
--- /dev/null
+++ b/daemon/connect_diagnostics_test.go
@@ -0,0 +1,41 @@
+package daemon
+
+import (
+	"fmt"
+	librespot "github.com/devgianlu/go-librespot"
+	"strings"
+	"testing"
+)
+
+type recoveryDiagnosticLogger struct {
+	librespot.NullLogger
+	lines []string
+}
+
+func (l *recoveryDiagnosticLogger) Infof(format string, args ...interface{}) {
+	l.lines = append(l.lines, fmt.Sprintf(format, args...))
+}
+func TestConnectRecoveryDiagnosticOriginAndReplay(t *testing.T) {
+	p, s := localAliasPlayer(t)
+	p.spotConnId = "private-connection"
+	logger := &recoveryDiagnosticLogger{}
+	p.app.log = logger
+	r := recoveryRequest()
+	r.SentByDeviceId = "private-sender"
+	r.Command.Options.SystemInitiated = true
+	p.emitConnectRecovery(r)
+	if len(s.events) != 0 || len(logger.lines) != 1 || logger.lines[0] != "connect-recovery native reason=system_initiated" {
+		t.Fatal("system rejection lacks exact closed reason")
+	}
+	r.Command.Options.SystemInitiated = false
+	p.emitConnectRecovery(r)
+	p.emitConnectRecovery(r)
+	if len(s.events) != 1 || len(logger.lines) != 3 || logger.lines[1] != "connect-recovery native reason=accepted" || logger.lines[2] != "connect-recovery native reason=duplicate_request" {
+		t.Fatal("diagnostic changed one-shot or omitted admission/replay")
+	}
+	for _, line := range logger.lines {
+		if strings.Contains(line, "private") || len(strings.Fields(line)) != 3 {
+			t.Fatal("private/unbounded fields")
+		}
+	}
+}
