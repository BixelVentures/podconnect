+// The authenticated Dealer actor uses the existing MOVE owner before publishing
+// a different room. A completed START/MOVE cannot be routed by legacy recovery.
+func (p *AppPlayer) handoffDealerRoomTransfer(parent context.Context, req dealer.RequestPayload) (bool, error) {
+	if p.app == nil || p.app.cfg == nil || p.app.cfg.AudioBackend != "pipe" || !p.app.cfg.ExternalVolume || p.app.cfg.RoomTransportOwnToneURL == "" {
+		return false, nil
+	}
+	p.app.moveCustodyMu.Lock()
+	owned := p.app.startCustody != nil || p.app.moveCustody != nil
+	blocked := p.app.moveCustodyUnknown || p.app.retirementPending != nil
+	p.app.moveCustodyMu.Unlock()
+	if blocked {
+		return false, ErrAliasConflict
+	}
+	if !owned {
+		return false, nil
+	} // Existing ordinary/unbound route keeps its owner.
+	requested := req.TargetAliasId
+	if requested == nil {
+		requested = req.Command.TargetAliasId
+	}
+	if req.TargetAliasId != nil && req.Command.TargetAliasId != nil && *req.TargetAliasId != *req.Command.TargetAliasId {
+		return false, ErrAliasConflict
+	}
+	if requested == nil || *requested == 0 {
+		return false, nil
+	}
+	p.aliasMu.Lock()
+	valid := p.state != nil && p.state.device != nil && !p.aliasRetired && int(*requested) <= len(p.aliasRegistry) && p.aliasRegistry[*requested-1].ID == *requested
+	same := valid && p.state.device.SelectedAliasId == *requested
+	var destination ApiAlias
+	if valid {
+		destination = p.aliasRegistry[*requested-1]
+	}
+	p.aliasMu.Unlock()
+	if !valid {
+		return false, ErrAliasConflict
+	}
+	if same {
+		return false, nil
+	}
+	if req.Command.Endpoint != "transfer" || len(req.Command.Data) == 0 || req.Command.Options.SystemInitiated || req.Command.PlayOptions.SystemInitiated || req.SentByDeviceId == "" || len(req.SentByDeviceId) > 160 || p.sess == nil {
+		return false, ErrAliasConflict
+	}
+	account, authenticated := p.sess.BoundUsername()
+	if !authenticated || destination.RoomID == "" || destination.HomePodID == "" {
+		return false, ErrAliasConflict
+	}
+	ctx, cancel := context.WithTimeout(parent, 16*time.Second) // Existing public MOVE commit bound.
+	defer cancel()
+	capture, err := p.captureMove(roomVolumeScope{account, p.app.deviceId, destination.RoomID, destination.HomePodID})
+	if err != nil {
+		return false, err
+	}
+	state, err := capture.readCState(ctx)
+	if err != nil {
+		return false, err
+	}
+	value, err := p.offerMove(moveOfferActorRequest{Capture: capture, State: state, Context: ctx})
+	if err != nil {
+		return false, err
+	}
+	op := value.(*moveOperation)
+	op.onDealerActor = true
+	_, err = p.claimMove(moveActorRequest{Operation: op, Context: ctx, Request: movePrepareRequest{Scope: capture.Scope, Offer: op.Offer, Action: "move_existing_session", Args: moveArgs{}}})
+	if err != nil {
+		return false, err
+	}
+	op.prepare(ctx)
+	op.commit(ctx, nil)
+	// The actor-local path uses exactly the public path's reservation cleanup,
+	// deadline fence and UNKNOWN quarantine before accepting another command.
+	open := p.waitMoveReservation(ctx)
+	op.mu.Lock()
+	complete := op.Terminal && op.State == "complete"
+	op.mu.Unlock()
+	if !open || !complete || ctx.Err() != nil {
+		return false, ErrAliasConflict
+	}
+	return true, nil
+}
