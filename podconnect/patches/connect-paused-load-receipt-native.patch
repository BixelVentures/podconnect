+// A paused transfer and its actual queued worker observation share one load
+// receipt. Older Play/Resume observations remain FIFO-ordered; genuine later
+// Pause has no initial receipt and must remain a cancelling observation.
+func TestPausedConnectInitialReceiptPreservesWorkerOrder(t *testing.T) {
+	for _, choice := range []struct{ prior, cancel bool }{{false, false}, {true, false}, {false, true}, {true, true}} {
+		prior, cancel := choice.prior, choice.cancel
+		t.Run(fmt.Sprintf("prior_play_resume_%t_cancel_%t", prior, cancel), func(t *testing.T) {
+			ctx := context.Background()
+			log := &librespot.NullLogger{}
+			events, _ := (evtimpl.Impl{}).NewEventManager(log, nil, nil, nil, "")
+			sp := pc13Spclient(t, pc13RoundTrip(func(r *http.Request) (*http.Response, error) {
+				return &http.Response{StatusCode: 200, Body: http.NoBody, Header: make(http.Header), Request: r}, nil
+			}))
+			path := filepath.Join(t.TempDir(), "pcm.fifo")
+			if err := syscall.Mkfifo(path, 0600); err != nil {
+				t.Fatal(err)
+			}
+			reader, err := os.OpenFile(path, os.O_RDONLY|syscall.O_NONBLOCK, 0)
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer reader.Close()
+			worker, err := player.NewPlayer(&player.Options{Log: log, Spclient: sp, Events: events, AudioBackend: "pipe", AudioOutputPipe: path, AudioOutputPipeFormat: "s16le"})
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer worker.Close()
+			p := pc13ExistingPlayer(t, false)
+			p.player = worker
+			p.prodInfo = &ProductInfo{}
+			p.app.mpris = mpris.DummyServer{}
+			p.state.reset()
+			p.state.device.SelectedAliasId = 1
+			p.app.cfg.DeviceAliases = []string{"Kitchen"}
+			p.app.cfg.DeviceAliasRoomIDs = []string{"r0"}
+			p.app.cfg.DeviceAliasHomePodIDs = []string{"42"}
+			p.app.cfg.ZeroconfEnabled = true
+			p.initAliasRegistry()
+			p.sess = &session.Session{}
+			nextSessionField(p.sess, "sp", sp)
+			nextSessionField(p.sess, "events", events)
+			p.spotConnId = "fixture-owner"
+			p.hasInitialConnectState = true
+			p.prefetchTimer = time.NewTimer(time.Hour)
+			defer p.prefetchTimer.Stop()
+			if prior {
+				if err = worker.SetPrimaryStreamObserved(&contentInertSource{}, false, false, 1); err != nil {
+					t.Fatal(err)
+				}
+				if err = worker.Play(); err != nil {
+					t.Fatal(err)
+				}
+				p.primaryLoadOrdinal = 1
+			}
+			track := "spotify:track:0000000000000000000003"
+			id, _ := librespot.SpotifyIdFromUri(track)
+			p.secondaryStream = &player.Stream{Source: &contentInertSource{}, Media: librespot.NewMediaFromTrack(&metadatapb.Track{Gid: id.Id(), Name: proto.String("fixture-track"), Duration: proto.Int32(300000), Number: proto.Int32(1), DiscNumber: proto.Int32(1), Album: &metadatapb.Album{Name: proto.String("fixture-album"), Date: &metadatapb.Date{}}})}
+			state := pc13TransferState()
+			state.Playback.CurrentTrack = &connectpb.ContextTrack{Uri: track}
+			state.Playback.IsPaused = true
+			state.CurrentSession.Context.Pages = []*connectpb.ContextPage{{Tracks: []*connectpb.ContextTrack{{Uri: track}}}}
+			req := recoveryRequest()
+			req.Command.Data, err = proto.Marshal(state)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if err = p.handlePlayerCommandWithSpclient(ctx, req, sp); err != nil {
+				t.Fatal(err)
+			}
+			server := p.app.server.(*aliasTestServer)
+			credit := server.events[len(server.events)-1]
+			data, ok := credit.Data.(map[string]any)
+			if credit.Type != "connect_transfer" || !ok || data["initial_load_ordinal"] != p.primaryLoadOrdinal || data["initial_paused"] != true {
+				t.Fatal("accepted paused transfer missing exact load receipt", credit)
+			}
+			p.aliasMu.Lock()
+			binding := p.aliasBindingLocked()
+			p.aliasMu.Unlock()
+			initialStatus := map[string]any{"active": p.state.active, "paused": p.state.player.IsPaused, "stopped": !p.state.player.IsPlaying, "selected_alias_id": p.state.device.SelectedAliasId, "alias_binding": binding}
+			// Queue genuine user Pause before any of the initial worker events dispatch.
+			var command dealer.RequestPayload
+			command.Command.Endpoint = "pause"
+			if cancel {
+				if err = p.handlePlayerCommandWithSpclient(ctx, command, sp); err != nil {
+					t.Fatal(err)
+				}
+			}
+			count := 1
+			if prior {
+				count = 3
+			}
+			for i := 0; i < count; i++ {
+				select {
+				case event := <-worker.Receive():
+					if i == count-1 {
+						if event.Type != player.EventTypePause || event.InitialLoadOrdinal != p.primaryLoadOrdinal {
+							t.Fatal("current initial observation lost receipt", event)
+						}
+					} else if i == 0 && event.InitialLoadOrdinal != 1 {
+						t.Fatal("prior initial observation lost distinct receipt", event)
+					} else if i == 1 && event.InitialLoadOrdinal != 0 {
+						t.Fatal("ordinary Resume impersonated initial load", event)
+					}
+					p.handlePlayerEvent(ctx, &event)
+				case <-time.After(time.Second):
+					t.Fatal("missing actual FIFO-ordered worker observation")
+				}
+			}
+			last := server.events[len(server.events)-1]
+			paused, ok := last.Data.(ApiEventDataPaused)
+			if last.Type != ApiEventTypePaused || !ok || paused.InitialLoadOrdinal != p.primaryLoadOrdinal || !p.state.player.IsPaused {
+				t.Fatal("initial Pause wire receipt/state wrong", last)
+			}
+			if cancel {
+
+				select {
+				case event := <-worker.Receive():
+					if event.InitialLoadOrdinal != 0 {
+						t.Fatal("genuine Pause impersonated initial load")
+					}
+					p.handlePlayerEvent(ctx, &event)
+				case <-time.After(time.Second):
+					t.Fatal("missing genuine queued Pause")
+				}
+				last = server.events[len(server.events)-1]
+				paused, ok = last.Data.(ApiEventDataPaused)
+				if last.Type != ApiEventTypePaused || !ok || paused.InitialLoadOrdinal != 0 {
+					t.Fatal("genuine Pause lost ordinary cancellation", last)
+				}
+			}
+
+			command.Command.Endpoint = "resume"
+			if err = p.handlePlayerCommandWithSpclient(ctx, command, sp); err != nil {
+				t.Fatal(err)
+			}
+			select {
+			case event := <-worker.Receive():
+				if event.InitialLoadOrdinal != 0 {
+					t.Fatal("genuine Resume impersonated load")
+				}
+				p.handlePlayerEvent(ctx, &event)
+			case <-time.After(time.Second):
+				t.Fatal("missing explicit Resume")
+			}
+			if p.state.player.IsPaused || server.events[len(server.events)-1].Type != ApiEventTypePlaying {
+				t.Fatal("explicit Resume failed")
+			}
+			rawWire, marshalErr := json.Marshal(server.events)
+			if marshalErr != nil {
+				t.Fatal(marshalErr)
+			}
+			var wire []struct {
+				Type string         `json:"type"`
+				Data map[string]any `json:"data"`
+			}
+			if err = json.Unmarshal(rawWire, &wire); err != nil {
+				t.Fatal(err)
+			}
+			matchingPause := 0
+			for _, event := range wire {
+				if event.Type == "paused" && event.Data["initial_load_ordinal"] == float64(p.primaryLoadOrdinal) {
+					matchingPause++
+				}
+			}
+			if matchingPause != 1 {
+				t.Fatal("actual JSON initial receipt missing/duplicated", string(rawWire))
+			}
+			if dir := os.Getenv("PC58_CONNECT_TRACE_DIR"); dir != "" {
+				if err = os.MkdirAll(dir, 0700); err != nil {
+					t.Fatal(err)
+				}
+				raw, marshalErr := json.MarshalIndent(map[string]any{"initial_status": initialStatus, "events": server.events}, "", "  ")
+				if marshalErr != nil {
+					t.Fatal(marshalErr)
+				}
+				if err = os.WriteFile(filepath.Join(dir, fmt.Sprintf("prior-%t-cancel-%t.json", prior, cancel)), append(raw, '\n'), 0600); err != nil {
+					t.Fatal(err)
+				}
+			}
+		})
+	}
+}
