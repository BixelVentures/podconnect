+// The caller receipt identifies only this load's later initial observation.
+// Command acknowledgement and queued event ordering remain unchanged.
+func (p *Player) SetPrimaryStreamObserved(source librespot.AudioSource, paused, drop bool, ordinal uint64) error {
+	if ordinal == 0 || ordinal > 9007199254740991 {
+		return fmt.Errorf("invalid initial load receipt")
+	}
+	return p.setPrimaryStream(source, paused, drop, ordinal)
+}
