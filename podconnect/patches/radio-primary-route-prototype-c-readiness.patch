@@ -1951,6 +1951,32 @@
 #include "httpd_jsonapi_radio_sender.inc.c"
 #include "httpd_jsonapi_radio_reacquire.inc.c"
 
+/* The composed primary build exposes this private, read-only capability.
+ * Current custody remains a separate observation and effect admission is
+ * never granted by this response. */
+static int
+jsonapi_reply_primary_radio_readiness(struct httpd_request *hreq)
+{
+  uint64_t id;
+  struct output_radio_admission admission = { 0 };
+  json_object *reply;
+  if (outputs_radio_sender_role()
+      || safe_atou64(hreq->path_parts[2], &id) < 0 || !id || id == UINT64_MAX)
+    return HTTP_BADREQUEST;
+  if (player_radio_admission_get(id, &admission) < 0)
+    return 409;
+  reply = json_object_new_object();
+  if (!reply)
+    return HTTP_SERVUNAVAIL;
+  json_object_object_add(reply, "schema", json_object_new_string("podconnect.output_primary_radio_readiness.v1"));
+  json_object_object_add(reply, "process_id", json_object_new_string(admission.process_id));
+  attention_json_u64(reply, "device_id", admission.device_id);
+  attention_json_u64(reply, "device_incarnation", admission.device_incarnation);
+  json_object_object_add(reply, "legacy_admission_open", json_object_new_boolean(admission.admission_open));
+  json_object_object_add(reply, "physical_result_verified", json_object_new_boolean(false));
+  return transport_json_reply(hreq, reply);
+}
+
 static int
