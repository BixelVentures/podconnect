+type retirementHeldRead struct {
+	entered     chan struct{}
+	release     chan struct{}
+	once        sync.Once
+	releaseOnce sync.Once
+	cancel      atomic.Bool
+}
+
+func (s *retirementHeldRead) Read([]float32) (int, error) {
+	s.once.Do(func() { close(s.entered) })
+	<-s.release
+	return 0, io.EOF
+}
+func (*retirementHeldRead) PositionMs() int64         { return 0 }
+func (*retirementHeldRead) SetPositionMs(int64) error { return nil }
+func (s *retirementHeldRead) CancelRead() {
+	s.cancel.Store(true)
+	s.releaseOnce.Do(func() { close(s.release) })
+}
+
+func retirementOwnerFixture(t *testing.T, baseURL, purpose string) (*App, *AppPlayer, string) {
+	t.Helper()
+	process, valid := nativeContentProcess()
+	if !valid {
+		t.Skip("requires actual Linux process certificate")
+	}
+	path := filepath.Join(t.TempDir(), "retiring.fifo")
+	if err := syscall.Mkfifo(path, 0600); err != nil {
+		t.Fatal(err)
+	}
+	reader, err := os.OpenFile(path, os.O_RDONLY|syscall.O_NONBLOCK, 0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = reader.Close() })
+	app := &App{}
+	owner := &AppPlayer{app: app, stop: make(chan struct{}, 1)}
+	worker, err := player.NewPlayer(&player.Options{Log: &librespot.NullLogger{}, AudioBackend: "pipe", AudioOutputPipe: path, AudioOutputPipeFormat: "s16le", WithNewOutput: func(create func() (output.Output, error)) (output.Output, error) {
+		return app.withNewOutput(owner, create)
+	}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	owner.player = worker
+	source := &contentInertSource{}
+	if err := worker.SetPrimaryStream(source, true, false); err != nil {
+		t.Fatal(err)
+	}
+	if _, _, err := worker.Start35(context.Background(), "quiesce", nil, source, output.PipeIdentity{}, "", func(mutate func()) error { mutate(); return nil }); err != nil {
+		t.Fatal(err)
+	}
+	pipe := &outputPipeIdentity{Device: app.openedWriter.Device, Inode: app.openedWriter.Inode, Type: app.openedWriter.Type}
+	incarnation, token := strings.Repeat("a", 32), strings.Repeat("e", 32)
+	capture := &contentCapture{Process: process, Incarnation: incarnation, OwnTone: baseURL, Scope: roomVolumeScope{HomePodID: "102"}}
+	if purpose == "start" {
+		op := &contentOperation{Owner: owner, Capture: capture, Target: contentTarget{DeviceID: "102"}, Epoch: "1", State: "complete", Terminal: true,
+			CReceipt: &contentCReceipt{Token: token, Phase: "completed", WriterEpoch: "1", InputEpoch: "1", Pipe: pipe}}
+		if err := app.supersedeContentCustody(nil, nil, op); err != nil {
+			t.Fatal(err)
+		}
+	} else {
+		op := &moveOperation{Owner: owner, Capture: &moveCapture{contentCapture: capture}, Target: contentTarget{DeviceID: "102"}, Epoch: "1", State: "complete", Terminal: true,
+			CReceipt: &moveCReceipt{Token: token, Phase: "completed", WriterEpoch: "1", InputEpoch: "1", Pipe: pipe}}
+		app.installCompletedMoveCustody(op)
+	}
+	return app, owner, app.openedWriter.FD
+}
+
+func retirementReply(purpose, phase, reservation string, writer output.MovePipeIdentity) retirementReceipt {
+	r := retirementReceipt{Schema: "podconnect.output_" + purpose + "_retirement_" + phase + ".v1", OK: true, Purpose: purpose,
+		RetirementToken: strings.Repeat("f", 32), CompletedToken: strings.Repeat("e", 32), ReservationID: reservation,
+		WriterEpoch: "1", AdmittedInput: "1", InputEpoch: "1", Pipe: outputPipeIdentity{Device: writer.Device, Inode: writer.Inode, Type: writer.Type},
+		Outcome: "pending", ReaderReady: true, GateClosed: true, DurablePending: true}
+	if phase == "complete" || phase == "result" {
+		r.Outcome, r.InputEpoch, r.ContextsDrained, r.DurableTerminal, r.RetiredWitness = "retired", "2", true, true, true
+	}
+	return r
+}
