+func TestRoomMoveNewAppFIFOEmissionWaitsForExactOldCRevocation(t *testing.T) {
+	entered, release := make(chan struct{}), make(chan struct{})
+	var releaseOnce sync.Once
+	defer releaseOnce.Do(func() { close(release) })
+	var op *moveOperation
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		close(entered)
+		<-release // Hold C before it closes the old global gate.
+		reply := moveCReceipt{Schema: "podconnect.output_move_cancel.v1", OK: true, Token: op.CReceipt.Token, OfferID: op.Offer.OfferID, BindingID: op.Offer.BindingID, Incarnation: op.Capture.Incarnation, Revision: op.Revision, ReservationID: op.ReservationID, Policy: movePolicy, OldOwner: *op.Capture.OldOwner, Intended: op.Intended, Target: op.Target, InputDigest: op.Capture.PipeDigest, Phase: "unknown", GateClosed: true}
+		_ = json.NewEncoder(w).Encode(reply)
+	}))
+	defer server.Close()
+	app := &App{}
+	oldWorker, err := player.NewPlayer(&player.Options{})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer oldWorker.Close()
+	old := &AppPlayer{app: app, player: oldWorker, stop: make(chan struct{}, 1)}
+	op = completedMoveCustody(old, server.URL)
+	app.installCompletedMoveCustody(op)
+	oldClosed := make(chan struct{})
+	go func() { _ = app.revokeCompletedMoveCustodyFor(old); close(oldClosed) }()
+	select {
+	case <-entered:
+	case <-time.After(time.Second):
+		t.Fatal("old C cancellation was not reached")
+	}
+	path := filepath.Join(t.TempDir(), "new-writer.fifo")
+	if err := syscall.Mkfifo(path, 0600); err != nil {
+		t.Fatal(err)
+	}
+	reader, err := os.OpenFile(path, os.O_RDONLY|syscall.O_NONBLOCK, 0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer reader.Close()
+	attempted := make(chan struct{})
+	newWorker, err := player.NewPlayer(&player.Options{Log: &librespot.NullLogger{}, AudioBackend: "pipe", AudioOutputPipe: path, AudioOutputPipeFormat: "s16le", WithNewOutput: func(create func() (output.Output, error)) (output.Output, error) {
+		close(attempted)
+		return app.withNewOutput(&AppPlayer{app: app}, create)
+	}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer newWorker.Close()
+	defer releaseOnce.Do(func() { close(release) })
+	newWriter := make(chan error, 1)
+	go func() { newWriter <- newWorker.SetPrimaryStream(&contentInertSource{}, true, false) }()
+	select {
+	case <-attempted:
+	case <-time.After(time.Second):
+		t.Fatal("replacement FIFO did not reach its pre-open boundary")
+	}
+	select {
+	case err := <-newWriter:
+		t.Fatalf("replacement emitted before C retired old token: %v", err)
+	default:
+	}
+	releaseOnce.Do(func() { close(release) })
+	select {
+	case <-oldClosed:
+	case <-time.After(time.Second):
+		t.Fatal("old close did not join C revocation")
+	}
+	select {
+	case err := <-newWriter:
+		if err == nil {
+			t.Fatal("UNKNOWN C cancel was credited as retirement and opened a new FIFO")
+		}
+	case <-time.After(time.Second):
+		t.Fatal("new FIFO writer did not return after C UNKNOWN quarantine")
+	}
+}
