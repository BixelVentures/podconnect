+	app := &App{}
+	owner := &AppPlayer{app: app}
+	op = completedMoveCustody(owner, server.URL)
+	app.installCompletedMoveCustody(op)
+	if app.revokeCompletedMoveCustody() == nil || !app.moveCustodyUnknown {
+		t.Fatal("stale C token was credited as exact retirement")
+	}
+	if app.revokeCompletedMoveCustody() == nil || calls != 1 {
+		t.Fatal("uncertain old cancellation retried against a later owner")
+	}
+	successor := &AppPlayer{app: app}
+	app.installCompletedMoveCustody(completedMoveCustody(successor, server.URL))
+	if err := app.revokeCompletedMoveCustodyFor(owner); err == nil || calls != 1 {
+		t.Fatal("late old owner close escaped unknown quarantine")
+	}
+}
+
+func TestRoomMoveLateOldOwnerCannotCancelSuccessor(t *testing.T) {
+	app := &App{}
+	old, successor := &AppPlayer{app: app}, &AppPlayer{app: app}
+	op := completedMoveCustody(successor, "http://127.0.0.1:1")
+	app.installCompletedMoveCustody(op)
+	if err := app.revokeCompletedMoveCustodyFor(old); err != nil || app.moveCustody != op {
+		t.Fatal("late old owner consumed successor's exact token")
