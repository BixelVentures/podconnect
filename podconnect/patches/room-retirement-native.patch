diff -ruN pv35-move-native-author-20261016/native/daemon/room_retirement.go pv35-move-native-replacement-author-20261016/native/daemon/room_retirement.go
--- pv35-move-native-author-20261016/native/daemon/room_retirement.go	1970-01-01 01:00:00
+++ pv35-move-native-replacement-author-20261016/native/daemon/room_retirement.go	2026-10-16 14:58:06
@@ -0,0 +1,261 @@
+package daemon
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"io"
+	"net/http"
+	"strconv"
+	"strings"
+	"time"
+
+	"github.com/devgianlu/go-librespot/output"
+)
+
+type retirementAttempt struct {
+	owner       *AppPlayer
+	purpose     string
+	baseURL     string
+	deviceID    string
+	completed   string
+	reservation string
+	incarnation string
+	process     contentProcess
+	writer      output.MovePipeIdentity
+	writerEpoch string
+	inputEpoch  string
+	retirement  string
+	prepared    bool
+	startSource *contentOperation
+	moveSource  *moveOperation
+}
+
+type retirementReceipt struct {
+	Schema          string             `json:"schema"`
+	OK              bool               `json:"ok"`
+	Purpose         string             `json:"source_purpose"`
+	RetirementToken string             `json:"retirement_token"`
+	CompletedToken  string             `json:"completed_token"`
+	ReservationID   string             `json:"native_reservation_id"`
+	Outcome         string             `json:"outcome"`
+	WriterEpoch     string             `json:"writer_source_epoch"`
+	AdmittedInput   string             `json:"admitted_input_epoch"`
+	InputEpoch      string             `json:"input_epoch"`
+	Pipe            outputPipeIdentity `json:"pipe_identity"`
+	ReaderReady     bool               `json:"reader_ready_closed"`
+	GateClosed      bool               `json:"gate_closed"`
+	ContextsDrained bool               `json:"contexts_drained"`
+	DurablePending  bool               `json:"durable_pending"`
+	DurableTerminal bool               `json:"durable_terminal"`
+	RetiredWitness  bool               `json:"retired_witness"`
+	Physical        bool               `json:"physical_result_verified"`
+}
+
+func (a *retirementAttempt) endpoint(phase string) string {
+	return strings.TrimSuffix(a.baseURL, "/") + "/api/outputs/" + a.deviceID + "/" + a.purpose + "/retire/" + phase
+}
+
+func retirementHTTP(ctx context.Context, method, url string, body, out any) error {
+	var source io.Reader
+	if body != nil {
+		raw, err := json.Marshal(body)
+		if err != nil {
+			return err
+		}
+		source = bytes.NewReader(raw)
+	}
+	req, err := http.NewRequestWithContext(ctx, method, url, source)
+	if err != nil {
+		return err
+	}
+	if body != nil {
+		req.Header.Set("Content-Type", "application/json")
+	}
+	client := &http.Client{Timeout: 12 * time.Second, CheckRedirect: func(*http.Request, []*http.Request) error { return ErrAliasConflict }}
+	reply, err := client.Do(req)
+	if err != nil {
+		return err
+	}
+	defer reply.Body.Close()
+	raw, err := io.ReadAll(io.LimitReader(reply.Body, 16385))
+	if err != nil || len(raw) > 16384 || reply.StatusCode != http.StatusOK {
+		return ErrAliasConflict
+	}
+	return strictContentJSON(raw, out)
+}
+
+func (a *retirementAttempt) matches(reply retirementReceipt, phase string) bool {
+	return reply.Schema == "podconnect.output_"+a.purpose+"_retirement_"+phase+".v1" &&
+		reply.Purpose == a.purpose && reply.RetirementToken == a.retirement &&
+		reply.CompletedToken == a.completed && reply.ReservationID == a.reservation &&
+		reply.WriterEpoch == a.writerEpoch && reply.AdmittedInput == a.inputEpoch &&
+		reply.Pipe == outputPipeIdentity{Device: a.writer.Device, Inode: a.writer.Inode, Type: a.writer.Type} &&
+		reply.GateClosed && !reply.Physical
+}
+
+func (a *retirementAttempt) validPrepare(reply retirementReceipt) bool {
+	return a.matches(reply, "prepare") && reply.OK && reply.Outcome == "pending" &&
+		reply.InputEpoch == a.inputEpoch && reply.ReaderReady && reply.DurablePending &&
+		!reply.DurableTerminal && !reply.RetiredWitness
+}
+
+func (a *retirementAttempt) validTerminal(reply retirementReceipt, phase string) bool {
+	admitted, err1 := strconv.ParseUint(a.inputEpoch, 10, 64)
+	actual, err2 := strconv.ParseUint(reply.InputEpoch, 10, 64)
+	return err1 == nil && err2 == nil && actual > admitted && a.matches(reply, phase) &&
+		(reply.Outcome == "retired" || reply.Outcome == "unknown") &&
+		reply.ReaderReady && reply.ContextsDrained && reply.DurableTerminal && reply.RetiredWitness
+}
+
+func (app *App) prepareCompletedRetirementFor(owner *AppPlayer) *retirementAttempt {
+	app.moveCustodyMu.Lock()
+	if app.moveCustodyUnknown || app.retirementPending != nil {
+		app.moveCustodyMu.Unlock()
+		return nil
+	}
+	var a retirementAttempt
+	switch {
+	case app.startCustody != nil && app.startCustody.Owner == owner:
+		op := app.startCustody
+		op.mu.Lock()
+		if op.Terminal && op.State == "complete" && op.CReceipt != nil && op.CReceipt.Phase == "completed" && op.Capture != nil {
+			a = retirementAttempt{owner: owner, purpose: "start", baseURL: op.Capture.OwnTone, deviceID: op.Target.DeviceID,
+				completed: op.CReceipt.Token, incarnation: op.Capture.Incarnation, process: op.Capture.Process,
+				writerEpoch: op.Epoch, inputEpoch: op.CReceipt.InputEpoch, startSource: op}
+			if op.CReceipt.WriterEpoch != op.Epoch || op.CReceipt.Pipe == nil ||
+				*op.CReceipt.Pipe != (outputPipeIdentity{Device: app.openedWriter.Device, Inode: app.openedWriter.Inode, Type: app.openedWriter.Type}) {
+				a.purpose = ""
+			}
+		}
+		op.mu.Unlock()
+	case app.moveCustody != nil && app.moveCustody.Owner == owner:
+		op := app.moveCustody
+		op.mu.Lock()
+		if op.Terminal && op.State == "complete" && op.CReceipt != nil && op.CReceipt.Phase == "completed" && op.Capture != nil {
+			a = retirementAttempt{owner: owner, purpose: "move", baseURL: op.Capture.OwnTone, deviceID: op.Target.DeviceID,
+				completed: op.CReceipt.Token, incarnation: op.Capture.Incarnation, process: op.Capture.Process,
+				writerEpoch: op.Epoch, inputEpoch: op.CReceipt.InputEpoch, moveSource: op}
+			if op.CReceipt.WriterEpoch != op.Epoch || op.CReceipt.Pipe == nil ||
+				*op.CReceipt.Pipe != (outputPipeIdentity{Device: app.openedWriter.Device, Inode: app.openedWriter.Inode, Type: app.openedWriter.Type}) {
+				a.purpose = ""
+			}
+		}
+		op.mu.Unlock()
+	default:
+		app.moveCustodyMu.Unlock()
+		return nil
+	}
+	if owner == nil || owner.player == nil {
+		app.moveCustodyUnknown = true
+		app.moveCustodyMu.Unlock()
+		return nil
+	}
+	process, current := nativeContentProcess()
+	if !current || process != a.process || a.purpose == "" || !volumeHex32.MatchString(a.completed) || !volumeHex32.MatchString(a.incarnation) ||
+		!volumeCounter(a.writerEpoch) || a.writerEpoch == "0" || !volumeCounter(a.inputEpoch) || a.inputEpoch == "0" ||
+		!volumeCounter(app.openedWriter.FD) || app.openedWriter.Type != "fifo" || !volumeCounter(app.openedWriter.Device) ||
+		!volumeCounter(app.openedWriter.Inode) || app.openedWriter.Inode == "0" || !roomTransportURL(a.baseURL) {
+		app.moveCustodyUnknown = true
+		app.moveCustodyMu.Unlock()
+		return nil
+	}
+	reservation, err := randomQueueID(16)
+	if err != nil {
+		app.moveCustodyUnknown = true
+		app.moveCustodyMu.Unlock()
+		return nil
+	}
+	a.reservation, a.writer = reservation, app.openedWriter
+	app.retirementPending = &a
+	app.moveCustodyMu.Unlock()
+
+	ctx, cancel := context.WithTimeout(context.Background(), 12*time.Second)
+	defer cancel()
+	var reply retirementReceipt
+	err = retirementHTTP(ctx, "POST", a.endpoint("prepare"), struct {
+		Completed   string             `json:"completed_token"`
+		Reservation string             `json:"native_reservation_id"`
+		Incarnation string             `json:"native_incarnation"`
+		Process     contentProcess     `json:"native_process"`
+		Epoch       string             `json:"writer_source_epoch"`
+		FD          string             `json:"writer_fd"`
+		Pipe        outputPipeIdentity `json:"pipe_identity"`
+		InputEpoch  string             `json:"expected_input_epoch"`
+	}{a.completed, a.reservation, a.incarnation, a.process, a.writerEpoch, a.writer.FD,
+		outputPipeIdentity{Device: a.writer.Device, Inode: a.writer.Inode, Type: a.writer.Type}, a.inputEpoch}, &reply)
+	if err != nil || !volumeHex32.MatchString(reply.RetirementToken) {
+		app.retirementFailed(&a)
+		return nil
+	}
+	a.retirement = reply.RetirementToken
+	if !a.validPrepare(reply) {
+		app.retirementFailed(&a)
+		return nil
+	}
+	app.moveCustodyMu.Lock()
+	if app.retirementPending != &a || app.moveCustodyUnknown {
+		app.moveCustodyUnknown = true
+		app.moveCustodyMu.Unlock()
+		return nil
+	}
+	a.prepared = true
+	app.moveCustodyMu.Unlock()
+	// C has durably closed the emission gate and established its draining
+	// reader. Interrupt an in-flight network read without waiting for the
+	// output/source locks that the read itself may hold.
+	owner.player.InterruptRetiringRead()
+	return &a
+}
+
+func (app *App) retirementFailed(a *retirementAttempt) {
+	app.moveCustodyMu.Lock()
+	if app.retirementPending == a {
+		app.moveCustodyUnknown = true
+	}
+	app.moveCustodyMu.Unlock()
+}
+
+func (app *App) completeRetirementFor(a *retirementAttempt) {
+	if a == nil || !a.prepared {
+		return
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), 12*time.Second)
+	defer cancel()
+	var reply retirementReceipt
+	err := retirementHTTP(ctx, "POST", a.endpoint("complete"), struct {
+		Retirement  string             `json:"retirement_token"`
+		Reservation string             `json:"native_reservation_id"`
+		Process     contentProcess     `json:"native_process"`
+		Epoch       string             `json:"writer_source_epoch"`
+		Pipe        outputPipeIdentity `json:"pipe_identity"`
+		InputEpoch  string             `json:"input_epoch"`
+		Closed      bool               `json:"native_close_done"`
+	}{a.retirement, a.reservation, a.process, a.writerEpoch,
+		outputPipeIdentity{Device: a.writer.Device, Inode: a.writer.Inode, Type: a.writer.Type}, a.inputEpoch, true}, &reply)
+	valid := err == nil && a.validTerminal(reply, "complete")
+	if !valid {
+		var observed retirementReceipt
+		readCtx, readCancel := context.WithTimeout(context.Background(), 2*time.Second)
+		defer readCancel()
+		if retirementHTTP(readCtx, "GET", a.endpoint("result/")+a.retirement, nil, &observed) == nil {
+			valid = a.validTerminal(observed, "result")
+		}
+	}
+	app.moveCustodyMu.Lock()
+	defer app.moveCustodyMu.Unlock()
+	if app.retirementPending != a || !valid {
+		app.moveCustodyUnknown = true
+		return
+	}
+	if a.purpose == "start" && app.startCustody == a.startSource && app.startCustody != nil && app.startCustody.Owner == a.owner {
+		app.startCustody = nil
+	} else if a.purpose == "move" && app.moveCustody == a.moveSource && app.moveCustody != nil && app.moveCustody.Owner == a.owner {
+		app.moveCustody = nil
+	} else {
+		app.moveCustodyUnknown = true
+		return
+	}
+	app.retirementPending = nil
+	app.openedWriter = output.MovePipeIdentity{}
+}
