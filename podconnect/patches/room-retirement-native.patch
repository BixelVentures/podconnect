+func TestRoomKnownRetirementTerminalWithoutFreshReaderStaysClosed(t *testing.T) {
+	var writer output.MovePipeIdentity
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		var body map[string]json.RawMessage
+		_ = json.NewDecoder(r.Body).Decode(&body)
+		var reservation string
+		_ = json.Unmarshal(body["native_reservation_id"], &reservation)
+		phase := "prepare"
+		if strings.HasSuffix(r.URL.Path, "/complete") {
+			phase = "complete"
+		}
+		reply := retirementReply("move", phase, reservation, writer)
+		if phase == "complete" {
+			reply.ReaderReady = false
+		}
+		_ = json.NewEncoder(w).Encode(reply)
+	}))
+	defer server.Close()
+	app, owner, _ := retirementOwnerFixture(t, server.URL, "move")
+	writer = app.openedWriter
+	owner.Close()
+	if !app.moveCustodyUnknown {
+		t.Fatal("terminal witness without a fresh FIFO reader admitted a replacement")
+	}
+	if err := attemptCustodyOutput(app, &AppPlayer{app: app}); err == nil {
+		t.Fatal("new writer admitted without C fresh-reader readiness")
+	}
+}
