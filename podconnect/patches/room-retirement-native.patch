diff -ruN pv35-move-native-author-20261016/native/daemon/room_move_custody.go pv35-move-native-replacement-author-20261016/native/daemon/room_move_custody.go
--- pv35-move-native-author-20261016/native/daemon/room_move_custody.go	1970-01-01 01:00:00
+++ pv35-move-native-replacement-author-20261016/native/daemon/room_move_custody.go	2026-10-16 14:38:54
@@ -0,0 +1,153 @@
+package daemon
+
+import (
+	"context"
+	"github.com/devgianlu/go-librespot/output"
+	"time"
+)
+
+// The App outlives individual authenticated AppPlayers. A completed MOVE's C
+// token belongs to the process-wide FIFO writer, so the next AppPlayer must
+// retire it before opening a replacement descriptor.
+func (app *App) installCompletedMoveCustody(op *moveOperation) {
+	app.moveCustodyMu.Lock()
+	defer app.moveCustodyMu.Unlock()
+	app.moveCustody = op
+}
+
+func (app *App) contentCustodySnapshot() (*moveOperation, *contentOperation, error) {
+	app.moveCustodyMu.Lock()
+	defer app.moveCustodyMu.Unlock()
+	if app.moveCustodyUnknown || app.retirementPending != nil {
+		return nil, nil, ErrAliasConflict
+	}
+	if app.startCustody != nil && !completedStartCustody(app.startCustody) {
+		return nil, nil, ErrAliasConflict
+	}
+	return app.moveCustody, app.startCustody, nil
+}
+
+func completedStartCustody(op *contentOperation) bool {
+	op.mu.Lock()
+	defer op.mu.Unlock()
+	return op.Terminal && op.State == "complete" && op.CReceipt != nil && op.CReceipt.Phase == "completed"
+}
+
+// An exact current START35 C commit takes over C's one active token before
+// its native quiesce can open a replacement FIFO writer. The pre-commit native
+// snapshot prevents a delayed ACK from clearing a later MOVE owner.
+func (app *App) supersedeContentCustody(expectedMove *moveOperation, expectedStart, successor *contentOperation) error {
+	app.moveCustodyMu.Lock()
+	defer app.moveCustodyMu.Unlock()
+	if app.moveCustodyUnknown || app.retirementPending != nil || app.moveCustody != expectedMove || app.startCustody != expectedStart || successor == nil ||
+		(expectedStart != nil && !completedStartCustody(expectedStart)) {
+		return ErrAliasConflict
+	}
+	app.moveCustody = nil
+	app.startCustody = successor
+	return nil
+}
+
+// The START gate-closed receipt transfers process-wide writer custody before
+// its own quiesce may create a paused FIFO. Completion does not retire C's
+// active START route, so no unrelated writer may be opened afterward.
+func (app *App) permitStartOutput(op *contentOperation) error {
+	app.moveCustodyMu.Lock()
+	defer app.moveCustodyMu.Unlock()
+	if app.moveCustodyUnknown || app.retirementPending != nil || app.startCustody != op || app.startOutputPermit != nil {
+		return ErrAliasConflict
+	}
+	app.startOutputPermit = op
+	return nil
+}
+
+func (app *App) releaseStartOutput(op *contentOperation) {
+	app.moveCustodyMu.Lock()
+	defer app.moveCustodyMu.Unlock()
+	if app.startOutputPermit == op {
+		app.startOutputPermit = nil
+	}
+}
+
+func (app *App) withNewOutput(owner *AppPlayer, create func() (output.Output, error)) (output.Output, error) {
+	app.moveCustodyMu.Lock()
+	defer app.moveCustodyMu.Unlock()
+	if app.moveCustodyUnknown || app.retirementPending != nil || app.startCustody != nil {
+		allowed := !app.moveCustodyUnknown && app.retirementPending == nil && app.startCustody != nil &&
+			app.startOutputPermit == app.startCustody && app.startCustody.Owner == owner
+		if allowed {
+			return app.openRegisteredOutputLocked(create)
+		}
+		return nil, ErrAliasConflict
+	}
+	if err := app.revokeCompletedMoveCustodyLocked(nil); err != nil {
+		return nil, err
+	}
+	return app.openRegisteredOutputLocked(create)
+}
+
+func (app *App) openRegisteredOutputLocked(create func() (output.Output, error)) (output.Output, error) {
+	out, err := create()
+	if err != nil {
+		return nil, err
+	}
+	if owned, ok := out.(interface {
+		OpenedWriterIdentity() output.MovePipeIdentity
+	}); ok {
+		app.openedWriter = owned.OpenedWriterIdentity()
+	} else {
+		app.openedWriter = output.MovePipeIdentity{}
+	}
+	return out, nil
+}
+
+func (app *App) revokeCompletedMoveCustody() error {
+	return app.revokeCompletedMoveCustodyFor(nil)
+}
+
+func (app *App) revokeCompletedMoveCustodyFor(owner *AppPlayer) error {
+	app.moveCustodyMu.Lock()
+	defer app.moveCustodyMu.Unlock()
+	return app.revokeCompletedMoveCustodyLocked(owner)
+}
+
+func (app *App) revokeCompletedMoveCustodyLocked(owner *AppPlayer) error {
+	if app.moveCustodyUnknown || app.retirementPending != nil {
+		return ErrAliasConflict
+	}
+	op := app.moveCustody
+	if op == nil || (owner != nil && op.Owner != owner) {
+		return nil
+	}
+	op.mu.Lock()
+	reply := op.CReceipt
+	complete := op.Terminal && op.State == "complete"
+	reservation := op.ReservationID
+	capture := op.Capture
+	offer := op.Offer
+	revision := op.Revision
+	intended := op.Intended
+	op.mu.Unlock()
+	if !complete || reply == nil || reply.Phase != "completed" || capture == nil || capture.OldOwner == nil {
+		app.moveCustodyUnknown = true
+		return ErrAliasConflict
+	}
+	ctx, stop := context.WithTimeout(context.Background(), time.Second)
+	defer stop()
+	var cancelled moveCReceipt
+	err := contentHTTP(ctx, "POST", capture.endpoint("cancel"), struct {
+		Token       string `json:"token"`
+		Reservation string `json:"native_reservation_id"`
+	}{reply.Token, reservation}, &cancelled)
+	if err != nil || cancelled.Schema != "podconnect.output_move_cancel.v1" || !cancelled.OK || cancelled.Token != reply.Token || cancelled.ReservationID != reservation || cancelled.OfferID != offer.OfferID || cancelled.BindingID != offer.BindingID || cancelled.Incarnation != capture.Incarnation || cancelled.Revision != revision || cancelled.Policy != movePolicy || cancelled.OldOwner != *capture.OldOwner || cancelled.Intended != intended || cancelled.Target != op.Target || cancelled.InputDigest != capture.PipeDigest || cancelled.Phase != "unknown" || !cancelled.GateClosed || cancelled.Physical {
+		// An uncertain effect is never retried against a later C owner. Every
+		// future new-output attempt on this process remains closed.
+		app.moveCustodyUnknown = true
+		return ErrAliasConflict
+	}
+	// The completed MOVE cancel receipt closes C's gate but deliberately ends
+	// in UNKNOWN. It is quarantine, never proof that C drained its reader and
+	// durably retired source custody for a replacement FIFO writer.
+	app.moveCustodyUnknown = true
+	return ErrAliasConflict
+}
