+func TestRoomKnownRetirementInterruptsHeldRawReadAfterCGate(t *testing.T) {
+	var writer output.MovePipeIdentity
+	var gated atomic.Bool
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		var body map[string]json.RawMessage
+		_ = json.NewDecoder(r.Body).Decode(&body)
+		var reservation string
+		_ = json.Unmarshal(body["native_reservation_id"], &reservation)
+		if strings.HasSuffix(r.URL.Path, "/prepare") {
+			gated.Store(true)
+			_ = json.NewEncoder(w).Encode(retirementReply("move", "prepare", reservation, writer))
+			return
+		}
+		_ = json.NewEncoder(w).Encode(retirementReply("move", "complete", reservation, writer))
+	}))
+	defer server.Close()
+	app, owner, _ := retirementOwnerFixture(t, server.URL, "move")
+	writer = app.openedWriter
+	current, err := owner.player.Start35CurrentSource(context.Background())
+	if err != nil {
+		t.Fatal(err)
+	}
+	held := &retirementHeldRead{entered: make(chan struct{}), release: make(chan struct{})}
+	defer held.CancelRead()
+	if _, _, err := owner.player.Start35(context.Background(), "publish", held, current, writer.PipeIdentity, "1", func(mutate func()) error { mutate(); return nil }); err != nil {
+		t.Fatal(err)
+	}
+	if _, _, err := owner.player.Start35(context.Background(), "resume", nil, held, writer.PipeIdentity, "1", func(mutate func()) error { mutate(); return nil }); err != nil {
+		t.Fatal(err)
+	}
+	select {
+	case <-held.entered:
+	case <-time.After(time.Second):
+		t.Fatal("actual FIFO output did not enter held raw read")
+	}
+	done := make(chan struct{})
+	go func() {
+		owner.beginStopRetirement()
+		owner.player.Stop()
+		owner.Close()
+		close(done)
+	}()
+	select {
+	case <-done:
+	case <-time.After(2 * time.Second):
+		t.Fatal("phone Stop hung on raw read after C reader-ready gate")
+	}
+	if !gated.Load() || !held.cancel.Load() || app.retirementPending != nil || app.moveCustodyUnknown {
+		t.Fatal("held raw read was not cancelled after exact C gate and retired by witness")
+	}
+}
