+func TestRoomKnownRetirementGatesBeforeCloseAndWitnessesBeforeReplacement(t *testing.T) {
+	for _, scenario := range []struct {
+		purpose string
+		stop    bool
+	}{{"start", false}, {"move", false}, {"start", true}, {"move", true}} {
+		purpose := scenario.purpose
+		name := purpose
+		if scenario.stop {
+			name += "_phone_stop"
+		}
+		t.Run(name, func(t *testing.T) {
+			var app *App
+			var writerFD string
+			var writer output.MovePipeIdentity
+			var orderMu sync.Mutex
+			var order []string
+			server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				var body map[string]json.RawMessage
+				_ = json.NewDecoder(r.Body).Decode(&body)
+				if r.URL.Path == "/api/outputs/102/"+purpose+"/retire/prepare" {
+					orderMu.Lock()
+					order = append(order, "prepare")
+					orderMu.Unlock()
+					if len(body) != 8 {
+						t.Errorf("prepare request has %d fields", len(body))
+					}
+					var reservation string
+					_ = json.Unmarshal(body["native_reservation_id"], &reservation)
+					var fd string
+					_ = json.Unmarshal(body["writer_fd"], &fd)
+					if fd != writerFD {
+						t.Error("prepare did not bind registered writer FD")
+					}
+					var stat syscall.Stat_t
+					if fdInt, err := strconv.Atoi(fd); err != nil || syscall.Fstat(fdInt, &stat) != nil || stat.Mode&syscall.S_IFMT != syscall.S_IFIFO {
+						t.Error("native writer closed before C pending gate")
+					}
+					_ = json.NewEncoder(w).Encode(retirementReply(purpose, "prepare", reservation, writer))
+					return
+				}
+				if r.URL.Path == "/api/outputs/102/"+purpose+"/retire/complete" {
+					orderMu.Lock()
+					order = append(order, "complete")
+					orderMu.Unlock()
+					if len(body) != 7 || string(body["native_close_done"]) != "true" {
+						t.Error("complete request lacks exact CloseDone assertion")
+					}
+					var reservation string
+					_ = json.Unmarshal(body["native_reservation_id"], &reservation)
+					fdInt, _ := strconv.Atoi(writerFD)
+					var stat syscall.Stat_t
+					if syscall.Fstat(fdInt, &stat) == nil && stat.Mode&syscall.S_IFMT == syscall.S_IFIFO &&
+						strconv.FormatUint(uint64(stat.Ino), 10) == writer.Inode {
+						t.Error("native writer remained open at C complete")
+					}
+					_ = json.NewEncoder(w).Encode(retirementReply(purpose, "complete", reservation, writer))
+					return
+				}
+				t.Errorf("unexpected retirement endpoint %s", r.URL.Path)
+				w.WriteHeader(404)
+			}))
+			defer server.Close()
+			var owner *AppPlayer
+			app, owner, writerFD = retirementOwnerFixture(t, server.URL, purpose)
+			writer = app.openedWriter
+			if scenario.stop {
+				owner.beginStopRetirement()
+				if owner.roomRetirement == nil {
+					t.Fatal("phone Stop did not record the C pending gate before closing its FIFO")
+				}
+				owner.player.Stop()
+			}
+			owner.Close()
+			orderMu.Lock()
+			defer orderMu.Unlock()
+			if strings.Join(order, ",") != "prepare,complete" || app.moveCustodyUnknown || app.retirementPending != nil || app.startCustody != nil || app.moveCustody != nil {
+				t.Fatalf("retirement did not reach exact known terminal: order=%v", order)
+			}
+			if err := attemptCustodyOutput(app, &AppPlayer{app: app}); err != nil {
+				t.Fatal("known terminal did not release old source custody", err)
+			}
+		})
+	}
+}
