+func TestRoomMoveSameWriterNextItemSkipsRevokeButNewWriterWaits(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "pcm.fifo")
+	if err := syscall.Mkfifo(path, 0600); err != nil {
+		t.Fatal(err)
+	}
+	reader, err := os.OpenFile(path, os.O_RDONLY|syscall.O_NONBLOCK, 0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer reader.Close()
+	calls := 0
+	p, err := NewPlayer(&Options{
+		Log: &librespot.NullLogger{}, AudioBackend: "pipe", AudioOutputPipe: path,
+		AudioOutputPipeFormat: "s16le", WithNewOutput: func(create func() (output.Output, error)) (output.Output, error) { calls++; return create() },
+	})
+	if err != nil {
+		t.Fatal(err)
