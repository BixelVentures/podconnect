+	}
+	if err := attemptCustodyOutput(app, owner); err == nil {
+		t.Fatal("START owner opened outside its exact quiesce")
+	}
+	if err := app.permitStartOutput(op); err != nil || attemptCustodyOutput(app, owner) != nil {
+		t.Fatal("exact START quiesce could not create its paused FIFO", err)
+	}
+	if err := attemptCustodyOutput(app, other); err == nil {
+		t.Fatal("other AppPlayer used START quiesce permit")
+	}
+	app.releaseStartOutput(op)
+	op.State, op.Terminal = "complete", true
+	if err := attemptCustodyOutput(app, owner); err == nil {
+		t.Fatal("completed START owner opened a replacement FIFO without retirement")
+	}
+	if err := attemptCustodyOutput(app, other); err == nil {
