+	}
+	p.Stop()
+	if err := p.SetPrimaryStream(&transportSource{id: 3}, true, false); err != nil || calls != 2 {
+		t.Fatalf("new writer was opened without custody boundary: %v calls=%d", err, calls)
+	}
+}
