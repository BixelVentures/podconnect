--- pv35-move-native-author-20261016/native/player/source_retirement_test.go	1970-01-01 01:00:00
+++ pv35-move-native-replacement-author-20261016/native/player/source_retirement_test.go	2026-10-16 14:56:54
@@ -0,0 +1,34 @@
+package player
+
+import (
+	"io"
+	"testing"
+	"time"
+)
+
+type retirementEOFSource struct{}
+
+func (retirementEOFSource) Read([]float32) (int, error) { return 0, io.EOF }
+func (retirementEOFSource) PositionMs() int64           { return 0 }
+func (retirementEOFSource) SetPositionMs(int64) error   { return nil }
+
+func TestRoomKnownRetirementFullDoneCannotHoldSourceLock(t *testing.T) {
+	source := NewSwitchingAudioSource()
+	source.SetPrimary(retirementEOFSource{})
+	source.SetSecondary(retirementEOFSource{})
+	finished := make(chan struct{})
+	go func() {
+		_, _ = source.Read(make([]float32, 1))
+		_, _ = source.Read(make([]float32, 1))
+		close(finished)
+	}()
+	select {
+	case <-finished:
+	case <-time.After(time.Second):
+		source.CancelRead()
+		t.Fatal("second EOF blocked with Done full while holding the source lock")
+	}
+	if got := source.TakeDone(); got != 2 {
+		t.Fatalf("two distinct EOFs require two queue advances, got %d", got)
+	}
+}
