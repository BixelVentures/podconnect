+func TestRoomKnownRetirementPendingBlocksConcurrentNewFIFO(t *testing.T) {
+	entered, release := make(chan struct{}), make(chan struct{})
+	var releaseOnce sync.Once
+	defer releaseOnce.Do(func() { close(release) })
+	var app *App
+	var writer output.MovePipeIdentity
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if strings.HasSuffix(r.URL.Path, "/prepare") {
+			var body map[string]json.RawMessage
+			_ = json.NewDecoder(r.Body).Decode(&body)
+			var reservation string
+			_ = json.Unmarshal(body["native_reservation_id"], &reservation)
+			close(entered)
+			<-release
+			_ = json.NewEncoder(w).Encode(retirementReply("move", "prepare", reservation, writer))
+			return
+		}
+		var body map[string]json.RawMessage
+		_ = json.NewDecoder(r.Body).Decode(&body)
+		var reservation string
+		_ = json.Unmarshal(body["native_reservation_id"], &reservation)
+		_ = json.NewEncoder(w).Encode(retirementReply("move", "complete", reservation, writer))
+	}))
+	defer server.Close()
+	var owner *AppPlayer
+	app, owner, _ = retirementOwnerFixture(t, server.URL, "move")
+	writer = app.openedWriter
+	done := make(chan struct{})
+	go func() { owner.Close(); close(done) }()
+	select {
+	case <-entered:
+	case <-time.After(time.Second):
+		t.Fatal("C pending gate was not entered")
+	}
+	if err := attemptCustodyOutput(app, &AppPlayer{app: app}); err == nil {
+		t.Fatal("new FIFO admitted while retirement prepare was unresolved")
+	}
+	releaseOnce.Do(func() { close(release) })
+	select {
+	case <-done:
+	case <-time.After(2 * time.Second):
+		t.Fatal("retirement did not join native CloseDone and C terminal")
+	}
+}
