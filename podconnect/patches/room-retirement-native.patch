+func TestStart35CommitCannotOvertakeFIFODescriptorAdmission(t *testing.T) {
+	app := &App{}
+	old := &AppPlayer{app: app}
+	start := &contentOperation{Owner: old, State: "committing"}
+	inside, release := make(chan struct{}), make(chan struct{})
+	var releaseOnce sync.Once
+	defer releaseOnce.Do(func() { close(release) })
+	writerDone := make(chan error, 1)
+	go func() {
+		_, err := app.withNewOutput(old, func() (output.Output, error) {
+			close(inside)
+			<-release // The actual descriptor-open boundary is held by custody.
+			return nil, nil
+		})
+		writerDone <- err
+	}()
+	select {
+	case <-inside:
+	case <-time.After(time.Second):
+		t.Fatal("FIFO admission was not entered")
+	}
+	commitDone := make(chan error, 1)
+	go func() { commitDone <- app.supersedeContentCustody(nil, nil, start) }()
+	select {
+	case err := <-commitDone:
+		t.Fatalf("START custody overtook in-progress FIFO open: %v", err)
+	case <-time.After(20 * time.Millisecond):
+	}
+	releaseOnce.Do(func() { close(release) })
+	if err := <-writerDone; err != nil {
+		t.Fatal(err)
+	}
+	if err := <-commitDone; err != nil {
+		t.Fatal(err)
+	}
+	if err := attemptCustodyOutput(app, &AppPlayer{app: app}); err == nil {
+		t.Fatal("unrelated writer opened after START took custody")
+	}
+}
