+	owner, other := &AppPlayer{app: app}, &AppPlayer{app: app}
+	op := &contentOperation{Owner: owner, State: "committing"}
+	if err := app.supersedeContentCustody(nil, nil, op); err != nil {
+		t.Fatal(err)
+	}
