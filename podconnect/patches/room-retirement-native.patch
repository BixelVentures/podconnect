+func TestStart35ExactCompletedSuccessorTransfersCustodyWithoutGap(t *testing.T) {
+	app := &App{}
+	owner := &AppPlayer{app: app}
+	old := &contentOperation{Owner: owner, State: "complete", Terminal: true, CReceipt: &contentCReceipt{Phase: "completed"}}
+	if err := app.supersedeContentCustody(nil, nil, old); err != nil {
+		t.Fatal(err)
+	}
+	move, prior, err := app.contentCustodySnapshot()
+	if err != nil || move != nil || prior != old {
+		t.Fatal("completed START source custody not captured", err)
+	}
+	newStart := &contentOperation{Owner: owner, State: "committing"}
+	if err := app.supersedeContentCustody(nil, prior, newStart); err != nil || app.startCustody != newStart {
+		t.Fatal("exact committed START successor did not take custody atomically", err)
+	}
+	if err := app.supersedeContentCustody(nil, prior, old); err == nil || app.startCustody != newStart {
+		t.Fatal("stale old START ACK replaced newer custody")
+	}
+	if _, _, err := app.contentCustodySnapshot(); err == nil {
+		t.Fatal("pending successor was mistaken for completed START")
+	}
+	newStart.mu.Lock()
+	newStart.State, newStart.Terminal = "unknown", true
+	newStart.mu.Unlock()
+	if _, _, err := app.contentCustodySnapshot(); err == nil || attemptCustodyOutput(app, owner) == nil {
+		t.Fatal("unknown successor escaped App-level FIFO quarantine")
+	}
+}
