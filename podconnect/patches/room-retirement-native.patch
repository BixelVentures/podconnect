+func TestRoomMoveCompletedCancelIsUnknownNotNewWriterProof(t *testing.T) {
+	calls := 0
+	var op *moveOperation
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		calls++
+		if r.URL.Path != "/api/outputs/102/move/cancel" || r.Method != http.MethodPost {
+			t.Errorf("wrong C endpoint: %s %s", r.Method, r.URL.Path)
+		}
+		var body map[string]string
+		if err := json.NewDecoder(r.Body).Decode(&body); err != nil || len(body) != 2 || body["token"] != op.CReceipt.Token || body["native_reservation_id"] != op.ReservationID {
+			t.Errorf("wrong exact C revocation: %#v %v", body, err)
+		}
+		reply := moveCReceipt{Schema: "podconnect.output_move_cancel.v1", OK: true, Token: op.CReceipt.Token, OfferID: op.Offer.OfferID, BindingID: op.Offer.BindingID, Incarnation: op.Capture.Incarnation, Revision: op.Revision, ReservationID: op.ReservationID, Policy: movePolicy, OldOwner: *op.Capture.OldOwner, Intended: op.Intended, Target: op.Target, InputDigest: op.Capture.PipeDigest, Phase: "unknown", GateClosed: true}
+		_ = json.NewEncoder(w).Encode(reply)
+	}))
+	defer server.Close()
+	app := &App{}
+	oldPlayer, err := player.NewPlayer(&player.Options{})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer oldPlayer.Close()
+	old := &AppPlayer{app: app, player: oldPlayer, stop: make(chan struct{}, 1)}
+	op = completedMoveCustody(old, server.URL)
+	app.installCompletedMoveCustody(op)
+	_ = app.revokeCompletedMoveCustodyFor(old) // Fallback UNKNOWN is never retirement.
+	if calls != 1 || app.moveCustody != op || !app.moveCustodyUnknown {
+		t.Fatalf("completed C cancel was falsely credited as known retirement: calls=%d", calls)
+	}
+	if err := app.revokeCompletedMoveCustody(); err == nil || calls != 1 {
+		t.Fatal("UNKNOWN cancellation allowed or retried a new writer")
+	}
+}
+
+func TestRoomMoveCompletedCustodyStaleAckBlocksReplacement(t *testing.T) {
+	calls := 0
+	var op *moveOperation
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		calls++
+		reply := moveCReceipt{Schema: "podconnect.output_move_cancel.v1", OK: true, Token: strings.Repeat("f", 32), OfferID: op.Offer.OfferID, BindingID: op.Offer.BindingID, Incarnation: op.Capture.Incarnation, Revision: op.Revision, ReservationID: op.ReservationID, Policy: movePolicy, OldOwner: *op.Capture.OldOwner, Intended: op.Intended, Target: op.Target, InputDigest: op.Capture.PipeDigest, Phase: "unknown", GateClosed: true}
+		_ = json.NewEncoder(w).Encode(reply)
+	}))
