+
+func testConfiguredManagerPrimaryResume(t *testing.T, ctx context.Context, p *AppPlayer, worker *player.Player, manager string) {
+	t.Helper()
+	app := p.app
+	api, err := NewApiServer(app.log, "127.0.0.1", 0, "", "", "")
+	if err != nil {
+		t.Fatal(err)
+	}
+	server := api.(*ConcreteApiServer)
+	defer server.Close()
+	app.server, app.mpris = server, mpris.DummyServer{}
+	p.state.player.Track = &connectpb.ProvidedTrack{Uri: "spotify:track:0000000000000000000003"}
+	p.state.player.PlayOrigin = &connectpb.PlayOrigin{}
+	p.state.player.Options = &connectpb.ContextPlayerOptions{}
+	p.prefetchTimer = time.NewTimer(time.Hour)
+	defer p.prefetchTimer.Stop()
+	events, _ := (evtimpl.Impl{}).NewEventManager(app.log, nil, nil, nil, "")
+	nextSessionField(p.sess, "events", events)
+	nextSessionField(p.sess, "sp", pc13Spclient(t, pc13RoundTrip(func(r *http.Request) (*http.Response, error) {
+		return &http.Response{StatusCode: http.StatusNoContent, Body: http.NoBody, Header: make(http.Header), Request: r}, nil
+	})))
+	actorContext, cancel := context.WithCancel(ctx)
+	actorRequests := make(chan ApiRequest)
+	actorDone, dispatchDone := make(chan struct{}), make(chan struct{})
+	app.ownerMu.Lock()
+	app.currentPlayer, app.currentAPI, app.currentDone = p, actorRequests, actorDone
+	app.ownerMu.Unlock()
+	go func() {
+		defer close(actorDone)
+		for {
+			select {
+			case <-actorContext.Done():
+				return
+			case req := <-actorRequests:
+				if !p.dispatchAPIAndPark(actorContext, req) {
+					return
+				}
+			case event, open := <-worker.Receive():
+				if !open {
+					return
+				}
+				p.handlePlayerEvent(actorContext, &event)
+			}
+		}
+	}()
+	go func() {
+		defer close(dispatchDone)
+		app.forwardAPI(actorContext)
+	}()
+	defer func() {
+		cancel()
+		<-dispatchDone
+		<-actorDone
+		app.ownerMu.Lock()
+		app.currentPlayer, app.currentAPI, app.currentDone = nil, nil, nil
+		app.ownerMu.Unlock()
+	}()
+
+	endpoint := "http://" + server.listener.Addr().String()
+	cmd := exec.CommandContext(ctx, manager, "-test.v", "-test.timeout=18s", "-test.run", "^TestConfiguredPrimaryRadioComposed$")
+	cmd.Env = append(os.Environ(), "PC_PRIMARY_MANAGER_NATIVE_URL="+endpoint)
+	output, err := cmd.CombinedOutput()
+	t.Logf("configured Manager result:\n%s", output)
+	if err != nil {
+		t.Fatal("configured Manager did not complete the three observed stations", err)
+	}
+	parked, err := worker.InspectRadio(ctx)
+	if err != nil || !parked.Suspended || !parked.WriterClosed || !app.radioOutputFence.Load() {
+		t.Fatal("Manager radio did not retain the parked Spotify writer", err)
+	}
+	resume, err := http.NewRequestWithContext(ctx, http.MethodPost, endpoint+"/player/resume", nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	response, err := http.DefaultClient.Do(resume)
+	if err != nil {
+		t.Fatal("explicit Native Resume failed", err)
+	}
+	response.Body.Close()
+	if response.StatusCode != http.StatusOK {
+		t.Fatalf("explicit Native Resume returned HTTP %d", response.StatusCode)
+	}
+}
