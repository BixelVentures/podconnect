+package daemon
+
+import (
+	"context"
+	"math"
+	"testing"
+
+	"github.com/devgianlu/go-librespot/player"
+)
+
+// These exercise the actual serialized action-receipt owner with the existing
+// alias fixture. No player/audio/provider/session readiness is fabricated.
+func TestExplicitVolumeReceiptKeepsOriginSameValueAndImmutablePlayerBinding(t *testing.T) {
+	p, server := localAliasPlayer(t)
+	p.emitVolumeAction(player.MaxStateVolume, "spotify_connect", "", "")
+	p.emitVolumeAction(player.MaxStateVolume, "api", "", "")
+	if len(server.events) != 2 {
+		t.Fatal("coalesced explicit actions")
+	}
+	first := server.events[0].Data.(ApiEventDataVolumeAction)
+	second := server.events[1].Data.(ApiEventDataVolumeAction)
+	if server.events[0].Type != ApiEventTypeVolumeAction || first.Origin != "spotify_connect" || first.Ordinal != "1" || second.Ordinal != "2" || second.Origin != "api" || first.Value != 100 || second.Value != 100 {
+		t.Fatal("explicit origin/same-value currency lost")
+	}
+	original := *first.AliasBinding
+	_, err := p.handleApiRequest(context.Background(), ApiRequest{Type: ApiRequestTypeSelectAlias, Data: ApiRequestDataSelectAlias{RoomID: "r1", ExpectedIncarnation: p.aliasIncarnation, ExpectedRegistry: p.aliasFingerprint}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	p.retireAliases()
+	if *first.AliasBinding != original || first.AliasID != 1 || !first.AliasBinding.Ready {
+		t.Fatal("old action followed later alias/retirement")
+	}
+	fresh, _ := localAliasPlayer(t)
+	fresh.emitVolumeAction(0, "spotify_connect", "", "")
+	if fresh.aliasIncarnation == first.AliasBinding.Incarnation {
+		t.Fatal("new player reused action epoch")
+	}
+}
+
+func TestManagerVolumeReceiptCarriesExactAutomationIdentity(t *testing.T) {
+	p, server := localAliasPlayer(t)
+	process := "00000000-0000-4000-8000-000000000301"
+	request := "00000000-0000-4000-8000-000000000302"
+	p.emitVolumeAction(player.MaxStateVolume/2, "api", process, request)
+	event := server.events[0].Data.(ApiEventDataVolumeAction)
+	if event.ManagerProcess != process || event.RequestID != request || event.Origin != "api" || event.Ordinal != "1" {
+		t.Fatal("manager echo identity dropped")
+	}
+	if p.player != nil || p.sess != nil {
+		t.Fatal("receipt fixture created a provider/player owner")
+	}
+}
+
+func TestInvalidManagerIdentityRejectedAtActualAPIAdmissionBeforeEffects(t *testing.T) {
+	for _, data := range []ApiRequestDataVolume{
+		{Volume: 20, ManagerProcess: "bad", RequestID: "00000000-0000-4000-8000-000000000302"},
+		{Volume: 20, ManagerProcess: "00000000-0000-4000-8000-000000000301"},
+		{Volume: 20, RequestID: "00000000-0000-4000-8000-000000000302"},
+	} {
+		p, server := localAliasPlayer(t)
+		_, err := p.handleApiRequest(context.Background(), ApiRequest{Type: ApiRequestTypeSetVolume, Data: data})
+		if err == nil || len(server.events) != 0 || p.volumeActionOrdinal != 0 {
+			t.Fatal("bad origin mutated player or emitted authority")
+		}
+	}
+}
+
+func TestExplicitVolumeReceiptSaturationCannotReuseOrdinal(t *testing.T) {
+	p, server := localAliasPlayer(t)
+	p.volumeActionOrdinal = math.MaxUint64
+	p.emitVolumeAction(0, "spotify_connect", "", "")
+	if len(server.events) != 0 || p.volumeActionOrdinal != math.MaxUint64 {
+		t.Fatal("saturated ordinal wrapped/reused")
+	}
+}
