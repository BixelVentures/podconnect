 // Set the player volume to the new volume, also notifies about the change.
+func volumeActionUUID(value string) bool {
+	if len(value) != 36 {
+		return false
+	}
+	for i, c := range value {
+		if i == 8 || i == 13 || i == 18 || i == 23 {
+			if c != '-' {
+				return false
+			}
+		} else if !(c >= '0' && c <= '9' || c >= 'a' && c <= 'f') {
+			return false
+		}
+	}
+	return true
+}
+
+// Only the two explicit remote/API admission sites call this. Initial connection
+// restoration and mixer notifications retain their original generic events.
+func (p *AppPlayer) emitVolumeAction(value uint32, origin, managerProcess, requestID string) {
+	if p.volumeActionOrdinal == math.MaxUint64 {
+		return
+	}
+	p.volumeActionOrdinal++ // Equal-value intent is a new action too.
+	p.app.server.Emit(&ApiEvent{Type: ApiEventTypeVolumeAction, Data: ApiEventDataVolumeAction{
+		Origin: origin, Ordinal: strconv.FormatUint(p.volumeActionOrdinal, 10),
+		Value:   int(math.Round(float64(min(value, player.MaxStateVolume)) * 100 / player.MaxStateVolume)),
+		AliasID: p.state.device.SelectedAliasId, AliasBinding: p.aliasBinding(),
+		ManagerProcess: managerProcess, RequestID: requestID,
+	}})
+}
