index 0000000..e963857
--- /dev/null
+++ b/src/outputs_radio_topology.inc.c
@@ -0,0 +1,441 @@
+/* Exact membership changes for an already OPENED OTHER source. Immutable
+ * operation receipts stay unchanged. Only this journal grants the one extra
+ * selection revision; it grants no target constructor or callback authority. */
+#define RADIO_TOPOLOGY_KEY "podconnect.radio_topology.v2"
+enum radio_topology_kind {RADIO_TOPOLOGY_JOIN=1,RADIO_TOPOLOGY_LOSS,RADIO_TOPOLOGY_DESELECT};
+#define RADIO_TOPOLOGY_LIMIT 16
+struct radio_topology_member {uint64_t id,incarnation;char key[65];};
+struct radio_topology_peer {
+  uint64_t id,generation,reader_epoch,base_revision,attention_revision;
+  int volume;
+  char token[33],command_digest[65],key[65];
+  struct output_transport_identity route;
+};
+struct radio_topology_record {
+  char process[37],a_token[33],a_intent[37],a_digest[65];
+  uint64_t serial,a_id,a_incarnation,a_effect,a_native_revision,before_revision,after_revision,a_session_epoch;
+  enum radio_topology_kind kind;
+  size_t before_count,after_count,peer_count;
+  struct radio_topology_member before[RADIO_TOPOLOGY_LIMIT],after[RADIO_TOPOLOGY_LIMIT];
+  struct radio_topology_peer peers[RADIO_TOPOLOGY_LIMIT];
+};
+struct radio_topology_runtime {
+  struct radio_topology_record record;
+  const void *sessions[RADIO_TOPOLOGY_LIMIT]; /* Never serialized/restored. */
+  const void *target_session;
+  bool active,transition_observed;
+};
+static struct radio_topology_runtime radio_topology_rows[RADIO_TOPOLOGY_LIMIT];
+static char *radio_topology_expected;
+static bool radio_topology_fault;
+static uint64_t radio_topology_serial;
+static int radio_topology_pending=-1;
+static bool radio_topology_record_valid(const struct radio_topology_record *);
+static void radio_topology_digest(const char *domain,const void *object,size_t size,char out[65])
+{
+  gcry_md_hd_t hash;char prefix[128];const unsigned char *bytes;
+  if(gcry_md_open(&hash,GCRY_MD_SHA256,0)!=0){out[0]=0;return;}
+  int length=snprintf(prefix,sizeof(prefix),"%s|%zu|",domain,size);
+  if(length<0 || (size_t)length>=sizeof(prefix)){gcry_md_close(hash);out[0]=0;return;}
+  gcry_md_write(hash,prefix,(size_t)length);gcry_md_write(hash,object,size);bytes=gcry_md_read(hash,GCRY_MD_SHA256);
+  for(size_t i=0;i<32;i++)snprintf(out+i*2,3,"%02x",bytes[i]);out[64]=0;gcry_md_close(hash);
+}
+static bool radio_topology_core_equal(const struct output_transport_identity *a,const struct output_transport_identity *b)
+{
+  struct output_transport_identity copy=*a;copy.selection_revision=b->selection_revision;
+  return transport_identity_equal(&copy,b);
+}
+static bool radio_topology_members_equal(const struct radio_topology_member *a,const struct radio_topology_member *b,size_t count)
+{
+  for(size_t i=0;i<count;i++)if(a[i].id!=b[i].id || a[i].incarnation!=b[i].incarnation || strcmp(a[i].key,b[i].key))return false;
+  return true;
+}
+static bool radio_topology_members(struct radio_topology_member members[RADIO_TOPOLOGY_LIMIT],size_t *count)
+{
+  size_t used=0;
+  for(struct output_device *d=outputs_device_list;d;d=d->next)if(d->selected){
+    if(used==RADIO_TOPOLOGY_LIMIT || d->type!=OUTPUT_TYPE_AIRPLAY || !d->advertised || !d->id
+        || !d->incarnation || d->incarnation==UINT64_MAX)return false;
+    struct radio_topology_member member={.id=d->id,.incarnation=d->incarnation};
+    if(outputs_airplay_radio_pairing_key_digest(d->id,member.key)<0)return false;
+    for(size_t j=0;j<used;j++)if(members[j].id==member.id || !strcmp(members[j].key,member.key))return false;
+    size_t j=used;while(j && members[j-1].id>member.id){members[j]=members[j-1];j--;}members[j]=member;used++;
+  }
+  *count=used;return true;
+}
+static bool radio_topology_set_current(const struct radio_topology_record *r)
+{
+  struct radio_topology_member actual[RADIO_TOPOLOGY_LIMIT]={0};size_t count=0;
+  if(strcmp(r->process,outputs_process) || !radio_topology_members(actual,&count))return false;
+  return (transport_selection_revision==r->before_revision && count==r->before_count
+      && radio_topology_members_equal(actual,r->before,count))
+    || (transport_selection_revision==r->after_revision && count==r->after_count
+      && radio_topology_members_equal(actual,r->after,count));
+}
+static bool radio_topology_peer_current(const struct radio_topology_runtime *row,size_t index,const struct output_transport_identity *actual)
+{
+  const struct radio_topology_peer *p=&row->record.peers[index];struct radio_other_slot *s=radio_other_find(p->id);
+  struct output_device *d=outputs_device_get(p->id);char digest[65],key[65];
+  if(!s || radio_other_fault || s->result.phase!=OUTPUT_RADIO_OTHER_OPENED || !s->result.writer_barrier_verified
+      || s->result.generation!=p->generation || strcmp(s->result.command.token,p->token)
+      || !d || !d->selected || !d->session || d->session!=row->sessions[index] || d->session!=s->session
+      || !radio_topology_core_equal(actual,&p->route)
+      || !radio_topology_core_equal(&s->result.route_identity,&p->route)
+      || outputs_airplay_radio_pairing_key_digest(p->id,key)<0 || strcmp(key,p->key))return false;
+  /* Exact stored command bytes, including owner and writer6. This is only a
+   * same-process equality fence; no cross-build/signature authority exists. */
+  radio_topology_digest("podconnect.topology.b-other.v1",&s->result.command,sizeof(s->result.command),digest);
+  return transport_hex(digest,64) && !strcmp(digest,p->command_digest);
+}
+bool outputs_radio_topology_route_current(uint64_t id,const struct output_transport_identity *identity,const struct output_transport_identity *immutable,uint64_t *reader_epoch)
+{
+  struct output_transport_identity actual;
+  if(reader_epoch)*reader_epoch=UINT64_MAX;
+  if(!identity || !immutable || radio_transport_identity_get(id,&actual,true)<0 || !transport_identity_equal(identity,&actual))return false;
