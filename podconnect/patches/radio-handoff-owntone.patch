+    slot->terminal=has_terminal && json_object_get_boolean(flag);
+    if(slot->terminal && r->phase!=OUTPUT_RADIO_OTHER_OPENED && r->phase!=OUTPUT_RADIO_OTHER_DELEGATED){valid=false;break;}
+    if(slot->terminal && r->phase==OUTPUT_RADIO_OTHER_DELEGATED
+        && (!memchr(r->delegated_token,0,sizeof(r->delegated_token)) || !transport_hex(r->delegated_token,32))){valid=false;break;}
+    if(!slot->terminal){
+      slot->used=true;r->phase=OUTPUT_RADIO_OTHER_UNKNOWN;r->writer_barrier_verified=false;r->observed_current=false;
+    }
+  }
+  if(root)json_object_put(root);
+  if(!valid){memset(radio_other_slots,0,sizeof(radio_other_slots));radio_other_fault=true;}
+}
+static void radio_other_unknown(struct radio_other_slot *s)
+{
+  s->terminal=false;s->result.phase=OUTPUT_RADIO_OTHER_UNKNOWN;s->result.writer_barrier_verified=false;
+  (void)radio_other_save();
+}
+bool outputs_radio_other_constructor_current(uint64_t id)
+{return !radio_other_fault && id && radio_other_scope==id;}
+uint64_t outputs_radio_other_generation(uint64_t id)
+{struct radio_other_slot *s=radio_other_find(id);return s?s->result.generation:0;}
+bool outputs_radio_other_effect_current(uint64_t id,uint64_t generation)
+{
+  struct radio_other_slot *s=radio_other_find(id);
+  if(radio_other_fault)return false;
