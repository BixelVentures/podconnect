+static int radio_other_unhex(unsigned char c)
+{return c>='0'&&c<='9'?c-'0':c>='a'&&c<='f'?c-'a'+10:-1;}
+void outputs_radio_other_target_init(void)
+{
+  char *value=NULL;int found=db_radio_handoff_load_key(RADIO_OTHER_KEY,&value);
+  memset(radio_other_slots,0,sizeof(radio_other_slots));radio_other_fault=false;
+  free(radio_other_expected);radio_other_expected=NULL;
+  if(found==0)return;
+  if(found!=1 || !value){free(value);radio_other_fault=true;return;}
+  radio_other_expected=value;
+  json_object *root=json_tokener_parse(value),*schema=NULL,*size=NULL,*rows=NULL,*terminal=NULL;
+  bool valid=root && json_object_get_type(root)==json_type_object
+    && json_object_object_get_ex(root,"schema",&schema) && json_object_get_type(schema)==json_type_string
+    && !strcmp(json_object_get_string(schema),RADIO_OTHER_KEY)
+    && json_object_object_get_ex(root,"record_size",&size) && json_object_get_type(size)==json_type_int
+    && json_object_get_int64(size)==sizeof(struct output_radio_other_target_result)
+    && json_object_object_get_ex(root,"records",&rows) && json_object_get_type(rows)==json_type_array
+    && json_object_array_length(rows)<=RADIO_OTHER_SLOTS;
