diff --git a/src/radio_absence.h b/src/radio_absence.h
new file mode 100644
index 0000000..137d7b3
--- /dev/null
+++ b/src/radio_absence.h
@@ -0,0 +1,82 @@
+#ifndef PODCONNECT_RADIO_ABSENCE_H
+#define PODCONNECT_RADIO_ABSENCE_H
+/* Include after outputs.h's output_native_process declaration. This source
+ * variant contains no fabricated account, playback session or writer FD. */
+#define RADIO_ABSENCE_ROUTES 16
+struct radio_absence_route {
+  struct output_transport_identity identity;
+  char receiver_key_digest[65];
+};
+struct radio_absence_source {
+  struct output_native_process native_process;
+  char registry_digest[65],input_path[4096],input_path_digest[65];
+  uint64_t pipe_device,pipe_inode;
+  bool target_absence;
+  uint64_t writer_fd,input_generation,input_item_id,input_epoch;
+  size_t route_count;
+  struct radio_absence_route routes[RADIO_ABSENCE_ROUTES];
+};
+struct radio_absence_receiver {
+  char process[37];
+  uint64_t device_id,device_incarnation,session_epoch,route_revision,base_revision,attention_revision;
+};
+struct output_radio_absence_request {
+  struct radio_absence_source source;
+  struct radio_absence_receiver identity;
+  char handoff_id[37],token[33],sender_peer[256],radio_process[37],receiver_key_digest[65];
+  uint64_t generation,native_revision,radio_owner_epoch;
+  int initial_volume_percent;
+};
+struct radio_absence_future_start {
+ struct output_native_process native_process;
+ struct output_native_owner intended_native_owner,old_native_owner;
+ bool old_owner_present;
+ char offer_id[33],binding_id[65],content_digest[65],native_incarnation[33];
+ char input_path[4096],input_path_digest[65],policy_revision[65];
+ uint64_t native_revision;int start_volume_percent;
+};
+struct output_radio_absence_start_request {
+ struct output_radio_absence_request hold;
+ struct radio_absence_future_start future;
+ char intent_id[37],challenge[33],drain_signature[65];uint64_t drain_generation;
+ int final_volume_kind,final_volume_percent;uint64_t final_volume_revision;
+};
+enum output_radio_absence_start_phase {OUTPUT_RADIO_ABSENCE_START_CHALLENGE=1,OUTPUT_RADIO_ABSENCE_START_BOUND,OUTPUT_RADIO_ABSENCE_START_DELEGATED,OUTPUT_RADIO_ABSENCE_START_UNKNOWN};
+struct output_radio_absence_start_result {
+ struct output_radio_absence_start_request command;
+ enum output_radio_absence_start_phase phase;
+ char challenge_signature[65],delegated_token[33];
+ struct radio_absence_receiver target;
+};
