+  if(!sequence || strcmp(sequence,expected)){RADIO_AUTH_TEST_MARK(job,cseq,0);RADIO_AUTH_TEST_MARK(job,reason,12);goto done;}
+  RADIO_AUTH_TEST_MARK(job,cseq,1);
