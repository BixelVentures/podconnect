+      && radio_parked_absence_sign(key,&b->parked,right)==0 && radio_absence_signature_equal(left,right)==0;
+  }
+  if(!a->source_absent)return radio_handoff_equal(&a->source,&b->source,token);
+  unsigned char key[32];char left[65],right[65];
