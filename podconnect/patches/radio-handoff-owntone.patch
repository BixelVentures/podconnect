+    && outputs_radio_topology_route_current(identity->device_id,identity,&s->result.route_identity,&expected_epoch)
+    && (pcm?radio_queue_writer_pcm_current(&s->result.command.current_writer,identity,&actual_epoch,s->pcm_reader_generation)
+      :radio_queue_writer_current(&s->result.command.current_writer,identity,&actual_epoch))
+    && (expected_epoch==UINT64_MAX || expected_epoch==actual_epoch);
+}
+bool outputs_radio_other_owner_current(const struct output_native_owner *owner,const struct output_transport_identity *identity)
+{return radio_other_owner_current(owner,identity,false);}
+bool outputs_radio_other_emission_current(uint64_t id,uint64_t inc,uint64_t epoch,const void *session)
