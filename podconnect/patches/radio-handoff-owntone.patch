+ if(found==0)return;if(found!=1||!value){free(value);radio_source_move_fault=true;return;}radio_source_move_expected=value;
+ json_object *root=json_tokener_parse(value),*schema=NULL,*size=NULL,*rows=NULL;
+ bool valid=root&&json_object_get_type(root)==json_type_object&&json_object_object_length(root)==3&&json_object_object_get_ex(root,"schema",&schema)&&json_object_get_type(schema)==json_type_string&&!strcmp(json_object_get_string(schema),RADIO_SOURCE_MOVE_KEY)
+  &&json_object_object_get_ex(root,"record_size",&size)&&json_object_get_type(size)==json_type_int&&json_object_get_int64(size)==sizeof(struct output_radio_source_move_result)
+  &&json_object_object_get_ex(root,"records",&rows)&&json_object_get_type(rows)==json_type_array&&json_object_array_length(rows)<=RADIO_SOURCE_MOVE_SLOTS;
