index 0000000..e4d6994
--- /dev/null
+++ b/src/radio_drain_ticket.inc.c
@@ -0,0 +1,122 @@
+/* Shared by the exact old receiver custodian and independent radio sender.
+ * Serialize fields, never native structs/padding or arbitrary JSON. Each field
+ * has a 32-bit BE length, including decimal uint64 fields, after a versioned
+ * domain including its NUL. Field order is the fixed v1 protocol. */
+#include "radio_drain_ticket.h"
+static int radio_ticket_text(gcry_md_hd_t h,const char *s,size_t capacity)
+{
+  size_t n=strnlen(s,capacity);unsigned char length[4];
+  if(!n || n==capacity || n>UINT32_MAX)return -1;
+  length[0]=(n>>24)&255;length[1]=(n>>16)&255;length[2]=(n>>8)&255;length[3]=n&255;
+  gcry_md_write(h,length,sizeof(length));gcry_md_write(h,s,n);return 0;
+}
+static int radio_ticket_number(gcry_md_hd_t h,uint64_t n)
+{
+  char value[21];if(!n || n==UINT64_MAX)return -1;
+  snprintf(value,sizeof(value),"%" PRIu64,n);return radio_ticket_text(h,value,sizeof(value));
+}
+/* These existing typed counters/FDs permit a literal zero. Encoding it is
+ * distinct from omitting a field or substituting a positive revision. */
+static int radio_ticket_number_zero(gcry_md_hd_t h,uint64_t n)
+{
+  char value[21];if(n==UINT64_MAX)return -1;
+  snprintf(value,sizeof(value),"%" PRIu64,n);return radio_ticket_text(h,value,sizeof(value));
+}
+static int radio_ticket_percent(gcry_md_hd_t h,int percent)
+{
+  char value[4];if(percent<0 || percent>100)return -1;
+  snprintf(value,sizeof(value),"%d",percent);return radio_ticket_text(h,value,sizeof(value));
+}
+static int radio_ticket_hex(const char *s,size_t length)
+{
+  size_t i;if(strnlen(s,length+1)!=length)return 0;
+  for(i=0;i<length;i++)if(!((s[i]>='0'&&s[i]<='9')||(s[i]>='a'&&s[i]<='f')))return 0;
+  return 1;
+}
+static int radio_ticket_final_volume(gcry_md_hd_t h,const struct radio_drain_identity *d)
+{
+  const char *kind;
+  if(d->final_volume_kind==RADIO_FINAL_VOLUME_ACKNOWLEDGED){if(!d->final_volume_revision || d->final_volume_revision==UINT64_MAX)return -1;kind="receiver_acknowledged";}
+  else if(d->final_volume_kind==RADIO_FINAL_VOLUME_UNCHANGED){if(d->final_volume_revision)return -1;kind="unchanged_source_base";}
+  else return -1;
+  char revision[21];snprintf(revision,sizeof(revision),"%" PRIu64,d->final_volume_revision);
+  return radio_ticket_text(h,kind,32)<0 || radio_ticket_percent(h,d->final_volume_percent)<0 || radio_ticket_text(h,revision,sizeof(revision))<0?-1:0;
+}
+static int radio_ticket_sign_domain(const unsigned char key[32],const struct output_radio_handoff_request *r,
+    const struct radio_drain_identity *d,char out[65],const char *domain,size_t domain_length)
+{
+  static const char hex[]="0123456789abcdef";
+  gcry_md_hd_t h;const unsigned char *digest;unsigned char nonzero=0;size_t i;int ret=-1;
+  if(!key || !r || !d || !out)return -1;
+  for(i=0;i<32;i++)nonzero|=key[i];
+  if(!nonzero || !radio_ticket_hex(r->token,32) || !radio_ticket_hex(r->identity.input_path_digest,64)
+      || !radio_ticket_hex(r->writer.input_path_digest,64) || !radio_ticket_hex(d->receiver_key_digest,64) || !radio_ticket_hex(d->reacquire_challenge,32)
+      || strcmp(d->radio_process,r->radio_process) || d->radio_owner_epoch!=r->radio_owner_epoch
+      || strcmp(d->receiver_key_digest,r->receiver_key_digest))return -1;
+  if(gcry_md_open(&h,GCRY_MD_SHA256,GCRY_MD_FLAG_HMAC))return -1;
+  if(gcry_md_setkey(h,key,32))goto done;
+  gcry_md_write(h,domain,domain_length);
+#define T(obj,field) do{if(radio_ticket_text(h,(obj)->field,sizeof((obj)->field))<0)goto done;}while(0)
+#define N(obj,field) do{if(radio_ticket_number(h,(obj)->field)<0)goto done;}while(0)
+#define N0(obj,field) do{if(radio_ticket_number_zero(h,(obj)->field)<0)goto done;}while(0)
+  T(&r->identity,process);T(&r->identity,input_path_digest);
+  N(&r->identity,device_id);N(&r->identity,device_incarnation);N(&r->identity,session_epoch);
+  N0(&r->identity,route_revision);N0(&r->identity,selection_revision);N(&r->identity,input_generation);N(&r->identity,input_item_id);
+  T(&r->native_owner,account_user_id);T(&r->native_owner,target_id);T(&r->native_owner,room_id);T(&r->native_owner,homepod_id);
+  T(&r->native_owner,connection_id);T(&r->native_owner,session_id);T(&r->native_owner,alias_incarnation);T(&r->native_owner,alias_registry);N0(&r->native_owner,alias_revision);
+  T(&r->writer.native_process,boot_id);N(&r->writer.native_process,pid);N(&r->writer.native_process,proc_start_ticks);
+  N0(&r->writer,writer_fd);N(&r->writer,pipe_device);N(&r->writer,pipe_inode);N(&r->writer,source_epoch);N(&r->writer,open_generation);T(&r->writer,input_path_digest);
+  if(radio_ticket_percent(h,r->initial_volume_percent)<0)goto done;
+  T(r,handoff_id);T(r,token);T(r,sender_peer);N(r,generation);N(r,source_owner_epoch);N(r,native_revision);
+  T(d,radio_process);N(d,radio_owner_epoch);T(d,receiver_key_digest);N(d,drain_generation);T(d,reacquire_challenge);
+  if(!strcmp(domain,"podconnect.radio-drain.v2") && radio_ticket_final_volume(h,d)<0)goto done;
+#undef T
+#undef N
+#undef N0
+  digest=gcry_md_read(h,GCRY_MD_SHA256);if(!digest)goto done;
+  for(i=0;i<32;i++){out[i*2]=hex[digest[i]>>4];out[i*2+1]=hex[digest[i]&15];}out[64]=0;ret=0;
+ done:gcry_md_close(h);return ret;
+}
+static int radio_drain_ticket_sign(const unsigned char key[32],const struct output_radio_handoff_request *r,
+    const struct radio_drain_identity *d,char out[65])
+{
+  static const char domain[]="podconnect.radio-drain.v2";
+  return radio_ticket_sign_domain(key,r,d,out,domain,sizeof(domain));
+}
+static int radio_handoff_suspended_signature(const unsigned char key[32],const struct output_radio_handoff_request *r,char out[65])
+{
+  static const char domain[]="podconnect.radio-suspended.v1";struct radio_drain_identity d={0};
+  snprintf(d.radio_process,sizeof(d.radio_process),"%s",r->radio_process);d.radio_owner_epoch=r->radio_owner_epoch;
+  snprintf(d.receiver_key_digest,sizeof(d.receiver_key_digest),"%s",r->receiver_key_digest);
+  snprintf(d.reacquire_challenge,sizeof(d.reacquire_challenge),"%s",r->token);d.drain_generation=r->generation;
+  return radio_ticket_sign_domain(key,r,&d,out,domain,sizeof(domain));
+}
+static int radio_handoff_suspended_verify(const unsigned char key[32],const struct output_radio_handoff_request *r,const char signature[65])
+{
+  char expected[65];unsigned char diff=0;size_t i;
+  if(!radio_ticket_hex(signature,64) || radio_handoff_suspended_signature(key,r,expected)<0)return -1;
+  for(i=0;i<64;i++)diff|=(unsigned char)(expected[i]^signature[i]);memset(expected,0,sizeof(expected));return diff?-1:0;
+}
+static int radio_handoff_challenge_signature(const unsigned char key[32],const struct output_radio_handoff_request *r,const char nonce[33],char out[65])
+{
+  static const char domain[]="podconnect.radio-reacquire-challenge.v1";struct radio_drain_identity d={0};
+  if(!radio_ticket_hex(nonce,32))return -1;
+  snprintf(d.radio_process,sizeof(d.radio_process),"%s",r->radio_process);d.radio_owner_epoch=r->radio_owner_epoch;
+  snprintf(d.receiver_key_digest,sizeof(d.receiver_key_digest),"%s",r->receiver_key_digest);
+  snprintf(d.reacquire_challenge,sizeof(d.reacquire_challenge),"%s",nonce);d.drain_generation=r->generation;
+  return radio_ticket_sign_domain(key,r,&d,out,domain,sizeof(domain));
+}
+static int radio_handoff_challenge_verify(const unsigned char key[32],const struct output_radio_handoff_request *r,const char nonce[33],const char signature[65])
+{
+  char expected[65];unsigned char diff=0;size_t i;
+  if(!radio_ticket_hex(signature,64) || radio_handoff_challenge_signature(key,r,nonce,expected)<0)return -1;
+  for(i=0;i<64;i++)diff|=(unsigned char)(expected[i]^signature[i]);memset(expected,0,sizeof(expected));return diff?-1:0;
+}
+static int radio_drain_ticket_verify(const unsigned char key[32],const struct output_radio_handoff_request *r,
+    const struct radio_drain_identity *d,const char signature[65])
+{
+  char expected[65];unsigned char diff=0;size_t i;
+  if(!signature || !radio_ticket_hex(signature,64) || radio_drain_ticket_sign(key,r,d,expected)<0)return -1;
+  for(i=0;i<64;i++)diff|=(unsigned char)(expected[i]^signature[i]);
+  memset(expected,0,sizeof(expected));return diff?-1:0;
+}
