+ * the suspended signer directly or populates synthetic handoff slots. */
+struct radio_return_writer {int fd;atomic_int error;atomic_size_t written;atomic_bool stop;};
+static void *radio_return_write(void *arg)
+{
+  struct radio_return_writer *w=arg;char pcm[4096]={0};struct pollfd ready={.fd=w->fd,.events=POLLOUT};
+  while(!atomic_load(&w->stop) && w->written<4*1024*1024){
+    ssize_t count=write(w->fd,pcm,sizeof(pcm));
+    if(count>0){w->written+=count;continue;}
+    if(count<0 && (errno==EAGAIN || errno==EINTR)){poll(&ready,1,50);continue;}
+    w->error=errno?errno:EIO;break;
+  }
+  return NULL;
+}
