+/* Explicit user intent consumes an independently signed current radio drain.
+ * This lane recreates ONLY the held output against CURRENT source input. It
+ * never retargets/replaces the player queue or clears custody as a fallback. */
+static uint64_t radio_reacquire_scope;
+bool outputs_radio_reacquire_constructor_current(uint64_t id)
+{return id && radio_reacquire_scope==id;}
+static bool radio_reacquire_source_equal(const struct output_transport_identity *a,const struct output_transport_identity *b)
+{
+  return !strcmp(a->process,b->process) && a->device_id==b->device_id
+    && a->input_generation==b->input_generation && a->input_item_id==b->input_item_id
+    && !strcmp(a->input_path_digest,b->input_path_digest);
+}
+static bool radio_reacquire_intent_equal(const struct output_radio_reacquire_request *a,const struct output_radio_reacquire_request *b)
+{
+  return radio_handoff_equal(&a->hold,&b->hold,true) && native_owner_equal(&a->current_native_owner,&b->current_native_owner) && native_owner_equal(&a->intended_native_owner,&b->intended_native_owner)
+    && a->native_revision==b->native_revision && !strcmp(a->intent_id,b->intent_id);
+}
+static bool radio_reacquire_receipt_equal(const struct output_radio_reacquire_request *a,const struct output_radio_reacquire_request *b)
+{
+  return radio_reacquire_intent_equal(a,b) && !strcmp(a->challenge,b->challenge)
+    && a->drain_generation==b->drain_generation && a->final_volume_kind==b->final_volume_kind
+    && a->final_volume_percent==b->final_volume_percent && a->final_volume_revision==b->final_volume_revision && !strcmp(a->drain_signature,b->drain_signature)
+    && radio_reacquire_source_equal(&a->current_source_identity,&b->current_source_identity);
+}
+static void radio_reacquire_unknown(struct radio_handoff_slot *s)
+{
+  s->result.resume.phase=OUTPUT_RADIO_REACQUIRE_UNKNOWN;s->result.resume.writer_barrier_verified=false;
+  radio_handoff_unknown(s);
+}
+static bool radio_reacquire_live_source(struct radio_handoff_slot *s,const struct output_queue_writer *writer,bool barrier)
+{
+  struct output_radio_reacquire_result *v=&s->result.resume;struct output_transport_identity actual;
+  struct db_queue_item *item;struct input_fifo_identity reader={0};struct timespec deadline;bool ok;uint64_t generation=0;
+  if(radio_transport_identity_get(s->result.command.identity.device_id,&actual,false)<0
+      || !radio_reacquire_source_equal(&actual,&v->command.current_source_identity)
+      || !radio_queue_writer_admit(writer,&actual,NULL,&generation) || !generation)return false;
+  if(!barrier)return generation==s->resume_pcm_generation;
+  if(!v->pause_native){s->resume_pcm_generation=generation;return true;} /* Shared stream must not be drained. */
+  item=db_queue_fetch_byitemid(actual.input_item_id);if(!item || !item->path){free_queue_item(item,0);return false;}
+  if(clock_gettime(CLOCK_MONOTONIC,&deadline)<0){free_queue_item(item,0);return false;}
+  deadline.tv_nsec+=100000000;if(deadline.tv_nsec>=1000000000){deadline.tv_sec++;deadline.tv_nsec-=1000000000;}
+  ok=input_fifo_owner_get(actual.input_item_id,item->path,true,writer->pipe_device,writer->pipe_inode,&deadline,&reader)==0
+    && reader.device==writer->pipe_device && reader.inode==writer->pipe_inode;
+  free_queue_item(item,0);
+  if(!ok || !radio_queue_writer_admit(writer,&actual,NULL,&generation) || !generation)return false;
+  s->resume_pcm_generation=generation;return true;
+}
+void outputs_radio_reacquire_session_created(uint64_t id,uint64_t inc,uint64_t epoch,const void *session)
+{
