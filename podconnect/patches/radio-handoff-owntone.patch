+/* Offline early CLI. No daemon/config/network startup; keys only travel from
+ * a read-only consistent SQLite snapshot into a newly created private stage. */
+#include <stdio.h>
+#include <stdlib.h>
+#include <stdbool.h>
+#include <errno.h>
+#include <string.h>
+#include <fcntl.h>
+#include <sys/stat.h>
+#include <unistd.h>
+#include <inttypes.h>
+#include <limits.h>
+#include <sqlite3.h>
+#include <json-c/json.h>
+#include "radio_pairing_format.h"
+static bool radio_pairing_stage_authority_equal(const char *bytes,size_t length,json_object *current)
+{
+  json_tokener *tok=json_tokener_new();json_object *old=NULL,*schema=NULL,*controller=NULL,*rows=NULL,*want_rows=NULL,*want_controller=NULL;
+  bool same=false;if(!tok || length>65536)goto done;
+  json_tokener_set_flags(tok,JSON_TOKENER_STRICT);old=json_tokener_parse_ex(tok,bytes,(int)length);
+  if(!old || json_tokener_get_error(tok)!=json_tokener_success || json_tokener_get_parse_end(tok)!=length
+      || !json_object_is_type(old,json_type_object) || json_object_object_length(old)!=3
+      || !json_object_object_get_ex(old,"schema",&schema) || !json_object_is_type(schema,json_type_string)
