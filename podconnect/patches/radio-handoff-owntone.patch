+    sqlite3_int64 volume=sqlite3_column_int64(source_row,0),format=sqlite3_column_int64(source_row,3),offset=sqlite3_column_int64(source_row,4);
+    if(radio_pairing_key(key)<0 || sqlite3_column_bytes(source_row,2)!=192 || (name && sqlite3_column_bytes(source_row,1)!=(int)strlen(name)) || volume< -1 || volume>100 || format<0 || format>INT_MAX || offset<INT_MIN || offset>INT_MAX || (name && strlen(name)>255))goto done;
+    json_object *row=json_object_new_object();if(!row)goto done;
+    json_object_object_add(row,"id",json_object_new_string(argv[i]));json_object_object_add(row,"volume",json_object_new_int64(volume));
