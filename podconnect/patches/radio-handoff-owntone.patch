diff --git a/src/player_radio_sender.inc.c b/src/player_radio_sender.inc.c
new file mode 100644
index 0000000..c2518c7
--- /dev/null
+++ b/src/player_radio_sender.inc.c
@@ -0,0 +1,123 @@
+/* Dedicated radio-role player adapter. Uses its OWN database and source queue;
+ * never touches an AppPlayer, Spotify queue, login, FIFO or session. */
+#include "transcode.h"
+#include "radio_source_preflight.inc.c"
+#include "radio_auth_preflight.inc.c"
+#ifdef RADIO_SENDER_PREFLIGHT_TEST_OBSERVER
+#include <limits.h>
+#endif
+struct radio_source_preflight {char station[32],url[256];uint64_t epoch;int decoded;struct radio_auth_target target;struct radio_auth_witness witness;};
+static enum command_state radio_source_prepared_command(void *arg,int *retval)
+{
+  struct radio_source_preflight *p=arg;struct db_queue_add_info add={0};struct db_queue_item qi={0};char virtual_path[96];int item=-1;
+#ifdef RADIO_SENDER_PREFLIGHT_TEST_OBSERVER
+  int observed_fresh=-1,observed_descriptor=INT_MIN;
+#endif
+  *retval=-1;
+  if(!outputs_radio_sender_preflight_current(p->epoch))return COMMAND_END;
+  if(outputs_radio_sender_preflight_cancelled(p->epoch)){outputs_radio_sender_prepared(p->epoch,0,-2,NULL);return COMMAND_END;}
+#ifdef RADIO_SENDER_PREFLIGHT_TEST_OBSERVER
+  /* Test observation captures only results of these existing calls, retaining
+   * their short circuit order. No additional clock, decoder or network work. */
+  if(!p->decoded || !(observed_fresh=radio_auth_witness_fresh(&p->witness))
+      || (observed_descriptor=outputs_airplay_radio_auth_descriptor_current(p->target.device_id,p->witness.descriptor_digest))<0)goto done;
+#else
+  if(!p->decoded || !radio_auth_witness_fresh(&p->witness)
+      || outputs_airplay_radio_auth_descriptor_current(p->target.device_id,p->witness.descriptor_digest)<0)goto done;
+#endif
+  snprintf(virtual_path,sizeof(virtual_path),"/http:/podview-radio/%s",p->station);
+  /* OwnTone's canonical queue normalizer may replace/free ANY tag. Give it
+   * owned storage; never pointers into the worker request or string literals. */
+  qi.path=strdup(p->url);qi.virtual_path=strdup(virtual_path);qi.title=strdup(p->station);
+  if(!qi.path || !qi.virtual_path || !qi.title)goto done;
+  qi.data_kind=DATA_KIND_HTTP;qi.media_kind=MEDIA_KIND_MUSIC;
+  if(db_queue_add_start(&add,-1)<0)goto done;
+  item=db_queue_add_next(&add,&qi);
+  if(db_queue_add_end(&add,0,0,item)<0 || item<=0){item=-1;goto done;}
+  *retval=0;
+ done:
+#ifdef RADIO_SENDER_PREFLIGHT_TEST_OBSERVER
+  RADIO_SENDER_PREFLIGHT_TEST_OBSERVER(p->epoch,2,*retval,p->decoded,observed_fresh,observed_descriptor,item);
+#endif
+  free_queue_item(&qi,1);outputs_radio_sender_prepared(p->epoch,item>0?(uint32_t)item:0,*retval,*retval==0?&p->witness:NULL);return COMMAND_END;
+}
+static void radio_source_preflight_worker(void *arg)
+{
+  struct radio_source_preflight *p=arg;
+  /* One real decoder call on worker; actual FFmpeg interrupt bounds reads. */
+#ifdef RADIO_SENDER_PREFLIGHT_TEST_OBSERVER
+  int observed_decode=radio_source_decode_preflight(p->url,true);
+  p->decoded=observed_decode==0;
+  RADIO_SENDER_PREFLIGHT_TEST_OBSERVER(p->epoch,0,observed_decode,p->decoded,-1,INT_MIN,0);
+  if(p->decoded){
+    int observed_auth=radio_auth_preflight(&p->target,p->epoch,&p->witness);
+    if(observed_auth<0)p->decoded=0;
+    RADIO_SENDER_PREFLIGHT_TEST_OBSERVER(p->epoch,1,observed_auth,p->decoded,-1,INT_MIN,0);
+  }
+#else
+  p->decoded=radio_source_decode_preflight(p->url,true)==0;
+  if(p->decoded && radio_auth_preflight(&p->target,p->epoch,&p->witness)<0)p->decoded=0;
+#endif
+  commands_exec_sync(cmdbase,radio_source_prepared_command,NULL,p);
+  radio_auth_wipe(p->target.credential,sizeof(p->target.credential));
+}
+int player_radio_source_prepare(const char *station,const char *url,uint64_t epoch,uint64_t device_id)
+{
+  struct radio_source_preflight p={0};
+  if(!outputs_radio_sender_role() || !station || !url || !epoch)return -1;
+  if(snprintf(p.station,sizeof(p.station),"%s",station)>=(int)sizeof(p.station)
+      || snprintf(p.url,sizeof(p.url),"%s",url)>=(int)sizeof(p.url))return -1;
+  if(outputs_airplay_radio_auth_snapshot(device_id,&p.target)<0)return -1;
+  p.epoch=epoch;worker_execute(radio_source_preflight_worker,&p,sizeof(p),0);radio_auth_wipe(p.target.credential,sizeof(p.target.credential));return 0;
+}
+int player_radio_source_start(uint32_t item)
+{
+  struct db_queue_item *qi;struct player_source *ps;int ret;
+  if(!outputs_radio_sender_role() || player_state!=PLAY_STOPPED || !item)return -1;
+  qi=db_queue_fetch_byitemid(item);if(!qi || qi->data_kind!=DATA_KIND_HTTP){free_queue_item(qi,0);return -1;}
+  ps=source_create(qi,0);free_queue_item(qi,0);if(!ps)return -1;
+  /* Deliberately avoid pb_session_start's generic failed-source-next loop. */
+  session_start(ps);ret=source_start(ps);
+  if(ret<0){(void)input_radio_source_stop(item);session_stop();return -1;}
+  session_update_read_start((uint32_t)ret);
+  if(pb_timer_start()<0){(void)input_radio_source_stop(item);session_stop();return -1;}
+  status_update(PLAY_PLAYING,LISTENER_PLAYER);return 0;
+}
+int player_radio_source_retire(uint32_t item)
+{
+  if(!outputs_radio_sender_role())return -1;
+  pb_timer_stop();if(input_radio_source_stop(item)<0)return -1;input_flush(NULL);session_stop();
+  outputs_metadata_purge();status_update(PLAY_STOPPED,LISTENER_PLAYER);
+  if(pb_session.source_list || pb_session.playing_now || pb_session.reading_now)return -1;
+  /* This adapter exists only in the dedicated radio role. Retire the exact
+   * private item once actual input/source references are gone, keeping its
+   * queue bounded across station changes without touching the Spotify DB. */
+  return item?db_queue_delete_byitemid(item):0;
+}
+bool player_radio_source_none(void)
+{
+  return outputs_radio_sender_role() && player_state==PLAY_STOPPED && !pb_session.source_list && !pb_session.playing_now
+    && !pb_session.reading_now && input_radio_source_none();
+}
+bool player_radio_source_current(uint32_t item)
+{
+  return outputs_radio_sender_role() && player_state!=PLAY_STOPPED && pb_session.playing_now && pb_session.playing_now->item_id==item;
+}
+int player_radio_source_discard(uint32_t item)
+{
+  if(!outputs_radio_sender_role())return -1;
+  if(!item)return 0;
+  if((pb_session.playing_now && pb_session.playing_now->item_id==item) || (pb_session.reading_now && pb_session.reading_now->item_id==item))return -1;
+  return db_queue_delete_byitemid(item);
+}
+struct radio_sender_player_command {int action;const struct output_radio_sender_request *r;struct output_radio_sender_result *out;};
+static enum command_state radio_sender_player_command(void *arg,int *retval)
+{
+  struct radio_sender_player_command *c=arg;
+  *retval=outputs_radio_sender(c->action,c->r,c->out);return COMMAND_END;
+}
+int player_radio_sender(int action,const struct output_radio_sender_request *r,struct output_radio_sender_result *out)
+{
+  struct radio_sender_player_command c={action,r,out};
+  return commands_exec_sync(cmdbase,radio_sender_player_command,NULL,&c);
+}
