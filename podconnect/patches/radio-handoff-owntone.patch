+  bytes=evbuffer_pullup(request->input_buffer,-1);if(!bytes){RADIO_AUTH_TEST_MARK(job,reason,14);goto done;}
+  ret=job->stage==1?pair_verify_response1(job->verify,bytes,length):pair_verify_response2(job->verify,bytes,length);
+  if(ret<0){RADIO_AUTH_TEST_MARK(job,reason,job->stage==1?15:16);goto done;}
+  if(job->stage==1){job->stage=2;if(radio_auth_send(job)==0)return;RADIO_AUTH_TEST_MARK(job,reason,17);goto done;}
+  if(pair_verify_result(&result,job->verify)<0 || !result || result->shared_secret_len!=32){RADIO_AUTH_TEST_MARK(job,reason,18);goto done;}
+  RADIO_AUTH_TEST_MARK(job,result,1);
+  cipher=pair_cipher_new(PAIR_CLIENT_HOMEKIT_NORMAL,0,result->shared_secret,result->shared_secret_len);
+  if(!cipher){RADIO_AUTH_TEST_MARK(job,reason,19);goto done;}
+  RADIO_AUTH_TEST_MARK(job,cipher,1);RADIO_AUTH_TEST_MARK(job,reason,0);
+  pair_cipher_free(cipher);job->verified=true;
+ done:event_base_loopbreak(job->base);
+}
+static int radio_auth_send(struct radio_auth_job *job)
+{
+  size_t length=0;uint8_t *bytes=job->stage==1?pair_verify_request1(&length,job->verify):pair_verify_request2(&length,job->verify);
+  struct evrtsp_request *request=NULL;char sequence[4];int ret=-1;
+  RADIO_AUTH_TEST_MARK(job,code,0);RADIO_AUTH_TEST_MARK(job,cseq,-1);
+  RADIO_AUTH_TEST_MARK(job,result,0);RADIO_AUTH_TEST_MARK(job,cipher,0);
+  if(!bytes || !length || length>4096 || !radio_auth_before_deadline(job))goto done;
+  request=evrtsp_request_new(radio_auth_reply,job);if(!request)goto done;
+  snprintf(sequence,sizeof(sequence),"%d",job->stage);
