+static int radio_auth_dispatch_current(void *arg)
+{return radio_auth_before_deadline(arg);}
+#ifdef RADIO_AUTH_PREFLIGHT_TEST_TIME
+static void radio_auth_test_time(const struct radio_auth_job *job,int stage)
+{
+  struct timespec now={.tv_sec=-1,.tv_nsec=-1};
+  (void)clock_gettime(CLOCK_MONOTONIC,&now);
+  RADIO_AUTH_PREFLIGHT_TEST_TIME(job->observed_generation,stage,(int64_t)now.tv_sec,now.tv_nsec,
+    (int64_t)job->deadline.tv_sec,job->deadline.tv_nsec);
