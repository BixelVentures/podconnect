+int outputs_radio_admission_get(uint64_t id,struct output_radio_admission *out)
+{
+  struct output_device *d=outputs_device_get(id);
+  if(!out||!id||id==UINT64_MAX||!d||!d->advertised||d->type!=OUTPUT_TYPE_AIRPLAY
