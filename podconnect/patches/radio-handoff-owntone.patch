+      || sqlite3_bind_text(q,1,path,-1,SQLITE_TRANSIENT)!=SQLITE_OK || sqlite3_step(q)!=SQLITE_ROW
+      || sqlite3_column_int64(q,0)<=0 || sqlite3_column_int(q,1)!=DATA_KIND_PIPE)goto done;
