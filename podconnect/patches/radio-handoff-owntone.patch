+static void radio_auth_timeout(evutil_socket_t fd,short events,void *arg)
+{(void)fd;(void)events;struct radio_auth_job *job=arg;RADIO_AUTH_TEST_MARK(job,reason,8);
+#ifdef RADIO_AUTH_PREFLIGHT_TEST_TIME
+  radio_auth_test_time(job,1);
+#endif
