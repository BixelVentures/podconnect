--- /dev/null
+++ b/src/input_fifo_publication.inc.c
@@ -0,0 +1,63 @@
+/* Input-thread lifecycle publication. The mutex protects only this bounded
+ * value: never hold it across a backend, command, database or PCM-buffer call. */
+static pthread_mutex_t input_fifo_publication_mutex=PTHREAD_MUTEX_INITIALIZER;
+static struct input_fifo_publication input_fifo_publication;
+static bool input_fifo_publication_exhausted;
+
+static bool input_fifo_publication_advance(void)
+{
+  if(input_fifo_publication_exhausted || input_fifo_publication.generation>=UINT64_MAX-1){
+    input_fifo_publication_exhausted=true;input_fifo_publication.valid=false;return false;
+  }
+  input_fifo_publication.generation++;return true;
+}
+static void input_fifo_publication_invalidate(void)
+{
+  pthread_mutex_lock(&input_fifo_publication_mutex);
+  if(input_fifo_publication.valid){
+    input_fifo_publication.valid=false;
+    input_fifo_publication_advance();
+  }
+  pthread_mutex_unlock(&input_fifo_publication_mutex);
+}
+static int input_fifo_publication_publish(const struct input_source *source,
+    const struct input_fifo_identity *identity,uint64_t *generation)
+{
+  struct input_fifo_publication next={0};int ret=-1;
+  if(generation)*generation=0;
+  if(!source || !identity || !source->open || source->type!=INPUT_TYPE_PIPE || !source->item_id
+      || !source->path || !identity->device || !identity->inode
+      || strnlen(source->path,sizeof(next.path))>=sizeof(next.path))return -1;
+  next.device=identity->device;next.inode=identity->inode;next.epoch=identity->epoch;
+  next.item_id=source->item_id;memcpy(next.path,source->path,strlen(source->path)+1);
+  pthread_mutex_lock(&input_fifo_publication_mutex);
+  bool same=input_fifo_publication.valid && input_fifo_publication.device==next.device
+    && input_fifo_publication.inode==next.inode && input_fifo_publication.epoch==next.epoch
+    && input_fifo_publication.item_id==next.item_id && !strcmp(input_fifo_publication.path,next.path);
+  if(!input_fifo_publication_exhausted && (same || input_fifo_publication_advance())){
+    next.generation=input_fifo_publication.generation;next.valid=true;input_fifo_publication=next;
+    if(generation)*generation=next.generation;ret=0;
+  }
+  pthread_mutex_unlock(&input_fifo_publication_mutex);
+  return ret;
+}
+int input_fifo_reader_snapshot(struct input_fifo_publication *out)
+{
+  if(!out)return -1;
+  pthread_mutex_lock(&input_fifo_publication_mutex);
+  *out=input_fifo_publication;
+  pthread_mutex_unlock(&input_fifo_publication_mutex);
+  return out->valid?0:-1;
+}
+bool input_fifo_reader_snapshot_current(const struct input_fifo_publication *expected)
+{
+  if(!expected || !expected->valid || !expected->generation
+      || !memchr(expected->path,0,sizeof(expected->path)))return false;
+  pthread_mutex_lock(&input_fifo_publication_mutex);
+  bool current=input_fifo_publication.valid && expected->generation==input_fifo_publication.generation
+    && expected->device==input_fifo_publication.device && expected->inode==input_fifo_publication.inode
+    && expected->epoch==input_fifo_publication.epoch && expected->item_id==input_fifo_publication.item_id
+    && !strcmp(expected->path,input_fifo_publication.path);
+  pthread_mutex_unlock(&input_fifo_publication_mutex);
+  return current;
+}
