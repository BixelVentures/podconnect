+/* Distinct real no-Spotify source variant. No invented account/session/writer.
+ * Uses the same length-prefixed field codec as sourceful tickets but separate
+ * versioned domains; signatures cannot cross source kinds or proof purposes. */
+#include "radio_absence.h"
+static int radio_absence_counter(gcry_md_hd_t h,uint64_t value)
+{
+  char decimal[21];if(value==UINT64_MAX)return -1;
+  snprintf(decimal,sizeof(decimal),"%" PRIu64,value);return radio_ticket_text(h,decimal,sizeof(decimal));
+}
+static int radio_absence_ticket_core(const unsigned char key[32],const struct output_radio_absence_request *r,
+    const struct radio_drain_identity *d,char out[65],int purpose)
+{
+  static const char *domains[]={"podconnect.radio-absence-suspended.v1","podconnect.radio-absence-challenge.v1","podconnect.radio-absence-drain.v2"};
+  static const char schema[]="podconnect.output_radio_absence.v1",provenance[]="stored_manual_base",hex[]="0123456789abcdef";
+  gcry_md_hd_t h;const unsigned char *digest;unsigned char present=0;size_t i;int ret=-1;
+  if(!key || !r || !out || purpose<0 || purpose>2)return -1;
+  for(i=0;i<32;i++)present|=key[i];
+  if(!present || !r->identity.device_id || !r->identity.device_incarnation || !r->source.native_process.pid
+      || !r->source.native_process.proc_start_ticks || !r->source.pipe_inode || !r->generation || !r->native_revision || !r->radio_owner_epoch
+      || r->source.input_path[0]!='/' || !radio_ticket_hex(r->source.input_path_digest,64)
+      || !radio_ticket_hex(r->source.registry_digest,64) || !radio_ticket_hex(r->receiver_key_digest,64) || !radio_ticket_hex(r->token,32))return -1;
+  if(purpose && (!d || !radio_ticket_hex(d->reacquire_challenge,32) || !d->drain_generation
+      || strcmp(d->radio_process,r->radio_process) || d->radio_owner_epoch!=r->radio_owner_epoch
+      || strcmp(d->receiver_key_digest,r->receiver_key_digest)))return -1;
+  if(gcry_md_open(&h,GCRY_MD_SHA256,GCRY_MD_FLAG_HMAC))return -1;
+  if(gcry_md_setkey(h,key,32))goto done;
+  gcry_md_write(h,domains[purpose],strlen(domains[purpose])+1);
+  if(radio_ticket_text(h,schema,sizeof(schema))<0 || radio_ticket_text(h,provenance,sizeof(provenance))<0)goto done;
+#define AT(obj,field) do{if(radio_ticket_text(h,(obj)->field,sizeof((obj)->field))<0)goto done;}while(0)
+#define AN(obj,field) do{if(radio_absence_counter(h,(obj)->field)<0)goto done;}while(0)
+  AT(&r->source.native_process,boot_id);AN(&r->source.native_process,pid);AN(&r->source.native_process,proc_start_ticks);
+  AT(&r->source,registry_digest);AT(&r->source,input_path);AT(&r->source,input_path_digest);AN(&r->source,pipe_device);AN(&r->source,pipe_inode);
+  if(radio_ticket_text(h,r->source.target_absence?"target":"global",7)<0)goto done;
+  if(r->source.target_absence){
+    if(!r->source.input_generation || !r->source.input_item_id || !r->source.input_epoch
+        || !r->source.route_count || r->source.route_count>16)goto done;
+    AN(&r->source,writer_fd);AN(&r->source,input_generation);AN(&r->source,input_item_id);AN(&r->source,input_epoch);AN(&r->source,route_count);
+    for(size_t route=0;route<r->source.route_count;route++){
+      const struct output_transport_identity *identity=&r->source.routes[route].identity;
+      if(!identity->device_id || identity->device_id==r->identity.device_id
+          || (route && r->source.routes[route-1].identity.device_id>=identity->device_id)
+          || !radio_ticket_hex(r->source.routes[route].receiver_key_digest,64)
+          || !strcmp(r->source.routes[route].receiver_key_digest,r->receiver_key_digest))goto done;
+      AT(identity,process);AT(identity,input_path_digest);AN(identity,device_id);AN(identity,device_incarnation);AN(identity,session_epoch);
+      AN(identity,route_revision);AN(identity,selection_revision);AN(identity,input_generation);AN(identity,input_item_id);
+      if(radio_ticket_text(h,r->source.routes[route].receiver_key_digest,65)<0)goto done;
+    }
+  }else if(r->source.route_count || r->source.writer_fd || r->source.input_generation || r->source.input_item_id || r->source.input_epoch)goto done;
+  AT(&r->identity,process);AN(&r->identity,device_id);AN(&r->identity,device_incarnation);AN(&r->identity,session_epoch);
+  AN(&r->identity,route_revision);AN(&r->identity,base_revision);AN(&r->identity,attention_revision);
+  AT(r,handoff_id);AT(r,token);AT(r,sender_peer);AT(r,radio_process);AT(r,receiver_key_digest);
+  AN(r,generation);AN(r,native_revision);AN(r,radio_owner_epoch);
+  if(radio_ticket_percent(h,r->initial_volume_percent)<0)goto done;
+  if(purpose){AT(d,radio_process);AN(d,radio_owner_epoch);AT(d,receiver_key_digest);AN(d,drain_generation);AT(d,reacquire_challenge);}
+  if(purpose==2 && radio_ticket_final_volume(h,d)<0)goto done;
+#undef AT
+#undef AN
+  digest=gcry_md_read(h,GCRY_MD_SHA256);if(!digest)goto done;
+  for(i=0;i<32;i++){out[i*2]=hex[digest[i]>>4];out[i*2+1]=hex[digest[i]&15];}out[64]=0;ret=0;
+ done:gcry_md_close(h);return ret;
+}
+static int radio_absence_signature_equal(const char *expected,const char *actual)
+{
+  unsigned char diff=0;size_t i;if(!radio_ticket_hex(actual,64))return -1;
+  for(i=0;i<64;i++)diff|=(unsigned char)(expected[i]^actual[i]);return diff?-1:0;
+}
+int radio_absence_sign(const unsigned char key[32],const struct output_radio_absence_request *r,char out[65])
+{return radio_absence_ticket_core(key,r,NULL,out,0);}
+int radio_absence_verify(const unsigned char key[32],const struct output_radio_absence_request *r,const char *signature)
+{
+  char expected[65];int ret=radio_absence_sign(key,r,expected);if(!ret)ret=radio_absence_signature_equal(expected,signature);memset(expected,0,sizeof(expected));return ret;
+}
+int radio_absence_challenge_sign(const unsigned char key[32],const struct output_radio_absence_request *r,const char nonce[33],char out[65])
+{
+  struct radio_drain_identity d={0};if(!r || !radio_ticket_hex(nonce,32))return -1;
+  snprintf(d.radio_process,sizeof(d.radio_process),"%s",r->radio_process);d.radio_owner_epoch=r->radio_owner_epoch;d.drain_generation=r->generation;
+  snprintf(d.receiver_key_digest,sizeof(d.receiver_key_digest),"%s",r->receiver_key_digest);snprintf(d.reacquire_challenge,sizeof(d.reacquire_challenge),"%s",nonce);
+  return radio_absence_ticket_core(key,r,&d,out,1);
+}
+int radio_absence_challenge_verify(const unsigned char key[32],const struct output_radio_absence_request *r,const char nonce[33],const char *signature)
+{
+  char expected[65];int ret=radio_absence_challenge_sign(key,r,nonce,expected);if(!ret)ret=radio_absence_signature_equal(expected,signature);memset(expected,0,sizeof(expected));return ret;
+}
+int radio_absence_drain_sign(const unsigned char key[32],const struct output_radio_absence_request *r,const struct radio_drain_identity *d,char out[65])
+{return radio_absence_ticket_core(key,r,d,out,2);}
+int radio_absence_drain_verify(const unsigned char key[32],const struct output_radio_absence_request *r,const struct radio_drain_identity *d,const char *signature)
+{
+  char expected[65];int ret=radio_absence_drain_sign(key,r,d,expected);if(!ret)ret=radio_absence_signature_equal(expected,signature);memset(expected,0,sizeof(expected));return ret;
+}
