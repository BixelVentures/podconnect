+static int radio_http_seed_peer(uint64_t id,int percent,const char *name,const char *receiver_id)
+{
+  struct output_device d={.id=id,.name=(char *)name,.volume=percent};
+  unsigned char public_key[32],private_key[64],receiver[32];char saved[193];
+  if(radio_wire_sourceful_registered_key(public_key,private_key)<0)return -1;
+  pair_public_key_get(PAIR_SERVER_HOMEKIT,receiver,receiver_id);
+  for(size_t i=0;i<64;i++)sprintf(saved+i*2,"%02x",private_key[i]);
+  for(size_t i=0;i<32;i++)sprintf(saved+128+i*2,"%02x",receiver[i]);saved[192]=0;d.auth_key=saved;
+  int ret=db_speaker_save(&d);if(!ret)ret=db_attention_base_save(id,percent);
+  sodium_memzero(private_key,sizeof(private_key));sodium_memzero(saved,sizeof(saved));return ret;
+}
