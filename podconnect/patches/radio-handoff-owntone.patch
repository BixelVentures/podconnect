+/* A distinct physical receiver needs its own durable, source-bound grant.
+ * The original radio hold is evidence only and is never consumed or edited. */
+#define RADIO_OTHER_KEY "podconnect.radio_other_target.v1"
+#define RADIO_OTHER_SLOTS 16
+struct radio_other_slot {
+  struct output_radio_other_target_result result;
+  const void *session;
+  uint64_t pcm_reader_generation; /* Runtime only; never restored. */
+  bool used,terminal;
+};
+static struct radio_other_slot radio_other_slots[RADIO_OTHER_SLOTS];
+static char *radio_other_expected;
+static bool radio_other_fault;
+static uint64_t radio_other_scope;
+static struct radio_other_slot *radio_other_find(uint64_t id)
+{
+  for(size_t i=0;i<ARRAY_SIZE(radio_other_slots);i++)
+    if(radio_other_slots[i].used && radio_other_slots[i].result.route_identity.device_id==id)return &radio_other_slots[i];
+  return NULL;
+}
+static int radio_other_save(void)
+{
+  json_object *root=json_object_new_object(),*rows=json_object_new_array(),*terminal=json_object_new_array();
+  static const char hex[]="0123456789abcdef";
