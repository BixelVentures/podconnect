+#include "../src/radio_absence_ticket.inc.c"
+#include "../src/radio_parked_absence_ticket.inc.c"
+/* The whole immutable sourceful parent is MAC-bound, including literal zeros.
+ * These are tuple/domain tests, never evidence of a native source producer. */
+static void parked_parent_zero_codec(const unsigned char key[32],const struct output_radio_parked_absence_request *base,const struct radio_drain_identity *d)
+{
+ const unsigned masks[]={1,2,4,8,15};
+ for(size_t test=0;test<sizeof(masks)/sizeof(masks[0]);test++){
+  struct output_radio_parked_absence_request r=*base,changed;
+  uint64_t *fields[]={&r.source_hold.native_owner.alias_revision,&r.source_hold.writer.writer_fd,&r.source_hold.identity.route_revision,&r.source_hold.identity.selection_revision};
+  char suspended[65],challenge[65],drain[65],again[65];
+  for(size_t field=0;field<4;field++)if(masks[test]&(1u<<field))*fields[field]=0;
+  assert(radio_parked_absence_sign(key,&r,suspended)==0&&radio_parked_absence_verify(key,&r,suspended)==0);
+  assert(radio_parked_absence_sign(key,&r,again)==0&&!strcmp(suspended,again));
+  assert(radio_parked_absence_challenge_sign(key,&r,d->reacquire_challenge,challenge)==0&&radio_parked_absence_challenge_verify(key,&r,d->reacquire_challenge,challenge)==0);
+  assert(radio_parked_absence_challenge_sign(key,&r,d->reacquire_challenge,again)==0&&!strcmp(challenge,again));
+  assert(radio_parked_absence_drain_sign(key,&r,d,drain)==0&&radio_parked_absence_drain_verify(key,&r,d,drain)==0);
+  assert(radio_parked_absence_drain_sign(key,&r,d,again)==0&&!strcmp(drain,again));
+  for(size_t field=0;field<4;field++)if(masks[test]&(1u<<field)){
+   changed=r;uint64_t *mutations[]={&changed.source_hold.native_owner.alias_revision,&changed.source_hold.writer.writer_fd,&changed.source_hold.identity.route_revision,&changed.source_hold.identity.selection_revision};*mutations[field]=1;
+   assert(radio_parked_absence_verify(key,&changed,suspended)<0);
+   assert(radio_parked_absence_challenge_verify(key,&changed,d->reacquire_challenge,challenge)<0);
+   assert(radio_parked_absence_drain_verify(key,&changed,d,drain)<0);
