+}
+static int radio_auth_preflight(const struct radio_auth_target *target,uint64_t generation,struct radio_auth_witness *out)
+{
+  struct radio_auth_job job={0};int ret=-1;struct timeval timeout={5,0};
+  RADIO_AUTH_TEST_MARK(&job,reason,1);RADIO_AUTH_TEST_MARK(&job,cseq,-1);
+  memset(out,0,sizeof(*out));
+  if(!target || !generation || !target->device_id || !target->device_incarnation || !target->port
+      || strnlen(target->credential,sizeof(target->credential))!=192 || strnlen(target->controller_id,17)!=16
+      || strnlen(target->receiver_key_digest,65)!=64 || !target->address[0])return -1;
+  if(clock_gettime(CLOCK_MONOTONIC,&job.deadline)<0)return -1;job.deadline.tv_sec+=5;
+#ifdef RADIO_AUTH_PREFLIGHT_TEST_TIME
+  job.observed_generation=generation;
+  /* Reuse the actual admission clock sample; never renew its deadline. */
+  RADIO_AUTH_PREFLIGHT_TEST_TIME(generation,0,(int64_t)job.deadline.tv_sec-5,job.deadline.tv_nsec,
+    (int64_t)job.deadline.tv_sec,job.deadline.tv_nsec);
+#endif
+  job.base=event_base_new();if(!job.base)goto done;
+  job.connection=evrtsp_connection_new(target->address,target->port);if(!job.connection)goto done;
+  evrtsp_connection_set_base(job.connection,job.base);
+  job.verify=pair_verify_new(PAIR_CLIENT_HOMEKIT_NORMAL,target->credential,NULL,NULL,target->controller_id);if(!job.verify)goto done;
+  job.timeout=evtimer_new(job.base,radio_auth_timeout,&job);if(!job.timeout || evtimer_add(job.timeout,&timeout)<0)goto done;
+  job.stage=1;if(radio_auth_send(&job)<0){RADIO_AUTH_TEST_MARK(&job,reason,7);goto done;}
+  event_base_dispatch(job.base);
+  if(job.verified && radio_auth_before_deadline(&job))ret=0;
+#ifdef RADIO_AUTH_PREFLIGHT_TEST_OBSERVER
+  else if(job.verified){RADIO_AUTH_TEST_MARK(&job,reason,20);}
+#endif
+ done:
+#ifdef RADIO_AUTH_PREFLIGHT_TEST_TIME
+  radio_auth_test_time(&job,2);
+#endif
+  /* No witness exists until the actual probe connection and all its requests
+   * are closed. Delayed work cannot create an audio/session effect. */
+  if(job.connection)evrtsp_connection_free(job.connection);
+  if(job.timeout)event_free(job.timeout);
+  if(job.verify)pair_verify_free(job.verify);
+  if(job.base)event_base_free(job.base);
+  if(!ret && (radio_auth_target_digest(target,out->descriptor_digest)<0 || radio_auth_target_physical_digest(target,out->physical_digest)<0)){ret=-1;RADIO_AUTH_TEST_MARK(&job,reason,21);}
+  if(!ret){
+    out->device_id=target->device_id;out->device_incarnation=target->device_incarnation;out->route_revision=target->route_revision;out->source_generation=generation;
+    snprintf(out->controller_id,sizeof(out->controller_id),"%s",target->controller_id);
+    snprintf(out->receiver_key_digest,sizeof(out->receiver_key_digest),"%s",target->receiver_key_digest);
+#ifdef RADIO_AUTH_PREFLIGHT_TEST_OBSERVER
+    if(clock_gettime(CLOCK_REALTIME,&out->observed)<0 || clock_gettime(CLOCK_MONOTONIC,&out->deadline)<0){ret=-1;RADIO_AUTH_TEST_MARK(&job,reason,22);}
+    else{out->deadline.tv_sec+=5;out->authenticated=true;out->ttl_seconds=5;}
+#else
+    if(clock_gettime(CLOCK_REALTIME,&out->observed)<0 || clock_gettime(CLOCK_MONOTONIC,&out->deadline)<0)return -1;out->deadline.tv_sec+=5;out->authenticated=true;out->ttl_seconds=5;
+#endif
+  }
+#ifdef RADIO_AUTH_PREFLIGHT_TEST_OBSERVER
+  /* Safe numeric diagnostics only, after all actual probe resources closed. */
+  RADIO_AUTH_PREFLIGHT_TEST_OBSERVER(generation,job.stage,job.observed_reason,job.observed_code,job.observed_cseq,job.observed_result,job.observed_cipher);
+#endif
+  return ret;
+}
+#undef RADIO_AUTH_TEST_MARK
