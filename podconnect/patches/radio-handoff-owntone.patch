+  fd=openat(dirfd,basename,O_WRONLY|O_CREAT|O_EXCL|O_NOFOLLOW|O_CLOEXEC,0600);
+  if(fd<0){
+    if(errno!=EEXIST)goto done;
+    /* Restart verification is read-only. Never replace a stage or silently
+     * change any credential, controller or scoped receiver. Existing metadata
+     * remains unchanged; current source metadata is not pairing authority. */
+    fd=openat(dirfd,basename,O_RDONLY|O_NOFOLLOW|O_CLOEXEC);
+    struct stat prior;char *prior_bytes=NULL;size_t prior_got=0;
+    if(fd<0 || fstat(fd,&prior)<0 || !S_ISREG(prior.st_mode) || prior.st_nlink!=1
+        || prior.st_uid!=geteuid() || (prior.st_mode&0777)!=0600 || prior.st_size<=0 || prior.st_size>65536)goto done;
