--- /dev/null
+++ b/src/radio_pairing_format.h
@@ -0,0 +1,31 @@
+#ifndef RADIO_PAIRING_FORMAT_H
+#define RADIO_PAIRING_FORMAT_H
+#include <errno.h>
+#include <stdint.h>
+#include <stdbool.h>
+#include <stdlib.h>
+#include <string.h>
+static int radio_pairing_id(const char *text,uint64_t *id)
+{
+  char *end;size_t i,n=text?strlen(text):0;unsigned long long value;
+  if(!n || n>20 || (n>1 && text[0]=='0'))return -1;
+  for(i=0;i<n;i++)if(text[i]<'0' || text[i]>'9')return -1;
+  errno=0;value=strtoull(text,&end,10);if(errno || *end || !value)return -1;*id=(uint64_t)value;return 0;
+}
+static int radio_pairing_controller(const char *text)
+{
+  size_t i;bool nonzero=false;if(!text || strlen(text)!=16)return -1;
+  for(i=0;i<16;i++){if(!((text[i]>='0'&&text[i]<='9')||(text[i]>='A'&&text[i]<='F')))return -1;if(text[i]!='0')nonzero=true;}
+  return nonzero?0:-1;
+}
+static int radio_pairing_key(const char *key)
+{
+  size_t i;unsigned char remote=0;
+  if(!key || strlen(key)!=192)return -1;
+  for(i=0;i<192;i++){
+    char c=key[i];if(!((c>='0'&&c<='9')||(c>='a'&&c<='f')||(c>='A'&&c<='F')))return -1;
+    if(i>=128 && c!='0')remote=1;
+  }
+  return remote?0:-1;
+}
+#endif
