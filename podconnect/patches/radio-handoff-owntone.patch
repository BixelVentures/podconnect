+      || evrtsp_add_header(request->output_headers,"Content-Type","application/octet-stream")<0
+      || evrtsp_add_header(request->output_headers,"X-Apple-HKP","3")<0
+      || evbuffer_add(request->output_buffer,bytes,length)<0)goto done;
+  ret=evrtsp_make_request_guarded(job->connection,request,EVRTSP_REQ_POST,"/pair-verify",radio_auth_dispatch_current,job);
+  if(ret>=0)request=NULL;
