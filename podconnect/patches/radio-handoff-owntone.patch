+int outputs_radio_source_move(int action,const struct output_radio_source_move_request *r,struct output_radio_source_move_result *out)
+{
+ struct radio_source_move_slot *s;struct output_radio_other_target_request inner={0};struct output_radio_other_target_result receiver;struct output_radio_source_move_observation observed={0};
