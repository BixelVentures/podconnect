+{return a->pid==b->pid&&a->proc_start_ticks==b->proc_start_ticks&&!strcmp(a->boot_id,b->boot_id);}
+static struct re_batch *re_find(const struct output_radio_absence_request *h,size_t *member)
+{
+ for(size_t i=0;i<RE_LIMIT;i++)if(re_batches[i].active)for(size_t j=0;j<re_batches[i].count;j++)
+  if(radio_absence_equal(h,&re_batches[i].members[j].hold,true)){if(member)*member=j;return &re_batches[i];}
+ return NULL;
+}
