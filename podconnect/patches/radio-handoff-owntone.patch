+static bool radio_sender_binding_equal(const struct radio_sender_binding *a,const struct radio_sender_binding *b,bool token)
+{
+  if(a->source_absent!=b->source_absent || a->source_parked!=b->source_parked)return false;
+  if(a->source_absent && a->source_parked)return false;
+  if(a->source_parked){
