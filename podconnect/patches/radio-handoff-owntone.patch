+}
+static bool radio_other_source_current(const struct output_transport_identity *source)
+{
+  return !strcmp(source->process,outputs_process) && source->input_generation==transport_input_generation
+    && source->input_item_id==transport_input_item && source->input_item_id
+    && !strcmp(source->input_path_digest,transport_input_path_digest);
+}
+static bool radio_other_intent_equal(const struct output_radio_other_target_request *a,const struct output_radio_other_target_request *b)
+{return radio_handoff_equal(&a->hold,&b->hold,true) && native_owner_equal(&a->current_native_owner,&b->current_native_owner) && native_owner_equal(&a->intended_native_owner,&b->intended_native_owner)
+  && a->native_revision==b->native_revision && !strcmp(a->intent_id,b->intent_id);}
+void outputs_radio_other_session_created(uint64_t id,uint64_t inc,uint64_t epoch,const void *session)
+{
+  struct radio_other_slot *s=radio_other_find(id);
+  if(!s || !outputs_radio_other_constructor_current(id) || s->result.phase!=OUTPUT_RADIO_OTHER_CONNECTING)return;
