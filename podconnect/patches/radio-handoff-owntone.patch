+    struct radio_wire_fixture *peers[2]={f,m->second};assert(fputs(",\"targets\":[",stream)>=0);
+    for(size_t i=0;i<2;i++){
+      struct radio_wire_fixture *peer=peers[i];
+      assert(fprintf(stream,"%s{\"device_id\":\"%" PRIu64 "\",\"audio_packets\":%d,\"packets\":%d,\"verifies\":%d,\"teardowns\":%d,\"selected\":%s,\"session_present\":%s",i?",":"",peer->device?peer->device->id:m->second_id,peer->audio_packets,peer->packets,peer->verifies,peer->teardowns,peer->device&&peer->device->selected?"true":"false",peer->device&&peer->device->session?"true":"false")>0);
+      if(m->delayed_discovery)assert(fprintf(stream,",\"discovered\":%s",peer->device?"true":"false")>0);
+      assert(fputc('}',stream)!=EOF);
