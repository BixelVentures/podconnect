--- /dev/null
+++ b/src/radio_parked_absence_ticket.inc.c
@@ -0,0 +1,51 @@
+/* Versioned HMAC composition binds the entire original sourceful tuple through
+ * its canonical MAC, never raw struct bytes or mutable parent state. */
+#include "radio_parked_absence.h"
+static int radio_parked_absence_ticket(const unsigned char key[32],const struct output_radio_parked_absence_request *r,const struct radio_drain_identity *d,int purpose,char out[65])
+{
+ static const char *domains[]={"podconnect.radio-parked-absence-suspended.v1","podconnect.radio-parked-absence-challenge.v1","podconnect.radio-parked-absence-drain.v2"};
+ static const char hex[]="0123456789abcdef";char parent[65];gcry_md_hd_t h;const unsigned char *digest;int ret=-1;
+ if(!key||!r||!out||purpose<0||purpose>2||!r->identity.device_id||!r->identity.device_incarnation
+  ||r->identity.device_id==r->source_hold.identity.device_id||!r->generation||!r->native_revision||!r->radio_owner_epoch
+  ||!radio_ticket_hex(r->token,32)||!radio_ticket_hex(r->receiver_key_digest,64)
+  ||!strcmp(r->receiver_key_digest,r->source_hold.receiver_key_digest)
+  ||!r->parked_source.input_generation||!r->parked_source.input_item_id
+  ||strcmp(r->parked_source.process,r->source_hold.identity.process)
+  ||strcmp(r->parked_source.input_path_digest,r->source_hold.writer.input_path_digest)
+  ||radio_handoff_suspended_signature(key,&r->source_hold,parent)<0)return -1;
+ if(purpose&&(!d||!radio_ticket_hex(d->reacquire_challenge,32)||!d->drain_generation
+  ||strcmp(d->radio_process,r->radio_process)||d->radio_owner_epoch!=r->radio_owner_epoch||strcmp(d->receiver_key_digest,r->receiver_key_digest)))return -1;
+ if(gcry_md_open(&h,GCRY_MD_SHA256,GCRY_MD_FLAG_HMAC))return -1;
+ if(gcry_md_setkey(h,key,32))goto done;
+ gcry_md_write(h,domains[purpose],strlen(domains[purpose])+1);
+ if(radio_ticket_text(h,"podconnect.output_radio_parked_absence.v1",64)<0||radio_ticket_text(h,"stored_manual_base",32)<0||radio_ticket_text(h,parent,sizeof(parent))<0)goto done;
+#define PT(obj,field) do{if(radio_ticket_text(h,(obj)->field,sizeof((obj)->field))<0)goto done;}while(0)
+#define PN(obj,field) do{if(radio_absence_counter(h,(obj)->field)<0)goto done;}while(0)
+ PT(&r->parked_source,process);PT(&r->parked_source,input_path_digest);PN(&r->parked_source,device_id);PN(&r->parked_source,device_incarnation);PN(&r->parked_source,session_epoch);PN(&r->parked_source,route_revision);PN(&r->parked_source,selection_revision);PN(&r->parked_source,input_generation);PN(&r->parked_source,input_item_id);
+ PT(&r->identity,process);PN(&r->identity,device_id);PN(&r->identity,device_incarnation);PN(&r->identity,session_epoch);PN(&r->identity,route_revision);PN(&r->identity,base_revision);PN(&r->identity,attention_revision);
+ PT(r,handoff_id);PT(r,token);PT(r,sender_peer);PT(r,radio_process);PT(r,receiver_key_digest);PN(r,generation);PN(r,native_revision);PN(r,radio_owner_epoch);
+ if(radio_ticket_percent(h,r->initial_volume_percent)<0)goto done;
+ if(purpose){PT(d,radio_process);PN(d,radio_owner_epoch);PT(d,receiver_key_digest);PN(d,drain_generation);PT(d,reacquire_challenge);}
+ if(purpose==2&&radio_ticket_final_volume(h,d)<0)goto done;
+#undef PT
+#undef PN
+ digest=gcry_md_read(h,GCRY_MD_SHA256);if(!digest)goto done;
+ for(size_t i=0;i<32;i++){out[i*2]=hex[digest[i]>>4];out[i*2+1]=hex[digest[i]&15];}out[64]=0;ret=0;
+ done:memset(parent,0,sizeof(parent));gcry_md_close(h);return ret;
+}
+int radio_parked_absence_sign(const unsigned char k[32],const struct output_radio_parked_absence_request *r,char out[65])
+{return radio_parked_absence_ticket(k,r,NULL,0,out);}
+int radio_parked_absence_verify(const unsigned char k[32],const struct output_radio_parked_absence_request *r,const char *sig)
+{char out[65];int ret=radio_parked_absence_sign(k,r,out);if(!ret)ret=radio_absence_signature_equal(out,sig);memset(out,0,sizeof(out));return ret;}
+int radio_parked_absence_challenge_sign(const unsigned char k[32],const struct output_radio_parked_absence_request *r,const char *nonce,char out[65])
+{
+ struct radio_drain_identity d={0};if(!r||!radio_ticket_hex(nonce,32))return -1;
+ snprintf(d.radio_process,37,"%s",r->radio_process);d.radio_owner_epoch=r->radio_owner_epoch;snprintf(d.receiver_key_digest,65,"%s",r->receiver_key_digest);d.drain_generation=r->generation;snprintf(d.reacquire_challenge,33,"%s",nonce);
+ return radio_parked_absence_ticket(k,r,&d,1,out);
+}
+int radio_parked_absence_challenge_verify(const unsigned char k[32],const struct output_radio_parked_absence_request *r,const char *nonce,const char *sig)
+{char out[65];int ret=radio_parked_absence_challenge_sign(k,r,nonce,out);if(!ret)ret=radio_absence_signature_equal(out,sig);memset(out,0,sizeof(out));return ret;}
+int radio_parked_absence_drain_sign(const unsigned char k[32],const struct output_radio_parked_absence_request *r,const struct radio_drain_identity *d,char out[65])
+{return radio_parked_absence_ticket(k,r,d,2,out);}
+int radio_parked_absence_drain_verify(const unsigned char k[32],const struct output_radio_parked_absence_request *r,const struct radio_drain_identity *d,const char *sig)
+{char out[65];int ret=radio_parked_absence_drain_sign(k,r,d,out);if(!ret)ret=radio_absence_signature_equal(out,sig);memset(out,0,sizeof(out));return ret;}
