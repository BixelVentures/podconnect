+  json_object_object_add(root,"schema",json_object_new_string(RADIO_OTHER_KEY));
+  json_object_object_add(root,"record_size",json_object_new_int64(sizeof(struct output_radio_other_target_result)));
+  json_object_object_add(root,"records",rows);
+  json_object_object_add(root,"terminal",terminal);
+  for(size_t i=0;i<ARRAY_SIZE(radio_other_slots);i++)if(radio_other_slots[i].used){
+    const unsigned char *bytes=(const unsigned char *)&radio_other_slots[i].result;
+    char encoded[sizeof(struct output_radio_other_target_result)*2+1];
+    for(size_t j=0;j<sizeof(struct output_radio_other_target_result);j++){encoded[j*2]=hex[bytes[j]>>4];encoded[j*2+1]=hex[bytes[j]&15];}
+    encoded[sizeof(struct output_radio_other_target_result)*2]=0;
+    json_object_array_add(rows,json_object_new_string(encoded));
+    json_object_array_add(terminal,json_object_new_boolean(radio_other_slots[i].terminal));
+  }
+  const char *serialized=json_object_to_json_string_ext(root,JSON_C_TO_STRING_PLAIN);
+  char *next=strdup(serialized);int ret=next?db_radio_handoff_save_key(RADIO_OTHER_KEY,radio_other_expected,serialized):-1;
