+  size_t length;const uint8_t *bytes;struct pair_cipher_context *cipher=NULL;int ret;
+  RADIO_AUTH_TEST_MARK(job,code,request?request->response_code:0);
+  if(!request || request->response_code!=200 || !radio_auth_before_deadline(job)){
