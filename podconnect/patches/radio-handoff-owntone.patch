+/* Worker-only normal pairing verification. Two requests on a private control
+ * connection, then close. This code has no player/output/session constructor,
+ * selection, setup, record, media, teardown or pairing-enrollment operation. */
+#include "radio_auth_preflight.h"
+#include "pair_ap/pair.h"
+#include "evrtsp/evrtsp.h"
+struct radio_auth_job {
+  struct event_base *base;struct event *timeout;
+  struct evrtsp_connection *connection;struct pair_verify_context *verify;
+  struct timespec deadline;int stage;bool verified;
+#ifdef RADIO_AUTH_PREFLIGHT_TEST_TIME
+  uint64_t observed_generation;
+#endif
+#ifdef RADIO_AUTH_PREFLIGHT_TEST_OBSERVER
+  int observed_reason,observed_code,observed_cseq,observed_result,observed_cipher;
+#endif
+};
+#ifdef RADIO_AUTH_PREFLIGHT_TEST_OBSERVER
+#define RADIO_AUTH_TEST_MARK(job,field,value) ((job)->observed_##field=(value))
+#else
+#define RADIO_AUTH_TEST_MARK(job,field,value) ((void)0)
+#endif
+static bool radio_auth_before_deadline(const struct radio_auth_job *job)
+{
+  struct timespec now;if(clock_gettime(CLOCK_MONOTONIC,&now)<0)return false;
+  return now.tv_sec<job->deadline.tv_sec || (now.tv_sec==job->deadline.tv_sec && now.tv_nsec<job->deadline.tv_nsec);
