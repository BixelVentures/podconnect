+  struct radio_handoff_slot *source=radio_handoff_find(id);
+  struct radio_absence_slot *absence=radio_absence_find(id);
+  struct radio_parked_absence_slot *parked=radio_parked_absence_find(id);
+  bool source_terminal=!source||source->result.phase==OUTPUT_RADIO_RELEASED;
+  if(source&&source->result.phase==OUTPUT_RADIO_REACQUIRED){
