+ enum output_radio_parked_absence_phase phase;
+ uint64_t release_native_revision;
+ char suspended_signature[65];
+};
+struct radio_drain_identity;
+#define PARKED_CRYPTO(name) int radio_parked_absence_##name(const unsigned char [32],const struct output_radio_parked_absence_request *,char [65])
+PARKED_CRYPTO(sign);
+#undef PARKED_CRYPTO
+int radio_parked_absence_verify(const unsigned char [32],const struct output_radio_parked_absence_request *,const char *);
+int radio_parked_absence_challenge_sign(const unsigned char [32],const struct output_radio_parked_absence_request *,const char *,char [65]);
+int radio_parked_absence_challenge_verify(const unsigned char [32],const struct output_radio_parked_absence_request *,const char *,const char *);
+int radio_parked_absence_drain_sign(const unsigned char [32],const struct output_radio_parked_absence_request *,const struct radio_drain_identity *,char [65]);
+int radio_parked_absence_drain_verify(const unsigned char [32],const struct output_radio_parked_absence_request *,const struct radio_drain_identity *,const char *);
+int outputs_radio_parked_absence_observe(const struct output_radio_handoff_request *,uint64_t,struct output_radio_parked_absence_result *);
+int outputs_radio_parked_absence(int,const struct output_radio_parked_absence_request *,struct output_radio_parked_absence_result *);
+void outputs_radio_parked_absence_init(void);
+bool outputs_radio_parked_absence_blocked(uint64_t);
+uint64_t outputs_radio_parked_absence_generation(uint64_t);
+bool outputs_radio_parked_absence_effect_current(uint64_t,uint64_t);
