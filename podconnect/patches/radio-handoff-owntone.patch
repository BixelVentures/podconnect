@@ -0,0 +1,62 @@
+/* Role-only selected pairing ingestion into the already initialized FULL
+ * private OwnTone schema. No account/queue/selection/settings import. */
+#include <fcntl.h>
+#include <json-c/json.h>
+#include <gcrypt.h>
+#include "radio_pairing_format.h"
+static int db_radio_pairing_import(void)
+{
+  const char *role=getenv("PODCONNECT_RADIO_SENDER"),*path=cfg_getstr(cfg_getsec(cfg,"general"),"radio_pairing_import_path");
+  struct stat st;int fd=-1,ret=-1,status;char *bytes=NULL,*existing=NULL;size_t got=0;json_object *root=NULL,*rows=NULL,*field=NULL;
+  json_tokener *tok=NULL;sqlite3_stmt *insert=NULL,*check=NULL;unsigned char hash[32];char digest[65];size_t i,j;
+  static const char hex[]="0123456789abcdef";
+  if(!path || !*path)return 0;
+  if(!role || strcmp(role,"1"))return -1;
+  fd=open(path,O_RDONLY|O_NOFOLLOW|O_CLOEXEC);
+  if(fd<0 || fstat(fd,&st)<0 || !S_ISREG(st.st_mode) || st.st_nlink!=1 || st.st_uid!=geteuid() || (st.st_mode&0777)!=0600 || st.st_size<=0 || st.st_size>65536)goto done;
+  bytes=malloc((size_t)st.st_size+1);if(!bytes)goto done;
+  while(got<(size_t)st.st_size){ssize_t n=read(fd,bytes+got,(size_t)st.st_size-got);if(n<0 && errno==EINTR)continue;if(n<=0)goto done;got+=(size_t)n;}
+  bytes[got]=0;gcry_md_hash_buffer(GCRY_MD_SHA256,hash,bytes,got);for(i=0;i<32;i++){digest[i*2]=hex[hash[i]>>4];digest[i*2+1]=hex[hash[i]&15];}digest[64]=0;
+  int marker_found=db_radio_handoff_load_key("podconnect.radio_pairing_import.v1",&existing);
+  if(marker_found<0)goto done;
+
+  tok=json_tokener_new();if(!tok)goto done;json_tokener_set_flags(tok,JSON_TOKENER_STRICT);root=json_tokener_parse_ex(tok,bytes,(int)got);
+  if(!root || json_tokener_get_error(tok)!=json_tokener_success || json_tokener_get_parse_end(tok)!=got
+      || !json_object_is_type(root,json_type_object) || json_object_object_length(root)!=3
+      || !json_object_object_get_ex(root,"schema",&field) || !json_object_is_type(field,json_type_string) || strcmp(json_object_get_string(field),"podconnect.radio-pairing-stage.v2")
+      || !json_object_object_get_ex(root,"speakers",&rows) || !json_object_is_type(rows,json_type_array)
+      || json_object_array_length(rows)<1 || json_object_array_length(rows)>16)goto done;
+  const char *controller=cfg_getstr(cfg_getsec(cfg,"general"),"radio_controller_id");
+  if(radio_pairing_controller(controller)<0 || !json_object_object_get_ex(root,"controller_id",&field)
+      || !json_object_is_type(field,json_type_string) || json_object_get_string_len(field)!=16
+      || strcmp(controller,json_object_get_string(field)))goto done;
+  if(existing){ret=strcmp(existing,digest)?-1:0;goto done;}
+  if(sqlite3_prepare_v2(hdl,"SELECT COUNT(*) FROM speakers",-1,&check,NULL)!=SQLITE_OK || sqlite3_step(check)!=SQLITE_ROW || sqlite3_column_int64(check,0)!=0)goto done;
+  sqlite3_finalize(check);check=NULL;
+  if(attention_transaction_begin()<0)goto done;
+  if(sqlite3_prepare_v2(hdl,"INSERT INTO speakers(id,selected,volume,name,auth_key,format,offset_ms) VALUES(?1,0,?2,?3,?4,?5,?6)",-1,&insert,NULL)!=SQLITE_OK)goto rollback;
+  for(i=0;i<json_object_array_length(rows);i++){
+    json_object *row=json_object_array_get_idx(rows,i),*id=NULL,*volume=NULL,*name=NULL,*key=NULL,*format=NULL,*offset=NULL,*manual=NULL;uint64_t physical;sqlite3_int64 signed_id;
+    bool has_manual=json_object_object_get_ex(row,"stored_manual_base",&manual);
+    if(!json_object_is_type(row,json_type_object) || json_object_object_length(row)!=(has_manual?7:6)
+        || !json_object_object_get_ex(row,"id",&id) || !json_object_is_type(id,json_type_string) || radio_pairing_id(json_object_get_string(id),&physical)<0
+        || !json_object_object_get_ex(row,"volume",&volume) || !json_object_is_type(volume,json_type_int) || json_object_get_int64(volume)< -1 || json_object_get_int64(volume)>100
+        || !json_object_object_get_ex(row,"name",&name) || !json_object_is_type(name,json_type_string) || strlen(json_object_get_string(name))>255
+        || !json_object_object_get_ex(row,"auth_key",&key) || !json_object_is_type(key,json_type_string) || radio_pairing_key(json_object_get_string(key))<0 || json_object_get_string_len(key)!=192
+        || !json_object_object_get_ex(row,"format",&format) || !json_object_is_type(format,json_type_int) || json_object_get_int64(format)<0 || json_object_get_int64(format)>INT_MAX
+        || !json_object_object_get_ex(row,"offset_ms",&offset) || !json_object_is_type(offset,json_type_int) || json_object_get_int64(offset)<INT_MIN || json_object_get_int64(offset)>INT_MAX
+        || (has_manual && (!json_object_is_type(manual,json_type_int) || json_object_get_int64(manual)<0 || json_object_get_int64(manual)>100)))goto rollback;
+    for(j=0;j<i;j++){json_object *other=NULL;json_object_object_get_ex(json_object_array_get_idx(rows,j),"id",&other);if(!strcmp(json_object_get_string(other),json_object_get_string(id)))goto rollback;}
+    memcpy(&signed_id,&physical,sizeof(signed_id));sqlite3_bind_int64(insert,1,signed_id);sqlite3_bind_int64(insert,2,json_object_get_int64(volume));
+    sqlite3_bind_text(insert,3,json_object_get_string(name),-1,SQLITE_TRANSIENT);sqlite3_bind_text(insert,4,json_object_get_string(key),-1,SQLITE_TRANSIENT);
+    sqlite3_bind_int64(insert,5,json_object_get_int64(format));sqlite3_bind_int64(insert,6,json_object_get_int64(offset));
+    status=sqlite3_step(insert);if(status!=SQLITE_DONE)goto rollback;sqlite3_reset(insert);sqlite3_clear_bindings(insert);
+    if(has_manual && attention_base_write(physical,json_object_get_int(manual))<0)goto rollback;
+  }
+  sqlite3_finalize(insert);insert=NULL;
+  if(db_admin_set("podconnect.radio_pairing_import.v1",digest)<0)goto rollback;
+  ret=attention_transaction_end(0);goto done;
+ rollback:if(insert){sqlite3_finalize(insert);insert=NULL;}attention_transaction_end(-1);
+ done:if(fd>=0)close(fd);if(check)sqlite3_finalize(check);if(insert)sqlite3_finalize(insert);if(root)json_object_put(root);if(tok)json_tokener_free(tok);
+  if(bytes){memset(bytes,0,got);free(bytes);}free(existing);return ret;
+}
diff --git a/src/db_radio_speaker_save.inc.c b/src/db_radio_speaker_save.inc.c
new file mode 100644
index 0000000..a933631
--- /dev/null
+++ b/src/db_radio_speaker_save.inc.c
@@ -0,0 +1,16 @@
+/* Dedicated radio-role speaker persistence never builds a SQL string containing
+ * a copied pairing credential, including on debug/error paths. */
+static int db_radio_private_speaker_save(struct output_device *device)
+{
+  static const char sql[]="INSERT OR REPLACE INTO speakers(id,selected,volume,name,auth_key,format,offset_ms) VALUES(?1,?2,?3,?4,?5,?6,?7)";
+  sqlite3_stmt *stmt=NULL;sqlite3_int64 id;int ret=-1;
+  if(!device)return -1;memcpy(&id,&device->id,sizeof(id));
+  if(db_blocking_prepare_v2(sql,-1,&stmt,NULL)!=SQLITE_OK)return -1;
+  if(sqlite3_bind_int64(stmt,1,id)!=SQLITE_OK || sqlite3_bind_int(stmt,2,device->selected)!=SQLITE_OK
+      || sqlite3_bind_int(stmt,3,device->volume)!=SQLITE_OK
+      || sqlite3_bind_text(stmt,4,device->name,-1,SQLITE_TRANSIENT)!=SQLITE_OK
+      || sqlite3_bind_text(stmt,5,device->auth_key,-1,SQLITE_TRANSIENT)!=SQLITE_OK
+      || sqlite3_bind_int(stmt,6,device->selected_format)!=SQLITE_OK || sqlite3_bind_int(stmt,7,device->offset_ms)!=SQLITE_OK)goto done;
+  cache_daap_suspend();ret=db_blocking_step(stmt)==SQLITE_DONE?0:-1;cache_daap_resume();
+ done:sqlite3_finalize(stmt);return ret;
+}
