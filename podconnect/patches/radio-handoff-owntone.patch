+  outputs_radio_absence_current_init();
+  start_journal_startup();
+  radio_protocols_initialized=true;
+}
+bool outputs_radio_absence_protocol_available(void)
+{
+  return radio_protocols_initialized && outputs_radio_auto_resume_enabled()
+    && !radio_handoff_fault && !radio_other_fault && !radio_absence_fault
+    && !radio_move_fault && !radio_source_move_fault && !radio_parked_absence_fault
