@@ -0,0 +1,50 @@
+#ifndef PODCONNECT_RADIO_AUTH_PREFLIGHT_H
+#define PODCONNECT_RADIO_AUTH_PREFLIGHT_H
+#include <stdint.h>
+#include <stdbool.h>
+#include <time.h>
+#include <inttypes.h>
+#include <stdio.h>
+#include <string.h>
+#include <gcrypt.h>
+static inline void radio_auth_wipe(void *data,size_t size)
+{volatile unsigned char *p=data;while(size--)*p++=0;}
+/* Internal-only copied descriptor. Never serialize the credential or address. */
+struct radio_auth_target {
+  uint64_t device_id,device_incarnation,route_revision;
+  unsigned short port;
+  char address[128],controller_id[17],receiver_key_digest[65],credential[193];
+};
+struct radio_auth_witness {
+  uint64_t device_id,device_incarnation,route_revision,source_generation;
+  char controller_id[17],receiver_key_digest[65],descriptor_digest[65],physical_digest[65];
+  struct timespec observed,deadline;
+  bool authenticated;unsigned ttl_seconds;
+};
+static inline int radio_auth_target_digest(const struct radio_auth_target *target,char out[65])
+{
+  char canonical[768];unsigned char digest[32];static const char hex[]="0123456789abcdef";int n;
+  if(!target || !out || !target->device_id || !target->device_incarnation || !target->port
+      || strnlen(target->credential,193)!=192 || strnlen(target->controller_id,17)!=16
+      || strnlen(target->receiver_key_digest,65)!=64 || !target->address[0] || strnlen(target->address,128)==128)return -1;
+  n=snprintf(canonical,sizeof(canonical),"%" PRIu64 "\n%" PRIu64 "\n%" PRIu64 "\n%u\n%s\n%s\n%s\n%s",
+    target->device_id,target->device_incarnation,target->route_revision,(unsigned)target->port,target->address,target->controller_id,target->receiver_key_digest,target->credential);
+  if(n<0 || n>=(int)sizeof(canonical)){radio_auth_wipe(canonical,sizeof(canonical));return -1;}
+  gcry_md_hash_buffer(GCRY_MD_SHA256,digest,canonical,(size_t)n);radio_auth_wipe(canonical,sizeof(canonical));
+  for(size_t i=0;i<32;i++){out[i*2]=hex[digest[i]>>4];out[i*2+1]=hex[digest[i]&15];}out[64]=0;return 0;
+}
+static inline int radio_auth_target_physical_digest(const struct radio_auth_target *target,char out[65])
+{
+  if(!target)return -1;struct radio_auth_target physical=*target;physical.route_revision=0;
+  int ret=radio_auth_target_digest(&physical,out);radio_auth_wipe(physical.credential,sizeof(physical.credential));return ret;
+}
+static inline bool radio_auth_witness_fresh(const struct radio_auth_witness *w)
+{
+  struct timespec now;if(!w || !w->authenticated || !w->source_generation)return false;if(clock_gettime(CLOCK_MONOTONIC,&now)<0)return false;
+  return now.tv_sec<w->deadline.tv_sec || (now.tv_sec==w->deadline.tv_sec && now.tv_nsec<w->deadline.tv_nsec);
+}
+int outputs_airplay_radio_auth_physical_current(uint64_t,const char [65]);
+int outputs_airplay_radio_auth_descriptor_current(uint64_t,const char [65]);
+int outputs_airplay_radio_auth_physical_current(uint64_t,const char [65]);
+int outputs_airplay_radio_auth_snapshot(uint64_t,struct radio_auth_target *);
+#endif
