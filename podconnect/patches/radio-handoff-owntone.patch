+/* Private, fixed-version radio drain proof. No caller supplied drain booleans. */
+#ifndef RADIO_DRAIN_TICKET_H
+#define RADIO_DRAIN_TICKET_H
+struct output_radio_handoff_request;
+enum radio_final_volume_kind { RADIO_FINAL_VOLUME_UNKNOWN=0,RADIO_FINAL_VOLUME_ACKNOWLEDGED=1,RADIO_FINAL_VOLUME_UNCHANGED=2 };
+struct radio_drain_identity {
+  char radio_process[37];
+  uint64_t radio_owner_epoch, drain_generation;
+  enum radio_final_volume_kind final_volume_kind;int final_volume_percent;uint64_t final_volume_revision;
+  char receiver_key_digest[65], reacquire_challenge[33];
+};
+/* key is a separately configured 32-byte secret; missing/all-zero is disabled.
+ * Sign is internal to the radio sender's actual terminal drain owner. */
+static int radio_drain_ticket_sign(const unsigned char key[32],
+    const struct output_radio_handoff_request *, const struct radio_drain_identity *, char out[65]);
+static int radio_drain_ticket_verify(const unsigned char key[32],
+    const struct output_radio_handoff_request *, const struct radio_drain_identity *, const char signature[65]);
+#endif
diff --git a/src/radio_drain_ticket.inc.c b/src/radio_drain_ticket.inc.c
