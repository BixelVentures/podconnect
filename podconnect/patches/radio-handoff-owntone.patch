+}
+static int radio_http_uid(void)
+{
+  const char *name=cfg_getstr(cfg_getsec(cfg,"general"),"uid");
+  struct passwd *pw=name?getpwnam(name):NULL;
+  if(!pw)return -1;
+  if(geteuid()==pw->pw_uid)return getegid()==pw->pw_gid?0:-1;
+  if(geteuid()!=0 || initgroups(name,pw->pw_gid)<0 || setgid(pw->pw_gid)<0 || setuid(pw->pw_uid)<0)return -1;
+  return geteuid()==pw->pw_uid && getegid()==pw->pw_gid?0:-1;
