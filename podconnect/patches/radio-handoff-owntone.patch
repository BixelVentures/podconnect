index 0000000..90fc290
--- /dev/null
+++ b/src/radio_source_preflight.inc.c
@@ -0,0 +1,10 @@
+/* Actual decoder probe shared by production's worker and its offline fixture.
+ * No source/output queue, no receiver connection and no PCM emission. */
+static int radio_source_decode_preflight(const char *path,bool http)
+{
+  struct transcode_decode_setup_args dec={.profile=XCODE_PCM_NATIVE,.path=path,.is_http=http};
+  struct transcode_encode_setup_args enc={.profile=XCODE_PCM_NATIVE};
+  struct transcode_ctx *decoder=transcode_setup(dec,enc);struct evbuffer *pcm=evbuffer_new();int ret=-1;
+  if(decoder && pcm && transcode(pcm,NULL,decoder,1)>0 && evbuffer_get_length(pcm)>=4)ret=0;
+  if(decoder)transcode_cleanup(&decoder);if(pcm)evbuffer_free(pcm);return ret;
+}
