+  json_object_object_add(row, "route", json_object_new_int(-1));
+  assert(!db_radio_handoff_save_key(key, raw, json_object_to_json_string_ext(row, JSON_C_TO_STRING_PLAIN)));
+  json_object_put(row);
+  free(raw);
+  assert(!outputs_primary_radio_custody_available(2));
+  puts("PASS malformed release row leaves primary-radio custody closed");
+#endif
+  outputs_device_remove(radio.device);
+  evconnlistener_free(radio.listener);
+  evbuffer_free(radio.plain);
+  close(radio.udp_fd);
+  db_perthread_deinit();
+  db_deinit();
+  cfg_free(cfg);
+  event_base_free(base);
+  return 0;
 }
 
