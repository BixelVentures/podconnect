+static int
+airplay_primary_radio_decode(const struct airplay_primary_radio_route *route, const char *station)
+{
+  struct airplay_session *session = airplay_primary_radio_session(route);
+  const char *url = outputs_radio_station_url(station);
+  if (!url || !primary_radio_live(session) || session->primary_radio_decoder)
+    return -1;
+  struct primary_radio_decode *decoder = primary_radio_decoder_create(url);
+  if (!decoder)
+    return -1;
+  decoder->session = session;
+  decoder->route = *route;
+  session->primary_radio_decoder = decoder;
+  return 0;
+}
+
+static bool
+primary_radio_station_request_valid(const struct output_primary_radio_start_request *request)
+{
+  if (!request || strnlen(request->process, sizeof(request->process)) != 36
+      || strnlen(request->action, sizeof(request->action)) != 36
+      || strnlen(request->station, sizeof(request->station)) >= sizeof(request->station))
+    return false;
+  for (size_t i = 0; i < 36; i++)
+    if ((i == 8 || i == 13 || i == 18 || i == 23) ? request->action[i] != '-'
+        : !strchr("0123456789abcdef", request->action[i]))
+      return false;
+  return outputs_radio_station_url(request->station) != NULL;
+}
+
+static struct primary_radio_station_operation *
+primary_radio_station_find(const struct output_primary_radio_start_request *request)
+{
+  for (size_t i = 0; i < ARRAY_SIZE(primary_radio_station_operations); i++)
+    {
+      struct primary_radio_station_operation *operation = &primary_radio_station_operations[i];
+      if (!strcmp(operation->request.action, request->action))
+        return operation;
+    }
+  return NULL;
+}
+
+int
+outputs_airplay_primary_station_result(const struct output_primary_radio_start_request *request,
+    struct output_primary_radio_start_result *out)
+{
+  if (!out || !primary_radio_station_request_valid(request))
+    return -1;
+  struct primary_radio_station_operation *operation = primary_radio_station_find(request);
+  if (!operation || !primary_radio_station_same_target(&operation->request, request)
+      || strcmp(operation->request.station, request->station))
+    return -1;
+  *out = operation->result;
+  if (out->phase == OUTPUT_PRIMARY_RADIO_START_OBSERVED
+      && (!operation->decoder || !primary_radio_live(operation->decoder->session)))
+    *out = (struct output_primary_radio_start_result) { .phase = OUTPUT_PRIMARY_RADIO_START_UNKNOWN };
+  return 0;
+}
+
+int
+outputs_airplay_primary_station_start(const struct output_primary_radio_start_request *request,
+    struct output_primary_radio_start_result *out)
+{
+  if (!out || !primary_radio_station_request_valid(request))
+    return -1;
+  if (primary_radio_station_find(request))
+    return outputs_airplay_primary_station_result(request, out);
+
+  struct output_primary_radio_start_request current;
+  if (outputs_airplay_primary_station_target(request->device_id, &current) < 0
+      || !primary_radio_station_same_target(request, &current))
+    return -1;
+
+  struct primary_radio_station_operation *slot = NULL;
+  for (size_t i = 0; i < ARRAY_SIZE(primary_radio_station_operations); i++)
+    {
+      struct primary_radio_station_operation *operation = &primary_radio_station_operations[i];
+      if (operation->decoder)
+        return -1;
+      if (!slot && !operation->request.action[0])
+        slot = operation;
+    }
+  for (struct airplay_session *session = airplay_sessions; session; session = session->next)
+    if (session->primary_radio)
+      return -1;
+  if (!slot || clock_gettime(CLOCK_MONOTONIC, &slot->deadline))
+    return -1;
+  slot->deadline.tv_sec += PRIMARY_RADIO_START_SECONDS;
+  slot->request = *request;
+  slot->decoder = primary_radio_decoder_create(outputs_radio_station_url(request->station));
+  if (!slot->decoder)
+    primary_radio_station_finish(slot, OUTPUT_PRIMARY_RADIO_START_REJECTED);
+  else
+    {
+      slot->decoder->operation = slot;
+      primary_radio_station_finish(slot, OUTPUT_PRIMARY_RADIO_START_PENDING);
+    }
+  *out = slot->result;
+  return 0;
+}
+
+int
+outputs_airplay_primary_station_cancel(const struct output_primary_radio_start_request *request,
+    struct output_primary_radio_start_result *out)
+{
+  if (outputs_airplay_primary_station_result(request, out) < 0)
+    return -1;
+  struct primary_radio_station_operation *operation = primary_radio_station_find(request);
+  if (operation->decoder && (operation->result.phase == OUTPUT_PRIMARY_RADIO_START_PENDING
+      || operation->result.phase == OUTPUT_PRIMARY_RADIO_START_OBSERVED))
+    primary_radio_station_abort(operation->decoder);
+  *out = operation->result;
+  return 0;
 }
 
