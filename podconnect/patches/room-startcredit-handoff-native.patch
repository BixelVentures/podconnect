@@ -0,0 +1,28 @@
+package daemon
+
+import (
+	"testing"
+
+	"github.com/devgianlu/go-librespot/dealer"
+	"google.golang.org/protobuf/proto"
+)
+
+func TestNormalPhoneAliasNoopKeepsRevisionButRealABAAdvances(t *testing.T) {
+	p, _ := localAliasPlayer(t)
+	p.app.cfg.DeviceAliases = []string{"Room A", "Room B"}
+	p.app.cfg.DeviceAliasRoomIDs = []string{"r0", "r1"}
+	p.initAliasRegistry()
+	p.state.device.SelectedAliasId = 1
+	initial := p.aliasRevision
+	for _, alias := range []uint32{0, 1} {
+		p.commitPlayerCommand(dealer.RequestPayload{TargetAliasId: proto.Uint32(alias)})
+		if p.aliasRevision != initial {
+			t.Fatal("resolved current alias advanced owner revision")
+		}
+	}
+	p.commitPlayerCommand(dealer.RequestPayload{TargetAliasId: proto.Uint32(2)})
+	p.commitPlayerCommand(dealer.RequestPayload{TargetAliasId: proto.Uint32(1)})
+	if p.aliasRevision != initial+2 || p.state.device.SelectedAliasId != 1 {
+		t.Fatal("real alias ABA did not advance revision twice")
+	}
+}
diff --git a/daemon/room_completed_writer.go b/daemon/room_completed_writer.go
new file mode 100644
--- /dev/null
+++ b/daemon/room_completed_writer.go
@@ -0,0 +1,116 @@
+package daemon
+
+import (
+	"context"
+
+	"github.com/devgianlu/go-librespot/output"
+)
+
+// A completed C source may continue with a new phone connection or playback
+// session only on this same App, Player and live FIFO writer. The two changing
+// owner fields are intentionally excluded only at this completed-source gate.
+type completedWriter struct {
+	start  *contentOperation
+	move   *moveOperation
+	writer output.MovePipeIdentity
+	epoch  string
+}
+
+func sameCompletedRoom(a, b roomTransportIdentity) bool {
+	return a.AccountUserID == b.AccountUserID && a.TargetID == b.TargetID &&
+		a.RoomID == b.RoomID && a.HomePodID == b.HomePodID &&
+		a.AliasIncarnation == b.AliasIncarnation && a.AliasRegistry == b.AliasRegistry &&
+		a.AliasRevision == b.AliasRevision
+}
+
+func (app *App) completedWriterCurrent(owner *AppPlayer, identity roomTransportIdentity) (*completedWriter, error) {
+	app.moveCustodyMu.Lock()
+	defer app.moveCustodyMu.Unlock()
+	if app.moveCustodyUnknown || app.retirementPending != nil {
+		return nil, ErrAliasConflict
+	}
+	if app.startCustody == nil && app.moveCustody == nil {
+		return nil, nil
+	}
+	if owner == nil || owner.player == nil || owner.sess == nil ||
+		app.startCustody != nil && app.moveCustody != nil {
+		return nil, ErrAliasConflict
+	}
+	var current completedWriter
+	var actual *roomTransportIdentity
+	var process contentProcess
+	if op := app.startCustody; op != nil {
+		op.mu.Lock()
+		valid := op.Owner == owner && op.Capture != nil && op.Capture.Player == owner.player &&
+			op.Capture.Session == owner.sess && op.Terminal && op.State == "complete" &&
+			op.CReceipt != nil && op.CReceipt.Phase == "completed" && op.CReceipt.Actual != nil &&
+			op.Actual != nil && *op.CReceipt.Actual == *op.Actual && op.CReceipt.WriterEpoch == op.Epoch
+		if valid {
+			current = completedWriter{start: op, writer: app.openedWriter, epoch: op.Epoch}
+			actual, process = op.Actual, op.Capture.Process
+			valid = op.CReceipt.Pipe != nil && *op.CReceipt.Pipe == outputPipeIdentity{Device: current.writer.Device, Inode: current.writer.Inode, Type: "fifo"}
+		}
+		op.mu.Unlock()
+		if !valid {
+			return nil, ErrAliasConflict
+		}
+	} else if op := app.moveCustody; op != nil {
+		op.mu.Lock()
+		valid := op.Owner == owner && op.Capture != nil && op.Capture.Player == owner.player &&
+			op.Capture.Session == owner.sess && op.Terminal && op.State == "complete" &&
+			op.CReceipt != nil && op.CReceipt.Phase == "completed" && op.CReceipt.Actual != nil &&
+			op.Actual != nil && *op.CReceipt.Actual == *op.Actual && op.CReceipt.WriterEpoch == op.Epoch
+		if valid {
+			current = completedWriter{move: op, writer: op.Pipe, epoch: op.Epoch}
+			actual, process = op.Actual, op.Capture.Process
+			valid = op.CReceipt.Pipe != nil && *op.CReceipt.Pipe == outputPipeIdentity{Device: current.writer.Device, Inode: current.writer.Inode, Type: "fifo"} && current.writer == app.openedWriter
+		}
+		op.mu.Unlock()
+		if !valid {
+			return nil, ErrAliasConflict
+		}
+	}
+	observed, ok := nativeContentProcess()
+	if !ok || observed != process || actual == nil || !sameCompletedRoom(*actual, identity) ||
+		current.writer.Type != "fifo" || !volumeCounter(current.writer.FD) ||
+		!volumeCounter(current.epoch) || current.epoch == "0" {
+		return nil, ErrAliasConflict
+	}
+	return &current, nil
+}
+
+// This is the existing RoomMove verify worker phase, which performs no move
+// mutation. It joins the real output and source locks and fstats the writer.
+func (p *AppPlayer) verifyCompletedWriter(ctx context.Context, identity roomTransportIdentity) (*completedWriter, error) {
+	current, err := p.app.completedWriterCurrent(p, identity)
+	if err != nil || current == nil {
+		return current, err
+	}
+	if p.primaryStream == nil || p.primaryStream.Source == nil || p.state == nil || p.state.player == nil {
+		return nil, ErrAliasConflict
+	}
+	source := p.primaryStream.Source
+	paused := p.state.player.IsPaused
+	_, _, err = p.player.RoomMove(ctx, "verify", source, current.writer, current.epoch, !paused, func(mutate func()) error {
+		p.aliasMu.Lock()
+		defer p.aliasMu.Unlock()
+		fresh, err := p.app.completedWriterCurrent(p, identity)
+		binding := p.aliasBindingLocked()
+		if err != nil || fresh == nil || *fresh != *current || p.primaryStream == nil ||
+			p.primaryStream.Source != source || p.state == nil || p.state.player == nil ||
+			p.state.player.IsPaused != paused || p.spotConnId != identity.ConnectionID ||
+			p.state.player.SessionId != identity.SessionID || !p.hasInitialConnectState || p.aliasRetired ||
+			p.aliasIncarnation != identity.AliasIncarnation || p.aliasFingerprint != identity.AliasRegistry ||
+			p.aliasRevision != identity.AliasRevision || p.app.deviceId != identity.TargetID ||
+			binding == nil || !binding.Ready || binding.RoomID != identity.RoomID ||
+			!p.transportMappingCurrentLocked() {
+			return ErrAliasConflict
+		}
+		mutate()
+		return nil
+	})
+	if err != nil {
+		return nil, ErrAliasConflict
+	}
+	return current, nil
+}
