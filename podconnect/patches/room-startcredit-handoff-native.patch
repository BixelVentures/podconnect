+package player
+
+import (
+	"context"
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"os"
+	"path/filepath"
+	"syscall"
+	"testing"
+	"time"
+
+	librespot "github.com/devgianlu/go-librespot"
+	"github.com/devgianlu/go-librespot/output"
+)
+
+type startVerifyEOFSource struct{ id int }
+
+func (*startVerifyEOFSource) Read([]float32) (int, error) { return 0, io.EOF }
+func (*startVerifyEOFSource) PositionMs() int64           { return 0 }
+func (*startVerifyEOFSource) SetPositionMs(int64) error   { return nil }
+
+func TestStart35HeldCCompleteCannotCreditClosedWriter(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "pcm.fifo")
+	if err := syscall.Mkfifo(path, 0600); err != nil {
+		t.Fatal(err)
+	}
+	reader, err := os.OpenFile(path, os.O_RDONLY|syscall.O_NONBLOCK, 0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer reader.Close()
+	var writer output.MovePipeIdentity
+	p, err := NewPlayer(&Options{
+		Log: &librespot.NullLogger{}, AudioBackend: "pipe", AudioOutputPipe: path,
+		AudioOutputPipeFormat: "s16le", WithNewOutput: func(create func() (output.Output, error)) (output.Output, error) {
+			out, err := create()
+			if err == nil {
+				writer = out.(interface {
+					OpenedWriterIdentity() output.MovePipeIdentity
+				}).OpenedWriterIdentity()
+			}
+			return out, err
+		},
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer p.Close()
+	old, selected := &startVerifyEOFSource{1}, &startVerifyEOFSource{2}
+	if err := p.SetPrimaryStream(old, true, false); err != nil {
+		t.Fatal(err)
+	}
+	guard := func(mutate func()) error { mutate(); return nil }
+	pipe, epoch, err := p.Start35(context.Background(), "quiesce", nil, old, output.PipeIdentity{}, "", guard)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, _, err = p.Start35(context.Background(), "publish", selected, old, pipe, epoch, guard); err != nil {
+		t.Fatal(err)
+	}
+	if _, _, err = p.Start35(context.Background(), "resume", nil, selected, pipe, epoch, guard); err != nil {
+		t.Fatal(err)
+	}
+	credited := false
+	if err = p.VerifyStart35(context.Background(), selected, pipe, epoch, writer.FD, func(mutate func()) error { mutate(); credited = true; return nil }); err != nil || !credited {
+		t.Fatal("live actual writer/source/epoch did not verify", err)
+	}
+	for _, mismatch := range []struct {
+		source librespot.AudioSource
+		pipe   output.PipeIdentity
+		epoch  string
+		fd     string
+	}{
+		{old, pipe, epoch, writer.FD},
+		{selected, output.PipeIdentity{Device: pipe.Device, Inode: "999", Type: "fifo"}, epoch, writer.FD},
+		{selected, pipe, "999", writer.FD},
+		{selected, pipe, epoch, "999"},
+	} {
+		credited = false
+		if err := p.VerifyStart35(context.Background(), mismatch.source, mismatch.pipe, mismatch.epoch, mismatch.fd, func(mutate func()) error { mutate(); credited = true; return nil }); err == nil || credited {
+			t.Fatal("stale source/FIFO/epoch/FD credited")
+		}
+	}
+	entered, release := make(chan struct{}), make(chan struct{})
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		close(entered)
+		<-release
+		w.WriteHeader(http.StatusOK)
+	}))
+	defer server.Close()
+	ack := make(chan error, 1)
+	go func() {
+		resp, err := http.Post(server.URL+"/complete", "application/json", nil)
+		if err == nil {
+			_ = resp.Body.Close()
+		}
+		ack <- err
+	}()
+	select {
+	case <-entered:
+	case <-time.After(time.Second):
+		t.Fatal("C COMPLETE was not held")
+	}
+	p.Stop() // independent output close while the C bookkeeping ACK is held
+	close(release)
+	if err := <-ack; err != nil {
+		t.Fatal(err)
+	}
+	credited = false
+	if err = p.VerifyStart35(context.Background(), selected, pipe, epoch, writer.FD, func(mutate func()) error { mutate(); credited = true; return nil }); err == nil || credited {
+		t.Fatal("C COMPLETE credited a closed native writer")
+	}
+	p.Close()
+	if err = p.VerifyStart35(context.Background(), selected, pipe, epoch, writer.FD, func(mutate func()) error { mutate(); credited = true; return nil }); err == nil || credited {
+		t.Fatal("closed player accepted late C COMPLETE")
+	}
+}
