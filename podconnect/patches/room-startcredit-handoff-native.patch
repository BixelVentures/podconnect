+
+func (*normalPhoneSource) Read([]float32) (int, error) { return 0, io.EOF }
+func (*normalPhoneSource) PositionMs() int64           { return 0 }
+func (*normalPhoneSource) SetPositionMs(int64) error   { return nil }
+
+func TestCompletedWriterFreshPhoneSessionAndNextTrackReproof(t *testing.T) {
+	p, op := contentFixture(t)
+	path := filepath.Join(t.TempDir(), "pcm.fifo")
+	if err := syscall.Mkfifo(path, 0600); err != nil {
+		t.Fatal(err)
+	}
+	reader, err := os.OpenFile(path, os.O_RDONLY|syscall.O_NONBLOCK, 0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer reader.Close()
+	actual, err := player.NewPlayer(&player.Options{
+		Log: &librespot.NullLogger{}, AudioBackend: "pipe", AudioOutputPipe: path,
+		AudioOutputPipeFormat: "s16le", WithNewOutput: func(create func() (output.Output, error)) (output.Output, error) {
+			out, err := create()
+			if err == nil {
+				p.app.openedWriter = out.(interface {
+					OpenedWriterIdentity() output.MovePipeIdentity
+				}).OpenedWriterIdentity()
+			}
+			return out, err
+		},
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer actual.Close()
+	old, selected, next := &normalPhoneSource{1}, &normalPhoneSource{2}, &normalPhoneSource{3}
+	if err := actual.SetPrimaryStream(old, true, false); err != nil {
+		t.Fatal(err)
+	}
+	guard := func(mutate func()) error { mutate(); return nil }
+	pipe, epoch, err := actual.Start35(context.Background(), "quiesce", nil, old, output.PipeIdentity{}, "", guard)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, _, err = actual.Start35(context.Background(), "publish", selected, old, pipe, epoch, guard); err != nil {
+		t.Fatal(err)
+	}
+	if _, _, err = actual.Start35(context.Background(), "resume", nil, selected, pipe, epoch, guard); err != nil {
+		t.Fatal(err)
+	}
+	if err := actual.Pause(); err != nil {
+		t.Fatal(err)
+	}
+	p.state.player.IsPaused = true
+	p.player, op.Capture.Player = actual, actual
+	p.primaryStream.Source = selected
+	op.Capture.Session = p.sess
+	op.Epoch = epoch
+	owned := op.Intended
+	p.aliasRevision = owned.AliasRevision
+	p.state.device.SelectedAliasId = 2
+	op.Actual = &owned
+	op.CReceipt = &contentCReceipt{Phase: "completed", Actual: &owned, WriterEpoch: epoch,
+		Pipe: &outputPipeIdentity{Device: pipe.Device, Inode: pipe.Inode, Type: pipe.Type}}
+	op.Terminal, op.State = true, "complete"
+	p.app.startCustody = op
+	actualFD := p.app.openedWriter.FD
+	p.spotConnId, p.state.player.SessionId = "accepted-new-connection", "new-phone-session"
+	p.hasInitialConnectState = true
+	identity := owned
+	identity.ConnectionID, identity.SessionID = p.spotConnId, p.state.player.SessionId
+	if _, err := p.verifyCompletedWriter(context.Background(), identity); err != nil {
+		t.Fatal("same App/new accepted phone owner lost exact writer", err)
+	}
+	p.hasInitialConnectState = false
+	if _, err := p.verifyCompletedWriter(context.Background(), identity); err == nil {
+		t.Fatal("failed NEW_DEVICE acceptance credited")
+	}
+	p.hasInitialConnectState = true
+	if err := actual.SetPrimaryStream(next, true, false); err != nil {
+		t.Fatal(err)
+	}
+	p.primaryStream.Source = next
+	if _, _, directErr := actual.RoomMove(context.Background(), "verify", next, p.app.openedWriter, epoch, false, guard); directErr != nil {
+		t.Fatal("actual next-track writer changed", directErr)
+	}
+	if _, err := p.verifyCompletedWriter(context.Background(), identity); err != nil {
+		t.Fatal("same writer next track was denied", err)
+	}
+	identity.AliasRevision++
+	if _, err := p.verifyCompletedWriter(context.Background(), identity); err == nil {
+		t.Fatal("real alias ABA accepted against old completed owner")
+	}
+	identity.AliasRevision--
+	p.app.openedWriter.FD = "999"
+	if _, err := p.verifyCompletedWriter(context.Background(), identity); err == nil {
+		t.Fatal("wrong global writer FD accepted")
+	}
+	p.app.openedWriter.FD = actualFD
+	op.State = "unknown"
+	if _, err := p.verifyCompletedWriter(context.Background(), identity); err == nil {
+		t.Fatal("unknown completed source adopted")
+	}
+	op.State = "complete"
+	future := &normalPhoneSource{4}
+	if err := actual.SetPrimaryStream(future, true, false); err != nil {
+		t.Fatal(err)
+	}
+	if _, _, err := actual.RoomMove(context.Background(), "verify", next, p.app.openedWriter, epoch, false, guard); err == nil {
+		t.Fatal("old operation crossed a new track source boundary")
+	}
+}
