+func TestInitialPublicationRecoversBeforeExistingStatePublication(t *testing.T) {
+	p, server := pc10InitialOwner(t)
+	before := proto.Clone(p.state.player).(*connectpb.PlayerState)
+	oldTracks, oldQueue := p.state.tracks, p.state.queueID
+	var reasons []connectpb.PutStateReason
+	rejectInitial := true
+	sp := pc13Spclient(t, pc13RoundTrip(func(r *http.Request) (*http.Response, error) {
+		if r.Method != http.MethodPut || r.URL.Host != "pc13.invalid" || r.URL.Path != "/connect-state/v1/devices/fixture-device" || r.Header.Get("X-Spotify-Connection-Id") != "fixture-current-connection-00000001" {
+			return nil, fmt.Errorf("unexpected inert publication")
+		}
+		body, err := io.ReadAll(r.Body)
+		if err != nil {
+			return nil, err
+		}
+		var request connectpb.PutStateRequest
+		if err := proto.Unmarshal(body, &request); err != nil {
+			return nil, err
+		}
+		reasons = append(reasons, request.PutStateReason)
+		status, payload := http.StatusOK, ""
+		if request.PutStateReason == connectpb.PutStateReason_NEW_DEVICE && rejectInitial {
+			status, payload = http.StatusServiceUnavailable, `{"message":"fixture initial rejection"}`
+		}
+		return &http.Response{StatusCode: status, Header: make(http.Header), Body: io.NopCloser(strings.NewReader(payload)), Request: r}, nil
+	}))
+	ctx, cancel := context.WithTimeout(context.Background(), 6*time.Second)
+	defer cancel()
+	if err := p.handleConnectionMessage(ctx, pc10Connection("fixture-current-connection-00000001"), sp); err == nil {
+		t.Fatal("initial publication unexpectedly accepted")
+	}
+	if len(reasons) != 3 {
+		t.Fatalf("initial retry count=%d want=3", len(reasons))
+	}
+	for _, reason := range reasons {
+		if reason != connectpb.PutStateReason_NEW_DEVICE {
+			t.Fatal("wrong initial request reason")
+		}
+	}
+	if !p.hasSpotConnId || p.hasInitialConnectState || pc10RootReady(t, p) {
+		t.Fatal("failed initial state advertised ready")
+	}
+	if err := p.handleAccesspointPacket(ap.PacketTypeCountryCode, []byte("DK")); err != nil {
+		t.Fatal(err)
+	}
+	if !p.hasCountryCode || pc10RootReady(t, p) {
+		t.Fatal("country code incorrectly replaced initial acceptance")
+	}
+	rejectInitial = false
+	if err := p.putConnectStateWithClient(ctx, connectpb.PutStateReason_PLAYER_STATE_CHANGED, sp); err != nil {
+		t.Fatal(err)
+	}
+	if len(reasons) != 5 || reasons[3] != connectpb.PutStateReason_NEW_DEVICE || reasons[4] != connectpb.PutStateReason_PLAYER_STATE_CHANGED {
+		t.Fatal("initial recovery did not precede the existing publication")
+	}
+	if !p.hasInitialConnectState || !pc10RootReady(t, p) || pc10ReadyEvents(server) != 1 {
+		t.Fatal("actual initial acceptance did not open readiness")
+	}
+	if p.state.tracks != oldTracks || p.state.queueID != oldQueue || !proto.Equal(before, p.state.player) {
+		t.Fatal("diagnostic path changed queue/context")
+	}
+}
