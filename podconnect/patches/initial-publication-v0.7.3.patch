+func TestNewConnectionRequiresCurrentInitialAcceptance(t *testing.T) {
+	p, server := pc10InitialOwner(t)
+	var connections []string
+	rejectSecond := true
+	sp := pc13Spclient(t, pc13RoundTrip(func(r *http.Request) (*http.Response, error) {
+		id := r.Header.Get("X-Spotify-Connection-Id")
+		connections = append(connections, id)
+		status, payload := http.StatusOK, ""
+		if id == "fixture-second-connection-00000002" && rejectSecond {
+			status, payload = http.StatusServiceUnavailable, `{"message":"fixture reconnect rejection"}`
+		}
+		return &http.Response{StatusCode: status, Header: make(http.Header), Body: io.NopCloser(strings.NewReader(payload)), Request: r}, nil
+	}))
+	ctx, cancel := context.WithTimeout(context.Background(), 6*time.Second)
+	defer cancel()
+	if err := p.handleAccesspointPacket(ap.PacketTypeCountryCode, []byte("DK")); err != nil {
+		t.Fatal(err)
+	}
+	if err := p.handleConnectionMessage(ctx, pc10Connection("fixture-current-connection-00000001"), sp); err != nil {
+		t.Fatal(err)
+	}
+	if !pc10RootReady(t, p) {
+		t.Fatal("positive control failed")
+	}
+	if err := p.handleConnectionMessage(ctx, pc10Connection("fixture-second-connection-00000002"), sp); err == nil {
+		t.Fatal("reconnect publication unexpectedly accepted")
+	}
+	if len(connections) != 4 || p.spotConnId != "fixture-second-connection-00000002" {
+		t.Fatal("actual reconnect requests missing")
+	}
+	for _, id := range connections[1:] {
+		if id != p.spotConnId {
+			t.Fatal("reconnect retry used old connection")
+		}
+	}
+	if p.hasInitialConnectState || pc10RootReady(t, p) || pc10ReadyEvents(server) != 1 {
+		t.Fatal("old lifetime channel credited a new connection")
+	}
+	rejectSecond = false
+	if err := p.putConnectStateWithClient(ctx, connectpb.PutStateReason_VOLUME_CHANGED, sp); err != nil {
+		t.Fatal(err)
+	}
+	if !p.hasInitialConnectState || !pc10RootReady(t, p) || pc10ReadyEvents(server) != 1 || len(connections) != 6 {
+		t.Fatal("current connection recovery or one-shot event changed")
+	}
+	fresh, freshServer := pc10InitialOwner(t)
+	if pc10RootReady(t, fresh) || pc10ReadyEvents(freshServer) != 0 {
+		t.Fatal("fresh owner inherited prior readiness")
+	}
+	if err := fresh.handleAccesspointPacket(ap.PacketTypeCountryCode, []byte("DK")); err != nil {
+		t.Fatal(err)
+	}
+	if err := fresh.handleConnectionMessage(ctx, pc10Connection("fixture-fresh-connection-00000003"), sp); err != nil {
+		t.Fatal(err)
+	}
+	if !pc10RootReady(t, fresh) || pc10ReadyEvents(freshServer) != 1 || fresh.spotConnId != "fixture-fresh-connection-00000003" {
+		t.Fatal("fresh owner acceptance missing")
+	}
+}
