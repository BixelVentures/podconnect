+	for _, reason := range []connectpb.PutStateReason{connectpb.PutStateReason_PLAYER_STATE_CHANGED, connectpb.PutStateReason_VOLUME_CHANGED} {
+		if err := p.putConnectStateWithClient(ctx, reason, sp); err != nil {
+			t.Fatal(err)
+		}
+	}
+	want := []connectpb.PutStateReason{connectpb.PutStateReason_NEW_DEVICE, connectpb.PutStateReason_NEW_DEVICE, connectpb.PutStateReason_PLAYER_STATE_CHANGED, connectpb.PutStateReason_VOLUME_CHANGED}
+	if !reflect.DeepEqual(reasons, want) || requests != 4 || pc10ReadyEvents(server) != 1 {
+		t.Fatal("normal/duplicate publication order or count changed")
