+// Actual existing publication-owner regressions, not Spotify visibility/audio proof.
+// Reuse PC13's real Spclient constructor and inert RoundTripper. No Session,
+// provider, AP connection, output backend or readiness flag impersonation.
+func pc10InitialOwner(t *testing.T) (*AppPlayer, *aliasTestServer) {
+	t.Helper()
+	p := pc13ExistingPlayer(t, false)
+	server := &aliasTestServer{}
+	country := ""
+	p.app.server = server
+	p.app.cfg.ExternalVolume = true
+	p.state.device.Volume = 17  // Existing local preference must survive external-volume admission.
+	p.player = &player.Player{} // HasBeenPlayingFor's real zero-state read; no player goroutine.
+	p.countryCode = &country
+	p.playbackReadyCh = make(chan struct{})
+	return p, server
+}
+
+func pc10RootReady(t *testing.T, p *AppPlayer) bool {
+	t.Helper()
+	data, err := p.handleApiRequest(context.Background(), ApiRequest{Type: ApiRequestTypeRoot})
+	if err != nil {
+		t.Fatal(err)
+	}
+	return data.(*ApiResponseRoot).PlaybackReady
+}
+
+func pc10Connection(id string) dealer.Message {
+	return dealer.Message{Uri: "hm://pusher/v1/connections/fixture", Headers: map[string]string{"Spotify-Connection-Id": id}}
+}
+
+func pc10ReadyEvents(server *aliasTestServer) int {
+	n := 0
+	for _, event := range server.events {
+		if event.Type == ApiEventTypePlaybackReady {
+			n++
+		}
+	}
+	return n
+}
