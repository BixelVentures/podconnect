+func TestHeldInitialSuccessCannotCreditRetiredOrCanceledOwner(t *testing.T) {
+	for _, cancelled := range []bool{false, true} {
+		t.Run(fmt.Sprintf("cancelled_%v", cancelled), func(t *testing.T) {
+			p, server := pc10InitialOwner(t)
+			before := proto.Clone(p.state.player)
+			oldTracks, oldQueue := p.state.tracks, p.state.queueID
+			entered, allow := make(chan struct{}), make(chan struct{})
+			calls := 0
+			sp := pc13Spclient(t, pc13RoundTrip(func(r *http.Request) (*http.Response, error) {
+				calls++
+				body, err := io.ReadAll(r.Body)
+				if err != nil {
+					return nil, err
+				}
+				var req connectpb.PutStateRequest
+				if err := proto.Unmarshal(body, &req); err != nil {
+					return nil, err
+				}
+				if req.PutStateReason != connectpb.PutStateReason_NEW_DEVICE {
+					return nil, fmt.Errorf("unexpected ordinary send")
+				}
+				close(entered)
+				<-allow
+				return &http.Response{StatusCode: http.StatusOK, Header: make(http.Header), Body: io.NopCloser(strings.NewReader("")), Request: r}, nil
+			}))
+			ctx, cancel := context.WithTimeout(context.Background(), 6*time.Second)
+			defer cancel()
+			if err := p.handleAccesspointPacket(ap.PacketTypeCountryCode, []byte("DK")); err != nil {
+				t.Fatal(err)
+			}
+			returned := make(chan error, 1)
+			go func() {
+				returned <- p.handleConnectionMessage(ctx, pc10Connection("fixture-current-connection-00000001"), sp)
+			}()
+			// Always release and join the exact request goroutine even on assertion failure.
+			joined := false
+			defer func() {
+				select {
+				case <-allow:
+				default:
+					close(allow)
+				}
+				if !joined {
+					select {
+					case <-returned:
+					case <-time.After(time.Second):
+						t.Error("request owner not joined")
+					}
+				}
+			}()
+			select {
+			case <-entered:
+			case <-ctx.Done():
+				t.Fatal("initial request did not enter")
+			}
+			if cancelled {
+				cancel()
+			} else {
+				p.retireAliases()
+			}
+			close(allow)
+			select {
+			case err := <-returned:
+				joined = true
+				if err == nil {
