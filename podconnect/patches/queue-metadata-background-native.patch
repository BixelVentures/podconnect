+// readQueueMetadata is display-only and runs on the HTTP goroutine, never the player actor.
+func readQueueMetadata(ctx context.Context, client interface {
+	ExtendedMetadata(context.Context, *extpb.BatchedEntityRequest) (*extpb.BatchedExtensionResponse, error)
+}, rows []nativeQueueItem) map[string]queueMetadata {
+	request := &extpb.BatchedEntityRequest{}
+	allowed := make(map[string]bool, len(rows))
+	for _, row := range rows {
+		if !allowed[row.URI] {
+			allowed[row.URI] = true
+			request.EntityRequest = append(request.EntityRequest, &extpb.EntityRequest{EntityUri: row.URI, Query: []*extpb.ExtensionQuery{{ExtensionKind: extpb.ExtensionKind_TRACK_V4}}})
+		}
+	}
+	if len(request.EntityRequest) == 0 {
+		return nil
+	}
+	reply, err := client.ExtendedMetadata(ctx, request)
+	if err != nil || ctx.Err() != nil || reply == nil {
+		return nil
+	}
+	result := make(map[string]queueMetadata)
+	metadataBytes := 0
+	for _, group := range reply.GetExtendedMetadata() {
+		if group.GetExtensionKind() != extpb.ExtensionKind_TRACK_V4 {
+			continue
+		}
+		for _, row := range group.GetExtensionData() {
+			uri := row.GetEntityUri()
+			if !allowed[uri] || row.GetHeader().GetStatusCode() != 200 || row.GetExtensionData() == nil {
+				continue
+			}
+			var track metapb.Track
+			if row.GetExtensionData().UnmarshalTo(&track) != nil {
+				continue
+			}
+			id, ok := new(big.Int).SetString(strings.TrimPrefix(uri, "spotify:track:"), 62)
+			if !ok || id.BitLen() > 128 || !bytes.Equal(track.GetGid(), id.FillBytes(make([]byte, 16))) {
+				continue
+			}
+			name := track.GetName()
+			if !utf8.ValidString(name) || len(name) < 1 || len(name) > 256 {
+				continue
+			}
+			artists := []string{}
+			for _, artist := range track.GetArtist() {
+				value := artist.GetName()
+				if !utf8.ValidString(value) || len(value) < 1 || len(value) > 256 || len(artists) >= 20 {
+					artists = nil
+					break
+				}
+				artists = append(artists, value)
+			}
+			if len(artists) == 0 {
+				continue
+			}
+			joined := strings.Join(artists, ", ")
+			if len(joined) > 512 {
+				continue
+			}
+			label := queueMetadata{Name: name, Artist: joined}
+			if image := track.GetAlbum().GetCoverGroup().GetImage(); len(image) > 0 && len(image[0].GetFileId()) == 20 {
+				label.Artwork = "https://i.scdn.co/image/" + hex.EncodeToString(image[0].GetFileId())
+			}
+			encoded, err := json.Marshal(label)
+			if err != nil || len(encoded)+len(uri)+metadataBytes > 6000 {
+				continue
+			}
+			metadataBytes += len(encoded) + len(uri)
+			result[uri] = label
+		}
+	}
+	return result
+}
