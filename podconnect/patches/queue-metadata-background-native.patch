+func TestQueueMetadataBackgroundExtendingQueueRetainsPriorLabels(t *testing.T) {
+	cache := &queueMetadataCache{}
+	defer cache.close()
+	owner := &session.Session{}
+	client := &sequenceMetadataFixture{}
+	a, b := "spotify:track:0000000000000000000001", "spotify:track:0000000000000000000002"
+	first := []nativeQueueItem{{URI: a}}
+	both := []nativeQueueItem{{URI: a}, {URI: b}}
+	wait := func() {
+		deadline := time.Now().Add(time.Second)
+		for {
+			cache.mu.Lock()
+			done := cache.cancel == nil
+			cache.mu.Unlock()
+			if done {
+				return
+			}
+			if time.Now().After(deadline) {
+				t.Fatal("warm did not finish")
+			}
+			time.Sleep(time.Millisecond)
+		}
+	}
+	cache.readAndWarm("account", owner, client, first)
+	wait()
+	got := cache.readAndWarm("account", owner, client, both)
+	if got[a].Name != a {
+		t.Fatal("existing label lost when queue extended", got)
+	}
+	wait()
+	for i := 0; i < 10; i++ {
+		got = cache.readAndWarm("account", owner, client, both)
+		if got[a].Name != a || got[b].Name != b {
+			t.Fatal("labels oscillated", got)
+		}
+	}
+	if calls := client.calls.Load(); calls != 2 {
+		t.Fatal("unexpected repeated provider lookups", calls)
+	}
+	cache.mu.Lock()
+	defer cache.mu.Unlock()
+	if len(cache.values) > 20 || len(cache.attempted) > 20 {
+		t.Fatal("unbounded metadata cache")
+	}
