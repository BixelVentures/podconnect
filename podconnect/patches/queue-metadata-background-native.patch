+func TestQueueMetadataColdLookupExactURIAndFailSoft(t *testing.T) {
+	uri := "spotify:track:0000000000000000000001"
+	foreign := "spotify:track:BBBBBBBBBBBBBBBBBBBBBB"
+	id, err := librespot.SpotifyIdFromUri(uri)
+	if err != nil {
+		t.Fatal(err)
+	}
+	track := &metapb.Track{Gid: id.Id(), Name: proto.String("Song"), Artist: []*metapb.Artist{{Name: proto.String("Artist")}}, Album: &metapb.Album{CoverGroup: &metapb.ImageGroup{Image: []*metapb.Image{{FileId: make([]byte, 20)}}}}}
+	data, err := anypb.New(track)
+	if err != nil {
+		t.Fatal(err)
+	}
+	entry := func(key string) *extpb.EntityExtensionData {
+		return &extpb.EntityExtensionData{EntityUri: key, Header: &extpb.EntityExtensionDataHeader{StatusCode: 200}, ExtensionData: data}
+	}
+	f := &metadataFixture{reply: &extpb.BatchedExtensionResponse{ExtendedMetadata: []*extpb.EntityExtensionDataArray{{ExtensionKind: extpb.ExtensionKind_TRACK_V4, ExtensionData: []*extpb.EntityExtensionData{entry(uri), entry(foreign)}}}}}
+	rows := []nativeQueueItem{{ID: "one", URI: uri}, {ID: "two", URI: uri}}
+	out := readQueueMetadata(context.Background(), f, rows)
+	if len(f.request.EntityRequest) != 1 || len(out) != 1 || out[uri].Name != "Song" || out[uri].Artist != "Artist" || out[uri].Artwork != "https://i.scdn.co/image/0000000000000000000000000000000000000000" {
+		t.Fatalf("metadata projection %#v", out)
+	}
+	track.Gid = make([]byte, 16)
+	mismatched, err := anypb.New(track)
+	if err != nil {
+		t.Fatal(err)
+	}
+	f.reply.ExtendedMetadata[0].ExtensionData = []*extpb.EntityExtensionData{{EntityUri: uri, Header: &extpb.EntityExtensionDataHeader{StatusCode: 200}, ExtensionData: mismatched}}
+	if got := readQueueMetadata(context.Background(), f, rows); len(got) != 0 {
+		t.Fatal("foreign metadata GID published", got)
+	}
+	overflow := "spotify:track:AAAAAAAAAAAAAAAAAAAAAA"
+	f.reply.ExtendedMetadata[0].ExtensionData = []*extpb.EntityExtensionData{{EntityUri: overflow, Header: &extpb.EntityExtensionDataHeader{StatusCode: 200}, ExtensionData: mismatched}}
+	if got := readQueueMetadata(context.Background(), f, []nativeQueueItem{{URI: overflow}}); len(got) != 0 {
+		t.Fatal("overflow ID published", got)
+	}
+	f.err = errors.New("unavailable")
+	if got := readQueueMetadata(context.Background(), f, rows); len(got) != 0 {
+		t.Fatal("failed lookup published", got)
+	}
+	ctx, cancel := context.WithDeadline(context.Background(), time.Now().Add(-time.Second))
+	defer cancel()
+	f.err = nil
+	if got := readQueueMetadata(ctx, f, rows); len(got) != 0 {
+		t.Fatal("expired lookup published", got)
+	}
+}
