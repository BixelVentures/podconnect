+package daemon
+
+import (
+	"context"
+	"encoding/json"
+	"sync"
+	"time"
+
+	extpb "github.com/devgianlu/go-librespot/proto/spotify/extendedmetadata"
+	"github.com/devgianlu/go-librespot/session"
+)
+
+type queueMetadataFetcher interface {
+	ExtendedMetadata(context.Context, *extpb.BatchedEntityRequest) (*extpb.BatchedExtensionResponse, error)
+}
+
+// queueMetadataCache owns display hints only. Queue authority never depends on it.
+type queueMetadataCache struct {
+	mu               sync.Mutex
+	account          string
+	session          *session.Session
+	values           map[string]queueMetadata
+	attempted        map[string]time.Time
+	relevant         []string
+	cancel           context.CancelFunc
+	generation       uint64
+	activeGeneration uint64
+	closed           bool
+}
+
+// prune keeps only the current 20 distinct URIs and at most 6 KiB of hints.
+func (c *queueMetadataCache) prune(now time.Time) {
+	values := make(map[string]queueMetadata)
+	attempted := make(map[string]time.Time)
+	size := 0
+	for _, uri := range c.relevant {
+		until, ok := c.attempted[uri]
+		if !ok || !now.Before(until) {
+			continue
+		}
+		attempted[uri] = until
+		if value, ok := c.values[uri]; ok {
+			encoded, err := json.Marshal(value)
+			if err == nil && size+len(uri)+len(encoded) <= 6000 {
+				values[uri] = value
+				size += len(uri) + len(encoded)
+			}
+		}
+	}
+	c.values, c.attempted = values, attempted
+}
+
+func (c *queueMetadataCache) readAndWarm(account string, owner *session.Session, client queueMetadataFetcher, rows []nativeQueueItem) map[string]queueMetadata {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if c.closed || owner == nil || client == nil || account == "" {
+		return nil
+	}
+	if c.account != account || c.session != owner {
+		if c.cancel != nil {
+			c.cancel()
+		}
+		c.generation++
+		c.account = account
+		c.session = owner
+		c.values = nil
+		c.attempted = nil
+	}
+	c.relevant = nil
+	seen := map[string]bool{}
+	for _, row := range rows {
+		if !seen[row.URI] && len(c.relevant) < 20 {
+			seen[row.URI] = true
+			c.relevant = append(c.relevant, row.URI)
+		}
+	}
+	c.prune(time.Now())
+	result := make(map[string]queueMetadata)
+	missing := make([]nativeQueueItem, 0, len(c.relevant))
+	for _, uri := range c.relevant {
+		if value, ok := c.values[uri]; ok {
+			result[uri] = value
+		}
+		if _, ok := c.attempted[uri]; !ok {
+			missing = append(missing, nativeQueueItem{URI: uri})
+		}
+	}
+	if len(missing) > 0 && c.cancel == nil {
+		ctx, cancel := context.WithTimeout(context.Background(), 2*time.Second)
+		c.cancel = cancel
+		c.generation++
+		gen := c.generation
+		c.activeGeneration = gen
+		go func() {
+			defer cancel()
+			values := readQueueMetadata(ctx, client, missing)
+			c.mu.Lock()
+			defer c.mu.Unlock()
+			if c.activeGeneration == gen {
+				c.cancel = nil
+			}
+			if c.closed || c.generation != gen || c.session != owner || c.account != account {
+				return
+			}
+			if c.values == nil {
+				c.values = make(map[string]queueMetadata)
+			}
+			if c.attempted == nil {
+				c.attempted = make(map[string]time.Time)
+			}
+			until := time.Now().Add(30 * time.Second)
+			for _, row := range missing {
+				c.attempted[row.URI] = until
+				if value, ok := values[row.URI]; ok {
+					c.values[row.URI] = value
+				}
+			}
+			c.prune(time.Now())
+		}()
+	}
+	return result
+}
+func (c *queueMetadataCache) close() {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	c.closed = true
+	c.generation++
+	if c.cancel != nil {
+		c.cancel()
+		c.cancel = nil
+	}
+	c.values = nil
+	c.attempted = nil
+	c.relevant = nil
+	c.session = nil
+}
