+		server.handleRoomQueue(out, httptest.NewRequest(http.MethodGet, "/player/room_transport/bound-queue?account_user_id=account&target_id=engine&room_id=r0&homepod_id=1", nil))
+		return out
+	}
+	start := time.Now()
+	first := read()
+	if first.Code != 200 || time.Since(start) > 200*time.Millisecond {
+		t.Fatal("cold read waited", first.Code)
+	}
+	select {
+	case <-entered:
+	case <-time.After(time.Second):
+		t.Fatal("warm not started")
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), 200*time.Millisecond)
+	defer cancel()
+	if _, err := server.roomTransportAsk(ctx, ApiRequestTypePause, nil); err != nil {
+		t.Fatal("actual player pause blocked", err)
+	}
+	close(release)
+	deadline := time.Now().Add(time.Second)
+	for {
+		p.queueMetadata.mu.Lock()
+		ready := p.queueMetadata.cancel == nil
+		p.queueMetadata.mu.Unlock()
+		if ready {
+			break
+		}
+		if time.Now().After(deadline) {
+			t.Fatal("warm did not settle")
+		}
+		time.Sleep(time.Millisecond)
+	}
+	second := read()
+	if second.Code != 200 || !bytes.Contains(second.Body.Bytes(), []byte(`"name":"Song"`)) || !bytes.Contains(second.Body.Bytes(), []byte(`"id":"000000000000000000000001"`)) || !bytes.Contains(second.Body.Bytes(), []byte(`"id":"000000000000000000000002"`)) {
+		t.Fatal("later read lost metadata or occurrences", second.Code, second.Body.String())
+	}
