+func TestFreshPlayerWriterReportsExactCustodyRefusalWithoutOpeningFIFO(t *testing.T) {
+	for _, tc := range []struct {
+		name    string
+		arrange func(*App, *AppPlayer)
+	}{
+		{"custody_unknown", func(app *App, _ *AppPlayer) { app.moveCustodyUnknown = true }},
+		{"retirement_pending", func(app *App, owner *AppPlayer) { app.retirementPending = &retirementAttempt{owner: owner} }},
+		{"start_custody", func(app *App, owner *AppPlayer) {
+			app.startCustody = &contentOperation{Owner: owner, State: "complete", Terminal: true, CReceipt: &contentCReceipt{Phase: "completed"}}
+		}},
+		{"writer_generation_exhausted", func(app *App, _ *AppPlayer) { app.openedWriterGeneration = ^uint64(0) }},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			app := &App{}
+			owner := &AppPlayer{app: app}
+			created := false
+			worker, err := player.NewPlayer(&player.Options{Log: &librespot.NullLogger{}, AudioBackend: "pipe", AudioOutputPipe: filepath.Join(t.TempDir(), "must-not-open.fifo"), AudioOutputPipeFormat: "s16le", WithNewOutput: func(create func() (output.Output, error)) (output.Output, error) {
+				return app.withNewOutput(owner, func() (output.Output, error) {
+					created = true
+					return create()
+				})
+			}})
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer worker.Close()
+			owner.player = worker
+			tc.arrange(app, owner)
+			err = worker.SetPrimaryStream(&contentInertSource{}, false, false)
+			if !errors.Is(err, ErrAliasConflict) || !strings.Contains(err.Error(), "output admission "+tc.name) {
+				t.Fatalf("missing exact pre-open refusal: %v", err)
+			}
+			if created {
+				t.Fatal("refused ownership created an output")
+			}
+		})
+	}
 }
 
