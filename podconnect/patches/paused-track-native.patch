+func TestPausedTerminalNextNeverStagesForeignSessionUnderOldRoute(t *testing.T) {
+	p := nextFixture(t)
+	p.state.player.IsPaused = true
+	before := proto.Clone(p.state.player)
+	calls := 0
+	staged, state, err := p.prepareRoomTransportTrack(context.Background(), false, nextSpclient(t, &calls, nextTrack, nil))
+	if !errors.Is(err, ErrAliasConflict) || staged != nil || state != nil || calls != 1 {
+		t.Fatalf("paused foreign session admitted: %v, %v", err, state)
+	}
+	if !proto.Equal(before, p.state.player) {
+		t.Fatal("paused terminal rejection mutated the live owner")
+	}
+}
+
+func TestPausedSameSessionTrackSwitchKeepsNativePause(t *testing.T) {
+	for _, previous := range []bool{false, true} {
+		p := nextFixture(t)
+		list, err := tracks.NewTrackListFromContext(context.Background(), &librespot.NullLogger{}, nil,
+			&connectpb.Context{Uri: pContext, Pages: []*connectpb.ContextPage{{Tracks: []*connectpb.ContextTrack{{Uri: oldTrack}, {Uri: nextTrack}}}}})
+		if err != nil {
+			t.Fatal(err)
+		}
+		current := oldTrack
+		want := nextTrack
+		if previous {
+			current, want = nextTrack, oldTrack
+		}
+		if err = list.TrySeek(context.Background(), func(track *connectpb.ContextTrack) bool { return track.Uri == current }); err != nil {
+			t.Fatal(err)
+		}
+		p.state.tracks = list
+		p.state.player.Track = list.CurrentTrack()
+		p.state.player.IsPaused = true
+		before := proto.Clone(p.state.player)
+		staged, state, err := p.prepareRoomTransportTrack(context.Background(), previous, nil)
+		if err != nil || staged == nil || state == nil || state.Track.Uri != want || !state.IsPaused || state.SessionId != before.(*connectpb.PlayerState).SessionId {
+			t.Fatalf("same-session paused switch changed pause or owner: previous=%v err=%v state=%v", previous, err, state)
+		}
+		if !proto.Equal(before, p.state.player) || list.CurrentTrack().Uri != current {
+			t.Fatal("paused staging mutated live source")
+		}
+	}
+}
