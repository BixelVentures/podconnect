diff --git a/daemon/room_start_level_test.go b/daemon/room_start_level_test.go
new file mode 100644
index 0000000..4d77327
--- /dev/null
+++ b/daemon/room_start_level_test.go
@@ -0,0 +1,48 @@
+package daemon
+
+import (
+	"context"
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+)
+
+// Policy v2: a start plays at the room's HomePod output level as C reports it,
+// never above 35 %. A room set to 8 % starts at 8 %.
+func TestStartLevelIsTheRoomLevelReportedByCNeverAbove35(t *testing.T) {
+	for _, tc := range []struct {
+		percent int
+		ok      bool
+	}{{8, true}, {0, true}, {35, true}, {36, false}, {-1, false}} {
+		server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+			_ = json.NewEncoder(w).Encode(contentCState{Schema: "podconnect.output_start_state.v1", OK: true, Ready: true, Policy: start35Policy, Percent: tc.percent, Target: contentTarget{"11111111-1111-1111-1111-111111111111", "101", "1"}})
+		}))
+		capture := &contentCapture{OwnTone: server.URL, Scope: roomVolumeScope{"account", "engine", "r0", "101"}}
+		state, err := capture.readCState(context.Background())
+		server.Close()
+		if tc.ok && (err != nil || state.Percent != tc.percent) {
+			t.Fatalf("C level %d refused: %v", tc.percent, err)
+		}
+		if !tc.ok && err == nil {
+			t.Fatalf("C level %d above the start ceiling accepted", tc.percent)
+		}
+	}
+}
+
+// The offered level is what C prepares and what the receipt reports.
+func TestStartLevelTravelsFromOfferToCPrepareAndReceipt(t *testing.T) {
+	op := &contentOperation{Capture: &contentCapture{Scope: roomVolumeScope{"account", "engine", "r0", "101"}}, Offer: contentOffer{"podconnect.room_content_offer.v1", strings.Repeat("a", 32), strings.Repeat("b", 64), strings.Repeat("c", 32), start35Policy, 8, 5000}, State: "complete"}
+	raw, _ := json.Marshal(op.cPrepareBody())
+	var body struct {
+		Percent int    `json:"start_volume_percent"`
+		Policy  string `json:"policy_revision"`
+	}
+	if err := json.Unmarshal(raw, &body); err != nil || body.Percent != 8 || body.Policy != start35Policy {
+		t.Fatalf("C prepare %s, want the room's 8 %%", raw)
+	}
+	if got := op.receipt("commit"); got.StartVolume != 8 {
+		t.Fatalf("receipt percent %d, want 8", got.StartVolume)
+	}
+}
