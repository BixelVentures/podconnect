+}
+func TestPC58PendingPauseCannotBeClearedByConcurrentResume(t *testing.T) {
+	out, _, _ := startPipeFixture(t, &startRead{})
+	out.lock.Lock()
+	paused := make(chan error, 1)
+	go func() { paused <- out.Pause() }()
+	until := time.Now().Add(time.Second)
+	for !out.controlPending.Load() && time.Now().Before(until) {
+		time.Sleep(time.Millisecond)
+	}
+	if !out.controlPending.Load() {
+		out.lock.Unlock()
+		t.Fatal("pause never announced")
+	}
+	resumed := make(chan error, 1)
+	go func() { resumed <- out.Resume() }()
+	select {
+	case <-resumed:
+		out.lock.Unlock()
+		t.Fatal("Resume crossed pending Pause")
+	default:
+	}
+	out.lock.Unlock()
+	for _, done := range []chan error{paused, resumed} {
+		select {
+		case e := <-done:
+			if e != nil {
+				t.Fatal(e)
+			}
+		case <-time.After(time.Second):
+			t.Fatal("ordered control did not join")
+		}
+	}
+	if err := out.Close(); err != nil {
+		t.Fatal(err)
+	}
+}
