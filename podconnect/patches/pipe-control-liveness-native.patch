@@ -0,0 +1,302 @@
+package output
+
+import (
+	"bytes"
+	"context"
+	"fmt"
+	"io"
+	"os"
+	"runtime"
+	"syscall"
+	"testing"
+	"time"
+)
+
+// Extends the existing actual startPipeFixture/full-FIFO setup with the missing
+// no-consumer liveness case using the actual output worker and kernel FIFO.
+func TestPC58KeeperReaderAllowsBoundedCommandLiveness(t *testing.T) {
+	for _, command := range []string{"Pause", "Close"} {
+		t.Run(command, func(t *testing.T) {
+			reader := &startRead{entered: make(chan struct{})}
+			out, read, path := startPipeFixture(t, reader)
+			writer, err := syscall.Open(path, syscall.O_WRONLY|syscall.O_NONBLOCK, 0)
+			if err != nil {
+				t.Fatal(err)
+			}
+			for {
+				_, err = syscall.Write(writer, make([]byte, 4096))
+				if err == syscall.EAGAIN {
+					break
+				}
+				if err != nil {
+					t.Fatal(err)
+				}
+			}
+			syscall.Close(writer)
+			if err = out.Resume(); err != nil {
+				t.Fatal(err)
+			}
+			<-reader.entered
+			// Verify the actual worker reached file.Write while the exact FIFO is full.
+			// The retained read descriptor is deliberately open and never consumed here.
+			deadline := time.Now().Add(time.Second)
+			var stack []byte
+			for time.Now().Before(deadline) {
+				dump := make([]byte, 1<<20)
+				n := runtime.Stack(dump, true)
+				for _, goroutine := range bytes.Split(dump[:n], []byte("\n\n")) {
+					if bytes.Contains(goroutine, []byte("(*pipeOutput).outputLoop")) && bytes.Contains(goroutine, []byte("(*File).Write")) {
+						stack = append([]byte(nil), goroutine...)
+					}
+				}
+				if stack != nil {
+					break
+				}
+				time.Sleep(time.Millisecond)
+			}
+			done := make(chan error, 1)
+			go func() {
+				if command == "Pause" {
+					done <- out.Pause()
+				} else {
+					done <- out.Close()
+				}
+			}()
+			returned := false
+			timedOut := false
+			select {
+			case err = <-done:
+				returned = true
+			case <-time.After(200 * time.Millisecond):
+				timedOut = true
+			}
+			// Cleanup only after the no-consumer deadline. Fence prevents another chunk;
+			// draining now releases the same original kernel write and its mutex.
+			out.FenceStart()
+			buffer := make([]byte, 65536)
+			until := time.Now().Add(2 * time.Second)
+			for !returned && time.Now().Before(until) {
+				_, _ = syscall.Read(int(read.Fd()), buffer)
+				select {
+				case err = <-done:
+					returned = true
+				default:
+				}
+				time.Sleep(time.Millisecond)
+			}
+			if !returned {
+				t.Fatal("fixture cleanup could not join command after controlled drain")
+			}
+			if stack == nil {
+				t.Fatal("worker kernel write not observed")
+			}
+			if err != nil {
+				t.Fatal(err)
+			}
+			fmt.Fprintf(os.Stdout, "%s held FIFO fd=%s reader-open=true reads=%d blocked-stack:\n%s\n", command, out.openedWriter.FD, reader.reads.Load(), stack)
+			// A control request must join without an
+			// external consumer draining the pipe. Cleanup does not erase a failure.
+			if timedOut {
+				t.Error("command exceeded 200ms while keeper reader remained open with no consumer; returned only after controlled drain")
+			}
+		})
+	}
+}
+
+type pc58SingleChunk struct{ reads int }
+
+func (s *pc58SingleChunk) Read(samples []float32) (int, error) {
+	s.reads++
+	if s.reads > 1 {
+		return 0, io.EOF
+	}
+	for i := range samples {
+		samples[i] = 0.25
+	}
+	return len(samples), io.EOF
+}
+func pc58WaitWrite(t *testing.T) {
+	t.Helper()
+	until := time.Now().Add(time.Second)
+	for time.Now().Before(until) {
+		dump := make([]byte, 1<<20)
+		n := runtime.Stack(dump, true)
+		for _, g := range bytes.Split(dump[:n], []byte("\n\n")) {
+			if bytes.Contains(g, []byte("(*pipeOutput).outputLoop")) && bytes.Contains(g, []byte("(*File).Write")) {
+				return
+			}
+		}
+		time.Sleep(time.Millisecond)
+	}
+	t.Fatal("actual FIFO write did not wait")
+}
+func TestPC58PauseRetainsOnlyUnwrittenSuffixAndFenceDiscardsIt(t *testing.T) {
+	for _, boundary := range []string{"resume", "drop", "start"} {
+		t.Run(boundary, func(t *testing.T) {
+			source := &pc58SingleChunk{}
+			out, read, path := startPipeFixture(t, source)
+			fd, err := syscall.Open(path, syscall.O_WRONLY|syscall.O_NONBLOCK, 0)
+			if err != nil {
+				t.Fatal(err)
+			}
+			filled := 0
+			for {
+				n, e := syscall.Write(fd, make([]byte, 4096))
+				if n > 0 {
+					filled += n
+				}
+				if e == syscall.EAGAIN {
+					break
+				}
+				if e != nil {
+					t.Fatal(e)
+				}
+			}
+			syscall.Close(fd)
+			freed := make([]byte, 4096)
+			if n, e := syscall.Read(int(read.Fd()), freed); e != nil || n != len(freed) {
+				t.Fatal(n, e)
+			}
+			if err = out.Resume(); err != nil {
+				t.Fatal(err)
+			}
+			pc58WaitWrite(t)
+			if err = out.Pause(); err != nil {
+				t.Fatal(err)
+			}
+			remaining := len(out.pendingPCM)
+			total := 4 * 4096
+			written := total - remaining
+			if remaining <= 0 {
+				t.Fatal("fixture did not interrupt pending PCM")
+			}
+			// Drain only after Pause has joined, then resume with the same real FD.
+			got := make([]byte, 0)
+			buffer := make([]byte, 65536)
+			for {
+				n, e := syscall.Read(int(read.Fd()), buffer)
+				if n > 0 {
+					got = append(got, buffer[:n]...)
+				}
+				if e == syscall.EAGAIN {
+					break
+				}
+				if e != nil {
+					t.Fatal(e)
+				}
+			}
+			filler := filled - len(freed)
+			if len(got) != filler+written {
+				t.Fatal("partial write accounting", len(got), filler, written)
+			}
+			got = got[filler:]
+			before := out.openedWriter
+			switch boundary {
+			case "drop":
+				if err = out.Drop(); err != nil {
+					t.Fatal(err)
+				}
+			case "start":
+				out.FenceStart()
+				if err = out.WithStartLock(context.Background(), func(_ PipeIdentity, pause func(bool)) error { pause(true); return nil }); err != nil {
+					t.Fatal(err)
+				}
+			}
+			if boundary == "start" {
+				err = out.WithStartLock(context.Background(), func(_ PipeIdentity, pause func(bool)) error { pause(false); return nil })
+			} else {
+				err = out.Resume()
+			}
+			if err != nil {
+				t.Fatal(err)
+			}
+			until := time.Now().Add(time.Second)
+			for time.Now().Before(until) {
+				n, e := syscall.Read(int(read.Fd()), buffer)
+				if n > 0 {
+					got = append(got, buffer[:n]...)
+				}
+				if e != nil && e != syscall.EAGAIN {
+					t.Fatal(e)
+				}
+				paused := false
+				if out.lock.TryLock() {
+					paused = out.paused
+					out.lock.Unlock()
+				}
+				if paused {
+					for {
+						n, e := syscall.Read(int(read.Fd()), buffer)
+						if n > 0 {
+							got = append(got, buffer[:n]...)
+						}
+						if e == syscall.EAGAIN {
+							break
+						}
+						if e != nil {
+							t.Fatal(e)
+						}
+					}
+					break
+				}
+				time.Sleep(time.Millisecond)
+			}
+			expected := written
+			if boundary == "resume" {
+				expected = total
+			}
+			if len(got) != expected {
+				t.Fatalf("%s emitted %d bytes, want %d", boundary, len(got), expected)
+			}
+			for i := 0; i < len(got); i += 4 {
+				if !bytes.Equal(got[i:i+4], []byte{0, 0, 128, 62}) {
