+// A control announces its boundary before joining the audio mutex. Keeping
+// Resume in this same control order prevents it clearing another command's
+// cancellation deadline and allowing a blocked write to start again.
+func (out *pipeOutput) lockControl() error {
+	out.control.Lock()
+	out.controlPending.Store(true)
+	if !out.fileClosed {
+		if err := out.file.SetWriteDeadline(time.Now()); err != nil && !errors.Is(err, os.ErrClosed) {
+			out.controlPending.Store(false)
+			out.control.Unlock()
+			return err
+		}
+	}
+	out.lock.Lock()
+	return nil
+}
+func (out *pipeOutput) unlockControl() error {
+	var err error
+	if !out.fileClosed {
+		err = out.file.SetWriteDeadline(time.Time{})
+	}
+	out.controlPending.Store(false)
+	out.cond.Broadcast()
+	out.lock.Unlock()
+	out.control.Unlock()
+	return err
+}
