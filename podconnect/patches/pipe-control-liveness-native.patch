diff --git a/player/pipe_liveness_test.go b/player/pipe_liveness_test.go
new file mode 100644
--- /dev/null
+++ b/player/pipe_liveness_test.go
@@ -0,0 +1,196 @@
+package player
+
+import (
+	"io"
+	"sync/atomic"
+	"syscall"
+	"testing"
+	"time"
+
+	librespot "github.com/devgianlu/go-librespot"
+	"github.com/devgianlu/go-librespot/output"
+)
+
+type replacementPCM struct {
+	reads   atomic.Int32
+	entered chan struct{}
+}
+
+func (s *replacementPCM) Read(samples []float32) (int, error) {
+	if s.reads.Add(1) == 1 {
+		close(s.entered)
+		for i := range samples {
+			samples[i] = 0.5
+		}
+		return len(samples), io.EOF
+	}
+	return 0, io.EOF
+}
+func (*replacementPCM) PositionMs() int64         { return 0 }
+func (*replacementPCM) SetPositionMs(int64) error { return nil }
+
+type replacementOutput struct {
+	output.Output
+	next    *replacementPCM
+	dropped bool
+	bad     bool
+}
+
+func (o *replacementOutput) WithSourceChange(apply func(func(bool)) error) error {
+	return o.Output.(interface {
+		WithSourceChange(func(func(bool)) error) error
+	}).WithSourceChange(func(setPaused func(bool)) error {
+		if o.next != nil {
+			o.bad = o.next.reads.Load() != 0
+			o.dropped = true
+		}
+		return apply(setPaused)
+	})
+}
+func (o *replacementOutput) Drop() error {
+	if o.next != nil {
+		o.bad = o.next.reads.Load() != 0
+		o.dropped = true
+	}
+	return o.Output.Drop()
+}
+func (o *replacementOutput) Resume() error {
+	err := o.Output.Resume()
+	// Force the former Resume-before-Drop ordering to expose a consumed new
+	// chunk. The corrected caller drops while still paused, so never waits here.
+	if o.next != nil && !o.dropped {
+		select {
+		case <-o.next.entered:
+		case <-time.After(time.Second):
+		}
+	}
+	return err
+}
+func TestPipeReplacementDropsOldSuffixBeforeReadingNewSource(t *testing.T) {
+	var actual *replacementOutput
+	path := queueFIFO(t)
+	p, err := NewPlayer(&Options{Log: &librespot.NullLogger{}, AudioBackend: "pipe", AudioOutputPipe: path, AudioOutputPipeFormat: "s16le", ExternalVolume: true, WithNewOutput: func(create func() (output.Output, error)) (output.Output, error) {
+		out, err := create()
+		if err != nil {
+			return nil, err
+		}
+		actual = &replacementOutput{Output: out}
+		return actual, nil
+	}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer p.Close()
+	if err = p.SetPrimaryStream(&queueEOFSource{1}, true, false); err != nil {
+		t.Fatal(err)
+	}
+	next := &replacementPCM{entered: make(chan struct{})}
+	actual.next = next
+	if err = p.SetPrimaryStream(next, false, true); err != nil {
+		t.Fatal(err)
+	}
+	if actual.bad || !actual.dropped {
+		t.Fatal("new source consumed before old suffix was discarded")
+	}
+	select {
+	case <-next.entered:
+	case <-time.After(time.Second):
+		t.Fatal("replacement never resumed")
+	}
+	fd, e := syscall.Open(path, syscall.O_RDONLY|syscall.O_NONBLOCK, 0)
+	if e != nil {
+		t.Fatal(e)
+	}
+	defer syscall.Close(fd)
+	got := make([]byte, 0)
+	buffer := make([]byte, 8192)
+	until := time.Now().Add(time.Second)
+	for len(got) < 8192 && time.Now().Before(until) {
+		n, e := syscall.Read(fd, buffer)
+		if n > 0 {
+			got = append(got, buffer[:n]...)
+		}
+		if e != nil && e != syscall.EAGAIN {
+			t.Fatal(e)
+		}
+		time.Sleep(time.Millisecond)
+	}
+	if len(got) != 8192 {
+		t.Fatalf("first replacement chunk lost: got %d bytes", len(got))
+	}
+	for i := 0; i < len(got); i += 2 {
+		if got[i] != 0 || got[i+1] != 64 {
+			t.Fatal("old or corrupted PCM crossed source replacement")
+		}
+	}
+
+}
+
+type seekPCM struct {
+	reads   atomic.Int32
+	seeked  atomic.Bool
+	entered chan struct{}
+	after   chan struct{}
+}
+
+func (s *seekPCM) Read(samples []float32) (int, error) {
+	if s.reads.Add(1) == 1 {
+		close(s.entered)
+	}
+	if s.seeked.Load() {
+		select {
+		case <-s.after:
+		default:
+			close(s.after)
+		}
+	}
+	for i := range samples {
+		samples[i] = 0.25
+	}
+	return len(samples), nil
+}
+func (*seekPCM) PositionMs() int64           { return 0 }
+func (s *seekPCM) SetPositionMs(int64) error { s.seeked.Store(true); return nil }
+func TestPipeSeekPreservesPausedStateAndDoesNotWaitForConsumer(t *testing.T) {
+	for _, paused := range []bool{true, false} {
+		t.Run(map[bool]string{true: "paused", false: "playing"}[paused], func(t *testing.T) {
+			p, err := NewPlayer(&Options{Log: &librespot.NullLogger{}, AudioBackend: "pipe", AudioOutputPipe: queueFIFO(t), AudioOutputPipeFormat: "s16le", ExternalVolume: true})
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer p.Close()
+			source := &seekPCM{entered: make(chan struct{}), after: make(chan struct{})}
+			if err = p.SetPrimaryStream(source, paused, true); err != nil {
+				t.Fatal(err)
+			}
+			if !paused {
+				select {
+				case <-source.entered:
+				case <-time.After(time.Second):
+					t.Fatal("active source did not read")
+				}
+			}
+			done := make(chan error, 1)
+			go func() { done <- p.SeekMs(500) }()
+			select {
+			case err = <-done:
+				if err != nil {
+					t.Fatal(err)
+				}
+			case <-time.After(time.Second):
+				t.Fatal("seek blocked without FIFO consumer")
+			}
+			if paused {
+				if source.reads.Load() != 0 {
+					t.Fatal("paused seek read or resumed source")
+				}
+			} else {
+				select {
+				case <-source.after:
+				case <-time.After(time.Second):
+					t.Fatal("playing seek lost resumed output state")
+				}
+			}
+		})
+	}
+}
