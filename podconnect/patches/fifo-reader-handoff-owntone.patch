@@ -46,6 +46,30 @@ static int fixture_service_bind(struct net_socket *socket, unsigned short *port,
 #include "../src/outputs/streaming.c"
 #include "../src/player.c"
 
+/* The input command closes its real old reader before opening the successor.
+ * Schedule the pipe watcher's independent reset-close in that exact interval.
+ * No C output/session result is substituted; the FIFO write is a real syscall. */
+static atomic_int fixture_handoff_old_reader = -1;
+static atomic_int fixture_handoff_watcher = -1;
+static atomic_int fixture_handoff_writer = -1;
+static atomic_int fixture_handoff_write_result = -2;
+static atomic_int fixture_handoff_write_errno;
+int __real_close(int);
+int __wrap_close(int fd)
+{
+  int result=__real_close(fd),saved_errno=errno;
+  int expected=fd;
+  if(fd>=0 && atomic_compare_exchange_strong(&fixture_handoff_old_reader,&expected,-1)){
+    int watcher=atomic_exchange(&fixture_handoff_watcher,-1);
+    assert(watcher>=0 && __real_close(watcher)==0);
+    errno=0;
+    ssize_t written=write(atomic_load(&fixture_handoff_writer),"p",1);
+    atomic_store(&fixture_handoff_write_errno,errno);
+    atomic_store(&fixture_handoff_write_result,(int)written);
+  }
+  errno=saved_errno;return result;
+}
