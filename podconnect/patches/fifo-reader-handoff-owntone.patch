+/* Existing input-thread command used by start_reader_install. The production
+ * watcher is independently between close and reopen; the wrapper controls that
+ * scheduling point while retaining a real old input and writer descriptor. */
+static void fifo_live_reader_handoff_case(uint32_t item,const char *path)
+{
+  struct timespec deadline;struct input_fifo_identity before={0},after={0};
+  struct stat identity,st;int old=-1,count=0;
+  int writer=open(path,O_WRONLY|O_NONBLOCK),watcher=open(path,O_RDONLY|O_NONBLOCK);
+  assert(writer>=0 && watcher>=0 && fstat(writer,&identity)==0);
+  clock_gettime(CLOCK_MONOTONIC,&deadline);deadline.tv_sec+=4;
+  assert(input_fifo_owner_get(item,path,true,identity.st_dev,identity.st_ino,&deadline,&before)==0);
+  for(int fd=0;fd<4096;fd++){
+    if(fd==watcher || fd==writer || fstat(fd,&st)<0 || !S_ISFIFO(st.st_mode)
+        || st.st_dev!=identity.st_dev || st.st_ino!=identity.st_ino)continue;
+    int flags=fcntl(fd,F_GETFL);
+    if(flags>=0 && (flags&O_ACCMODE)==O_RDONLY){old=fd;count++;}
+  }
+  assert(count==1 && old>=0);
+  void (*prior_signal)(int)=signal(SIGPIPE,SIG_IGN);assert(prior_signal!=SIG_ERR);
+  atomic_store(&fixture_handoff_watcher,watcher);
+  atomic_store(&fixture_handoff_writer,writer);
+  atomic_store(&fixture_handoff_write_result,-2);
+  atomic_store(&fixture_handoff_old_reader,old);
+  assert(input_start_fifo_exact(item,path,&deadline)>=0);
+  assert(atomic_load(&fixture_handoff_old_reader)==-1
+      && atomic_load(&fixture_handoff_watcher)==-1);
+  int written=atomic_load(&fixture_handoff_write_result);
+  fprintf(stderr,"live FIFO reader handoff write=%d errno=%d\n",written,
+      atomic_load(&fixture_handoff_write_errno));
+  assert(written==1); /* No EPIPE during input + watcher reader replacement. */
+  assert(input_fifo_owner_get(item,path,false,0,0,&deadline,&after)==0
+      && after.device==before.device && after.inode==before.inode
+      && after.epoch==before.epoch);
+  assert(input_fifo_owner_get(item,path,true,before.device,before.inode,&deadline,&after)==0
+      && after.epoch>before.epoch);
+  struct timespec expired={0};
+  uint64_t epoch=after.epoch;
+  assert(input_start_fifo_exact(item,path,&expired)<0);
+  assert(input_start_fifo_exact(item,"/not-the-owned-fifo",&deadline)<0);
+  assert(input_fifo_owner_get(item,path,false,0,0,&deadline,&after)==0
+      && after.device==before.device && after.inode==before.inode && after.epoch==epoch);
+  assert(write(writer,"p",1)==1); /* Rejected requests cannot close the live reader. */
+  assert(signal(SIGPIPE,prior_signal)!=SIG_ERR);
+  close(writer);
+  puts("PASS actual FIFO reader replacement retains an existing writer across watcher reset, with a fresh exact input epoch");
+}
