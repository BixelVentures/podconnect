@@ -1,3 +1,11 @@
+/* Resource hold only: no read, autostop change or event registration. */
+static int fifo_hold(struct input_source *source)
+{
+  struct pipe *pipe=source->input_ctx;
+  if(!pipe || pipe->fd<0)return -1;
+  return fcntl(pipe->fd,F_DUPFD_CLOEXEC,0);
+}
