+      && receipt.teardown_cseq > 0 && receipt.incarnation == route->incarnation
+      && receipt.epoch == route->epoch && receipt.route == route->revision
+      && !strcmp(receipt.process, operation->request.process) && !strcmp(receipt.operation, operation->request.action);
+  return operation->released;
