+func TestMoveHTTPRejectsDuplicateAndExtraBodyFields(t *testing.T) {
+	for _, body := range []string{
+		`{"offer_id":"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa","binding_id":"bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb","offer_id":"cccccccccccccccccccccccccccccccc"}`,
