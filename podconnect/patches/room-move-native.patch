+++ b/daemon/room_move_actor.go
@@ -0,0 +1,181 @@
+package daemon
+
+import (
+	"context"
+	"time"
+)
+
+func (p *AppPlayer) moveEffectCurrentLocked(op *moveOperation, ctx context.Context) bool {
+	if ctx.Err() != nil || op.Cancelled || op.Terminal || !time.Now().Before(op.Until) || p.roomMoveReservation == nil || p.roomMoveReservation.Operation != op || p.roomVolumeClosing || p.aliasRetired || p.roomMoveQuarantined {
+		return false
+	}
+	if !op.Switched {
+		return p.moveCurrentLocked(op.Capture)
+	}
+	c := op.Capture
+	return c.processCurrent() && p.state == c.State && p.state.player == c.PlayerState && p.state.player.SessionId == c.SessionID && p.state.device.Volume == c.StateVolume && p.state.tracks == c.Tracks && c.Tracks.TransportRevision() == c.QueueRevision && p.primaryStream == c.Primary && p.primaryStream.Source == c.Source && p.sess == c.Session && p.player == c.Player && p.spotConnId == c.Connection && p.roomNativeIntent == c.Intent && p.aliasIncarnation == c.AliasIncarnation && p.aliasFingerprint == c.Registry && p.aliasRevision == op.Intended.AliasRevision && p.state.device.SelectedAliasId == c.TargetAlias && p.state.player.IsPaused == c.Paused && p.app.cfg.AudioOutputPipe == c.Pipe && p.transportMappingCurrentLocked()
+}
+
+func (p *AppPlayer) applyMoveStep(step moveStep) error {
+	op := step.Operation
+	if op == nil {
+		return ErrAliasConflict
+	}
+	p.aliasMu.Lock()
+	op.mu.Lock()
+	valid := p.moveEffectCurrentLocked(op, step.Context) && contentAccountMatches(p.sess, op.Capture.Scope.AccountUserID)
+	if step.Phase == "quiesce" {
+		valid = valid && op.CReceipt != nil && op.CReceipt.Phase == "gate_closed_reader_ready" && op.CReceipt.GateClosed
+	}
+	if step.Phase == "switch" {
+		valid = valid && op.Quiescent && op.CReceipt != nil && op.CReceipt.Phase == "route_ready_closed" && op.CReceipt.GateClosed
+	}
+	if step.Phase == "resume" {
+		valid = valid && op.Switched && op.CReceipt != nil && op.CReceipt.Phase == "opened" && !op.CReceipt.GateClosed
+	}
+	pipe, epoch := op.Pipe, op.Epoch
+	if step.Phase == "quiesce" {
+		pipe, epoch = op.Capture.WriterPipe, op.Capture.WriterEpoch
+	}
+	op.mu.Unlock()
+	p.aliasMu.Unlock()
+	if !valid {
+		return ErrAliasConflict
+	}
+	ctx, cancel := context.WithDeadline(step.Context, op.Until)
+	defer cancel()
+	actualPipe, actualEpoch, err := p.player.RoomMove(ctx, step.Phase, op.Capture.Source, pipe, epoch, !op.Capture.Paused, func(mutate func()) error {
+		p.aliasMu.Lock()
+		defer p.aliasMu.Unlock()
+		op.mu.Lock()
+		defer op.mu.Unlock()
+		if !p.moveEffectCurrentLocked(op, ctx) || !contentAccountMatches(p.sess, op.Capture.Scope.AccountUserID) {
+			return ErrAliasConflict
+		}
+		if step.Phase == "switch" && (!op.Quiescent || op.CReceipt == nil || op.CReceipt.Phase != "route_ready_closed") {
+			return ErrAliasConflict
+		}
+		if step.Phase == "resume" && (!op.Switched || op.CReceipt == nil || op.CReceipt.Phase != "opened") {
+			return ErrAliasConflict
+		}
+		mutate()
+		if step.Phase == "switch" {
+			p.state.device.SelectedAliasId = op.Capture.TargetAlias
+			p.aliasRevision = op.Intended.AliasRevision
+			op.Switched = true
+			actualAccount, _ := p.sess.BoundUsername()
+			actual := roomTransportIdentity{actualAccount, p.app.deviceId, op.Capture.Scope.RoomID, op.Capture.Scope.HomePodID, p.spotConnId, p.state.player.SessionId, p.aliasIncarnation, p.aliasFingerprint, p.aliasRevision}
+			op.Actual = &actual
+		}
+		if step.Phase == "quiesce" {
+			op.Quiescent = true
+		}
+		return nil
+	})
+	if err != nil {
+		return err
+	}
+	op.mu.Lock()
+	op.Pipe = actualPipe
+	op.Epoch = actualEpoch
+	op.mu.Unlock()
+	return nil
+}
+
+func (op *moveOperation) actorStep(ctx context.Context, phase string) error {
+	reply := make(chan error, 1)
+	select {
+	case op.Owner.roomMoveSteps <- moveStep{op, phase, ctx, reply}:
+	case <-ctx.Done():
+		return ctx.Err()
+	}
+	return <-reply
+}
+
+func (p *AppPlayer) waitMoveReservation(ctx context.Context) bool {
+	p.aliasMu.Lock()
+	reservation := p.roomMoveReservation
+	p.aliasMu.Unlock()
+	if reservation == nil {
+		return ctx.Err() == nil
+	}
+	op := reservation.Operation
+	timer := time.NewTimer(max(0, time.Until(reservation.Until)))
+	defer timer.Stop()
+	stopRequested := false
+	for {
+		select {
+		case step := <-p.roomMoveSteps:
+			if step.Operation != op {
+				step.Reply <- ErrAliasConflict
+				continue
+			}
+			step.Reply <- p.applyMoveStep(step)
+		case <-op.TerminalSignal:
+			op.mu.Lock()
+			completed := op.State == "complete"
+			op.mu.Unlock()
+			if completed && p.primaryStream == op.Capture.Primary && p.primaryStream.Source == op.Capture.Source && p.state.player == op.Capture.PlayerState && p.state.tracks == op.Capture.Tracks && p.state.player.SessionId == op.Capture.SessionID {
+				p.emitSelectedAlias(op.Capture.TargetAlias, p.aliasBinding())
+			}
+			p.aliasMu.Lock()
+			if p.roomMoveReservation == reservation {
+				p.roomMoveReservation = nil
+			}
+			closing := p.roomVolumeClosing
+			p.aliasMu.Unlock()
+			return !closing && !stopRequested && ctx.Err() == nil
+		case <-ctx.Done():
+			stopRequested = true
+			op.mu.Lock()
+			op.OwnerClosing = true
+			op.mu.Unlock()
+			op.cancelMove()
+			go p.Close()
+			ctx = context.Background()
+		case <-timer.C:
+			op.mu.Lock()
+			possible := op.Possible
+			alreadyClosing := op.OwnerClosing
+			if possible {
+				op.OwnerClosing = true
+			}
+			pipe, epoch := op.Pipe, op.Epoch
+			if !op.Quiescent {
+				pipe, epoch = op.Capture.WriterPipe, op.Capture.WriterEpoch
+			}
+			op.mu.Unlock()
+			op.cancelMove()
+			if possible && alreadyClosing {
+				// A context-triggered Close may still be joining an old write.
+				p.Close()
+			} else if possible {
+				// The actor cannot resume ordinary dealer or player events while
+				// an unknown MOVE may still own a live FIFO writer.
+				fenceCtx, stopFence := context.WithTimeout(context.Background(), time.Second)
+				_, _, fenceErr := p.player.RoomMove(fenceCtx, "fence", nil, pipe, epoch, false, nil)
+				stopFence()
+				if fenceErr != nil {
+					// Close joins the actual writer FD before this actor exits.
+					p.player.Close()
+				}
+				go p.Close()
+			}
+			if possible {
+				op.finish("unknown")
+			} else {
+				op.finish("cancelled")
+			}
+			p.aliasMu.Lock()
+			if possible {
+				p.roomMoveQuarantined = true
+			}
+			if p.roomMoveReservation == reservation {
+				p.roomMoveReservation = nil
+			}
+			closing := p.roomVolumeClosing
+			p.aliasMu.Unlock()
+			return !possible && !closing && !stopRequested && ctx.Err() == nil
+		}
+	}
+}
