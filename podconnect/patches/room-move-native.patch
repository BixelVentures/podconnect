diff --git a/output/room_move.go b/output/room_move.go
new file mode 100644
index 0000000..25e47be
--- /dev/null
+++ b/output/room_move.go
@@ -0,0 +1,33 @@
+package output
+
+import "strconv"
+
+// MovePipeIdentity is the actual writer descriptor and its fstat identity.
+// FD is a private transport proof, never a pathname or public control field.
+type MovePipeIdentity struct {
+	PipeIdentity
+	FD string
+}
+
+// MovePipeOutput exposes only state already owned by the pipe lock. Callers must
+// invoke both methods from within WithStartLock's callback; the lock joins any
+// in-flight reader or FIFO writer before the state is observed or changed.
+type MovePipeOutput interface {
+	StartPipeOutput
+	PausedUnderStartLock() bool
+	FencedUnderStartLock() bool
+	WriterFDUnderStartLock() string
+	SetMoveStateUnderStartLock(paused, fenced bool)
+}
+
+func (out *pipeOutput) PausedUnderStartLock() bool { return out.paused }
+func (out *pipeOutput) FencedUnderStartLock() bool { return out.startFenced.Load() }
+func (out *pipeOutput) WriterFDUnderStartLock() string {
+	return strconv.FormatUint(uint64(out.file.Fd()), 10)
+}
+
+func (out *pipeOutput) SetMoveStateUnderStartLock(paused, fenced bool) {
+	out.paused = paused
+	out.startFenced.Store(fenced)
+	out.cond.Broadcast()
+}
