index 0000000..201393c
--- /dev/null
+++ b/daemon/room_move_execute.go
@@ -0,0 +1,253 @@
+package daemon
+
+import (
+	"context"
+	"time"
+)
+
+func (op *moveOperation) cancelMove() {
+	op.mu.Lock()
+	if op.Terminal && op.State == "complete" {
+		op.mu.Unlock()
+		return
+	}
+	op.Cancelled = true
+	cancel := op.Cancel
+	token, reservation := "", op.ReservationID
+	if op.CReceipt != nil && !op.CancelSent {
+		token = op.CReceipt.Token
+		op.CancelSent = true
+	}
+	possible := op.Possible
+	terminal := op.Terminal
+	op.mu.Unlock()
+	if cancel != nil {
+		cancel()
+	}
+	if token != "" {
+		go func() {
+			ctx, stop := context.WithTimeout(context.Background(), time.Second)
+			defer stop()
+			_, _ = op.cCall(ctx, "POST", "cancel", struct {
+				Token       string `json:"token"`
+				Reservation string `json:"native_reservation_id"`
+			}{token, reservation})
+		}()
+	}
+	if !possible && !terminal {
+		op.finish("cancelled")
+	}
+}
+
+func (op *moveOperation) cPoll(ctx context.Context, reply moveCReceipt, want string) (moveCReceipt, error) {
+	for reply.Phase != want {
+		if reply.Phase == "unknown" || reply.Phase == "rejected_before_admission" || reply.Phase == "expired_before_admission" || reply.Phase == "cancelled_before_admission" {
+			return reply, ErrAliasConflict
+		}
+		timer := time.NewTimer(50 * time.Millisecond)
+		select {
+		case <-timer.C:
+		case <-ctx.Done():
+			timer.Stop()
+			return reply, ctx.Err()
+		}
+		var err error
+		reply, err = op.cCall(ctx, "GET", "result/"+reply.Token, nil)
+		if err != nil {
+			return reply, err
+		}
+	}
+	return reply, nil
+}
+
+func (op *moveOperation) prepare(ctx context.Context) {
+	op.mu.Lock()
+	if !op.Claimed || op.Cancelled || op.Terminal || op.State != "staging" {
+		op.mu.Unlock()
+		return
+	}
+	op.mu.Unlock()
+	prepared, err := op.cCall(ctx, "POST", "prepare", op.cPrepareBody())
+	if err != nil || prepared.Phase != "prepared" {
+		op.finish("rejected")
+		return
+	}
+	op.mu.Lock()
+	if op.Cancelled || op.Terminal || ctx.Err() != nil {
+		op.mu.Unlock()
+		op.cancelMove()
+		return
+	}
+	op.State = "staged"
+	op.StagedUntil = time.Now().Add(8 * time.Second)
+	op.mu.Unlock()
+}
+
+func (op *moveOperation) commit(parent context.Context, server *ConcreteApiServer) {
+	op.mu.Lock()
+	if !op.Claimed || op.CommitClaimed || op.Cancelled || op.Terminal || op.State != "staged" || !time.Now().Before(op.StagedUntil) {
+		op.mu.Unlock()
+		return
+	}
+	op.CommitClaimed = true
+	op.State = "committing"
+	ctx, cancel := context.WithTimeout(parent, 14*time.Second)
+	op.Cancel = cancel
+	op.mu.Unlock()
+	defer cancel()
+	failed := func() {
+		op.mu.Lock()
+		possible := op.Possible
+		reply := op.CReceipt
+		cancelled := op.Cancelled || ctx.Err() != nil
+		switched := op.Switched
+		ownerClosing := op.OwnerClosing
+		pipe, epoch := op.Pipe, op.Epoch
+		if !op.Quiescent {
+			pipe, epoch = op.Capture.WriterPipe, op.Capture.WriterEpoch
+		}
+		op.mu.Unlock()
+		if possible && !ownerClosing {
+			// Unknown C status cannot leave the same actual native writer free
+			// to emit. The independent C cancel closes its global gate.
+			fenceCtx, stopFence := context.WithTimeout(context.Background(), time.Second)
+			_, _, fenceErr := op.Owner.player.RoomMove(fenceCtx, "fence", nil, pipe, epoch, false, nil)
+			stopFence()
+			if fenceErr != nil {
+				go op.Owner.Close()
+			}
+			op.cancelMove()
+		}
+		if possible || switched {
+			op.Owner.aliasMu.Lock()
+			op.Owner.roomMoveQuarantined = true
+			op.Owner.aliasMu.Unlock()
+			op.finish("unknown")
+		} else {
+			state := "rejected"
+			if cancelled {
+				state = "cancelled"
+			}
+			if reply != nil && reply.Possible {
+				state = "unknown"
+			}
+			op.finish(state)
+		}
+	}
+	if ctx.Err() != nil {
+		failed()
+		return
+	}
+	prepared := op.CReceipt
+	if prepared == nil || prepared.Phase != "prepared" {
+		failed()
+		return
+	}
+	_, err := server.roomTransportAsk(ctx, apiMoveConsume, moveActorRequest{Operation: op, Context: ctx})
+	if err != nil {
+		op.cancelMove()
+		failed()
+		return
+	}
+	critical, stopCritical := context.WithDeadline(ctx, op.Until)
+	defer stopCritical()
+	op.mu.Lock()
+	op.Possible = true
+	op.mu.Unlock()
+	reply, err := op.cCall(critical, "POST", "commit", struct {
+		Incarnation string                `json:"native_incarnation"`
+		Old         roomTransportIdentity `json:"old_native_owner"`
+		Offer       string                `json:"offer_id"`
+		Binding     string                `json:"binding_id"`
+		Revision    string                `json:"native_revision"`
+		Token       string                `json:"token"`
+		Reservation string                `json:"native_reservation_id"`
+		Drained     bool                  `json:"pending_native_mutators_drained"`
+	}{op.Capture.Incarnation, *op.Capture.OldOwner, op.Offer.OfferID, op.Offer.BindingID, op.Revision, prepared.Token, op.ReservationID, true})
+	if err == nil {
+		reply, err = op.cPoll(critical, reply, "gate_closed_reader_ready")
+	}
+	if err != nil || reply.Pipe == nil || reply.Pipe.Device != op.Capture.WriterPipe.Device || reply.Pipe.Inode != op.Capture.WriterPipe.Inode || reply.Pipe.Type != "fifo" {
+		failed()
+		return
+	}
+	if err = op.actorStep(critical, "quiesce"); err != nil {
+		failed()
+		return
+	}
+	op.mu.Lock()
+	pipe, epoch := op.Pipe, op.Epoch
+	op.mu.Unlock()
+	reply, err = op.cCall(critical, "POST", "barrier", struct {
+		Token       string `json:"token"`
+		Reservation string `json:"native_reservation_id"`
+		Epoch       string `json:"writer_source_epoch"`
+		Pipe        any    `json:"pipe_identity"`
+		Digest      string `json:"expected_input_path_digest"`
+		Quiescent   bool   `json:"writer_quiescent"`
+	}{prepared.Token, op.ReservationID, epoch, pipe.PipeIdentity, op.Capture.PipeDigest, true})
+	if err == nil {
+		reply, err = op.cPoll(critical, reply, "route_ready_closed")
+	}
+	if err != nil {
+		failed()
+		return
+	}
+	if err = op.actorStep(critical, "switch"); err != nil {
+		failed()
+		return
+	}
+	op.mu.Lock()
+	actual := op.Actual
+	op.mu.Unlock()
+	if actual == nil {
+		failed()
+		return
+	}
+	reply, err = op.cCall(critical, "POST", "open", struct {
+		Token       string                `json:"token"`
+		Reservation string                `json:"native_reservation_id"`
+		Epoch       string                `json:"writer_source_epoch"`
+		Actual      roomTransportIdentity `json:"committed_native_owner"`
+	}{prepared.Token, op.ReservationID, epoch, *actual})
+	if err != nil || reply.Phase != "opened" {
+		failed()
+		return
+	}
+	if err = op.actorStep(critical, "resume"); err != nil {
+		failed()
+		return
+	}
+	reply, err = op.cCall(ctx, "POST", "complete", struct {
+		Token       string                `json:"token"`
+		Reservation string                `json:"native_reservation_id"`
+		Epoch       string                `json:"writer_source_epoch"`
+		Actual      roomTransportIdentity `json:"committed_native_owner"`
+		Drained     bool                  `json:"native_mutators_drained"`
+	}{prepared.Token, op.ReservationID, epoch, *actual, true})
+	if err != nil || reply.Phase != "completed" {
+		failed()
+		return
+	}
+	// Join the real writer/source and credit completion within one output/source
+	// lock boundary. Actor metadata can lag an EOF/autoplay replacement.
+	_, _, err = op.Owner.player.RoomMove(ctx, "verify", op.Capture.Source, op.Pipe, op.Epoch, !op.Capture.Paused, func(mutate func()) error {
+		op.Owner.aliasMu.Lock()
+		defer op.Owner.aliasMu.Unlock()
+		op.mu.Lock()
+		defer op.mu.Unlock()
+		if op.Cancelled || op.Terminal || op.CReceipt == nil || op.CReceipt.Phase != "completed" || !op.Owner.moveEffectCurrentLocked(op, ctx) || op.Actual == nil || *op.Actual != op.Intended || op.Epoch == "" || op.Pipe != op.Capture.WriterPipe {
+			return ErrAliasConflict
+		}
+		mutate()
+		op.State = "complete"
+		op.Terminal = true
+		op.RetainUntil = time.Now().Add(time.Minute)
+		close(op.TerminalSignal)
+		return nil
+	})
+	if err != nil {
+		failed()
+		return
+	}
+}
