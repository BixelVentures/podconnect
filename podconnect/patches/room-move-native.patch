diff --git a/player/room_move.go b/player/room_move.go
new file mode 100644
index 0000000..92a9711
--- /dev/null
+++ b/player/room_move.go
@@ -0,0 +1,177 @@
+package player
+
+import (
+	"context"
+	"fmt"
+	"strconv"
+	"sync"
+
+	librespot "github.com/devgianlu/go-librespot"
+	"github.com/devgianlu/go-librespot/output"
+)
+
+type roomMoveCommand struct {
+	ctx            context.Context
+	phase          string
+	expectedSource librespot.AudioSource
+	pipe           output.MovePipeIdentity
+	epoch          string
+	wasPlaying     bool
+	guard          output.TransportGuard
+}
+
+type roomMoveResult struct {
+	Pipe  output.MovePipeIdentity
+	Epoch string
+	Err   error
+}
+
+// RoomMove serializes each phase through the player worker. The switch phase
+// invokes guard while the real FIFO and source locks are held. The guard owner
+// may synchronously mutate only its already validated native destination alias;
+// this method never replaces, closes, seeks, or restarts the audio source.
+func (p *Player) RoomMove(ctx context.Context, phase string, expectedSource librespot.AudioSource, pipe output.MovePipeIdentity, epoch string, wasPlaying bool, guard output.TransportGuard) (output.MovePipeIdentity, string, error) {
+	if ctx == nil {
+		return output.MovePipeIdentity{}, "", fmt.Errorf("move context required")
+	}
+	reply := make(chan any, 1)
+	command := &roomMoveCommand{ctx: ctx, phase: phase, expectedSource: expectedSource, pipe: pipe, epoch: epoch, wasPlaying: wasPlaying, guard: guard}
+	select {
+	case p.cmd <- playerCmd{move: command, resp: reply}:
+	case <-ctx.Done():
+		return output.MovePipeIdentity{}, "", ctx.Err()
+	}
+	result := (<-reply).(roomMoveResult)
+	return result.Pipe, result.Epoch, result.Err
+}
+
+func (p *Player) applyRoomMove(command *roomMoveCommand, out *output.Output, source *SwitchingAudioSource) (result roomMoveResult, err error) {
+	if command.ctx == nil || (command.expectedSource == nil && command.phase != "fence") || (command.guard == nil && command.phase != "snapshot" && command.phase != "abort" && command.phase != "fence") {
+		return result, fmt.Errorf("incomplete move command")
+	}
+	if command.phase != "snapshot" && command.phase != "quiesce" && command.phase != "switch" && command.phase != "resume" && command.phase != "abort" && command.phase != "fence" && command.phase != "verify" {
+		return result, fmt.Errorf("bad move phase")
+	}
+	if *out == nil {
+		return result, fmt.Errorf("no existing pipe output")
+	}
+	pipe, ok := (*out).(output.MovePipeOutput)
+	if !ok {
+		return result, fmt.Errorf("move pipe owner unavailable")
+	}
+	if command.phase == "snapshot" && p.movePhase != "" && p.movePhase != "snapshot" {
+		return result, fmt.Errorf("move already active")
+	}
+	if command.phase == "quiesce" {
+		if p.movePhase != "snapshot" || p.startEpoch == ^uint64(0) {
+			return result, fmt.Errorf("move snapshot unavailable or epoch exhausted")
+		}
+	}
+	err = pipe.WithStartLock(command.ctx, func(identity output.PipeIdentity, _ func(bool)) error {
+		lock, ok := source.cond.L.(*sync.Mutex)
+		if !ok {
+			return fmt.Errorf("native source lock unavailable")
+		}
+		if e := output.LockTransport(command.ctx, lock); e != nil {
+			return e
+		}
+		defer lock.Unlock()
+		if e := command.ctx.Err(); e != nil {
+			return e
+		}
+		if command.phase != "fence" && source.source[source.which] != command.expectedSource {
+			return fmt.Errorf("native primary source changed")
+		}
+		if identity.Type != "fifo" {
+			return fmt.Errorf("actual output descriptor is not FIFO")
+		}
+		writer := output.MovePipeIdentity{PipeIdentity: identity, FD: pipe.WriterFDUnderStartLock()}
+		fd, e := strconv.ParseUint(writer.FD, 10, 64)
+		if e != nil || writer.FD == "" || strconv.FormatUint(fd, 10) != writer.FD {
+			return fmt.Errorf("actual output writer descriptor unavailable")
+		}
+		currentEpoch := strconv.FormatUint(p.startEpoch, 10)
+		if command.phase == "verify" {
+			if p.movePhase != "" || writer != command.pipe || command.epoch == "" || command.epoch != currentEpoch || pipe.PausedUnderStartLock() == command.wasPlaying || pipe.FencedUnderStartLock() {
+				return fmt.Errorf("move final source, writer, or paused state changed")
+			}
+			return command.guard(func() { result.Pipe, result.Epoch = writer, currentEpoch })
+		}
+		if command.phase == "fence" {
+			if writer != command.pipe || command.epoch == "" || command.epoch != currentEpoch {
+				return fmt.Errorf("move fail-closed writer identity changed")
+			}
+			pipe.FenceStart()
+			pipe.SetMoveStateUnderStartLock(true, true)
+			result.Pipe, result.Epoch = writer, currentEpoch
+			return nil
+		}
+		if command.phase != "snapshot" {
+			if writer != command.pipe || command.pipe.Type != "fifo" || command.epoch == "" || command.epoch != currentEpoch || p.movePipe != writer || p.moveSource != command.expectedSource || p.movePlaying != command.wasPlaying {
+				return fmt.Errorf("move FIFO, writer epoch, source, or state changed")
+			}
+		}
+		if command.phase == "snapshot" {
+			if pipe.PausedUnderStartLock() == command.wasPlaying {
+				return fmt.Errorf("actual pipe pause state changed")
+			}
+			commit := func() {
+				p.movePhase = "snapshot"
+				p.movePipe = writer
+				p.moveSource = command.expectedSource
+				p.movePlaying = command.wasPlaying
+				result.Pipe, result.Epoch = writer, currentEpoch
+			}
+			if command.guard == nil {
+				commit()
+				return nil
+			}
+			return command.guard(commit)
+		}
+		if (command.phase == "quiesce" && p.movePhase != "snapshot") || (command.phase == "switch" && p.movePhase != "quiesced") || (command.phase == "resume" && p.movePhase != "switched") || (command.phase == "abort" && p.movePhase != "snapshot" && p.movePhase != "quiesced") {
+			return fmt.Errorf("move phase out of order")
+		}
+		if (command.phase == "switch" || command.phase == "resume" || (command.phase == "abort" && p.movePhase == "quiesced")) && (!pipe.PausedUnderStartLock() || !pipe.FencedUnderStartLock()) {
+			return fmt.Errorf("move quiescence was lost")
+		}
+		if command.phase == "abort" {
+			if p.movePhase == "quiesced" {
+				pipe.SetMoveStateUnderStartLock(!p.movePlaying, false)
+			}
+			p.movePhase = ""
+			p.moveSource = nil
+			p.movePipe = output.MovePipeIdentity{}
+			result.Pipe, result.Epoch = writer, currentEpoch
+			return nil
+		}
+		if command.phase == "quiesce" && pipe.PausedUnderStartLock() == command.wasPlaying {
+			return fmt.Errorf("actual pipe pause state changed")
+		}
+		return command.guard(func() {
+			switch command.phase {
+			case "quiesce":
+				// The lock has joined any blocked Read or Write. Fence and pause
+				// before releasing it; no bytes can cross the later switch.
+				pipe.FenceStart()
+				pipe.SetMoveStateUnderStartLock(true, true)
+				p.startEpoch++
+				p.movePhase = "quiesced"
+			case "switch":
+				// The guard owns the synchronous alias mutation. The source and
+				// FIFO writer remain the same through this phase.
+				p.movePhase = "switched"
+			case "resume":
+				pipe.SetMoveStateUnderStartLock(!p.movePlaying, false)
+				p.movePhase = ""
+				p.moveSource = nil
+				p.movePipe = output.MovePipeIdentity{}
+			}
+			result.Pipe = writer
+			result.Epoch = strconv.FormatUint(p.startEpoch, 10)
+		})
+	})
+	if err == nil && result.Pipe.Type == "" {
+		err = fmt.Errorf("move guard did not commit")
+	}
+	return result, err
+}
