+	} {
+		request := httptest.NewRequest(http.MethodPost, "/player/room_move/commit", strings.NewReader(body))
+		response := httptest.NewRecorder()
+		var ids moveIDRequest
+		if moveBody(response, request, &ids, "offer_id", "binding_id") || response.Code != http.StatusBadRequest {
+			t.Fatalf("unexpected acceptance of body %s: status %d", body, response.Code)
+		}
