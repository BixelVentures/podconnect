@@ -0,0 +1,196 @@
+package daemon
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"io"
+	"net/http"
+	"time"
+)
+
+// moveBody checks the closed MOVE request before it can reach the actor. In
+// particular, a duplicate JSON key cannot silently replace a captured grant.
+func moveBody(w http.ResponseWriter, r *http.Request, out any, keys ...string) bool {
+	if r.Method != http.MethodPost {
+		w.WriteHeader(http.StatusMethodNotAllowed)
+		return false
+	}
+	if r.URL.RawQuery != "" {
+		w.WriteHeader(http.StatusBadRequest)
+		return false
+	}
+	defer r.Body.Close()
+	raw, err := io.ReadAll(io.LimitReader(r.Body, 8193))
+	if err != nil || len(raw) > 8192 {
+		w.WriteHeader(http.StatusBadRequest)
+		return false
+	}
+	var fields map[string]json.RawMessage
+	if strictVolumeJSON(raw, &fields) != nil || len(fields) != len(keys) {
+		w.WriteHeader(http.StatusBadRequest)
+		return false
+	}
+	for _, key := range keys {
+		if _, ok := fields[key]; !ok {
+			w.WriteHeader(http.StatusBadRequest)
+			return false
+		}
+	}
+	if value, ok := fields["args"]; ok {
+		var args map[string]json.RawMessage
+		if !bytes.HasPrefix(bytes.TrimSpace(value), []byte("{")) || json.Unmarshal(value, &args) != nil || len(args) != 0 {
+			w.WriteHeader(http.StatusBadRequest)
+			return false
+		}
+	}
+	if strictContentJSON(raw, out) != nil {
+		w.WriteHeader(http.StatusBadRequest)
+		return false
+	}
+	return true
+}
+
+func moveWrite(w http.ResponseWriter, value moveReceipt) {
+	w.Header().Set("Content-Type", "application/json")
+	w.Header().Set("Cache-Control", "no-store")
+	_ = json.NewEncoder(w).Encode(value)
+}
+
+func (s *ConcreteApiServer) handleMoveControls(w http.ResponseWriter, r *http.Request) {
+	if r.Method != http.MethodGet {
+		w.WriteHeader(http.StatusMethodNotAllowed)
+		return
+	}
+	q := r.URL.Query()
+	if len(q) != 4 {
+		w.WriteHeader(http.StatusBadRequest)
+		return
+	}
+	for _, key := range []string{"account_user_id", "target_id", "room_id", "homepod_id"} {
+		if len(q[key]) != 1 || q.Get(key) == "" || len(q.Get(key)) > 160 {
+			w.WriteHeader(http.StatusBadRequest)
+			return
+		}
+	}
+	scope := roomVolumeScope{q.Get("account_user_id"), q.Get("target_id"), q.Get("room_id"), q.Get("homepod_id")}
+	ctx, cancel := context.WithTimeout(r.Context(), 3*time.Second)
+	defer cancel()
+	value, err := s.roomTransportAsk(ctx, apiMoveObserve, scope)
+	if err != nil {
+		roomTransportResponse(w, nil, err)
+		return
+	}
+	capture, ok := value.(*moveCapture)
+	if !ok || capture == nil || capture.OldOwner == nil {
+		roomTransportResponse(w, nil, ErrAliasConflict)
+		return
+	}
+	state, err := capture.readCState(ctx)
+	if err != nil {
+		roomTransportResponse(w, nil, ErrAliasConflict)
+		return
+	}
+	value, err = s.roomTransportAsk(ctx, apiMoveOffer, moveOfferActorRequest{Capture: capture, State: state, Context: ctx})
+	if err != nil {
+		roomTransportResponse(w, nil, err)
+		return
+	}
+	op, ok := value.(*moveOperation)
+	if !ok || op == nil || !s.roomMoves.put(op) {
+		roomTransportResponse(w, nil, ErrAliasConflict)
+		return
+	}
+	roomTransportResponse(w, struct {
+		Schema   string                 `json:"schema"`
+		Ready    bool                   `json:"ready"`
+		Scope    roomVolumeScope        `json:"scope"`
+		Actions  []string               `json:"actions"`
+		Offer    moveOffer              `json:"move_offer"`
+		Physical bool                   `json:"physical_result_verified"`
+		Registry string                 `json:"alias_registry"`
+		Digest   string                 `json:"input_path_digest"`
+		OwnTone  string                 `json:"own_tone_url"`
+		OldOwner *roomTransportIdentity `json:"old_native_owner"`
+	}{"podconnect.native_room_move_controls.v1", true, scope, []string{"move_existing_session"}, op.Offer, false, capture.Registry, capture.PipeDigest, capture.OwnTone, capture.OldOwner}, nil)
+}
+
+func (s *ConcreteApiServer) handleMovePrepare(w http.ResponseWriter, r *http.Request) {
+	var request movePrepareRequest
+	if !moveBody(w, r, &request, "scope", "move_offer", "action", "args") {
+		return
+	}
+	if request.Action != "move_existing_session" || !volumeHex32.MatchString(request.Offer.OfferID) || !volumeHex64.MatchString(request.Offer.BindingID) {
+		w.WriteHeader(http.StatusBadRequest)
+		return
+	}
+	op := s.roomMoves.get(request.Offer.OfferID, request.Offer.BindingID)
+	if op == nil {
+		w.WriteHeader(http.StatusConflict)
+		return
+	}
+	ctx, cancel := context.WithTimeout(r.Context(), 8*time.Second)
+	defer cancel()
+	_, err := s.roomTransportAsk(ctx, apiMoveClaim, moveActorRequest{Operation: op, Context: ctx, Request: request})
+	if err != nil {
+		roomTransportResponse(w, nil, err)
+		return
+	}
+	// Prepare captures C/actor provenance only; physical routing belongs to commit.
+	op.prepare(ctx)
+	moveWrite(w, op.receipt("prepare"))
+}
+
+func (s *ConcreteApiServer) moveID(w http.ResponseWriter, r *http.Request) *moveOperation {
+	var request moveIDRequest
+	if !moveBody(w, r, &request, "offer_id", "binding_id") {
+		return nil
+	}
+	if !volumeHex32.MatchString(request.OfferID) || !volumeHex64.MatchString(request.BindingID) {
+		w.WriteHeader(http.StatusBadRequest)
+		return nil
+	}
+	op := s.roomMoves.get(request.OfferID, request.BindingID)
+	if op == nil {
+		w.WriteHeader(http.StatusConflict)
+	}
+	return op
+}
+
+func (s *ConcreteApiServer) handleMoveCommit(w http.ResponseWriter, r *http.Request) {
+	op := s.moveID(w, r)
+	if op == nil {
+		return
+	}
+	ctx, cancel := context.WithTimeout(r.Context(), 16*time.Second)
+	defer cancel()
+	op.commit(ctx, s)
+	moveWrite(w, op.receipt("commit"))
+}
+
+func (s *ConcreteApiServer) handleMoveCancel(w http.ResponseWriter, r *http.Request) {
+	op := s.moveID(w, r)
+	if op == nil {
+		return
+	}
+	op.cancelMove()
+	moveWrite(w, op.receipt("cancel"))
+}
+
+func (s *ConcreteApiServer) handleMoveResult(w http.ResponseWriter, r *http.Request) {
+	if r.Method != http.MethodGet {
+		w.WriteHeader(http.StatusMethodNotAllowed)
+		return
+	}
+	q := r.URL.Query()
+	if len(q) != 2 || len(q["offer_id"]) != 1 || len(q["binding_id"]) != 1 || !volumeHex32.MatchString(q.Get("offer_id")) || !volumeHex64.MatchString(q.Get("binding_id")) {
+		w.WriteHeader(http.StatusBadRequest)
+		return
+	}
+	op := s.roomMoves.get(q.Get("offer_id"), q.Get("binding_id"))
+	if op == nil {
+		w.WriteHeader(http.StatusConflict)
+		return
+	}
+	moveWrite(w, op.receipt("result"))
+}
