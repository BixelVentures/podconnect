+)
+
+type moveCState struct {
+	Schema             string          `json:"schema"`
+	OK                 bool            `json:"ok"`
+	Ready              bool            `json:"ready"`
+	Busy               bool            `json:"busy"`
+	Policy             string          `json:"policy_revision"`
+	SessionVolume      int             `json:"session_volume_percent"`
+	OldBaseRevision    string          `json:"old_base_revision"`
+	TargetBaseRevision string          `json:"target_base_revision"`
+	OldRoute           roomVolumeRoute `json:"old_route_identity"`
+	Target             contentTarget   `json:"target_identity"`
+	InputDigest        string          `json:"input_path_digest"`
+	Paused             bool            `json:"paused"`
+	Physical           bool            `json:"physical_result_verified"`
+}
+type moveCReceipt struct {
+	Schema             string                 `json:"schema"`
+	OK                 bool                   `json:"ok"`
+	Token              string                 `json:"token"`
+	OfferID            string                 `json:"offer_id"`
+	BindingID          string                 `json:"binding_id"`
+	Incarnation        string                 `json:"native_incarnation"`
+	Revision           string                 `json:"native_revision"`
+	ReservationID      string                 `json:"native_reservation_id"`
+	Policy             string                 `json:"policy_revision"`
+	SessionVolume      int                    `json:"session_volume_percent"`
+	OldBaseRevision    string                 `json:"old_base_revision"`
+	TargetBaseRevision string                 `json:"target_base_revision"`
+	OldOwner           roomTransportIdentity  `json:"old_native_owner"`
+	Intended           roomTransportIdentity  `json:"intended_native_owner"`
+	Actual             *roomTransportIdentity `json:"actual_native_owner"`
+	OldRoute           roomVolumeRoute        `json:"old_route_identity"`
+	Target             contentTarget          `json:"target_identity"`
+	Route              *roomVolumeRoute       `json:"route_identity"`
+	InputDigest        string                 `json:"input_path_digest"`
+	Pipe               *outputPipeIdentity    `json:"pipe_identity"`
+	InputEpoch         string                 `json:"input_epoch"`
+	WriterEpoch        string                 `json:"writer_source_epoch"`
+	Phase              string                 `json:"phase"`
+	Possible           bool                   `json:"possible_effect"`
+	Drained            bool                   `json:"contexts_drained"`
+	GateClosed         bool                   `json:"gate_closed"`
+	Retired            bool                   `json:"deadline_retired"`
+	PinRemaining       int                    `json:"pin_remaining_ms"`
+	Expires            int                    `json:"expires_after_ms"`
+	Physical           bool                   `json:"physical_result_verified"`
+}
+
+func (c *moveCapture) endpoint(suffix string) string {
+	return strings.TrimSuffix(c.OwnTone, "/") + "/api/outputs/" + c.Scope.HomePodID + "/move/" + suffix
+}
+func (c *moveCapture) stateBody() any {
+	return struct {
+		Incarnation  string                `json:"native_incarnation"`
+		Process      contentProcess        `json:"native_process"`
+		Path         string                `json:"expected_input_path"`
+		Digest       string                `json:"expected_input_path_digest"`
+		Old          roomTransportIdentity `json:"old_native_owner"`
+		WriterFD     string                `json:"writer_fd"`
+		WriterDevice string                `json:"writer_pipe_device"`
+		WriterInode  string                `json:"writer_pipe_inode"`
+	}{c.Incarnation, c.Process, c.Pipe, c.PipeDigest, *c.OldOwner, c.WriterFD, c.WriterPipe.Device, c.WriterPipe.Inode}
+}
+func (state moveCState) valid(c *moveCapture) bool {
+	if c == nil || c.OldOwner == nil {
+		return false
+	}
+	if state.Schema != "podconnect.output_move_state.v1" || !state.OK || !state.Ready || state.Busy || state.Policy != movePolicy || state.Physical || state.Paused != c.Paused || state.SessionVolume < 0 || state.SessionVolume > 100 || !volumeCounter(state.OldBaseRevision) || !volumeCounter(state.TargetBaseRevision) || !state.OldRoute.valid() || state.OldRoute.DeviceID != c.OldOwner.HomePodID || state.OldRoute.InputPathDigest != c.PipeDigest || state.InputDigest != c.PipeDigest || state.Target.DeviceID != c.Scope.HomePodID || !volumeUUID.MatchString(state.Target.Process) || !volumeCounter(state.Target.Incarnation) || state.Target.Incarnation == "0" {
+		return false
+	}
+	return true
+}
+func (c *moveCapture) readCState(ctx context.Context) (moveCState, error) {
+	var state moveCState
+	if c == nil || c.OldOwner == nil || !volumeCounter(c.WriterFD) || c.WriterPipe.Type != "fifo" {
+		return state, ErrAliasConflict
+	}
+	if err := contentHTTP(ctx, "POST", c.endpoint("state"), c.stateBody(), &state); err != nil || !state.valid(c) {
+		return state, ErrAliasConflict
+	}
+	return state, nil
+}
+func (op *moveOperation) cPrepareBody() any {
+	c := op.Capture
+	return struct {
+		Incarnation  string                `json:"native_incarnation"`
+		Process      contentProcess        `json:"native_process"`
+		Path         string                `json:"expected_input_path"`
+		Digest       string                `json:"expected_input_path_digest"`
+		Old          roomTransportIdentity `json:"old_native_owner"`
+		WriterFD     string                `json:"writer_fd"`
+		WriterDevice string                `json:"writer_pipe_device"`
+		WriterInode  string                `json:"writer_pipe_inode"`
+		OfferID      string                `json:"offer_id"`
+		BindingID    string                `json:"binding_id"`
+		Revision     string                `json:"native_revision"`
+		Intended     roomTransportIdentity `json:"intended_native_owner"`
+		Policy       string                `json:"policy_revision"`
+	}{c.Incarnation, c.Process, c.Pipe, c.PipeDigest, *c.OldOwner, c.WriterFD, c.WriterPipe.Device, c.WriterPipe.Inode, op.Offer.OfferID, op.Offer.BindingID, op.Revision, op.Intended, movePolicy}
+}
+func (op *moveOperation) cValid(reply moveCReceipt, endpoint string) bool {
+	op.mu.Lock()
+	previous := op.CReceipt
+	reservation := op.ReservationID
+	epoch := op.Epoch
+	pipe := op.Pipe
+	op.mu.Unlock()
+	c := op.Capture
+	if reply.Schema != "podconnect.output_move_"+endpoint+".v1" || !reply.OK || !volumeHex32.MatchString(reply.Token) || reply.OfferID != op.Offer.OfferID || reply.BindingID != op.Offer.BindingID || reply.Incarnation != c.Incarnation || reply.Revision != op.Revision || reply.ReservationID != reservation || reply.Policy != movePolicy || reply.SessionVolume != op.Offer.SessionVolumePercent || reply.OldBaseRevision != op.CState.OldBaseRevision || reply.TargetBaseRevision != op.CState.TargetBaseRevision || reply.OldOwner != *c.OldOwner || reply.Intended != op.Intended || reply.OldRoute != op.CState.OldRoute || reply.Target != op.Target || reply.InputDigest != c.PipeDigest || !volumeCounter(reply.InputEpoch) || !volumeCounter(reply.WriterEpoch) || reply.PinRemaining < 0 || reply.PinRemaining > 15000 || reply.Expires != 8000 || reply.Physical {
+		return false
+	}
+	if previous != nil && previous.Token != reply.Token {
+		return false
+	}
+	if previous != nil && previous.Route != nil && (reply.Phase == "opened" || reply.Phase == "completed") && (reply.Route == nil || *reply.Route != *previous.Route || reply.InputEpoch != previous.InputEpoch || reply.Pipe == nil || previous.Pipe == nil || *reply.Pipe != *previous.Pipe) {
+		return false
+	}
+	if reply.Route != nil && (!reply.Route.valid() || reply.Route.DeviceID != c.Scope.HomePodID || reply.Route.InputPathDigest != c.PipeDigest || reply.Route.Process != op.Target.Process || reply.Route.DeviceIncarnation != op.Target.Incarnation) {
+		return false
+	}
+	if reply.Pipe != nil && (!volumeCounter(reply.Pipe.Device) || !volumeCounter(reply.Pipe.Inode) || reply.Pipe.Inode == "0" || reply.Pipe.Type != "fifo") {
+		return false
+	}
+	if epoch != "" && (reply.WriterEpoch != epoch || reply.Pipe == nil || reply.Pipe.Device != pipe.Device || reply.Pipe.Inode != pipe.Inode) {
+		return false
+	}
+	switch reply.Phase {
+	case "prepared":
+		return reservation == "" && !reply.Possible && reply.Actual == nil && reply.WriterEpoch == "0"
+	case "gate_draining", "gate_closed_reader_ready", "preparing_route", "route_ready_closed":
+		if reply.Retired || reply.PinRemaining < 1 || !reply.GateClosed || !reply.Possible || reply.Actual != nil {
+			return false
+		}
+	case "opened", "completed":
+		if reply.PinRemaining < 1 || (reply.Phase == "opened" && reply.Retired) || reply.GateClosed || !reply.Possible || !reply.Drained || reply.Actual == nil || *reply.Actual != op.Intended || reply.Route == nil || reply.InputEpoch == "0" || reply.WriterEpoch == "0" {
+			return false
+		}
+	case "rejected_before_admission", "expired_before_admission", "cancelled_before_admission":
+		return !reply.Possible && reply.Drained
+	case "unknown":
+		return true
+	default:
+		return false
+	}
+	if reply.Phase == "route_ready_closed" && (reply.Route == nil || reply.Pipe == nil || reply.InputEpoch == "0" || reply.WriterEpoch == "0" || !reply.Drained) {
+		return false
+	}
+	if reply.Phase == "gate_closed_reader_ready" && reply.Pipe == nil {
+		return false
+	}
+	return true
+}
+func (op *moveOperation) cCall(ctx context.Context, method, endpoint string, payload any) (moveCReceipt, error) {
+	var reply moveCReceipt
+	err := contentHTTP(ctx, method, op.Capture.endpoint(endpoint), payload, &reply)
+	schemaEndpoint := strings.Split(endpoint, "/")[0]
+	if err != nil || !op.cValid(reply, schemaEndpoint) {
+		return reply, ErrAliasConflict
+	}
+	op.mu.Lock()
+	op.CReceipt = &reply
+	op.mu.Unlock()
+	return reply, nil
+}
