+		"offer_id=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa&offer_id=cccccccccccccccccccccccccccccccc&binding_id=" + strings.Repeat("b", 64),
+	} {
+		response := httptest.NewRecorder()
+		server.handleMoveResult(response, httptest.NewRequest(http.MethodGet, "/player/room_move/result?"+query, nil))
+		if response.Code != http.StatusBadRequest {
+			t.Fatalf("unexpected acceptance of query %s: status %d", query, response.Code)
+		}
+	}
+}
