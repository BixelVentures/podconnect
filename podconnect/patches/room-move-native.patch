+	request := httptest.NewRequest(http.MethodPost, "/player/room_move/prepare", strings.NewReader(`{"scope":{},"move_offer":{},"action":"move_existing_session","args":{"volume_percent":35}}`))
+	response := httptest.NewRecorder()
+	var preparation movePrepareRequest
+	if moveBody(response, request, &preparation, "scope", "move_offer", "action", "args") || response.Code != http.StatusBadRequest {
+		t.Fatalf("MOVE args must be the exact empty object: status %d", response.Code)
+	}
+}
+
+func TestMoveResultRejectsExtraAndRepeatedQueryValues(t *testing.T) {
+	server := &ConcreteApiServer{}
+	for _, query := range []string{
