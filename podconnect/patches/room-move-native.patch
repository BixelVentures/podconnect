+package output
+
+import (
+	"io"
+	"os"
+	"sync"
+	"testing"
+	"time"
+)
+
+func TestPipeCloseJoinsActualBlockedWriterAndClosesAfterLoopError(t *testing.T) {
+	read, write, err := os.Pipe()
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer read.Close()
+	out := &pipeOutput{file: write}
+	out.cond = sync.NewCond(&out.lock)
+	writing := make(chan struct{})
+	writerDone := make(chan struct{})
+	go func() {
+		out.lock.Lock()
+		close(writing)
+		_, _ = write.Write(make([]byte, 1024*1024))
+		out.lock.Unlock()
+		close(writerDone)
+	}()
+	<-writing
+	closeDone := make(chan struct{})
+	go func() { _ = out.Close(); close(closeDone) }()
+	select {
+	case <-closeDone:
+		t.Fatal("Close returned before actual writer joined")
+	case <-time.After(20 * time.Millisecond):
+	}
+	drainDone := make(chan struct{})
+	go func() { _, _ = io.Copy(io.Discard, read); close(drainDone) }()
+	select {
+	case <-writerDone:
+	case <-time.After(2 * time.Second):
+		t.Fatal("writer did not drain")
+	}
+	select {
+	case <-closeDone:
+	case <-time.After(2 * time.Second):
+		t.Fatal("Close did not join writer")
+	}
+	<-drainDone
+	if _, err := write.Stat(); err == nil {
+		t.Fatal("old writer descriptor remains open")
+	}
+	out.lock.Lock()
+	out.closed = true
+	out.lock.Unlock()
+	if err := out.Close(); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func TestPipeCloseClosesDescriptorWhenOutputLoopAlreadyMarkedClosed(t *testing.T) {
+	read, write, err := os.Pipe()
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer read.Close()
+	out := &pipeOutput{file: write, closed: true}
+	out.cond = sync.NewCond(&out.lock)
+	if err := out.Close(); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := write.Stat(); err == nil {
+		t.Fatal("error-loop closed flag leaked writer FD")
+	}
+	if err := out.Close(); err != nil {
+		t.Fatal(err)
+	}
+}
