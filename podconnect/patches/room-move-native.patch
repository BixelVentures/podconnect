+package daemon
+
+import (
+	"context"
+	"fmt"
+	"strconv"
+	"sync"
+	"time"
+
+	"github.com/devgianlu/go-librespot/output"
+	"github.com/devgianlu/go-librespot/tracks"
+)
+
+const movePolicy = "a674d94e377e8ba2b51ca4ea5f541370bd9dd7f2ecc6fabb2cf3e2f50cbdb5b4"
+const (
+	apiMoveObserve ApiRequestType = "move_observe"
+	apiMoveOffer   ApiRequestType = "move_offer"
+	apiMoveClaim   ApiRequestType = "move_claim"
+	apiMoveConsume ApiRequestType = "move_consume"
+)
+
+type moveOffer struct {
+	Schema               string `json:"schema"`
+	OfferID              string `json:"offer_id"`
+	BindingID            string `json:"binding_id"`
+	NativeIncarnation    string `json:"native_incarnation"`
+	PolicyRevision       string `json:"policy_revision"`
+	SessionVolumePercent int    `json:"session_volume_percent"`
+	ExpiresAfterMS       int    `json:"expires_after_ms"`
+}
+type moveArgs struct{}
+type movePrepareRequest struct {
+	Scope  roomVolumeScope `json:"scope"`
+	Offer  moveOffer       `json:"move_offer"`
+	Action string          `json:"action"`
+	Args   moveArgs        `json:"args"`
+}
+type moveIDRequest struct {
+	OfferID   string `json:"offer_id"`
+	BindingID string `json:"binding_id"`
+}
+type moveReceipt struct {
+	Schema        string  `json:"schema"`
+	OK            bool    `json:"ok"`
+	OfferID       string  `json:"offer_id"`
+	BindingID     string  `json:"binding_id"`
+	State         string  `json:"state"`
+	Accepted      bool    `json:"accepted_room_move"`
+	OperationID   *string `json:"move_operation_id"`
+	SessionVolume *int    `json:"session_volume_percent"`
+	RoomID        string  `json:"room_id"`
+	HomePodID     string  `json:"homepod_id"`
+	Physical      bool    `json:"physical_result_verified"`
+}
+type moveCapture struct {
+	*contentCapture
+	Tracks        *tracks.List
+	QueueRevision uint64
+	Paused        bool
+	StateVolume   uint32
+	WriterPipe    output.MovePipeIdentity
+	WriterFD      string
+	WriterEpoch   string
+}
+type moveOperation struct {
+	mu                                                                                                   sync.Mutex
+	Owner                                                                                                *AppPlayer
+	Capture                                                                                              *moveCapture
+	Offer                                                                                                moveOffer
+	CState                                                                                               moveCState
+	Target                                                                                               contentTarget
+	Intended                                                                                             roomTransportIdentity
+	Actual                                                                                               *roomTransportIdentity
+	Expires, StagedUntil, Until, RetainUntil                                                             time.Time
+	State                                                                                                string
+	Claimed, CommitClaimed, Cancelled, Possible, Quiescent, Switched, Terminal, CancelSent, OwnerClosing bool
+	Revision, ReservationID                                                                              string
+	CReceipt                                                                                             *moveCReceipt
+	Pipe                                                                                                 output.MovePipeIdentity
+	Epoch                                                                                                string
+	Cancel                                                                                               context.CancelFunc
+	TerminalSignal                                                                                       chan struct{}
+}
+type moveOfferActorRequest struct {
+	Capture *moveCapture
+	State   moveCState
+	Context context.Context
+}
+type moveActorRequest struct {
+	Operation *moveOperation
+	Context   context.Context
+	Request   movePrepareRequest
+}
+type moveStep struct {
+	Operation *moveOperation
+	Phase     string
+	Context   context.Context
+	Reply     chan error
+}
+type moveReservation struct {
+	Operation *moveOperation
+	Until     time.Time
+}
+type moveStore struct {
+	mu      sync.Mutex
+	records map[string]*moveOperation
+}
+
+func (s *moveStore) put(op *moveOperation) bool {
+	s.mu.Lock()
+	if s.records == nil {
+		s.records = map[string]*moveOperation{}
+	}
+	for id, old := range s.records {
+		old.mu.Lock()
+		expired := (!old.Claimed && time.Now().After(old.Expires)) || (old.Terminal && old.State != "unknown" && time.Now().After(old.RetainUntil))
+		old.mu.Unlock()
+		if expired {
+			delete(s.records, id)
+		}
+	}
+	ok := len(s.records) < 128
+	if ok {
+		s.records[op.Offer.OfferID] = op
+	}
+	s.mu.Unlock()
+	return ok
+}
+func (s *moveStore) get(id, binding string) *moveOperation {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	op := s.records[id]
+	if op == nil || op.Offer.BindingID != binding {
+		return nil
+	}
+	return op
+}
+func (op *moveOperation) receipt(endpoint string) moveReceipt {
+	op.mu.Lock()
+	defer op.mu.Unlock()
+	complete := op.State == "complete"
+	var id *string
+	var percent *int
+	if complete {
+		value := op.Offer.OfferID
+		id = &value
+		valuePercent := op.Offer.SessionVolumePercent
+		percent = &valuePercent
+	}
+	return moveReceipt{"podconnect.native_room_move_" + endpoint + ".v1", complete, op.Offer.OfferID, op.Offer.BindingID, op.State, complete, id, percent, op.Capture.Scope.RoomID, op.Capture.Scope.HomePodID, false}
+}
+func (op *moveOperation) finish(state string) {
+	op.mu.Lock()
+	defer op.mu.Unlock()
+	if op.Terminal {
+		return
+	}
+	op.State = state
+	op.Terminal = true
+	op.RetainUntil = time.Now().Add(time.Minute)
+	if (state == "complete" || state == "rejected" || state == "cancelled") && op.TerminalSignal != nil {
+		close(op.TerminalSignal)
+	}
+}
+func (p *AppPlayer) moveBusyLocked() bool {
+	return p.roomMoveQuarantined || p.roomMoveReservation != nil
+}
+func (p *AppPlayer) captureMove(scope roomVolumeScope) (*moveCapture, error) {
+	c, err := p.captureContent(scope)
+	if err != nil {
+		return nil, err
+	}
+	snapshotCtx, stopSnapshot := context.WithTimeout(context.Background(), 2*time.Second)
+	defer stopSnapshot()
+	writer, writerEpoch, err := p.player.RoomMove(snapshotCtx, "snapshot", c.Source, output.MovePipeIdentity{}, "", !c.PlayerState.IsPaused, nil)
+	if err != nil {
+		return nil, ErrAliasConflict
+	}
+	p.aliasMu.Lock()
+	defer p.aliasMu.Unlock()
+	if c.OldOwner == nil || c.OldOwner.HomePodID == scope.HomePodID || c.OldOwner.RoomID == scope.RoomID || c.Primary == nil || c.Source == nil || c.Primary.Source != c.Source || !c.State.active || !c.PlayerState.IsPlaying || c.SessionID == "" || c.State.tracks == nil || p.moveBusyLocked() {
+		return nil, ErrAliasConflict
+	}
+	return &moveCapture{contentCapture: c, Tracks: c.State.tracks, QueueRevision: c.State.tracks.TransportRevision(), Paused: c.PlayerState.IsPaused, StateVolume: c.State.device.Volume, WriterPipe: writer, WriterFD: writer.FD, WriterEpoch: writerEpoch}, nil
+}
+func (p *AppPlayer) moveCurrentLocked(c *moveCapture) bool {
+	return c != nil && p.contentCurrentLocked(c.contentCapture) && p.state.active && p.state.player.IsPlaying && p.state.player.IsPaused == c.Paused && p.state.device.Volume == c.StateVolume && p.state.tracks == c.Tracks && c.Tracks.TransportRevision() == c.QueueRevision && p.primaryStream != nil && p.primaryStream.Source == c.Source
+}
+func (p *AppPlayer) offerMove(request moveOfferActorRequest) (any, error) {
+	p.aliasMu.Lock()
+	defer p.aliasMu.Unlock()
+	c := request.Capture
+	if request.Context.Err() != nil || !p.moveCurrentLocked(c) || !request.State.valid(c) {
+		return nil, ErrAliasConflict
+	}
+	if p.roomContentSteps == nil {
+		p.roomContentSteps = make(chan contentStep)
+	}
+	if p.roomMoveSteps == nil {
+		p.roomMoveSteps = make(chan moveStep)
+	}
+	id, err := randomQueueID(16)
+	if err != nil {
+		return nil, err
+	}
+	binding := contentDigest(struct {
+		Scope                                              roomVolumeScope
+		Process                                            contentProcess
+		Registry, Connection, Session, PipeDigest, OwnTone string
+		AliasRevision, QueueRevision, Intent               uint64
+		Paused                                             bool
+		Source, Primary                                    string
+		CState                                             moveCState
+	}{c.Scope, c.Process, c.Registry, c.Connection, c.SessionID, c.PipeDigest, c.OwnTone, c.AliasRevision, c.QueueRevision, c.Intent, c.Paused, fmt.Sprintf("%p", c.Source), fmt.Sprintf("%p", c.Primary), request.State})
+	op := &moveOperation{Owner: p, Capture: c, Offer: moveOffer{"podconnect.room_output_move_offer.v1", id, binding, c.Incarnation, movePolicy, request.State.SessionVolume, 5000}, CState: request.State, Target: request.State.Target, Expires: time.Now().Add(5 * time.Second), RetainUntil: time.Now().Add(45 * time.Second), State: "staging", TerminalSignal: make(chan struct{})}
+	return op, nil
+}
+func (p *AppPlayer) claimMove(request moveActorRequest) (any, error) {
+	op := request.Operation
+	if op == nil {
+		return nil, ErrAliasConflict
+	}
+	p.aliasMu.Lock()
+	defer p.aliasMu.Unlock()
+	op.mu.Lock()
+	defer op.mu.Unlock()
+	echo, original := request.Request.Offer, op.Offer
+	echo.ExpiresAfterMS = original.ExpiresAfterMS
+	if request.Context.Err() != nil || request.Request.Action != "move_existing_session" || request.Request.Scope != op.Capture.Scope || echo != original || request.Request.Offer.ExpiresAfterMS < 1 || request.Request.Offer.ExpiresAfterMS > original.ExpiresAfterMS || op.Claimed || op.Cancelled || !time.Now().Before(op.Expires) || !p.moveCurrentLocked(op.Capture) || p.roomNativeIntent == ^uint64(0) || p.aliasRevision >= 1<<53-1 {
+		return nil, ErrAliasConflict
+	}
+	p.roomNativeIntent++
+	op.Capture.Intent = p.roomNativeIntent
+	op.Revision = strconv.FormatUint(p.roomNativeIntent, 10)
+	op.Claimed = true
+	c := op.Capture
+	op.Intended = roomTransportIdentity{c.Scope.AccountUserID, c.Scope.TargetID, c.Scope.RoomID, c.Scope.HomePodID, c.Connection, c.SessionID, c.AliasIncarnation, c.Registry, c.AliasRevision + 1}
+	if !nativeBoundOwnerValid(op.Intended) {
+		return nil, ErrAliasConflict
+	}
+	return op, nil
+}
+func (p *AppPlayer) consumeMove(request moveActorRequest) (any, error) {
+	op := request.Operation
+	if op == nil {
+		return nil, ErrAliasConflict
+	}
+	p.aliasMu.Lock()
+	defer p.aliasMu.Unlock()
+	op.mu.Lock()
+	defer op.mu.Unlock()
+	if request.Context.Err() != nil || op.Owner != p || !op.CommitClaimed || op.Cancelled || op.Terminal || op.State != "committing" || op.CReceipt == nil || op.CReceipt.Phase != "prepared" || op.ReservationID != "" || !time.Now().Before(op.StagedUntil) || !p.moveCurrentLocked(op.Capture) || p.roomVolumeReservedLocked() || p.contentBusyLocked() || p.moveBusyLocked() {
+		return nil, ErrAliasConflict
+	}
+	id, err := randomQueueID(16)
+	if err != nil {
+		return nil, err
+	}
+	op.ReservationID = id
+	op.Until = time.Now().Add(12 * time.Second)
+	op.RetainUntil = op.Until.Add(time.Minute)
+	p.roomMoveReservation = &moveReservation{op, op.Until}
+	return op, nil
+}
