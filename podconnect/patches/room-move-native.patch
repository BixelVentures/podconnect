new file mode 100644
index 0000000..fcfba8c
--- /dev/null
+++ b/player/room_move_close_test.go
@@ -0,0 +1,43 @@
+package player
+
+import (
+	"sync"
+	"testing"
+	"time"
+)
+
+func TestPlayerCloseWaitsForWorkerCleanupAndSendsOnce(t *testing.T) {
+	p := &Player{cmd: make(chan playerCmd), closeDone: make(chan struct{})}
+	entered := make(chan struct{})
+	release := make(chan struct{})
+	workerDone := make(chan struct{})
+	go func() {
+		command := <-p.cmd
+		if command.typ != playerCmdClose {
+			t.Errorf("unexpected close command %v", command.typ)
+		}
+		close(entered)
+		<-release
+		close(p.cmd)
+		close(p.closeDone)
+		close(workerDone)
+	}()
+	var callers sync.WaitGroup
+	callers.Add(2)
+	returned := make(chan struct{}, 2)
+	for i := 0; i < 2; i++ {
+		go func() { defer callers.Done(); p.Close(); returned <- struct{}{} }()
+	}
+	<-entered
+	select {
+	case <-returned:
+		t.Fatal("Close returned before worker cleanup")
+	case <-time.After(20 * time.Millisecond):
+	}
+	close(release)
+	callers.Wait()
+	<-workerDone
+	if len(returned) != 2 {
+		t.Fatal("concurrent close caller did not join")
+	}
+}
diff --git a/player/room_move_test.go b/player/room_move_test.go
new file mode 100644
index 0000000..2d3752a
--- /dev/null
+++ b/player/room_move_test.go
@@ -0,0 +1,209 @@
+package player
+
+import (
+	"context"
+	"errors"
+	"sync"
+	"testing"
+	"time"
+
+	librespot "github.com/devgianlu/go-librespot"
+	"github.com/devgianlu/go-librespot/output"
+)
+
+type moveBackend struct {
+	transportTestOutput
+	lock     sync.Mutex
+	identity output.PipeIdentity
+	fd       string
+	fenced   bool
+}
+
+func (backend *moveBackend) FenceStart()                    { backend.fenced = true }
+func (backend *moveBackend) PausedUnderStartLock() bool     { return backend.paused }
+func (backend *moveBackend) FencedUnderStartLock() bool     { return backend.fenced }
+func (backend *moveBackend) WriterFDUnderStartLock() string { return backend.fd }
+func (backend *moveBackend) SetMoveStateUnderStartLock(paused, fenced bool) {
+	backend.paused, backend.fenced = paused, fenced
+}
+func (backend *moveBackend) WithStartLock(ctx context.Context, apply func(output.PipeIdentity, func(bool)) error) error {
+	if err := output.LockTransport(ctx, &backend.lock); err != nil {
+		return err
+	}
+	defer backend.lock.Unlock()
+	return apply(backend.identity, func(paused bool) { backend.paused, backend.fenced = paused, paused })
+}
+
+func TestRoomMoveSameSourceAndPausedPreservation(t *testing.T) {
+	for _, playing := range []bool{true, false} {
+		t.Run(map[bool]string{true: "playing", false: "paused"}[playing], func(t *testing.T) {
+			backend := &moveBackend{identity: output.PipeIdentity{Device: "1", Inode: "2", Type: "fifo"}, fd: "42"}
+			backend.paused = !playing
+			var out output.Output = backend
+			source := NewSwitchingAudioSource()
+			primary := &transportSource{id: 1}
+			source.SetPrimary(primary)
+			p := &Player{}
+			aliasMutations := 0
+			var finalPipe output.MovePipeIdentity
+			for _, phase := range []string{"snapshot", "quiesce", "switch", "resume"} {
+				guard := func(mutate func()) error {
+					mutate()
+					if phase == "switch" {
+						aliasMutations++
+					}
+					return nil
+				}
+				command := &roomMoveCommand{ctx: context.Background(), phase: phase, expectedSource: primary, pipe: p.movePipe, epoch: "0", wasPlaying: playing, guard: guard}
+				if phase == "switch" || phase == "resume" {
+					command.epoch = "1"
+				}
+				result, err := p.applyRoomMove(command, &out, source)
+				if err != nil || result.Pipe.PipeIdentity != backend.identity || result.Pipe.FD != backend.fd {
+					t.Fatalf("%s: result=%+v err=%v", phase, result, err)
+				}
+				finalPipe = result.Pipe
+				if phase != "resume" && phase != "snapshot" && (!backend.paused || !backend.fenced) {
+					t.Fatalf("%s did not hold writer quiescent", phase)
+				}
+				if source.source[source.which] != librespot.AudioSource(primary) {
+					t.Fatal("retained source replaced")
+				}
+			}
+			verified := 0
+			_, err := p.applyRoomMove(&roomMoveCommand{ctx: context.Background(), phase: "verify", expectedSource: primary, pipe: finalPipe, epoch: "1", wasPlaying: playing, guard: func(mutate func()) error { mutate(); verified++; return nil }}, &out, source)
+			if err != nil || verified != 1 {
+				t.Fatalf("final same-source proof failed: %v verified=%d", err, verified)
+			}
+			if aliasMutations != 1 || backend.paused == playing || backend.fenced {
+				t.Fatalf("wrong final state: alias=%d paused=%v fenced=%v", aliasMutations, backend.paused, backend.fenced)
+			}
+		})
+	}
+}
+
+func TestRoomMoveRejectsDelayedBlockedWriterAndEpochOrDescriptorChange(t *testing.T) {
+	backend := &moveBackend{identity: output.PipeIdentity{Device: "1", Inode: "2", Type: "fifo"}, fd: "42"}
+	var out output.Output = backend
+	source := NewSwitchingAudioSource()
+	primary := &transportSource{id: 1}
+	source.SetPrimary(primary)
+	p := &Player{}
+	guard := func(mutate func()) error { mutate(); return nil }
+	snapshot, err := p.applyRoomMove(&roomMoveCommand{ctx: context.Background(), phase: "snapshot", expectedSource: primary, wasPlaying: true, guard: guard}, &out, source)
+	if err != nil {
+		t.Fatal(err)
+	}
+	backend.lock.Lock()
+	ctx, cancel := context.WithTimeout(context.Background(), 10*time.Millisecond)
+	defer cancel()
+	done := make(chan error, 1)
+	go func() {
+		_, e := p.applyRoomMove(&roomMoveCommand{ctx: ctx, phase: "quiesce", expectedSource: primary, pipe: snapshot.Pipe, epoch: snapshot.Epoch, wasPlaying: true, guard: guard}, &out, source)
+		done <- e
+	}()
+	if e := <-done; !errors.Is(e, context.DeadlineExceeded) {
+		t.Fatalf("blocked writer admitted: %v", e)
+	}
+	backend.lock.Unlock()
+	if backend.paused || backend.fenced || p.movePhase != "snapshot" {
+		t.Fatal("timed-out quiesce mutated output")
+	}
+	quiesce, err := p.applyRoomMove(&roomMoveCommand{ctx: context.Background(), phase: "quiesce", expectedSource: primary, pipe: snapshot.Pipe, epoch: snapshot.Epoch, wasPlaying: true, guard: guard}, &out, source)
+	if err != nil {
+		t.Fatal(err)
+	}
+	mutations := 0
+	trySwitch := func(pipe output.MovePipeIdentity, epoch string) error {
+		_, e := p.applyRoomMove(&roomMoveCommand{ctx: context.Background(), phase: "switch", expectedSource: primary, pipe: pipe, epoch: epoch, wasPlaying: true, guard: func(mutate func()) error { mutate(); mutations++; return nil }}, &out, source)
+		return e
+	}
+	if trySwitch(quiesce.Pipe, "0") == nil || mutations != 0 {
+		t.Fatal("stale writer epoch admitted")
+	}
+	backend.fenced = false
+	if trySwitch(quiesce.Pipe, quiesce.Epoch) == nil || mutations != 0 {
+		t.Fatal("lost quiescence admitted")
+	}
+	backend.fenced = true
+	backend.fd = "43"
+	if trySwitch(quiesce.Pipe, quiesce.Epoch) == nil || mutations != 0 {
+		t.Fatal("replacement writer FD admitted")
+	}
+	backend.fd = "42"
+	backend.identity = output.PipeIdentity{Device: "1", Inode: "3", Type: "fifo"}
+	if trySwitch(quiesce.Pipe, quiesce.Epoch) == nil || mutations != 0 {
+		t.Fatal("replacement descriptor admitted")
+	}
+}
+
+func TestRoomMoveRefreshesUnclaimedSnapshotAndAbortsQuiescence(t *testing.T) {
+	backend := &moveBackend{identity: output.PipeIdentity{Device: "1", Inode: "2", Type: "fifo"}, fd: "0"}
+	var out output.Output = backend
+	source := NewSwitchingAudioSource()
+	primary := &transportSource{id: 1}
+	source.SetPrimary(primary)
+	p := &Player{}
+	for i := 0; i < 2; i++ {
+		result, err := p.applyRoomMove(&roomMoveCommand{ctx: context.Background(), phase: "snapshot", expectedSource: primary, wasPlaying: true}, &out, source)
+		if err != nil || result.Pipe.FD != "0" || p.movePhase != "snapshot" {
+			t.Fatal("unclaimed snapshot cannot refresh or FD0 rejected", result, err)
+		}
+	}
+	quiesce, err := p.applyRoomMove(&roomMoveCommand{ctx: context.Background(), phase: "quiesce", expectedSource: primary, pipe: p.movePipe, epoch: "0", wasPlaying: true, guard: func(mutate func()) error { mutate(); return nil }}, &out, source)
+	if err != nil || !backend.paused || !backend.fenced {
+		t.Fatal("quiesce absent", err)
+	}
+	_, err = p.applyRoomMove(&roomMoveCommand{ctx: context.Background(), phase: "abort", expectedSource: primary, pipe: quiesce.Pipe, epoch: quiesce.Epoch, wasPlaying: true}, &out, source)
+	if err != nil || backend.paused || backend.fenced || p.movePhase != "" || source.source[source.which] != librespot.AudioSource(primary) {
+		t.Fatal("quiesced move did not restore retained playing source", err)
+	}
+}
+
+func TestRoomMoveRejectsAutoplaySourceReplacementAfterSnapshot(t *testing.T) {
+	backend := &moveBackend{identity: output.PipeIdentity{Device: "1", Inode: "2", Type: "fifo"}, fd: "42"}
+	var out output.Output = backend
+	source := NewSwitchingAudioSource()
+	original := &transportSource{id: 1}
+	source.SetPrimary(original)
+	p := &Player{}
+	snapshot, err := p.applyRoomMove(&roomMoveCommand{ctx: context.Background(), phase: "snapshot", expectedSource: original, wasPlaying: true}, &out, source)
+	if err != nil {
+		t.Fatal(err)
+	}
+	replacement := &transportSource{id: 2}
+	source.SetPrimary(replacement)
+	mutations := 0
+	_, err = p.applyRoomMove(&roomMoveCommand{ctx: context.Background(), phase: "quiesce", expectedSource: original, pipe: snapshot.Pipe, epoch: snapshot.Epoch, wasPlaying: true, guard: func(mutate func()) error { mutate(); mutations++; return nil }}, &out, source)
+	if err == nil || mutations != 0 || backend.paused || backend.fenced {
+		t.Fatalf("replaced source reached MOVE effect: err=%v mutations=%d paused=%v fenced=%v", err, mutations, backend.paused, backend.fenced)
+	}
+}
+
+func TestRoomMoveFinalSnapshotRejectsPostOpenAutoplayReplacement(t *testing.T) {
+	backend := &moveBackend{identity: output.PipeIdentity{Device: "1", Inode: "2", Type: "fifo"}, fd: "42"}
+	var out output.Output = backend
+	source := NewSwitchingAudioSource()
+	original := &transportSource{id: 1}
+	source.SetPrimary(original)
+	p := &Player{}
+	guard := func(mutate func()) error { mutate(); return nil }
+	result, err := p.applyRoomMove(&roomMoveCommand{ctx: context.Background(), phase: "snapshot", expectedSource: original, wasPlaying: true}, &out, source)
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, phase := range []string{"quiesce", "switch", "resume"} {
+		result, err = p.applyRoomMove(&roomMoveCommand{ctx: context.Background(), phase: phase, expectedSource: original, pipe: result.Pipe, epoch: result.Epoch, wasPlaying: true, guard: guard}, &out, source)
+		if err != nil {
+			t.Fatal(phase, err)
+		}
+	}
+	source.SetPrimary(&transportSource{id: 2})
+	verified := 0
+	if _, err = p.applyRoomMove(&roomMoveCommand{ctx: context.Background(), phase: "verify", expectedSource: original, pipe: result.Pipe, epoch: result.Epoch, wasPlaying: true, guard: func(mutate func()) error { mutate(); verified++; return nil }}, &out, source); err == nil || verified != 0 {
+		t.Fatal("post-open replaced source certified by final verification")
+	}
+	if _, err = p.applyRoomMove(&roomMoveCommand{ctx: context.Background(), phase: "fence", pipe: result.Pipe, epoch: result.Epoch}, &out, source); err != nil || !backend.paused || !backend.fenced {
+		t.Fatalf("unknown post-open source did not fence same actual writer: %v", err)
+	}
+}
