+primary_radio_wire_resend(struct recovery_wire_fixture *f, unsigned short port, uint16_t sequence)
+{
+  struct sockaddr_in destination = { .sin_family = AF_INET, .sin_port = htons(port),
+    .sin_addr.s_addr = htonl(INADDR_LOOPBACK) };
+  uint8_t request[8] = { 0x80, 0xd5, 0, 0, sequence >> 8, sequence & 0xff, 0, 1 };
+  uint16_t observed;
+
+  assert(sendto(f->udp_fd, request, sizeof(request), 0,
+      (struct sockaddr *)&destination, sizeof(destination)) == sizeof(request));
+  event_base_loop(f->base, EVLOOP_NONBLOCK);
+  return primary_radio_wire_packets(f, &observed);
+}
