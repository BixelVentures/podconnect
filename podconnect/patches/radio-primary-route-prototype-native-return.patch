+func (p *AppPlayer) commitPrimaryRadioReturn(ctx context.Context, h *radioHold, opened radioPrimaryReturnReceipt,
+	owner roomTransportIdentity, globalIntent, generation uint64, writer output.MovePipeIdentity) error {
+	if ctx.Err() != nil || opened.Phase != "opened" || opened.Writer == nil || opened.Route == nil ||
+		p.primaryStream == nil || p.primaryStream != h.primary || p.primaryStream.Source == nil {
+		return ErrAliasConflict
+	}
+	wire, primary, source, app := *opened.Writer, p.primaryStream, p.primaryStream.Source, p.app
+	_, _, err := p.player.RoomMove(ctx, "verify", source, writer, wire.Epoch, false, func(mutate func()) error {
+		p.aliasMu.Lock()
+		defer p.aliasMu.Unlock()
+		account, bound := p.sess.BoundUsername()
+		alias := p.aliasBindingLocked()
+		if ctx.Err() != nil || !bound || account != owner.AccountUserID || alias == nil || !alias.Ready || alias.RoomID != owner.RoomID ||
+			!p.radioReacquiredAliasCurrentLocked(owner) || p.aliasRevision != owner.AliasRevision || p.aliasIncarnation != owner.AliasIncarnation ||
+			p.aliasFingerprint != owner.AliasRegistry || p.spotConnId != owner.ConnectionID || p.state == nil || p.state.player == nil ||
+			p.state.player.SessionId != owner.SessionID || !p.state.player.IsPaused || p.primaryStream != primary || primary.Source != source ||
+			strconv.FormatUint(p.roomNativeIntent, 10) != opened.Revision {
+			return ErrAliasConflict
+		}
+		app.radio.mu.Lock()
+		defer app.radio.mu.Unlock()
+		if app.radio.failed || app.radio.Intent != globalIntent || app.radio.Holds[owner.RoomID] != h || h.owner != p ||
+			h.Phase != "reacquiring" || h.ReacquirePhase != "primary_return_open_attempted" || h.PrimaryReturn == nil ||
+			h.PrimaryReturn.Intent != opened.Intent || h.PrimaryReturn.Release != opened.Release || h.PrimaryReturn.Writer == nil ||
+			*h.PrimaryReturn.Writer != wire || h.Primary == nil || opened.Release.radioPrimaryBinding != *h.Primary {
+			return ErrAliasConflict
+		}
+		app.moveCustodyMu.Lock()
+		defer app.moveCustodyMu.Unlock()
+		if app.openedWriterOwner != p || app.openedWriter != writer || app.openedWriterGeneration != generation {
+			return ErrAliasConflict
+		}
+		mutate()
+		h.Phase, h.ReacquirePhase = "primary_released", "primary_return_opened"
+		h.WriterParked, h.RequiresPause = false, false
+		if err := app.persistRadioLocked(); err != nil {
+			h.Phase, h.WriterParked, h.RequiresPause = "unknown", true, true
+			return err
+		}
+		intent, _ := strconv.ParseUint(opened.Revision, 10, 64)
+		app.radioReacquiredWriter = &radioReacquiredWriter{
+			Intent: intent, GlobalIntent: globalIntent, Owner: p, Player: p.player, Session: p.sess,
+			Primary: primary, Source: source, Identity: owner, Wire: wire, Writer: writer, Process: wire.Process,
+			Generation: generation, StartAt: app.startCustody, MoveAt: app.moveCustody, PrimaryReturn: &opened,
+		}
+		app.radioParkedWriter, app.radioOtherWriter = nil, nil
+		p.radioResume = &radioResumeMarker{Primary: primary, Source: source, Player: p.player, Session: p.sess, Owner: owner, Writer: wire}
+		app.refreshRadioOutputFenceLocked()
+		return nil
+	})
+	return err
+}
