 int
+outputs_airplay_primary_station_readiness(const struct output_primary_radio_start_request *request,
+    struct output_primary_radio_start_result *out)
+{
+  if (outputs_airplay_primary_station_result(request, out) < 0
+      || out->phase != OUTPUT_PRIMARY_RADIO_START_OBSERVED
+      || !primary_radio_station_predecessor(&out->custody))
+    return -1;
+  const struct primary_radio_station_operation *operation = primary_radio_station_find(request);
+  struct timespec now, zero = { 0 }, max_age = { .tv_sec = PRIMARY_RADIO_READY_SECONDS };
+  if (clock_gettime(CLOCK_MONOTONIC, &now) < 0 || timespec_cmp(operation->last_fresh_rtp, zero) <= 0
+      || timespec_cmp(now, operation->last_fresh_rtp) < 0
+      || timespec_cmp(timespec_sub(now, operation->last_fresh_rtp), max_age) > 0)
+    return -1;
+  return 0;
+}
