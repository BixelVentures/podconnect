+static enum command_state
+transport_command(void *arg, int *retval)
+{
+  struct player_transport_command *c=arg;
+  if (c->action!=2 && (!pb_session.playing_now || pb_session.playing_now!=pb_session.source_list
+      || pb_session.reading_now!=pb_session.playing_now))
+    { *retval=-1; return COMMAND_END; }
