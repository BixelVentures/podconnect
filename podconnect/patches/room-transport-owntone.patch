+  else if (c->action==1) *retval=outputs_transport_commit(c->request,c->result);
+  else if (c->action==2) *retval=outputs_transport_result_get(c->token,c->result);
+  else *retval=outputs_transport_state_get(c->id,c->identity,c->busy);
+  return COMMAND_END;
