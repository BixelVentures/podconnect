index a5ada22..81440e2 100644
--- a/src/outputs.c
+++ b/src/outputs.c
@@ -141,6 +141,209 @@ static bool outputs_got_new_subscription;
 
 
 
+/* Transport tokens never reuse attention leases or receipts. The bounded store
+ * may evict an old token, but an unknown token can never be committed again. */
+#define OUTPUT_TRANSPORT_SLOTS 64
+struct transport_slot
+{
+  struct output_transport_result result;
+  struct timespec expiry;
+  bool used;
+};
+static struct transport_slot transport_slots[OUTPUT_TRANSPORT_SLOTS];
+static struct transport_slot *transport_pin;
+static struct timespec transport_pin_expiry;
+static uint64_t transport_selection_revision = 1;
+static uint64_t transport_input_generation = 1;
+static uint64_t transport_input_item;
+static char transport_input_path_digest[65];
+
+static unsigned
+transport_remaining(const struct timespec *expiry)
+{
+  struct timespec now;
+  int64_t ns;
+  if (clock_gettime(CLOCK_MONOTONIC, &now) < 0) return OUTPUT_TRANSPORT_TTL_MS; /* Clock failure cannot unlock. */
+  ns = (int64_t)(expiry->tv_sec - now.tv_sec) * 1000000000LL + expiry->tv_nsec - now.tv_nsec;
+  return ns > 0 ? (unsigned)((ns + 999999) / 1000000) : 0;
+}
+
+bool
+outputs_transport_busy(void)
+{
+  if (transport_pin && !transport_remaining(&transport_pin_expiry)) transport_pin = NULL;
+  return transport_pin != NULL;
+}
+
+static void
+transport_selection_changed(void)
+{
+  if (transport_selection_revision != UINT64_MAX) transport_selection_revision++;
+}
+
+void
+outputs_transport_input_changed(uint64_t item_id, const char *path, bool pipe_input)
+{
+  unsigned char digest[32];
+  static const char hex[]="0123456789abcdef";
+  size_t i;
+  if (transport_input_generation != UINT64_MAX) transport_input_generation++;
+  transport_input_item = item_id;
+  memset(transport_input_path_digest,0,sizeof(transport_input_path_digest));
+  if (!item_id || !path || !*path || !pipe_input) return;
+  /* Exact actual source path bytes, no caller echo or path normalization. */
+  gcry_md_hash_buffer(GCRY_MD_SHA256,digest,path,strlen(path));
+  for (i=0;i<32;i++)
+    { transport_input_path_digest[2*i]=hex[digest[i]>>4]; transport_input_path_digest[2*i+1]=hex[digest[i]&15]; }
+}
+
+static bool
+transport_hex(const char *text, size_t length)
+{
+  size_t i;
+  if (!text || strlen(text) != length) return false;
+  for (i = 0; i < length; i++)
+    if (!((text[i] >= '0' && text[i] <= '9') || (text[i] >= 'a' && text[i] <= 'f'))) return false;
+  return true;
+}
+
+static bool
+transport_command_valid(const struct output_transport_request *r)
+{
+  if (!r || !r->device_id || !transport_hex(r->native_prepare_id,32) || !transport_hex(r->args_digest,64)) return false;
+  if (!strcmp(r->action,"volume")) return r->percent >= 0 && r->percent <= 100;
+  return r->percent == -1 && (!strcmp(r->action,"pause") || !strcmp(r->action,"resume")
+      || !strcmp(r->action,"next") || !strcmp(r->action,"previous"));
+}
+
+static int
+transport_identity_get(uint64_t id, struct output_transport_identity *state)
+{
+  struct output_device *device = outputs_device_get(id), *scan;
+  int selected = 0;
+  if (!device || !state || !outputs_process[0] || !device->selected || !device->advertised
+      || device->type != OUTPUT_TYPE_AIRPLAY || !device->session || device->state < OUTPUT_STATE_CONNECTED
+      || device->busy || device->prevent_playback || device->attention_retiring_session
+      || device->session_epoch == UINT64_MAX || device->route_revision == UINT64_MAX
+      || transport_selection_revision == UINT64_MAX || transport_input_generation == UINT64_MAX
+      || !transport_input_item || !transport_input_path_digest[0]) return -1;
+  for (scan = outputs_device_list; scan; scan = scan->next) if (scan->selected) selected++;
+  if (selected != 1) return -1;
+  memset(state,0,sizeof(*state));
+  memcpy(state->process,outputs_process,sizeof(state->process));
+  state->device_id=id; state->device_incarnation=device->incarnation;
+  state->session_epoch=device->session_epoch; state->route_revision=device->route_revision;
+  state->selection_revision=transport_selection_revision;
+  state->input_generation=transport_input_generation; state->input_item_id=transport_input_item;
+  memcpy(state->input_path_digest,transport_input_path_digest,sizeof(state->input_path_digest));
+  return 0;
+}
+
+int
+outputs_transport_state_get(uint64_t id, struct output_transport_identity *identity, bool *busy)
+{
+  if (!busy || transport_identity_get(id,identity)<0) return -1;
+  *busy=outputs_transport_busy();
+  return 0;
+}
+
+static bool
+transport_identity_equal(const struct output_transport_identity *a, const struct output_transport_identity *b)
+{
+  return !strcmp(a->process,b->process) && a->device_id==b->device_id
+    && a->device_incarnation==b->device_incarnation && a->session_epoch==b->session_epoch
+    && a->route_revision==b->route_revision && a->selection_revision==b->selection_revision
+    && a->input_generation==b->input_generation && a->input_item_id==b->input_item_id
+    && !strcmp(a->input_path_digest,b->input_path_digest);
+}
+
+static struct transport_slot *
+transport_find(const char *token)
+{
+  size_t i;
+  if (!token || strlen(token)!=32) return NULL;
+  for (i=0;i<ARRAY_SIZE(transport_slots);i++)
+    if (!strcmp(transport_slots[i].result.command.token,token)) return &transport_slots[i];
+  return NULL;
+}
+
+bool
+outputs_transport_current(const struct output_transport_result *operation)
+{
+  struct output_transport_identity state;
+  return operation && outputs_transport_busy() && transport_pin->used
+    && !strcmp(transport_pin->result.command.token,operation->command.token)
+    && transport_identity_get(operation->identity.device_id,&state)==0
+    && transport_identity_equal(&operation->identity,&state);
+}
+
+int
+outputs_transport_prepare(const struct output_transport_request *request, struct output_transport_result *result)
+{
+  struct output_transport_identity identity;
+  struct transport_slot *slot=NULL;
+  size_t i;
+  if (!result || !transport_command_valid(request) || outputs_transport_busy()
+      || transport_identity_get(request->device_id,&identity)<0) return -1;
+  /* Manual physical volume needs its separately reviewed admission contract. */
+  if (!strcmp(request->action,"volume")) return -1;
+  for (i=0;i<ARRAY_SIZE(transport_slots);i++)
+    {
+      if (transport_remaining(&transport_slots[i].expiry)
+          && !strcmp(transport_slots[i].result.command.native_prepare_id,request->native_prepare_id)) return -1;
+      if (!slot && !transport_remaining(&transport_slots[i].expiry)) slot=&transport_slots[i];
+    }
+  if (!slot || clock_gettime(CLOCK_MONOTONIC,&slot->expiry)<0) return -1;
+  memset(&slot->result,0,sizeof(slot->result));
+  slot->result.identity=identity; slot->result.command=*request;
+  {
+    char uuid[37]; size_t j,k=0;
+    outputs_attention_uuid(uuid); /* randomness primitive only, no attention authority */
+    for (j=0;j<36;j++) if (uuid[j]!='-') slot->result.command.token[k++]=uuid[j];
+    slot->result.command.token[k]=0;
+  }
+  slot->expiry.tv_sec += OUTPUT_TRANSPORT_TTL_MS / 1000;
+  slot->used=false; slot->result.remaining_ms=OUTPUT_TRANSPORT_TTL_MS;
+  *result=slot->result;
+  return 0;
+}
+
+int
+outputs_transport_commit(const struct output_transport_request *request, struct output_transport_result *result)
+{
+  struct transport_slot *slot;
+  struct output_transport_identity identity;
+  if (!request || !result || !(slot=transport_find(request->token)) || slot->used) return -1;
+  slot->used=true; slot->result.outcome=-1; /* Consume before any validation/mutation: altered token cannot retry. */
+  if (!transport_remaining(&slot->expiry) || !transport_command_valid(request)
+      || request->device_id!=slot->result.command.device_id
+      || strcmp(request->native_prepare_id,slot->result.command.native_prepare_id)
+      || strcmp(request->action,slot->result.command.action)
+      || strcmp(request->args_digest,slot->result.command.args_digest)
+      || request->percent!=slot->result.command.percent
+      || !transport_hex(request->expected_input_path_digest,64)
+      || strcmp(request->expected_input_path_digest,slot->result.identity.input_path_digest)
+      || outputs_transport_busy()
+      || transport_identity_get(request->device_id,&identity)<0
+      || !transport_identity_equal(&slot->result.identity,&identity)) return -1;
+  if (clock_gettime(CLOCK_MONOTONIC,&transport_pin_expiry)<0) return -1;
+  transport_pin_expiry.tv_sec += OUTPUT_TRANSPORT_TTL_MS / 1000;
+  transport_pin=slot; slot->expiry=transport_pin_expiry;
+  slot->result.remaining_ms=OUTPUT_TRANSPORT_TTL_MS; slot->result.outcome=0;
+  *result=slot->result;
+  return slot->result.outcome<0 ? -1 : 0;
+}
+
+int
+outputs_transport_result_get(const char *token, struct output_transport_result *result)
+{
+  struct transport_slot *slot=transport_find(token);
+  if (!slot || !slot->used || !result) return -1;
+  *result=slot->result;
+  result->remaining_ms=outputs_transport_busy() && transport_pin==slot ? transport_remaining(&transport_pin_expiry) : 0;
+  return 0;
+}
