+static int transport_http(struct httpd_request *hreq, const char *action, const char *body)
+{
+  hreq->path_parts[2]="1"; hreq->path_parts[4]=(char *)action;
+  evbuffer_drain(hreq->in_body,evbuffer_get_length(hreq->in_body));
+  evbuffer_drain(hreq->out_body,evbuffer_get_length(hreq->out_body));
+  if (body) evbuffer_add(hreq->in_body,body,strlen(body));
+  return !strcmp(action,"state") ? jsonapi_reply_transport_state(hreq) : jsonapi_reply_transport_write(hreq);
+}
