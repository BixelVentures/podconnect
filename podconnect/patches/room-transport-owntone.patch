+static json_object *
+transport_identity_json(const struct output_transport_identity *s)
+{
+  json_object *o=json_object_new_object();
+  json_object_object_add(o,"process",json_object_new_string(s->process));
+  attention_json_u64(o,"device_id",s->device_id);
+  attention_json_u64(o,"device_incarnation",s->device_incarnation);
+  attention_json_u64(o,"session_epoch",s->session_epoch);
+  attention_json_u64(o,"route_revision",s->route_revision);
+  attention_json_u64(o,"selection_revision",s->selection_revision);
+  attention_json_u64(o,"input_generation",s->input_generation);
+  attention_json_u64(o,"input_item_id",s->input_item_id);
+  json_object_object_add(o,"input_path_digest",json_object_new_string(s->input_path_digest));
+  return o;
+}
+
+static int
+transport_json_reply(struct httpd_request *hreq, json_object *reply)
+{
+  int ret=evbuffer_add_printf(hreq->out_body,"%s",json_object_to_json_string(reply));
+  jparse_free(reply);
+  return ret<0 ? HTTP_INTERNAL : HTTP_OK;
+}
+
+static int
+jsonapi_reply_transport_state(struct httpd_request *hreq)
+{
+  struct output_transport_identity identity;
+  uint64_t id;
+  bool busy;
+  json_object *reply, *actions;
+  const char *names[]={"pause","resume","next","previous"};
+  size_t i;
+  if (safe_atou64(hreq->path_parts[2],&id)<0
+      || player_transport_state_get(id,&identity,&busy)<0) return 409;
+  reply=json_object_new_object(); actions=json_object_new_array();
+  json_object_object_add(reply,"schema",json_object_new_string("podconnect.output_transport_state.v1"));
+  json_object_object_add(reply,"ok",json_object_new_boolean(true));
+  json_object_object_add(reply,"identity",transport_identity_json(&identity));
+  json_object_object_add(reply,"busy",json_object_new_boolean(busy));
+  /* Physical volume is unavailable until its separate admission contract is reviewed. */
+  if (!busy) for (i=0;i<ARRAY_SIZE(names);i++) json_object_array_add(actions,json_object_new_string(names[i]));
+  json_object_object_add(reply,"actions",actions);
+  json_object_object_add(reply,"physical_result_verified",json_object_new_boolean(false));
+  return transport_json_reply(hreq,reply);
+}
+
+static bool
+transport_json_string(json_object *body, const char *key, char *destination, size_t capacity)
+{
+  json_object *field;
+  const char *value;
+  size_t length;
+  if (!json_object_object_get_ex(body,key,&field) || !json_object_is_type(field,json_type_string)) return false;
+  value=json_object_get_string(field); length=json_object_get_string_len(field);
+  if (!length || length>=capacity || strlen(value)!=length) return false;
+  memcpy(destination,value,length+1);
+  return true;
+}
+
+/* This flat wire protocol has only canonical ASCII identifier/action strings
+ * and an optional integer. Escapes have no valid purpose. Counting unquoted
+ * colons against parsed keys rejects json-c's duplicate-key collapse without
+ * inventing another general JSON parser; strict parse_end rejects suffix data. */
+static json_object *
+transport_parse_body(struct evbuffer *buffer)
+{
+  size_t length=evbuffer_get_length(buffer), i, end, colons=0;
+  const unsigned char *text=evbuffer_pullup(buffer,-1);
+  bool quoted=false;
+  struct json_tokener *tokener;
+  json_object *body;
+  if (!text || !length || length>1024) return NULL;
+  for (i=0;i<length;i++)
+    {
+      if (!text[i] || text[i]=='\\' || text[i]>=128) return NULL;
+      if (text[i]=='"') quoted=!quoted;
+      else if (!quoted && text[i]==':') colons++;
+    }
+  if (quoted) return NULL;
+  tokener=json_tokener_new();
+  if (!tokener) return NULL;
+  json_tokener_set_flags(tokener,JSON_TOKENER_STRICT);
+  body=json_tokener_parse_ex(tokener,(const char *)text,length);
+  end=json_tokener_get_parse_end(tokener);
+  if (json_tokener_get_error(tokener)!=json_tokener_success || !body
+      || !json_object_is_type(body,json_type_object) || colons!=json_object_object_length(body))
+    { if (body) json_object_put(body); body=NULL; }
+  for (i=end;body && i<length;i++)
+    if (text[i]!=' ' && text[i]!='\t' && text[i]!='\r' && text[i]!='\n')
+      { json_object_put(body); body=NULL; }
+  json_tokener_free(tokener);
+  return body;
+}
+
+static int
+jsonapi_reply_transport_write(struct httpd_request *hreq)
+{
+  struct output_transport_request request={.percent=-1};
+  struct output_transport_result result;
+  json_object *body=transport_parse_body(hreq->in_body), *reply, *percent;
+  bool commit=!strcmp(hreq->path_parts[4],"commit"), volume;
+  int expected, ret=HTTP_BADREQUEST;
+  if (!body || !json_object_is_type(body,json_type_object)
+      || safe_atou64(hreq->path_parts[2],&request.device_id)<0
+      || !transport_json_string(body,"native_prepare_id",request.native_prepare_id,sizeof(request.native_prepare_id))
+      || !transport_json_string(body,"args_digest",request.args_digest,sizeof(request.args_digest))
+      || !transport_json_string(body,"action",request.action,sizeof(request.action))) goto out;
+  volume=!strcmp(request.action,"volume");
+  expected=3+(commit?2:0)+(volume?1:0);
+  if (json_object_object_length(body)!=expected) goto out;
+  if (commit && (!transport_json_string(body,"token",request.token,sizeof(request.token))
+      || !transport_json_string(body,"expected_input_path_digest",request.expected_input_path_digest,sizeof(request.expected_input_path_digest)))) goto out;
+  if (volume)
+    {
+      if (!json_object_object_get_ex(body,"percent",&percent) || !json_object_is_type(percent,json_type_int)
+          || json_object_get_int64(percent)<0 || json_object_get_int64(percent)>100) goto out;
+      request.percent=json_object_get_int(percent);
+    }
+  ret=409;
+  if ((commit ? player_transport_commit(&request,&result) : player_transport_prepare(&request,&result))<0) goto out;
+  reply=json_object_new_object();
+  json_object_object_add(reply,"schema",json_object_new_string(commit ? "podconnect.output_transport_commit.v1" : "podconnect.output_transport_prepare.v1"));
+  json_object_object_add(reply,"ok",json_object_new_boolean(true));
+  json_object_object_add(reply,"token",json_object_new_string(result.command.token));
+  if (!commit) json_object_object_add(reply,"identity",transport_identity_json(&result.identity));
+  if (commit)
+    {
+      json_object_object_add(reply,"native_prepare_id",json_object_new_string(result.command.native_prepare_id));
+      json_object_object_add(reply,"args_digest",json_object_new_string(result.command.args_digest));
+    }
+  json_object_object_add(reply,commit ? "pin_remaining_ms" : "expires_after_ms",json_object_new_int(result.remaining_ms));
+  if (commit) json_object_object_add(reply,"outcome",json_object_new_string(result.outcome==1 ? "pending" : "accepted"));
+  if (commit) json_object_object_add(reply,"physical_result_verified",json_object_new_boolean(false));
+  ret=transport_json_reply(hreq,reply);
+ out:
+  jparse_free(body);
+  return ret;
+}
+
+static int
+jsonapi_reply_transport_result(struct httpd_request *hreq)
+{
+  struct output_transport_result result;
+  uint64_t id;
+  json_object *reply;
+  if (safe_atou64(hreq->path_parts[2],&id)<0
+      || player_transport_result_get(hreq->path_parts[5],&result)<0 || result.identity.device_id!=id) return HTTP_NOTFOUND;
+  reply=json_object_new_object();
+  json_object_object_add(reply,"schema",json_object_new_string("podconnect.output_transport_result.v1"));
+  json_object_object_add(reply,"ok",json_object_new_boolean(true));
+  json_object_object_add(reply,"token",json_object_new_string(result.command.token));
+  json_object_object_add(reply,"identity",transport_identity_json(&result.identity));
+  json_object_object_add(reply,"outcome",json_object_new_string(result.outcome==1 ? "pending" : result.outcome==-1 ? "failed" : result.outcome==-2 ? "unknown" : "accepted"));
+  json_object_object_add(reply,"pin_remaining_ms",json_object_new_int(result.remaining_ms));
+  json_object_object_add(reply,"physical_result_verified",json_object_new_boolean(false));
+  return transport_json_reply(hreq,reply);
+}
