+/* Controlled owner-state regression only: no real connected speaker or
+ * protocol success is fabricated by these struct fixtures. */
+static struct output_transport_request transport_fixture_request(const char *action)
+{
+  static unsigned n;
+  struct output_transport_request r={.device_id=1,.percent=-1};
+  snprintf(r.native_prepare_id,sizeof(r.native_prepare_id),"%032x",++n);
+  memset(r.args_digest,'a',64); r.args_digest[64]=0;
+  snprintf(r.action,sizeof(r.action),"%s",action);
+  return r;
+}
+static void transport_fixture_end_pin(void)
