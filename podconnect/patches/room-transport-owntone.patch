+static void exact_transport_route_pin_owner(void)
+{
+  struct output_device *a=add_device(1), *b=add_device(2);
+  struct output_transport_request request, changed;
+  struct output_transport_result prepared, result;
+  struct output_transport_identity identity;
+  bool busy;
+  unsigned char session_a, session_b;
+  int original_volume;
+  outputs_device_select(a,-1);
+  assert(outputs_device_session_add(a->id,&session_a)==0);
+  a->state=OUTPUT_STATE_CONNECTED;
+  outputs_transport_input_changed(101,"/srv/media/spotify",true);
+  assert(outputs_transport_state_get(1,&identity,&busy)==0 && !busy);
+  outputs_transport_input_changed(101,"http://radio.invalid",false);
+  assert(outputs_transport_state_get(1,&identity,&busy)<0);
+  outputs_transport_input_changed(101,"/srv/media/spotify",true);
+  request=transport_fixture_request("resume");
+  assert(outputs_transport_prepare(&request,&prepared)==0);
+  assert(strlen(prepared.command.token)==32 && prepared.remaining_ms==10000);
+  /* Route ABA is rejected even though exactly the original output is selected. */
+  outputs_device_deselect(a); outputs_device_select(a,-1);
+  request=prepared.command; memcpy(request.expected_input_path_digest,prepared.identity.input_path_digest,65);
+  assert(outputs_transport_commit(&request,&result)<0);
+  assert(outputs_transport_commit(&request,&result)<0 && !outputs_transport_busy());
+  request=transport_fixture_request("pause"); assert(outputs_transport_prepare(&request,&prepared)==0);
+  outputs_device_select(b,-1); request=prepared.command;
+  assert(outputs_transport_commit(&request,&result)<0); outputs_device_deselect(b);
+  /* Exact session replacement, same pointer ABA, and source replacement fence. */
+  request=transport_fixture_request("next"); assert(outputs_transport_prepare(&request,&prepared)==0);
+  outputs_device_session_remove(1); assert(outputs_device_session_add(1,&session_a)==0);
+  request=prepared.command; memcpy(request.expected_input_path_digest,prepared.identity.input_path_digest,65); assert(outputs_transport_commit(&request,&result)<0);
+  request=transport_fixture_request("previous"); assert(outputs_transport_prepare(&request,&prepared)==0);
+  outputs_transport_input_changed(102,"/srv/media/spotify",true); outputs_transport_input_changed(101,"/srv/media/spotify",true);
+  request=prepared.command; memcpy(request.expected_input_path_digest,prepared.identity.input_path_digest,65); assert(outputs_transport_commit(&request,&result)<0);
+  request=transport_fixture_request("resume"); assert(outputs_transport_prepare(&request,&prepared)==0);
+  request=prepared.command; memcpy(request.expected_input_path_digest,prepared.identity.input_path_digest,65); changed=request; changed.args_digest[0]='b';
+  assert(outputs_transport_commit(&changed,&result)<0);
+  assert(outputs_transport_commit(&request,&result)<0); /* Tamper consumes exact token. */
+  request=transport_fixture_request("pause"); assert(outputs_transport_prepare(&request,&prepared)==0);
+  request=prepared.command; memcpy(request.expected_input_path_digest,prepared.identity.input_path_digest,65); transport_find(request.token)->expiry.tv_sec-=11;
+  assert(outputs_transport_commit(&request,&result)<0);
+  {
+    char own_digest[65];
+    assert(outputs_transport_state_get(1,&identity,&busy)==0);
+    memcpy(own_digest,identity.input_path_digest,65);
+    outputs_transport_input_changed(101,"/srv/media/other",true);
+    request=transport_fixture_request("pause"); assert(outputs_transport_prepare(&request,&prepared)==0);
+    request=prepared.command; memcpy(request.expected_input_path_digest,own_digest,65);
+    assert(outputs_transport_commit(&request,&result)<0); /* Other engine FIFO cannot borrow this route. */
+    outputs_transport_input_changed(101,"/srv/media/spotify",true);
+  }
+  request=transport_fixture_request("volume"); request.percent=27;
+  assert(outputs_transport_prepare(&request,&result)<0); /* No physical volume authority. */
+  request=transport_fixture_request("resume"); assert(outputs_transport_prepare(&request,&prepared)==0);
+  request=prepared.command; memcpy(request.expected_input_path_digest,prepared.identity.input_path_digest,65); original_volume=a->volume;
+  assert(outputs_transport_commit(&request,&result)==0 && outputs_transport_busy());
+  assert(outputs_transport_current(&result));
+  assert(a->volume==original_volume); /* No 35 or manual-volume write. */
+  outputs_device_select(b,-1); outputs_device_deselect(a);
+  assert(a->selected && !b->selected && a->volume==original_volume);
+  assert(outputs_device_session_add(2,&session_b)<0);
+  assert(outputs_transport_commit(&request,&prepared)<0); /* One use. */
+  assert(outputs_transport_result_get(result.command.token,&prepared)==0);
+  assert(outputs_transport_busy()); /* Reading an ACK never releases early. */
+  outputs_device_session_remove(1);
+  assert(!outputs_transport_current(&result) && outputs_transport_busy());
+  assert(outputs_device_session_add(1,&session_a)<0); /* Loss does not hand off. */
+  outputs_device_select(b,-1); assert(!b->selected);
+  transport_fixture_end_pin();
+  assert(outputs_device_session_add(1,&session_a)==0);
+  outputs_device_session_remove(1);
+  clear_devices();
+  puts("PASS transport owner route/session/input ABA, whole-set pin, one-use/tamper/expiry, loss quarantine, no volume/start35; no device claim");
+}
