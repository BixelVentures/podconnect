+/* Release never borrows the generic accepted transport receipt. */
+static json_object *
+transport_release_json(const struct output_transport_result *r, bool result, bool commit)
+{
+  json_object *o = json_object_new_object();
+  json_object_object_add(o, "schema",
+      json_object_new_string(
+          result ? "podconnect.output_transport_release_result.v1" : "podconnect.output_transport_release_prepare.v1"));
+  json_object_object_add(
+      o, "ok", json_object_new_boolean(result ? r->release_terminal : !commit || r->release_durable_pending));
+  json_object_object_add(o, "token", json_object_new_string(r->command.token));
+  json_object_object_add(o, "native_prepare_id", json_object_new_string(r->command.native_prepare_id));
+  json_object_object_add(o, "args_digest", json_object_new_string(r->command.args_digest));
+  transport_native_binding_json(o, &r->command.native_owner, r->command.native_revision);
+  json_object_object_add(o, "identity", transport_identity_json(&r->identity));
+  json_object_object_add(o, "writer_proof", queue_writer_json(&r->command.writer));
+  json_object_object_add(o, "purpose", json_object_new_string("manual_release_v1"));
+  if (result)
+    {
+      json_object_object_add(o, "outcome",
+          json_object_new_string(r->release_terminal ? "retired"
+                                 : r->outcome == -1  ? "rejected"
+                                                     : "unknown"));
+      json_object_object_add(o, "terminal", json_object_new_boolean(r->release_terminal));
+      json_object_object_add(o, "contexts_drained", json_object_new_boolean(r->release_contexts_drained));
+      json_object_object_add(o, "retry_allowed", json_object_new_boolean(false));
+    }
+  else
+    {
+      json_object_object_add(o, "phase", json_object_new_string(commit ? "committed" : "prepared"));
+      json_object_object_add(o, "outcome",
+          json_object_new_string(!commit                      ? "prepared"
+                                 : r->release_durable_pending ? "pending"
+                                                              : "unknown"));
+      json_object_object_add(o, "gate_closed", json_object_new_boolean(r->release_gate_closed));
+      json_object_object_add(o, "durable_pending", json_object_new_boolean(r->release_durable_pending));
+      json_object_object_add(o, "remaining_ms", json_object_new_int(r->remaining_ms));
+    }
+  json_object_object_add(o, "physical_result_verified", json_object_new_boolean(false));
+  return o;
+}
+static int
+jsonapi_reply_transport_release_confirm(struct httpd_request *hreq)
+{
+  json_object *body = transport_parse_body_limit(hreq->in_body, 1024), *closed;
+  struct output_transport_result result;
+  char token[33], prepare[33];
+  uint64_t id, revision;
+  int ret = HTTP_BADREQUEST;
+  if (!body || json_object_object_length(body) != 4 || safe_atou64(hreq->path_parts[2], &id) < 0
+      || !transport_json_string(body, "token", token, sizeof(token)) || !queue_wire_hex(token, 32)
+      || !transport_json_string(body, "native_prepare_id", prepare, sizeof(prepare)) || !queue_wire_hex(prepare, 32)
+      || transport_native_counter(body, "native_revision", &revision) < 0 || !revision || revision == UINT64_MAX
+      || !json_object_object_get_ex(body, "native_close_done", &closed)
+      || !json_object_is_type(closed, json_type_boolean) || !json_object_get_boolean(closed))
+    goto out;
+  ret = 409;
+  if (player_transport_release_confirm(id, token, prepare, revision, true, &result) < 0)
+    goto out;
+  ret = transport_json_reply(hreq, transport_release_json(&result, true, true));
+out:
+  if (body)
+    jparse_free(body);
+  return ret;
+}
