+static bool
+release_wrap_predecessor(struct start_slot *s, json_object *o)
+{
+  struct transport_release_operation *op = &release_operation;
+  if (!op->prepared || !op->used || !op->predecessor.completed_token[0]
+      || strcmp(s->result.command.token, op->predecessor.completed_token))
+    return true;
+  if (s->retirement.outcome != OUTPUT_RETIRE_PENDING && s->retirement.outcome != OUTPUT_RETIRE_RETIRED_KNOWN
+      && s->retirement.outcome != OUTPUT_RETIRE_UNKNOWN)
+    return false;
+  op->record.retirement = s->retirement.outcome;
+  if (s->retirement.outcome == OUTPUT_RETIRE_RETIRED_KNOWN)
+    {
+      op->record.retired_epoch = s->retirement.input_epoch;
+      strcpy(op->record.retired_c_process, outputs_process);
