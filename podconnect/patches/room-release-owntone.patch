+#define RJ(k) json_object_object_add(o, #k, json_object_new_uint64(v->k))
+  json_object_object_add(o, "process", json_object_new_string(v->process));
+  json_object_object_add(o, "input_path_digest", json_object_new_string(v->input_path_digest));
+  RJ(device_id);
+  RJ(device_incarnation);
+  RJ(session_epoch);
+  RJ(route_revision);
+  RJ(selection_revision);
+  RJ(input_generation);
+  RJ(input_item_id);
+#undef RJ
+  return o;
+}
+static bool
+release_identity_parse(json_object *o, struct output_transport_identity *v)
+{
+  if (!o || !json_object_is_type(o, json_type_object) || json_object_object_length(o) != 9)
+    return false;
+#define RI(k) release_json_u64(o, #k, &v->k)
+  return release_json_string(o, "process", v->process, sizeof(v->process))
+         && release_json_string(o, "input_path_digest", v->input_path_digest, sizeof(v->input_path_digest))
+         && RI(device_id) && RI(device_incarnation) && RI(session_epoch) && RI(route_revision) && RI(selection_revision)
+         && RI(input_generation) && RI(input_item_id);
+#undef RI
+}
+static json_object *
+release_journal_json(const struct transport_release_record *r)
+{
+  const struct output_transport_request *c = &r->result.command;
+  json_object *o = json_object_new_object();
+#define JS(k, v) json_object_object_add(o, k, json_object_new_string(v))
+#define JN(k, v) json_object_object_add(o, k, json_object_new_uint64(v))
+  JS("schema", "podconnect.output_transport_release_journal.v1");
+  JS("purpose", "manual_release_v1");
+  JS("token", c->token);
+  JS("c_process", r->result.identity.process);
+  JS("native_boot_id", c->writer.native_process.boot_id);
+  JN("native_pid", c->writer.native_process.pid);
+  JN("native_start_ticks", c->writer.native_process.proc_start_ticks);
+  JN("native_pid_namespace_device", r->pidns_device);
+  JN("native_pid_namespace_inode", r->pidns_inode);
+  JS("native_prepare_id", c->native_prepare_id);
+  JS("args_digest", c->args_digest);
+  JN("native_revision", c->native_revision);
+  json_object_object_add(o, "native_owner", start_journal_owner(&c->native_owner));
+  json_object_object_add(o, "writer_proof", release_writer_json(&c->writer));
+  json_object_object_add(o, "identity", release_identity_json(&r->result.identity));
+  JS("retired_c_process", r->retired_c_process);
+  JS("input_path", r->input_path);
+  JN("admitted_input_epoch", r->admitted_epoch);
+  JN("retired_input_epoch", r->retired_epoch);
+  JS("retirement_outcome", r->retirement == OUTPUT_RETIRE_RETIRED_KNOWN ? "retired_known"
+                           : r->retirement == OUTPUT_RETIRE_PENDING     ? "pending"
+                                                                        : "unknown");
+  json_object_object_add(o, "retirement_reopen_consumed", json_object_new_boolean(r->reopen_consumed));
+#undef JS
+#undef JN
+  return o;
+}
+static bool
+release_journal_parse(json_object *o, const struct db_start_guard *guard)
+{
+  struct transport_release_record r = { 0 };
+  struct output_transport_request *c = &r.result.command;
+  json_object *owner, *writer, *identity;
+  char purpose[32], outcome[32], boot[37], process[37];
+  uint64_t pid, ticks;
+  json_object *saved_schema;
+  if (!json_object_object_get_ex(o, "schema", &saved_schema) || !json_object_is_type(saved_schema, json_type_string)
+      || strcmp(json_object_get_string(saved_schema), "podconnect.output_transport_release_journal.v1")
+      || json_object_object_length(o) != 21
+      || strcmp(json_object_to_json_string_ext(o, JSON_C_TO_STRING_PLAIN), guard->payload)
+      || !release_json_string(o, "purpose", purpose, sizeof(purpose)) || strcmp(purpose, "manual_release_v1")
+      || !release_json_string(o, "token", c->token, sizeof(c->token)) || !transport_hex(c->token, 32)
+      || strcmp(c->token, guard->token) || !release_json_string(o, "c_process", process, sizeof(process))
+      || strcmp(process, guard->c_process) || !release_json_string(o, "native_boot_id", boot, sizeof(boot))
+      || strcmp(boot, guard->boot_id) || !release_json_u64(o, "native_pid", &pid) || pid != guard->pid
+      || !release_json_u64(o, "native_start_ticks", &ticks) || ticks != guard->proc_start_ticks
+      || !release_json_u64(o, "native_pid_namespace_device", &r.pidns_device)
+      || !release_json_u64(o, "native_pid_namespace_inode", &r.pidns_inode) || !r.pidns_inode
+      || !release_json_string(o, "native_prepare_id", c->native_prepare_id, sizeof(c->native_prepare_id))
+      || !transport_hex(c->native_prepare_id, 32)
+      || !release_json_string(o, "args_digest", c->args_digest, sizeof(c->args_digest))
+      || !transport_hex(c->args_digest, 64) || !release_json_u64(o, "native_revision", &c->native_revision)
+      || !c->native_revision || c->native_revision == UINT64_MAX
+      || !json_object_object_get_ex(o, "native_owner", &owner) || !release_owner_parse(owner, &c->native_owner)
+      || !json_object_object_get_ex(o, "writer_proof", &writer) || !release_writer_parse(writer, &c->writer)
+      || !json_object_object_get_ex(o, "identity", &identity) || !release_identity_parse(identity, &r.result.identity)
+      || strcmp(process, r.result.identity.process) || !r.result.identity.device_id || !r.result.identity.input_item_id
+      || strcmp(boot, c->writer.native_process.boot_id) || pid != c->writer.native_process.pid
+      || ticks != c->writer.native_process.proc_start_ticks
+      || strcmp(c->writer.input_path_digest, r.result.identity.input_path_digest)
+      || !native_owner_valid(&c->native_owner, r.result.identity.device_id)
+      || !release_json_string(o, "input_path", r.input_path, sizeof(r.input_path)) || r.input_path[0] != '/'
+      || !release_json_u64(o, "admitted_input_epoch", &r.admitted_epoch)
+      || !release_json_u64(o, "retired_input_epoch", &r.retired_epoch)
+      || !release_json_bool(o, "retirement_reopen_consumed", &r.reopen_consumed)
+      || !release_json_string(o, "retirement_outcome", outcome, sizeof(outcome)))
+    return false;
+  if (!strcmp(outcome, "pending"))
+    r.retirement = OUTPUT_RETIRE_PENDING;
+  else if (!strcmp(outcome, "retired_known"))
+    r.retirement = OUTPUT_RETIRE_RETIRED_KNOWN;
+  else if (!strcmp(outcome, "unknown"))
+    r.retirement = OUTPUT_RETIRE_UNKNOWN;
+  else
+    return false;
+  json_object *retired_process;
+  if (!json_object_object_get_ex(o, "retired_c_process", &retired_process)
+      || !json_object_is_type(retired_process, json_type_string))
+    return false;
+  const char *retired = json_object_get_string(retired_process);
+  if (r.retirement == OUTPUT_RETIRE_RETIRED_KNOWN)
+    {
+      if (strlen(retired) != 36 || !r.retired_epoch
+          || (!strcmp(retired, process) && r.retired_epoch <= r.admitted_epoch))
+	return false;
+      strcpy(r.retired_c_process, retired);
+    }
+  else if (*retired || r.reopen_consumed || r.retired_epoch)
+    return false;
+  c->device_id = r.result.identity.device_id;
+  c->bound = true;
+  c->percent = -1;
+  strcpy(c->action, "release");
+  release_record = r;
+  start_journal_pidns_device = r.pidns_device;
+  start_journal_pidns_inode = r.pidns_inode;
+  start_journal_retirement_outcome = r.retirement;
+  start_journal_retirement_reopen_consumed = r.reopen_consumed;
+  return true;
+}
+
+static bool
+release_journal_payload_valid(json_object *o)
+{
+  return release_journal_parse(o, &start_journal);
+}
+static bool
+release_is_typed_journal(void)
+{
+  json_object *o, *v;
+  bool valid = false;
+  if (!start_journal.payload)
+    return false;
+  o = json_tokener_parse(start_journal.payload);
+  if (o && json_object_object_get_ex(o, "schema", &v) && json_object_is_type(v, json_type_string))
+    {
+      const char *schema = json_object_get_string(v);
+      valid = !strcmp(schema, "podconnect.output_transport_release_journal.v1")
+              || !strcmp(schema, "podconnect.output_manual_release_start_journal.v1")
+              || !strcmp(schema, "podconnect.output_manual_release_move_journal.v1");
+    }
+  if (o)
+    json_object_put(o);
+  return valid;
+}
+
+struct transport_release_operation {
+  struct transport_release_record record;
+  struct output_retirement_request predecessor;
+  const void *session;
+  struct timespec expiry;
+  bool prepared, used, effect_pending, durable, terminal;
+};
+static struct transport_release_operation release_operation;
+
+static void
+release_observe(struct output_transport_result *out)
+{
+  *out = release_operation.record.result;
+  out->remaining_ms = transport_remaining(&release_operation.expiry);
+  out->release_gate_closed = outputs_start_gate_closed();
+  out->release_durable_pending = release_operation.durable;
+  out->release_terminal = release_operation.terminal;
+  out->release_contexts_drained = start_contexts_drained();
+  out->outcome = release_operation.terminal         ? 0
+                 : release_operation.durable        ? 1
+                 : release_operation.effect_pending ? -2
+                 : release_operation.used           ? -1
+                                                    : 0;
+}
+static bool
+release_route_retirable(const struct transport_release_operation *);
+static bool
+release_protected_owned(const struct output_native_owner *owner, const struct output_transport_identity *identity)
+{
+  struct output_transport_identity actual;
+  return start_active && start_retirement_source_current(start_active, &actual)
+         && transport_identity_equal(&actual, identity) && outputs_start_bound_owner_current(owner, identity, false);
+}
+static bool
+release_current(struct transport_release_operation *op, bool admission)
+{
+  struct output_transport_identity actual;
+  uint64_t epoch = 0;
+  struct output_transport_request *c = &op->record.result.command;
+  return (!admission || transport_remaining(&op->expiry)) && !outputs_start_gate_closed() && release_route_retirable(op)
+         && transport_bound_available(c->device_id, &c->native_owner, c->native_revision)
+         && transport_identity_get(c->device_id, &actual) == 0
+         && transport_identity_equal(&actual, &op->record.result.identity)
+         && queue_writer_current(&c->writer, &actual, &epoch) && epoch == op->record.admitted_epoch
+         && (op->predecessor.completed_token[0]
+                 ? start_active && !strcmp(start_active->result.command.token, op->predecessor.completed_token)
+                       && release_protected_owned(&c->native_owner, &actual)
+                 : start_route_clean_absent()
+                       || (!start_active && !start_scope && !strcmp(start_journal.token, c->token)
+                           && start_journal_retirement_outcome == OUTPUT_RETIRE_PENDING));
+}
+static int
+release_prepare(const struct output_transport_request *request, struct output_transport_result *out)
+{
+  struct transport_release_operation op = { 0 };
+  struct output_transport_identity identity;
+  struct output_device *d;
+  struct db_queue_item *item;
+  uint64_t epoch = 0;
+  if (!request || !out || !request->bound || !request->native_revision || request->native_revision == UINT64_MAX
+      || !transport_hex(request->native_prepare_id, 32) || !transport_hex(request->args_digest, 64)
+      || !native_owner_valid(&request->native_owner, request->device_id)
+      || (release_operation.prepared && !release_operation.terminal
+          && (release_operation.effect_pending
+              || (!release_operation.used && transport_remaining(&release_operation.expiry))))
+      || !transport_bound_available(request->device_id, &request->native_owner, request->native_revision)
+      || transport_identity_get(request->device_id, &identity) < 0
+      || !queue_writer_current(&request->writer, &identity, &epoch) || !(d = outputs_device_get(request->device_id))
+      || !start_contexts_drained() || !(item = db_queue_fetch_byitemid(identity.input_item_id)))
+    return -1;
+  bool path = item->path && item->path[0] == '/' && strlen(item->path) < sizeof(op.record.input_path);
+  if (path)
+    strcpy(op.record.input_path, item->path);
+  free_queue_item(item, 0);
+  if (!path)
+    return -1;
+  op.record.result.command = *request;
+  op.record.result.identity = identity;
+  op.record.admitted_epoch = epoch;
+  op.session = d->session;
+  if (!release_route_retirable(&op))
+    return -1;
+  if (release_protected_owned(&request->native_owner, &identity))
+    {
+      struct start_slot *s = start_active;
+      if (!s || request->writer.source_epoch != s->result.writer_source_epoch
+          || request->writer.writer_fd != s->result.command.writer_fd
+          || request->writer.pipe_device != s->result.pipe_device || request->writer.pipe_inode != s->result.pipe_inode
+          || strcmp(request->writer.native_process.boot_id, s->result.command.native_process.boot_id)
+          || request->writer.native_process.pid != s->result.command.native_process.pid
+          || request->writer.native_process.proc_start_ticks != s->result.command.native_process.proc_start_ticks)
+	return -1;
+      op.predecessor.device_id = request->device_id;
+      op.predecessor.move_existing_session = s->result.command.move_existing_session;
+      strcpy(op.predecessor.completed_token, s->result.command.token);
+      strcpy(op.predecessor.native_reservation_id, request->native_prepare_id);
+      strcpy(op.predecessor.native_incarnation, s->result.command.native_incarnation);
+      op.predecessor.native_process = request->writer.native_process;
+      op.predecessor.writer_source_epoch = request->writer.source_epoch;
+      op.predecessor.writer_fd = request->writer.writer_fd;
+      op.predecessor.pipe_device = request->writer.pipe_device;
+      op.predecessor.pipe_inode = request->writer.pipe_inode;
+      op.predecessor.input_epoch = epoch;
+    }
+  else if (!start_route_clean_absent())
+    return -1;
+  if (!start_pid_namespace(&op.record.pidns_device, &op.record.pidns_inode)
+      || clock_gettime(CLOCK_MONOTONIC, &op.expiry) < 0)
+    return -1;
+  op.expiry.tv_sec += 10;
+  op.prepared = true;
+  char uuid[37];
+  size_t j = 0;
+  outputs_attention_uuid(uuid);
+  for (size_t i = 0; i < 36; i++)
+    if (uuid[i] != '-')
+      op.record.result.command.token[j++] = uuid[i];
+  op.record.result.command.token[j] = 0;
+  release_operation = op;
+  release_observe(out);
+  return 0;
+}
+static int
+release_journal_save(struct transport_release_record *r)
+{
+  json_object *o = release_journal_json(r), *outer = NULL, *manual;
+  struct db_start_guard next = { 0 };
+  int ret;
+  char *copy;
+  if (!o)
+    return -1;
+  const struct output_queue_writer *w = &r->result.command.writer;
+  /* A recovery update retains the genuine predecessor unchanged. A new
+   * ordinary release on a later route must replace, never inherit, it. */
+  if (start_journal.payload && strcmp(start_journal.token, r->result.command.token))
+    {
+      outer = json_tokener_parse(start_journal.payload);
+      if (outer && json_object_object_get_ex(outer, "manual_release", &manual)
+          && json_object_is_type(manual, json_type_object))
+	{
+	  json_object *saved;
+	  if (json_object_object_get_ex(manual, "token", &saved) && json_object_is_type(saved, json_type_string)
+	      && !strcmp(json_object_get_string(saved), r->result.command.token))
+	    {
+	      json_object_object_add(outer, "manual_release", o);
+	      o = outer;
+	      outer = NULL;
+	      next = start_journal;
+	    }
+	}
+      if (outer)
+	json_object_put(outer);
+    }
+  if (!next.token[0])
+    {
+      strcpy(next.token, r->result.command.token);
+      strcpy(next.c_process, r->result.identity.process);
+      strcpy(next.boot_id, w->native_process.boot_id);
+      next.pid = w->native_process.pid;
+      next.proc_start_ticks = w->native_process.proc_start_ticks;
+    }
+  next.payload = (char *)json_object_to_json_string_ext(o, JSON_C_TO_STRING_PLAIN);
+  copy = next.payload ? strdup(next.payload) : NULL;
+  ret = copy ? db_start_guard_save(&start_journal, &next) : -1;
+  if (ret == 0)
+    {
+      free(start_journal.payload);
+      start_journal = next;
+      start_journal.payload = copy;
+      release_record = *r;
+      start_journal_pidns_device = r->pidns_device;
+      start_journal_pidns_inode = r->pidns_inode;
+      start_journal_retirement_outcome = r->retirement;
+      start_journal_retirement_reopen_consumed = r->reopen_consumed;
+    }
+  else
+    free(copy);
+  json_object_put(o);
+  return ret;
+}
+static int
+release_commit(const struct output_transport_request *request, struct output_transport_result *out)
+{
+  struct transport_release_operation *op = &release_operation;
+  const struct output_transport_request *saved = &op->record.result.command;
+  struct output_retirement_result retired;
+  if (!request || !out || !op->prepared || op->used || strcmp(request->token, saved->token))
+    return -1;
+  op->used = true;
+  if (strcmp(request->native_prepare_id, saved->native_prepare_id) || strcmp(request->action, "release")
+      || strcmp(request->args_digest, saved->args_digest) || !request->bound
+      || !native_owner_equal(&request->native_owner, &saved->native_owner)
+      || request->native_revision != saved->native_revision || !queue_writer_equal(&request->writer, &saved->writer)
+      || strcmp(request->expected_input_path_digest, op->record.result.identity.input_path_digest)
+      || !release_current(op, true))
+    return -1;
+  if (op->predecessor.completed_token[0])
+    {
+      if (outputs_retirement_prepare(&op->predecessor, &retired) < 0)
+	return -1;
+      op->effect_pending = true;
+      if (!start_journal_payload_valid() || strcmp(release_record.result.command.token, saved->token))
+	{
+	  start_journal_fault = true;
+	  start_gate_set(true);
+	  release_observe(out);
+	  return 0;
+	}
+      if (retired.ok && retired.durable_pending && retired.gate_closed && retired.reader_ready_closed)
+	{
+	  strcpy(op->predecessor.retirement_token, retired.command.retirement_token);
+	  op->durable = true;
+	}
+      release_observe(out);
+      return 0;
+    }
+  op->record.retirement = OUTPUT_RETIRE_PENDING;
+  op->effect_pending = true;
+  if (release_journal_save(&op->record) < 0)
+    {
+      start_journal_fault = true;
+      start_gate_set(true);
+      release_observe(out);
+      return 0;
+    }
+  /* The write may have waited. Do not acknowledge permission to close Native
+   * unless the exact reader, writer and route still match behind the gate. */
+  bool current = start_journal_payload_valid() && !strcmp(release_record.result.command.token, saved->token)
+                 && release_current(op, false);
+  start_gate_set(true);
+  atomic_store(&start_owned_latch, true);
+  struct input_fifo_identity reader = { 0 };
+  struct timespec deadline;
+  if (!current || clock_gettime(CLOCK_MONOTONIC, &deadline) < 0)
+    {
+      release_observe(out);
+      return 0;
+    }
+  deadline.tv_nsec += 100000000;
+  if (deadline.tv_nsec >= 1000000000)
+    {
+      deadline.tv_sec++;
+      deadline.tv_nsec -= 1000000000;
+    }
+  if (input_fifo_owner_get(
+          op->record.result.identity.input_item_id, op->record.input_path, false, 0, 0, &deadline, &reader)
+          < 0
+      || reader.device != saved->writer.pipe_device || reader.inode != saved->writer.pipe_inode
+      || reader.epoch != op->record.admitted_epoch
+      || !start_proven_writer_fd(
+          &saved->writer.native_process, saved->writer.writer_fd, saved->writer.pipe_device, saved->writer.pipe_inode))
+    {
+      release_observe(out);
+      return 0;
+    }
+  op->durable = true;
+  release_observe(out);
+  return 0;
+}
+static int
+release_result(const char *token, struct output_transport_result *out)
+{
+  if (!out || !token)
+    return -1;
+  if (release_operation.prepared && !strcmp(token, release_operation.record.result.command.token))
+    {
+      release_observe(out);
+      return 0;
+    }
+  if (start_journal_fault || !release_is_typed_journal() || !start_journal_payload_valid()
+      || strcmp(token, release_record.result.command.token))
+    return -1;
+  *out = release_record.result;
+  out->release_gate_closed = outputs_start_gate_closed();
+  out->release_terminal = start_journal_retirement_outcome == OUTPUT_RETIRE_RETIRED_KNOWN && start_retired_stage_ready
+                          && start_contexts_drained();
+  out->release_contexts_drained = start_contexts_drained();
+  out->outcome = out->release_terminal ? 0 : -2;
+  /* Only the exact consumed producer may finish closing after a lost reply.
+   * This read grants no mutation/replay and never adopts a new route or PID. */
+  uint64_t fd = 0;
+  const struct output_queue_writer *w = &out->command.writer;
+  if (start_startup_quarantine && start_journal_retirement_outcome == OUTPUT_RETIRE_PENDING
+      && outputs_start_gate_closed()
+      && start_proven_writer_fd(&w->native_process, w->writer_fd, w->pipe_device, w->pipe_inode)
+      && start_unique_writer_fd(&w->native_process, w->pipe_device, w->pipe_inode, &fd) && fd == w->writer_fd)
+    {
+      out->release_durable_pending = true;
+      out->outcome = 1;
+    }
+  return 0;
+}
+
+static bool
+release_route_retirable(const struct transport_release_operation *op)
+{
+  const struct output_transport_identity *r = &op->record.result.identity;
+  struct output_device *d = outputs_device_get(r->device_id), *scan;
+  if (!d || !d->selected || d->incarnation != r->device_incarnation || d->route_revision != r->route_revision
+      || r->selection_revision == UINT64_MAX
+      || transport_selection_revision != (d->session ? r->selection_revision : r->selection_revision + 1) || d->busy
+      || d->attention_lease || d->attention_retiring_session || d->attention_restart_pending || d->attention_restoring
+      || (d->session ? d->session != op->session || d->session_epoch != r->session_epoch
+                     : d->session_epoch != r->session_epoch + 1))
+    return false;
+  for (scan = outputs_device_list; scan; scan = scan->next)
+    if (scan != d
+        && (scan->selected || scan->session || scan->busy || scan->attention_lease || scan->attention_retiring_session
+            || scan->attention_restart_pending || scan->attention_restoring))
+      return false;
+  return !transport_pin && !room_volume_pin_busy() && !room_volume_undrained() && start_contexts_drained();
