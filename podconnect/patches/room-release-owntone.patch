+void
+outputs_transport_release_recover_pending(void)
+{
+  struct output_device *d;
+  struct input_fifo_identity reader = { 0 };
+  struct timespec deadline;
+  /* Called once after input_init and before player emission can start. A
+   * persisted token is evidence to retire, never authority for a new route. */
+  if (start_journal_fault || !start_startup_quarantine || !start_journal.payload || !release_is_typed_journal()
+      || !start_journal_payload_valid() || start_journal_retirement_outcome != OUTPUT_RETIRE_PENDING
+      || !strcmp(start_journal.c_process, outputs_process) || start_active || start_scope || transport_pin
+      || transport_custody_busy() || room_volume_pin_busy() || !start_contexts_drained())
+    return;
+  for (d = outputs_device_list; d; d = d->next)
+    if (d->selected || d->session || d->busy || d->attention_lease || d->attention_retiring_session
+        || d->attention_restart_pending || d->attention_restoring)
+      return;
+  struct transport_release_record r = release_record;
+  const struct output_queue_writer *w = &r.result.command.writer;
+  if (start_all_writers_closed(&w->native_process, w->pipe_device, w->pipe_inode) != 1
+      || !release_fifo_has_no_writers(w->pipe_device, w->pipe_inode) || clock_gettime(CLOCK_MONOTONIC, &deadline) < 0)
+    return;
+  deadline.tv_sec++;
+  if (input_fifo_retire_recovered(r.input_path, w->pipe_device, w->pipe_inode, &deadline, &reader) < 0
+      || reader.device != w->pipe_device || reader.inode != w->pipe_inode || !reader.epoch
+      || start_all_writers_closed(&w->native_process, w->pipe_device, w->pipe_inode) != 1
+      || !release_fifo_has_no_writers(w->pipe_device, w->pipe_inode) || !start_contexts_drained())
+    return;
+  r.retired_epoch = reader.epoch;
+  strcpy(r.retired_c_process, outputs_process);
+  r.retirement = OUTPUT_RETIRE_RETIRED_KNOWN;
+  if (release_journal_save(&r) < 0)
+    {
+      start_journal_fault = true;
+      return;
+    }
+  start_startup_quarantine = false;
+  atomic_store(&start_owned_latch, false);
+  start_retired_reopen_pending = true;
+}
