+/* Recovery has no live Native admission to exclude a successor. Inspect the
+ * visible process namespace, not merely the old PID. Ambiguous visibility is
+ * fenced; no privilege or numeric-PID fallback is introduced. */
+static bool
+release_fifo_has_no_writers_raw(uint64_t device, uint64_t inode)
+{
+  DIR *processes = opendir("/proc");
+  struct dirent *process, *entry;
+  bool valid = processes != NULL;
+  char directory[80], path[128], line[256], *end;
+  struct stat st;
+  if (!processes || !device || !inode)
+    {
+      if (processes)
+	closedir(processes);
+      return false;
+    }
+  while (valid)
+    {
+      errno = 0;
+      process = readdir(processes);
+      if (!process)
+	{
+	  if (errno)
+	    valid = false;
+	  break;
+	}
+      if (process->d_name[0] < '0' || process->d_name[0] > '9')
+	continue;
+      errno = 0;
+      unsigned long pid = strtoul(process->d_name, &end, 10);
+      if (errno || *end || !pid || pid > INT_MAX)
+	{
+	  valid = false;
+	  break;
+	}
+      if (snprintf(directory, sizeof(directory), "/proc/%lu/fd", pid) >= (int)sizeof(directory))
+	{
+	  valid = false;
+	  break;
+	}
+      DIR *fds = opendir(directory);
+      if (!fds)
+	{
+	  if (errno == ENOENT)
+	    continue;
+	  valid = false;
+	  break;
+	}
+      while (valid)
+	{
+	  errno = 0;
+	  entry = readdir(fds);
+	  if (!entry)
+	    {
+	      if (errno)
+		valid = false;
+	      break;
+	    }
+	  if (entry->d_name[0] == '.')
+	    continue;
+	  errno = 0;
+	  unsigned long fd = strtoul(entry->d_name, &end, 10);
+	  if (errno || *end || fd > INT_MAX
+	      || snprintf(path, sizeof(path), "%s/%lu", directory, fd) >= (int)sizeof(path))
+	    {
+	      valid = false;
+	      break;
+	    }
+	  if (stat(path, &st) < 0)
+	    {
+	      if (errno == ENOENT)
+		continue;
+	      valid = false;
+	      break;
+	    }
+	  if (!S_ISFIFO(st.st_mode) || (uint64_t)st.st_dev != device || (uint64_t)st.st_ino != inode)
+	    continue;
+	  if (snprintf(path, sizeof(path), "/proc/%lu/fdinfo/%lu", pid, fd) >= (int)sizeof(path))
+	    {
+	      valid = false;
+	      break;
+	    }
+	  FILE *info = fopen(path, "r");
+	  unsigned long flags = 0;
+	  bool found = false;
+	  if (!info)
+	    {
+	      valid = false;
+	      break;
+	    }
+	  while (fgets(line, sizeof(line), info))
+	    if (!strncmp(line, "flags:", 6))
+	      {
+		errno = 0;
+		flags = strtoul(line + 6, &end, 8);
+		found = !errno && end != line + 6 && (*end == '\n' || !*end);
+		break;
+	      }
+	  fclose(info);
+	  if (!found || (flags & O_ACCMODE) != O_RDONLY)
+	    valid = false;
+	}
+      closedir(fds);
+    }
+  closedir(processes);
+  return valid;
+}
+
+static bool
+release_fifo_has_no_writers(uint64_t device, uint64_t inode)
+{
+  struct proc_native_scope scope = { 0 };
+  if (!proc_native_scope_enter(&scope))
+    return false;
+  bool valid = release_fifo_has_no_writers_raw(device, inode);
+  proc_native_scope_leave(&scope);
+  return valid;
+}
