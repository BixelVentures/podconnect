+static bool
+release_json_string(json_object *o, const char *key, char *out, size_t size)
+{
+  json_object *v;
+  const char *s;
+  size_t n;
+  if (!json_object_object_get_ex(o, key, &v) || !json_object_is_type(v, json_type_string))
+    return false;
+  s = json_object_get_string(v);
+  n = json_object_get_string_len(v);
+  if (!n || strlen(s) != n || n >= size)
+    return false;
+  memcpy(out, s, n + 1);
+  return true;
+}
+static bool
+release_json_u64(json_object *o, const char *key, uint64_t *out)
+{
+  json_object *v;
+  if (!json_object_object_get_ex(o, key, &v) || !json_object_is_type(v, json_type_int) || json_object_get_int64(v) < 0)
+    return false;
+  *out = json_object_get_uint64(v);
+  return true;
+}
+static bool
+release_json_bool(json_object *o, const char *key, bool *out)
+{
+  json_object *v;
+  if (!json_object_object_get_ex(o, key, &v) || !json_object_is_type(v, json_type_boolean))
+    return false;
+  *out = json_object_get_boolean(v);
