+static bool
+release_retired_owner_detach(void)
+{
+  struct transport_release_operation *op = &release_operation;
+  struct output_transport_identity *r = &op->record.result.identity;
+  struct output_device *d = outputs_device_get(r->device_id);
+  if (!op->prepared || op->predecessor.completed_token[0] || op->record.retirement != OUTPUT_RETIRE_RETIRED_KNOWN
+      || strcmp(start_journal.token, op->record.result.command.token) || !outputs_start_gate_closed()
+      || !release_route_retirable(op) || d->session
+      || start_all_writers_closed(&op->record.result.command.writer.native_process,
+             op->record.result.command.writer.pipe_device, op->record.result.command.writer.pipe_inode)
+             != 1)
+    return false;
+  if (transport_custody_busy()
+      && (!native_owner_equal(&transport_custody_owner, &op->record.result.command.native_owner)
+          || !transport_identity_equal(&transport_custody_identity, r)))
+    return false;
+  uint64_t route = d->route_revision, selection = transport_selection_revision;
+  if (route == UINT64_MAX || selection == UINT64_MAX)
+    return false;
+  outputs_device_deselect(d);
+  if (d->selected || d->route_revision != route + 1 || transport_selection_revision != selection + 1)
+    return false;
+  if (transport_custody_live)
+    {
+      transport_custody_live = false;
+      transport_custody_lost = true;
+      transport_generation_advance();
+    }
+  return true;
+}
+int
+outputs_transport_release_confirm(uint64_t id, const char *token, const char *prepare, uint64_t revision, bool closed,
+    struct output_transport_result *out)
+{
+  struct transport_release_operation *op = &release_operation;
+  const struct output_transport_request *c = &op->record.result.command;
+  struct output_retirement_result retired;
+  struct input_fifo_identity reader = { 0 };
+  struct timespec deadline;
+  if (!op->prepared && out && closed && release_is_typed_journal() && start_journal_payload_valid())
+    {
+      const struct output_transport_request *saved = &release_record.result.command;
+      if (id != saved->device_id || strcmp(token, saved->token) || strcmp(prepare, saved->native_prepare_id)
+          || revision != saved->native_revision)
+	return -1;
+      outputs_transport_release_recover_pending();
+      if (start_journal_retirement_outcome == OUTPUT_RETIRE_RETIRED_KNOWN && !start_retired_stage_ready)
+	outputs_start_retired_stage_reader();
+      return release_result(token, out);
+    }
+  if (!out || !op->prepared || !op->used || !op->durable || !closed || id != c->device_id || strcmp(token, c->token)
+      || strcmp(prepare, c->native_prepare_id) || revision != c->native_revision)
+    return -1;
+  if (op->terminal)
+    {
+      release_observe(out);
+      return 0;
+    }
+  if (!outputs_start_gate_closed() || start_journal_fault)
+    {
+      release_observe(out);
+      return 0;
+    }
+  if (start_all_writers_closed(&c->writer.native_process, c->writer.pipe_device, c->writer.pipe_inode) != 1)
+    {
+      release_observe(out);
+      return 0;
+    }
+  if (op->predecessor.completed_token[0])
+    {
+      op->predecessor.native_close_done = true;
+      if (outputs_retirement_complete(&op->predecessor, &retired) == 0 && retired.durable_terminal
+          && outputs_start_retired_stage_reader())
+	op->terminal = true;
+      release_observe(out);
+      return 0;
+    }
+  if (strcmp(start_journal.token, c->token) || start_journal_retirement_outcome != OUTPUT_RETIRE_PENDING
+      || !release_route_retirable(op)
+      || start_all_writers_closed(&c->writer.native_process, c->writer.pipe_device, c->writer.pipe_inode) != 1
+      || clock_gettime(CLOCK_MONOTONIC, &deadline) < 0)
+    {
+      release_observe(out);
+      return 0;
+    }
+  deadline.tv_sec++;
+  int ret = input_fifo_retire_transport(op->record.result.identity.input_item_id, op->record.input_path,
+      c->writer.pipe_device, c->writer.pipe_inode, op->record.admitted_epoch, &deadline, &reader);
+  if (ret < 0)
+    ret = input_fifo_retire_empty(op->record.input_path, c->writer.pipe_device, c->writer.pipe_inode,
+        op->record.admitted_epoch, &deadline, &reader);
+  if (ret < 0 || reader.device != c->writer.pipe_device || reader.inode != c->writer.pipe_inode
+      || reader.epoch <= op->record.admitted_epoch || !release_route_retirable(op)
+      || start_all_writers_closed(&c->writer.native_process, c->writer.pipe_device, c->writer.pipe_inode) != 1)
+    {
+      release_observe(out);
+      return 0;
+    }
+  outputs_transport_input_changed(0, NULL, false);
+  outputs_metadata_purge();
+  start_retire_sessions();
+  if (!start_contexts_drained())
+    {
+      release_observe(out);
+      return 0;
+    }
+  op->record.retired_epoch = reader.epoch;
+  strcpy(op->record.retired_c_process, outputs_process);
+  op->record.retirement = OUTPUT_RETIRE_RETIRED_KNOWN;
+  if (release_journal_save(&op->record) < 0)
+    {
+      start_journal_fault = true;
+      release_observe(out);
+      return 0;
+    }
+  atomic_store(&start_owned_latch, false);
+  start_retired_reopen_pending = true;
+  op->terminal = outputs_start_retired_stage_reader();
+  release_observe(out);
+  return 0;
+}
