+/* PC29 tests log data at the real C owner predicate; logging never grants authority. */
+static void connect_diagnostic_expect(uint64_t id,const char *reason)
+{
+  connect_diagnostic_count=0; connect_diagnostic_message=NULL; connect_diagnostic_capture=true;
+  assert(outputs_connect_recovery_available(id)==(reason==NULL));
+  connect_diagnostic_capture=false;
+  if (reason) {
+    char expected[128]; snprintf(expected,sizeof(expected),"Connect recovery denied: %s\n",reason);
+    assert(connect_diagnostic_count==1 && !strcmp(connect_diagnostic_message,expected));
+  } else assert(connect_diagnostic_count==0);
+}
+static void connect_recovery_constant_diagnostics(void)
+{
+  struct output_device *a=add_device(1), *b=add_device(2);
+  int volume=a->volume; uint64_t base=a->base_revision,route=a->route_revision;
+  assert(start_route_clean_absent() && !outputs_transport_busy());
+  connect_diagnostic_expect(1,NULL);
+  connect_diagnostic_expect(0,"invalid_output");
+  connect_diagnostic_expect(999,"output_unavailable");
+  a->advertised=false; connect_diagnostic_expect(1,"output_unadvertised"); a->advertised=true;
+  a->type=OUTPUT_TYPE_DUMMY; connect_diagnostic_expect(1,"output_type"); a->type=OUTPUT_TYPE_AIRPLAY;
+  a->prevent_playback=true; connect_diagnostic_expect(1,"playback_prevented"); a->prevent_playback=false;
+  atomic_store(&start_owned_latch,true); connect_diagnostic_expect(1,"transport_busy"); atomic_store(&start_owned_latch,false);
+  start_journal_fault=true; connect_diagnostic_expect(1,"start_not_clean_absent"); start_journal_fault=false;
+  b->busy=true; connect_diagnostic_expect(1,"output_busy"); b->busy=false;
+  b->attention_lease=1; connect_diagnostic_expect(1,"attention_lease"); b->attention_lease=0;
+  b->attention_retiring_session=b; connect_diagnostic_expect(1,"attention_retiring"); b->attention_retiring_session=NULL;
+  b->attention_restart_pending=true; connect_diagnostic_expect(1,"attention_restart_pending"); b->attention_restart_pending=false;
+  b->attention_restoring=true; connect_diagnostic_expect(1,"attention_restoring"); b->attention_restoring=false;
+  /* Multiple failures retain the existing first-clause order and emit once. */
+  a->prevent_playback=true; atomic_store(&start_owned_latch,true); start_journal_fault=true;
+  connect_diagnostic_expect(1,"playback_prevented");
+  a->prevent_playback=false; atomic_store(&start_owned_latch,false); start_journal_fault=false;
+  connect_diagnostic_expect(1,NULL);
+  assert(a->volume==volume && a->base_revision==base && a->route_revision==route);
+  assert(!a->selected && !b->selected && !a->session && !b->session);
+  clear_devices();
+  puts("PASS PC29 actual C owner constant diagnostic reasons, first-denial order, allowed silence, no mutation");
+}
