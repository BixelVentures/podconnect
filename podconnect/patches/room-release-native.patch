+package daemon
+
+// Manual release is an existing bound transport purpose. Its immutable writer
+// proof is observed without authority; C's durable commit, not an HTTP timeout,
+// authorizes closing that captured AppPlayer.
+import (
+	"bytes"
+	"context"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"io"
+	"net/http"
+	"strconv"
+	"strings"
+	"sync"
+	"time"
+
+	"github.com/devgianlu/go-librespot/output"
+)
+
+const releaseOwnerSchema = "podconnect.native_release_owner.v1"
+const manualReleasePurpose = "manual_release_v1"
+const apiRoomReleaseFence ApiRequestType = "room_release_fence"
+const apiRoomReleaseLookup ApiRequestType = "room_release_lookup"
+const apiRoomReleaseClose ApiRequestType = "room_release_close"
+
+type manualReleaseFailure struct {
+	OutputEpoch uint64
+	Generation  uint64
+}
+type releaseOperation struct {
+	Mu              sync.Mutex
+	Token           string
+	ACK             *releasePrepareACK
+	Receipt         *releaseResult
+	TerminalC       *releaseResult
+	HandoffPending  bool
+	CommitAttempted bool
+	Logout          chan *AppPlayer
+}
+type releaseOwnerDescriptor struct {
+	Schema string                `json:"schema"`
+	Owner  roomTransportIdentity `json:"native_owner"`
+	Writer queueWriterWire       `json:"writer_proof"`
+}
+type releaseResult struct {
+	Schema    string `json:"schema"`
+	OK        bool   `json:"ok"`
+	PrepareID string `json:"prepare_id"`
+	Outcome   string `json:"outcome"`
+	Terminal  bool   `json:"terminal"`
+	Drained   bool   `json:"contexts_drained"`
+	Retry     bool   `json:"retry_allowed"`
+	Physical  bool   `json:"physical_result_verified"`
+}
+
+func releaseOutcome(offer *nativeTransportOffer, outcome string) releaseResult {
+	retired := outcome == "retired"
+	return releaseResult{"podconnect.release_result.v1", retired, offer.Snapshot.PrepareID, outcome, retired || outcome == "rejected", retired, false, false}
+}
+func (p *AppPlayer) prepareRoomRelease(parent context.Context, request roomTransportPrepareRequest, bound bool) (any, error) {
+	if !p.managedReleaseAvailable() {
+		return nil, ErrAliasConflict
+	}
+	if !bound || request.ExpectedReleaseOwner == nil || request.ExpectedReleaseOwner.Schema != releaseOwnerSchema || request.Queue != nil || request.VolumePercent != 0 {
+		return nil, ErrBadRequest
+	}
+	ctx, cancel := queueOperationContext(parent, request.Context)
+	defer cancel()
+	identity, err := p.roomTransportIdentity(request.AccountUserID, request.TargetID, request.RoomID, request.HomePodID)
+	if err != nil || !nativeBoundOwnerValid(identity) || request.ExpectedReleaseOwner.Owner != identity || ctx.Err() != nil {
+		return nil, ErrAliasConflict
+	}
+	revision, err := p.nextNativeIntent()
+	if err != nil {
+		return nil, err
+	}
+	id, err := randomQueueID(16)
+	if err != nil {
+		return nil, err
+	}
+	offer := &nativeTransportOffer{Bound: true, NativeRevision: revision, Generation: p.roomTransportGeneration, OriginalPlayerState: p.state.player, QueueRevision: p.state.tracks.TransportRevision(), State: p.state, Session: p.sess, Player: p.player, Primary: p.primaryStream, Tracks: p.state.tracks, OwnToneURL: p.app.cfg.RoomTransportOwnToneURL, InputPath: p.app.cfg.AudioOutputPipe, ReleaseOwner: p, ReleaseOperation: &releaseOperation{Logout: p.logout}, Expires: time.Now().Add(roomTransportLifetime)}
+	offer.Snapshot = roomTransportSnapshot{roomTransportIdentity: identity, Schema: "podconnect.native_room_transport.v2", PrepareID: id, Action: "release", NativeRevision: revision, ExpiresAfterMS: 5000, Purpose: manualReleasePurpose}
+	writer, err := p.captureQueueWriter(ctx, identity, offer)
+	if err != nil {
+		return nil, err
+	}
+	offer.Writer = writer
+	if writer.Wire != request.ExpectedReleaseOwner.Writer {
+		offer.discardPrepared()
+		return nil, ErrAliasConflict
+	}
+	offer.WriterGeneration, _ = strconv.ParseUint(writer.Wire.Generation, 10, 64)
+	offer.Snapshot.WriterProof = &writer.Wire
+	raw, _ := json.Marshal(struct {
+		Owner    roomTransportIdentity `json:"native_owner"`
+		Writer   queueWriterWire       `json:"writer_proof"`
+		Action   string                `json:"action"`
+		Purpose  string                `json:"purpose"`
+		Revision string                `json:"native_revision"`
+	}{identity, writer.Wire, "release", manualReleasePurpose, revision})
+	digest := sha256.Sum256(raw)
+	offer.Snapshot.ArgsDigest = hex.EncodeToString(digest[:])
+	p.aliasMu.Lock()
+	current := p.transportOfferCurrentLocked(offer, parent, request.Context) && p.queueWriterCurrentLocked(writer, offer)
+	p.aliasMu.Unlock()
+	if !current {
+		offer.discardPrepared()
+		return nil, ErrAliasConflict
+	}
+	p.storeRoomTransportOffer(offer)
+	return offer.Snapshot, nil
+}
+
+// Called by the private actor before C's commit await. This existing admission
+// fence has no expiry: an ambiguous C outcome cannot reopen a successor writer.
+func (p *AppPlayer) fenceRoomRelease(ctx context.Context, offer *nativeTransportOffer) (any, error) {
+	p.aliasMu.Lock()
+	defer p.aliasMu.Unlock()
+	if offer == nil || offer.ReleaseOwner != p || p.roomTransportPending != offer || !p.transportOfferCurrentLocked(offer, ctx, nil) || !p.queueWriterCurrentLocked(offer.Writer, offer) {
+		return nil, ErrAliasConflict
+	}
+	p.roomCloseMu.Lock()
+	defer p.roomCloseMu.Unlock()
+	if p.roomCloseDone != nil || p.roomReleaseWait != nil {
+		return nil, ErrAliasConflict
+	}
+	p.app.moveCustodyMu.Lock()
+	defer p.app.moveCustodyMu.Unlock()
+	if p.app.manualRelease != nil || p.app.moveCustodyUnknown || p.app.retirementPending != nil {
+		return nil, ErrAliasConflict
+	}
+	offer.ReleaseStart = p.app.startCustody
+	offer.ReleaseMove = p.app.moveCustody
+	p.app.manualRelease = offer
+	p.app.manualReleaseReceipt = offer
+	p.roomReleaseWait = make(chan struct{})
+	return true, nil
+}
+func (p *AppPlayer) admitRoomReleaseClose(ctx context.Context, offer *nativeTransportOffer) (any, error) {
+	p.aliasMu.Lock()
+	defer p.aliasMu.Unlock()
+	if offer == nil || p.roomTransportPending != offer || !p.releaseCleanupCurrentLocked(ctx, offer) {
+		return nil, ErrAliasConflict
+	}
+	p.roomCloseMu.Lock()
+	defer p.roomCloseMu.Unlock()
+	if p.roomCloseDone != nil || p.roomRetirement != nil {
+		return nil, ErrAliasConflict
+	}
+	p.app.moveCustodyMu.Lock()
+	defer p.app.moveCustodyMu.Unlock()
+	if p.app.manualRelease != offer || p.app.startCustody != offer.ReleaseStart || p.app.moveCustody != offer.ReleaseMove {
+		return nil, ErrAliasConflict
+	}
+	// Set only after the exact durable C ACK. Close still owns cancellation/join;
+	// only its redundant START/MOVE prepare is suppressed for this operation.
+	p.roomManualRelease = offer
+	if wait := p.roomReleaseWait; wait != nil {
+		p.roomReleaseWait = nil
+		close(wait)
+	}
+	p.roomTransportPending = nil
+	offer.Published = true
+	return p, nil
+}
+func releaseEndpoint(offer *nativeTransportOffer, suffix string) string {
+	return strings.TrimSuffix(offer.OwnToneURL, "/") + "/api/outputs/" + offer.Snapshot.HomePodID + "/transport/" + suffix
+}
+
+type releasePrepareACK struct {
+	Schema         string                `json:"schema"`
+	OK             bool                  `json:"ok"`
+	Phase          string                `json:"phase"`
+	Token          string                `json:"token"`
+	PrepareID      string                `json:"native_prepare_id"`
+	Digest         string                `json:"args_digest"`
+	Owner          roomTransportIdentity `json:"native_owner"`
+	Revision       string                `json:"native_revision"`
+	Identity       roomVolumeRoute       `json:"identity"`
+	Writer         queueWriterWire       `json:"writer_proof"`
+	Purpose        string                `json:"purpose"`
+	Outcome        string                `json:"outcome"`
+	GateClosed     bool                  `json:"gate_closed"`
+	DurablePending bool                  `json:"durable_pending"`
+	Remaining      int                   `json:"remaining_ms"`
+	Physical       *bool                 `json:"physical_result_verified"`
+}
+type releaseCResult struct {
+	Schema    string                `json:"schema"`
+	OK        bool                  `json:"ok"`
+	Token     string                `json:"token"`
+	PrepareID string                `json:"native_prepare_id"`
+	Digest    string                `json:"args_digest"`
+	Owner     roomTransportIdentity `json:"native_owner"`
+	Revision  string                `json:"native_revision"`
+	Identity  roomVolumeRoute       `json:"identity"`
+	Writer    queueWriterWire       `json:"writer_proof"`
+	Purpose   string                `json:"purpose"`
+	Outcome   string                `json:"outcome"`
+	Terminal  bool                  `json:"terminal"`
+	Drained   bool                  `json:"contexts_drained"`
+	Retry     bool                  `json:"retry_allowed"`
