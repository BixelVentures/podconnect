+/* Strict idle proof is a read, never retirement/admission or pin expiry.
+ * Reuse the actual START absence/drain and configured Native FIFO proof. */
+static bool
+start_clean_absent_read(const struct output_start_request *r)
+{
+  struct output_device *scan;
+  struct stat before, after;
+  bool absent = start_route_clean_absent();
+  /* A detached, durably completed manual release is quiet while its autostart
+   * gate remains closed. This read neither reopens it nor grants START. */
+  if (!absent && !start_active && !start_scope && !outputs_start_source_owned() && outputs_start_gate_closed()
+      && !start_journal_fault && !start_startup_quarantine && start_retired_reopen_pending && start_retired_stage_ready
+      && !start_journal_retirement_reopen_consumed && start_journal.token[0]
+      && !strcmp(start_journal.c_process, outputs_process) && release_is_typed_journal()
+      && start_journal_payload_valid() && start_journal_retirement_outcome == OUTPUT_RETIRE_RETIRED_KNOWN)
+    {
+      json_object *record = json_tokener_parse(start_journal.payload), *path;
+      absent = record && json_object_object_get_ex(record, "input_path", &path)
+               && json_object_is_type(path, json_type_string)
+               && !strcmp(json_object_get_string(path), r->expected_input_path);
+      if (record)
+	json_object_put(record);
+    }
+  if (!outputs_process[0] || r->old_owner_present || r->move_existing_session
+      || !start_process_current(&r->native_process) || !absent
+      || (transport_pin && transport_remaining(&transport_pin_expiry))
+      || (room_volume_pin && !room_volume_pin->result.command.bound && transport_remaining(&room_volume_pin_expiry))
+      || (transport_custody_live && transport_remaining(&transport_custody_expiry)) || transport_generation_exhausted
+      || !start_contexts_drained())
+    return false;
+  for (scan = outputs_device_list; scan; scan = scan->next)
+    if (scan->selected || scan->session || scan->busy || scan->prevent_playback || scan->attention_lease
+        || scan->attention_retiring_session || scan->attention_restart_pending || scan->attention_restoring)
+      return false;
+  if (stat(r->expected_input_path, &before) < 0 || !S_ISFIFO(before.st_mode)
+      || start_all_writers_closed(&r->native_process, before.st_dev, before.st_ino) != 1
+      || stat(r->expected_input_path, &after) < 0 || !S_ISFIFO(after.st_mode) || before.st_dev != after.st_dev
+      || before.st_ino != after.st_ino)
+    return false;
+  return start_process_current(&r->native_process);
+}
