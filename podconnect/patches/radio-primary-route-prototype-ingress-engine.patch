 static int
+primary_radio_control_bind(struct airplay_session *session, const char *local_address, int family)
+{
+  struct addrinfo hints = { .ai_family = family, .ai_socktype = SOCK_DGRAM,
+    .ai_flags = AI_NUMERICHOST | AI_NUMERICSERV };
+  struct addrinfo *local;
+  union net_sockaddr actual;
+  socklen_t length = sizeof(actual);
+  int fd;
+
+  /* Resend datagrams have no session or authentication field. Give this
+   * transport a distinct control destination and deliberately serve no
+   * retransmits there. Normal synchronization still uses the same socket. */
+  if (getaddrinfo(local_address, "0", &hints, &local))
+    return -1;
+  fd = socket(family, SOCK_DGRAM | SOCK_CLOEXEC | SOCK_NONBLOCK, 0);
+  if (fd < 0 || bind(fd, local->ai_addr, local->ai_addrlen)
+      || getsockname(fd, &actual.sa, &length))
+    {
+      if (fd >= 0) close(fd);
+      freeaddrinfo(local);
+      return -1;
+    }
+  freeaddrinfo(local);
+  session->primary_radio_control_fd = fd;
+  session->primary_radio_control_port = family == AF_INET
+    ? ntohs(actual.sin.sin_port) : ntohs(actual.sin6.sin6_port);
+  return 0;
+}
