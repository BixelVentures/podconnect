+/* Called only on the output owner thread immediately before a distinguished
+ * Connect recovery mutation. No selected session is required to prove absence. */
+bool
+outputs_connect_recovery_available(uint64_t id)
+{
+  struct output_device *device=outputs_device_get(id), *scan;
+  if (!id || !device || !device->advertised || device->type!=OUTPUT_TYPE_AIRPLAY
+      || device->prevent_playback || outputs_transport_busy() || !start_route_clean_absent()) return false;
+  for (scan=outputs_device_list;scan;scan=scan->next)
+    if (scan->busy || scan->attention_lease || scan->attention_retiring_session
+        || scan->attention_restart_pending || scan->attention_restoring) return false;
+  return true;
+}
