+/* PC28: real output-owner predicate, with bounded controlled owner states.
+ * No AirPlay connection, source identity, ACK or physical result is invented. */
+static void connect_recovery_requires_clean_unowned_output(void)
+{
+  struct output_device *a=add_device(1), *b=add_device(2);
+  struct start_slot pending={0};
+  struct timespec saved_expiry=transport_custody_expiry;
+  int original_volume=a->volume;
+  uint64_t original_base=a->base_revision, original_route=a->route_revision;
+  assert(start_route_clean_absent() && !outputs_transport_busy());
+  assert(!a->selected && !a->session);
+  assert(outputs_connect_recovery_available(1)); /* Unselected output is recoverable. */
+  assert(!outputs_connect_recovery_available(0) && !outputs_connect_recovery_available(999));
+
+  atomic_store(&start_owned_latch,true);
+  assert(!outputs_connect_recovery_available(1));
+  atomic_store(&start_owned_latch,false);
+  atomic_store(&start_gate,true);
+  assert(!outputs_connect_recovery_available(1));
+  atomic_store(&start_gate,false);
+  start_active=&pending; assert(!outputs_connect_recovery_available(1)); start_active=NULL;
+  start_scope=&pending; assert(!outputs_connect_recovery_available(1)); start_scope=NULL;
+#define PC28_DENY_FLAG(field) do { field=true; assert(!outputs_connect_recovery_available(1)); field=false; } while(0)
+  PC28_DENY_FLAG(start_journal_fault);
+  PC28_DENY_FLAG(start_startup_quarantine);
+  PC28_DENY_FLAG(start_retired_reopen_pending);
+  PC28_DENY_FLAG(start_retired_stage_ready);
+  start_journal.token[0]='x'; assert(!outputs_connect_recovery_available(1)); start_journal.token[0]=0;
+  start_journal.payload="{}"; assert(!outputs_connect_recovery_available(1)); start_journal.payload=NULL;
+
+  assert(clock_gettime(CLOCK_MONOTONIC,&transport_custody_expiry)==0);
+  transport_custody_expiry.tv_sec+=60; transport_custody_live=true;
+  assert(!outputs_connect_recovery_available(1));
+  transport_custody_live=false; transport_custody_expiry=saved_expiry;
+  PC28_DENY_FLAG(a->prevent_playback);
+  PC28_DENY_FLAG(b->busy);
+  PC28_DENY_FLAG(b->attention_restart_pending);
+  PC28_DENY_FLAG(b->attention_restoring);
+#undef PC28_DENY_FLAG
+  b->attention_lease=1; assert(!outputs_connect_recovery_available(1)); b->attention_lease=0;
+  b->attention_retiring_session=b; assert(!outputs_connect_recovery_available(1)); b->attention_retiring_session=NULL;
+  a->advertised=false; assert(!outputs_connect_recovery_available(1)); a->advertised=true;
+  a->type=OUTPUT_TYPE_DUMMY; assert(!outputs_connect_recovery_available(1)); a->type=OUTPUT_TYPE_AIRPLAY;
+
+  assert(outputs_connect_recovery_available(1));
+  assert(a->volume==original_volume && a->base_revision==original_base && a->route_revision==original_route);
+  assert(!a->selected && !b->selected && !a->session && !b->session);
+  clear_devices();
+  puts("PASS PC28 actual C owner: clean unselected allowed; START ownership/gate, unknown journal, custody, attention and wrong output denied without mutation");
+}
+
+static void connect_recovery_selection_query_contract(void)
+{
+  static const struct { const char *query,*body; int status; } cases[] = {
+    {"recovery=connect", "{\"outputs\":[\"1\"]}", HTTP_NOCONTENT},
+    {"recovery=%63onnect", "{\"outputs\":[\"1\"]}", HTTP_NOCONTENT},
+    {"recovery=other", "{\"outputs\":[\"1\"]}", HTTP_BADREQUEST},
+    {"recovery=", "{\"outputs\":[\"1\"]}", HTTP_BADREQUEST},
+    {"recovery=connect", "{\"outputs\":[\"1\",\"2\"]}", HTTP_BADREQUEST},
+    {"recovery=connect", "{\"outputs\":[\"01\"]}", HTTP_BADREQUEST},
+    {"recovery=connect", "{\"outputs\":[1]}", HTTP_BADREQUEST},
+    {"recovery=connect", "{\"outputs\":[\"1\"],\"extra\":true}", HTTP_BADREQUEST},
+    {"recovery=connect", "{\"outputs\":[\"999\"]}", HTTP_INTERNAL}
+  };
+  struct output_device *a=add_device(1);
+  size_t i;
+  for(i=0;i<ARRAY_SIZE(cases);i++) {
+    struct evkeyvalq query;
+    struct httpd_request request={0};
+    TAILQ_INIT(&query);
+    assert(evhttp_parse_query_str(cases[i].query,&query)==0);
+    request.query=&query; request.in_body=evbuffer_new(); assert(request.in_body);
+    assert(evbuffer_add(request.in_body,cases[i].body,strlen(cases[i].body))==0);
+    selection_fixture_calls=selection_fixture_ids_freed=selection_fixture_request_freed=0;
+    selection_fixture_ids=NULL;
+    assert(jsonapi_reply_outputs_set(&request)==cases[i].status);
+    assert(selection_fixture_calls==0); /* Distinguished query never falls through to normal selection. */
+    assert(!a->selected && !a->session); /* Adapter is inert; no actual output selection claim. */
+    evbuffer_free(request.in_body); evhttp_clear_headers(&query);
+  }
+  clear_devices();
+  puts("PASS PC28 real selection HTTP parser/libevent query: exact and decoded guard, invalid purpose/body/output reject; no unguarded fallback");
+}
