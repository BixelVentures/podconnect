+var homePodIDPattern = regexp.MustCompile(`^[0-9]{1,20}$`)
+
+type roomTransportIdentity struct {
+	AccountUserID    string `json:"account_user_id"`
+	TargetID         string `json:"target_id"`
+	RoomID           string `json:"room_id"`
+	HomePodID        string `json:"homepod_id"`
+	ConnectionID     string `json:"connection_id"`
+	SessionID        string `json:"session_id"`
+	AliasIncarnation string `json:"alias_incarnation"`
+	AliasRegistry    string `json:"alias_registry"`
+	AliasRevision    uint64 `json:"alias_revision"`
+}
+type roomTransportStateRequest struct {
+	AccountUserID string          `json:"account_user_id"`
+	TargetID      string          `json:"target_id"`
+	RoomID        string          `json:"room_id"`
+	HomePodID     string          `json:"homepod_id"`
+	Context       context.Context `json:"-"`
+}
+type roomTransportPrepareRequest struct {
+	AccountUserID string          `json:"account_user_id"`
+	TargetID      string          `json:"target_id"`
+	RoomID        string          `json:"room_id"`
+	HomePodID     string          `json:"homepod_id"`
+	Action        string          `json:"action"`
