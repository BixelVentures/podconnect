+// Inert closeable decoder proves exact source ownership without audio/provider I/O.
+type roomTransportClosableSource struct {
+	closes int
+	owner  *AppPlayer
+	locked bool
+}
+
+func (*roomTransportClosableSource) Read([]float32) (int, error) { return 0, nil }
+func (*roomTransportClosableSource) PositionMs() int64           { return 0 }
+func (*roomTransportClosableSource) SetPositionMs(int64) error   { return nil }
+func (source *roomTransportClosableSource) Close() error {
+	source.closes++
+	if source.owner != nil {
+		if source.owner.aliasMu.TryLock() {
+			source.owner.aliasMu.Unlock()
+		} else {
+			source.locked = true
+		}
+	}
+	return nil
+}
