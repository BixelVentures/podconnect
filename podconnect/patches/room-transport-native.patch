+package output
+
+import (
+	"context"
+	"sync"
+	"testing"
+	"time"
+)
+
+func TestRoomTransportPipeGuardFollowsBlockingOutputLock(t *testing.T) {
+	out := &pipeOutput{paused: false}
+	out.cond = sync.NewCond(&out.lock)
+	out.lock.Lock()
+	ctx, cancel := context.WithCancel(context.Background())
+	started := make(chan struct{})
+	done := make(chan error, 1)
+	go func() {
+		close(started)
+		done <- out.WithTransportLock(ctx, func(setPaused func(bool)) error {
+			if ctx.Err() != nil {
+				return ctx.Err()
+			}
+			setPaused(true)
+			return nil
+		})
+	}()
+	<-started
+	cancel() // causal invalidation while the actual output mutex is unavailable
+	out.lock.Unlock()
+	select {
+	case err := <-done:
+		if err != context.Canceled {
+			t.Fatal(err)
+		}
+	case <-time.After(time.Second):
+		t.Fatal("guarded operation not joined")
+	}
+	if out.paused {
+		t.Fatal("late blocked output mutation executed")
+	}
+}
+func TestRoomTransportPipeGuardMutatesOnlyOnAdmission(t *testing.T) {
+	out := &pipeOutput{}
+	out.cond = sync.NewCond(&out.lock)
+	n := 0
+	err := out.WithTransportLock(context.Background(), func(setPaused func(bool)) error { n++; setPaused(true); return nil })
+	if err != nil || n != 1 || !out.paused {
+		t.Fatal("actual pipe mutation was not performed exactly once")
+	}
+	out.closed = true
+	if out.WithTransportLock(context.Background(), func(func(bool)) error { t.Fatal("closed output guard ran"); return nil }) == nil {
+		t.Fatal("closed output accepted")
+	}
+}
+
+func TestRoomTransportPipeHeldLockReturnsOnCancellation(t *testing.T) {
+	out := &pipeOutput{}
+	out.cond = sync.NewCond(&out.lock)
+	out.lock.Lock()
+	ctx, cancel := context.WithCancel(context.Background())
+	started := make(chan struct{})
+	done := make(chan error, 1)
+	go func() {
+		close(started)
+		done <- out.WithTransportLock(ctx, func(func(bool)) error { t.Error("held cancelled lock entered callback"); return nil })
+	}()
+	<-started
+	cancel()
+	select {
+	case err := <-done:
+		if err != context.Canceled {
+			t.Fatal(err)
+		}
+	case <-time.After(time.Second):
+		t.Fatal("actor remained blocked on held output lock")
+	}
+	out.lock.Unlock()
+}
