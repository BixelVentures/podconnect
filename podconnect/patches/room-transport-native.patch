+func TestRoomTransportDetachedNextPreviousPreserveRetainedList(t *testing.T) {
+	rows := []*connectpb.ContextTrack{{Uri: "spotify:track:0000000000000000000001"}, {Uri: "spotify:track:0000000000000000000002"}, {Uri: "spotify:track:0000000000000000000003"}}
+	list, err := NewTrackListFromContext(context.Background(), &librespot.NullLogger{}, nil, &connectpb.Context{Uri: "spotify:playlist:0000000000000000000001", Pages: []*connectpb.ContextPage{{Tracks: rows}}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err = list.TrySeek(context.Background(), func(track *connectpb.ContextTrack) bool { return track.Uri == rows[1].Uri }); err != nil {
+		t.Fatal(err)
+	}
+	list.AddToQueue(&connectpb.ContextTrack{Uri: "spotify:track:0000000000000000000004"})
+	beforeTrack, beforeQueue, beforeRevision, beforePosition := list.CurrentTrack().Uri, append([]*connectpb.ContextTrack(nil), list.queue...), list.queueRevision, list.tracks.pos
+	for _, previous := range []bool{false, true} {
+		prepared, err := list.PrepareTransport(context.Background(), previous, 0)
+		if err != nil {
+			t.Fatal(err)
+		}
+		expected := "spotify:track:0000000000000000000004"
+		if previous {
+			expected = rows[0].Uri
+		}
+		if prepared.CurrentTrack().Uri != expected {
+			t.Fatal("native occurrence order changed")
+		}
+		if list.CurrentTrack().Uri != beforeTrack || list.tracks.pos != beforePosition || list.queueRevision != beforeRevision || !reflect.DeepEqual(list.queue, beforeQueue) {
+			t.Fatal("preparation changed retained cursor/queue/revision")
+		}
+		if prepared == list || prepared.tracks == list.tracks {
+			t.Fatal("staged cursor shares mutable native list storage")
+		}
+	}
