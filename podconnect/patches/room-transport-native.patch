+}
+type roomTransportConsumeRequest struct {
+	PrepareID string
+	Context   context.Context
+}
+type roomTransportEffectRequest struct {
+	Offer   *nativeTransportOffer
+	Context context.Context
+}
+
+func (offer *nativeTransportOffer) discardPrepared() {
+	if offer == nil || offer.Published || offer.Disposed {
+		return
+	}
+	offer.Disposed = true
+	if offer.PreparedStream != nil {
+		if closer, ok := offer.PreparedStream.Source.(io.Closer); ok {
+			_ = closer.Close()
+		}
+	}
+}
+func (p *AppPlayer) storeRoomTransportOffer(offer *nativeTransportOffer) {
+	if p.roomTransportOffer != offer {
+		p.roomTransportOffer.discardPrepared()
+	}
+	p.roomTransportOffer = offer
+}
+func (p *AppPlayer) discardExpiredRoomTransport() {
+	if offer := p.roomTransportOffer; offer != nil && !time.Now().Before(offer.Expires) {
+		p.roomTransportOffer = nil
+		offer.discardPrepared()
+	}
+	if offer := p.roomTransportPending; offer != nil && !time.Now().Before(offer.Expires) {
+		p.roomTransportPending = nil
+		offer.discardPrepared()
+	}
+}
+func (p *AppPlayer) clearRoomTransport() {
+	p.roomTransportOffer.discardPrepared()
+	p.roomTransportPending.discardPrepared()
+	p.roomTransportOffer = nil
+	p.roomTransportPending = nil
+}
+func (p *AppPlayer) abortRoomTransport(offer *nativeTransportOffer) {
+	if offer != nil && p.roomTransportPending == offer {
+		p.roomTransportPending = nil
+		offer.discardPrepared()
+	}
+}
+func (p *AppPlayer) advanceRoomTransportGenerationLocked() {
+	if p.roomTransportGeneration >= 1<<53-1 {
+		p.roomTransportGenerationExhausted = true
+		return
+	}
+	p.roomTransportGeneration++
+}
+func (p *AppPlayer) invalidateRoomTransportGeneration() {
+	p.aliasMu.Lock()
+	defer p.aliasMu.Unlock()
+	p.advanceRoomTransportGenerationLocked()
+}
+func (p *AppPlayer) advanceAliasRevisionLocked() {
+	if p.aliasRevision >= 1<<53-1 {
+		p.aliasRevisionExhausted = true
+		return
+	}
+	p.aliasRevision++
+}
+func roomTransportURL(raw string) bool {
+	u, err := url.Parse(raw)
+	if err != nil || u.Scheme != "http" || u.User != nil || u.RawQuery != "" || u.Fragment != "" || (u.Path != "" && u.Path != "/") || u.Port() == "" {
+		return false
+	}
+	host := u.Hostname()
+	if host == "localhost" {
+		return true
+	}
+	ip := net.ParseIP(host)
+	return ip != nil && ip.IsLoopback()
+}
+func (p *AppPlayer) transportMappingCurrentLocked() bool {
+	ids := p.app.cfg.DeviceAliasHomePodIDs
+	if len(ids) == 0 || len(ids) != len(p.aliasRegistry) || len(p.app.cfg.DeviceAliasRoomIDs) != len(ids) || len(p.app.cfg.DeviceAliases) != len(ids) {
+		return false
+	}
+	seen := make(map[string]bool, len(ids))
+	for i, id := range ids {
+		n, err := strconv.ParseUint(id, 10, 64)
+		if err != nil || n == 0 || !homePodIDPattern.MatchString(id) || seen[id] || p.aliasRegistry[i].HomePodID != id || p.aliasRegistry[i].RoomID != p.app.cfg.DeviceAliasRoomIDs[i] || p.aliasRegistry[i].Name != p.app.cfg.DeviceAliases[i] {
+			return false
+		}
+		seen[id] = true
+	}
+	return true
+}
+func (p *AppPlayer) roomTransportIdentity(account, target, room, homepod string) (roomTransportIdentity, error) {
+	zero := roomTransportIdentity{}
+	if p.sess == nil || p.state == nil || p.state.player == nil || p.state.device == nil || p.primaryStream == nil || p.primaryStream.Source == nil || p.player == nil || !p.state.active || !p.state.player.IsPlaying || account == "" || len(account) > 160 || target == "" || target != p.app.deviceId || p.sess.Username() != account || !p.playbackReady() || p.spotConnId == "" || p.state.player.SessionId == "" || p.app.cfg.AudioBackend != "pipe" || !filepath.IsAbs(p.app.cfg.AudioOutputPipe) || !p.app.cfg.ExternalVolume || !roomTransportURL(p.app.cfg.RoomTransportOwnToneURL) || !homePodIDPattern.MatchString(homepod) {
+		return zero, ErrAliasConflict
+	}
+	p.aliasMu.Lock()
+	defer p.aliasMu.Unlock()
+	binding := p.aliasBindingLocked()
+	if binding == nil || !binding.Ready || binding.RoomID != room || room == "" || p.aliasRevisionExhausted || p.roomTransportGenerationExhausted || !p.transportMappingCurrentLocked() {
+		return zero, ErrAliasConflict
+	}
+	for _, a := range p.aliasRegistry {
+		if a.RoomID == room && a.HomePodID == homepod {
+			return roomTransportIdentity{account, target, room, homepod, p.spotConnId, p.state.player.SessionId, binding.Incarnation, binding.Registry, p.aliasRevision}, nil
+		}
+	}
+	return zero, ErrAliasConflict
+}
+func (p *AppPlayer) roomTransportState(parent context.Context, request roomTransportStateRequest) (any, error) {
+	ctx, cancel := queueOperationContext(parent, request.Context)
+	defer cancel()
+	if ctx.Err() != nil || parent.Err() != nil {
+		return nil, ErrAliasConflict
+	}
+	identity, err := p.roomTransportIdentity(request.AccountUserID, request.TargetID, request.RoomID, request.HomePodID)
+	if err != nil {
+		return nil, err
+	}
+	return struct {
+		Schema   string                `json:"schema"`
+		Ready    bool                  `json:"ready"`
+		Identity roomTransportIdentity `json:"identity"`
+		Actions  []string              `json:"actions"`
+		Physical bool                  `json:"physical_result_verified"`
+	}{"podconnect.native_room_transport_state.v1", true, identity, slices.Clone(roomTransportActions), false}, nil
+}
+func (p *AppPlayer) prepareRoomTransport(parent context.Context, request roomTransportPrepareRequest) (any, error) {
+	ctx, cancel := queueOperationContext(parent, request.Context)
+	defer cancel()
+	if !slices.Contains(roomTransportActions, request.Action) || request.VolumePercent != 0 || ctx.Err() != nil || parent.Err() != nil {
+		return nil, ErrBadRequest
+	}
+	identity, err := p.roomTransportIdentity(request.AccountUserID, request.TargetID, request.RoomID, request.HomePodID)
+	if err != nil {
+		return nil, err
+	}
+	offer := &nativeTransportOffer{Generation: p.roomTransportGeneration, OriginalPlayerState: p.state.player, QueueRevision: p.state.tracks.TransportRevision(), State: p.state, Session: p.sess, Player: p.player, Primary: p.primaryStream, Tracks: p.state.tracks, OwnToneURL: p.app.cfg.RoomTransportOwnToneURL, InputPath: p.app.cfg.AudioOutputPipe}
+	stagedOwned := true
+	defer func() {
+		if stagedOwned {
+			offer.discardPrepared()
+		}
+	}()
+	offer.Snapshot = roomTransportSnapshot{roomTransportIdentity: identity, Schema: "podconnect.native_room_transport.v1", Action: request.Action, VolumePercent: 0, ExpiresAfterMS: 5000}
+	if request.Action == "next" || request.Action == "previous" {
+		staged, err := p.state.tracks.PrepareTransport(ctx, request.Action == "previous", p.state.trackPosition())
+		if err != nil {
+			return nil, ErrAliasConflict
+		}
+		state := proto.Clone(p.state.player).(*connectpb.PlayerState)
+		if request.Action == "next" {
+			state.IsPaused = false
+		}
+		state.Track = staged.CurrentTrack()
+		state.PrevTracks = staged.PrevTracks()
+		state.NextTracks = staged.NextTracks(ctx, nil)
+		state.Index = staged.Index()
+		id, err := librespot.SpotifyIdFromUri(state.Track.Uri)
+		if err != nil {
+			return nil, ErrBadRequest
+		}
+		stream, err := p.player.NewStream(ctx, p.app.client, *id, p.app.cfg.Bitrate, 0)
+		if err != nil {
+			return nil, err
+		}
+		offer.PreparedTracks = staged
+		offer.PreparedState = state
+		offer.PreparedStream = stream
+	}
+	if ctx.Err() != nil || parent.Err() != nil {
+		return nil, ErrAliasConflict
+	}
+	latest, err := p.roomTransportIdentity(request.AccountUserID, request.TargetID, request.RoomID, request.HomePodID)
+	if err != nil || latest != identity || p.state != offer.State || p.sess != offer.Session || p.player != offer.Player || p.primaryStream != offer.Primary || p.state.tracks != offer.Tracks {
+		return nil, ErrAliasConflict
+	}
+	id, err := randomQueueID(16)
+	if err != nil {
+		return nil, err
+	}
+	offer.Snapshot.PrepareID = id
+	// Full immutable native identity/action/args, encoded by this owner.
+	raw, err := json.Marshal(struct {
+		Identity roomTransportIdentity `json:"identity"`
+		Action   string                `json:"action"`
+		Percent  int                   `json:"volume_percent"`
+	}{identity, request.Action, 0})
+	if err != nil {
+		return nil, err
+	}
+	digest := sha256.Sum256(raw)
+	offer.Snapshot.ArgsDigest = hex.EncodeToString(digest[:])
+	// All detached network work precedes this monotonic cutoff and any OwnTone pin.
+	offer.Expires = time.Now().Add(roomTransportLifetime)
+	p.storeRoomTransportOffer(offer)
+	stagedOwned = false
+	return offer.Snapshot, nil
+}
+func (p *AppPlayer) transportOfferCurrentLocked(offer *nativeTransportOffer, parent, request context.Context) bool {
+	if offer == nil || parent.Err() != nil || (request != nil && request.Err() != nil) || !time.Now().Before(offer.Expires) || p.aliasRetired || p.aliasRevisionExhausted || p.roomTransportGenerationExhausted || p.roomTransportGeneration != offer.Generation || p.state != offer.State || p.sess != offer.Session || p.player != offer.Player || p.primaryStream != offer.Primary || p.state == nil || p.state.player == nil || p.state.player != offer.OriginalPlayerState || !p.state.active || !p.state.player.IsPlaying || p.state.tracks != offer.Tracks || p.state.tracks.TransportRevision() != offer.QueueRevision || p.spotConnId != offer.Snapshot.ConnectionID || p.state.player.SessionId != offer.Snapshot.SessionID || p.aliasRevision != offer.Snapshot.AliasRevision || p.app.deviceId != offer.Snapshot.TargetID || p.app.cfg.RoomTransportOwnToneURL != offer.OwnToneURL || p.app.cfg.AudioOutputPipe != offer.InputPath {
+		return false
+	}
+	binding := p.aliasBindingLocked()
+	if !p.transportMappingCurrentLocked() || binding == nil || !binding.Ready || binding.Incarnation != offer.Snapshot.AliasIncarnation || binding.Registry != offer.Snapshot.AliasRegistry || binding.RoomID != offer.Snapshot.RoomID {
+		return false
+	}
+	for _, alias := range p.aliasRegistry {
+		if alias.RoomID == offer.Snapshot.RoomID && alias.HomePodID == offer.Snapshot.HomePodID {
+			return true
+		}
+	}
+	return false
+}
+func (p *AppPlayer) consumeRoomTransport(parent context.Context, request roomTransportConsumeRequest) (any, error) {
+	offer := p.roomTransportOffer
+	if offer == nil || request.PrepareID != offer.Snapshot.PrepareID {
+		return nil, ErrAliasConflict
+	}
+	p.roomTransportOffer = nil
+	p.aliasMu.Lock()
+	current := p.transportOfferCurrentLocked(offer, parent, request.Context)
+	p.aliasMu.Unlock()
+	if !current {
+		offer.discardPrepared()
+		return nil, ErrAliasConflict
+	}
+	if p.roomTransportPending != nil && time.Now().Before(p.roomTransportPending.Expires) {
+		offer.discardPrepared()
+		return nil, ErrAliasConflict
+	}
+	p.roomTransportPending.discardPrepared()
+	p.roomTransportPending = offer
+	return offer, nil
+}
+
+func (p *AppPlayer) effectRoomTransport(parent context.Context, request roomTransportEffectRequest) (any, error) {
+	offer := request.Offer
+	if offer == nil || p.roomTransportPending != offer {
+		return nil, ErrAliasConflict
+	}
+	p.roomTransportPending = nil // private in-process capability, never an HTTP field
+	defer offer.discardPrepared()
+	if parent.Err() != nil || (request.Context != nil && request.Context.Err() != nil) || !time.Now().Before(offer.Expires) {
+		return nil, ErrAliasConflict
+	}
+	var stream librespot.AudioSource
+	if offer.PreparedStream != nil {
+		stream = offer.PreparedStream.Source
+	}
+	paused := offer.Snapshot.Action == "pause"
+	if offer.PreparedStream != nil {
+		paused = offer.PreparedState.IsPaused
+	}
+	requestContext := request.Context
+	if requestContext == nil {
+		requestContext = parent
+	}
+	effectContext, cancelEffect := context.WithDeadline(requestContext, offer.Expires)
+	defer cancelEffect()
+	stop := context.AfterFunc(parent, cancelEffect)
+	defer stop()
+	err := p.player.GuardedTransport(effectContext, paused, stream, offer.Primary.Source, func(mutate func()) error {
+		p.aliasMu.Lock()
+		defer p.aliasMu.Unlock()
+		if !p.transportOfferCurrentLocked(offer, parent, request.Context) {
+			return ErrAliasConflict
+		}
+		// No I/O or deferred operation in this callback.
+		mutate()
+		offer.Published = true
+		if offer.PreparedStream != nil {
+			p.primaryStream = offer.PreparedStream
+			p.secondaryStream = nil
+			p.state.tracks = offer.PreparedTracks
+			p.state.player = offer.PreparedState
+			p.state.player.PlaybackId = hex.EncodeToString(offer.PreparedStream.PlaybackId)
+			p.state.player.Duration = int64(offer.PreparedStream.Media.Duration())
+			p.state.player.PositionAsOfTimestamp = 0
+		} else {
+			p.state.player.PositionAsOfTimestamp = p.state.trackPosition()
+		}
+		p.state.player.Timestamp = time.Now().UnixMilli()
+		p.state.setPaused(paused)
+		p.state.player.IsBuffering = false
+		return nil
+	})
+	if err != nil {
+		return nil, err
+	}
+	// Observations after acceptance are never additional physical writes.
+	if offer.PreparedStream != nil {
+		p.sess.Events().PostPrimaryStreamLoad(p.primaryStream, paused)
+	}
+	event := player.EventTypeResume
+	if paused {
+		event = player.EventTypePause
+	} else if offer.PreparedStream != nil {
+		event = player.EventTypePlay
+	}
+	p.handlePlayerEvent(parent, &player.Event{Type: event})
+	return struct {
+		Schema         string `json:"schema"`
+		AcceptedNative bool   `json:"accepted_native"`
+		PrepareID      string `json:"prepare_id"`
+		Physical       bool   `json:"physical_result_verified"`
+	}{"podconnect.native_room_transport_commit.v1", true, offer.Snapshot.PrepareID, false}, nil
+}
