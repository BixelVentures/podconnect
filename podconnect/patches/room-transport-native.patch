+// WithTransportLock is the actual paused-state mutation boundary. Acquiring the
+// existing lock may wait for a FIFO write; guard evaluation must follow it.
+func (out *pipeOutput) WithTransportLock(ctx context.Context, apply func(func(bool)) error) error {
+	if err := LockTransport(ctx, &out.lock); err != nil {
