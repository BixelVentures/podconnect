+package daemon
+
+import (
+	"bytes"
+	"context"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"io"
+	"net/http"
+	"strings"
+	"time"
+)
+
+type roomTransportCommitRequest struct {
+	PrepareID    string `json:"prepare_id"`
+	OwnToneToken string `json:"own_tone_token"`
+}
+type roomTransportOutputACK struct {
+	Schema          string `json:"schema"`
+	OK              bool   `json:"ok"`
+	Token           string `json:"token"`
+	NativePrepareID string `json:"native_prepare_id"`
+	ArgsDigest      string `json:"args_digest"`
+	PinRemainingMS  int    `json:"pin_remaining_ms"`
+	Outcome         string `json:"outcome"`
+	Physical        bool   `json:"physical_result_verified"`
+}
+
+func (s *ConcreteApiServer) roomTransportAsk(ctx context.Context, typ ApiRequestType, data any) (any, error) {
+	req, wait := NewApiRequest(typ, data)
+	select {
+	case s.requests <- req:
+	case <-ctx.Done():
+		return nil, ctx.Err()
+	}
+	return wait(ctx)
+}
+func roomTransportResponse(w http.ResponseWriter, data any, err error) {
+	if err != nil {
+		if errors.Is(err, ErrBadRequest) {
+			w.WriteHeader(400)
+		} else if errors.Is(err, ErrAliasConflict) || errors.Is(err, ErrNoSession) {
+			w.WriteHeader(409)
+		} else {
+			w.WriteHeader(504)
+		}
+		return
+	}
+	w.Header().Set("Content-Type", "application/json")
+	w.Header().Set("Cache-Control", "no-store")
+	_ = json.NewEncoder(w).Encode(data)
+}
+func roomTransportBody(w http.ResponseWriter, r *http.Request, out any) bool {
+	if r.Method != http.MethodPost {
+		w.WriteHeader(405)
+		return false
+	}
+	if r.URL.RawQuery != "" {
+		w.WriteHeader(400)
+		return false
+	}
+	defer r.Body.Close()
+	raw, err := io.ReadAll(io.LimitReader(r.Body, 2049))
+	if err != nil || len(raw) > 2048 || decodeQueueJSON(raw, out) != nil {
+		w.WriteHeader(400)
+		return false
+	}
+	return true
+}
+func (s *ConcreteApiServer) handleRoomTransportState(w http.ResponseWriter, r *http.Request) {
+	if r.Method != http.MethodGet {
+		w.WriteHeader(405)
+		return
+	}
+	q := r.URL.Query()
+	if len(q) != 4 {
+		w.WriteHeader(400)
+		return
+	}
+	for _, key := range []string{"account_user_id", "target_id", "room_id", "homepod_id"} {
+		if len(q[key]) != 1 || q.Get(key) == "" || len(q.Get(key)) > 160 {
+			w.WriteHeader(400)
+			return
+		}
+	}
+	ctx, cancel := context.WithTimeout(r.Context(), 3*time.Second)
+	defer cancel()
+	data, err := s.roomTransportAsk(ctx, apiRoomTransportState, roomTransportStateRequest{q.Get("account_user_id"), q.Get("target_id"), q.Get("room_id"), q.Get("homepod_id"), ctx})
+	roomTransportResponse(w, data, err)
+}
+func (s *ConcreteApiServer) handleRoomTransportPrepare(w http.ResponseWriter, r *http.Request) {
+	var request roomTransportPrepareRequest
+	if !roomTransportBody(w, r, &request) {
+		return
+	}
+	if request.AccountUserID == "" || len(request.AccountUserID) > 160 || request.TargetID == "" || len(request.TargetID) > 160 || request.RoomID == "" || len(request.RoomID) > 128 || !homePodIDPattern.MatchString(request.HomePodID) || request.VolumePercent != 0 {
+		w.WriteHeader(400)
+		return
+	}
+	ctx, cancel := context.WithTimeout(r.Context(), 3*time.Second)
+	defer cancel()
+	request.Context = ctx
+	data, err := s.roomTransportAsk(ctx, apiRoomTransportPrepare, request)
+	roomTransportResponse(w, data, err)
+}
+func (s *ConcreteApiServer) handleRoomTransportCommit(w http.ResponseWriter, r *http.Request) {
+	var request roomTransportCommitRequest
+	if !roomTransportBody(w, r, &request) {
+		return
+	}
+	if !queueIDPattern.MatchString(request.PrepareID) || !queueIDPattern.MatchString(request.OwnToneToken) {
+		w.WriteHeader(400)
+		return
+	}
+	ctx, cancel := context.WithTimeout(r.Context(), 5*time.Second)
+	defer cancel()
+	// First actor consumption occurs before the only OwnTone await. The actor is
+	// available to process retirement/alias/session updates during this HTTP call.
+	value, err := s.roomTransportAsk(ctx, apiRoomTransportConsume, roomTransportConsumeRequest{request.PrepareID, ctx})
+	if err != nil {
+		roomTransportResponse(w, nil, err)
+		return
+	}
+	offer, ok := value.(*nativeTransportOffer)
+	if !ok || offer == nil || ctx.Err() != nil || !time.Now().Before(offer.Expires) {
+		roomTransportResponse(w, nil, ErrAliasConflict)
+		return
+	}
+	defer func() {
+		cleanup, cancelCleanup := context.WithTimeout(context.Background(), time.Second)
+		defer cancelCleanup()
+		_, _ = s.roomTransportAsk(cleanup, apiRoomTransportAbort, offer)
+	}()
+	inputDigest := sha256.Sum256([]byte(offer.InputPath))
+	body, _ := json.Marshal(struct {
+		Token                   string `json:"token"`
+		NativePrepareID         string `json:"native_prepare_id"`
+		Action                  string `json:"action"`
+		ArgsDigest              string `json:"args_digest"`
+		ExpectedInputPathDigest string `json:"expected_input_path_digest"`
+	}{request.OwnToneToken, offer.Snapshot.PrepareID, offer.Snapshot.Action, offer.Snapshot.ArgsDigest, hex.EncodeToString(inputDigest[:])})
+	endpoint := strings.TrimSuffix(offer.OwnToneURL, "/") + "/api/outputs/" + offer.Snapshot.HomePodID + "/transport/commit"
+	call, err := http.NewRequestWithContext(ctx, http.MethodPost, endpoint, bytes.NewReader(body))
+	if err != nil {
+		roomTransportResponse(w, nil, err)
+		return
+	}
+	call.Header.Set("Content-Type", "application/json")
+	client := &http.Client{Timeout: 3 * time.Second, CheckRedirect: func(*http.Request, []*http.Request) error { return errors.New("transport redirect denied") }}
+	response, err := client.Do(call)
+	if err != nil {
+		roomTransportResponse(w, nil, err)
+		return
+	}
+	raw, readErr := io.ReadAll(io.LimitReader(response.Body, 2049))
+	_ = response.Body.Close()
+	var ack roomTransportOutputACK
+	if response.StatusCode != 200 || readErr != nil || len(raw) > 2048 || decodeQueueJSON(raw, &ack) != nil || ack.Schema != "podconnect.output_transport_commit.v1" || !ack.OK || ack.Token != request.OwnToneToken || ack.NativePrepareID != offer.Snapshot.PrepareID || ack.ArgsDigest != offer.Snapshot.ArgsDigest || ack.PinRemainingMS < 1 || ack.PinRemainingMS > 10000 || ack.Outcome != "accepted" || ack.Physical {
+		roomTransportResponse(w, nil, ErrAliasConflict)
+		return
+	}
+	// No public endpoint accepts this pointer. A real C ACK is required to enqueue.
+	data, err := s.roomTransportAsk(ctx, apiRoomTransportEffect, roomTransportEffectRequest{offer, ctx})
+	roomTransportResponse(w, data, err)
+}
