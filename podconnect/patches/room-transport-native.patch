+package output
+
+import (
+	"context"
+	"sync"
+	"time"
+)
+
+// LockTransport is used only for bounded, explicitly requested transport. The
+// existing audio path retains its blocking lock behavior.
+func LockTransport(ctx context.Context, lock *sync.Mutex) error {
+	if ctx == nil {
+		ctx = context.Background()
+	}
+	if err := ctx.Err(); err != nil {
+		return err
+	}
+	if lock.TryLock() {
+		return nil
+	}
+	tick := time.NewTicker(time.Millisecond)
+	defer tick.Stop()
+	for {
+		select {
+		case <-ctx.Done():
+			return ctx.Err()
+		case <-tick.C:
+			if lock.TryLock() {
+				return nil
+			}
+		}
+	}
+}
