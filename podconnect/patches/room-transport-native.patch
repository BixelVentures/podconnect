+	}
+	p.retireAliases()
+	p.aliasMu.Lock()
+	current := p.transportOfferCurrentLocked(offer, context.Background(), context.Background())
+	p.aliasMu.Unlock()
+	if current {
+		t.Fatal("post-consume retirement passed final actual mutation guard")
+	}
+	if _, err = p.consumeRoomTransport(context.Background(), roomTransportConsumeRequest{offer.Snapshot.PrepareID, context.Background()}); err == nil {
+		t.Fatal("consumed offer replayed")
+	}
+}
