+func TestRoomTransportFinalGuardRechecksInvalidationAfterConsumption(t *testing.T) {
+	p, offer := roomTransportAdmittedFixture(t)
+	value, err := p.handleApiRequest(context.Background(), ApiRequest{Type: apiRoomTransportConsume, Data: roomTransportConsumeRequest{offer.Snapshot.PrepareID, context.Background()}})
+	if err != nil || value != offer {
