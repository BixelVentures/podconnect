+package tracks
+
+import (
+	"context"
+	"fmt"
+	connectpb "github.com/devgianlu/go-librespot/proto/spotify/connectstate"
+	"google.golang.org/protobuf/proto"
+	"slices"
+)
+
+// PrepareTransport stages a cursor on detached native list storage. It does not
+// mutate the retained cursor, manual queue, revision or shuffle order.
+func (tl *List) PrepareTransport(ctx context.Context, previous bool, positionMS int64) (*List, error) {
+	if tl == nil || tl.tracks == nil || tl.tracks.pos < 0 || tl.ctx == nil || tl.queueRevisionExhausted {
+		return nil, fmt.Errorf("native list unavailable")
+	}
+	clone := *tl
+	pages := *tl.tracks
+	pages.list = slices.Clone(tl.tracks.list)
+	for i := range pages.list {
+		if pages.list[i].item == nil {
+			return nil, fmt.Errorf("nil native track")
+		}
+		pages.list[i].item = proto.Clone(pages.list[i].item).(*connectpb.ContextTrack)
+	}
+	clone.tracks = &pages
+	clone.queue = make([]*connectpb.ContextTrack, len(tl.queue))
+	for i, track := range tl.queue {
+		if track == nil {
+			return nil, fmt.Errorf("nil queued track")
+		}
+		clone.queue[i] = proto.Clone(track).(*connectpb.ContextTrack)
+	}
+	if previous && positionMS > 3000 {
+		clone.invalidateQueueObservation()
+	} else if previous {
+		clone.GoPrev()
+	} else if !clone.GoNext(ctx) {
+		return nil, fmt.Errorf("no next native occurrence")
+	}
+	if ctx.Err() != nil {
+		return nil, ctx.Err()
+	}
+	return &clone, nil
+}
+
+// TransportRevision is an actor-owned monotonic queue mutation fence.
+func (tl *List) TransportRevision() uint64 {
+	if tl == nil {
+		return 0
+	}
+	return tl.queueRevision
+}
