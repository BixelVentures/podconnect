+package player
+
+import (
+	"context"
+	"fmt"
+	librespot "github.com/devgianlu/go-librespot"
+	"github.com/devgianlu/go-librespot/output"
+	"sync"
+)
+
+type guardedTransportCommand struct {
+	context        context.Context
+	paused         bool
+	source         librespot.AudioSource
+	expectedSource librespot.AudioSource
+	guard          output.TransportGuard
+}
+
+// GuardedTransport is additive; legacy player operations keep their behavior.
+// After enqueue, wait for the worker's terminal answer to preserve AppPlayer
+// serialization. The HTTP caller may have timed out independently.
+func (p *Player) GuardedTransport(ctx context.Context, paused bool, source librespot.AudioSource, expectedSource librespot.AudioSource, guard output.TransportGuard) error {
+	reply := make(chan any, 1)
+	select {
+	case p.cmd <- playerCmd{guarded: &guardedTransportCommand{context: ctx, paused: paused, source: source, expectedSource: expectedSource, guard: guard}, resp: reply}:
+	case <-ctx.Done():
+		return ctx.Err()
+	}
+	if result := <-reply; result != nil {
+		return result.(error)
+	}
+	return nil
+}
+
+func (p *Player) applyGuardedTransport(command *guardedTransportCommand, out *output.Output, source *SwitchingAudioSource, volume float32) error {
+	if *out == nil {
+		return fmt.Errorf("no existing pipe output")
+	}
+
+	pipe, ok := (*out).(output.GuardedPipeOutput)
+	if !ok {
+		return fmt.Errorf("guarded pipe output unavailable")
+	}
+	var displaced []librespot.AudioSource
+	err := pipe.WithTransportLock(command.context, func(setPaused func(bool)) error {
+		lock, ok := source.cond.L.(*sync.Mutex)
+		if !ok {
+			return fmt.Errorf("native source lock unavailable")
+		}
+		if err := output.LockTransport(command.context, lock); err != nil {
+			return err
+		}
+		defer lock.Unlock()
+		if source.source[source.which] != command.expectedSource {
+			return fmt.Errorf("native primary source changed")
+		}
+		// Both possibly blocking locks precede the deadline/owner test. The guarded
+		// callback is only local assignment; it never seeks, reads, writes or awaits.
+		return command.guard(func() {
+			if command.source != nil {
+				displaced = append(displaced, source.source[source.which], source.source[!source.which])
+				source.source[source.which] = command.source
+				delete(source.source, !source.which)
+				source.cond.Broadcast()
+			}
+			setPaused(command.paused)
+		})
+	})
+	if err == nil {
+		// Publication removed these sources while both source/output locks were
+		// held. Dispose them after releasing locks; the adopted source remains live.
+		seen := map[librespot.AudioSource]bool{}
+		for _, old := range displaced {
+			if old != nil && old != command.source && !seen[old] {
+				seen[old] = true
+				_ = closeAudioDecoder(old)
+			}
+		}
+	}
+	return err
+}
