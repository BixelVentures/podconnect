+					}
+					mutate()
+					return nil
+				}}, &out, source, 1)
+			}()
+			<-backend.entered
+			mu.Lock()
+			expired = true
+			mu.Unlock()
+			if stage == "source" {
+				source.cond.L.Unlock()
+			} else {
+				close(backend.gate)
+			}
+			select {
+			case err := <-done:
