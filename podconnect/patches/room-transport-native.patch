+package player
+
+import (
+	librespot "github.com/devgianlu/go-librespot"
+	"io"
+	"sync"
+)
+
+// ownedAudioSource retains the raw HTTP reader hidden by decoder section/meta
+// readers. Closing cancels fetches before decoder teardown, and handles Vorbis'
+// legacy void Close signature as well as io.Closer. The player owns adopted
+// sources; the transport offer owns sources until guarded publication.
+type ownedAudioSource struct {
+	librespot.AudioSource
+	raw  io.Closer
+	once sync.Once
+	err  error
+}
+
+func closeAudioDecoder(source librespot.AudioSource) error {
+	switch decoder := source.(type) {
+	case io.Closer:
+		return decoder.Close()
+	case interface{ Close() }:
+		decoder.Close()
+	}
+	return nil
+}
+func (source *ownedAudioSource) Close() error {
+	source.once.Do(func() {
+		if source.raw != nil {
+			source.err = source.raw.Close()
+		}
+		if err := closeAudioDecoder(source.AudioSource); source.err == nil {
+			source.err = err
+		}
+	})
+	return source.err
+}
