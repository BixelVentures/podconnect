+func TestPauseOnlyWriterVerificationWithHeldReadRejectsStaleProofs(t *testing.T) {
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) { w.WriteHeader(http.StatusConflict) }))
+	defer srv.Close()
+	app, owner, _ := retirementOwnerFixture(t, srv.URL, "start")
+	writer := app.openedWriter
+	current, err := owner.player.Start35CurrentSource(context.Background())
+	if err != nil {
+		t.Fatal(err)
+	}
+	held := &retirementHeldRead{entered: make(chan struct{}), release: make(chan struct{})}
+	defer held.CancelRead()
+	guard := func(m func()) error { m(); return nil }
+	if _, _, err = owner.player.Start35(context.Background(), "publish", held, current, writer.PipeIdentity, "1", guard); err != nil {
+		t.Fatal(err)
+	}
+	if _, _, err = owner.player.Start35(context.Background(), "resume", nil, held, writer.PipeIdentity, "1", guard); err != nil {
+		t.Fatal(err)
+	}
+	select {
+	case <-held.entered:
+	case <-time.After(time.Second):
+		t.Fatal("read not held")
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), time.Second)
+	defer cancel()
+	got, epoch, err := owner.player.RoomMove(ctx, "verify-pause", held, writer, "1", true, guard)
+	if err != nil || got != writer || epoch != "1" {
+		t.Fatalf("pause-only verification: %v", err)
+	}
+	for _, mode := range []string{"source", "writer", "epoch", "owner"} {
+		candidate := writer
+		source := librespot.AudioSource(held)
+		candidateEpoch := "1"
+		checks := 0
+		if mode == "source" {
+			source = &contentInertSource{}
+		}
+		if mode == "writer" {
+			candidate.FD = "99999"
+		}
+		if mode == "epoch" {
+			candidateEpoch = "2"
+		}
+		reject := func(m func()) error {
+			checks++
+			if mode == "owner" {
+				return errors.New("stale owner")
+			}
+			m()
+			return nil
+		}
+		if _, _, e := owner.player.RoomMove(ctx, "verify-pause", source, candidate, candidateEpoch, true, reject); e == nil {
+			t.Fatalf("%s accepted", mode)
+		}
+		if mode != "owner" && checks != 0 {
+			t.Fatalf("%s reached guard", mode)
+		}
+		if mode == "owner" && checks != 1 {
+			t.Fatal("owner guard not checked")
+		}
+	}
+	owner.player.InterruptRetiringRead()
+	if _, _, e := owner.player.RoomMove(ctx, "verify-pause", held, writer, "1", true, guard); e == nil {
+		t.Fatal("terminal source proof accepted")
+	}
+	held.CancelRead()
+	owner.player.Close()
+}
