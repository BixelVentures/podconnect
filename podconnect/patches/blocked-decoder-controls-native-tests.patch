+func TestHeldReadPauseRetainsPCMAndStopAllowsFreshSource(t *testing.T) {
+	for _, mode := range []string{"pause_resume", "guarded_pause_resume", "stop_replace"} {
+		t.Run(mode, func(t *testing.T) {
+			srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) { w.WriteHeader(http.StatusConflict) }))
+			defer srv.Close()
+			_, owner, fd := retirementOwnerFixture(t, srv.URL, "start")
+			if mode == "stop_replace" {
+				owner.app.startCustody = nil
+			} // Generic unbound Stop; no UNKNOWN clearance is tested here.
+			writer := owner.app.openedWriter
+			path, err := os.Readlink("/proc/self/fd/" + fd)
+			if err != nil {
+				t.Fatal(err)
+			}
+			reader, err := os.OpenFile(path, os.O_RDONLY|syscall.O_NONBLOCK, 0)
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer reader.Close()
+			if err = syscall.SetNonblock(int(reader.Fd()), true); err != nil {
+				t.Fatal(err)
+			}
+			current, err := owner.player.Start35CurrentSource(context.Background())
+			if err != nil {
+				t.Fatal(err)
+			}
+			held := &retainedPCMRead{entered: make(chan struct{}), release: make(chan struct{})}
+			guard := func(m func()) error { m(); return nil }
+			if _, _, err = owner.player.Start35(context.Background(), "publish", held, current, writer.PipeIdentity, "1", guard); err != nil {
+				t.Fatal(err)
+			}
+			if _, _, err = owner.player.Start35(context.Background(), "resume", nil, held, writer.PipeIdentity, "1", guard); err != nil {
+				t.Fatal(err)
+			}
+			select {
+			case <-held.entered:
+			case <-time.After(time.Second):
+				t.Fatal("no held read")
+			}
+			if mode == "pause_resume" || mode == "guarded_pause_resume" {
+				if mode == "guarded_pause_resume" {
+					err = owner.player.GuardedTransport(context.Background(), true, nil, held, guard)
+				} else {
+					err = owner.player.Pause()
+				}
+				if err != nil {
+					t.Fatal(err)
+				}
+				close(held.release)
+				var buf [2]byte
+				deadline := time.Now().Add(100 * time.Millisecond)
+				for time.Now().Before(deadline) {
+					n, e := syscall.Read(int(reader.Fd()), buf[:])
+					if n > 0 {
+						t.Fatal("PCM escaped while paused")
+					}
+					if e != nil && !errors.Is(e, syscall.EAGAIN) {
+						t.Fatal(e)
+					}
+					time.Sleep(time.Millisecond)
+				}
+				if err = owner.player.Play(); err != nil {
+					t.Fatal(err)
+				}
+				deadline = time.Now().Add(time.Second)
+				n := 0
+				for n <= 0 && time.Now().Before(deadline) {
+					n, _ = syscall.Read(int(reader.Fd()), buf[:])
+					if n <= 0 {
+						time.Sleep(time.Millisecond)
+					}
+				}
+				if n != 2 || buf != [2]byte{0, 64} {
+					t.Fatalf("held PCM not preserved: %x %d", buf, n)
+				}
+			} else {
+				done := make(chan struct{})
+				go func() { owner.player.Stop(); close(done) }()
+				// This synthetic source is intentionally non-cancellable; Stop must wait for
+				// the exact old read and must not grant a replacement before it joins.
+				select {
+				case <-done:
+					t.Fatal("Stop returned before non-cancellable read joined")
+				case <-time.After(50 * time.Millisecond):
+				}
+				close(held.release)
+				select {
+				case <-done:
+				case <-time.After(time.Second):
+					t.Fatal("Stop did not join")
+				}
+				fresh := &contentInertSource{}
+				if err = owner.player.SetPrimaryStream(fresh, true, false); err != nil {
+					t.Fatalf("fresh source after Stop: %v", err)
+				}
+				if err = owner.player.Play(); err != nil {
+					t.Fatalf("new source cannot play: %v", err)
+				}
+			}
+			owner.player.Close()
+		})
+	}
+}
