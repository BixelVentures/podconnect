+type delayedLeaseSource struct {
+	entered   chan struct{}
+	release   chan struct{}
+	cancelled chan struct{}
+	once      sync.Once
+}
+
+func (s *delayedLeaseSource) Read(p []float32) (int, error) {
+	close(s.entered)
+	<-s.release
+	p[0] = 0.5
+	return 1, io.EOF
+}
+func (s *delayedLeaseSource) CancelRead()             { s.once.Do(func() { close(s.cancelled) }) }
+func (*delayedLeaseSource) PositionMs() int64         { return 91 }
+func (*delayedLeaseSource) SetPositionMs(int64) error { return nil }
+func TestAbandonedReadSuppressesLatePCMAndEOFAfterSameSourceABA(t *testing.T) {
+	s := NewSwitchingAudioSource()
+	s.asyncRead = true
+	old := &delayedLeaseSource{entered: make(chan struct{}), release: make(chan struct{}), cancelled: make(chan struct{})}
+	s.SetPrimary(old)
+	result := make(chan struct {
+		n   int
+		err error
+	}, 1)
+	go func() {
+		n, e := s.Read(make([]float32, 2))
+		result <- struct {
+			n   int
+			err error
+		}{n, e}
+	}()
+	select {
+	case <-old.entered:
+	case <-time.After(time.Second):
+		t.Fatal("read not entered")
+	}
+	s.CancelActiveRead()
+	<-old.cancelled
+	s.SetPrimary(old)
+	close(old.release)
+	select {
+	case v := <-result:
+		if v.n != 0 || v.err != nil {
+			t.Fatalf("stale data crossed lease: %v", v)
+		}
+	case <-time.After(time.Second):
+		t.Fatal("old read not joined")
+	}
+	if s.TakeDone() != 0 {
+		t.Fatal("old EOF crossed lease")
+	}
+	select {
+	case <-s.Done():
+		t.Fatal("old EOF signalled successor")
+	default:
+	}
+}
+func TestTerminalReadFenceCannotBeResetBySetPrimary(t *testing.T) {
+	s := NewSwitchingAudioSource()
+	s.asyncRead = true
+	s.CancelRead()
+	s.SetPrimary(&retirementEOFSource{})
+	if _, err := s.Read(make([]float32, 1)); err != io.EOF {
+		t.Fatalf("terminal fence revived: %v", err)
+	}
+}
+
+func TestCancelWaitingNilSourceWakesOnlyOldLease(t *testing.T) {
+	s := NewSwitchingAudioSource()
+	s.asyncRead = true
+	done := make(chan error, 1)
+	go func() { _, e := s.Read(make([]float32, 1)); done <- e }()
+	// Observe that the old read entered Cond.Wait before cancelling its lease.
+	deadline := time.Now().Add(time.Second)
+	for {
+		buf := make([]byte, 1<<16)
+		n := runtime.Stack(buf, true)
+		if bytes.Contains(buf[:n], []byte("(*SwitchingAudioSource).Read")) && bytes.Contains(buf[:n], []byte("sync.(*Cond).Wait")) {
+			break
+		}
+		if time.Now().After(deadline) {
+			t.Fatal("nil-source read did not wait")
+		}
+		runtime.Gosched()
+	}
+	s.CancelActiveRead()
+	select {
+	case e := <-done:
+		if e != nil {
+			t.Fatalf("old wait returned %v", e)
+		}
+	case <-time.After(time.Second):
+		t.Fatal("old nil-source wait did not wake")
+	}
+	fresh := &retirementEOFSource{}
+	if !s.SetPrimary(fresh) {
+		t.Fatal("generic cancellation sealed wrapper")
+	}
+}
