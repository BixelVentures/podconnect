+	n, e := syscall.Read(int(reader.Fd()), buf[:])
+	if n > 0 {
+		t.Fatalf("old PCM escaped: %x", buf)
+	}
+	if e != nil && !errors.Is(e, syscall.EAGAIN) {
+		t.Fatal(e)
+	}
+	for {
+		select {
+		case event := <-owner.player.Receive():
+			if event.Type == player.EventTypeNotPlaying {
+				t.Fatal("old EOF escaped")
+			}
+		default:
+			goto checkedSame
+		}
+	}
+checkedSame:
+	source.CancelRead()
+	limit := time.Now().Add(time.Second)
+	n = 0
+	for n <= 0 && time.Now().Before(limit) {
+		n, _ = syscall.Read(int(reader.Fd()), buf[:])
+		if n <= 0 {
+			time.Sleep(time.Millisecond)
+		}
+	}
+	if n != 2 || buf != [2]byte{0, 32} {
+		t.Fatalf("new PCM missing: %x %d", buf, n)
+	}
+	owner.player.Close()
+}
