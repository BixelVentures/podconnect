+func TestBlockedDecoderControlLiveness(t *testing.T) {
+	for _, mode := range []string{"position", "pause", "stop_after_prepare_409"} {
+		t.Run(mode, func(t *testing.T) {
+			prepare := make(chan struct{}, 1)
+			srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				prepare <- struct{}{}
+				w.WriteHeader(http.StatusConflict)
+			}))
+			defer srv.Close()
+			_, owner, _ := retirementOwnerFixture(t, srv.URL, "start")
+			writer := owner.app.openedWriter
+			current, err := owner.player.Start35CurrentSource(context.Background())
+			if err != nil {
+				t.Fatal(err)
+			}
+			held := &retirementHeldRead{entered: make(chan struct{}), release: make(chan struct{})}
+			defer held.CancelRead()
+			guard := func(mutate func()) error { mutate(); return nil }
+			if _, _, err = owner.player.Start35(context.Background(), "publish", held, current, writer.PipeIdentity, "1", guard); err != nil {
+				t.Fatal(err)
+			}
+			if _, _, err = owner.player.Start35(context.Background(), "resume", nil, held, writer.PipeIdentity, "1", guard); err != nil {
+				t.Fatal(err)
+			}
+			select {
+			case <-held.entered:
+			case <-time.After(time.Second):
+				t.Fatal("decoder not entered")
+			}
+			done := make(chan struct{})
+			go func() {
+				if mode == "position" {
+					_ = owner.player.PositionMs()
+				} else if mode == "pause" {
+					_ = owner.player.Pause()
+				} else {
+					owner.beginStopRetirement()
+					owner.player.Stop()
+				}
+				close(done)
+			}()
+			if mode == "stop_after_prepare_409" {
+				select {
+				case <-prepare:
+				case <-time.After(time.Second):
+					held.CancelRead()
+					t.Fatal("prepare not reached")
+				}
+			}
+			blocked := false
+			select {
+			case <-done:
+			case <-time.After(300 * time.Millisecond):
+				blocked = true
+			}
+			held.CancelRead()
+			select {
+			case <-done:
+			case <-time.After(time.Second):
+				t.Fatal("cleanup failed")
+			}
+			owner.player.Close()
+			if blocked {
+				t.Errorf("RED: %s waits on blocked decoder despite bounded writer control", mode)
+			}
+		})
+	}
+}
