diff --git a/output/room_transport_lock_test.go b/output/room_transport_lock_test.go
new file mode 100644
--- /dev/null
+++ b/output/room_transport_lock_test.go
@@ -0,0 +1,63 @@
+package output
+
+import (
+	"context"
+	"runtime"
+	"sync"
+	"testing"
+	"time"
+)
+
+func waitTransportLockReleased(t *testing.T, lock *sync.Mutex) {
+	t.Helper()
+	deadline := time.Now().Add(time.Second)
+	for !lock.TryLock() {
+		if time.Now().After(deadline) {
+			t.Fatal("canceled waiter retained transport lock")
+		}
+		runtime.Gosched()
+	}
+	lock.Unlock()
+}
+
+func TestTransportLockCanceledWaiterNeverRetainsLaterLock(t *testing.T) {
+	var lock sync.Mutex
+	lock.Lock()
+	ctx, cancel := context.WithCancel(context.Background())
+	result := make(chan error, 1)
+	go func() {
+		err := LockTransport(ctx, &lock)
+		if err == nil {
+			lock.Unlock()
+		}
+		result <- err
+	}()
+	cancel()
+	if err := <-result; err != context.Canceled {
+		t.Fatal("canceled waiter accepted", err)
+	}
+	lock.Unlock()
+	waitTransportLockReleased(t, &lock)
+}
+
+func TestTransportLockAcquireCancelRaceReleasesExactlyOnce(t *testing.T) {
+	for i := 0; i < 100; i++ {
+		var lock sync.Mutex
+		lock.Lock()
+		ctx, cancel := context.WithCancel(context.Background())
+		result := make(chan error, 1)
+		go func() {
+			err := LockTransport(ctx, &lock)
+			if err == nil {
+				lock.Unlock()
+			}
+			result <- err
+		}()
+		lock.Unlock()
+		cancel()
+		if err := <-result; err != nil && err != context.Canceled {
+			t.Fatal(err)
+		}
+		waitTransportLockReleased(t, &lock)
+	}
+}
