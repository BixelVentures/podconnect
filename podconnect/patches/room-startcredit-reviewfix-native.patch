+	p, err := NewPlayer(&Options{
+		Log: &librespot.NullLogger{}, AudioBackend: "pipe", AudioOutputPipe: path,
+		AudioOutputPipeFormat: "s16le", WithNewOutput: func(create func() (output.Output, error)) (output.Output, error) {
+			out, err := create()
+			if err == nil {
+				writer = out.(interface {
+					OpenedWriterIdentity() output.MovePipeIdentity
+				}).OpenedWriterIdentity()
+			}
+			return out, err
+		},
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	old := &startVerifyEOFSource{id: 1}
+	old.end.Store(true)
+	selected := &startVerifyPCMSource{tokens: make(chan struct{}, 1), entered: make(chan struct{}, 1)}
+	defer func() { close(selected.tokens); p.Close() }()
+	if err := p.SetPrimaryStream(old, true, false); err != nil {
+		t.Fatal(err)
+	}
+	guard := func(mutate func()) error { mutate(); return nil }
+	pipe, epoch, err := p.Start35(context.Background(), "quiesce", nil, old, output.PipeIdentity{}, "", guard)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, _, err = p.Start35(context.Background(), "publish", selected, old, pipe, epoch, guard); err != nil {
+		t.Fatal(err)
+	}
+	if _, _, err = p.Start35(context.Background(), "resume", nil, selected, pipe, epoch, guard); err != nil {
+		t.Fatal(err)
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), 2*time.Second)
+	defer cancel()
+	// Prove a real nonzero PCM write reached the registered FIFO reader before
+	// claiming that verification can join a playing output.
+	select {
+	case <-selected.entered:
+	case <-ctx.Done():
+		t.Fatal("playing source did not start reading", ctx.Err())
+	}
+	selected.tokens <- struct{}{}
+	select {
+	case <-drainedPCM:
+	case <-ctx.Done():
+		t.Fatal("playing writer did not deliver nonzero PCM", ctx.Err())
+	}
+	// A fresh Read is now blocked on its token while holding the output-side
+	// playback path; the verification must wait for that work to finish.
+	select {
+	case <-selected.entered:
+	case <-ctx.Done():
+		t.Fatal("playing source did not enter its next read", ctx.Err())
+	}
+	finished := make(chan error, 1)
+	go func() {
+		finished <- p.VerifyStart35(ctx, selected, pipe, epoch, writer.FD, guard)
+	}()
+	select {
+	case <-finished:
+		t.Fatal("verification returned while a live source Read was blocked")
+	default:
+	}
+	// Release the blocked Read with another real PCM chunk.
+	selected.tokens <- struct{}{}
+	morePCM := false
+	for {
+		select {
+		case <-drainedPCM:
+			morePCM = true
+		case err := <-finished:
+			if err != nil {
+				t.Fatal("live nonzero PCM writer was not verified", err)
+			}
+			if !morePCM {
+				select {
+				case <-drainedPCM:
+				case <-ctx.Done():
+					t.Fatal("verification saw no subsequent nonzero PCM", ctx.Err())
+				}
+			}
+			return
+		case selected.tokens <- struct{}{}:
+		case <-ctx.Done():
+			t.Fatal("live nonzero PCM writer verification timed out", ctx.Err())
+		}
+	}
+}
