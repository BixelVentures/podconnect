@@ -0,0 +1,268 @@
+package daemon
+
+import (
+	"context"
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"sync/atomic"
+	"testing"
+	"time"
+)
+
+func burstVolumeFixture(t *testing.T) (*AppPlayer, *roomVolumeOperation) {
+	p, op := roomVolumeFixture(t)
+	revision, err := p.nextNativeIntent()
+	if err != nil {
+		t.Fatal(err)
+	}
+	op.Bound = true
+	op.NativeRevision = revision
+	op.Actor.Bound = true
+	op.Actor.NativeRevision = revision
+	op.TerminalProof = make(chan struct{})
+	return p, op
+}
+func TestRoomBurstActorOwnedIntentSupersedesActualFinalGuard(t *testing.T) {
+	p, offer := roomTransportAdmittedFixture(t)
+	first, err := p.nextNativeIntent()
+	if err != nil {
+		t.Fatal(err)
+	}
+	offer.Bound = true
+	offer.NativeRevision = first
+	offer.Snapshot.NativeRevision = first
+	if _, err = p.consumeRoomTransportVersion(context.Background(), roomTransportConsumeRequest{offer.Snapshot.PrepareID, context.Background()}, true); err != nil {
+		t.Fatal(err)
+	}
+	second, err := p.nextNativeIntent()
+	if err != nil || second == first {
+		t.Fatal("new actor prepare did not advance actual intent")
+	}
+	// This is exactly the final actor guard invoked after the actual pipe/source
+	// locks. Those lock positions are exercised by retained player guard tests.
+	p.aliasMu.Lock()
+	admitted := p.transportOfferCurrentLocked(offer, context.Background(), context.Background())
+	p.aliasMu.Unlock()
+	if admitted {
+		t.Fatal("superseded intent passed actual final actor mutator guard")
+	}
+	p.roomNativeIntent = ^uint64(0)
+	if _, err = p.nextNativeIntent(); err == nil {
+		t.Fatal("native revision wrapped into old authority")
+	}
+}
+func TestRoomBurstBoundEnvelopeCannotDowngradeOrAdoptForeignOwner(t *testing.T) {
+	_, op := burstVolumeFixture(t)
+	base := roomVolumePrepareACK{"podconnect.output_room_volume_prepare.v2", true, strings.Repeat("c", 32), op.ID, op.ArgsDigest, 45, op.Binding.Route, op.Binding.VolumeState, 1000, false}
+	good, _ := json.Marshal(boundOwnerPayload(base, op.Binding.Native, op.NativeRevision))
+	var got roomVolumePrepareACK
+	if decodeBoundOwner(good, &got, op.Binding.Native, op.NativeRevision) != nil {
+		t.Fatal("matching closed bound proof denied")
+	}
+	for _, raw := range [][]byte{[]byte(strings.Replace(string(good), `"native_revision":"1"`, `"native_revision":"2"`, 1)), []byte(strings.Replace(string(good), `"account_user_id":"account"`, `"account_user_id":"other"`, 1)), []byte(strings.Replace(string(good), `"native_revision":"1"`, `"native_revision":"1","native_revision":"1"`, 1))} {
+		if decodeBoundOwner(raw, &got, op.Binding.Native, op.NativeRevision) == nil {
+			t.Fatal("foreign or ambiguous bound owner accepted")
+		}
+	}
+	unbound, _ := json.Marshal(base)
+	if decodeBoundOwner(unbound, &got, op.Binding.Native, op.NativeRevision) == nil {
+		t.Fatal("legacy receipt silently upgraded")
+	}
+}
+func TestRoomBurstVerifiedTerminalReleasesProductionActorPark(t *testing.T) {
+	p, op := burstVolumeFixture(t)
+	var commits atomic.Int32
+	server := &ConcreteApiServer{requests: make(chan ApiRequest)}
+	server.roomVolumes.put(op)
+	owner := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		var fields map[string]json.RawMessage
+		if r.Method == "POST" && json.NewDecoder(r.Body).Decode(&fields) != nil {
+			t.Error("request")
+		}
+		switch r.URL.Path {
+		case "/api/outputs/101/volume/bound-prepare":
+			if len(fields) != 8 {
+				t.Error("bound prepare not closed8")
+			}
+			var request roomVolumeCPrepareRequest
+			raw, _ := json.Marshal(fields)
+			if decodeBoundOwner(raw, &request, op.Binding.Native, op.NativeRevision) != nil {
+				t.Error("prepare actual owner/revision mismatch")
+			}
+			ack := roomVolumePrepareACK{"podconnect.output_room_volume_prepare.v2", true, strings.Repeat("c", 32), op.ID, op.ArgsDigest, 45, op.Binding.Route, op.Binding.VolumeState, 1000, false}
+			_ = json.NewEncoder(w).Encode(boundOwnerPayload(ack, op.Binding.Native, op.NativeRevision))
+		case "/api/outputs/101/volume/bound-commit":
+			if len(fields) != 8 {
+				t.Error("bound commit not closed8")
+			}
+			var request roomVolumeCCommitRequest
+			raw, _ := json.Marshal(fields)
+			if decodeBoundOwner(raw, &request, op.Binding.Native, op.NativeRevision) != nil {
+				t.Error("commit actual owner/revision mismatch")
+			}
+			commits.Add(1)
+			ack := volumeOwnerAck(op, "commit", "protocol_accepted", true)
+			ack.Schema = boundSchema(ack.Schema, true)
+			_ = json.NewEncoder(w).Encode(boundOwnerPayload(ack, op.Binding.Native, op.NativeRevision))
+		default:
+			t.Error("unexpected route", r.URL.Path)
+			w.WriteHeader(404)
+		}
+	}))
+	defer owner.Close()
+	op.OwnToneURL = owner.URL
+	op.Actor.OwnToneURL = owner.URL
+	p.app.cfg.RoomTransportOwnToneURL = owner.URL
+	actorDone := make(chan struct{})
+	go func() {
+		defer close(actorDone)
+		for req := range server.requests {
+			if !p.dispatchAPIAndPark(context.Background(), req) {
+				return
+			}
+		}
+	}()
+	defer func() { close(server.requests); <-actorDone }()
+	out := httptest.NewRecorder()
+	server.handleRoomVolumeCommit(out, httptest.NewRequest("POST", "/player/room_volume/bound-commit", strings.NewReader(`{"native_prepare_id":"`+op.ID+`"}`)))
+	var receipt roomVolumeReceipt
+	if strictVolumeJSON(out.Body.Bytes(), &receipt) != nil || receipt.Schema != "podconnect.native_room_volume_commit.v2" || !receipt.ProtocolAccepted || commits.Load() != 1 {
+		t.Fatal("actual bound protocol proof absent", out.Body.String())
+	}
+	// Production dispatch must have replied to CONSUME before parking, permitting
+	// the C HTTP call; exact trusted terminal proof now permits a queued operation.
+	req, wait := NewApiRequest(ApiRequestTypeAliases, nil)
+	select {
+	case server.requests <- req:
+	case <-time.After(400 * time.Millisecond):
+		t.Fatal("verified drained protocol proof did not release actor promptly")
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), 400*time.Millisecond)
+	defer cancel()
+	if _, err := wait(ctx); err != nil {
+		t.Fatal("queued same-owner read stalled", err)
+	}
+	p.aliasMu.Lock()
+	stillReserved := p.roomVolumeReservation != nil
+	p.aliasMu.Unlock()
+	if stillReserved || !time.Now().Before(op.ReservationUntil) {
+		t.Fatal("early exact terminal release not exercised")
+	}
+}
+func TestRoomBurstUnknownForeignAndUndrainedProofKeepOriginalPark(t *testing.T) {
+	for _, mode := range []string{"unknown", "undrained", "foreign-owner", "timeout"} {
+		t.Run(mode, func(t *testing.T) {
+			p, op := burstVolumeFixture(t)
+			op.CPrepare = &roomVolumePrepareACK{Token: strings.Repeat("c", 32)}
+			op.ReservationID = strings.Repeat("d", 32)
+			until := time.Now().Add(65 * time.Millisecond)
+			reservation := &nativeRoomVolumeReservation{op, until}
+			p.roomVolumeReservation = reservation
+			done := make(chan struct{})
+			go func() { p.waitReservedOwner(context.Background(), reservation); close(done) }()
+			ack := volumeOwnerAck(op, "result", "protocol_accepted", true)
+			ack.Schema = boundSchema(ack.Schema, true)
+			switch mode {
+			case "unknown":
+				ack.Outcome = "unknown"
+			case "undrained":
+				ack.ContextsDrained = false
+			case "foreign-owner":
+				ack.Identity.Process = "00000000-0000-0000-0000-000000000002"
+			}
+			if mode != "timeout" && op.validOwnerReceipt(ack, "result") {
+				op.recordOwnerReceipt(ack)
+			}
+			select {
+			case <-done:
+				t.Fatal("unproven receipt shortened native owner quarantine")
+			case <-time.After(10 * time.Millisecond):
+			}
+			select {
+			case <-done:
+				if time.Now().Before(until) {
+					t.Fatal("native absolute deadline renewed or shortened")
+				}
+			case <-time.After(time.Second):
+				t.Fatal("bounded park failed to retire")
+			}
+		})
+	}
+}
+
+func TestRoomBurstAudioHTTPRequiresActualExactBoundProof(t *testing.T) {
+	for _, mode := range []string{"accepted", "foreign-revision", "foreign-owner", "downgrade", "old-endpoint"} {
+		t.Run(mode, func(t *testing.T) {
+			p, offer := roomTransportAdmittedFixture(t)
+			revision, err := p.nextNativeIntent()
+			if err != nil {
+				t.Fatal(err)
+			}
+			offer.Bound = true
+			offer.NativeRevision = revision
+			offer.Snapshot.NativeRevision = revision
+			owner := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				if r.URL.Path != "/api/outputs/101/transport/bound-commit" {
+					t.Error("unbound fallback", r.URL.Path)
+				}
+				raw := map[string]json.RawMessage{}
+				_ = json.NewDecoder(r.Body).Decode(&raw)
+				if len(raw) != 7 {
+					t.Error("audio Ccommit not closed7")
+				}
+				var got roomTransportIdentity
+				var gotRevision string
+				if strictVolumeJSON(raw["native_owner"], &got) != nil || got != offer.Snapshot.roomTransportIdentity || json.Unmarshal(raw["native_revision"], &gotRevision) != nil || gotRevision != revision {
+					t.Error("audio Ccommit actual actor binding absent")
+				}
+				ack := roomTransportOutputACK{"podconnect.output_transport_commit.v2", true, strings.Repeat("c", 32), offer.Snapshot.PrepareID, offer.Snapshot.ArgsDigest, 10000, "accepted", false}
+				boundOwner := offer.Snapshot.roomTransportIdentity
+				boundRevision := revision
+				if mode == "foreign-owner" {
+					boundOwner.ConnectionID = "foreign"
+				}
+				if mode == "foreign-revision" {
+					boundRevision = "2"
+				}
+				var reply any = boundOwnerPayload(ack, boundOwner, boundRevision)
+				if mode == "downgrade" {
+					ack.Schema = "podconnect.output_transport_commit.v1"
+					reply = ack
+				}
+				_ = json.NewEncoder(w).Encode(reply)
+			}))
+			defer owner.Close()
+			offer.OwnToneURL = owner.URL
+			p.app.cfg.RoomTransportOwnToneURL = owner.URL
+			server := &ConcreteApiServer{requests: make(chan ApiRequest)}
+			var effects atomic.Int32
+			done := make(chan struct{})
+			go func() {
+				defer close(done)
+				for req := range server.requests {
+					switch req.Type {
+					case apiRoomTransportEffect:
+						effects.Add(1)
+						req.Reply(map[string]any{"schema": "podconnect.native_room_transport_commit.v2", "accepted_native": true, "prepare_id": offer.Snapshot.PrepareID, "physical_result_verified": false}, nil)
+					default:
+						data, err := p.handleApiRequest(context.Background(), req)
+						req.Reply(data, err)
+					}
+				}
+			}()
+			path := "/player/room_transport/bound-commit"
+			if mode == "old-endpoint" {
+				path = "/player/room_transport/commit"
+			}
+			out := httptest.NewRecorder()
+			server.handleRoomTransportCommit(out, httptest.NewRequest("POST", path, strings.NewReader(`{"prepare_id":"`+offer.Snapshot.PrepareID+`","own_tone_token":"`+strings.Repeat("c", 32)+`"}`)))
+			close(server.requests)
+			<-done
+			if (mode == "accepted") != (out.Code == 200 && effects.Load() == 1) {
+				t.Fatal("wrong bound proof reached private effect", mode, out.Code, out.Body.String(), effects.Load())
+			}
+		})
+	}
+}
