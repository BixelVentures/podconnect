diff --git a/daemon/room_burst.go b/daemon/room_burst.go
new file mode 100644
--- /dev/null
+++ b/daemon/room_burst.go
@@ -0,0 +1,107 @@
+package daemon
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"net/http"
+	"strconv"
+	"strings"
+)
+
+const (
+	apiRoomBoundState         ApiRequestType = "room_bound_state"
+	apiRoomBoundPrepare       ApiRequestType = "room_bound_prepare"
+	apiRoomBoundConsume       ApiRequestType = "room_bound_consume"
+	apiRoomVolumeBoundState   ApiRequestType = "room_volume_bound_state"
+	apiRoomVolumeBoundPrepare ApiRequestType = "room_volume_bound_prepare"
+)
+
+func roomBoundRequest(r *http.Request) bool { return strings.Contains(r.URL.Path, "/bound-") }
+func boundSchema(schema string, bound bool) string {
+	if bound {
+		return strings.TrimSuffix(schema, ".v1") + ".v2"
+	}
+	return schema
+}
+func nativeOwnerASCII(value string, limit int) bool {
+	if len(value) == 0 || len(value) > limit {
+		return false
+	}
+	for _, c := range []byte(value) {
+		if c < 0x20 || c > 0x7e || c == '"' || c == '\\' {
+			return false
+		}
+	}
+	return true
+}
+func nativeBoundOwnerValid(owner roomTransportIdentity) bool {
+	if owner.AliasRevision >= 1<<53 || !nativeOwnerASCII(owner.AccountUserID, 160) {
+		return false
+	}
+	for _, s := range []string{owner.TargetID, owner.RoomID, owner.HomePodID, owner.ConnectionID, owner.SessionID, owner.AliasIncarnation, owner.AliasRegistry} {
+		if !nativeOwnerASCII(s, 255) {
+			return false
+		}
+	}
+	return volumeCounter(owner.HomePodID) && owner.HomePodID != "0" && volumeHex32.MatchString(owner.AliasIncarnation) && volumeHex64.MatchString(owner.AliasRegistry)
+}
+func (p *AppPlayer) nextNativeIntent() (string, error) {
+	p.aliasMu.Lock()
+	defer p.aliasMu.Unlock()
+	if p.roomNativeIntent == ^uint64(0) {
+		return "", ErrAliasConflict
+	}
+	p.roomNativeIntent++
+	return strconv.FormatUint(p.roomNativeIntent, 10), nil
+}
+func (p *AppPlayer) boundIntentCurrentLocked(offer *nativeTransportOffer) bool {
+	return !offer.Bound || (offer.NativeRevision != "" && offer.NativeRevision == strconv.FormatUint(p.roomNativeIntent, 10))
+}
+
+// The v2 envelope is decoded separately so the frozen v1 closed schemas remain
+// closed. The actual owner/revision comes only from the consumed native offer.
+func boundOwnerPayload(base any, owner roomTransportIdentity, revision string) any {
+	raw, _ := json.Marshal(base)
+	var fields map[string]any
+	_ = json.Unmarshal(raw, &fields)
+	fields["native_owner"] = owner
+	fields["native_revision"] = revision
+	return fields
+}
+func decodeBoundOwner(raw []byte, base any, owner roomTransportIdentity, revision string) error {
+	var fields map[string]json.RawMessage
+	if strictVolumeJSON(raw, &fields) != nil {
+		return ErrAliasConflict
+	}
+	var got roomTransportIdentity
+	var gotRevision string
+	if strictVolumeJSON(fields["native_owner"], &got) != nil || json.Unmarshal(fields["native_revision"], &gotRevision) != nil || got != owner || gotRevision != revision || !nativeBoundOwnerValid(got) || !volumeCounter(gotRevision) || gotRevision == "0" {
+		return ErrAliasConflict
+	}
+	delete(fields, "native_owner")
+	delete(fields, "native_revision")
+	remaining, _ := json.Marshal(fields)
+	return strictVolumeJSON(remaining, base)
+}
+func roomBoundHTTP(ctx context.Context, method, endpoint string, payload any, out any, owner roomTransportIdentity, revision string) error {
+	// Use the same fixed local-only client and bounded body, retaining exact bytes
+	// for envelope validation before a receipt can signal native retirement.
+	var raw boundReceiptBytes
+	if err := roomVolumeHTTP(ctx, method, endpoint, payload, &raw); err != nil {
+		return err
+	}
+	if err := decodeBoundOwner(raw.Raw, out, owner, revision); err != nil {
+		return errors.New("bound owner receipt mismatch")
+	}
+	return nil
+}
+
+type boundReceiptBytes struct {
+	Raw []byte `json:"-"`
+}
+
+func (raw *boundReceiptBytes) UnmarshalJSON(data []byte) error {
+	raw.Raw = append(raw.Raw[:0], data...)
+	return nil
+}
