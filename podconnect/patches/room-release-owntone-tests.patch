+static void
+manual_release_strict_wire(void)
+{
+  struct output_transport_result r = { 0 };
+  struct output_transport_request *c = &r.command;
+  struct httpd_request h = { 0 };
+  json_object *body = json_object_new_object(), *reply;
+  char *raw;
+  h.in_body = evbuffer_new();
+  h.out_body = evbuffer_new();
+  h.path_parts[2] = "1";
+  h.path_parts[4] = "bound-prepare";
+  c->native_owner = burst_owner();
+  c->native_revision = 1;
+  memset(c->native_prepare_id, 'a', 32);
+  memset(c->args_digest, 'b', 64);
+  c->writer.native_process.pid = getpid();
+  assert(start_boot_id(c->writer.native_process.boot_id));
+  assert(start_process_ticks(getpid(), &c->writer.native_process.proc_start_ticks) == 1);
+  c->writer.open_generation = 1;
+  memset(c->writer.input_path_digest, 'c', 64);
+  c->writer.pipe_device = 1;
+  c->writer.pipe_inode = 2;
+  json_object_object_add(body, "native_prepare_id", json_object_new_string(c->native_prepare_id));
+  json_object_object_add(body, "args_digest", json_object_new_string(c->args_digest));
+  json_object_object_add(body, "action", json_object_new_string("release"));
+  transport_native_binding_json(body, &c->native_owner, c->native_revision);
+  json_object_object_add(body, "purpose", json_object_new_string("manual_release_v1"));
+  json_object_object_add(body, "writer_proof", queue_writer_json(&c->writer));
+  raw = strdup(json_object_to_json_string_ext(body, JSON_C_TO_STRING_PLAIN));
+  assert(raw);
+  evbuffer_add(h.in_body, raw, strlen(raw));
+  assert(jsonapi_reply_transport_write(&h)
+         == 409); /* Valid ordinary source_epoch0/fd0 reaches owner, inert input denies. */
+  evbuffer_drain(h.in_body, evbuffer_get_length(h.in_body));
+  evbuffer_add_printf(h.in_body, "%s{}", raw);
+  assert(jsonapi_reply_transport_write(&h) == HTTP_BADREQUEST);
+  json_object_object_add(body, "purpose", json_object_new_string("queue_occurrence_v1"));
+  evbuffer_drain(h.in_body, evbuffer_get_length(h.in_body));
+  evbuffer_add_printf(h.in_body, "%s", json_object_to_json_string_ext(body, JSON_C_TO_STRING_PLAIN));
+  assert(jsonapi_reply_transport_write(&h) == HTTP_BADREQUEST);
+  json_object_put(body);
+  free(raw);
+  body = json_object_new_object();
+  json_object_object_add(body, "token", json_object_new_string("aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"));
+  json_object_object_add(body, "native_prepare_id", json_object_new_string(c->native_prepare_id));
+  attention_json_u64(body, "native_revision", 1);
+  json_object_object_add(body, "native_close_done", json_object_new_boolean(false));
+  evbuffer_drain(h.in_body, evbuffer_get_length(h.in_body));
+  evbuffer_add_printf(h.in_body, "%s", json_object_to_json_string_ext(body, JSON_C_TO_STRING_PLAIN));
+  assert(jsonapi_reply_transport_release_confirm(&h) == HTTP_BADREQUEST);
+  json_object_object_add(body, "native_close_done", json_object_new_boolean(true));
+  evbuffer_drain(h.in_body, evbuffer_get_length(h.in_body));
+  evbuffer_add_printf(h.in_body, "%s", json_object_to_json_string_ext(body, JSON_C_TO_STRING_PLAIN));
+  assert(jsonapi_reply_transport_release_confirm(&h) == 409);
+  json_object_object_add(body, "writer_proof", queue_writer_json(&c->writer));
+  evbuffer_drain(h.in_body, evbuffer_get_length(h.in_body));
+  evbuffer_add_printf(h.in_body, "%s", json_object_to_json_string_ext(body, JSON_C_TO_STRING_PLAIN));
+  assert(jsonapi_reply_transport_release_confirm(&h) == HTTP_BADREQUEST);
+  json_object_put(body);
+  reply = transport_release_json(&r, false, true);
+  assert(json_object_object_length(reply) == 16);
+  json_object_put(reply);
+  reply = transport_release_json(&r, true, true);
+  assert(json_object_object_length(reply) == 15);
+  json_object_put(reply);
+  evbuffer_free(h.in_body);
+  evbuffer_free(h.out_body);
+  puts("PASS manual release strict prepare7/commit9 and confirm4; source_epoch0/fd0 valid, "
+       "wrongpurpose/trailing/CloseDonefalse/proofreplay denied; typedACK16/result15");
+}
