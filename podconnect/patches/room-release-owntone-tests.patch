+/* AP2 leaves the 12-byte RTP header clear even though its audio payload is
+ * encrypted. Sync/control share this fixture's UDP port but use other types. */
+static bool native_start_audio_rtp(const unsigned char *packet,ssize_t length)
+{
+  return length>12 && (packet[0]>>6)==2 && (packet[1]&0x7f)==AIRPLAY_RTP_PAYLOADTYPE;
+}
+static void native_start_audio_poll(struct native_start_wire *wire)
+{
+  struct recovery_wire_fixture *f=wire->fixture;
+  unsigned char packet[4096];ssize_t length;
+  while((length=recv(f->udp_fd,packet,sizeof(packet),MSG_DONTWAIT))>0){
+    if(!native_start_audio_rtp(packet,length))continue;
+    if(!atomic_load(&wire->completed) || f->volumes<1 || outputs_start_gate_closed() || !start_active
+        || start_active->result.phase!=OUTPUT_START_COMPLETED){
+      recovery_wire_fail(f,"audio RTP crossed closed START gate");return;
+    }
+    struct airplay_session *session=f->device ? f->device->session : NULL;
+    struct airplay_master_session *master=session ? session->master_session : NULL;
+    uint16_t seq;uint32_t timestamp;size_t payload_len;
+    uint8_t nonce[12]={0},decoded[4096];gcry_cipher_hd_t cipher;
+    struct rtp_packet *source;
+    if(!session || !session->supports_encryption || !master || !master->rtp_session || length<36){
+      recovery_wire_fail(f,"audio RTP lacks negotiated encrypted session");return;
+    }
+    memcpy(&seq,packet+2,sizeof(seq));seq=ntohs(seq);
+    memcpy(&timestamp,packet+4,sizeof(timestamp));timestamp=ntohl(timestamp);
+    if(wire->decoded_audio_packet && (uint16_t)(seq-wire->last_audio_seq)!=1){
+      recovery_wire_fail(f,"audio RTP sequence did not advance by one");return;
+    }
+    if(wire->decoded_audio_packet && timestamp<=wire->last_audio_timestamp){
+      recovery_wire_fail(f,"audio RTP timestamp did not advance");return;
+    }
+    payload_len=(size_t)length-12-16-8;
+    source=rtp_packet_get(master->rtp_session,seq);
+    if(!source || source->payload_len!=payload_len || source->header[0]!=packet[0]
+        || (source->header[1]&0x7f)!=(packet[1]&0x7f) || memcmp(source->header+2,packet+2,10)){
+      recovery_wire_fail(f,"audio RTP has no matching encoded packet");return;
+    }
+    memcpy(nonce+4,packet+length-8,8);
+    cipher=chacha_open(session->shared_secret,AIRPLAY_AUDIO_KEY_LEN);
+    if(!cipher || gcry_cipher_setiv(cipher,nonce,sizeof(nonce))
+        || gcry_cipher_authenticate(cipher,packet+4,8)
+        || gcry_cipher_decrypt(cipher,decoded,payload_len,packet+12,payload_len)
+        || gcry_cipher_checktag(cipher,packet+length-8-16,16)
+        || memcmp(decoded,source->payload,payload_len)){
+      chacha_close(cipher);recovery_wire_fail(f,"audio RTP authentication/decode failed");return;
+    }
+    chacha_close(cipher);
+    for(size_t i=0;i<master->rawbuf_size;i++)
+      if(master->rawbuf[i]){wire->nonzero_pcm_input=true;break;}
+    wire->decoded_audio_packet=true;wire->last_audio_seq=seq;wire->last_audio_timestamp=timestamp;
+    atomic_fetch_add(&wire->audio_packets,1);
+  }
+  if(length<0 && errno!=EAGAIN && errno!=EWOULDBLOCK)
+    recovery_wire_fail(f,"private RTP receive failed");
+}
