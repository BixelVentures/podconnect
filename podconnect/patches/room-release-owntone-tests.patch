+  c->writer.writer_fd = 3;
+  c->writer.source_epoch = 1;
+  c->writer.open_generation = 1;
+  memset(c->writer.input_path_digest, 'b', 64);
+  c->writer.input_path_digest[64] = 0;
+  c->writer.pipe_device = 1;
+  c->writer.pipe_inode = 2;
+  strcpy(r.result.identity.process, outputs_process);
+  strcpy(r.result.identity.input_path_digest, c->writer.input_path_digest);
+  r.result.identity.device_id = 1;
+  r.result.identity.device_incarnation = 1;
+  r.result.identity.session_epoch = 1;
+  r.result.identity.route_revision = 1;
+  r.result.identity.selection_revision = 1;
+  r.result.identity.input_generation = 1;
+  r.result.identity.input_item_id = 1;
+  strcpy(r.input_path, "/tmp/ordinary-native-fifo");
+  r.admitted_epoch = 9;
+  r.retirement = OUTPUT_RETIRE_PENDING;
+  assert(start_pid_namespace(&r.pidns_device, &r.pidns_inode));
+  o = release_journal_json(&r);
+  serialized = json_object_to_json_string_ext(o, JSON_C_TO_STRING_PLAIN);
+  strcpy(next.token, c->token);
+  strcpy(next.c_process, outputs_process);
+  strcpy(next.boot_id, c->writer.native_process.boot_id);
+  next.pid = getpid();
+  next.proc_start_ticks = c->writer.native_process.proc_start_ticks;
+  next.payload = (char *)serialized;
+  assert(db_start_guard_save(&saved, &next) == 0);
+  start_journal_startup();
+  assert(!start_journal_fault && start_startup_quarantine && outputs_start_gate_closed());
+  assert(start_journal_retirement_outcome == OUTPUT_RETIRE_PENDING && !start_route_clean_absent());
+  assert(!start_journal_payload_legacy_valid()); /* Actual prior parser body, no compatibility fiction. */
+  {
+    char *saved = start_journal.payload;
+    json_object *missing = json_tokener_parse(saved);
+    json_object_object_del(missing, "admitted_input_epoch");
+    start_journal.payload = strdup(json_object_to_json_string_ext(missing, JSON_C_TO_STRING_PLAIN));
+    assert(start_journal.payload && !start_journal_payload_valid());
+    free(start_journal.payload);
+    json_object_put(missing);
+    start_journal.payload = saved;
+    assert(start_journal_payload_valid());
+    struct transport_release_record zero = r;
+    zero.admitted_epoch = 0;
+    json_object *present = release_journal_json(&zero);
+    start_journal.payload = strdup(json_object_to_json_string_ext(present, JSON_C_TO_STRING_PLAIN));
+    assert(start_journal.payload && start_journal_payload_valid() && release_record.admitted_epoch == 0);
+    free(start_journal.payload);
+    json_object_put(present);
+    start_journal.payload = saved;
+    assert(start_journal_payload_valid());
+  }
+  json_object_object_add(o, "retirement_outcome", json_object_new_string("retired_known"));
+  json_object_object_add(o, "retired_input_epoch", json_object_new_uint64(10));
+  json_object_object_add(o, "retired_c_process", json_object_new_string(outputs_process));
+  serialized = json_object_to_json_string_ext(o, JSON_C_TO_STRING_PLAIN);
+  next.payload = (char *)serialized;
+  assert(db_start_guard_save(&start_journal, &next) == 0);
+  start_journal_startup();
+  assert(
+      !start_journal_fault && !start_startup_quarantine && start_retired_reopen_pending && outputs_start_gate_closed());
+  assert(!start_journal_payload_legacy_valid()); /* Terminal still requires forward recovery. */
+  old_payload = start_journal.payload;
+  start_journal.payload = strdup(old_payload);
+  assert(start_journal.payload);
+  v = json_object_new_int(1);
+  json_object_object_add(o, "unrecognized", v);
+  free(start_journal.payload);
+  start_journal.payload = strdup(json_object_to_json_string_ext(o, JSON_C_TO_STRING_PLAIN));
+  assert(!start_journal_payload_valid());
+  free(start_journal.payload);
+  start_journal.payload = old_payload;
+  assert(db_start_guard_save(&start_journal, &saved) == 0);
+  start_journal_startup();
+  start_journal_fault = old_fault;
+  free(saved.payload);
+  json_object_put(o);
+  puts("PASS manual release typed journal pending/terminal survive startup; actual legacy parser rejects both; unknown "
+       "fields reject; no START token fabricated");
+}
