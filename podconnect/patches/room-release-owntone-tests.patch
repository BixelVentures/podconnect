+/* Actual pipe backend, named FIFOs and its existing event-loop command queue.
+ * A DB id and path may be reused; the old stop must not destroy the new watch.
+ * A real metadata read callback must run before final cleanup on that owner. */
+static int metadata_pipe_owner_case(void)
+{
+  char directory[]="/tmp/pipe-metadata-owner-XXXXXX";
+  char audio[PATH_MAX], metadata[PATH_MAX];
+  struct input_source old={.id=7}, next={.id=7};
+  uint64_t first=0, successor=0, seen=0, reads=0, before=0;
+  uint32_t id=0; bool watching=false;
+  int writer=-1, result=1;
+  if(!mkdtemp(directory))return 1;
+  snprintf(audio,sizeof(audio),"%s/audio",directory);
+  snprintf(metadata,sizeof(metadata),"%s/audio.metadata",directory);
+  if(mkfifo(audio,0600)<0 || mkfifo(metadata,0600)<0)goto done;
+  writer=open(metadata,O_RDWR|O_NONBLOCK);
+  if(writer<0 || evthread_use_pthreads()<0)goto done;
+  cfg=cfg_init(toplvl_cfg,CFGF_NONE);
+  if(!cfg)goto done;
+  cfg_setbool(cfg_getsec(cfg,"library"),"pipe_autostart",false);
+  if(input_pipe.init()<0)goto done;
+  old.path=audio;next.path=audio;
+  if(input_pipe.setup(&old)<0)goto deinit;
+  if(pipe_metadata_test_snapshot(&first,&id,&watching,&reads)<0 || !watching || !first || id!=7)goto deinit;
+  if(input_pipe.setup(&next)<0)goto deinit;
+  if(pipe_metadata_test_snapshot(&successor,&id,&watching,&reads)<0 || !watching || successor<=first || id!=7)goto deinit;
+  if(input_pipe.stop(&old)<0)goto deinit;
+  if(pipe_metadata_test_snapshot(&seen,&id,&watching,&reads)<0 || !watching || seen!=successor || id!=7)goto deinit;
+  before=reads;
+  if(write(writer,"x",1)!=1)goto deinit;
+  for(int i=0;i<100;i++){
+    if(pipe_metadata_test_snapshot(&seen,&id,&watching,&reads)<0)goto deinit;
+    if(reads>before)break;
+    usleep(10000);
+  }
+  if(reads<=before || !watching || seen!=successor)goto deinit;
+  if(input_pipe.stop(&next)<0)goto deinit;
+  if(pipe_metadata_test_snapshot(&seen,&id,&watching,&reads)<0 || watching || seen)goto deinit;
+  result=0;
+ deinit:
+  if(old.input_ctx)input_pipe.stop(&old);
+  if(next.input_ctx)input_pipe.stop(&next);
+  input_pipe.deinit();
+ done:
+  if(cfg){cfg_free(cfg);cfg=NULL;}
+  if(writer>=0)close(writer);
+  unlink(metadata);unlink(audio);rmdir(directory);
+  return result;
+}
 
