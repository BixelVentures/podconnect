+func TestDealerTransferAcceptsGidAndRetainsUriPrecedence(t *testing.T) {
+	for _, tc := range []struct {
+		name  string
+		track *connectpb.ContextTrack
+	}{
+		{"sixteen-byte GID", &connectpb.ContextTrack{Gid: make([]byte, 16)}},
+		{"URI takes precedence over malformed GID", &connectpb.ContextTrack{Uri: "invalid-pc13-post-commit", Gid: []byte{1}}},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			state := pc13TransferState()
+			state.Playback.CurrentTrack = tc.track
+			state.CurrentSession.Context.Pages = []*connectpb.ContextPage{{Tracks: []*connectpb.ContextTrack{{Uri: "invalid-pc13-post-commit"}}}}
+			data, err := proto.Marshal(state)
+			if err != nil {
+				t.Fatal(err)
+			}
+			p := pc13ExistingPlayer(t, false)
+			// Genuine zero-value Session supplies only its nil Spclient getter.
+			// Complete context pages avoid provider I/O; invalid media URI ends before stream I/O.
+			p.sess = &session.Session{}
+			req := pc13PlayRequest(t)
+			req.Command.Endpoint, req.Command.Data = "transfer", data
+			err = p.handlePlayerCommand(context.Background(), req)
+			if err == nil || !strings.Contains(err.Error(), "failed parsing uri: invalid uri: invalid-pc13-post-commit") {
+				t.Fatalf("expected preparation accepted then deliberate media boundary: %v", err)
+			}
+			if p.state.lastTransferTimestamp != 789 || p.state.player.SessionId != "transfer-session" || len(p.app.server.(*aliasTestServer).events) != 0 {
+				t.Fatal("valid identity did not reach original transfer commit without claiming playback")
+			}
+		})
+	}
+}
