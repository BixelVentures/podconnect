+func (p *AppPlayer) commitPlayerCommand(req dealer.RequestPayload) {
+	p.state.lastCommand = &req
+
+	// device-aliases: when the controller picks a room, the selected alias arrives as target_alias_id at
+	// the dealer payload TOP level (not in command/options). Echo it on the next put_state, and push it
+	// over /events so the manager routes the output immediately (the /status backstop carries it too).
+	if len(p.app.cfg.DeviceAliases) > 0 {
+		aliasId := req.TargetAliasId
+		if aliasId == nil {
+			aliasId = req.Command.TargetAliasId // tolerate other controllers
+		}
+		if aliasId != nil {
+			// Web API commands target the engine and carry alias 0. Keep the
+			// selected room instead of publishing an unnamed active device.
+			resolved := resolveDeviceAlias(p.state.device.SelectedAliasId, *aliasId, len(p.app.cfg.DeviceAliases))
+			aliasId = &resolved
+			name := ""
+			if int(*aliasId) >= 1 && int(*aliasId) <= len(p.app.cfg.DeviceAliases) {
+				name = p.app.cfg.DeviceAliases[*aliasId-1]
+			}
+			p.app.log.Infof("device-alias selected: id=%d name=%q", *aliasId, name)
+			p.state.device.SelectedAliasId = *aliasId
+			p.emitSelectedAlias(*aliasId, p.aliasBinding())
+		}
+	}
+}
