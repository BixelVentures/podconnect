+type pc13RoundTrip func(*http.Request) (*http.Response, error)
+
+func (f pc13RoundTrip) RoundTrip(r *http.Request) (*http.Response, error) { return f(r) }
+
+type pc13Body struct {
+	io.Reader
+	closes int
+}
+
+func (b *pc13Body) Close() error { b.closes++; return nil }
+
+const pc13ContextURI = "spotify:playlist:0000000000000000000001"
+
+func pc13Spclient(t *testing.T, transport http.RoundTripper) *spclient.Spclient {
+	t.Helper()
+	sp, err := spclient.NewSpclient(context.Background(), &librespot.NullLogger{}, &http.Client{Transport: transport}, func(context.Context) string { return "pc13.invalid" }, func(context.Context, bool) (string, error) { return "fixture-access-token", nil }, "fixture-device", "fixture-client-token")
+	if err != nil {
+		t.Fatal(err)
+	}
+	return sp
+}
