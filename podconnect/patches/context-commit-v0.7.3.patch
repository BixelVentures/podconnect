+func TestDealerIncompleteTransferRejectsBeforeAnyStateOrAliasMutation(t *testing.T) {
+	for _, missing := range []string{"unknown-only", "playback", "current-track", "current-track-identity", "invalid-gid", "oversized-gid", "queue-empty-track", "queue-nil-track", "queue-invalid-gid", "queue-oversized-gid", "context-empty-track", "context-nil-track", "context-invalid-gid", "context-oversized-gid", "context-uri-invalid-gid", "context-uri-oversized-gid", "session", "context", "origin", "options", "queue", "malformed-wire"} {
+		t.Run(missing, func(t *testing.T) {
+			state := pc13TransferState()
+			switch missing {
+			case "playback":
+				state.Playback = nil
+			case "current-track":
+				state.Playback.CurrentTrack = nil
+			case "current-track-identity":
+				state.Playback.CurrentTrack = &connectpb.ContextTrack{}
+			case "invalid-gid":
+				state.Playback.CurrentTrack = &connectpb.ContextTrack{Gid: []byte{1}}
+			case "oversized-gid":
+				state.Playback.CurrentTrack = &connectpb.ContextTrack{Gid: make([]byte, 17)}
+			case "queue-empty-track":
+				state.Queue.Tracks = []*connectpb.ContextTrack{{}}
+			case "queue-nil-track":
+				// Protobuf encodes a nil repeated message as an empty track.
+				state.Queue.Tracks = []*connectpb.ContextTrack{nil}
+			case "queue-invalid-gid":
+				state.Queue.Tracks = []*connectpb.ContextTrack{{Gid: []byte{1}}}
+			case "queue-oversized-gid":
+				state.Queue.Tracks = []*connectpb.ContextTrack{{Gid: make([]byte, 17)}}
+			case "context-empty-track", "context-nil-track", "context-invalid-gid", "context-oversized-gid", "context-uri-invalid-gid", "context-uri-oversized-gid":
+				track := &connectpb.ContextTrack{}
+				switch missing {
+				case "context-nil-track":
+					track = nil // Decodes as an empty track, as for the queue above.
+				case "context-invalid-gid":
+					track.Gid = []byte{1}
+				case "context-oversized-gid":
+					track.Gid = make([]byte, 17)
+				case "context-uri-invalid-gid":
+					track.Uri, track.Gid = "nonmatching-uri", []byte{1}
+				case "context-uri-oversized-gid":
+					track.Uri, track.Gid = "nonmatching-uri", make([]byte, 17)
+				}
+				state.CurrentSession.Context.Pages = []*connectpb.ContextPage{{Tracks: []*connectpb.ContextTrack{track}}}
+			case "session":
+				state.CurrentSession = nil
+			case "context":
+				state.CurrentSession.Context = nil
+			case "origin":
+				state.CurrentSession.PlayOrigin = nil
+			case "options":
+				state.Options = nil
+			case "queue":
+				state.Queue = nil
+			}
+			data, err := proto.Marshal(state)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if missing == "unknown-only" {
+				data = []byte{0xf8, 0x07, 0x01}
+			}
+			if missing == "malformed-wire" {
+				data = []byte{0x12, 0xff}
+			}
+			p := pc13ExistingPlayer(t, true)
+			p.app.cfg.DeviceAliases = []string{"Room A", "Room B"}
+			previousCommand := &dealer.RequestPayload{}
+			p.state.lastCommand = previousCommand
+			before := proto.Clone(p.state.player)
+			oldTracks, oldSince := p.state.tracks, p.state.activeSince
+			req := pc13PlayRequest(t)
+			req.Command.Endpoint = "transfer"
+			req.Command.Data = data
+			req.TargetAliasId = proto.Uint32(1)
+			// No Session is constructed: entering any provider path fails this test.
+			if err := p.handlePlayerCommand(context.Background(), req); err == nil {
+				t.Fatal("incomplete transfer was accepted")
+			}
+			if !proto.Equal(before, p.state.player) || !p.state.active || !p.state.activeSince.Equal(oldSince) || p.state.tracks != oldTracks || p.state.lastTransferTimestamp != 123 || p.state.queueID != 7 || p.state.lastCommand != previousCommand || p.state.device.SelectedAliasId != 2 {
+				t.Fatal("invalid transfer changed retained playback/command/alias ownership")
+			}
+			if len(p.app.server.(*aliasTestServer).events) != 0 {
+				t.Fatal("invalid transfer emitted an alias or playback event")
+			}
+		})
+	}
+}
