+func TestDealerIncompleteTransferRejectsBeforeAnyStateOrAliasMutation(t *testing.T) {
+	for _, missing := range []string{"unknown-only", "playback", "current-track", "current-track-identity", "invalid-gid", "oversized-gid", "queue-empty-track", "queue-nil-track", "queue-invalid-gid", "queue-oversized-gid", "context-empty-track", "context-nil-track", "context-invalid-gid", "context-oversized-gid", "context-uri-invalid-gid", "context-uri-oversized-gid", "session", "context", "origin", "options", "queue", "malformed-wire"} {
+		t.Run(missing, func(t *testing.T) {
