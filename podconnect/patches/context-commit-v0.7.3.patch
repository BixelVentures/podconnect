+func TestDealerTransferContext404PreservesCurrencyThenFreshPreparationCommits(t *testing.T) {
+	p := pc13ExistingPlayer(t, true)
+	p.primaryStream, p.secondaryStream = &player.Stream{}, &player.Stream{}
+	oldTracks, oldPrimary, oldSecondary, oldSince := p.state.tracks, p.primaryStream, p.secondaryStream, p.state.activeSince
+	before := proto.Clone(p.state.player)
+	state := pc13TransferState()
+	req := pc13PlayRequest(t)
+	req.Command.Endpoint = "transfer"
+	requests := 0
+	var bodies []*pc13Body
+	sp := pc13Spclient(t, pc13RoundTrip(func(r *http.Request) (*http.Response, error) {
+		requests++
+		if requests > 2 || r.Method != http.MethodGet || r.URL.Host != "pc13.invalid" || r.URL.Path != "/context-resolve/v1/"+pc13ContextURI {
+			return nil, fmt.Errorf("unexpected request: %s %s", r.Method, r.URL)
+		}
+		status, payload := http.StatusNotFound, "not found"
+		if requests == 2 {
+			status = http.StatusOK
+			data, err := json.Marshal(&connectpb.Context{Uri: pc13ContextURI, Pages: []*connectpb.ContextPage{{Tracks: []*connectpb.ContextTrack{{Uri: "invalid-pc13-post-commit", Metadata: map[string]string{}}}}}})
+			if err != nil {
+				return nil, err
+			}
+			payload = string(data)
+		}
+		body := &pc13Body{Reader: strings.NewReader(payload)}
+		bodies = append(bodies, body)
+		return &http.Response{StatusCode: status, Header: make(http.Header), Body: body, Request: r}, nil
+	}))
+	if err := p.handleTransferCommand(context.Background(), req, state, sp); err == nil || !strings.Contains(err.Error(), "context resolve: 404") {
+		t.Fatalf("rejected preparation=%v", err)
+	}
+	if !proto.Equal(before, p.state.player) || !p.state.active || !p.state.activeSince.Equal(oldSince) || p.state.lastTransferTimestamp != 123 || p.state.queueID != 7 || p.state.tracks != oldTracks || p.primaryStream != oldPrimary || p.secondaryStream != oldSecondary || p.state.device.SelectedAliasId != 2 || len(p.app.server.(*aliasTestServer).events) != 0 {
+		t.Fatal("failed transfer preparation changed accepted playback/currency")
+	}
+	if requests != 1 || bodies[0].closes != 1 {
+		t.Fatal("failed preparation retried or left response open")
+	}
+	// Observe successful preparation separately with no live streams: real media
+	// unloading/continuity requires Session/player I/O and is not proved here.
+	p.primaryStream, p.secondaryStream = nil, nil
+	// A subsequent explicit request, not a retry, reaches the same existing commit.
+	err := p.handleTransferCommand(context.Background(), req, state, sp)
+	if err == nil || !strings.Contains(err.Error(), "failed parsing uri: invalid uri: invalid-pc13-post-commit") {
+		t.Fatalf("expected deliberate post-commit media boundary: %v", err)
+	}
+	if requests != 2 || len(bodies) != 2 || bodies[1].closes != 1 || p.state.lastTransferTimestamp != 789 || p.state.tracks == oldTracks || p.state.player.SessionId != "transfer-session" {
+		t.Fatal("successful preparation did not retain transfer currency/commit")
+	}
+	if len(p.app.server.(*aliasTestServer).events) != 0 {
+		t.Fatal("deliberate media failure emitted playback success")
+	}
+}
