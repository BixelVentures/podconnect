+func TestDealerPlayContext404PreservesPreviousState(t *testing.T) {
+	for _, active := range []bool{false, true} {
+		t.Run(fmt.Sprintf("active_%t", active), func(t *testing.T) {
+			p := pc13ExistingPlayer(t, active)
+			p.primaryStream = &player.Stream{}
+			p.secondaryStream = &player.Stream{}
+			before := proto.Clone(p.state.player).(*connectpb.PlayerState)
+			oldTracks, oldPrimary, oldSecondary := p.state.tracks, p.primaryStream, p.secondaryStream
+			oldSince := p.state.activeSince
+			body := &pc13Body{Reader: strings.NewReader("not found")}
+			requests := 0
+			sp := pc13Spclient(t, pc13RoundTrip(func(r *http.Request) (*http.Response, error) {
+				requests++
+				if r.Method != http.MethodGet || r.URL.Host != "pc13.invalid" || r.URL.Path != "/context-resolve/v1/"+pc13ContextURI {
+					return nil, fmt.Errorf("unexpected fixture request: %s %s", r.Method, r.URL)
+				}
+				return &http.Response{StatusCode: http.StatusNotFound, Header: make(http.Header), Body: body, Request: r}, nil
+			}))
+			err := p.handlePlayCommand(context.Background(), pc13PlayRequest(t), sp)
+			if err == nil || !strings.Contains(err.Error(), "invalid status code from context resolve: 404") {
+				t.Fatalf("resolution error=%v", err)
+			}
+			if requests != 1 || body.closes != 1 {
+				t.Fatalf("requests=%d closes=%d", requests, body.closes)
+			}
+			if !proto.Equal(before, p.state.player) {
+				t.Fatal("rejected context mutated previous player state")
+			}
+			if p.state.active != active || !p.state.activeSince.Equal(oldSince) || p.state.tracks != oldTracks || p.primaryStream != oldPrimary || p.secondaryStream != oldSecondary || p.state.queueID != 7 || p.state.lastTransferTimestamp != 123 || p.state.device.SelectedAliasId != 2 {
+				t.Fatal("rejected context changed existing playback ownership")
+			}
+			if len(p.app.server.(*aliasTestServer).events) != 0 {
+				t.Fatal("rejected context emitted a playback event")
+			}
+		})
+	}
+}
