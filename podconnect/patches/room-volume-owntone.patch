@@ -0,0 +1,79 @@
+/* Separate physical-volume purpose, sharing only native RTSP mechanics. */
+static void room_volume_request_remove(struct airplay_room_volume_request *c)
+{
+  struct airplay_room_volume_request **p=&c->session->room_volume_requests;
+  while (*p && *p!=c) p=&(*p)->next;
+  if (*p) *p=c->next;
+}
+static int room_volume_session_current(struct airplay_room_volume_request *c)
+{
+  struct output_device *d=outputs_device_get(c->operation.identity.device_id);
+  return d && d->session==c->session && !c->session->attention_retiring
+    && d->incarnation==c->operation.identity.device_incarnation
+    && d->session_epoch==c->operation.identity.session_epoch;
+}
+static int room_volume_dispatch_guard(void *arg)
+{
+  struct airplay_room_volume_request *c=arg;
+  bool current=room_volume_session_current(c) && outputs_room_volume_dispatch_current(c->operation.command.token);
+  if (!current) c->guard_rejected=true;
+  return current;
+}
+static int room_volume_write_guard(void *arg)
+{
+  struct airplay_room_volume_request *c=arg;
+  c->write_guard_seen=true;
+  bool current=room_volume_session_current(c) && outputs_room_volume_before_write(c->operation.command.token);
+  if (!current) c->guard_rejected=true;
+  return current;
+}
+static void room_volume_response(struct evrtsp_request *request,void *arg)
+{
+  struct airplay_room_volume_request *c=arg;
+  struct airplay_session *session=c->session;
+  const char *header=request ? evrtsp_find_header(request->input_headers,"CSeq") : NULL;
+  int cseq=0;
+  bool accepted=request && request->response_code==RTSP_OK && header
+    && safe_atoi32(header,&cseq)==0 && cseq==c->cseq && room_volume_session_current(c);
+  bool retire=(!request || c->guard_rejected) && (c->write_guard_seen || !c->guard_rejected);
+  room_volume_request_remove(c);
+  session->reqs_in_flight--;
+  if (!session->reqs_in_flight) evrtsp_connection_set_closecb(session->ctrl,rtsp_close_cb,session);
+  outputs_room_volume_complete(c->operation.command.token,accepted);
+  free(c);
+  /* Ciphered/partial output may not be reused after a veto. Exact old session
+   * destruction drains its connection/requests; the global route pin survives. */
+  if (retire) session_cleanup(session);
+}
+static int airplay_room_volume(struct output_device *device,const struct output_room_volume_result *operation)
+{
+  struct airplay_session *session=device->session;
+  struct airplay_room_volume_request *c;
+  struct evrtsp_request *request;
+  int effective=operation->command.percent;
+  float mapped;
+  char volume[32];
+  if (!session || !(session->state&AIRPLAY_STATE_F_CONNECTED) || session->attention_retiring
+      || session->recovery_only || !outputs_room_volume_dispatch_current(operation->command.token)) return -1;
+  c=calloc(1,sizeof(*c)); if (!c) return -1;
+  c->session=session; c->operation=*operation; c->cseq=session->cseq;
+  request=evrtsp_request_new(room_volume_response,c);
+  if (!request) { free(c); return -1; }
+  if (request_headers_add(request,session,EVRTSP_REQ_SET_PARAMETER)<0) goto error;
+  if (device->attention_lease && !device->attention_restoring && effective>device->attention_cap) effective=device->attention_cap;
+  mapped=airplay_volume_from_pct(effective,session->devname);
+  snprintf(volume,sizeof(volume),"-%d.%06d",-(int)mapped,-(int)(1000000.0*(mapped-(int)mapped)));
+  evrtsp_add_header(request->output_headers,"Content-Type","text/parameters");
+  if (evbuffer_add_printf(request->output_buffer,"volume: %s\r\n",volume)<0) goto error;
+  request->write_current=room_volume_write_guard; request->write_current_arg=c;
+  c->next=session->room_volume_requests; session->room_volume_requests=c;
+  session->reqs_in_flight++; evrtsp_connection_set_closecb(session->ctrl,NULL,NULL);
+  if (evrtsp_make_request_guarded(session->ctrl,request,EVRTSP_REQ_SET_PARAMETER,session->session_url,room_volume_dispatch_guard,c)<0) {
+    room_volume_request_remove(c); session->reqs_in_flight--;
+    if (!session->reqs_in_flight) evrtsp_connection_set_closecb(session->ctrl,rtsp_close_cb,session);
+    goto error;
+  }
+  return 1;
+ error:
+  evrtsp_request_free(request); free(c); return -1;
+}
diff --git a/src/outputs_room_volume.inc.c b/src/outputs_room_volume.inc.c
new file mode 100644
index 0000000..be555c5
--- /dev/null
+++ b/src/outputs_room_volume.inc.c
@@ -0,0 +1,187 @@
+/* Included in outputs.c: the actual output event-loop owner, no HTTP awaits. */
+#define ROOM_VOLUME_SLOTS 64
+struct room_volume_slot {
+  struct output_room_volume_result result;
+  struct timespec deadline;
+  bool used, cancelled;
+};
+static struct room_volume_slot room_volume_slots[ROOM_VOLUME_SLOTS];
+static struct room_volume_slot *room_volume_pin;
+static struct timespec room_volume_pin_expiry;
+
+static bool room_volume_pin_busy(void)
+{
+  if (room_volume_pin && !transport_remaining(&room_volume_pin_expiry)) room_volume_pin=NULL;
+  return room_volume_pin!=NULL;
+}
+static bool room_volume_window_live(const struct room_volume_slot *slot)
+{
+  struct timespec now;
+  return clock_gettime(CLOCK_MONOTONIC,&now)==0 &&
+    (now.tv_sec<slot->deadline.tv_sec || (now.tv_sec==slot->deadline.tv_sec && now.tv_nsec<slot->deadline.tv_nsec));
+}
+static struct room_volume_slot *room_volume_find(const char *token)
+{
+  size_t i;
+  if (!transport_hex(token,32)) return NULL;
+  for (i=0;i<ARRAY_SIZE(room_volume_slots);i++)
+    if (!strcmp(room_volume_slots[i].result.command.token,token)) return &room_volume_slots[i];
+  return NULL;
+}
+static bool room_volume_state_equal(const struct output_room_volume_state *a,const struct output_room_volume_state *b)
+{
+  return a->base_revision==b->base_revision && a->attention_revision==b->attention_revision
+    && a->base_percent==b->base_percent && a->effective_percent==b->effective_percent;
+}
+static int room_volume_snapshot(uint64_t id,struct output_transport_identity *identity,struct output_room_volume_state *state)
+{
+  struct output_device *d=outputs_device_get(id);
+  if (!d || !outputs[d->type]->device_room_volume || transport_identity_get(id,identity)<0
+      || d->base_revision==UINT64_MAX || d->attention_revision==UINT64_MAX) return -1;
+  state->base_revision=d->base_revision; state->attention_revision=d->attention_revision;
+  state->base_percent=d->volume; state->effective_percent=outputs_device_effective_volume(d);
+  return 0;
+}
+int outputs_room_volume_state_get(uint64_t id,struct output_transport_identity *identity,struct output_room_volume_state *state,bool *busy)
+{
+  if (!busy || room_volume_snapshot(id,identity,state)<0) return -1;
+  *busy=outputs_transport_busy(); return 0;
+}
+static void room_volume_observe(struct room_volume_slot *s,struct output_room_volume_result *result)
+{
+  s->result.deadline_retired=!room_volume_window_live(s);
+  if (s->result.deadline_retired && s->result.outcome!=ROOM_VOLUME_PROTOCOL_ACCEPTED
+      && s->result.outcome!=ROOM_VOLUME_REJECTED && s->result.outcome!=ROOM_VOLUME_CANCELLED)
+    s->result.outcome=s->result.possible_effect ? ROOM_VOLUME_UNKNOWN : ROOM_VOLUME_EXPIRED;
+  s->result.pin_remaining_ms=room_volume_pin_busy() && room_volume_pin==s ? transport_remaining(&room_volume_pin_expiry) : 0;
+  *result=s->result;
+}
+static bool room_volume_request_valid(const struct output_room_volume_request *r)
+{
+  return r && r->device_id && transport_hex(r->native_prepare_id,32)
+    && transport_hex(r->args_digest,64) && transport_hex(r->expected_input_path_digest,64)
+    && r->percent>=0 && r->percent<=100;
+}
+int outputs_room_volume_prepare(const struct output_room_volume_request *r,struct output_room_volume_result *out)
+{
+  struct output_transport_identity identity;
+  struct output_room_volume_state state;
+  struct room_volume_slot *slot=NULL;
+  size_t i,j,k=0; char uuid[37];
+  if (!out || !room_volume_request_valid(r) || outputs_transport_busy()
+      || room_volume_snapshot(r->device_id,&identity,&state)<0
+      || !transport_identity_equal(&identity,&r->expected_identity)
+      || !room_volume_state_equal(&state,&r->expected_volume_state)
+      || strcmp(identity.input_path_digest,r->expected_input_path_digest)) return -1;
+  for (i=0;i<ARRAY_SIZE(room_volume_slots);i++) {
+    struct room_volume_slot *s=&room_volume_slots[i];
+    if (s->result.command.token[0] && room_volume_window_live(s)
+        && !strcmp(s->result.command.native_prepare_id,r->native_prepare_id)) return -1;
+    if (!slot && s!=room_volume_pin && (!s->result.command.token[0]
+        || (!room_volume_window_live(s) && s->result.contexts_drained))) slot=s;
+  }
+  if (!slot) return -1;
+  memset(slot,0,sizeof(*slot));
+  if (clock_gettime(CLOCK_MONOTONIC,&slot->deadline)<0) return -1;
+  slot->deadline.tv_sec++;
+  slot->result.command=*r; slot->result.identity=identity; slot->result.volume_state=state;
+  slot->result.outcome=ROOM_VOLUME_PREPARED; slot->result.contexts_drained=true;
+  outputs_attention_uuid(uuid); /* Shared randomness only, no attention capability. */
+  for (j=0;j<36;j++) if (uuid[j]!='-') slot->result.command.token[k++]=uuid[j];
+  slot->result.command.token[k]=0;
+  *out=slot->result; return 0;
+}
+int outputs_room_volume_result_get(const char *token,struct output_room_volume_result *out)
+{
+  struct room_volume_slot *slot=room_volume_find(token);
+  if (!slot || !out) return -1;
+  room_volume_observe(slot,out); return 0;
+}
+static bool room_volume_current(struct room_volume_slot *slot)
+{
+  struct output_transport_identity identity;
+  struct output_room_volume_state state;
+  return slot && slot->used && !slot->cancelled && room_volume_window_live(slot)
+    && room_volume_pin_busy() && room_volume_pin==slot
+    && room_volume_snapshot(slot->result.identity.device_id,&identity,&state)==0
+    && transport_identity_equal(&identity,&slot->result.identity)
+    && room_volume_state_equal(&state,&slot->result.volume_state);
+}
+int outputs_room_volume_commit(const struct output_room_volume_request *r,struct output_room_volume_result *out)
+{
+  struct room_volume_slot *s;
+  struct output_transport_identity identity;
+  struct output_room_volume_state state;
+  struct output_device *d;
+  int ret;
+  if (!r || !out || !(s=room_volume_find(r->token)) || s->used) return -1;
+  s->used=true; s->result.outcome=ROOM_VOLUME_REJECTED;
+  if (transport_hex(r->native_reservation_id,32)) memcpy(s->result.command.native_reservation_id,r->native_reservation_id,33);
+  if (!room_volume_request_valid(r) || !transport_hex(r->native_reservation_id,32)
+      || !room_volume_window_live(s) || s->cancelled || outputs_transport_busy()
+      || r->device_id!=s->result.command.device_id || r->percent!=s->result.command.percent
+      || strcmp(r->native_prepare_id,s->result.command.native_prepare_id)
+      || strcmp(r->args_digest,s->result.command.args_digest)
+      || strcmp(r->expected_input_path_digest,s->result.command.expected_input_path_digest)
+      || room_volume_snapshot(r->device_id,&identity,&state)<0
+      || !transport_identity_equal(&identity,&s->result.identity)
+      || !room_volume_state_equal(&state,&s->result.volume_state)) {
+    if (!room_volume_window_live(s)) s->result.outcome=ROOM_VOLUME_EXPIRED;
+    room_volume_observe(s,out); return 0;
+  }
+  memcpy(s->result.command.native_reservation_id,r->native_reservation_id,33);
+  if (clock_gettime(CLOCK_MONOTONIC,&room_volume_pin_expiry)<0) { room_volume_observe(s,out); return 0; }
+  room_volume_pin_expiry.tv_sec+=10; room_volume_pin=s;
+  s->result.outcome=ROOM_VOLUME_PENDING; s->result.contexts_drained=false;
+  d=outputs_device_get(r->device_id);
+  ret=outputs[d->type]->device_room_volume(d,&s->result);
+  if (ret<0) { s->result.outcome=ROOM_VOLUME_REJECTED; s->result.contexts_drained=true; }
+  room_volume_observe(s,out); return 0;
+}
+int outputs_room_volume_cancel(const char *token,const char *reservation,struct output_room_volume_result *out)
+{
+  struct room_volume_slot *s=room_volume_find(token);
+  if (!s || !out || !transport_hex(reservation,32)
+      || (s->result.command.native_reservation_id[0] && strcmp(reservation,s->result.command.native_reservation_id))) return -1;
+  if (!s->used) { s->used=true; memcpy(s->result.command.native_reservation_id,reservation,33); }
+  s->cancelled=true;
+  if (s->result.outcome!=ROOM_VOLUME_PROTOCOL_ACCEPTED)
+    s->result.outcome=s->result.possible_effect ? ROOM_VOLUME_UNKNOWN : ROOM_VOLUME_CANCELLED;
+  room_volume_observe(s,out); return 0;
+}
+bool outputs_room_volume_dispatch_current(const char *token)
+{
+  struct room_volume_slot *s=room_volume_find(token);
+  return room_volume_current(s) && (s->result.outcome==ROOM_VOLUME_PENDING || s->result.outcome==ROOM_VOLUME_ADMITTED_PENDING);
+}
+bool outputs_room_volume_before_write(const char *token)
+{
+  struct room_volume_slot *s=room_volume_find(token);
+  struct output_device *d;
+  struct output_transport_identity identity;
+  if (!outputs_room_volume_dispatch_current(token)) return false;
+  if (s->result.possible_effect) return true;
+  d=outputs_device_get(s->result.identity.device_id);
+  /* This is the final local mutator, after all queue/socket delays. Durable
+   * desired base admission is irreversible; a following error stays unknown. */
+  s->result.possible_effect=true; s->result.outcome=ROOM_VOLUME_ADMITTED_PENDING;
+  if (outputs_device_volume_register(d,s->result.command.percent,-1)<0) {
+    s->result.outcome=ROOM_VOLUME_UNKNOWN; return false; /* Local durable admission may be uncertain. */
+  }
+  if (room_volume_snapshot(d->id,&identity,&s->result.volume_state)<0 || !room_volume_window_live(s)) {
+    s->result.outcome=ROOM_VOLUME_UNKNOWN; return false;
+  }
+  return true;
+}
+void outputs_room_volume_complete(const char *token,bool accepted)
+{
+  struct room_volume_slot *s=room_volume_find(token);
+  if (!s || s->result.contexts_drained) return;
+  s->result.contexts_drained=true;
+  /* Terminal unknown/cancel/expiry cannot be upgraded by a late completion. */
+  if (s->result.outcome==ROOM_VOLUME_PENDING || s->result.outcome==ROOM_VOLUME_ADMITTED_PENDING) {
+    if (accepted && s->result.possible_effect && room_volume_current(s)) s->result.outcome=ROOM_VOLUME_PROTOCOL_ACCEPTED;
+    else s->result.outcome=s->result.possible_effect ? ROOM_VOLUME_UNKNOWN : s->cancelled ? ROOM_VOLUME_CANCELLED :
+        room_volume_window_live(s) ? ROOM_VOLUME_REJECTED : ROOM_VOLUME_EXPIRED;
+  }
+}
