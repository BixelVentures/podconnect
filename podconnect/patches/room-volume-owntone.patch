+/* Sum all nested object keys to detect duplicate-key collapse in the strict
+ * canonical identifier protocol. Arrays have no place in mutation bodies. */
+static size_t transport_json_key_count(json_object *object,unsigned depth)
+{
+  size_t count=0;
+  if (depth>4 || json_object_is_type(object,json_type_array)) return SIZE_MAX;
+  if (!json_object_is_type(object,json_type_object)) return 0;
+  json_object_object_foreach(object,key,value) {
+    size_t nested=transport_json_key_count(value,depth+1);
+    (void)key;
+    if (nested==SIZE_MAX || count>SIZE_MAX-nested-1) return SIZE_MAX;
+    count+=nested+1;
+  }
+  return count;
+}
+
 /* This flat wire protocol has only canonical ASCII identifier/action strings
