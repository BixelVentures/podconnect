diff --git a/src/httpd_jsonapi_room_volume.inc.c b/src/httpd_jsonapi_room_volume.inc.c
new file mode 100644
index 0000000..b75ba5d
--- /dev/null
+++ b/src/httpd_jsonapi_room_volume.inc.c
@@ -0,0 +1,128 @@
+static json_object *room_volume_state_json(const struct output_room_volume_state *s)
+{
+  json_object *o=json_object_new_object();
+  attention_json_u64(o,"base_revision",s->base_revision); attention_json_u64(o,"attention_revision",s->attention_revision);
+  json_object_object_add(o,"base_percent",json_object_new_int(s->base_percent));
+  json_object_object_add(o,"effective_percent",json_object_new_int(s->effective_percent)); return o;
+}
+static int room_volume_parse_counter(json_object *o,const char *key,uint64_t *out)
+{
+  char canonical[32]; const char *value;
+  if (attention_parse_u64(o,key,out)<0) return -1;
+  value=jparse_str_from_obj(o,key); snprintf(canonical,sizeof(canonical),"%" PRIu64,*out);
+  return strcmp(value,canonical) ? -1 : 0;
+}
+static int room_volume_parse_identity(json_object *o,struct output_transport_identity *id)
+{
+  if (!o || !json_object_is_type(o,json_type_object) || json_object_object_length(o)!=9
+      || !transport_json_string(o,"process",id->process,sizeof(id->process))
+      || !transport_json_string(o,"input_path_digest",id->input_path_digest,sizeof(id->input_path_digest))
+      || room_volume_parse_counter(o,"device_id",&id->device_id)<0
+      || room_volume_parse_counter(o,"device_incarnation",&id->device_incarnation)<0
+      || room_volume_parse_counter(o,"session_epoch",&id->session_epoch)<0
+      || room_volume_parse_counter(o,"route_revision",&id->route_revision)<0
+      || room_volume_parse_counter(o,"selection_revision",&id->selection_revision)<0
+      || room_volume_parse_counter(o,"input_generation",&id->input_generation)<0
+      || room_volume_parse_counter(o,"input_item_id",&id->input_item_id)<0) return -1;
+  return 0;
+}
+static int room_volume_parse_percent(json_object *o,const char *key,int *out)
+{
+  json_object *v;
+  if (!json_object_object_get_ex(o,key,&v) || !json_object_is_type(v,json_type_int)
+      || json_object_get_int64(v)<0 || json_object_get_int64(v)>100) return -1;
+  *out=json_object_get_int(v); return 0;
+}
+static int room_volume_parse_state(json_object *o,struct output_room_volume_state *s)
+{
+  return !o || !json_object_is_type(o,json_type_object) || json_object_object_length(o)!=4
+    || room_volume_parse_counter(o,"base_revision",&s->base_revision)<0
+    || room_volume_parse_counter(o,"attention_revision",&s->attention_revision)<0
+    || room_volume_parse_percent(o,"base_percent",&s->base_percent)<0
+    || room_volume_parse_percent(o,"effective_percent",&s->effective_percent)<0 ? -1 : 0;
+}
+static const char *room_volume_outcome_name(enum output_room_volume_outcome outcome)
+{
+  const char *names[]={"prepared","pending","admitted_pending","protocol_accepted","rejected_before_admission","expired_before_admission","cancelled_before_admission","unknown"};
+  return outcome>=0 && (size_t)outcome<ARRAY_SIZE(names) ? names[outcome] : "unknown";
+}
+static json_object *room_volume_result_json(const char *schema,const struct output_room_volume_result *r)
+{
+  json_object *o=json_object_new_object();
+  json_object_object_add(o,"schema",json_object_new_string(schema)); json_object_object_add(o,"ok",json_object_new_boolean(true));
+  json_object_object_add(o,"token",json_object_new_string(r->command.token));
+  json_object_object_add(o,"native_prepare_id",json_object_new_string(r->command.native_prepare_id));
+  json_object_object_add(o,"native_reservation_id",json_object_new_string(r->command.native_reservation_id));
+  json_object_object_add(o,"args_digest",json_object_new_string(r->command.args_digest));
+  json_object_object_add(o,"percent",json_object_new_int(r->command.percent));
+  json_object_object_add(o,"identity",transport_identity_json(&r->identity));
+  json_object_object_add(o,"volume_state",room_volume_state_json(&r->volume_state));
+  json_object_object_add(o,"outcome",json_object_new_string(room_volume_outcome_name(r->outcome)));
+  json_object_object_add(o,"possible_effect",json_object_new_boolean(r->possible_effect));
+  json_object_object_add(o,"deadline_retired",json_object_new_boolean(r->deadline_retired));
+  json_object_object_add(o,"contexts_drained",json_object_new_boolean(r->contexts_drained));
+  json_object_object_add(o,"physical_result_verified",json_object_new_boolean(false));
+  json_object_object_add(o,"pin_remaining_ms",json_object_new_int(r->pin_remaining_ms)); return o;
+}
+static int jsonapi_reply_room_volume_state(struct httpd_request *hreq)
+{
+  uint64_t id; bool busy;
+  struct output_transport_identity identity; struct output_room_volume_state state;
+  json_object *o,*actions;
+  if (safe_atou64(hreq->path_parts[2],&id)<0 || player_room_volume_state_get(id,&identity,&state,&busy)<0) return 409;
+  o=json_object_new_object(); actions=json_object_new_array();
+  json_object_object_add(o,"schema",json_object_new_string("podconnect.output_room_volume_state.v1"));
+  json_object_object_add(o,"ok",json_object_new_boolean(true)); json_object_object_add(o,"identity",transport_identity_json(&identity));
+  json_object_object_add(o,"volume_state",room_volume_state_json(&state)); json_object_object_add(o,"busy",json_object_new_boolean(busy));
+  if (!busy) json_object_array_add(actions,json_object_new_string("volume"));
+  json_object_object_add(o,"actions",actions); json_object_object_add(o,"physical_result_verified",json_object_new_boolean(false));
+  return transport_json_reply(hreq,o);
+}
+static int jsonapi_reply_room_volume_write(struct httpd_request *hreq)
+{
+  struct output_room_volume_request request={0}; struct output_room_volume_result result;
+  json_object *body=transport_parse_body(hreq->in_body),*identity,*state,*reply;
+  const char *phase=hreq->path_parts[4]; bool prepare=!strcmp(phase,"prepare"),cancel=!strcmp(phase,"cancel");
+  int ret=HTTP_BADREQUEST;
+  if (!body || safe_atou64(hreq->path_parts[2],&request.device_id)<0) goto out;
+  if (cancel) {
+    if (json_object_object_length(body)!=2 || !transport_json_string(body,"token",request.token,sizeof(request.token))
+        || !transport_json_string(body,"native_reservation_id",request.native_reservation_id,sizeof(request.native_reservation_id))) goto out;
+    ret=HTTP_NOTFOUND;
+    if (player_room_volume_result_get(request.token,&result)<0 || result.identity.device_id!=request.device_id
+        || player_room_volume_cancel(request.token,request.native_reservation_id,&result)<0) goto out;
+    ret=transport_json_reply(hreq,room_volume_result_json("podconnect.output_room_volume_cancel.v1",&result)); goto out;
+  }
+  if (json_object_object_length(body)!=6
+      || !transport_json_string(body,"native_prepare_id",request.native_prepare_id,sizeof(request.native_prepare_id))
+      || !transport_json_string(body,"args_digest",request.args_digest,sizeof(request.args_digest))
+      || !transport_json_string(body,"expected_input_path_digest",request.expected_input_path_digest,sizeof(request.expected_input_path_digest))
+      || room_volume_parse_percent(body,"percent",&request.percent)<0) goto out;
+  if (prepare) {
+    if (!json_object_object_get_ex(body,"expected_identity",&identity) || room_volume_parse_identity(identity,&request.expected_identity)<0
+        || !json_object_object_get_ex(body,"expected_volume_state",&state) || room_volume_parse_state(state,&request.expected_volume_state)<0) goto out;
+  } else if (!transport_json_string(body,"token",request.token,sizeof(request.token))
+      || !transport_json_string(body,"native_reservation_id",request.native_reservation_id,sizeof(request.native_reservation_id))) goto out;
+  ret=409;
+  if ((prepare ? player_room_volume_prepare(&request,&result) : player_room_volume_commit(&request,&result))<0) goto out;
+  if (!prepare) { ret=transport_json_reply(hreq,room_volume_result_json("podconnect.output_room_volume_commit.v1",&result)); goto out; }
+  reply=json_object_new_object();
+  json_object_object_add(reply,"schema",json_object_new_string("podconnect.output_room_volume_prepare.v1"));
+  json_object_object_add(reply,"ok",json_object_new_boolean(true)); json_object_object_add(reply,"token",json_object_new_string(result.command.token));
+  json_object_object_add(reply,"native_prepare_id",json_object_new_string(result.command.native_prepare_id));
+  json_object_object_add(reply,"args_digest",json_object_new_string(result.command.args_digest));
+  json_object_object_add(reply,"percent",json_object_new_int(result.command.percent));
+  json_object_object_add(reply,"identity",transport_identity_json(&result.identity));
+  json_object_object_add(reply,"volume_state",room_volume_state_json(&result.volume_state));
+  json_object_object_add(reply,"expires_after_ms",json_object_new_int(OUTPUT_ROOM_VOLUME_WINDOW_MS));
+  json_object_object_add(reply,"physical_result_verified",json_object_new_boolean(false));
+  ret=transport_json_reply(hreq,reply);
+ out:
+  jparse_free(body); return ret;
+}
+static int jsonapi_reply_room_volume_result(struct httpd_request *hreq)
+{
+  uint64_t id; struct output_room_volume_result result;
+  if (safe_atou64(hreq->path_parts[2],&id)<0 || player_room_volume_result_get(hreq->path_parts[5],&result)<0 || result.identity.device_id!=id) return HTTP_NOTFOUND;
+  return transport_json_reply(hreq,room_volume_result_json("podconnect.output_room_volume_result.v1",&result));
+}
