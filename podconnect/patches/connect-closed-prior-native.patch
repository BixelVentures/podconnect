+// A closed prior AppPlayer cannot use the normal prepare-before-Close path:
+// its original FIFO writer is already gone. Only C can establish an exact
+// terminal witness for that old completed START before a successor may write.
+func (app *App) retireClosedPriorStartFor(ctx context.Context, current *AppPlayer) error {
+	if ctx.Err() != nil {
+		return ErrAliasConflict
+	}
+	app.moveCustodyMu.Lock()
+	op := app.startCustody
+	if op == nil || op.Owner == nil || op.Owner == current {
+		app.moveCustodyMu.Unlock()
+		return ErrAliasConflict
+	}
+	old := op.Owner
+	app.moveCustodyMu.Unlock()
+
+	old.roomCloseMu.Lock()
+	done := old.roomCloseDone
+	old.roomCloseMu.Unlock()
+	if done == nil || old.player == nil || !old.player.Closed() {
+		return ErrAliasConflict
+	}
+	select {
+	case <-done:
+	default:
+		return ErrAliasConflict
+	}
+
+	app.moveCustodyMu.Lock()
+	if ctx.Err() != nil || app.startCustody != op || app.moveCustody != nil || app.startOutputPermit != nil ||
+		app.openedWriterOwner != old || app.queueWriterBusyLocked() ||
+		(app.retirementPending != nil && (app.retirementPending.closedPrior || app.retirementPending.owner != old || app.retirementPending.startSource != op)) {
+		app.moveCustodyMu.Unlock()
+		return ErrAliasConflict
+	}
+	op.mu.Lock()
+	valid := op.Terminal && op.State == "complete" && op.CReceipt != nil && op.CReceipt.Phase == "completed" &&
+		op.Capture != nil && op.Capture.Player == old.player && op.Capture.Session == old.sess &&
+		op.CReceipt.WriterEpoch == op.Epoch && op.CReceipt.Pipe != nil &&
+		*op.CReceipt.Pipe == (outputPipeIdentity{Device: app.openedWriter.Device, Inode: app.openedWriter.Inode, Type: app.openedWriter.Type})
+	var a retirementAttempt
+	if valid {
+		a = retirementAttempt{owner: old, purpose: "start", closedPrior: true, baseURL: op.Capture.OwnTone,
+			deviceID: op.Target.DeviceID, completed: op.CReceipt.Token,
+			incarnation: op.Capture.Incarnation, process: op.Capture.Process,
+			writerEpoch: op.Epoch, inputEpoch: op.CReceipt.InputEpoch, startSource: op,
+			writer: app.openedWriter}
+	}
+	op.mu.Unlock()
+	process, currentProcess := nativeContentProcess()
+	if !valid || !currentProcess || process != a.process || !volumeHex32.MatchString(a.completed) ||
+		!volumeHex32.MatchString(a.incarnation) || !volumeCounter(a.writerEpoch) || a.writerEpoch == "0" ||
+		!volumeCounter(a.inputEpoch) || a.inputEpoch == "0" || !volumeCounter(a.writer.FD) ||
+		a.writer.Type != "fifo" || !volumeCounter(a.writer.Device) ||
+		!volumeCounter(a.writer.Inode) || a.writer.Inode == "0" || !roomTransportURL(a.baseURL) {
+		app.moveCustodyMu.Unlock()
+		return ErrAliasConflict
+	}
+	reservation, err := randomQueueID(16)
+	if err != nil {
+		app.moveCustodyMu.Unlock()
+		return ErrAliasConflict
+	}
+	a.reservation = reservation
+	writerGeneration := app.openedWriterGeneration
+	app.retirementPending = &a // Fences all other new writers throughout the C await.
+	app.moveCustodyMu.Unlock()
+
+	ctx, cancel := context.WithTimeout(ctx, 12*time.Second)
+	defer cancel()
+	var reply retirementReceipt
+	err = retirementHTTP(ctx, "POST", a.endpoint("prepare"), struct {
+		Completed           string             `json:"completed_token"`
+		Reservation         string             `json:"native_reservation_id"`
+		Incarnation         string             `json:"native_incarnation"`
+		Process             contentProcess     `json:"native_process"`
+		Epoch               string             `json:"writer_source_epoch"`
+		FD                  string             `json:"writer_fd"`
+		Pipe                outputPipeIdentity `json:"pipe_identity"`
+		InputEpoch          string             `json:"expected_input_epoch"`
+		WriterAlreadyClosed bool               `json:"writer_already_closed"`
+	}{a.completed, a.reservation, a.incarnation, a.process, a.writerEpoch, a.writer.FD,
+		outputPipeIdentity{Device: a.writer.Device, Inode: a.writer.Inode, Type: a.writer.Type}, a.inputEpoch, true}, &reply)
+	a.retirement = reply.RetirementToken
+	terminal := err == nil && reply.Outcome == "retired" &&
+		volumeHex32.MatchString(a.retirement) && a.validTerminal(reply, "prepare")
+
+	app.moveCustodyMu.Lock()
+	defer app.moveCustodyMu.Unlock()
+	if app.retirementPending != &a || app.startCustody != op || app.moveCustody != nil ||
+		app.startOutputPermit != nil || app.queueWriterBusyLocked() ||
+		app.openedWriterOwner != old || app.openedWriter != a.writer ||
+		app.openedWriterGeneration != writerGeneration || !terminal {
+		app.moveCustodyUnknown = true
+		return ErrAliasConflict
+	}
+	app.startCustody = nil
+	app.retirementPending = nil
+	app.moveCustodyUnknown = false
+	app.openedWriter = output.MovePipeIdentity{}
+	app.openedWriterOwner = nil
+	return nil
+}
