+// A fresh explicit phone transfer may replace only a completed START owned by
+// an already joined, different AppPlayer. C must retire that original closed
+// writer before this command changes Spotify state or opens a successor FIFO.
+func (p *AppPlayer) retirePriorStartForDealerTransfer(ctx context.Context, req dealer.RequestPayload) error {
+	if p.app == nil {
+		return nil
+	}
+	p.app.moveCustodyMu.Lock()
+	prior := p.app.startCustody != nil && p.app.startCustody.Owner != p
+	p.app.moveCustodyMu.Unlock()
+	if !prior {
+		return nil // Current-owner and ordinary transfers retain their existing path.
+	}
+	alias := req.TargetAliasId
+	if alias == nil {
+		alias = req.Command.TargetAliasId
+	}
+	if ctx.Err() != nil || p.player == nil || p.player.Closed() || p.sess == nil ||
+		p.state == nil || p.state.device == nil ||
+		req.Command.Endpoint != "transfer" || req.Command.Options.SystemInitiated ||
+		req.Command.PlayOptions.SystemInitiated || len(req.Command.Data) == 0 ||
+		req.SentByDeviceId == "" || len(req.SentByDeviceId) > 160 || alias == nil || *alias == 0 {
+		return ErrAliasConflict
+	}
+	p.aliasMu.Lock()
+	valid := !p.aliasRetired && p.spotConnId != "" && int(*alias) <= len(p.aliasRegistry) &&
+		p.aliasRegistry[*alias-1].ID == *alias && p.aliasRegistry[*alias-1].RoomID != ""
+	incarnation, fingerprint, revision, connection := p.aliasIncarnation, p.aliasFingerprint, p.aliasRevision, p.spotConnId
+	selected := p.state.device.SelectedAliasId
+	p.aliasMu.Unlock()
+	if !valid {
+		return ErrAliasConflict
+	}
+	if err := p.app.retireClosedPriorStartFor(ctx, p); err != nil {
+		return err
+	}
+	p.aliasMu.Lock()
+	current := !p.aliasRetired && p.aliasIncarnation == incarnation && p.aliasFingerprint == fingerprint &&
+		p.aliasRevision == revision && p.spotConnId == connection &&
+		p.state.device.SelectedAliasId == selected && int(*alias) <= len(p.aliasRegistry) &&
+		p.aliasRegistry[*alias-1].ID == *alias && p.aliasRegistry[*alias-1].RoomID != ""
+	p.aliasMu.Unlock()
+	if ctx.Err() != nil || p.player.Closed() || !current {
+		return ErrAliasConflict
+	}
+	return nil
+}
