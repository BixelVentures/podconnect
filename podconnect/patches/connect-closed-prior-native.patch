+func TestClosedPriorSTARTRequiresExactTerminalBeforeFreshWriter(t *testing.T) {
+	var app *App
+	var writer output.MovePipeIdentity
+	var normal, orphan atomic.Int32
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if r.URL.Path != "/api/outputs/102/start/retire/prepare" {
+			t.Errorf("unexpected endpoint %s", r.URL.Path)
+			http.Error(w, "endpoint", http.StatusNotFound)
+			return
+		}
+		var body map[string]json.RawMessage
+		if json.NewDecoder(r.Body).Decode(&body) != nil {
+			t.Error("bad retirement body")
+			return
+		}
+		if len(body) == 8 {
+			normal.Add(1)
+			http.Error(w, "old writer unavailable", http.StatusConflict)
+			return
+		}
+		if len(body) != 9 || string(body["writer_already_closed"]) != "true" {
+			t.Errorf("closed prior request changed normal contract: %#v", body)
+			http.Error(w, "bad body", http.StatusConflict)
+			return
+		}
+		orphan.Add(1)
+		var reservation string
+		_ = json.Unmarshal(body["native_reservation_id"], &reservation)
+		reply := retirementReply("start", "prepare", reservation, writer)
+		reply.Outcome, reply.InputEpoch, reply.ContextsDrained, reply.DurableTerminal, reply.RetiredWitness = "retired", "2", true, true, true
+		_ = json.NewEncoder(w).Encode(reply)
+	}))
+	defer server.Close()
+	var old *AppPlayer
+	app, old, _ = retirementOwnerFixture(t, server.URL, "start")
+	writer = app.openedWriter
+	pipePath, err := os.Readlink("/proc/self/fd/" + writer.FD)
+	if err != nil {
+		t.Fatal("cannot identify original FIFO", err)
+	}
+	oldGeneration := app.openedWriterGeneration
+	app.startCustody.Capture.Player = old.player
+	old.Close()
+	if normal.Load() != 1 || !app.moveCustodyUnknown || app.startCustody == nil || !old.player.Closed() {
+		t.Fatal("failed normal prepare did not retain closed old START custody")
+	}
+	fresh := &AppPlayer{app: app}
+	cancelled, cancel := context.WithCancel(context.Background())
+	cancel()
+	if app.retireClosedPriorStartFor(cancelled, fresh) == nil || orphan.Load() != 0 || app.startCustody == nil {
+		t.Fatal("cancelled transfer sent a new retirement request")
+	}
+	if err := app.retireClosedPriorStartFor(context.Background(), fresh); err != nil {
+		t.Fatal("exact closed-prior terminal was refused", err)
+	}
+	if orphan.Load() != 1 || app.moveCustodyUnknown || app.startCustody != nil || app.retirementPending != nil {
+		t.Fatal("terminal did not retire only the old custody")
+	}
+	worker, err := player.NewPlayer(&player.Options{Log: &librespot.NullLogger{}, AudioBackend: "pipe",
+		AudioOutputPipe: pipePath, AudioOutputPipeFormat: "s16le",
+		WithNewOutput: func(create func() (output.Output, error)) (output.Output, error) {
+			return app.withNewOutput(fresh, create)
+		}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer worker.Close()
+	fresh.player = worker
+	if err := worker.SetPrimaryStream(&contentInertSource{}, true, false); err != nil {
+		t.Fatal("fresh player did not open its FIFO writer", err)
+	}
+	if app.openedWriterOwner != fresh || app.openedWriterGeneration != oldGeneration+1 ||
+		app.openedWriter.Device != writer.Device || app.openedWriter.Inode != writer.Inode ||
+		app.openedWriter.Type != "fifo" {
+		t.Fatal("terminal did not admit a fresh writer for the same named FIFO")
+	}
+	opened, err := os.Stat("/proc/self/fd/" + app.openedWriter.FD)
+	if err != nil || opened.Mode()&os.ModeNamedPipe == 0 {
+		t.Fatal("fresh writer descriptor is not an open FIFO", err)
+	}
+}
