+func TestQueuePresentationRetainsExactSurvivorOfPublishedSelection(t *testing.T) {
+	for _, kind := range []string{"manual", "context"} {
+		t.Run(kind, func(t *testing.T) {
+			p, operation, fresh := queueSurvivorFixture(t, kind)
+			old := operation.Queue.Observation.Snapshot
+			observation, expiry := fresh.Snapshot.ObservationID, fresh.Expires
+			originalTailID := fresh.Snapshot.Items[len(fresh.Snapshot.Items)-1].ID
+			p.recordQueueContinuation(operation)
+			if p.queueOccurrenceOffer != nil || !p.retainQueueContinuation(fresh) ||
+				fresh.Snapshot.Items[0].ID != old.Items[operation.Queue.Position+1].ID {
+				t.Fatal("first fresh read lost the exact surviving duplicate")
+			}
+			if fresh.Snapshot.Items[0].ID == old.Items[operation.Queue.Position].ID || fresh.Snapshot.ObservationID != observation || fresh.Expires != expiry ||
+				fresh.Snapshot.Items[len(fresh.Snapshot.Items)-1].ID != originalTailID {
+				t.Fatal("fresh read restored the consumed occurrence or old authority")
+			}
+			if p.retainQueueContinuation(fresh) {
+				t.Fatal("presentation continuation was reusable")
+			}
+		})
+	}
+}
