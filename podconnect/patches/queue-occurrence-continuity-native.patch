+// A successful exact queue selection removes the upcoming prefix through the
+// selected row. Retain its known survivors only for the actual published list.
+func (p *AppPlayer) recordQueueContinuation(offer *nativeTransportOffer) {
+	p.queuePresentationContinuation = nil
+	queue := offer.Queue
+	if queue == nil || queue.Owner != p || !offer.Published || !queue.EffectEnqueued || !queue.EffectJoined ||
+		queue.Observation == nil || queue.Observation.BoundOwner == nil || offer.Writer == nil ||
+		p.state == nil || p.state != offer.State || p.sess != offer.Session || p.player != offer.Player ||
+		p.primaryStream == nil || p.primaryStream != offer.PreparedStream ||
+		p.state.player == nil || p.state.player != offer.PreparedState ||
+		p.state.tracks == nil || p.state.tracks != offer.PreparedTracks ||
+		p.state.tracks.TransportRevision() != queue.Selection.QueueRevision+1 {
+		return
+	}
+	previous := queue.Observation
+	owner := offer.Snapshot.roomTransportIdentity
+	if *previous.BoundOwner != owner || previous.Snapshot.ObservationID != queue.Selection.ObservationID ||
+		previous.Snapshot.QueueRevision != queue.Selection.QueueRevision ||
+		queue.Position < 0 || queue.Position >= len(previous.Snapshot.Items)-1 ||
+		previous.Snapshot.Items[queue.Position].ID != queue.Selection.OccurrenceID {
+		return
+	}
+	snapshot := previous.Snapshot
+	snapshot.QueueRevision = p.state.tracks.TransportRevision()
+	snapshot.Items = append([]nativeQueueItem(nil), previous.Snapshot.Items[queue.Position+1:]...)
+	for index := range snapshot.Items {
+		snapshot.Items[index].Position = index
+	}
+	writer := *offer.Writer
+	if writer.Completed != nil {
+		completed := *writer.Completed
+		writer.Completed = &completed
+	}
+	p.queuePresentationContinuation = &nativeQueueOffer{
+		Snapshot: snapshot, State: p.state, Tracks: p.state.tracks, Alias: previous.Alias,
+		Expires: time.Now().Add(queueOfferLifetime), BoundOwner: &owner, PlayerState: p.state.player,
+		Session: p.sess, Player: p.player, Primary: p.primaryStream,
+		Generation: p.roomTransportGeneration, Writer: &writer,
+	}
+}
+
+func (p *AppPlayer) retainQueueContinuation(fresh *nativeQueueOffer) bool {
+	previous := p.queuePresentationContinuation
+	p.queuePresentationContinuation = nil
+	return sameQueuePresentationScope(previous, fresh) && time.Now().Before(previous.Expires) &&
+		copyQueuePresentationPrefix(previous.Snapshot.Items, fresh.Snapshot.Items)
+}
