+func TestQueuePresentationContinuationFailsClosedOnInterveningChange(t *testing.T) {
+	for _, change := range []string{"unpublished", "unjoined", "writer", "generation", "revision", "list", "state", "primary", "owner", "expired", "tail-collision"} {
+		t.Run(change, func(t *testing.T) {
+			p, operation, fresh := queueSurvivorFixture(t, "context")
+			switch change {
+			case "unpublished":
+				operation.Published = false
+			case "unjoined":
+				operation.Queue.EffectJoined = false
+			}
+			p.recordQueueContinuation(operation)
+			switch change {
+			case "writer":
+				fresh.Writer.Wire.Generation = "2"
+			case "generation":
+				fresh.Generation++
+			case "revision":
+				fresh.Snapshot.QueueRevision++
+			case "list":
+				fresh.Tracks = &tracks.List{}
+			case "state":
+				fresh.PlayerState = &connectpb.PlayerState{}
+			case "primary":
+				fresh.Primary = &player.Stream{}
+			case "owner":
+				fresh.BoundOwner.AliasRevision++
+			case "expired":
+				p.queuePresentationContinuation.Expires = time.Now().Add(-time.Second)
+			case "tail-collision":
+				old := operation.Queue.Observation.Snapshot.Items[operation.Queue.Position+1]
+				fresh.Snapshot.Items[len(fresh.Snapshot.Items)-1].ID = old.ID
+			}
+			original := fresh.Snapshot.Items[0].ID
+			if p.retainQueueContinuation(fresh) || fresh.Snapshot.Items[0].ID != original || p.queuePresentationContinuation != nil {
+				t.Fatal("stale or unsupported transition reused a prior occurrence")
+			}
+		})
+	}
+}
