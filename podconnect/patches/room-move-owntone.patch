+  uint64_t generation=transport_input_generation;
+  if(!item_id || !start_retired_stage_ready || !outputs_start_retired_normal_staging(path)
+      || transport_input_item!=item_id || !transport_input_path_digest[0]
+      || !generation || stat(path,&st)<0 || !S_ISFIFO(st.st_mode)
+      || clock_gettime(CLOCK_MONOTONIC,&deadline)<0)return false;
+  deadline.tv_sec++;
+  if(input_fifo_owner_get(item_id,path,false,0,0,&deadline,&reader)<0
+      || reader.device!=(uint64_t)st.st_dev || reader.inode!=(uint64_t)st.st_ino
+      || !outputs_start_retired_normal_staging(path) || transport_input_generation!=generation
+      || transport_input_item!=item_id || !start_contexts_drained())return false;
+  if(start_journal_consume_retired_reopen()<0)return false;
+  if(!outputs_start_retired_normal_staging(path) || transport_input_generation!=generation
+      || transport_input_item!=item_id
+      || input_fifo_owner_get(item_id,path,false,0,0,&deadline,&reader)<0
+      || reader.device!=(uint64_t)st.st_dev || reader.inode!=(uint64_t)st.st_ino)return false;
+  if(input_fifo_stage_release(path,&staged)<0 || staged.device!=reader.device
+      || staged.inode!=reader.inode)return false;
+  start_retired_stage_ready=false;start_retired_stage_path[0]=0;
+  if(input_fifo_owner_get(item_id,path,false,0,0,&deadline,&reader)<0
+      || reader.device!=(uint64_t)st.st_dev || reader.inode!=(uint64_t)st.st_ino
+      || transport_input_generation!=generation || transport_input_item!=item_id
+      || !start_contexts_drained())return false;
+  if(start_active)start_active->retirement.reopen_consumed=true;
+  start_retired_reopen_pending=false;
