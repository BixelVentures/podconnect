@@ -0,0 +1,1020 @@
+/* Actual player/output event-loop owner. START is a separate purpose; no HTTP
+ * wait, volume-attention lease, generic autoselection or caller TTL. */
+#define START_SLOTS 32
+struct start_retirement {
+  enum output_retirement_outcome outcome;
+  char token[33],reservation[33],native_incarnation[33];
+  uint64_t writer_source_epoch,writer_fd,pipe_device,pipe_inode,input_item_id,admitted_input_epoch,input_epoch;
+  struct timespec deadline;
+  bool reader_ready_closed,reopen_consumed;
+};
+struct start_slot {
+  struct output_start_result result;
+  struct start_retirement retirement;
+  struct timespec deadline,pin_expiry;
+  uint64_t prepared_generation,selection_revision,input_generation,target_epoch,target_route;
+  uint64_t target_base_revision,target_attention_revision;
+  const void *session,*old_session;
+  uint64_t old_epoch,old_route;
+  uint64_t move_proven_input_generation;
+  bool used,cancelled,writer_pending,volume_pending,volume_admitted;
+  struct event *deadline_ev;
+};
+static struct start_slot start_slots[START_SLOTS],*start_active,*start_scope;
+static atomic_bool start_gate=ATOMIC_VAR_INIT(false);
+static atomic_uint_fast64_t start_metadata_epoch=ATOMIC_VAR_INIT(1);
+
+static bool start_window(const struct start_slot *s)
+{
+  struct timespec now;
+  return s && clock_gettime(CLOCK_MONOTONIC,&now)==0 && (now.tv_sec<s->deadline.tv_sec
+    || (now.tv_sec==s->deadline.tv_sec && now.tv_nsec<s->deadline.tv_nsec));
+}
+static struct start_slot *start_find(const char *token)
+{
+  size_t i;
+  if (!transport_hex(token,32)) return NULL;
+  for (i=0;i<ARRAY_SIZE(start_slots);i++) if (!strcmp(start_slots[i].result.command.token,token)) return &start_slots[i];
+  return NULL;
+}
+bool outputs_start_gate_closed(void) { return atomic_load(&start_gate); }
+uint64_t outputs_start_metadata_generation(void) { return atomic_load(&start_metadata_epoch); }
+bool outputs_start_metadata_current(uint64_t epoch)
+{ return !outputs_start_gate_closed() && epoch==outputs_start_metadata_generation(); }
+static void start_gate_set(bool closed)
+{
+  uint64_t epoch=outputs_start_metadata_generation();
+  if (epoch==UINT64_MAX) { atomic_store(&start_gate,true); transport_generation_exhausted=true; return; }
+  atomic_store(&start_gate,closed); atomic_store(&start_metadata_epoch,epoch+1);
+}
+bool outputs_start_busy(void)
+{ return outputs_start_gate_closed() || (start_active && start_active->writer_pending); }
+static bool start_contexts_drained(void)
+{
+  struct output_device *d;
+  if (room_volume_undrained() || !outputs_airplay_start_all_drained()) return false;
+  for (d=outputs_device_list;d;d=d->next)
+    if (d->session && (!outputs[d->type]->device_start_drained || !outputs[d->type]->device_start_drained(d))) return false;
+  return true;
+}
+#include "outputs_start_journal.inc.c"
+
+static bool start_move_route_current(struct start_slot *,struct output_transport_identity *,bool);
+static bool start_move_reader_current(struct start_slot *,const struct output_transport_identity *,bool);
+
+static bool start_move_old_route_equal(struct output_device *old,const struct output_transport_identity *expected)
+{
+  struct output_transport_identity actual;
+  return old && expected && transport_identity_get(old->id,&actual)==0
+    && transport_identity_equal(&actual,expected);
+}
+
+bool outputs_start_source_owned(void)
+{ return atomic_load(&start_owned_latch); }
+static bool start_completed_writer_current(const struct start_slot *s)
+{
+  uint64_t fd=0;
+  return s && start_unique_writer_fd(&s->result.command.native_process,
+      s->result.pipe_device,s->result.pipe_inode,&fd)
+    && fd==s->result.command.writer_fd;
+}
+bool outputs_start_bound_owner_current(const struct output_native_owner *owner,const struct output_transport_identity *identity,bool active_effect)
+{
+  struct output_transport_identity actual;
+  struct start_slot *s=start_active;
+  if(!outputs_start_source_owned())return true;
+  if(!owner || !identity || outputs_start_busy() || start_journal_fault || !s || s->cancelled
+      || s->result.phase!=OUTPUT_START_COMPLETED || !s->result.actual_owner_present
+      || !native_owner_completed_continuity(owner,&s->result.command.committed_native_owner)
+      || !start_completed_writer_current(s))return false;
+  if(!s->result.command.move_existing_session)
+    {
+      struct output_device *d=outputs_device_get(s->result.command.device_id);
+      struct input_fifo_identity reader={0};struct timespec deadline;
+      if(!transport_identity_equal(identity,&s->result.route_identity)
+          || !d || !d->selected || d->session!=s->session
+          || d->incarnation!=s->result.target_incarnation || d->session_epoch!=s->target_epoch
+          || clock_gettime(CLOCK_MONOTONIC,&deadline)<0)return false;
+      deadline.tv_nsec+=100000000;
+      if(deadline.tv_nsec>=1000000000){deadline.tv_sec++;deadline.tv_nsec-=1000000000;}
+      return input_fifo_owner_get(identity->input_item_id,s->result.command.expected_input_path,false,0,0,&deadline,&reader)==0
+        && reader.device==s->result.pipe_device && reader.inode==s->result.pipe_inode
+        && reader.epoch==s->result.input_epoch
+        && start_completed_writer_current(s);
+    }
+  return start_move_route_current(s,&actual,active_effect)
+    && transport_identity_equal(identity,&actual)
+    && start_move_reader_current(s,&actual,active_effect)
+    && start_completed_writer_current(s);
+}
+
+static bool start_move_request_reader_current(const struct output_start_request *r,
+    const struct output_transport_identity *expected)
+{
+  struct input_fifo_identity reader={0};struct output_transport_identity after;
+  struct stat path;struct timespec deadline;
+  if(!r || !expected || !expected->input_item_id || !start_writer_fd_current(r)
+      || stat(r->expected_input_path,&path)<0 || !S_ISFIFO(path.st_mode)
+      || (uint64_t)path.st_dev!=r->writer_pipe_device || (uint64_t)path.st_ino!=r->writer_pipe_inode
+      || clock_gettime(CLOCK_MONOTONIC,&deadline)<0)return false;
+  deadline.tv_nsec+=100000000;
+  if(deadline.tv_nsec>=1000000000){deadline.tv_sec++;deadline.tv_nsec-=1000000000;}
+  return input_fifo_owner_get(expected->input_item_id,r->expected_input_path,false,0,0,&deadline,&reader)==0
+    && reader.device==r->writer_pipe_device && reader.inode==r->writer_pipe_inode
+    && start_writer_fd_current(r)
+    && transport_identity_get(expected->device_id,&after)==0
+    && transport_identity_equal(&after,expected);
+}
+
+/* Native/C writer-reader proof admits a normal Connect source. A retained
+ * durable START or MOVE owner must agree, or its old native process must be
+ * kernel-proven retired before conditional journal replacement. */
+static bool move_old_owner_current(const struct output_start_request *r,
+    struct output_device **old_out,struct output_transport_identity *identity)
+{
+  uint64_t old_id;struct output_device *old;struct output_transport_identity actual;
+  bool journal_owner,completed_successor=false,move_continuation=false;
+  if(!r || !r->move_existing_session || !r->old_owner_present
+      || start_journal_fault || (start_startup_quarantine && !start_old_process_retired())
+      || !start_writer_fd_current(r)
+      || safe_atou64(r->old_native_owner.homepod_id,&old_id)<0 || !old_id
+      || !(old=outputs_device_get(old_id)) || old_id==r->device_id
+      || !native_owner_valid(&r->old_native_owner,old_id) || !old->session
+      || transport_identity_get(old_id,&actual)<0
+      || strcmp(actual.input_path_digest,r->expected_input_path_digest)
+      || !start_move_request_reader_current(r,&actual)) return false;
+  if(start_active && start_active->result.command.move_existing_session
+      && old_id==start_active->result.command.device_id){
+    struct output_transport_identity continued;
+    move_continuation=start_move_route_current(start_active,&continued,false)
+      && transport_identity_equal(&continued,&actual)
+      && start_move_reader_current(start_active,&continued,false);
+  }
+  journal_owner=start_active && !start_active->cancelled && start_active->result.phase==OUTPUT_START_COMPLETED
+    && !strcmp(start_journal.token,start_active->result.command.token)
+    && !strcmp(start_journal.c_process,outputs_process)
+    && start_active->result.actual_owner_present
+    && native_owner_equal(&r->old_native_owner,&start_active->result.command.committed_native_owner)
+    && !strcmp(r->native_incarnation,start_active->result.command.native_incarnation)
+    && (!start_active->result.command.move_existing_session || move_continuation)
+    && old->session==start_active->session
+    && old->incarnation==start_active->result.target_incarnation
+    && old->session_epoch==start_active->target_epoch;
+  /* A known completed obligation may yield to a new Connect owner in the
+   * same live process only while its exact C output route and input still
+   * exist. This never retires an unknown or in-flight journal by inference. */
+  if(start_active && !start_startup_quarantine && !outputs_start_gate_closed()
+      && !start_active->cancelled && !start_active->writer_pending
+      && start_active->result.phase==OUTPUT_START_COMPLETED
+      && start_active->result.route_present
+      && start_active->result.actual_owner_present
+      && native_owner_completed_continuity(&r->old_native_owner,
+          &start_active->result.command.committed_native_owner)
+      && !strcmp(start_journal.token,start_active->result.command.token)
+      && !strcmp(start_journal.c_process,outputs_process)
+      && !strcmp(start_journal.boot_id,r->native_process.boot_id)
+      && start_journal.pid==r->native_process.pid
+      && start_journal.proc_start_ticks==r->native_process.proc_start_ticks
+      && old->session==start_active->session
+      && old->incarnation==start_active->result.target_incarnation
+      && old->session_epoch==start_active->target_epoch
+      && (start_active->result.command.move_existing_session ? move_continuation
+          : transport_identity_equal(&actual,&start_active->result.route_identity))
+      && start_contexts_drained() && !room_volume_undrained()
+      && !transport_pin && !room_volume_pin_busy())completed_successor=true;
+  /* A fresh joined writer/C reader is the normal Connect path. A retained
+   * journal must be completed and exact, or its old process proven retired. */
+  if(start_journal.token[0] && !journal_owner && !completed_successor && !start_old_process_retired()
+      && !(start_journal_retirement_outcome==OUTPUT_RETIRE_RETIRED_KNOWN
+        && start_journal_retirement_reopen_consumed && !outputs_start_gate_closed()
+        && !outputs_start_source_owned() && !start_startup_quarantine))return false;
+  if(old_out)*old_out=old;
+  if(identity)*identity=actual;
+  return true;
+}
+
+static void start_observe(struct start_slot *s,struct output_start_result *out)
+{
+  s->result.deadline_retired=!start_window(s);
+  s->result.gate_closed=outputs_start_gate_closed();
+  s->result.contexts_drained=start_contexts_drained();
+  s->result.pin_remaining_ms=s->used ? transport_remaining(&s->pin_expiry) : 0;
+  *out=s->result;
+}
+static bool start_old_owner_equal(const struct output_start_request *a,const struct output_start_request *b)
+{ return a->old_owner_present==b->old_owner_present && (!a->old_owner_present || native_owner_equal(&a->old_native_owner,&b->old_native_owner)); }
+static bool start_pipe_registered(const struct output_start_request *r,char digest[65])
+{
+  struct media_file_info *mfi; struct stat st; uint32_t id; size_t i; unsigned char hash[32];
+  static const char hex[]="0123456789abcdef";
+  if (!cfg || cfg_getint(cfg_getsec(cfg,"library"),"pipe_sample_rate")!=44100
+      || cfg_getint(cfg_getsec(cfg,"library"),"pipe_bits_per_sample")!=16 || !r || r->expected_input_path[0]!='/' || !transport_hex(r->expected_input_path_digest,64)
+      || !(id=db_file_id_bypath(r->expected_input_path)) || !(mfi=db_file_fetch_byid(id))) return false;
+  bool valid=mfi->path && !strcmp(mfi->path,r->expected_input_path) && mfi->data_kind==DATA_KIND_PIPE
+
+    && stat(mfi->path,&st)==0 && S_ISFIFO(st.st_mode);
+  if (valid) {
+    gcry_md_hash_buffer(GCRY_MD_SHA256,hash,mfi->path,strlen(mfi->path));
+    for(i=0;i<32;i++) { digest[2*i]=hex[hash[i]>>4];digest[2*i+1]=hex[hash[i]&15]; } digest[64]=0;
+    valid=!strcmp(digest,r->expected_input_path_digest);
+  }
+  free_mfi(mfi,0);return valid;
+}
+
+/* The retired old producer is a durable fact, not a new START grant. This
+ * permits only staging of the existing normal configured PIPE while the
+ * global emission gate remains closed. No old route, PCM or task credit is
+ * restored, and a newer pending/unknown journal always wins. */
+bool outputs_start_retired_normal_staging(const char *path)
+{
+  json_object *o,*v;const char *saved;struct media_file_info *mfi;
+  uint32_t id;bool valid=false;
+  if(!start_retired_reopen_pending || !outputs_start_gate_closed() || outputs_start_source_owned()
+      || start_journal_fault || start_startup_quarantine || !start_contexts_drained()
+      || transport_pin || room_volume_pin_busy() || room_volume_undrained()
+      || !start_journal.token[0] || !start_journal_payload_valid()
+      || start_journal_retirement_outcome!=OUTPUT_RETIRE_RETIRED_KNOWN
+      || (start_active && (strcmp(start_active->result.command.token,start_journal.token)
+          || start_active->retirement.outcome!=OUTPUT_RETIRE_RETIRED_KNOWN)))return false;
+  if(!path)return true; /* Selection can stage, but cannot open the gate. */
+  if(path[0]!='/' || !cfg || cfg_getint(cfg_getsec(cfg,"library"),"pipe_sample_rate")!=44100
+      || cfg_getint(cfg_getsec(cfg,"library"),"pipe_bits_per_sample")!=16)return false;
+  o=json_tokener_parse(start_journal.payload);
+  if(!o || !json_object_is_type(o,json_type_object))goto done;
+  if(!json_object_object_get_ex(o,"input_path",&v) || !json_object_is_type(v,json_type_string))goto done;
+  saved=json_object_get_string(v);
+  if(!saved || strcmp(path,saved) || !(id=db_file_id_bypath(path)) || !(mfi=db_file_fetch_byid(id)))goto done;
+  valid=mfi->path && !strcmp(mfi->path,path) && mfi->data_kind==DATA_KIND_PIPE;
+  free_mfi(mfi,0);
+ done:
+  if(o)json_object_put(o);
+  return valid;
+}
+bool outputs_start_retired_normal_ready(const char *path)
+{return start_retired_stage_ready && outputs_start_retired_normal_staging(path);}
+
+bool outputs_start_retired_stage_reader(void)
+{
+  json_object *o,*v;const char *saved;char path[4096];struct stat st;
+  struct input_fifo_identity staged={0};bool valid=false;
+  start_retired_stage_ready=false;
+  if(!outputs_start_retired_normal_staging(NULL))return false;
+  o=json_tokener_parse(start_journal.payload);
+  if(!o || !json_object_is_type(o,json_type_object))goto done;
+  if(!json_object_object_get_ex(o,"input_path",&v) || !json_object_is_type(v,json_type_string))goto done;
+  saved=json_object_get_string(v);
+  if(!saved || strlen(saved)>=sizeof(path))goto done;
+  memcpy(path,saved,strlen(saved)+1);
+  if(!outputs_start_retired_normal_staging(path) || stat(path,&st)<0 || !S_ISFIFO(st.st_mode)
+      || input_fifo_stage_reader(path,&staged)<0 || staged.device!=(uint64_t)st.st_dev
+      || staged.inode!=(uint64_t)st.st_ino || !outputs_start_retired_normal_staging(path))goto done;
+  memcpy(start_retired_stage_path,path,strlen(path)+1);
+  start_retired_stage_ready=true;valid=true;
+ done:
+  if(!valid && staged.device){struct input_fifo_identity discarded={0};
+    input_fifo_stage_release(path,&discarded);}
+  if(o)json_object_put(o);
