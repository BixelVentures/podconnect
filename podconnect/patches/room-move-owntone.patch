diff --git a/src/inputs/pipe_fifo_barrier.inc.c b/src/inputs/pipe_fifo_barrier.inc.c
new file mode 100644
index 0000000..9ee1e21
--- /dev/null
+++ b/src/inputs/pipe_fifo_barrier.inc.c
@@ -0,0 +1,49 @@
+/* Raw PCM pipe source only. The actual private fd and source evbuf are owned
+ * by this input thread. Writer quiescence is an earlier native owner proof. */
+static int fifo_barrier(struct input_source *source,bool drain,uint64_t expected_device,uint64_t expected_inode,
+    const struct timespec *deadline,struct input_fifo_identity *out)
+{
+  struct pipe *pipe=source->input_ctx;struct stat st;struct timespec now;char bytes[8192];ssize_t n;
+  if(!pipe || pipe->fd<0 || fstat(pipe->fd,&st)<0 || !S_ISFIFO(st.st_mode))return -1;
+  /* An explicitly owned reader must remain open before the paused writer opens. */
+  pipe->is_autostarted=false;
+  if(source->quality.sample_rate!=44100 || source->quality.bits_per_sample!=16 || source->quality.channels!=2)return -1;
+  out->device=(uint64_t)st.st_dev;out->inode=(uint64_t)st.st_ino;
+  if(!drain)return 0;
+  if(out->device!=expected_device || out->inode!=expected_inode)return -1;
+  if(source->evbuf)evbuffer_drain(source->evbuf,evbuffer_get_length(source->evbuf));
+  for(;;){
+    if(clock_gettime(CLOCK_MONOTONIC,&now)<0 || now.tv_sec>deadline->tv_sec
+        || (now.tv_sec==deadline->tv_sec && now.tv_nsec>=deadline->tv_nsec))return -1;
+    n=read(pipe->fd,bytes,sizeof(bytes));
+    if(n>0)continue;
+    if(n<0 && errno==EINTR)continue;
+    if(n<0 && (errno==EAGAIN || errno==EWOULDBLOCK))return 0;
+    /* No writer/EOF is not the promised paused, live descriptor owner. */
+    return -1;
+  }
+}
+
+/* Called only by the exact input-thread retirement command after the native
+ * writer's CloseDone. Unlike fifo_barrier, EOF is an expected terminal read. */
+static int fifo_retire(struct input_source *source,uint64_t expected_device,uint64_t expected_inode,
+    const struct timespec *deadline,struct input_fifo_identity *out)
+{
+  struct pipe *pipe=source->input_ctx;struct stat st;struct timespec now;char bytes[8192];ssize_t n;
+  if(!pipe || pipe->fd<0 || fstat(pipe->fd,&st)<0 || !S_ISFIFO(st.st_mode)
+      || (uint64_t)st.st_dev!=expected_device || (uint64_t)st.st_ino!=expected_inode
+      || source->quality.sample_rate!=44100 || source->quality.bits_per_sample!=16
+      || source->quality.channels!=2)return -1;
+  out->device=(uint64_t)st.st_dev;out->inode=(uint64_t)st.st_ino;
+  if(source->evbuf)evbuffer_drain(source->evbuf,evbuffer_get_length(source->evbuf));
+  for(;;){
+    if(clock_gettime(CLOCK_MONOTONIC,&now)<0 || now.tv_sec>deadline->tv_sec
+        || (now.tv_sec==deadline->tv_sec && now.tv_nsec>=deadline->tv_nsec))return -1;
+    n=read(pipe->fd,bytes,sizeof(bytes));
+    if(n>0)continue;
+    if(n==0)return 0;
+    if(errno==EINTR)continue;
+    if(errno==EAGAIN || errno==EWOULDBLOCK)return 1;
+    return -1;
+  }
+}
