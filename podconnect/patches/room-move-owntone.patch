 }
 
+static bool start_base_deadline(const struct timespec *deadline)
+{
+  struct timespec now;return deadline && clock_gettime(CLOCK_MONOTONIC,&now)==0
+    && (now.tv_sec<deadline->tv_sec || (now.tv_sec==deadline->tv_sec && now.tv_nsec<deadline->tv_nsec));
+}
+int db_bound_base_save(uint64_t id,int volume,const struct timespec *deadline)
+{
+  sqlite3_stmt *stmt=NULL;char device[32];int ret;
+  if(volume<0 || volume>100 || !hdl || !start_base_deadline(deadline)
+      || sqlite3_busy_timeout(hdl,0)!=SQLITE_OK || attention_transaction_begin()<0)return -1;
+  /* This purpose never uses the generic unlock/retry wrappers for the actual
+   * base mutation or COMMIT. LOCKED/BUSY is terminal, with rollback, not a
+   * future SQL retry that could cross the original physical cutoff. */
+  ret=start_base_deadline(deadline) ? sqlite3_prepare_v2(hdl,"INSERT INTO native_attention_base_v1 VALUES(?1,?2) ON CONFLICT(device) DO UPDATE SET volume=excluded.volume",-1,&stmt,NULL) : SQLITE_ABORT;
+  if(ret==SQLITE_OK){
+    snprintf(device,sizeof(device),"%" PRIu64,id);sqlite3_bind_text(stmt,1,device,-1,SQLITE_TRANSIENT);sqlite3_bind_int(stmt,2,volume);
+    ret=start_base_deadline(deadline) ? sqlite3_step(stmt) : SQLITE_ABORT;
+  }
+  if(stmt)sqlite3_finalize(stmt);
+  if(ret==SQLITE_DONE && start_base_deadline(deadline))ret=sqlite3_exec(hdl,"COMMIT",NULL,NULL,NULL);
+  else ret=SQLITE_ABORT;
+  if(ret!=SQLITE_OK){sqlite3_exec(hdl,"ROLLBACK",NULL,NULL,NULL);return -1;}
+  return start_base_deadline(deadline) ? 0 : -1;
+}
+/* Mechanical persistence only: callers must hold their actual purpose token. */
+int db_start_base_save(uint64_t id,int volume,const struct timespec *deadline)
+{ return volume==35 ? db_bound_base_save(id,volume,deadline) : -1; }
+int db_room_volume_base_save(uint64_t id,int volume,const struct timespec *deadline)
+{ return volume>=0 && volume<=100 ? db_bound_base_save(id,volume,deadline) : -1; }
 int
 db_attention_base_save(uint64_t id, int volume)
 {
@@ -7729,6 +7760,9 @@ db_init(char *sqlite_ext_path)
