diff --git a/src/input_fifo_barrier.inc.c b/src/input_fifo_barrier.inc.c
new file mode 100644
index 0000000..dc15ee2
--- /dev/null
+++ b/src/input_fifo_barrier.inc.c
@@ -0,0 +1,138 @@
+/* Executed exclusively on the actual input command base, never the HTTP
+ * worker/player stack touching an input backend's private descriptor. */
+static uint64_t input_fifo_epoch;
+static int input_fifo_staged_fd=-1;
+static uint64_t input_fifo_staged_device,input_fifo_staged_inode;
+static char *input_fifo_staged_path;
+
+struct input_fifo_stage_command {const char *path;struct input_fifo_identity *out;bool release;};
+static enum command_state input_fifo_stage_command(void *arg,int *retval)
+{
+  struct input_fifo_stage_command *c=arg;struct stat st;int fd;
+  *retval=-1;
+  if(!c || !c->path || !c->out)return COMMAND_END;
+  if(c->release){
+    if(input_fifo_staged_fd<0 || !input_fifo_staged_path || strcmp(c->path,input_fifo_staged_path))return COMMAND_END;
+    if(fstat(input_fifo_staged_fd,&st)<0 || !S_ISFIFO(st.st_mode)
+        || (uint64_t)st.st_dev!=input_fifo_staged_device || (uint64_t)st.st_ino!=input_fifo_staged_inode)return COMMAND_END;
+    c->out->device=input_fifo_staged_device;c->out->inode=input_fifo_staged_inode;c->out->epoch=input_fifo_epoch;
+    close(input_fifo_staged_fd);input_fifo_staged_fd=-1;
+    free(input_fifo_staged_path);input_fifo_staged_path=NULL;
+    input_fifo_staged_device=0;input_fifo_staged_inode=0;*retval=0;return COMMAND_END;
+  }
+  if(input_fifo_staged_fd>=0 || input_now_reading.open)return COMMAND_END;
+  fd=open(c->path,O_RDONLY|O_NONBLOCK|O_CLOEXEC);
+  if(fd<0)return COMMAND_END;
+  if(fstat(fd,&st)<0 || !S_ISFIFO(st.st_mode)){close(fd);return COMMAND_END;}
+  input_fifo_staged_path=strdup(c->path);
+  if(!input_fifo_staged_path){close(fd);return COMMAND_END;}
+  input_fifo_staged_fd=fd;input_fifo_staged_device=(uint64_t)st.st_dev;input_fifo_staged_inode=(uint64_t)st.st_ino;
+  c->out->device=input_fifo_staged_device;c->out->inode=input_fifo_staged_inode;c->out->epoch=input_fifo_epoch;
+  *retval=0;return COMMAND_END;
+}
+int input_fifo_stage_reader(const char *path,struct input_fifo_identity *out)
+{
+  struct input_fifo_stage_command c={.path=path,.out=out};
+  return commands_exec_sync(cmdbase,input_fifo_stage_command,NULL,&c);
+}
+int input_fifo_stage_release(const char *path,struct input_fifo_identity *out)
+{
+  struct input_fifo_stage_command c={.path=path,.out=out,.release=true};
+  return commands_exec_sync(cmdbase,input_fifo_stage_command,NULL,&c);
+}
+struct input_fifo_command {
+  uint32_t item_id;const char *path;bool drain;uint64_t device,inode;
+  struct timespec deadline;struct input_fifo_identity *out;
+};
+static bool input_fifo_deadline(const struct timespec *deadline)
+{
+  struct timespec now;
+  return clock_gettime(CLOCK_MONOTONIC,&now)==0 && (now.tv_sec<deadline->tv_sec
+    || (now.tv_sec==deadline->tv_sec && now.tv_nsec<deadline->tv_nsec));
+}
+static enum command_state input_fifo_command(void *arg,int *retval)
+{
+  struct input_fifo_command *c=arg;struct input_source *source=&input_now_reading;
+  *retval=-1;
+  if (!c->out || !input_fifo_deadline(&c->deadline) || source->type!=INPUT_TYPE_PIPE || !source->open
+      || source->item_id!=c->item_id || !source->path || strcmp(source->path,c->path)
+      || !inputs[source->type]->fifo_barrier || (c->drain && input_fifo_epoch==UINT64_MAX))return COMMAND_END;
+  /* This command's input event cannot interleave while the descriptor and
+   * source evbuf are drained. The shared PCM flush takes its existing mutex. */
+  if(inputs[source->type]->fifo_barrier(source,c->drain,c->device,c->inode,&c->deadline,c->out)<0)return COMMAND_END;
+  if(c->drain){flush(NULL);input_fifo_epoch++;}
+  c->out->epoch=input_fifo_epoch;
+  *retval=input_fifo_deadline(&c->deadline) ? 0 : -1;return COMMAND_END;
+}
+int input_fifo_owner_get(uint32_t item,const char *path,bool drain,uint64_t device,uint64_t inode,
+    const struct timespec *deadline,struct input_fifo_identity *out)
+{
+  if(!path || !deadline || !out)return -1;
+  struct input_fifo_command command={.item_id=item,.path=path,.drain=drain,.device=device,.inode=inode,.deadline=*deadline,.out=out};
+  return commands_exec_sync(cmdbase,input_fifo_command,NULL,&command);
+}
+
+struct input_fifo_retire_command {
+  uint32_t item_id;const char *path;uint64_t device,inode,epoch;
+  struct timespec deadline;struct input_fifo_identity *out;
+};
+static enum command_state input_fifo_retire_exact(void *arg,int *retval)
+{
+  struct input_fifo_retire_command *c=arg;struct input_source *source=&input_now_reading;
+  int drained;
+  *retval=-1;
+  if(!c->out || !input_fifo_deadline(&c->deadline) || source->type!=INPUT_TYPE_PIPE
+      || !source->open || source->item_id!=c->item_id || !source->path
+      || strcmp(source->path,c->path) || !c->device || !c->inode || !c->epoch
+      || input_fifo_epoch!=c->epoch || input_fifo_epoch==UINT64_MAX
+      || !inputs[source->type]->fifo_retire)return COMMAND_END;
+  /* The backend descriptor and source evbuf are only touched on cmdbase.
+   * Its read callback cannot interleave with this command. */
+  drained=inputs[source->type]->fifo_retire(source,c->device,c->inode,&c->deadline,c->out);
+  if(drained<0 || !input_fifo_deadline(&c->deadline))return COMMAND_END;
+  flush(NULL); /* shared PCM plus pending metadata/EOF/START_NEXT markers */
+  input_fifo_epoch++;
+  c->out->epoch=input_fifo_epoch;
+  stop(); /* closes the exact current reader; never opens another input */
+  *retval=drained;
+  return COMMAND_END;
+}
+int input_fifo_retire(uint32_t item,const char *path,uint64_t device,uint64_t inode,uint64_t expected_epoch,
+    const struct timespec *deadline,struct input_fifo_identity *out)
+{
+  if(!path || !deadline || !out)return -1;
+  struct input_fifo_retire_command command={.item_id=item,.path=path,.device=device,.inode=inode,
+    .epoch=expected_epoch,.deadline=*deadline,.out=out};
+  return commands_exec_sync(cmdbase,input_fifo_retire_exact,NULL,&command);
+}
+
+struct input_fifo_start_command {uint32_t item_id;const char *path;struct timespec deadline;};
+static enum command_state input_fifo_start_exact(void *arg,int *retval)
+{
+  struct input_fifo_start_command *c=arg;struct db_queue_item *qi;
+  *retval=-1;
+  if(!input_fifo_deadline(&c->deadline))return COMMAND_END;
+  qi=db_queue_fetch_byitemid(c->item_id);
+  if(!qi)return COMMAND_END;
+  if(qi->data_kind!=DATA_KIND_PIPE || !qi->path || strcmp(qi->path,c->path) || !input_fifo_deadline(&c->deadline)){
+    free_queue_item(qi,0);return COMMAND_END;
+  }
+  /* The actual input-thread mutator checks after queue and database latency.
+   * It never falls back to a later queue item or starts an output session. */
+  if(input_now_reading.open)stop();
+  if(!input_fifo_deadline(&c->deadline)){free_queue_item(qi,0);return COMMAND_END;}
+  int ret=setup(&input_now_reading,qi,0);free_queue_item(qi,0);
+  if(ret<0)return COMMAND_END;
+  struct input_fifo_identity identity={0};
+  if(!inputs[input_now_reading.type]->fifo_barrier
+      || inputs[input_now_reading.type]->fifo_barrier(&input_now_reading,false,0,0,&c->deadline,&identity)<0){stop();return COMMAND_END;}
+  if(!input_fifo_deadline(&c->deadline)){stop();return COMMAND_END;}
+  event_add(input_open_timeout_ev,&input_open_timeout);event_active(input_ev,0,0);
+  *retval=ret;return COMMAND_END;
+}
+int input_start_fifo_exact(uint32_t item,const char *path,const struct timespec *deadline)
+{
+  if(!path || !deadline)return -1;
+  struct input_fifo_start_command c={.item_id=item,.path=path,.deadline=*deadline};
+  return commands_exec_sync(cmdbase,input_fifo_start_exact,NULL,&c);
+}
