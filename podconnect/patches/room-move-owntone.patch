+  if(input_fifo_stage_release(start_retired_stage_path,&released)<0)return false;
+  start_retired_stage_ready=false;start_retired_stage_path[0]=0;
+  return true;
+}
+/* A completed MOVE owns this exact AirPlay session while a normal phone
+ * context may advance the item on the same registered FIFO. Each new input
+ * generation must join the actual input reader to the still-live native
+ * writer before any RTP can be emitted. START and OPENED keep exact identity. */
