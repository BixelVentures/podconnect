diff --git a/src/db_start_guard.inc.c b/src/db_start_guard.inc.c
new file mode 100644
index 0000000..36cd9d9
--- /dev/null
+++ b/src/db_start_guard.inc.c
@@ -0,0 +1,38 @@
+/* Separate START owner journal. No delete API: completed FIFO owners remain
+ * quarantined across C restart until actual old process retirement is proved. */
+int db_start_guard_schema_init(void)
+{
+  if(attention_transaction_begin()<0)return -1;
+  return attention_transaction_end(attention_sql(sqlite3_mprintf(
+    "CREATE TABLE IF NOT EXISTS native_start_guard_v1 (singleton INTEGER PRIMARY KEY CHECK(singleton=1),token TEXT NOT NULL,c_process TEXT NOT NULL,boot_id TEXT NOT NULL,pid TEXT NOT NULL,start_ticks TEXT NOT NULL,payload TEXT NOT NULL)")));
+}
+int db_start_guard_load(struct db_start_guard *out)
+{
+  sqlite3_stmt *stmt=NULL;int ret;const char *text;char *end;
+  if(!out)return -1;
+  memset(out,0,sizeof(*out));
+  if(attention_query(sqlite3_mprintf("SELECT token,c_process,boot_id,pid,start_ticks,payload FROM native_start_guard_v1 WHERE singleton=1"),&stmt)<0)return -1;
+  ret=db_blocking_step(stmt);
+  if(ret==SQLITE_DONE){sqlite3_finalize(stmt);return 0;}
+  if(ret!=SQLITE_ROW)goto fail;
+  text=(const char *)sqlite3_column_text(stmt,0);if(!text || strlen(text)!=32)goto fail;memcpy(out->token,text,33);
+  text=(const char *)sqlite3_column_text(stmt,1);if(!text || strlen(text)!=36)goto fail;memcpy(out->c_process,text,37);
+  text=(const char *)sqlite3_column_text(stmt,2);if(!text || strlen(text)!=36)goto fail;memcpy(out->boot_id,text,37);
+  text=(const char *)sqlite3_column_text(stmt,3);if(!text || !*text || *text<'1' || *text>'9')goto fail;
+  errno=0;out->pid=strtoull(text,&end,10);if(errno || *end || !out->pid)goto fail;
+  text=(const char *)sqlite3_column_text(stmt,4);if(!text || !*text || *text<'1' || *text>'9')goto fail;
+  errno=0;out->proc_start_ticks=strtoull(text,&end,10);if(errno || *end || !out->proc_start_ticks)goto fail;
+  text=(const char *)sqlite3_column_text(stmt,5);if(!text || !(out->payload=strdup(text)))goto fail;
+  sqlite3_finalize(stmt);return 1;
+ fail:
+  sqlite3_finalize(stmt);free(out->payload);out->payload=NULL;return -1;
+}
+int db_start_guard_save(const struct db_start_guard *expected,const struct db_start_guard *r)
+{
+  int ret;
+  if(!r || !r->payload || !expected || attention_transaction_begin()<0)return -1;
+  if(!expected->token[0])ret=attention_sql(sqlite3_mprintf("INSERT INTO native_start_guard_v1 VALUES(1,%Q,%Q,%Q,'%" PRIu64 "','%" PRIu64 "',%Q)",r->token,r->c_process,r->boot_id,r->pid,r->proc_start_ticks,r->payload));
+  else ret=attention_sql(sqlite3_mprintf("UPDATE native_start_guard_v1 SET token=%Q,c_process=%Q,boot_id=%Q,pid='%" PRIu64 "',start_ticks='%" PRIu64 "',payload=%Q WHERE singleton=1 AND token=%Q AND c_process=%Q AND boot_id=%Q AND pid='%" PRIu64 "' AND start_ticks='%" PRIu64 "' AND payload=%Q",r->token,r->c_process,r->boot_id,r->pid,r->proc_start_ticks,r->payload,expected->token,expected->c_process,expected->boot_id,expected->pid,expected->proc_start_ticks,expected->payload));
+  if(ret==0 && sqlite3_changes(hdl)!=1)ret=-1;
+  return attention_transaction_end(ret);
+}
