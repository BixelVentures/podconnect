+  const char *path;struct timespec deadline;struct db_queue_item *qi=NULL;struct query_params qp={.type=Q_ITEMS};
+  struct input_fifo_identity actual={0};struct player_source *ps;uint32_t file;int item,ret;
+  if(!outputs_start_source_current(token,&path,&deadline) || !(file=db_file_id_bypath(path)))return -1;
+  qi=db_queue_fetch_byfileid(file);
+  if(!qi){qp.id=file;if(db_queue_add_by_query(&qp,0,0,-1,NULL,&item)<0)return -1;qi=db_queue_fetch_byitemid(item);}
+  if(!qi || qi->data_kind!=DATA_KIND_PIPE || !qi->path || strcmp(qi->path,path)){free_queue_item(qi,0);return -1;}
+  if(!outputs_start_source_current(token,NULL,NULL)){free_queue_item(qi,0);return -1;}
+  pb_timer_stop();outputs_transport_input_changed(0,NULL,false);
+  ps=source_create(qi,0);free_queue_item(qi,0);session_start(ps);
+  ret=input_start_fifo_exact(ps->item_id,path,&deadline); /* Actual input owner checks after queue/DB latency; no fallback. */
+  if(ret<0 || !outputs_start_source_current(token,NULL,NULL))return -1;
+  session_update_read_start((uint32_t)ret);
+  outputs_transport_input_changed(ps->item_id,ps->path,true);
+  player_state=PLAY_PLAYING;
+  if(pb_timer_start()<0)return -1; /* Harmlessly drains even with every output gated. */
+  if(input_fifo_owner_get(ps->item_id,path,false,0,0,&deadline,&actual)<0)return -1;
+  if(!outputs_start_retired_stage_release_for_start())return -1;
+  if(input_fifo_owner_get(ps->item_id,path,false,actual.device,actual.inode,&deadline,&actual)<0
+      || !outputs_start_source_current(token,NULL,NULL))return -1;
+  return outputs_start_reader_ready(token,actual.device,actual.inode);
+}
+static int start_input_barrier(const struct output_start_request *r)
+{
+  const char *path;struct timespec deadline;struct input_fifo_identity actual={0};struct player_source *ps=pb_session.playing_now;
+  if(!outputs_start_source_current(r->token,&path,&deadline) || !ps || ps!=pb_session.source_list || ps!=pb_session.reading_now
+      || ps->data_kind!=DATA_KIND_PIPE || !ps->path || strcmp(ps->path,path))return -1;
+  if(input_fifo_owner_get(ps->item_id,path,true,r->pipe_device,r->pipe_inode,&deadline,&actual)<0)return -1;
+  if(!outputs_start_source_current(r->token,NULL,NULL))return -1;
+  if(pb_session.buffer && pb_session.bufsize)memset(pb_session.buffer,0,pb_session.bufsize);
+  pb_session.read_deficit=0;pb_write_recovery=false;
+  outputs_transport_input_changed(ps->item_id,ps->path,true);
+  return outputs_start_barrier_done(r->token,actual.epoch);
+}
+struct player_start_command {
+  int action;uint64_t id;const struct output_start_request *request;const char *token,*reservation;
+  struct output_start_state *state;struct output_start_result *result;
+  const struct output_retirement_request *retirement_request;
+  struct output_retirement_result *retirement_result;bool move;
+};
+static bool move_source_current(const struct output_start_request *r,bool writer_required)
+{
+  const struct player_source *ps=pb_session.playing_now;
+  struct input_fifo_identity actual={0};struct timespec deadline;
+  if(!(r && r->move_existing_session && ps && ps==pb_session.reading_now
+    && ps->data_kind==DATA_KIND_PIPE && ps->path && !strcmp(ps->path,r->expected_input_path)
+    && (!r->source_pointer || (ps==r->source_pointer && ps->item_id==r->source_item_id))
+    && (player_state==PLAY_PAUSED || player_state==PLAY_PLAYING)
+    && (!r->source_pointer || (player_state==PLAY_PAUSED)==r->source_paused)))return false;
+  if(!writer_required)return true;
+  if(clock_gettime(CLOCK_MONOTONIC,&deadline)<0)return false;
+  deadline.tv_sec++;
+  return input_fifo_owner_get(ps->item_id,ps->path,false,0,0,&deadline,&actual)==0
+    && actual.device==r->writer_pipe_device && actual.inode==r->writer_pipe_inode;
+}
+static enum command_state start_command(void *arg,int *retval)
+{
+  struct player_start_command *c=arg;struct output_start_result observed;
+  if(c->action==0){
+    *retval=c->request->move_existing_session && !move_source_current(c->request,true) ? -1 : outputs_start_state_get(c->request,c->state);
+    if(!*retval && c->request->move_existing_session)c->state->paused=player_state==PLAY_PAUSED;
+  }
+  else if(c->action==1){
+    struct output_start_request local=*c->request;
+    if(local.move_existing_session){
+      if(!move_source_current(&local,true)){*retval=-1;return COMMAND_END;}
+      local.source_pointer=pb_session.playing_now;local.source_item_id=pb_session.playing_now->item_id;
+      local.source_paused=player_state==PLAY_PAUSED;
+    }
+    *retval=outputs_start_prepare(&local,c->result);
+  }
+  else if(c->action==2){
+    if(c->request->move_existing_session && (outputs_start_result_get(c->request->device_id,c->request->token,&observed)<0
+        || !move_source_current(&observed.command,true))){*retval=-1;return COMMAND_END;}
+    *retval=outputs_start_commit(c->request,c->result);
+    if(!*retval && c->result->phase==OUTPUT_START_GATE_DRAINING){
+      if(c->request->move_existing_session){
+        struct input_fifo_identity fd={0};struct timespec deadline;
+        const char *path=NULL;struct player_source *ps=pb_session.playing_now;
+        pb_timer_stop(); /* Retain this source and its exact timeline at quiescence. */
+        if(!move_source_current(&observed.command,true) || !outputs_start_source_current(c->request->token,&path,&deadline)
+            || input_fifo_owner_get(ps->item_id,path,false,0,0,&deadline,&fd)<0
+            || outputs_start_reader_ready(c->request->token,fd.device,fd.inode)<0)
+          outputs_start_cancel(c->request->token,c->request->native_reservation_id,&observed);
+      }else if(start_reader_install(c->request->token)<0)outputs_start_cancel(c->request->token,c->request->native_reservation_id,&observed);
+      outputs_start_result_get(c->request->device_id,c->request->token,c->result);
+    }
+  } else if(c->action==3){
+    if(c->request->move_existing_session && (outputs_start_result_get(c->request->device_id,c->request->token,&observed)<0
+        || !move_source_current(&observed.command,false))){*retval=-1;return COMMAND_END;}
+    *retval=outputs_start_barrier_begin(c->request,c->result);
+    if(!*retval){
+      if(start_input_barrier(c->request)<0)outputs_start_cancel(c->request->token,c->request->native_reservation_id,&observed);
+      outputs_start_result_get(c->request->device_id,c->request->token,c->result);
+    }
+  } else if(c->action==4){
+    if(c->request->move_existing_session && (outputs_start_result_get(c->request->device_id,c->request->token,&observed)<0
+        || !move_source_current(&observed.command,false))){*retval=-1;return COMMAND_END;}
+    *retval=outputs_start_open(c->request,c->result);
+    if(!*retval && c->request->move_existing_session && !observed.command.source_paused
+        && pb_timer_start()<0){
+      /* OPEN already changed the guarded route. A failed retained timer must
+       * synchronously close the gate and retire the target session. */
+      outputs_start_cancel(c->request->token,c->request->native_reservation_id,&observed);
+      *retval=-1;
+    }
+  }
+  else if(c->action==7){
+    struct timespec read_deadline;struct input_fifo_identity fd={0};struct player_source *ps=pb_session.playing_now;
+    *retval=-1;
+    if(outputs_start_result_get(c->request->device_id,c->request->token,&observed)<0 || !ps || ps!=pb_session.reading_now
+        || (c->request->move_existing_session && !move_source_current(&observed.command,false))
+        || !ps->path || strcmp(ps->path,observed.command.expected_input_path) || clock_gettime(CLOCK_MONOTONIC,&read_deadline)<0)return COMMAND_END;
+    read_deadline.tv_sec++; /* Read-only FD proof budget, no physical deadline renewal. */
+    if(input_fifo_owner_get(ps->item_id,ps->path,false,0,0,&read_deadline,&fd)<0
+        || fd.device!=observed.pipe_device || fd.inode!=observed.pipe_inode)return COMMAND_END;
+    *retval=outputs_start_complete(c->request,c->result);
+  }
+  else if(c->action==5)*retval=outputs_start_cancel(c->token,c->reservation,c->result);
+  else if(c->action==8)*retval=outputs_retirement_prepare(c->retirement_request,c->retirement_result);
+  else if(c->action==9){
+    *retval=outputs_retirement_complete(c->retirement_request,c->retirement_result);
+    if(!*retval && c->retirement_result->durable_terminal){
+      /* The input owner has closed the old reader and flushed its PCM. Retire
+       * the corresponding C player source before a fresh normal admission. */
+      pb_timer_stop();pb_session_stop();status_update(PLAY_STOPPED,LISTENER_PLAYER);
+      /* A separate read-only FIFO FD must exist before a new Native App opens
+       * O_WRONLY|O_NONBLOCK. It reads no old bytes and keeps the gate closed. */
+      outputs_start_retired_stage_reader();
+      outputs_retirement_result_get(c->retirement_request->device_id,
+        c->retirement_request->move_existing_session,c->retirement_request->retirement_token,c->retirement_result);
+    }
+  }
+  else if(c->action==10)*retval=outputs_retirement_result_get(c->id,c->move,c->token,c->retirement_result);
+  else *retval=outputs_start_result_get(c->id,c->token,c->result);
+  return COMMAND_END;
+}
+int player_start_state_get(const struct output_start_request *r,struct output_start_state *out)
+{struct player_start_command c={.action=0,.request=r,.state=out};return commands_exec_sync(cmdbase,start_command,NULL,&c);}
+int player_start_prepare(const struct output_start_request *r,struct output_start_result *out)
+{struct player_start_command c={.action=1,.request=r,.result=out};return commands_exec_sync(cmdbase,start_command,NULL,&c);}
+int player_start_commit(const struct output_start_request *r,struct output_start_result *out)
+{struct player_start_command c={.action=2,.request=r,.result=out};return commands_exec_sync(cmdbase,start_command,NULL,&c);}
+int player_start_barrier(const struct output_start_request *r,struct output_start_result *out)
+{struct player_start_command c={.action=3,.request=r,.result=out};return commands_exec_sync(cmdbase,start_command,NULL,&c);}
+int player_start_open(const struct output_start_request *r,struct output_start_result *out)
+{struct player_start_command c={.action=4,.request=r,.result=out};return commands_exec_sync(cmdbase,start_command,NULL,&c);}
+int player_start_cancel(const char *t,const char *res,struct output_start_result *out)
+{struct player_start_command c={.action=5,.token=t,.reservation=res,.result=out};return commands_exec_sync(cmdbase,start_command,NULL,&c);}
+int player_start_result_get(uint64_t id,const char *t,struct output_start_result *out)
+{struct player_start_command c={.action=6,.id=id,.token=t,.result=out};return commands_exec_sync(cmdbase,start_command,NULL,&c);}
+
+int player_start_complete(const struct output_start_request *r,struct output_start_result *out)
+{struct player_start_command c={.action=7,.request=r,.result=out};return commands_exec_sync(cmdbase,start_command,NULL,&c);}
+int player_retirement_prepare(const struct output_retirement_request *r,struct output_retirement_result *out)
+{struct player_start_command c={.action=8,.retirement_request=r,.retirement_result=out};return commands_exec_sync(cmdbase,start_command,NULL,&c);}
+int player_retirement_complete(const struct output_retirement_request *r,struct output_retirement_result *out)
+{struct player_start_command c={.action=9,.retirement_request=r,.retirement_result=out};return commands_exec_sync(cmdbase,start_command,NULL,&c);}
+int player_retirement_result_get(uint64_t id,bool move,const char *token,struct output_retirement_result *out)
+{struct player_start_command c={.action=10,.id=id,.move=move,.token=token,.retirement_result=out};return commands_exec_sync(cmdbase,start_command,NULL,&c);}
diff --git a/src/proc_native_scope.inc.c b/src/proc_native_scope.inc.c
new file mode 100644
index 0000000..160d6e0
--- /dev/null
+++ b/src/proc_native_scope.inc.c
@@ -0,0 +1,137 @@
+/* Included only in the output owner's translation unit. Mechanical per-thread
+ * scope for its generated numeric /proc proofs; no path/callback/authority API.
+ * Caller uses a zero-initialized stack object, closes ALL proc handles before
+ * leave, and rechecks its original deadline/current owner AFTER leave. */
+#include <pthread.h>
+#include <signal.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <string.h>
+#include <sys/types.h>
+#include <unistd.h>
+#ifdef __linux__
+# include <linux/capability.h>
+# include <sys/syscall.h>
+#endif
+
+struct proc_native_scope {
+  bool guarded, credentials_saved;
+  int old_cancel_state;
+  sigset_t old_signal_mask;
+#ifdef __linux__
+  uid_t old_fsuid, old_euid;
+  gid_t old_fsgid, old_egid;
+  long owner_tid;
+  struct __user_cap_data_struct old_caps[2];
+#endif
+};
+
+#ifdef __linux__
+static _Noreturn void proc_native_scope_fatal(void)
+{
+  /* Restoration failure must never return, log, or admit another effect. */
+  syscall(SYS_exit_group, 125);
+  __builtin_trap();
+}
+static bool proc_native_scope_caps_get(struct __user_cap_data_struct caps[2])
+{
+  struct __user_cap_header_struct header = { .version = _LINUX_CAPABILITY_VERSION_3, .pid = 0 };
+  return syscall(SYS_capget, &header, caps) == 0;
+}
+static bool proc_native_scope_caps_set(const struct __user_cap_data_struct caps[2])
+{
+  struct __user_cap_header_struct header = { .version = _LINUX_CAPABILITY_VERSION_3, .pid = 0 };
+  return syscall(SYS_capset, &header, caps) == 0;
+}
+static bool proc_native_scope_caps_equal(const struct __user_cap_data_struct a[2], const struct __user_cap_data_struct b[2])
+{
+  size_t i;
+  for (i = 0; i < 2; i++)
+    if (a[i].effective != b[i].effective || a[i].permitted != b[i].permitted || a[i].inheritable != b[i].inheritable)
+      return false;
+  return true;
+}
+#endif
+
+static void proc_native_scope_leave(struct proc_native_scope *scope)
+{
+#ifdef __linux__
+  struct __user_cap_data_struct now[2];
+  int cancel_state;
+  if (!scope || !scope->guarded || syscall(SYS_gettid) != scope->owner_tid)
+    proc_native_scope_fatal();
+  if (scope->credentials_saved) {
+    /* FS transitions can alter effective filesystem capability bits. Restore
+     * FS IDs FIRST and the exact saved capability words LAST. */
+    syscall(SYS_setfsgid, scope->old_fsgid);
+    syscall(SYS_setfsuid, scope->old_fsuid);
+    if (!proc_native_scope_caps_set(scope->old_caps)
+        || (uid_t)syscall(SYS_setfsuid, (uid_t)-1) != scope->old_fsuid
+        || (gid_t)syscall(SYS_setfsgid, (gid_t)-1) != scope->old_fsgid
+        || geteuid() != scope->old_euid || getegid() != scope->old_egid
+        || !proc_native_scope_caps_get(now) || !proc_native_scope_caps_equal(now, scope->old_caps))
+      proc_native_scope_fatal();
+  }
+  scope->credentials_saved = false;
+  scope->guarded = false;
+  if (pthread_sigmask(SIG_SETMASK, &scope->old_signal_mask, NULL) != 0)
+    proc_native_scope_fatal();
+  cancel_state = scope->old_cancel_state;
+  if (pthread_setcancelstate(cancel_state, NULL) != 0)
+    proc_native_scope_fatal();
+#else
+  (void)scope;
+#endif
+}
+
+static bool proc_native_scope_enter(struct proc_native_scope *scope)
+{
+#ifdef __linux__
+  struct __user_cap_data_struct raised[2], now[2];
+  sigset_t blocked;
+  size_t i;
+  if (!scope) return false;
+  if (scope->guarded) proc_native_scope_fatal();
+  if (pthread_setcancelstate(PTHREAD_CANCEL_DISABLE, &scope->old_cancel_state) != 0) return false;
+  if (sigfillset(&blocked) != 0 || pthread_sigmask(SIG_BLOCK, &blocked, &scope->old_signal_mask) != 0) {
+    if (pthread_setcancelstate(scope->old_cancel_state, NULL) != 0) proc_native_scope_fatal();
+    return false;
+  }
+  scope->owner_tid = syscall(SYS_gettid);
+  if (scope->owner_tid <= 0) {
+    if (pthread_sigmask(SIG_SETMASK, &scope->old_signal_mask, NULL) != 0)
+      proc_native_scope_fatal();
+    if (pthread_setcancelstate(scope->old_cancel_state, NULL) != 0)
+      proc_native_scope_fatal();
+    return false;
+  }
+  scope->guarded = true;
+  scope->old_fsuid = (uid_t)syscall(SYS_setfsuid, (uid_t)-1);
+  scope->old_fsgid = (gid_t)syscall(SYS_setfsgid, (gid_t)-1);
+  scope->old_euid = geteuid();
+  scope->old_egid = getegid();
+  if (!proc_native_scope_caps_get(scope->old_caps)) {
+    proc_native_scope_leave(scope);
+    return false;
+  }
+  scope->credentials_saved = true;
+  memcpy(raised, scope->old_caps, sizeof(raised));
+  for (i = 0; i < 2; i++) raised[i].effective = raised[i].permitted;
+  /* No new permitted, inheritable or bounding capability is requested. In
+   * particular this helper never requests an added CAP_SYS_PTRACE. */
+  syscall(SYS_setfsgid, 0);
+  syscall(SYS_setfsuid, 0);
+  if (!proc_native_scope_caps_set(raised)
+      || (uid_t)syscall(SYS_setfsuid, (uid_t)-1) != 0
+      || (gid_t)syscall(SYS_setfsgid, (gid_t)-1) != 0
+      || geteuid() != scope->old_euid || getegid() != scope->old_egid
+      || !proc_native_scope_caps_get(now) || !proc_native_scope_caps_equal(now, raised)) {
+    proc_native_scope_leave(scope);
+    return false;
+  }
+  return true;
+#else
+  (void)scope;
+  return false;
+#endif
+}
