diff --git a/src/httpd_jsonapi_move.inc.c b/src/httpd_jsonapi_move.inc.c
new file mode 100644
index 0000000..8f183ed
--- /dev/null
+++ b/src/httpd_jsonapi_move.inc.c
@@ -0,0 +1,126 @@
+/* Private retained-session MOVE purpose. The public/manager wire does not use
+ * these C tokens, process identities, FIFO descriptors or route receipts. */
+static json_object *move_result_json(const char *endpoint,const struct output_start_result *r)
+{
+  json_object *o=json_object_new_object(),*pipe=NULL;char schema[96];
+  snprintf(schema,sizeof(schema),"podconnect.output_move_%s.v1",endpoint);
+  json_object_object_add(o,"schema",json_object_new_string(schema));
+  json_object_object_add(o,"ok",json_object_new_boolean(true));
+  json_object_object_add(o,"token",json_object_new_string(r->command.token));
+  json_object_object_add(o,"offer_id",json_object_new_string(r->command.offer_id));
+  json_object_object_add(o,"binding_id",json_object_new_string(r->command.binding_id));
+  json_object_object_add(o,"native_incarnation",json_object_new_string(r->command.native_incarnation));
+  attention_json_u64(o,"native_revision",r->command.native_revision);
+  json_object_object_add(o,"native_reservation_id",json_object_new_string(r->command.native_reservation_id));
+  json_object_object_add(o,"policy_revision",json_object_new_string(r->command.policy_revision));
+  json_object_object_add(o,"session_volume_percent",json_object_new_int(r->session_volume_percent));
+  attention_json_u64(o,"old_base_revision",r->old_base_revision);
+  attention_json_u64(o,"target_base_revision",r->target_base_revision);
+  json_object_object_add(o,"old_native_owner",transport_native_json(&r->command.old_native_owner));
+  json_object_object_add(o,"intended_native_owner",transport_native_json(&r->command.intended_native_owner));
+  json_object_object_add(o,"actual_native_owner",r->actual_owner_present ? transport_native_json(&r->command.committed_native_owner) : NULL);
+  json_object_object_add(o,"old_route_identity",transport_identity_json(&r->old_route_identity));
+  json_object_object_add(o,"target_identity",start_target_json(r->process,r->command.device_id,r->target_incarnation));
+  json_object_object_add(o,"route_identity",r->route_present ? transport_identity_json(&r->route_identity) : NULL);
+  json_object_object_add(o,"input_path_digest",json_object_new_string(r->input_path_digest));
+  if(r->pipe_present){pipe=json_object_new_object();attention_json_u64(pipe,"device",r->pipe_device);attention_json_u64(pipe,"inode",r->pipe_inode);json_object_object_add(pipe,"type",json_object_new_string("fifo"));}
+  json_object_object_add(o,"pipe_identity",pipe);
+  attention_json_u64(o,"input_epoch",r->input_epoch);
+  attention_json_u64(o,"writer_source_epoch",r->writer_source_epoch);
+  json_object_object_add(o,"phase",json_object_new_string(start_phase_name(r->phase)));
+  json_object_object_add(o,"possible_effect",json_object_new_boolean(r->possible_effect));
+  json_object_object_add(o,"contexts_drained",json_object_new_boolean(r->contexts_drained));
+  json_object_object_add(o,"gate_closed",json_object_new_boolean(r->gate_closed));
+  json_object_object_add(o,"deadline_retired",json_object_new_boolean(r->deadline_retired));
+  json_object_object_add(o,"pin_remaining_ms",json_object_new_int(r->pin_remaining_ms));
+  json_object_object_add(o,"expires_after_ms",json_object_new_int(8000));
+  json_object_object_add(o,"physical_result_verified",json_object_new_boolean(false));
+  return o;
+}
+static int move_json_writer(json_object *body,struct output_start_request *r)
+{
+  return transport_native_counter(body,"writer_fd",&r->writer_fd)<0 || r->writer_fd>INT_MAX
+    || transport_native_counter(body,"writer_pipe_device",&r->writer_pipe_device)<0 || !r->writer_pipe_device
+    || transport_native_counter(body,"writer_pipe_inode",&r->writer_pipe_inode)<0 || !r->writer_pipe_inode ? -1 : 0;
+}
+static int jsonapi_reply_move_write(struct httpd_request *hreq)
+{
+  const char *phase=hreq->path_parts[4];struct output_start_request r={.move_existing_session=true};
+  struct output_start_result result;struct output_start_state state;json_object *body,*value,*reply;int ret=HTTP_BADREQUEST;
+  body=transport_parse_body_limit(hreq->in_body,16384);
+  if(!body || safe_atou64(hreq->path_parts[2],&r.device_id)<0 || !r.device_id)goto out;
+  if(!strcmp(phase,"state")){
+    if(json_object_object_length(body)!=8 || start_json_common(body,&r,false,true)<0 || !r.old_owner_present
+        || move_json_writer(body,&r)<0)goto out;
+    ret=409;if(player_start_state_get(&r,&state)<0)goto out;
+    reply=json_object_new_object();
+    json_object_object_add(reply,"schema",json_object_new_string("podconnect.output_move_state.v1"));
+    json_object_object_add(reply,"ok",json_object_new_boolean(true));
+    json_object_object_add(reply,"ready",json_object_new_boolean(state.ready));
+    json_object_object_add(reply,"busy",json_object_new_boolean(state.busy));
+    json_object_object_add(reply,"policy_revision",json_object_new_string(OUTPUT_MOVE_POLICY));
+    json_object_object_add(reply,"session_volume_percent",json_object_new_int(state.session_volume_percent));
+    attention_json_u64(reply,"old_base_revision",state.old_base_revision);
+    attention_json_u64(reply,"target_base_revision",state.target_base_revision);
+    json_object_object_add(reply,"old_route_identity",transport_identity_json(&state.old_route_identity));
+    json_object_object_add(reply,"target_identity",start_target_json(state.process,state.device_id,state.device_incarnation));
+    json_object_object_add(reply,"input_path_digest",json_object_new_string(r.expected_input_path_digest));
+    json_object_object_add(reply,"paused",json_object_new_boolean(state.paused));
+    json_object_object_add(reply,"physical_result_verified",json_object_new_boolean(false));
+    ret=transport_json_reply(hreq,reply);goto out;
+  }
+  if(!strcmp(phase,"prepare") || !strcmp(phase,"commit")){
+    bool prepare=!strcmp(phase,"prepare");
+    if(json_object_object_length(body)!=(prepare?13:8)
+        || start_json_common(body,&r,prepare,false)<0 || !r.old_owner_present
+        || !transport_json_string(body,"offer_id",r.offer_id,sizeof(r.offer_id))
+        || !transport_json_string(body,"binding_id",r.binding_id,sizeof(r.binding_id))
+        || transport_native_counter(body,"native_revision",&r.native_revision)<0 || !r.native_revision || r.native_revision==UINT64_MAX)goto out;
+    if(prepare){
+      if(move_json_writer(body,&r)<0 || start_json_owner(body,"intended_native_owner",&r.intended_native_owner,false,NULL)<0
+          || !transport_json_string(body,"policy_revision",r.policy_revision,sizeof(r.policy_revision)))goto out;
+    }else{
+      if(!transport_json_string(body,"token",r.token,sizeof(r.token))
+          || !transport_json_string(body,"native_reservation_id",r.native_reservation_id,sizeof(r.native_reservation_id))
+          || !start_json_true(body,"pending_native_mutators_drained"))goto out;
+      r.pending_native_mutators_drained=true;
+    }
+    ret=409;if((prepare?player_start_prepare(&r,&result):player_start_commit(&r,&result))<0)goto out;
+  }else{
+    if(!transport_json_string(body,"token",r.token,sizeof(r.token))
+        || !transport_json_string(body,"native_reservation_id",r.native_reservation_id,sizeof(r.native_reservation_id)))goto out;
+    if(!strcmp(phase,"cancel")){
+      if(json_object_object_length(body)!=2)goto out;
+      ret=HTTP_NOTFOUND;if(player_start_result_get(r.device_id,r.token,&result)<0 || !result.command.move_existing_session
+          || player_start_cancel(r.token,r.native_reservation_id,&result)<0)goto out;
+    }else if(!strcmp(phase,"barrier")){
+      char type[8];
+      if(json_object_object_length(body)!=6 || !start_json_true(body,"writer_quiescent")
+          || transport_native_counter(body,"writer_source_epoch",&r.writer_source_epoch)<0 || !r.writer_source_epoch
+          || !transport_json_string(body,"expected_input_path_digest",r.expected_input_path_digest,sizeof(r.expected_input_path_digest))
+          || !json_object_object_get_ex(body,"pipe_identity",&value) || !json_object_is_type(value,json_type_object)
+          || json_object_object_length(value)!=3 || transport_native_counter(value,"device",&r.pipe_device)<0
+          || transport_native_counter(value,"inode",&r.pipe_inode)<0
+          || !transport_json_string(value,"type",type,sizeof(type)) || strcmp(type,"fifo"))goto out;
+      r.writer_quiescent=true;ret=409;if(player_start_barrier(&r,&result)<0)goto out;
+    }else if(!strcmp(phase,"open") || !strcmp(phase,"complete")){
+      bool complete=!strcmp(phase,"complete");
+      if(json_object_object_length(body)!=(complete?5:4)
+          || transport_native_counter(body,"writer_source_epoch",&r.writer_source_epoch)<0 || !r.writer_source_epoch
+          || start_json_owner(body,"committed_native_owner",&r.committed_native_owner,false,NULL)<0)goto out;
+      if(complete){if(!start_json_true(body,"native_mutators_drained"))goto out;r.native_mutators_drained=true;}
+      ret=409;if((complete?player_start_complete(&r,&result):player_start_open(&r,&result))<0)goto out;
+    }else goto out;
+  }
+  if(!result.command.move_existing_session){ret=409;goto out;}
+  ret=transport_json_reply(hreq,move_result_json(phase,&result));
+ out:
+  jparse_free(body);return ret;
+}
+static int jsonapi_reply_move_result(struct httpd_request *hreq)
+{
+  uint64_t id;struct output_start_result result;
+  if(safe_atou64(hreq->path_parts[2],&id)<0 || player_start_result_get(id,hreq->path_parts[5],&result)<0
+      || !result.command.move_existing_session)return HTTP_NOTFOUND;
+  return transport_json_reply(hreq,move_result_json("result",&result));
+}
diff --git a/src/httpd_jsonapi_retirement.inc.c b/src/httpd_jsonapi_retirement.inc.c
new file mode 100644
index 0000000..65743fc
--- /dev/null
+++ b/src/httpd_jsonapi_retirement.inc.c
@@ -0,0 +1,98 @@
+/* Private, purpose-bound cleanup of one completed protected FIFO owner. */
+static bool retirement_hex(const char *s)
+{
+  size_t i;if(!s || strlen(s)!=32)return false;
+  for(i=0;i<32;i++)if(!((s[i]>='0'&&s[i]<='9')||(s[i]>='a'&&s[i]<='f')))return false;
+  return true;
+}
+static json_object *retirement_result_json(const char *operation,const struct output_retirement_result *r)
+{
+  json_object *o=json_object_new_object(),*pipe=json_object_new_object();char schema[96];
+  const char *purpose=r->command.move_existing_session ? "move" : "start";
+  const char *outcome=r->outcome==OUTPUT_RETIRE_PENDING ? "pending" :
+    r->outcome==OUTPUT_RETIRE_RETIRED_KNOWN ? "retired" :
+    r->outcome==OUTPUT_RETIRE_UNKNOWN ? "unknown" : "rejected";
+  snprintf(schema,sizeof(schema),"podconnect.output_%s_retirement_%s.v1",purpose,operation);
+  json_object_object_add(o,"schema",json_object_new_string(schema));
+  json_object_object_add(o,"ok",json_object_new_boolean(r->ok));
+  json_object_object_add(o,"source_purpose",json_object_new_string(purpose));
+  json_object_object_add(o,"retirement_token",json_object_new_string(r->command.retirement_token));
+  json_object_object_add(o,"completed_token",json_object_new_string(r->command.completed_token));
+  json_object_object_add(o,"native_reservation_id",json_object_new_string(r->command.native_reservation_id));
+  json_object_object_add(o,"outcome",json_object_new_string(outcome));
+  attention_json_u64(o,"writer_source_epoch",r->command.writer_source_epoch);
+  attention_json_u64(o,"admitted_input_epoch",r->admitted_input_epoch);
+  attention_json_u64(o,"input_epoch",r->input_epoch);
+  attention_json_u64(pipe,"device",r->command.pipe_device);attention_json_u64(pipe,"inode",r->command.pipe_inode);
+  json_object_object_add(pipe,"type",json_object_new_string("fifo"));
+  json_object_object_add(o,"pipe_identity",pipe);
+  json_object_object_add(o,"reader_ready_closed",json_object_new_boolean(r->reader_ready_closed));
+  json_object_object_add(o,"gate_closed",json_object_new_boolean(r->gate_closed));
+  json_object_object_add(o,"contexts_drained",json_object_new_boolean(r->contexts_drained));
+  json_object_object_add(o,"durable_pending",json_object_new_boolean(r->durable_pending));
+  json_object_object_add(o,"durable_terminal",json_object_new_boolean(r->durable_terminal));
+  json_object_object_add(o,"retired_witness",json_object_new_boolean(r->retired_witness));
+  json_object_object_add(o,"physical_result_verified",json_object_new_boolean(false));
+  return o;
+}
+static int retirement_process_parse(json_object *body,struct output_native_process *process)
+{
+  json_object *p;
+  return !json_object_object_get_ex(body,"native_process",&p) || !json_object_is_type(p,json_type_object)
+    || json_object_object_length(p)!=3
+    || !transport_json_string(p,"boot_id",process->boot_id,sizeof(process->boot_id))
+    || transport_native_counter(p,"pid",&process->pid)<0 || !process->pid || process->pid>INT_MAX
+    || transport_native_counter(p,"proc_start_ticks",&process->proc_start_ticks)<0 || !process->proc_start_ticks ? -1 : 0;
+}
+static int retirement_pipe_parse(json_object *body,uint64_t *device,uint64_t *inode)
+{
+  json_object *p;char type[8];
+  return !json_object_object_get_ex(body,"pipe_identity",&p) || !json_object_is_type(p,json_type_object)
+    || json_object_object_length(p)!=3 || transport_native_counter(p,"device",device)<0 || !*device
+    || transport_native_counter(p,"inode",inode)<0 || !*inode
+    || !transport_json_string(p,"type",type,sizeof(type)) || strcmp(type,"fifo") ? -1 : 0;
+}
+static int jsonapi_reply_retirement_write(struct httpd_request *hreq)
+{
+  struct output_retirement_request r={0};struct output_retirement_result result;
+  json_object *body=transport_parse_body_limit(hreq->in_body,4096);int ret=HTTP_BADREQUEST;
+  bool prepare=!strcmp(hreq->path_parts[5],"prepare");
+  r.move_existing_session=!strcmp(hreq->path_parts[3],"move");
+  if(!body || safe_atou64(hreq->path_parts[2],&r.device_id)<0 || !r.device_id
+      || json_object_object_length(body)!=(prepare?8:7)
+      || !transport_json_string(body,prepare?"completed_token":"retirement_token",
+          prepare?r.completed_token:r.retirement_token,33)
+      || !retirement_hex(prepare?r.completed_token:r.retirement_token)
+      || !transport_json_string(body,"native_reservation_id",r.native_reservation_id,33)
+      || !retirement_hex(r.native_reservation_id)
+      || retirement_process_parse(body,&r.native_process)<0
+      || transport_native_counter(body,"writer_source_epoch",&r.writer_source_epoch)<0 || !r.writer_source_epoch
+      || retirement_pipe_parse(body,&r.pipe_device,&r.pipe_inode)<0)goto out;
+  if(prepare){
+    if(!transport_json_string(body,"native_incarnation",r.native_incarnation,33)
+        || !retirement_hex(r.native_incarnation)
+        || transport_native_counter(body,"writer_fd",&r.writer_fd)<0 || r.writer_fd>INT_MAX
+        || transport_native_counter(body,"expected_input_epoch",&r.input_epoch)<0 || !r.input_epoch)goto out;
+    ret=409;if(player_retirement_prepare(&r,&result)<0)goto out;
+  }else{
+    json_object *v;
+    if(transport_native_counter(body,"input_epoch",&r.input_epoch)<0 || !r.input_epoch
+        || !json_object_object_get_ex(body,"native_close_done",&v) || !json_object_is_type(v,json_type_boolean)
+        || !json_object_get_boolean(v))goto out;
+    r.native_close_done=true;
+    /* The retirement token identifies the completed source on the player
+     * owner; complete cannot inject a different completed operation. */
+    ret=409;if(player_retirement_complete(&r,&result)<0)goto out;
+  }
+  ret=transport_json_reply(hreq,retirement_result_json(prepare?"prepare":"complete",&result));
+ out:
+  jparse_free(body);return ret;
+}
+static int jsonapi_reply_retirement_result(struct httpd_request *hreq)
+{
+  uint64_t id;struct output_retirement_result result;
+  bool move=!strcmp(hreq->path_parts[3],"move");
+  if(safe_atou64(hreq->path_parts[2],&id)<0 || !id || !retirement_hex(hreq->path_parts[6])
+      || player_retirement_result_get(id,move,hreq->path_parts[6],&result)<0)return HTTP_NOTFOUND;
+  return transport_json_reply(hreq,retirement_result_json("result",&result));
+}
diff --git a/src/httpd_jsonapi_start.inc.c b/src/httpd_jsonapi_start.inc.c
new file mode 100644
index 0000000..cc5d51d
--- /dev/null
+++ b/src/httpd_jsonapi_start.inc.c
@@ -0,0 +1,139 @@
+/* Strict, closed, private configured-local START transaction. */
+static int start_json_owner(json_object *body,const char *key,struct output_native_owner *owner,bool nullable,bool *present)
+{
+  json_object *value,*wrapper;uint64_t id;
+  if(!json_object_object_get_ex(body,key,&value))return -1;
+  if(!value || json_object_is_type(value,json_type_null)){if(!nullable)return -1;if(present)*present=false;return 0;}
+  wrapper=json_object_new_object();json_object_object_add(wrapper,"native_owner",json_object_get(value));
+  int ret=transport_native_parse(wrapper,owner,NULL);json_object_put(wrapper);
+  if(ret<0 || safe_atou64(owner->homepod_id,&id)<0)return -1;
+  /* HTTP validates canonical owner shape; the actual C owner validates binding. */
+  char canonical[32];snprintf(canonical,sizeof(canonical),"%" PRIu64,id);
+  if(!id || strcmp(canonical,owner->homepod_id))return -1;
+  if(present)*present=true;
+  return 0;
+}
+static json_object *start_target_json(const char *process,uint64_t id,uint64_t incarnation)
+{
+  json_object *o=json_object_new_object();json_object_object_add(o,"process",json_object_new_string(process));
+  attention_json_u64(o,"device_id",id);attention_json_u64(o,"device_incarnation",incarnation);return o;
+}
+static const char *start_phase_name(enum output_start_phase phase)
+{
+  const char *names[]={"prepared","gate_draining","gate_closed_reader_ready","preparing_route","route_ready_closed","opened",
+    "rejected_before_admission","expired_before_admission","cancelled_before_admission","unknown","completed"};
+  return phase>=0 && (size_t)phase<ARRAY_SIZE(names) ? names[phase] : "unknown";
+}
+static json_object *start_result_json(const char *endpoint,const struct output_start_result *r)
+{
+  json_object *o=json_object_new_object(),*pipe=NULL;char schema[96];
+  snprintf(schema,sizeof(schema),"podconnect.output_start_%s.v1",endpoint);
+  json_object_object_add(o,"schema",json_object_new_string(schema));json_object_object_add(o,"ok",json_object_new_boolean(true));
+  json_object_object_add(o,"token",json_object_new_string(r->command.token));
+  json_object_object_add(o,"offer_id",json_object_new_string(r->command.offer_id));
+  json_object_object_add(o,"binding_id",json_object_new_string(r->command.binding_id));
+  json_object_object_add(o,"content_digest",json_object_new_string(r->command.content_digest));
+  json_object_object_add(o,"native_incarnation",json_object_new_string(r->command.native_incarnation));
+  attention_json_u64(o,"native_revision",r->command.native_revision);
+  json_object_object_add(o,"native_reservation_id",json_object_new_string(r->command.native_reservation_id));
+  json_object_object_add(o,"policy_revision",json_object_new_string(r->command.policy_revision));
+  json_object_object_add(o,"start_volume_percent",json_object_new_int(35));
+  json_object_object_add(o,"intended_native_owner",transport_native_json(&r->command.intended_native_owner));
+  json_object_object_add(o,"actual_native_owner",r->actual_owner_present ? transport_native_json(&r->command.committed_native_owner) : NULL);
+  json_object_object_add(o,"target_identity",start_target_json(r->process,r->command.device_id,r->target_incarnation));
+  json_object_object_add(o,"route_identity",r->route_present ? transport_identity_json(&r->route_identity) : NULL);
+  json_object_object_add(o,"input_path_digest",json_object_new_string(r->input_path_digest));
+  if(r->pipe_present){pipe=json_object_new_object();attention_json_u64(pipe,"device",r->pipe_device);attention_json_u64(pipe,"inode",r->pipe_inode);json_object_object_add(pipe,"type",json_object_new_string("fifo"));}
+  json_object_object_add(o,"pipe_identity",pipe);attention_json_u64(o,"input_epoch",r->input_epoch);attention_json_u64(o,"writer_source_epoch",r->writer_source_epoch);
+  json_object_object_add(o,"phase",json_object_new_string(start_phase_name(r->phase)));
+  json_object_object_add(o,"possible_effect",json_object_new_boolean(r->possible_effect));
+  json_object_object_add(o,"contexts_drained",json_object_new_boolean(r->contexts_drained));
+  json_object_object_add(o,"gate_closed",json_object_new_boolean(r->gate_closed));
+  json_object_object_add(o,"deadline_retired",json_object_new_boolean(r->deadline_retired));
+  json_object_object_add(o,"pin_remaining_ms",json_object_new_int(r->pin_remaining_ms));
+  json_object_object_add(o,"expires_after_ms",json_object_new_int(8000));
+  json_object_object_add(o,"physical_result_verified",json_object_new_boolean(false));return o;
+}
+static bool start_json_true(json_object *body,const char *key)
+{
+  json_object *v;return json_object_object_get_ex(body,key,&v) && json_object_is_type(v,json_type_boolean) && json_object_get_boolean(v);
+}
+static int start_json_common(json_object *body,struct output_start_request *r,bool prepare,bool state)
+{
+  if(!transport_json_string(body,"native_incarnation",r->native_incarnation,sizeof(r->native_incarnation)))return -1;
+  if((prepare || state) && (!transport_json_string(body,"expected_input_path",r->expected_input_path,sizeof(r->expected_input_path))
+      || !transport_json_string(body,"expected_input_path_digest",r->expected_input_path_digest,sizeof(r->expected_input_path_digest))))return -1;
+  if(prepare || state){
+    json_object *process;
+    if(!json_object_object_get_ex(body,"native_process",&process) || !json_object_is_type(process,json_type_object) || json_object_object_length(process)!=3
+        || !transport_json_string(process,"boot_id",r->native_process.boot_id,sizeof(r->native_process.boot_id))
+        || transport_native_counter(process,"pid",&r->native_process.pid)<0 || !r->native_process.pid
+        || transport_native_counter(process,"proc_start_ticks",&r->native_process.proc_start_ticks)<0 || !r->native_process.proc_start_ticks)return -1;
+  }
+  if(start_json_owner(body,"old_native_owner",&r->old_native_owner,true,&r->old_owner_present)<0)return -1;
+  return 0;
+}
+static int jsonapi_reply_start_write(struct httpd_request *hreq)
+{
+  const char *phase=hreq->path_parts[4];struct output_start_request r={0};struct output_start_result result;struct output_start_state state;
+  json_object *body=transport_parse_body_limit(hreq->in_body,16384),*value,*reply;int ret=HTTP_BADREQUEST;
+  if(!body || safe_atou64(hreq->path_parts[2],&r.device_id)<0)goto out;
+  if(!strcmp(phase,"state")){
+    if(json_object_object_length(body)!=5 || start_json_common(body,&r,false,true)<0)goto out;
+    ret=409;if(player_start_state_get(&r,&state)<0)goto out;
+    reply=json_object_new_object();json_object_object_add(reply,"schema",json_object_new_string("podconnect.output_start_state.v1"));
+    json_object_object_add(reply,"ok",json_object_new_boolean(true));json_object_object_add(reply,"ready",json_object_new_boolean(state.ready));
+    json_object_object_add(reply,"busy",json_object_new_boolean(state.busy));json_object_object_add(reply,"policy_revision",json_object_new_string(OUTPUT_START_POLICY));
+    json_object_object_add(reply,"start_volume_percent",json_object_new_int(35));
+    json_object_object_add(reply,"target_identity",start_target_json(state.process,state.device_id,state.device_incarnation));
+    json_object_object_add(reply,"physical_result_verified",json_object_new_boolean(false));ret=transport_json_reply(hreq,reply);goto out;
+  }
+  if(!strcmp(phase,"prepare") || !strcmp(phase,"commit")){
+    bool prepare=!strcmp(phase,"prepare");
+    if(json_object_object_length(body)!=(prepare?12:9) || start_json_common(body,&r,prepare,false)<0
+        || !transport_json_string(body,"offer_id",r.offer_id,sizeof(r.offer_id)) || !transport_json_string(body,"binding_id",r.binding_id,sizeof(r.binding_id))
+        || !transport_json_string(body,"content_digest",r.content_digest,sizeof(r.content_digest))
+        || transport_native_counter(body,"native_revision",&r.native_revision)<0 || !r.native_revision || r.native_revision==UINT64_MAX)goto out;
+    if(prepare){
+      if(start_json_owner(body,"intended_native_owner",&r.intended_native_owner,false,NULL)<0
+          || !transport_json_string(body,"policy_revision",r.policy_revision,sizeof(r.policy_revision))
+          || !json_object_object_get_ex(body,"start_volume_percent",&value) || !json_object_is_type(value,json_type_int) || json_object_get_int64(value)!=35)goto out;
+      r.start_volume_percent=35;
+    }else{
+      if(!transport_json_string(body,"token",r.token,sizeof(r.token)) || !transport_json_string(body,"native_reservation_id",r.native_reservation_id,sizeof(r.native_reservation_id))
+          || !start_json_true(body,"pending_native_mutators_drained"))goto out;
+      r.pending_native_mutators_drained=true;
+    }
+    ret=409;if((prepare?player_start_prepare(&r,&result):player_start_commit(&r,&result))<0)goto out;
+  }else{
+    if(!transport_json_string(body,"token",r.token,sizeof(r.token)) || !transport_json_string(body,"native_reservation_id",r.native_reservation_id,sizeof(r.native_reservation_id)))goto out;
+    if(!strcmp(phase,"cancel")){
+      if(json_object_object_length(body)!=2)goto out;
+      ret=HTTP_NOTFOUND;if(player_start_result_get(r.device_id,r.token,&result)<0 || player_start_cancel(r.token,r.native_reservation_id,&result)<0)goto out;
+    }else if(!strcmp(phase,"barrier")){
+      char type[8];
+      if(json_object_object_length(body)!=6 || !start_json_true(body,"writer_quiescent")
+          || transport_native_counter(body,"writer_source_epoch",&r.writer_source_epoch)<0 || !r.writer_source_epoch
+          || !transport_json_string(body,"expected_input_path_digest",r.expected_input_path_digest,sizeof(r.expected_input_path_digest))
+          || !json_object_object_get_ex(body,"pipe_identity",&value) || !json_object_is_type(value,json_type_object) || json_object_object_length(value)!=3
+          || transport_native_counter(value,"device",&r.pipe_device)<0 || transport_native_counter(value,"inode",&r.pipe_inode)<0
+          || !transport_json_string(value,"type",type,sizeof(type)) || strcmp(type,"fifo"))goto out;
+      r.writer_quiescent=true;ret=409;if(player_start_barrier(&r,&result)<0)goto out;
+    }else if(!strcmp(phase,"open") || !strcmp(phase,"complete")){
+      bool complete=!strcmp(phase,"complete");
+      if(json_object_object_length(body)!=(complete?5:4) || transport_native_counter(body,"writer_source_epoch",&r.writer_source_epoch)<0 || !r.writer_source_epoch
+          || start_json_owner(body,"committed_native_owner",&r.committed_native_owner,false,NULL)<0)goto out;
+      if(complete){if(!start_json_true(body,"native_mutators_drained"))goto out;r.native_mutators_drained=true;}
+      ret=409;if((complete?player_start_complete(&r,&result):player_start_open(&r,&result))<0)goto out;
+    }else goto out;
+  }
+  ret=transport_json_reply(hreq,start_result_json(phase,&result));
+ out:
+  jparse_free(body);return ret;
+}
+static int jsonapi_reply_start_result(struct httpd_request *hreq)
+{
+  uint64_t id;struct output_start_result result;
+  if(safe_atou64(hreq->path_parts[2],&id)<0 || player_start_result_get(id,hreq->path_parts[5],&result)<0)return HTTP_NOTFOUND;
+  return transport_json_reply(hreq,start_result_json("result",&result));
+}
