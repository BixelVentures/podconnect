index 0000000..783423d
--- /dev/null
+++ b/daemon/autoplay_queue_http.go
@@ -0,0 +1,118 @@
+package daemon
+
+import (
+	"context"
+	"net/http"
+	"time"
+)
+
+const queueAutoplayHeader = "X-Podconnect-Queue-Autoplay"
+
+func queueAutoplayOptIn(r *http.Request) (enabled, valid bool) {
+	values := r.Header.Values(queueAutoplayHeader)
+	if len(values) == 0 {
+		return false, true
+	}
+	valid = len(values) == 1 && values[0] == "1"
+	return valid, valid
+}
+
+type queueAutoplayPendingResponse struct {
+	Kind string `json:"kind"`
+}
+
+type queueAutoplayPreviewResponse struct {
+	Kind          string                   `json:"kind"`
+	ObservationID string                   `json:"observation_id"`
+	Revision      uint64                   `json:"queue_revision"`
+	Expires       int                      `json:"expires_after_ms"`
+	Items         []nativeQueueItem        `json:"items"`
+	Truncated     bool                     `json:"truncated"`
+	DisplayIDs    map[string]string        `json:"display_ids"`
+	Metadata      map[string]queueMetadata `json:"metadata,omitempty"`
+}
+
+type queueAutoplayPromotionResponse struct {
+	Kind       string                   `json:"kind"`
+	DisplayIDs map[string]string        `json:"display_ids"`
+	Metadata   map[string]queueMetadata `json:"metadata,omitempty"`
+}
+
+// Run inside the queue read actor turn so current, preview and promotion are
+// all bound to the one just-issued ordinary observation.
+func (p *AppPlayer) autoplayQueueExtension(ctx context.Context, current queueStateResponse) any {
+	if len(current.Items) == 0 && !current.Truncated {
+		value, err := p.readAutoplayPreview(ctx, current.Owner, true)
+		if err != nil {
+			return nil
+		}
+		view := value.(prospectiveQueueView)
+		if len(view.Rows) == 0 {
+			preview := p.autoplayPreview
+			if preview.pending != nil && time.Now().Before(preview.pendingUntil) &&
+				preview.owner.Writer.Wire == current.Writer {
+				return queueAutoplayPendingResponse{Kind: "pending"}
+			}
+			return nil
+		}
+		choice := p.autoplayPreview.choice
+		expires := min(current.Expires, int(time.Until(choice.Expires).Milliseconds()))
+		if expires < 1 {
+			return nil
+		}
+		response := queueAutoplayPreviewResponse{
+			Kind: "preview", ObservationID: choice.Snapshot.ObservationID,
+			Revision: choice.Snapshot.QueueRevision, Expires: expires, Items: choice.Snapshot.Items,
+			Truncated: view.Truncated, DisplayIDs: make(map[string]string, len(view.Rows)),
+			Metadata: make(map[string]queueMetadata),
+		}
+		for _, row := range view.Rows {
+			response.DisplayIDs[row.Selection.OccurrenceID] = row.DisplayID
+			if row.Metadata.Name != "" {
+				response.Metadata[row.URI] = row.Metadata
+			}
+		}
+		return response
+	}
+	value, err := p.readAutoplayPromotion(ctx, autoplayPromotionRead{current.Owner, current.ObservationID})
+	if err != nil {
+		return nil
+	}
+	rows := value.([]autoplayPromotedRow)
+	response := queueAutoplayPromotionResponse{
+		Kind: "promotion", DisplayIDs: make(map[string]string, len(rows)),
+		Metadata: make(map[string]queueMetadata),
+	}
+	for i, row := range rows {
+		response.DisplayIDs[row.QueueID] = row.DisplayID
+		if row.Metadata.Name != "" {
+			response.Metadata[current.Items[i].URI] = row.Metadata
+		}
+	}
+	return response
+}
+
+// Wait for the original provider work off the player actor. Reserve part of
+// the existing HTTP deadline for one fresh owner read, with pending as fallback.
+func (s *ConcreteApiServer) finishAutoplayQueueRead(ctx context.Context, request roomTransportStateRequest, pending queueStateResponse) (any, error) {
+	deadline, _ := ctx.Deadline()
+	waitUntil := deadline.Add(-250 * time.Millisecond)
+	if !time.Now().Before(waitUntil) {
+		return pending, nil
+	}
+	started := time.Now()
+	wait, cancel := context.WithDeadline(ctx, waitUntil)
+	defer cancel()
+	select {
+	case <-pending.autoplayDone:
+		if wait.Err() == nil {
+			return s.roomTransportAsk(ctx, apiRoomBoundQueueAutoplayFinish, request)
+		}
+	case <-wait.Done():
+	}
+	if err := ctx.Err(); err != nil {
+		return nil, err
+	}
+	pending.Expires -= int(time.Since(started).Milliseconds())
+	return pending, nil
+}
