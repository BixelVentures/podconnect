diff --git a/daemon/autoplay_preview.go b/daemon/autoplay_preview.go
new file mode 100644
index 0000000..a697ae0
--- /dev/null
+++ b/daemon/autoplay_preview.go
@@ -0,0 +1,296 @@
+package daemon
+
+import (
+	"context"
+	"strings"
+	"time"
+
+	connectpb "github.com/devgianlu/go-librespot/proto/spotify/connectstate"
+	"github.com/devgianlu/go-librespot/tracks"
+	"google.golang.org/protobuf/proto"
+)
+
+const (
+	apiRoomAutoplayPrepare  ApiRequestType = "room_autoplay_prepare"
+)
+
+const (
+	autoplayPreviewLifetime = 2 * time.Minute
+	autoplayPreviewTimeout  = 3 * time.Second
+	autoplayPreviewHistory  = 256
+)
+
+type autoplayStation struct {
+	context     *connectpb.Context
+	tracks      *tracks.List
+	occurrences tracks.QueueObservation
+}
+
+type autoplayPreview struct {
+	owner        *nativeQueueOffer
+	options      *connectpb.ContextPlayerOptions
+	uri          string
+	played       string
+	until        time.Time
+	pending      <-chan *autoplayStation
+	pendingUntil time.Time
+	done         <-chan struct{}
+	cancel       context.CancelFunc
+	station      *autoplayStation
+	choice       *nativeQueueOffer
+	actionItems  []nativeQueueItem
+	displayIDs   []string
+	metadata     map[string]queueMetadata
+}
+
+// The player actor owns the preview and publishes no playback state from its worker.
+func (p *AppPlayer) warmAutoplayPreview(ctx context.Context, offer *nativeQueueOffer) {
+	p.collectAutoplayPreview()
+	if len(offer.Snapshot.Items) != 0 || offer.Snapshot.Truncated || !p.canPreviewAutoplay() {
+		p.clearAutoplayPreview()
+		return
+	}
+	if current := p.autoplayPreview; current != nil {
+		if p.autoplayPreviewCurrent(current) && current.owner.Writer.Wire == offer.Writer.Wire {
+			return
+		}
+		p.clearAutoplayPreview()
+		if p.autoplayPreview != nil {
+			return // A cancelled resolve is still leaving the provider call.
+		}
+	}
+	client := p.sess.Spclient()
+	if client == nil {
+		return
+	}
+	// The exact empty bound observation has already established end of context.
+	// Snapshot only resident history, without a second page read on the actor.
+	recent := offer.Tracks.ResidentAutoplayHistory(autoplayPreviewHistory)
+	if len(recent) == 0 {
+		return
+	}
+	state := p.state.player
+	result := make(chan *autoplayStation, 1)
+	done := make(chan struct{})
+	readCtx, cancel := context.WithTimeout(ctx, autoplayPreviewTimeout)
+	pendingUntil, _ := readCtx.Deadline()
+	preview := &autoplayPreview{
+		owner: offer, options: proto.Clone(state.Options).(*connectpb.ContextPlayerOptions),
+		uri: state.ContextUri, played: state.GetTrack().GetUri(),
+		until: time.Now().Add(autoplayPreviewLifetime), pending: result, pendingUntil: pendingUntil, done: done, cancel: cancel,
+	}
+	p.autoplayPreview = preview
+	log := p.app.log
+	uri, played, shuffle := preview.uri, preview.played, preview.options.GetShufflingContext()
+	go func() {
+		defer close(done)
+		defer cancel()
+		station, err := resolveAutoplayHistory(readCtx, client, uri, recent, played)
+		if err != nil || !strings.HasPrefix(station.GetUri(), "spotify:station:") {
+			result <- nil
+			return
+		}
+		staged, err := tracks.NewTrackListFromContext(readCtx, log, client, station)
+		if err == nil {
+			err = prepareContextOrder(readCtx, staged, firstAutoplayTrack,
+				shuffle && len(station.GetRestrictions().GetDisallowTogglingShuffleReasons()) == 0)
+		}
+		if err != nil || readCtx.Err() != nil {
+			result <- nil
+			return
+		}
+		occurrences, err := staged.ObserveStation(readCtx)
+		if err != nil {
+			result <- nil
+			return
+		}
+		result <- &autoplayStation{station, staged, occurrences}
+	}()
+}
+
+func firstAutoplayTrack(*connectpb.ContextTrack) bool { return true }
+
+func (p *AppPlayer) canPreviewAutoplay() bool {
+	state := p.state.player
+	return !p.app.cfg.DisableAutoplay && state.Options != nil && state.IsPlaying && !state.IsPaused &&
+		!state.Options.RepeatingContext && !state.Options.RepeatingTrack &&
+		!strings.HasPrefix(state.ContextUri, "spotify:station:")
+}
+
+func (p *AppPlayer) autoplayPreviewSnapshotCurrent(preview *autoplayPreview) bool {
+	offer := preview.owner
+	return p.autoplayPreview == preview && time.Now().Before(preview.until) &&
+		p.state == offer.State && p.state.player == offer.PlayerState && p.state.tracks == offer.Tracks &&
+		offer.Tracks.TransportRevision() == offer.Snapshot.QueueRevision &&
+		p.sess == offer.Session && p.player == offer.Player && p.primaryStream == offer.Primary &&
+		p.roomTransportGeneration == offer.Generation && p.canPreviewAutoplay() &&
+		p.state.player.ContextUri == preview.uri && p.state.player.GetTrack().GetUri() == preview.played &&
+		proto.Equal(p.state.player.Options, preview.options)
+}
+
+func (p *AppPlayer) autoplayPreviewCurrent(preview *autoplayPreview) bool {
+	if !p.autoplayPreviewSnapshotCurrent(preview) {
+		return false
+	}
+	owner := *preview.owner.BoundOwner
+	current, err := p.roomTransportIdentity(owner.AccountUserID, owner.TargetID, owner.RoomID, owner.HomePodID)
+	return err == nil && current == owner
+}
+
+func (p *AppPlayer) collectAutoplayPreview() {
+	preview := p.autoplayPreview
+	if preview == nil || preview.pending == nil {
+		return
+	}
+	select {
+	case preview.station = <-preview.pending:
+		preview.pending = nil
+		if preview.until.IsZero() {
+			p.autoplayPreview = nil
+		}
+	default:
+	}
+}
+
+func (p *AppPlayer) clearAutoplayPreview() {
+	if preview := p.autoplayPreview; preview != nil {
+		preview.cancel()
+		if preview.pending == nil {
+			p.autoplayPreview = nil
+		} else {
+			preview.until = time.Time{}
+		}
+	}
+}
+
+type prospectiveQueueRow struct {
+	tracks.QueueOccurrence
+	Selection queueSelection
+	DisplayID string
+	Metadata  queueMetadata
+}
+
+type prospectiveQueueView struct {
+	Rows      []prospectiveQueueRow
+	Truncated bool
+}
+
+// readAutoplayPreview is internal to the actor. It neither issues a current
+// queue offer nor starts a resolve. Returned rows cannot mutate the station.
+func (p *AppPlayer) readAutoplayPreview(ctx context.Context, owner roomTransportIdentity, renew bool) (any, error) {
+	p.collectAutoplayPreview()
+	preview := p.autoplayPreview
+	if preview == nil || *preview.owner.BoundOwner != owner || !p.autoplayPreviewCurrent(preview) {
+		return nil, ErrAliasConflict
+	}
+	if preview.station == nil {
+		return prospectiveQueueView{}, nil
+	}
+	if !p.autoplayPreviewWriterCurrent(ctx, preview) {
+		return nil, ErrAliasConflict
+	}
+	if renew || preview.choice == nil || !time.Now().Before(preview.choice.Expires) {
+		choice := *preview.owner
+		choice.Expires = minTime(preview.until, time.Now().Add(queueOfferLifetime))
+		id, err := randomQueueID(16)
+		if err != nil {
+			return nil, err
+		}
+		choice.Snapshot.ObservationID = id
+		if preview.actionItems == nil {
+			items := make([]nativeQueueItem, 0, len(preview.station.occurrences.Items))
+			for _, row := range preview.station.occurrences.Items {
+				id, err := randomQueueID(12)
+				if err != nil {
+					return nil, err
+				}
+				items = append(items, nativeQueueItem{id, row.Position, row.URI, false})
+			}
+			preview.actionItems = items
+		}
+		choice.Snapshot.Items = preview.actionItems
+		choice.Snapshot.Truncated = preview.station.occurrences.Truncated
+		if !validRoomQueueObservation(&choice) {
+			return nil, ErrAliasConflict
+		}
+		preview.choice = &choice
+	}
+	snapshot := preview.choice.Snapshot
+	if preview.displayIDs == nil {
+		displayIDs := make([]string, len(snapshot.Items))
+		for i := range displayIDs {
+			id, err := randomQueueID(12)
+			if err != nil {
+				return nil, err
+			}
+			displayIDs[i] = "display-" + id
+		}
+		preview.displayIDs = displayIDs
+	}
+	if client := p.sess.Spclient(); client != nil {
+		if metadata := p.queueMetadata.readAndWarm(owner.AccountUserID, p.sess, client, snapshot.Items); len(metadata) != 0 {
+			if preview.metadata == nil {
+				preview.metadata = make(map[string]queueMetadata)
+			}
+			for uri, label := range metadata {
+				preview.metadata[uri] = label
+			}
+		}
+	}
+	view := prospectiveQueueView{Rows: make([]prospectiveQueueRow, len(snapshot.Items)), Truncated: snapshot.Truncated}
+	for i, item := range snapshot.Items {
+		view.Rows[i] = prospectiveQueueRow{preview.station.occurrences.Items[i],
+			queueSelection{snapshot.ObservationID, owner.SessionID, snapshot.QueueRevision, item.ID},
+			preview.displayIDs[i], preview.metadata[item.URI]}
+	}
+	return view, nil
+}
+
+func (p *AppPlayer) prepareAutoplaySelection(parent context.Context, request roomTransportPrepareRequest) (any, error) {
+	ctx, cancel := queueOperationContext(parent, request.Context)
+	defer cancel()
+	if request.Action != "queue" || request.VolumePercent != 0 || request.PositionMS != nil ||
+		request.OptionsRoute != nil || request.ExpectedReleaseOwner != nil ||
+		!validOptionArguments(request.Action, request.ShuffleEnabled, request.RepeatMode) || !validQueueSelection(request.Queue) {
+		return nil, ErrBadRequest
+	}
+	owner, err := p.roomTransportIdentity(request.AccountUserID, request.TargetID, request.RoomID, request.HomePodID)
+	if err != nil || !nativeBoundOwnerValid(owner) {
+		return nil, ErrAliasConflict
+	}
+	selection := *request.Queue
+	preview := p.autoplayPreview
+	if preview == nil || preview.station == nil || preview.choice == nil ||
+		*preview.owner.BoundOwner != owner || preview.choice.Snapshot.ObservationID != selection.ObservationID ||
+		!p.autoplayPreviewCurrent(preview) || !p.strongQueueCurrent(preview.choice, owner) ||
+		selection.SessionID != owner.SessionID || selection.QueueRevision != preview.choice.Snapshot.QueueRevision {
+		return nil, ErrAliasConflict
+	}
+	observed := preview.choice
+	preview.choice = nil
+	for _, item := range observed.Snapshot.Items {
+		if item.ID == selection.OccurrenceID {
+			return p.prepareBoundQueueOffer(parent, ctx, owner, selection, observed, item.Position, preview)
+		}
+	}
+	return nil, ErrAliasConflict
+}
+
+func (p *AppPlayer) takeAutoplayPreview(ctx context.Context) *autoplayPreview {
+	p.collectAutoplayPreview()
+	preview := p.autoplayPreview
+	defer p.clearAutoplayPreview()
+	if preview == nil || preview.station == nil || !p.autoplayPreviewCurrent(preview) ||
+		!p.autoplayPreviewWriterCurrent(ctx, preview) {
+		return nil
+	}
+	return preview
+}
+
+func (p *AppPlayer) autoplayPreviewWriterCurrent(ctx context.Context, preview *autoplayPreview) bool {
+	// Same read-only writer inspection as a bound queue read, without an offer.
+	checkCtx, cancel := context.WithTimeout(ctx, 200*time.Millisecond)
+	defer cancel()
+	writer, err := p.captureQueueWriter(checkCtx, *preview.owner.BoundOwner, nil)
+	return err == nil && writer.Wire == preview.owner.Writer.Wire && p.autoplayPreviewCurrent(preview)
+}
diff --git a/daemon/autoplay_promotion.go b/daemon/autoplay_promotion.go
new file mode 100644
index 0000000..f01ca4e
--- /dev/null
+++ b/daemon/autoplay_promotion.go
@@ -0,0 +1,103 @@
+package daemon
+
+import (
+	"context"
+	"time"
+
+	"github.com/devgianlu/go-librespot/tracks"
+)
+
+type autoplayDisplayRow struct {
+	Occurrence tracks.QueueOccurrence
+	ID         string
+	Metadata   queueMetadata
+}
+
+type autoplayPromotion struct {
+	owner *nativeQueueOffer
+	rows  []autoplayDisplayRow
+}
+
+type autoplayPromotionRead struct {
+	Owner         roomTransportIdentity
+	ObservationID string
+}
+
+type autoplayPromotedRow struct {
+	QueueID   string
+	DisplayID string
+	Metadata  queueMetadata
+}
+
+// Record only the suffix of the exact staged station whose source is now
+// published. This data never populates or reuses a queue action offer.
+func (p *AppPlayer) recordAutoplayPromotion(preview *autoplayPreview, selected int) {
+	p.autoplayPromotion = nil
+	previous := preview.owner
+	owner := *previous.BoundOwner
+	current, err := p.roomTransportIdentity(owner.AccountUserID, owner.TargetID, owner.RoomID, owner.HomePodID)
+	if err != nil {
+		return
+	}
+	// Natural autoplay can change playback session, but not the App, room or
+	// writer. A fresh ordinary queue read must still prove the same writer.
+	owner.SessionID = current.SessionID
+	if owner != current || p.sess != previous.Session || p.player != previous.Player ||
+		p.state != previous.State || p.state.player.ContextUri != preview.station.context.Uri ||
+		selected < 0 || selected >= len(preview.displayIDs)-1 {
+		return
+	}
+	observation := preview.station.occurrences
+	playing := p.state.player.GetTrack()
+	if row := observation.Items[selected]; row.UID != playing.GetUid() || row.URI != playing.GetUri() {
+		return
+	}
+	rows := make([]autoplayDisplayRow, 0, len(preview.displayIDs)-selected-1)
+	for i := selected + 1; i < len(preview.displayIDs); i++ {
+		row := observation.Items[i]
+		row.Position = len(rows)
+		rows = append(rows, autoplayDisplayRow{row, preview.displayIDs[i], preview.metadata[row.URI]})
+	}
+	p.autoplayPromotion = &autoplayPromotion{
+		owner: &nativeQueueOffer{
+			Snapshot: nativeQueueSnapshot{QueueRevision: p.state.tracks.TransportRevision()},
+			State:    p.state, Tracks: p.state.tracks, Expires: preview.until, BoundOwner: &current,
+			PlayerState: p.state.player, Session: p.sess, Player: p.player, Primary: p.primaryStream,
+			Generation: p.roomTransportGeneration, Writer: previous.Writer,
+		},
+		rows: rows,
+	}
+}
+
+func (p *AppPlayer) readAutoplayPromotion(ctx context.Context, request autoplayPromotionRead) (any, error) {
+	promotion := p.autoplayPromotion
+	current := p.queueOccurrenceOffer
+	if promotion == nil || current == nil || current.Snapshot.ObservationID != request.ObservationID ||
+		!p.strongQueueCurrent(promotion.owner, request.Owner) || !p.strongQueueCurrent(current, request.Owner) ||
+		current.Writer == nil || current.Writer.Wire != promotion.owner.Writer.Wire {
+		return nil, ErrAliasConflict
+	}
+	checkCtx, cancel := context.WithTimeout(ctx, 200*time.Millisecond)
+	defer cancel()
+	writer, err := p.captureQueueWriter(checkCtx, request.Owner, nil)
+	if err != nil || writer.Wire != current.Writer.Wire || !p.strongQueueCurrent(current, request.Owner) ||
+		!p.strongQueueCurrent(promotion.owner, request.Owner) {
+		return nil, ErrAliasConflict
+	}
+	return reconcileAutoplayRows(promotion.rows, current)
+}
+
+func reconcileAutoplayRows(expected []autoplayDisplayRow, current *nativeQueueOffer) ([]autoplayPromotedRow, error) {
+	if len(expected) > len(current.Occurrences) || len(current.Occurrences) != len(current.Snapshot.Items) {
+		return nil, ErrAliasConflict
+	}
+	rows := make([]autoplayPromotedRow, len(expected))
+	for i, row := range expected {
+		item := current.Snapshot.Items[i]
+		if current.Occurrences[i] != row.Occurrence || item.Position != i || item.URI != row.Occurrence.URI || item.Queued {
+			return nil, ErrAliasConflict
+		}
+		rows[i] = autoplayPromotedRow{item.ID, row.ID, row.Metadata}
+	}
+	return rows, nil
+}
diff --git a/daemon/autoplay_queue_http.go b/daemon/autoplay_queue_http.go
