+int
+outputs_primary_radio_custody_read(uint64_t id, struct output_primary_radio_custody *custody)
+{
+  char key[64], *raw = NULL;
+  primary_radio_custody_key(key, id);
+  int found = db_radio_handoff_load_key(key, &raw);
+  if (found == 1 && raw)
+    {
+      if (!primary_radio_custody_valid(raw, id, false) && !primary_radio_custody_valid(raw, id, true))
+        found = -1;
+      else
+        {
+          json_object *row = json_tokener_parse(raw);
+          if (!row)
+            found = -1;
+          else
+            {
+              *custody = (struct output_primary_radio_custody) {
+                .device_id = id,
+                .incarnation = json_object_get_uint64(json_object_object_get(row, "incarnation")),
+                .epoch = json_object_get_uint64(json_object_object_get(row, "epoch")),
+                .route = json_object_get_uint64(json_object_object_get(row, "route")),
+                .teardown_cseq = json_object_get_int(json_object_object_get(row, "teardown_cseq")),
+              };
+              snprintf(custody->process, sizeof(custody->process), "%s", json_object_get_string(json_object_object_get(row, "process")));
+              snprintf(custody->operation, sizeof(custody->operation), "%s", json_object_get_string(json_object_object_get(row, "operation")));
+              snprintf(custody->stop_action, sizeof(custody->stop_action), "%s", json_object_get_string(json_object_object_get(row, "stop_action")));
+              json_object_put(row);
+            }
+        }
+    }
+  free(raw);
+  return found;
+}
+
+char *
+outputs_primary_radio_custody_claim(uint64_t id, const char *pending, const char *action)
+{
+  char key[64], *claimed = NULL;
+  json_object *row, *previous;
+
+  if (!pending || !action || !radio_handoff_uuid(action) || !primary_radio_custody_valid(pending, id, false))
+    return NULL;
+  row = json_tokener_parse(pending);
+  if (!row)
+    return NULL;
+  if (json_object_object_get_ex(row, "stop_action", &previous) && json_object_get_string_len(previous) == 0)
+    {
+      primary_radio_custody_key(key, id);
+      json_object_object_add(row, "stop_action", json_object_new_string(action));
+      const char *raw = json_object_to_json_string_ext(row, JSON_C_TO_STRING_PLAIN);
+      if (raw && primary_radio_custody_valid(raw, id, false))
+        claimed = strdup(raw);
+      if (claimed && db_radio_handoff_save_key(key, pending, claimed) < 0)
+        {
+          free(claimed);
+          claimed = NULL;
+        }
+    }
+  json_object_put(row);
+  return claimed;
 }
 
