+static int
+primary_radio_claim_stop(struct airplay_session *session, const char *action)
+{
+  char *claimed = outputs_primary_radio_custody_claim(session->device_id, session->primary_radio_custody, action);
+
+  if (!claimed)
+    return -1;
+  free(session->primary_radio_custody);
+  session->primary_radio_custody = claimed;
+  session->primary_radio_revoked = true;
+  return 0;
+}
+
+/* Native owns the explicit intent. This command binds it to one exact live C
+ * route. Re-observing the same pending action never writes a second STOP. */
+int
+outputs_airplay_primary_radio_claim_stop(const struct output_primary_radio_custody *expected, const char *action)
+{
+  struct output_primary_radio_custody actual;
+  struct airplay_session *session;
+  if (!expected || !action || outputs_primary_radio_custody_read(expected->device_id, &actual) != 1
+      || strcmp(expected->process, actual.process) || strcmp(expected->operation, actual.operation)
+      || expected->incarnation != actual.incarnation || expected->epoch != actual.epoch || expected->route != actual.route)
+    return -1;
+  if (actual.stop_action[0])
+    return strcmp(actual.stop_action, action) ? -1 : 0;
+  if (strcmp(actual.process, outputs_process))
+    return -1;
+
+  struct airplay_primary_radio_route route = { actual.device_id, actual.incarnation, actual.epoch, actual.route };
+  session = airplay_primary_radio_session(&route);
+  if (!primary_radio_live(session) || primary_radio_claim_stop(session, action) < 0)
+    return -1;
+  sequence_start(AIRPLAY_SEQ_STOP, session, NULL, "primary_radio_actor_revoke");
+  return 0;
+}
