+// recoverUncertainCustodyLocked: last command wins. A hand-over whose outcome
+// stayed unknown used to quarantine every later output, transfer and control
+// until the engine restarted (Green, 11-12 Nov 2026). The hand-over is still
+// attempted; only when it stayed uncertain does the next command drop it.
+func (app *App) recoverUncertainCustodyLocked() {
+	if !app.moveCustodyUnknown {
+		return
+	}
+	app.moveCustody = nil
+	app.startCustody = nil
+	app.startOutputPermit = nil
+	app.retirementPending = nil
+	app.moveCustodyUnknown = false
+	if app.log != nil {
+		app.log.Warnf("uncertain room custody dropped: the newest command wins")
+	}
+}
+
