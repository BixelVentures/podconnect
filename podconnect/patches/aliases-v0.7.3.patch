+	"github.com/devgianlu/go-librespot/player"
+	connectpb "github.com/devgianlu/go-librespot/proto/spotify/connectstate"
+	"github.com/devgianlu/go-librespot/tracks"
+)
+
+type heldAliasServer struct {
+	entered chan *ApiEvent
+	release chan struct{}
+	once    sync.Once
+}
+
+func (s *heldAliasServer) Emit(e *ApiEvent)           { s.once.Do(func() { s.entered <- e }); <-s.release }
+func (s *heldAliasServer) Receive() <-chan ApiRequest { return nil }
+func (s *heldAliasServer) Close() error               { return nil }
+
+func TestLocalAliasCommitBeforeRetireKeepsOriginalIdentity(t *testing.T) {
+	p, _ := localAliasPlayer(t)
+	hold := &heldAliasServer{entered: make(chan *ApiEvent, 1), release: make(chan struct{})}
+	p.app.server = hold
+	old := p.aliasBinding()
+	result := make(chan *ApiResponseSelectAlias, 1)
+	errs := make(chan error, 1)
+	done := make(chan struct{})
+	var releaseOnce sync.Once
+	t.Cleanup(func() {
+		releaseOnce.Do(func() { close(hold.release) })
+		select {
+		case <-done:
+		case <-time.After(time.Second):
+			t.Error("owned alias operation not joined")
+		}
+	})
+	go func() {
+		defer close(done)
+		reply, err := p.selectLocalAlias(ApiRequestDataSelectAlias{RoomID: "r1", ExpectedRegistry: old.Registry, ExpectedIncarnation: old.Incarnation})
+		result <- reply
+		errs <- err
+	}()
+	var emitted *ApiEvent
+	select {
+	case emitted = <-hold.entered:
+	case <-time.After(time.Second):
+		t.Fatal("actual commit/event boundary not reached")
+	}
+	p.retireAliases() // exact same retirement method called before Close resource I/O
+	status := p.aliasBinding()
+	if status.Ready || status.RoomID != "" {
+		t.Fatal("retired status has reusable route")
+	}
+	if _, err := p.localAliases(); err != ErrAliasConflict {
+		t.Fatal("retired owner registry accepted GET")
+	}
+	releaseOnce.Do(func() { close(hold.release) })
+	select {
+	case reply := <-result:
+		if !reply.AcceptedLocal || reply.Binding.Incarnation != old.Incarnation || !reply.Binding.Ready {
+			t.Fatal("already committed effect was relabelled")
+		}
+	case <-time.After(time.Second):
+		t.Fatal("retained local operation did not finish")
+	}
+	if err := <-errs; err != nil {
+		t.Fatal(err)
+	}
+	binding := emitted.Data.(map[string]any)["alias_binding"].(*ApiAliasBinding)
+	if binding.Incarnation != old.Incarnation || binding.RoomID != "r1" {
+		t.Fatal("old emitted event borrowed replacement identity")
+	}
+}
+
+func localAliasPlayer(t *testing.T) (*AppPlayer, *aliasTestServer) {
+	t.Helper()
+	server := &aliasTestServer{}
+	p := &AppPlayer{app: &App{log: &librespot.NullLogger{}, cfg: &Config{DeviceAliases: []string{"A", "B"}, DeviceAliasRoomIDs: []string{"r0", "r1"}}, server: server}, state: &State{device: &connectpb.DeviceInfo{SelectedAliasId: 1}, player: &connectpb.PlayerState{PositionAsOfTimestamp: 65000, Options: &connectpb.ContextPlayerOptions{RepeatingContext: true, ShufflingContext: true}}, queueID: 37}}
+	p.initAliasRegistry()
+	if p.aliasFingerprint == "" {
+		t.Fatal("actual registry initialization failed")
+	}
+	return p, server
+}
+
+func TestLocalAliasActualHandlerPreservesPlaybackState(t *testing.T) {
+	p, server := localAliasPlayer(t)
+	oldState, oldDevice, oldPlayer := p.state, p.state.device, p.state.player
+	p.state.tracks = &tracks.List{}
+	p.state.lastCommand = &dealer.RequestPayload{MessageId: 77}
+	p.primaryStream = &player.Stream{}
+	p.secondaryStream = &player.Stream{}
+	oldTracks, oldCommand, oldPrimary, oldSecondary := p.state.tracks, p.state.lastCommand, p.primaryStream, p.secondaryStream
+	oldPosition, oldOptions, oldQueue := p.state.player.PositionAsOfTimestamp, *p.state.player.Options, p.state.queueID
+	before, _ := p.localAliases()
+	result, err := p.handleApiRequest(context.Background(), ApiRequest{Type: ApiRequestTypeSelectAlias, Data: ApiRequestDataSelectAlias{RoomID: "r1", ExpectedIncarnation: before.Binding.Incarnation, ExpectedRegistry: before.Binding.Registry}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	reply := result.(*ApiResponseSelectAlias)
+	if !reply.AcceptedLocal || reply.ID != 2 || reply.Binding.RoomID != "r1" {
+		t.Fatalf("wrong local result: %+v", reply)
+	}
+	if p.state != oldState || p.state.device != oldDevice || p.state.player != oldPlayer || p.state.player.PositionAsOfTimestamp != oldPosition || !reflect.DeepEqual(*p.state.player.Options, oldOptions) || p.state.queueID != oldQueue || p.state.tracks != oldTracks || p.primaryStream != oldPrimary || p.secondaryStream != oldSecondary || p.state.lastCommand != oldCommand {
+		t.Fatal("local alias operation mutated playback/context/queue")
+	}
+	if len(server.events) != 1 || server.events[0].Type != "selected_alias" {
+		t.Fatal("local selection did not emit one actual event")
+	}
+	event := server.events[0].Data.(map[string]any)
+	if event["id"] != uint32(2) || event["alias_binding"].(*ApiAliasBinding).Incarnation != before.Binding.Incarnation {
+		t.Fatal("event not bound to actual owner")
+	}
+	// No Session/Player was fabricated: any provider or playback call would fail.
+	if p.sess != nil || p.player != nil {
+		t.Fatal("unexpected competing I/O owner")
+	}
+}
