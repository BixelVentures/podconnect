new file mode 100644
--- /dev/null
+++ b/daemon/device_alias.go
@@ -0,0 +1,133 @@
+package daemon
+
+import (
+	"crypto/rand"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+)
+
+// resolveDeviceAlias preserves the selected zone for engine-targeted Web API
+// commands. Explicit valid aliases still switch rooms. Zero is not an advertised
+// room in alias mode; invalid/stale selections fall back to the primary room.
+func resolveDeviceAlias(current, requested uint32, count int) uint32 {
+	if count <= 0 {
+		return requested
+	}
+	if requested >= 1 && uint64(requested) <= uint64(count) {
+		return requested
+	}
+	if current >= 1 && uint64(current) <= uint64(count) {
+		return current
+	}
+	return 1
+}
+
+// Registry identity belongs to this actual AppPlayer and its loaded config.
+// Missing stable IDs preserve legacy Spotify behaviour but disable local selection.
+func (p *AppPlayer) initAliasRegistry() {
+	names, ids := p.app.cfg.DeviceAliases, p.app.cfg.DeviceAliasRoomIDs
+	p.aliasConfigured = p.app.cfg.DeviceAliasRoomIDsConfigured || ids != nil
+	if len(names) == 0 || len(names) != len(ids) {
+		return
+	}
+	seen := make(map[string]bool, len(ids))
+	entries := make([]ApiAlias, len(ids))
+	for i, id := range ids {
+		if id == "" || names[i] == "" || seen[id] {
+			return
+		}
+		seen[id] = true
+		entries[i] = ApiAlias{ID: uint32(i + 1), RoomID: id, Name: names[i]}
+	}
+	var nonce [16]byte
+	if _, err := rand.Read(nonce[:]); err != nil {
+		return
+	}
+	raw, err := json.Marshal(entries)
+	if err != nil {
+		return
+	}
+	sum := sha256.Sum256(raw)
+	p.aliasRegistry = entries
+	p.aliasFingerprint = hex.EncodeToString(sum[:])
+	p.aliasIncarnation = hex.EncodeToString(nonce[:])
+}
+
+func (p *AppPlayer) aliasBindingLocked() *ApiAliasBinding {
+	if len(p.aliasRegistry) == 0 {
+		if p.aliasConfigured {
+			return &ApiAliasBinding{}
+		}
+		return nil
+	}
+	b := &ApiAliasBinding{Incarnation: p.aliasIncarnation, Registry: p.aliasFingerprint, Ready: !p.aliasRetired}
+	if b.Ready {
+		for _, a := range p.aliasRegistry {
+			if a.ID == p.state.device.SelectedAliasId {
+				b.RoomID = a.RoomID
+				break
+			}
+		}
+	}
+	return b
+}
+
+func (p *AppPlayer) aliasBinding() *ApiAliasBinding {
+	p.aliasMu.Lock()
+	defer p.aliasMu.Unlock()
+	return p.aliasBindingLocked()
+}
+
+func (p *AppPlayer) localAliases() (*ApiResponseAliases, error) {
+	p.aliasMu.Lock()
+	defer p.aliasMu.Unlock()
+	if len(p.aliasRegistry) == 0 || p.aliasRetired {
+		return nil, ErrAliasConflict
+	}
+	binding := p.aliasBindingLocked()
+	if binding.RoomID == "" {
+		return nil, ErrAliasConflict
+	}
+	return &ApiResponseAliases{Binding: binding, Aliases: append([]ApiAlias(nil), p.aliasRegistry...)}, nil
+}
+
+func (p *AppPlayer) emitSelectedAlias(id uint32, binding *ApiAliasBinding) {
+	data := map[string]any{"id": id}
+	if binding != nil {
+		data["alias_binding"] = binding
+	}
+	p.app.server.Emit(&ApiEvent{Type: "selected_alias", Data: data})
+}
+
+func (p *AppPlayer) selectLocalAlias(data ApiRequestDataSelectAlias) (*ApiResponseSelectAlias, error) {
+	// Close and local commit share only this short admission boundary.
+	p.aliasMu.Lock()
+	if p.aliasRetired || p.aliasFingerprint == "" || data.ExpectedRegistry != p.aliasFingerprint || data.ExpectedIncarnation != p.aliasIncarnation {
+		p.aliasMu.Unlock()
+		return nil, ErrAliasConflict
+	}
+	var id uint32
+	for _, a := range p.aliasRegistry {
+		if a.RoomID == data.RoomID {
+			id = a.ID
+			break
+		}
+	}
+	if id == 0 {
+		p.aliasMu.Unlock()
+		return nil, ErrAliasConflict
+	}
+	p.state.device.SelectedAliasId = id
+	binding := p.aliasBindingLocked()
+	p.aliasMu.Unlock()
+	// These best-effort observations cannot turn local acceptance into native ACK.
+	p.emitSelectedAlias(id, binding)
+	return &ApiResponseSelectAlias{AcceptedLocal: true, Binding: binding, ID: id}, nil
+}
+
+func (p *AppPlayer) retireAliases() {
+	p.aliasMu.Lock()
+	p.aliasRetired = true
+	p.aliasMu.Unlock()
+}
