+++ b/daemon/device_alias_handler_test.go
@@ -0,0 +1,48 @@
+package daemon
+
+import (
+	"context"
+	"encoding/json"
+	librespot "github.com/devgianlu/go-librespot"
+	"github.com/devgianlu/go-librespot/dealer"
+	connectpb "github.com/devgianlu/go-librespot/proto/spotify/connectstate"
+	"testing"
+)
+
+type aliasTestServer struct{ events []*ApiEvent }
+
+func (s *aliasTestServer) Emit(e *ApiEvent)           { s.events = append(s.events, e) }
+func (s *aliasTestServer) Receive() <-chan ApiRequest { return nil }
+func (s *aliasTestServer) Close() error               { return nil }
+
+func TestDealerAliasSelection(t *testing.T) {
+	for _, tc := range []struct {
+		name, payload string
+		want          uint32
+	}{
+		{"web api preserves selected child", `{"target_alias_id":0,"command":{"endpoint":"transfer"}}`, 2},
+		{"phone picks primary", `{"target_alias_id":1,"command":{"endpoint":"transfer"}}`, 1},
+		{"nested web api preserves selected child", `{"command":{"target_alias_id":0,"endpoint":"transfer"}}`, 2},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			server := &aliasTestServer{}
+			p := &AppPlayer{app: &App{log: &librespot.NullLogger{}, cfg: &Config{DeviceAliases: []string{"Kitchen", "Bedroom"}}, server: server}, state: &State{device: &connectpb.DeviceInfo{SelectedAliasId: 2}}}
+			var req dealer.RequestPayload
+			if err := json.Unmarshal([]byte(tc.payload), &req); err != nil {
+				t.Fatal(err)
+			}
+			if err := p.handlePlayerCommand(context.Background(), req); err != nil {
+				t.Fatal(err)
+			}
+			if p.state.device.SelectedAliasId != tc.want {
+				t.Fatalf("published device alias=%d want=%d", p.state.device.SelectedAliasId, tc.want)
+			}
+			if len(server.events) == 0 || server.events[0].Type != "selected_alias" {
+				t.Fatalf("no routing event: %+v", server.events)
+			}
+			if got := server.events[0].Data.(map[string]any)["id"]; got != tc.want {
+				t.Fatalf("route id=%v want=%d", got, tc.want)
+			}
+		})
+	}
+}
