+func TestLocalAliasActualHandlerRejectsStaleAndInvalidRegistry(t *testing.T) {
+	for _, kind := range []string{"room", "registry", "incarnation", "retired", "missing-ids", "duplicate-ids", "explicit-empty-ids"} {
+		t.Run(kind, func(t *testing.T) {
+			p, server := localAliasPlayer(t)
+			req := ApiRequestDataSelectAlias{RoomID: "r1", ExpectedIncarnation: p.aliasIncarnation, ExpectedRegistry: p.aliasFingerprint}
+			switch kind {
+			case "room":
+				req.RoomID = "missing"
+			case "registry":
+				req.ExpectedRegistry = "old"
+			case "incarnation":
+				req.ExpectedIncarnation = "old"
+			case "retired":
+				p.aliasMu.Lock()
+				p.aliasRetired = true
+				p.aliasMu.Unlock()
+			case "missing-ids":
+				p.app.cfg.DeviceAliasRoomIDs = nil
+				p.aliasRegistry = nil
+				p.aliasFingerprint = ""
+				p.initAliasRegistry()
+			case "explicit-empty-ids":
+				p.app.cfg.DeviceAliasRoomIDs = nil
+				p.app.cfg.DeviceAliasRoomIDsConfigured = true
+				p.aliasRegistry = nil
+				p.aliasFingerprint = ""
+				p.initAliasRegistry()
+			case "duplicate-ids":
+				p.app.cfg.DeviceAliasRoomIDs = []string{"same", "same"}
+				p.aliasRegistry = nil
+				p.aliasFingerprint = ""
+				p.initAliasRegistry()
+			}
+			if (kind == "duplicate-ids" || kind == "explicit-empty-ids") && p.aliasBinding() == nil {
+				t.Fatal("configured invalid registry masquerades as legacy")
+			}
+			if kind == "missing-ids" && p.aliasBinding() != nil {
+				t.Fatal("legacy config requires unsupported identity")
+			}
+			_, err := p.handleApiRequest(context.Background(), ApiRequest{Type: ApiRequestTypeSelectAlias, Data: req})
+			if err != ErrAliasConflict || p.state.device.SelectedAliasId != 1 || len(server.events) != 0 {
+				t.Fatalf("invalid local selection had effect: %v", err)
+			}
+		})
+	}
+}
+
+func TestLocalAliasImmutableSnapshotAndFreshPlayerIncarnation(t *testing.T) {
+	a, _ := localAliasPlayer(t)
+	old, _ := a.localAliases()
+	a.app.cfg.DeviceAliases[1] = "changed"
+	a.app.cfg.DeviceAliasRoomIDs[1] = "replacement"
+	again, _ := a.localAliases()
+	if !reflect.DeepEqual(old, again) {
+		t.Fatal("registry followed mutable config after construction")
+	}
+	old.Aliases[1].RoomID = "tampered"
+	again, _ = a.localAliases()
+	if again.Aliases[1].RoomID != "r1" {
+		t.Fatal("export aliases share registry storage")
+	}
+	b, _ := localAliasPlayer(t)
+	if a.aliasIncarnation == b.aliasIncarnation {
+		t.Fatal("new player reused old owner")
+	}
+	_, err := b.handleApiRequest(context.Background(), ApiRequest{Type: ApiRequestTypeSelectAlias, Data: ApiRequestDataSelectAlias{RoomID: "r1", ExpectedIncarnation: a.aliasIncarnation, ExpectedRegistry: a.aliasFingerprint}})
+	if err != ErrAliasConflict {
+		t.Fatal("old player claim crossed replacement")
+	}
+	a.state.device.SelectedAliasId = 0
+	if _, err := a.localAliases(); err != ErrAliasConflict {
+		t.Fatal("unselected registry invented primary room")
+	}
+	a.retireAliases()
+	if _, err := a.localAliases(); err != ErrAliasConflict {
+		t.Fatal("retired GET exposed reusable registry")
+	}
+	binding := a.aliasBinding()
+	if binding == nil || binding.Ready || binding.RoomID != "" {
+		t.Fatal("retired status masquerades as old metadata or current owner")
+	}
+}
+
+func TestLocalAliasHTTPUsesActualRequestQueue(t *testing.T) {
+	for _, stale := range []bool{false, true} {
+		name := "accepted-local"
+		if stale {
+			name = "stale-conflict"
+		}
+		t.Run(name, func(t *testing.T) {
+			p, _ := localAliasPlayer(t)
+			server := &ConcreteApiServer{log: &librespot.NullLogger{}, requests: make(chan ApiRequest)}
+			received := make(chan ApiRequest, 1)
+			done := make(chan struct{})
+			ctx, cancel := context.WithCancel(context.Background())
+			t.Cleanup(func() {
+				cancel()
+				select {
+				case <-done:
+				case <-time.After(time.Second):
+					t.Error("retained API fixture owner did not join")
+				}
+			})
+			go func() {
+				defer close(done)
+				select {
+				case req := <-server.Receive():
+					received <- req
+					data, err := p.handleApiRequest(ctx, req)
+					req.Reply(data, err)
+				case <-ctx.Done():
+				}
+			}()
+			incarnation := p.aliasIncarnation
+			if stale {
+				incarnation = "stale"
+			}
+			raw, _ := json.Marshal(ApiRequestDataSelectAlias{RoomID: "r1", ExpectedIncarnation: incarnation, ExpectedRegistry: p.aliasFingerprint})
+			response := httptest.NewRecorder()
+			server.handleAliases(response, httptest.NewRequest(http.MethodPost, "/player/aliases", bytes.NewReader(raw)))
+			if stale {
+				if response.Code != http.StatusConflict || p.state.device.SelectedAliasId != 1 {
+					t.Fatalf("stale HTTP returned %d/alias %d", response.Code, p.state.device.SelectedAliasId)
+				}
+			} else {
+				var reply ApiResponseSelectAlias
+				if response.Code != http.StatusOK || json.Unmarshal(response.Body.Bytes(), &reply) != nil || !reply.AcceptedLocal || reply.ID != 2 || reply.Binding.RoomID != "r1" || reply.Binding.Incarnation != incarnation {
+					t.Fatalf("wrong actual local HTTP result: %d %s", response.Code, response.Body.String())
+				}
+			}
+			select {
+			case req := <-received:
+				if req.Type != ApiRequestTypeSelectAlias {
+					t.Fatal("wrong API owner")
+				}
+			case <-time.After(time.Second):
+				t.Fatal("request queue not observed")
+			}
+			select {
+			case <-done:
+			case <-time.After(time.Second):
+				t.Fatal("retained API fixture owner did not join")
+			}
+		})
+	}
+}
