 			},
 		},
 	}
+
+	// device-aliases (multiroom zones): mirror the configured aliases into the connect-state DeviceInfo
+	// so the cloud renders each as a selectable device. Selection arrives as target_alias_id over the
+	// dealer (see controls.go). Default the selected alias to the first.
+	if len(p.app.cfg.DeviceAliases) > 0 {
+		m := make(map[uint32]*devicespb.DeviceAlias, len(p.app.cfg.DeviceAliases))
