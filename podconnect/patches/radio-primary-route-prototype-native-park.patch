+package daemon
+
+import (
+	"context"
+	"strconv"
+	"strings"
+)
+
+const cPrimaryParkSchema = "podconnect.output_primary_spotify_park.v1"
+
+type radioPrimaryParkWire struct {
+	Schema   string                `json:"schema"`
+	Phase    string                `json:"phase"`
+	Action   string                `json:"action"`
+	Revision string                `json:"native_revision"`
+	Owner    roomTransportIdentity `json:"native_owner"`
+	Writer   queueWriterWire       `json:"writer_proof"`
+	Route    *roomVolumeRoute      `json:"output_identity,omitempty"`
+	Token    string                `json:"token,omitempty"`
+}
+
+type radioPrimaryParkReceipt struct {
+	radioPrimaryParkWire
+	RequiresPause bool `json:"requires_native_pause"`
+	StopCSeq      int  `json:"stop_cseq,omitempty"`
+}
+
+func (p *AppPlayer) primaryRadioParkCall(ctx context.Context, wire radioPrimaryParkWire, target radioPrimaryTarget) (radioPrimaryParkReceipt, error) {
+	var ack radioPrimaryParkReceipt
+	endpoint := strings.TrimSuffix(p.app.cfg.RoomTransportOwnToneURL, "/") + "/api/outputs/" + target.Device + "/radio-handoff/reacquire"
+	err := radioAuthenticatedHTTP(ctx, endpoint, p.app.cfg.RadioHandoffControlToken, wire, &ack)
+	if err != nil {
+		return ack, err
+	}
+	if ack.Schema != wire.Schema || ack.Action != wire.Action || ack.Revision != wire.Revision ||
+		ack.Owner != wire.Owner || ack.Writer != wire.Writer || !ack.RequiresPause || !volumeHex32.MatchString(ack.Token) ||
+		ack.Route == nil || !ack.Route.valid() || ack.Route.Process != target.Process || ack.Route.DeviceID != target.Device ||
+		ack.Route.DeviceIncarnation != target.Incarnation || ack.Route.SessionEpoch != target.Epoch ||
+		ack.Route.RouteRevision != target.Route || ack.Route.InputPathDigest != wire.Writer.InputDigest {
+		return ack, ErrAliasConflict
+	}
+	if wire.Phase == "prepare" {
+		if ack.Phase != "prepared" || ack.StopCSeq != 0 {
+			return ack, ErrAliasConflict
+		}
+	} else if wire.Route == nil || *wire.Route != *ack.Route || wire.Token != ack.Token ||
+		(ack.Phase != "pending" || ack.StopCSeq != 0) && (ack.Phase != "parked" || ack.StopCSeq <= 0) {
+		return ack, ErrAliasConflict
+	}
+	return ack, nil
+}
+
+func (p *AppPlayer) primaryRadioPrepareStation(ctx context.Context, r radioPrimaryCommand, h *radioHold, device string) (any, error) {
+	op := h.PrimaryPending
+	if h.Phase != "primary_reserved" || r.Session != nil || !nativeOwnerASCII(r.Station, 31) {
+		return nil, ErrAliasConflict
+	}
+	if r.Phase == "prepare_start" {
+		if r.ForPhase != "" || op.Target != nil {
+			return nil, ErrAliasConflict
+		}
+		phase := "target"
+		if room, err := p.radioIntentTarget(nil); p.primaryStream != nil && err == nil && room == r.Target {
+			phase, op.SameTarget = "preflight_target", true
+		}
+		ack, err := p.primaryRadioCStart(ctx, radioPrimaryStartWire{Schema: cPrimaryStartSchema, Phase: phase, radioPrimaryTarget: radioPrimaryTarget{Device: device}}, op.SameTarget)
+		if err != nil {
+			return nil, err
+		}
+		op.Target, op.Station = &ack.radioPrimaryTarget, r.Station
+		if err = p.app.persistRadioLocked(); err != nil {
+			return nil, err
+		}
+	}
+	if op.Target == nil || op.Station != r.Station || op.Target.Device != device {
+		return nil, ErrAliasConflict
+	}
+	r.Phase, op.Decoded = "prepared", !op.SameTarget
+	if !op.SameTarget {
+		return radioPrimaryReply{radioPrimaryCommand: r}, nil
+	}
+
+	phase := "result"
+	if r.ForPhase == "" {
+		phase = "preflight"
+	}
+	ack, err := p.primaryRadioCStart(ctx, radioPrimaryStartWire{
+		Schema: cPrimaryStartSchema, Phase: phase, Action: r.Action, Station: r.Station, radioPrimaryTarget: *op.Target,
+	}, true)
+	if err != nil {
+		return nil, err
+	}
+	switch ack.Phase {
+	case "pending":
+		r.Phase = "pending"
+	case "decoded":
+		op.Decoded = true
+		if err = p.app.persistRadioLocked(); err != nil {
+			return nil, err
+		}
+	case "rejected":
+		r.Phase, h.Phase = "rejected", "primary_rejected"
+		if err = p.app.persistRadioLocked(); err != nil {
+			return nil, err
+		}
+	default:
+		return nil, ErrAliasConflict
+	}
+	return radioPrimaryReply{radioPrimaryCommand: r}, nil
+}
+
+// Existing Native reservation owns exactly one preflight, park confirm and
+// decoder activation. Reads can settle a pending step, but never resend it.
+func (p *AppPlayer) primaryRadioAdvancePark(ctx context.Context, h *radioHold, r radioPrimaryCommand, wire radioPrimaryStartWire, begin bool) (radioPrimaryStartReceipt, error) {
+	op, app := h.PrimaryPending, p.app
+	if op.ActivationSent {
+		wire.Phase = "result"
+		return p.primaryRadioCStart(ctx, wire, true)
+	}
+
+	if begin {
+		owner, err := p.radioSourceOwner()
+		if err != nil || owner.RoomID != r.Target || owner.HomePodID != wire.Device || p.primaryStream == nil {
+			return radioPrimaryStartReceipt{}, ErrAliasConflict
+		}
+		writer, err := p.captureQueueWriter(ctx, owner, nil)
+		if err != nil {
+			return radioPrimaryStartReceipt{}, err
+		}
+		revision, err := p.nextNativeIntent()
+		if err != nil {
+			return radioPrimaryStartReceipt{}, err
+		}
+		ack, err := p.primaryRadioParkCall(ctx, radioPrimaryParkWire{
+			Schema: cPrimaryParkSchema, Phase: "prepare", Action: r.Action, Revision: revision, Owner: owner, Writer: writer.Wire,
+		}, *op.Target)
+		if err != nil {
+			return radioPrimaryStartReceipt{}, err
+		}
+		h.PrimaryPark, h.primary, h.RequiresPause, h.PauseUncertain = &ack.radioPrimaryParkWire, p.primaryStream, true, true
+		paused := p.state.player.IsPaused
+		h.PausedBefore = &paused
+		app.radioOutputFence.Store(true)
+		if err = app.persistRadioLocked(); err != nil {
+			return radioPrimaryStartReceipt{}, err
+		}
+		generation, _ := strconv.ParseUint(revision, 10, 64)
+		if err = p.pauseAndParkRadioWriter(ctx, h, ack.Token, generation, writer.Wire); err != nil {
+			return radioPrimaryStartReceipt{}, err
+		}
+	}
+	park := h.PrimaryPark
+	if park == nil || !h.WriterParked || h.PauseUncertain || h.primary == nil || p.primaryStream != h.primary {
+		return radioPrimaryStartReceipt{}, ErrAliasConflict
+	}
+	if owner, err := p.radioSourceOwner(); err != nil || owner != park.Owner {
+		return radioPrimaryStartReceipt{}, ErrAliasConflict
+	}
+	query := *park
+	query.Phase = "result"
+	if begin {
+		query.Phase = "confirm"
+	}
+	ack, err := p.primaryRadioParkCall(ctx, query, *op.Target)
+	if err != nil {
+		return radioPrimaryStartReceipt{}, err
+	}
+	if ack.Phase == "pending" {
+		return radioPrimaryStartReceipt{radioPrimaryStartWire: radioPrimaryStartWire{Phase: "pending"}}, nil
+	}
+
+	op.ActivationSent = true
+	if err = app.persistRadioLocked(); err != nil {
+		return radioPrimaryStartReceipt{}, err
+	}
+	wire.Phase, wire.ParkToken = "activate", park.Token
+	return p.primaryRadioCStart(ctx, wire, true)
+}
