+func TestAppShutdownJoinsUnpublishedPlayerAndSealsLateLogin(t *testing.T) {
+	app := &App{}
+	worker, err := player.NewPlayer(&player.Options{Log: &librespot.NullLogger{}, AudioBackend: "pipe", AudioOutputPipe: filepath.Join(t.TempDir(), "not-opened.fifo"), AudioOutputPipeFormat: "s16le"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	prepared := &AppPlayer{app: app, player: worker, stop: make(chan struct{}, 1)}
+	entered, release := make(chan struct{}), make(chan struct{})
+	var releaseOnce sync.Once
+	t.Cleanup(func() { releaseOnce.Do(func() { close(release) }); prepared.Close() })
+	login := make(chan error, 1)
+	go func() {
+		_, err := app.replaceAppPlayer(context.Background(), nil, func(context.Context) (*AppPlayer, error) { close(entered); <-release; return prepared, nil })
+		login <- err
+	}()
+	<-entered
+	closed := make(chan error, 1)
+	go func() { closed <- app.Close() }()
+	// Wait for the existing publication seal, not a guessed worker scheduling delay.
+	deadline := time.After(time.Second)
+	for {
+		app.ownerMu.Lock()
+		sealed := app.closed
+		app.ownerMu.Unlock()
+		if sealed {
+			break
+		}
+		select {
+		case <-deadline:
+			t.Fatal("shutdown did not seal pending login")
+		default:
+			time.Sleep(time.Millisecond)
+		}
+	}
+	select {
+	case err := <-closed:
+		t.Fatalf("Close escaped pending login: %v", err)
+	default:
+	}
+	releaseOnce.Do(func() { close(release) })
+	select {
+	case err := <-login:
+		if err == nil {
+			t.Fatal("late authenticated player published after Close")
+		}
+	case <-time.After(time.Second):
+		t.Fatal("late login not joined")
+	}
+	select {
+	case err := <-closed:
+		if err != nil {
+			t.Fatal(err)
+		}
+	case <-time.After(time.Second):
+		t.Fatal("Close did not join rejected player")
+	}
+	if !worker.Closed() || !prepared.aliasRetired || app.currentPlayer != nil || app.openedWriterOwner != nil {
+		t.Fatal("prepared no-writer player escaped shutdown")
+	}
+	called := false
+	if _, err := app.replaceAppPlayer(context.Background(), nil, func(context.Context) (*AppPlayer, error) { called = true; return nil, nil }); err == nil || called {
+		t.Fatal("closed daemon admitted another authentication attempt")
+	}
+}
