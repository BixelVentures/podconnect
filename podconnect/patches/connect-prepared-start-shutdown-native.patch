+
+// startPreparedDealerTransfer never resolves, seeks or reloads content. It
+// admits exactly the stream/context/session already prepared by the dealer
+// actor through the same C and native START steps as selected-content playback.
+func (p *AppPlayer) startPreparedDealerTransfer(ctx context.Context, paused bool, position int64) (*contentOperation, error) {
+	account, authenticated := p.sess.BoundUsername()
+	p.aliasMu.Lock()
+	binding := p.aliasBindingLocked()
+	homepod := ""
+	for _, alias := range p.aliasRegistry {
+		if alias.ID == p.state.device.SelectedAliasId {
+			homepod = alias.HomePodID
+			break
+		}
+	}
+	p.aliasMu.Unlock()
+	if !authenticated || binding == nil || !binding.Ready || p.primaryStream == nil || p.primaryStream.Source == nil || p.state.tracks == nil || p.primaryLoadOrdinal == 0 {
+		return nil, ErrAliasConflict
+	}
+	capture, err := p.captureContent(roomVolumeScope{account, p.app.deviceId, binding.RoomID, homepod})
+	if err != nil {
+		return nil, err
+	}
+	// A prepared decoder is not yet the worker's selected source or an output.
+	if capture.Source != nil || capture.Primary != p.primaryStream || capture.SessionID == "" || capture.TargetAlias != capture.SelectedAlias {
+		return nil, ErrAliasConflict
+	}
+	target, err := capture.readCState(ctx)
+	if err != nil {
+		return nil, err
+	}
+	value, err := p.offerContent(contentOfferActorRequest{capture, target.Target, ctx})
+	if err != nil {
+		return nil, err
+	}
+	op := value.(*contentOperation)
+	p.aliasMu.Lock()
+	if ctx.Err() != nil || !p.contentCurrentLocked(capture) || p.roomNativeIntent == ^uint64(0) {
+		p.aliasMu.Unlock()
+		return nil, ErrAliasConflict
+	}
+	p.roomNativeIntent++
+	capture.Intent = p.roomNativeIntent
+	op.Revision = strconv.FormatUint(p.roomNativeIntent, 10)
+	op.Intended = roomTransportIdentity{account, p.app.deviceId, binding.RoomID, homepod, capture.Connection, capture.SessionID, capture.AliasIncarnation, capture.Registry, capture.AliasRevision}
+	if !nativeBoundOwnerValid(op.Intended) {
+		p.aliasMu.Unlock()
+		return nil, ErrAliasConflict
+	}
+	op.preparedDealer, op.preparedPaused, op.initialLoadOrdinal = true, paused, p.primaryLoadOrdinal
+	op.Claimed, op.State = true, "staged"
+	op.StagedUntil = op.Expires
+	op.Stream, op.Tracks = p.primaryStream, p.state.tracks
+	op.Prepared = proto.Clone(p.state.player).(*connectpb.PlayerState)
+	op.Prepared.IsPlaying, op.Prepared.IsPaused, op.Prepared.IsBuffering = true, paused, false
+	op.Prepared.PositionAsOfTimestamp, op.Prepared.Timestamp = position, time.Now().UnixMilli()
+	op.Prepared.PlaybackId = hex.EncodeToString(op.Stream.PlaybackId)
+	op.Prepared.Duration = int64(op.Stream.Media.Duration())
+	op.ContentDigest = contentDigest(struct {
+		State   *connectpb.PlayerState
+		Binding string
+	}{op.Prepared, op.Offer.BindingID})
+	p.aliasMu.Unlock()
+	op.commit(ctx, nil)
+	op.mu.Lock()
+	complete := op.Terminal && op.State == "complete"
+	op.mu.Unlock()
+	p.aliasMu.Lock()
+	if p.roomContentReservation != nil && p.roomContentReservation.Operation == op {
+		p.roomContentReservation = nil
+	}
+	if !complete {
+		p.roomContentQuarantined = true
+	}
+	p.aliasMu.Unlock()
+	if !complete {
+		return op, ErrAliasConflict
+	}
+	return op, nil
+}
