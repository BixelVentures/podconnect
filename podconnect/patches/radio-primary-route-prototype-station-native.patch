+		}
+		var discriminator struct{ Schema string }
+		_ = json.Unmarshal(raw, &discriminator)
+		switch discriminator.Schema {
+		case cPrimaryStartSchema:
+			var r radioPrimaryStartWire
+			if strictVolumeJSON(raw, &r) != nil || r.Device != target.Device {
+				w.WriteHeader(http.StatusBadRequest)
