+			case "result":
+				ack.Phase, ack.Session = "playing", &binding
+			default:
+				w.WriteHeader(http.StatusBadRequest)
+				return
+			}
+			_ = json.NewEncoder(w).Encode(ack)
+		case primaryRadioStopSchema:
+			var r radioPrimaryStopRequest
+			if strictVolumeJSON(raw, &r) != nil || r.Action != stopAction || r.radioPrimaryBinding != binding {
+				w.WriteHeader(http.StatusBadRequest)
+				return
+			}
+			ack := radioPrimaryStopReceipt{radioPrimaryStopRequest: r}
+			if r.Phase == "claim_stop" {
+				stops.Add(1)
+				ack.Phase = "pending"
+			} else {
+				ack.Phase, ack.TeardownCSeq = "released", 8
+			}
+			_ = json.NewEncoder(w).Encode(ack)
+		default:
+			w.WriteHeader(http.StatusBadRequest)
+		}
+	}))
+	defer server.Close()
+	p.app.cfg.RoomTransportOwnToneURL = server.URL
+	ctx := context.Background()
+	ask := func(r radioPrimaryCommand, phase string) radioPrimaryReply {
+		t.Helper()
+		reply, err := p.radioPrimaryActor(ctx, r)
+		if err != nil {
+			t.Fatal(err)
+		}
+		ack, ok := reply.(radioPrimaryReply)
+		if !ok || ack.Phase != phase {
+			t.Fatalf("want %s, got %v", phase, reply)
+		}
+		return ack
+	}
+	request := radioPrimaryCommand{Schema: nativePrimarySchema, Phase: "reserve", Process: radioProcessID(op.Capture.Process),
+		Handoff: process, Generation: "1", Action: startAction, Target: "r1", Intent: "0", From: "r0"}
+	request.Owner = ask(request, "reserved").Owner
+	request.Phase, request.Station = "prepare_start", "p3"
+	ask(request, "prepared")
+	request.Phase = "start"
+	ask(request, "pending")
+	if _, err := p.radioPrimaryActor(ctx, request); err == nil {
+		t.Fatal("duplicate station action replayed")
+	}
+	request.Phase, request.ForPhase = "result", "start"
+	if ack := ask(request, "playing"); ack.Session == nil || *ack.Session != binding || ack.Observation.Source != "radio" {
+		t.Fatal("wrong live primary receipt")
+	}
+	request.Phase, request.ForPhase, request.Station, request.Owner = "reserve", "", "", ""
+	request.Action, request.Generation, request.From = stopAction, "2", request.Target
+	request.Owner = ask(request, "reserved").Owner
+	request.Phase, request.Session = "stop", &binding
+	ask(request, "pending")
+	request.Phase, request.ForPhase = "result", "stop"
+	if ack := ask(request, "released"); ack.CSeq != 8 || ack.Observation.Source != "none" {
+		t.Fatal("wrong exact release receipt")
+	}
+	if starts.Load() != 1 || stops.Load() != 1 || p.primaryStream != op.Capture.Primary || p.state.player != op.Capture.PlayerState {
+		t.Fatal("actor replayed effects or changed the disjoint Spotify source")
+	}
+}
