+package daemon
+
+import (
+	"context"
+	"strconv"
+	"strings"
+)
+
+type radioPrimaryPreviousRelease struct {
+	radioPrimaryBinding
+	Action       string `json:"action"`
+	TeardownCSeq int    `json:"teardown_cseq"`
+}
+
+func primaryReplacementPending(h *radioHold) bool {
+	return h != nil && h.PrimaryPending != nil && h.PrimaryPending.Reserve.Session != nil && !h.PrimaryPending.ReplacementDone
+}
+
+func (p *AppPlayer) reservePrimaryRadioReplacement(r radioPrimaryCommand, h *radioHold) (any, error) {
+	app := p.app
+	generation, err := strconv.ParseUint(r.Generation, 10, 64)
+	if err != nil || generation <= app.radio.Generation || r.Owner != "" || r.ForPhase != "" || r.Station != "" ||
+		r.From == "" || r.Session == nil || !r.Session.valid() {
+		return nil, ErrAliasConflict
+	}
+	old := app.radio.Holds[r.From]
+	if old == nil || old.owner != p || old.Phase != "primary_active" || old.Primary == nil || *old.Primary != *r.Session ||
+		p.primaryRadioRoom(r.From) != r.Session.DeviceID || old.PrimaryAction != "" {
+		return nil, ErrAliasConflict
+	}
+	for _, candidate := range app.radio.Holds {
+		if primaryReplacementPending(candidate) {
+			return nil, ErrAliasConflict
+		}
+	}
+	if h != old {
+		if h != nil && !primaryRadioRetired(h) {
+			return nil, ErrAliasConflict
+		}
+		h = &radioHold{owner: p, Phase: "primary_reserved", Actions: map[string]bool{},
+			Request: radioRequest{Schema: "podconnect.native_radio_primary_hold.v1", ProcessID: r.Process,
+				TargetID: r.Target, HandoffID: r.Handoff, Generation: r.Generation, ActionID: r.Action, ExpectedRevision: r.Intent}}
+	}
+	incumbent := *old.Primary
+	r.Session = &incumbent
+	r.Owner = r.Generation
+	h.PrimaryPending = &radioPrimaryPending{Reserve: r}
+	app.radio.Holds[r.Target], app.radio.Generation = h, generation
+	if err = app.persistRadioLocked(); err != nil {
+		return nil, err
+	}
+	r.Phase = "reserved"
+	return radioPrimaryReply{radioPrimaryCommand: r}, nil
+}
+
+func (p *AppPlayer) primaryRadioReplacementActor(ctx context.Context, r radioPrimaryCommand, h *radioHold, device string) (any, error) {
+	op := h.PrimaryPending
+	old := p.app.radio.Holds[op.Reserve.From]
+	if old == nil || old.owner != p {
+		return nil, ErrAliasConflict
+	}
+	if r.Phase == "prepare_replace" || r.Phase == "result" && r.ForPhase == "prepare_replace" {
+		return p.primaryRadioPrepareReplacement(ctx, r, h, old, device)
+	}
+	if r.Phase == "stop" || r.Phase == "result" && r.ForPhase == "stop" {
+		if op.ReplacementRejected && op.Stopped != nil && r.Phase == "result" && r.Session != nil && *r.Session == *op.Reserve.Session && r.Station == "" {
+			r.Phase = "replacement_rejected"
+			return radioPrimaryReply{radioPrimaryCommand: r}, nil
+		}
+		if op.Decoded && !op.ReplacementRejected {
+			return p.primaryRadioReplacementStop(ctx, r, h, old)
+		}
+		return nil, ErrAliasConflict
+	}
+	if !op.Decoded || op.ReplacementRejected {
+		return nil, ErrAliasConflict
+	}
+	if op.PriorRelease == nil || r.Station != op.Station || r.Session != nil {
+		return nil, ErrAliasConflict
+	}
+	if r.Phase == "prepare_start" || r.Phase == "result" && r.ForPhase == "prepare_start" {
+		r.Phase = "prepared"
+		return radioPrimaryReply{radioPrimaryCommand: r}, nil
+	}
+	if r.Phase != "start" && !(r.Phase == "result" && r.ForPhase == "start") {
+		return nil, ErrAliasConflict
+	}
+	return p.primaryRadioReplacementStart(ctx, r, h)
+}
+
+func (p *AppPlayer) primaryRadioPrepareReplacement(ctx context.Context, r radioPrimaryCommand, h, old *radioHold, device string) (any, error) {
+	op, app := h.PrimaryPending, p.app
+	if r.Session == nil || *r.Session != *op.Reserve.Session || !nativeOwnerASCII(r.Station, 31) ||
+		(op.Station != "" && op.Station != r.Station) {
+		return nil, ErrAliasConflict
+	}
+	if op.ReplacementRejected && r.Phase == "result" {
+		r.Phase = "replacement_rejected"
+		return radioPrimaryReply{radioPrimaryCommand: r}, nil
+	}
+	if op.ReplacementDone || old.Phase != "primary_active" || old.Primary == nil || *old.Primary != *r.Session {
+		return nil, ErrAliasConflict
+	}
+	wire := radioPrimaryStartWire{Schema: cPrimaryStartSchema, Phase: "result", Predecessor: r.Session,
+		Action: r.Action, Station: r.Station, Generation: r.Generation}
+	if r.Phase == "prepare_replace" {
+		if r.ForPhase != "" || op.Target != nil {
+			return nil, ErrAliasConflict
+		}
+		target, err := p.primaryRadioCStart(ctx, radioPrimaryStartWire{
+			Schema: cPrimaryStartSchema, Phase: "preflight_replace_target", Predecessor: r.Session,
+			radioPrimaryTarget: radioPrimaryTarget{Device: device},
+		}, false)
+		if err != nil {
+			// This was a read-only target lookup. Retire our unstarted
+			// candidate without touching the predecessor or receiver.
+			op.Station = r.Station
+			return p.rejectPrimaryRadioReplacement(r, h, old)
+		}
+		op.Target, op.Station = &target.radioPrimaryTarget, r.Station
+		if err = app.persistRadioLocked(); err != nil {
+			return nil, err
+		}
+		wire.Phase = "preflight_replace"
+	}
+	if op.Target == nil || op.Station != r.Station || op.Target.Device != device {
+		return nil, ErrAliasConflict
+	}
+	wire.radioPrimaryTarget = *op.Target
+	ack, err := p.primaryRadioCStart(ctx, wire, false)
+	if err != nil {
+		return nil, err
+	}
+	switch ack.Phase {
+	case "pending":
+		r.Phase = "pending"
+	case "decoded":
+		op.Decoded, r.Phase = true, "replacement_prepared"
+	case "rejected":
+		return p.rejectPrimaryRadioReplacement(r, h, old)
+	default:
+		return nil, ErrAliasConflict
+	}
+	if err = app.persistRadioLocked(); err != nil {
+		return nil, err
+	}
+	return radioPrimaryReply{radioPrimaryCommand: r}, nil
+}
+
+func (p *AppPlayer) rejectPrimaryRadioReplacement(r radioPrimaryCommand, h, old *radioHold) (any, error) {
+	op := h.PrimaryPending
+	op.ReplacementDone, op.ReplacementRejected, r.Phase = true, true, "replacement_rejected"
+	if h != old {
+		h.Phase = "primary_rejected"
+	}
+	if err := p.app.persistRadioLocked(); err != nil {
+		return nil, err
+	}
+	return radioPrimaryReply{radioPrimaryCommand: r}, nil
+}
+
+func (p *AppPlayer) primaryRadioReplacementStop(ctx context.Context, r radioPrimaryCommand, h, old *radioHold) (any, error) {
+	app, op := p.app, h.PrimaryPending
+	if r.Session == nil || *r.Session != *op.Reserve.Session || r.Station != "" || op.ReplacementDone ||
+		old.Primary == nil || *old.Primary != *r.Session || op.ActivationSent || old.PrimaryPending == nil {
+		return nil, ErrAliasConflict
+	}
+	if op.PriorRelease != nil {
+		if r.Phase != "result" {
+			return nil, ErrAliasConflict
+		}
+		return primaryRadioReplacementStopReply(r, *op.PriorRelease), nil
+	}
+	wire := radioPrimaryStopRequest{Schema: primaryRadioStopSchema, Phase: "result_stop_replace", Action: r.Action, radioPrimaryBinding: *r.Session}
+	if r.Phase == "stop" {
+		if r.ForPhase != "" || op.Stopped != nil || old.Phase != "primary_active" || old.PrimaryAction != "" {
+			return nil, ErrAliasConflict
+		}
+		admitted := r
+		op.Stopped, old.Phase, old.PrimaryAction = &admitted, "primary_stop_pending", r.Action
+		if err := app.persistRadioLocked(); err != nil {
+			return nil, err
+		}
+		wire.Phase = "claim_stop_replace"
+	} else if op.Stopped == nil || old.Phase != "primary_stop_pending" || old.PrimaryAction != r.Action {
+		return nil, ErrAliasConflict
+	}
+	var ack radioPrimaryStopReceipt
+	endpoint := strings.TrimSuffix(app.cfg.RoomTransportOwnToneURL, "/") + "/api/outputs/" + wire.DeviceID + "/radio-handoff/reacquire"
+	if err := radioAuthenticatedHTTP(ctx, endpoint, app.cfg.RadioHandoffControlToken, wire, &ack); err != nil {
+		return nil, err
+	}
+	if ack.Schema != wire.Schema || ack.Action != wire.Action || ack.radioPrimaryBinding != wire.radioPrimaryBinding {
+		return nil, ErrAliasConflict
+	}
+	if ack.Phase == "pending" && ack.TeardownCSeq == 0 {
+		r.Phase = "pending"
+		return radioPrimaryReply{radioPrimaryCommand: r}, nil
+	}
+	if ack.Phase == "replacement_rejected" && ack.TeardownCSeq == 0 {
+		old.Phase, old.PrimaryAction = "primary_active", ""
+		return p.rejectPrimaryRadioReplacement(r, h, old)
+	}
+	if ack.Phase != "released" || ack.TeardownCSeq <= 0 {
+		return nil, ErrAliasConflict
+	}
+	op.PriorRelease = &ack
+	if old != h {
+		old.Phase, old.PrimaryPending.Released = "primary_released", ack.TeardownCSeq
+	}
+	h.Phase = "primary_replacement_released"
+	if err := app.persistRadioLocked(); err != nil {
+		return nil, err
+	}
+	return primaryRadioReplacementStopReply(r, ack), nil
+}
+
+func primaryRadioReplacementStopReply(r radioPrimaryCommand, ack radioPrimaryStopReceipt) radioPrimaryReply {
+	r.Phase = "released"
+	source := r
+	source.Target = r.From
+	return radioPrimaryReply{radioPrimaryCommand: r, CSeq: ack.TeardownCSeq, Observation: primaryObservation(source, "stopped", "none")}
+}
+
+func (p *AppPlayer) primaryRadioReplacementStart(ctx context.Context, r radioPrimaryCommand, h *radioHold) (any, error) {
+	app, op := p.app, h.PrimaryPending
+	if op.Target == nil || op.PriorRelease == nil {
+		return nil, ErrAliasConflict
+	}
+	wire := radioPrimaryStartWire{Schema: cPrimaryStartSchema, Phase: "result", Action: r.Action,
+		Station: r.Station, Generation: r.Generation, radioPrimaryTarget: *op.Target, Predecessor: op.Reserve.Session}
+	if r.Phase == "start" {
+		if r.ForPhase != "" || h.Phase != "primary_replacement_released" || op.Started != nil || op.ReplacementDone {
+			return nil, ErrAliasConflict
+		}
+		admitted := r
+		op.Started, op.ActivationSent, h.Phase = &admitted, true, "primary_start_pending"
+		if err := app.persistRadioLocked(); err != nil {
+			return nil, err
+		}
+		release := *op.PriorRelease
+		wire.PriorRelease = &radioPrimaryPreviousRelease{release.radioPrimaryBinding, release.Action, release.TeardownCSeq}
+		wire.Phase = "activate_replace"
+		if h.PrimaryPark != nil {
+			wire.ParkToken = h.PrimaryPark.Token
+		}
+	} else if op.Started == nil || h.Phase != "primary_start_pending" && h.Phase != "primary_active" {
+		return nil, ErrAliasConflict
+	}
+	alreadyObserved := h.Phase == "primary_active" && op.ReplacementDone
+	ack, err := p.primaryRadioCStart(ctx, wire, false)
+	if err != nil {
+		return nil, err
+	}
+	if alreadyObserved {
+		if ack.Phase != "playing" || ack.Session == nil || h.Primary == nil || *ack.Session != *h.Primary {
+			return nil, ErrAliasConflict
+		}
+		r.Session, r.Phase = ack.Session, "playing"
+		return radioPrimaryReply{radioPrimaryCommand: r, Observation: primaryObservation(r, "playing", "radio")}, nil
+	}
+	switch ack.Phase {
+	case "pending":
+		r.Phase = "pending"
+	case "playing":
+		h.Primary, h.PrimaryAction, h.Phase = ack.Session, "", "primary_active"
+		h.PrimaryStatus = primaryRadioActiveRead(wire, r.Owner, false)
+		h.Request = radioRequest{Schema: "podconnect.native_radio_primary_hold.v1", ProcessID: r.Process,
+			TargetID: r.Target, HandoffID: r.Handoff, Generation: r.Generation, ActionID: r.Action, ExpectedRevision: r.Intent}
+		op.ReplacementDone = true
+		r.Session, r.Phase = ack.Session, "playing"
+	default:
+		h.Phase = "unknown"
+		_ = app.persistRadioLocked()
+		return nil, ErrAliasConflict
+	}
+	if err = app.persistRadioLocked(); err != nil {
+		return nil, err
+	}
+	reply := radioPrimaryReply{radioPrimaryCommand: r}
+	if r.Phase == "playing" {
+		reply.Observation = primaryObservation(r, "playing", "radio")
+	}
+	return reply, nil
+}
