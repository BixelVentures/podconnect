+/* Orphaned primary radio park: the owner that could still send STOP for it is
+ * provably gone. The old process died (different process id), or this process
+ * recorded that the receiver's RTSP control connection was lost. No session,
+ * pending start or open Spotify writer remains. The AirPlay receiver expires
+ * its own stale session, as in any normal takeover. No STOP receipt is invented:
+ * the park slot and the unreleased custody row are removed under their exact
+ * current contents and the release is logged. */
+static void
+radio_orphan_release(uint64_t id)
+{
+  struct radio_handoff_slot *slot = radio_handoff_find(id);
+  const struct output_device *d = outputs_device_get(id);
+  char key[64], *raw = NULL, *again = NULL;
+  struct output_primary_radio_custody custody;
+  const char *reason = NULL;
+
+  if (!slot || !slot->used || !d || !radio_primary_park_command(&slot->result.command))
+    return;
+#define ORPHAN_KEEP(test, stage) do { if (test) { DPRINTF(E_LOG, L_PLAYER, "Radio orphan kept: output=%" PRIu64 " stage=%s\n", id, stage); return; } } while (0)
+  ORPHAN_KEEP(slot->quarantined, "quarantined_record");
+  ORPHAN_KEEP(radio_handoff_fault || radio_absence_fault || radio_parked_absence_fault, "fault");
+  ORPHAN_KEEP(slot->result.phase != OUTPUT_RADIO_SUSPENDED && slot->result.phase != OUTPUT_RADIO_UNKNOWN, "phase");
+  ORPHAN_KEEP(d->session, "live_session");
+  ORPHAN_KEEP(outputs_start_busy() || start_journal_fault || start_startup_quarantine, "start_busy_or_fault");
+  const struct output_queue_writer *writer = &slot->result.command.writer;
+  ORPHAN_KEEP(start_all_writers_closed_scan(&writer->native_process, writer->pipe_device, writer->pipe_inode, true) != 1, "spotify_writer_open");
+#undef ORPHAN_KEEP
+  primary_radio_custody_key(key, id);
+  int found = db_radio_handoff_load_key(key, &raw);
+  if (found < 0)
+    return;
+  if (found == 0)
+    reason = "no_custody";
+  else if (raw && primary_radio_custody_decode(raw, id, &custody)
+      && !custody.stop_action[0] && !custody.teardown_cseq && strcmp(custody.process, outputs_process))
+    reason = "owner_process_gone";
+  else if (raw && primary_radio_custody_decode_isolation(raw, id, &custody))
+    reason = "receiver_control_lost";
+  else if (raw)
+    {
+      /* A peer-loss isolation row written by a process that has since died. */
+      json_object *row = json_tokener_parse(raw), *marker;
+      if (row && json_object_object_get_ex(row, "local_isolation", &marker)
+          && json_object_is_type(marker, json_type_string)
+          && !strcmp(json_object_get_string(marker), "rtsp_control_lost"))
+        {
+          json_object_object_del(row, "local_isolation");
+          const char *plain = json_object_to_json_string_ext(row, JSON_C_TO_STRING_PLAIN);
+          if (plain && primary_radio_custody_decode(plain, id, &custody) && !custody.stop_action[0]
+              && !custody.teardown_cseq && strcmp(custody.process, outputs_process))
+            reason = "owner_process_gone";
+        }
+      if (row)
+        json_object_put(row);
+    }
+  if (!reason)
+    {
+      DPRINTF(E_LOG, L_PLAYER, "Radio orphan kept: output=%" PRIu64 " stage=custody_owner_alive\n", id);
+      free(raw);
+      return;
+    }
+  if (found == 1 && (db_radio_handoff_load_key(key, &again) != 1 || strcmp(raw, again)
+      || db_admin_delete(key) < 0))
+    {
+      free(raw);
+      free(again);
+      return;
+    }
+  free(raw);
+  free(again);
+  DPRINTF(E_LOG, L_PLAYER, "Radio orphan released: output=%" PRIu64 " reason=%s phase=%d\n", id, reason, (int)slot->result.phase);
+  memset(slot, 0, sizeof(*slot));
+  primary_cold_detachment_reset();
+  (void)radio_handoff_save();
+}
