+func TestRoomTerminalNextOffAndCancelledHaveDistinctErrors(t *testing.T) {
+	list, err := NewTrackListFromContext(context.Background(), &librespot.NullLogger{}, nil, &connectpb.Context{Uri: "spotify:playlist:0000000000000000000001", Pages: []*connectpb.ContextPage{{Tracks: []*connectpb.ContextTrack{{Uri: "spotify:track:0000000000000000000001"}}}}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err = list.TrySeek(context.Background(), func(*connectpb.ContextTrack) bool { return true }); err != nil {
+		t.Fatal(err)
+	}
+	if _, err = list.PrepareTransportWithRepeat(context.Background(), false, 0, false); !errors.Is(err, ErrNoNextTrack) {
+		t.Fatal(err)
+	}
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	if _, err = list.PrepareTransportWithRepeat(ctx, false, 0, true); !errors.Is(err, context.Canceled) {
+		t.Fatal("cancelled prepare looked like exhausted queue", err)
+	}
+}
