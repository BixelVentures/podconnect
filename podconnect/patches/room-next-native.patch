+func TestRoomTerminalNextContextRepeatIsDetachedAndManualQueueWins(t *testing.T) {
+	for _, manual := range []bool{false, true} {
+		t.Run(fmt.Sprint(manual), func(t *testing.T) {
+			rows := []*connectpb.ContextTrack{{Uri: "spotify:track:0000000000000000000001"}, {Uri: "spotify:track:0000000000000000000002"}}
+			list, err := NewTrackListFromContext(context.Background(), &librespot.NullLogger{}, nil, &connectpb.Context{Uri: "spotify:playlist:0000000000000000000001", Pages: []*connectpb.ContextPage{{Tracks: rows}}})
+			if err != nil {
+				t.Fatal(err)
+			}
+			if err = list.TrySeek(context.Background(), func(row *connectpb.ContextTrack) bool { return row.Uri == rows[1].Uri }); err != nil {
+				t.Fatal(err)
+			}
+			if manual {
+				list.AddToQueue(&connectpb.ContextTrack{Uri: "spotify:track:0000000000000000000009"})
+			}
+			revision, position := list.TransportRevision(), list.tracks.pos
+			prepared, err := list.PrepareTransportWithRepeat(context.Background(), false, 0, true)
+			if err != nil {
+				t.Fatal(err)
+			}
+			want := rows[0].Uri
+			if manual {
+				want = "spotify:track:0000000000000000000009"
+			}
+			if prepared.CurrentTrack().Uri != want || list.CurrentTrack().Uri != rows[1].Uri || list.TransportRevision() != revision || list.tracks.pos != position {
+				t.Fatal("repeat preparation changed retained order/cursor/revision")
+			}
+		})
+	}
+}
