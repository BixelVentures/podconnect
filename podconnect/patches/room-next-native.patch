+func TestRoomTerminalNextAutoplayOffStationAndCancelledDoNotResolve(t *testing.T) {
+	for _, mode := range []string{"off", "station", "cancelled"} {
+		t.Run(mode, func(t *testing.T) {
+			p := nextFixture(t)
+			calls := 0
+			ctx, cancel := context.WithCancel(context.Background())
+			defer cancel()
+			if mode == "off" {
+				p.app.cfg.DisableAutoplay = true
+			}
+			if mode == "station" {
+				p.state.player.ContextUri = nextStation
+			}
+			if mode == "cancelled" {
+				cancel()
+			}
+			_, _, err := p.prepareRoomTransportTrack(ctx, false, nextSpclient(t, &calls, nextTrack, nil))
+			if err == nil || calls != 0 {
+				t.Fatalf("invalid station read: %v %d", err, calls)
+			}
+		})
+	}
+}
