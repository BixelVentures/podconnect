+func TestRoomTerminalNextContextRepeatAndManualQueuePrecedeAutoplay(t *testing.T) {
+	for _, mode := range []string{"context-repeat", "repeat-track-bypassed", "manual-queue"} {
+		t.Run(mode, func(t *testing.T) {
+			p := nextFixture(t)
+			calls := 0
+			p.state.player.Options.RepeatingContext = mode == "context-repeat"
+			p.state.player.Options.RepeatingTrack = mode == "repeat-track-bypassed"
+			if mode == "manual-queue" {
+				p.state.tracks.AddToQueue(&connectpb.ContextTrack{Uri: nextTrack})
+			}
+			staged, state, err := p.prepareRoomTransportTrack(context.Background(), false, nextSpclient(t, &calls, nextTrack, nil))
+			if err != nil {
+				t.Fatal(err)
+			}
+			if mode != "repeat-track-bypassed" && state.SessionId != p.state.player.SessionId {
+				t.Fatal("ordinary next changed playback session")
+			}
+			if mode == "repeat-track-bypassed" {
+				if calls != 1 || state.ContextUri != nextStation {
+					t.Fatal("explicit Next repeated current track")
+				}
+			} else {
+				if calls != 0 || state.ContextUri != pContext {
+					t.Fatal("repeat/queued next unnecessarily resolved station")
+				}
+			}
+			expected := nextTrack
+			if mode == "context-repeat" {
+				expected = oldTrack
+			}
+			if staged.CurrentTrack().Uri != expected || p.state.tracks.CurrentTrack().Uri != oldTrack {
+				t.Fatal("detached repeat/manual order incorrect")
+			}
+		})
+	}
+}
