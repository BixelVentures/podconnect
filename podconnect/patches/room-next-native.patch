+func TestRoomNextPageFailureIsNotExhaustion(t *testing.T) {
+	for _, repeat := range []bool{false, true} {
+		t.Run(fmt.Sprint(repeat), func(t *testing.T) {
+			list := occurrenceFixture(t)
+			list.tracks.pos = len(list.tracks.list) - 1
+			fault := errors.New("inert next-page failure")
+			list.tracks.pages = queuePreparePages(func(context.Context, int) ([]*connectpb.ContextTrack, error) { return nil, fault })
+			_, err := list.PrepareTransportWithRepeat(context.Background(), false, 0, repeat)
+			if !errors.Is(err, fault) || errors.Is(err, ErrNoNextTrack) {
+				t.Fatalf("page failure classified as exhaustion: %v", err)
+			}
+		})
+	}
+}
