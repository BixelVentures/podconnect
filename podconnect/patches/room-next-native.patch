+func nextFixture(t *testing.T) *AppPlayer {
+	p := pc13ExistingPlayer(t, true)
+	p.app.mpris = mpris.DummyServer{}
+	p.state.device.Volume = uint32(player.MaxStateVolume * 64 / 100)
+	return p
+}
+func nextSpclient(t *testing.T, calls *int, stationTrack string, during func()) *spclient.Spclient {
+	return pc13Spclient(t, pc13RoundTrip(func(r *http.Request) (*http.Response, error) {
+		*calls++
+		if *calls > 1 {
+			t.Fatal("autoplay repeated its request")
+		}
+		if r.Method != "POST" || r.URL.Path != "/context-resolve/v1/autoplay" {
+			t.Fatalf("unexpected request %s %s", r.Method, r.URL)
+		}
+		b, err := io.ReadAll(r.Body)
+		if err != nil {
+			t.Fatal(err)
+		}
+		req := &playerpb.AutoplayContextRequest{}
+		if err = proto.Unmarshal(b, req); err != nil {
+			t.Fatal(err)
+		}
+		if req.GetContextUri() != pContext || len(req.RecentTrackUri) != 1 || req.RecentTrackUri[0] != oldTrack {
+			t.Fatalf("lost actual source/played history: %v", req)
+		}
+		if during != nil {
+			during()
+		}
+		body := fmt.Sprintf(`{"uri":%q,"metadata":{"provider_fixture":"real-context-read"},"pages":[{"tracks":[{"uri":%q}]}]}`, nextStation, stationTrack)
+		return &http.Response{StatusCode: 200, Header: make(http.Header), Body: io.NopCloser(strings.NewReader(body)), Request: r}, nil
+	}))
+}
+
+const pContext = "spotify:playlist:0000000000000000000002"
+const oldTrack = "spotify:track:0000000000000000000003"
