+// resolveAutoplayContext prepares explicit Next through the existing native autoplay resolver.
+// It performs only the existing context read, never an audio/output mutation.
+func resolveAutoplayContext(ctx context.Context, sp *spclient.Spclient, contextURI string, list *tracks.List, playedURI string) (*connectpb.Context, error) {
+	var recent []string
+	if list != nil {
+		rows, err := list.AllTracksWithError(ctx)
+		if err != nil {
+			return nil, err
+		}
+		for _, track := range rows {
+			recent = append(recent, track.Uri)
+		}
+	}
+	if err := ctx.Err(); err != nil {
+		return nil, err
+	}
+	if len(recent) == 0 {
+		return nil, nil
+	}
+	return sp.ContextResolveAutoplay(ctx, &playerpb.AutoplayContextRequest{ContextUri: proto.String(contextURI), RecentTrackUri: recent}, playedURI)
+}
+
+func (p *AppPlayer) prepareRoomTransportTrack(ctx context.Context, previous bool, sp *spclient.Spclient) (*tracks.List, *connectpb.PlayerState, error) {
+	state := proto.Clone(p.state.player).(*connectpb.PlayerState)
+	staged, err := p.state.tracks.PrepareTransportWithRepeat(ctx, previous, p.state.trackPosition(), state.Options.GetRepeatingContext())
+	if err != nil {
+		if previous || !errors.Is(err, tracks.ErrNoNextTrack) || p.app.cfg.DisableAutoplay || strings.HasPrefix(state.ContextUri, "spotify:station:") {
+			return nil, nil, err
+		}
+		spotCtx, err := resolveAutoplayContext(ctx, sp, state.ContextUri, p.state.tracks, state.GetTrack().GetUri())
+		if err != nil {
+			return nil, nil, err
+		}
+		if spotCtx == nil {
+			return nil, nil, tracks.ErrNoNextTrack
+		}
+		staged, err = tracks.NewTrackListFromContext(ctx, p.app.log, sp, spotCtx)
+		if err != nil {
+			return nil, nil, err
+		}
+		if err = staged.Seek(ctx, func(*connectpb.ContextTrack) bool { return true }); err != nil {
+			return nil, nil, err
+		}
+		sessionID := make([]byte, 16)
+		if _, err := rand.Read(sessionID); err != nil {
+			return nil, nil, err
+		}
+		state.SessionId = base64.StdEncoding.EncodeToString(sessionID)
+		state.ContextUri, state.ContextUrl = spotCtx.Uri, spotCtx.Url
+		state.Restrictions, state.ContextRestrictions = spotCtx.Restrictions, spotCtx.Restrictions
+		if spotCtx.Restrictions != nil {
+			if len(spotCtx.Restrictions.DisallowTogglingShuffleReasons) > 0 {
+				state.Options.ShufflingContext = false
+			}
+			if len(spotCtx.Restrictions.DisallowTogglingRepeatTrackReasons) > 0 {
+				state.Options.RepeatingTrack = false
+			}
+			if len(spotCtx.Restrictions.DisallowTogglingRepeatContextReasons) > 0 {
+				state.Options.RepeatingContext = false
+			}
+		}
+		state.Suppressions = &connectpb.Suppressions{}
+		if state.ContextMetadata == nil {
+			state.ContextMetadata = map[string]string{}
+		}
+		for key, value := range spotCtx.Metadata {
+			state.ContextMetadata[key] = value
+		}
+		if err = staged.ToggleShuffle(ctx, state.Options.ShufflingContext); err != nil {
+			return nil, nil, fmt.Errorf("prepare autoplay shuffle: %w", err)
+		}
+	}
+	if err := ctx.Err(); err != nil {
+		return nil, nil, err
+	}
+	if !previous {
+		state.IsPaused = false
+	}
+	state.Track, state.PrevTracks, state.NextTracks, state.Index = staged.CurrentTrack(), staged.PrevTracks(), staged.NextTracks(ctx, nil), staged.Index()
+	return staged, state, nil
+}
