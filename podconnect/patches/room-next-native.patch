+// Inert session fields only: no login/authenticated welcome, output or provider.
+// This test-only injection lets the actual natural EOF dispatcher use its normal
+// Spclient and event getters, without adding a production test seam.
+func nextSessionField(s *session.Session, name string, value any) {
+	v := reflect.ValueOf(s).Elem().FieldByName(name)
+	reflect.NewAt(v.Type(), unsafe.Pointer(v.UnsafeAddr())).Elem().Set(reflect.ValueOf(value))
+}
