+func TestRoomNextLazyResolvedRowsAreDetached(t *testing.T) {
+	list := occurrenceFixture(t)
+	list.tracks.pos = len(list.tracks.list) - 1
+	row := &connectpb.ContextTrack{Uri: "spotify:track:4444444444444444444444", Metadata: map[string]string{"provider": "retained"}}
+	list.tracks.pages = queuePreparePages(func(context.Context, int) ([]*connectpb.ContextTrack, error) {
+		return []*connectpb.ContextTrack{row}, nil
+	})
+	prepared, err := list.PrepareTransportWithRepeat(context.Background(), false, 0, false)
+	if err != nil {
+		t.Fatal(err)
+	}
+	prepared.tracks.get().item.Metadata["provider"] = "staged"
+	if row.Metadata["provider"] != "retained" {
+		t.Fatal("next preparation aliases resolver-owned rows")
+	}
+}
