+func TestNaturalEOFDispatchesOneActualStationContextCommit(t *testing.T) {
+	p := nextFixture(t)
+	calls := 0
+	events := &nextEvents{}
+	p.sess = &session.Session{}
+	// Invalid station media deliberately ends AFTER real resolver/list/context
+	// commit, before decoding/audio. Distinct from the exhausted valid URI.
+	nextSessionField(p.sess, "sp", nextSpclient(t, &calls, "invalid-station-media-boundary", nil))
+	nextSessionField(p.sess, "events", events)
+	volume, alias := p.state.device.Volume, p.state.device.SelectedAliasId
+	p.handlePlayerEvent(context.Background(), &player.Event{Type: player.EventTypeNotPlaying})
+	if events.ends != 1 || calls != 1 || p.state.player.ContextUri != nextStation || p.state.player.Track.Uri != "invalid-station-media-boundary" || p.state.player.Track.Provider != "autoplay" || p.state.player.Track.Metadata["autoplay.is_autoplay"] != "true" {
+		t.Fatalf("EOF did not reach one real station commit: ends=%d calls=%d state=%v", events.ends, calls, p.state.player)
+	}
+	if p.state.device.Volume != volume || p.state.device.SelectedAliasId != alias {
+		t.Fatal("EOF reset manual volume or room alias")
+	}
+}
