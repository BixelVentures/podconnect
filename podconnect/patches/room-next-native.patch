+func TestRoomTerminalNextStagesAutoplayWithoutChangingRetainedOwner(t *testing.T) {
+	p := nextFixture(t)
+	before := proto.Clone(p.state.player)
+	list := p.state.tracks
+	revision := list.TransportRevision()
+	volume := p.state.device.Volume
+	calls := 0
+	staged, state, err := p.prepareRoomTransportTrack(context.Background(), false, nextSpclient(t, &calls, nextTrack, nil))
+	if err != nil || staged == nil || state == nil {
+		t.Fatalf("terminal Next has no detached autoplay successor: %v", err)
+	}
+	if calls != 1 || state.ContextUri != nextStation || state.Track.Uri != nextTrack || state.Track.Provider != "autoplay" || state.Track.Metadata["autoplay.is_autoplay"] != "true" || state.IsPaused {
+		t.Fatalf("wrong staged station: %v", state)
+	}
+	if !proto.Equal(before, p.state.player) || p.state.tracks != list || list.TransportRevision() != revision || list.CurrentTrack().Uri != oldTrack || p.state.device.Volume != volume || (state.SessionId == "" || state.SessionId == p.state.player.SessionId) {
+		t.Fatal("preparation mutated retained cursor/owner/manual volume")
+	}
+}
