+static int airplay_primary_radio_revoke(const struct airplay_primary_radio_route *);
+
+/* One producer per attached radio route. Only the player event loop can
+ * consume or emit. The producer never touches the output registry or FIFO. */
+#define PRIMARY_RADIO_PACKET_BYTES (AIRPLAY_SAMPLES_PER_PACKET * 4)
+#define PRIMARY_RADIO_QUEUE_PACKETS 8
+#define PRIMARY_RADIO_PACKET_US 7982
+
+struct primary_radio_decode
+{
+  struct airplay_session *session; /* player-owned, cleared before dropping owner reference */
+  struct airplay_primary_radio_route route;
+  const char *url; /* immutable station registry storage */
+  struct event *tick;
+  pthread_mutex_t mutex;
+  pthread_cond_t space;
+  atomic_bool cancelled;
+  atomic_uint refs;
+  bool done;
+  size_t head, count;
+  uint8_t pcm[PRIMARY_RADIO_QUEUE_PACKETS][PRIMARY_RADIO_PACKET_BYTES];
+};
+
+static void
+primary_radio_decode_unref(struct primary_radio_decode *decoder)
+{
+  if (atomic_fetch_sub(&decoder->refs, 1) != 1)
+    return;
+  pthread_cond_destroy(&decoder->space);
+  pthread_mutex_destroy(&decoder->mutex);
+  free(decoder);
+}
+
+static bool
+primary_radio_decode_cancelled(void *arg)
+{
+  struct primary_radio_decode *decoder = arg;
+  return atomic_load(&decoder->cancelled);
+}
+
+static void
+primary_radio_decode_cancel(struct primary_radio_decode *decoder)
+{
+  pthread_mutex_lock(&decoder->mutex);
+  atomic_store(&decoder->cancelled, true);
+  decoder->count = 0;
+  pthread_cond_signal(&decoder->space);
+  pthread_mutex_unlock(&decoder->mutex);
+}
+
+static void
+primary_radio_decoder_detach(struct airplay_session *session)
+{
+  struct primary_radio_decode *decoder = session->primary_radio_decoder;
+  if (!decoder)
+    return;
+  primary_radio_decode_cancel(decoder);
+  if (decoder->tick) event_free(decoder->tick);
+  decoder->session = NULL;
+  session->primary_radio_decoder = NULL;
+  primary_radio_decode_unref(decoder);
+}
+
+static void *
+primary_radio_decode_thread(void *arg)
+{
+  struct primary_radio_decode *decoder = arg;
+  struct media_quality quality = { 44100, 16, 2 };
+  struct transcode_decode_setup_args input = {
+    .profile = XCODE_PCM_NATIVE, .path = decoder->url,
+    .is_http = !strncmp(decoder->url, "https://", 8),
+    .cancelled = primary_radio_decode_cancelled, .cancelled_arg = decoder,
+  };
+  struct transcode_encode_setup_args output = { .profile = XCODE_PCM16, .quality = &quality };
+  struct transcode_ctx *stream = transcode_setup(input, output);
+  struct evbuffer *buffer = evbuffer_new();
+
+  while (stream && buffer && !primary_radio_decode_cancelled(decoder))
+    {
+      if (evbuffer_get_length(buffer) < PRIMARY_RADIO_PACKET_BYTES)
+        {
+          if (transcode(buffer, NULL, stream, 1) <= 0)
+            break;
+          continue;
+        }
+
+      pthread_mutex_lock(&decoder->mutex);
+      while (decoder->count == PRIMARY_RADIO_QUEUE_PACKETS && !primary_radio_decode_cancelled(decoder))
+        pthread_cond_wait(&decoder->space, &decoder->mutex);
+      if (!primary_radio_decode_cancelled(decoder))
+        {
+          size_t tail = (decoder->head + decoder->count) % PRIMARY_RADIO_QUEUE_PACKETS;
+          evbuffer_remove(buffer, decoder->pcm[tail], PRIMARY_RADIO_PACKET_BYTES);
+          decoder->count++;
+        }
+      pthread_mutex_unlock(&decoder->mutex);
+    }
+
+  if (stream) transcode_cleanup(&stream);
+  if (buffer) evbuffer_free(buffer);
+  pthread_mutex_lock(&decoder->mutex);
+  decoder->done = true;
+  pthread_mutex_unlock(&decoder->mutex);
+  primary_radio_decode_unref(decoder);
+  return NULL;
+}
+
+static void
+primary_radio_decoder_tick(int fd, short events, void *arg)
+{
+  struct primary_radio_decode *decoder = arg;
+  struct airplay_session *session = decoder->session;
+  uint8_t frame[PRIMARY_RADIO_PACKET_BYTES];
+  bool done, frame_ready = false;
+  struct timeval next = { 0, PRIMARY_RADIO_PACKET_US };
+  (void)fd;
+  (void)events;
+
+  pthread_mutex_lock(&decoder->mutex);
+  done = decoder->done;
+  if (decoder->count && !primary_radio_decode_cancelled(decoder))
+    {
+      memcpy(frame, decoder->pcm[decoder->head], sizeof(frame));
+      decoder->head = (decoder->head + 1) % PRIMARY_RADIO_QUEUE_PACKETS;
+      decoder->count--;
+      frame_ready = true;
+      pthread_cond_signal(&decoder->space);
+    }
+  pthread_mutex_unlock(&decoder->mutex);
+
+  if (frame_ready)
+    {
+      struct output_buffer buffer = { 0 };
+      buffer.data[0] = (struct output_data) {
+        .quality = { 44100, 16, 2 }, .buffer = frame,
+        .bufsize = sizeof(frame), .samples = AIRPLAY_SAMPLES_PER_PACKET,
+      };
+      if (clock_gettime(CLOCK_MONOTONIC, &buffer.pts)
+          || airplay_primary_radio_write(&decoder->route, &buffer) < 0)
+        {
+          primary_radio_decode_cancel(decoder);
+          if (!session->primary_radio_revoked)
+            {
+              session_failure(session);
+              return;
+            }
+        }
+    }
+
+  if (done && !frame_ready)
+    {
+      struct airplay_primary_radio_route route = decoder->route;
+      primary_radio_decoder_detach(session);
+      if (session->primary_radio_revoked)
+        sequence_start(AIRPLAY_SEQ_STOP, session, NULL, "primary_radio_decoder_drained");
+      else if (airplay_primary_radio_revoke(&route) < 0)
+        session_failure(session);
+      return;
+    }
+  if (evtimer_add(decoder->tick, &next) < 0)
+    session_failure(session);
+}
+
+static int
+airplay_primary_radio_decode(const struct airplay_primary_radio_route *route, const char *station)
+{
+  struct airplay_session *session = airplay_primary_radio_session(route);
+  const char *url = outputs_radio_station_url(station);
+  struct timeval first = { 0, 0 };
+  pthread_attr_t attr;
+  pthread_t thread;
+
+  if (!url || !primary_radio_live(session) || session->primary_radio_decoder)
+    return -1;
+
+  struct primary_radio_decode *decoder = calloc(1, sizeof(*decoder));
+  if (!decoder)
+    return -1;
+  if (pthread_mutex_init(&decoder->mutex, NULL))
+    {
+      free(decoder);
+      return -1;
+    }
+  if (pthread_cond_init(&decoder->space, NULL))
+    {
+      pthread_mutex_destroy(&decoder->mutex);
+      free(decoder);
+      return -1;
+    }
+  atomic_init(&decoder->cancelled, false);
+  atomic_init(&decoder->refs, 1);
+  decoder->session = session;
+  decoder->route = *route;
+  decoder->url = url;
+  decoder->tick = evtimer_new(evbase_player, primary_radio_decoder_tick, decoder);
+  session->primary_radio_decoder = decoder;
+  if (!decoder->tick || evtimer_add(decoder->tick, &first) || pthread_attr_init(&attr))
+    goto fail;
+  if (pthread_attr_setdetachstate(&attr, PTHREAD_CREATE_DETACHED))
+    {
+      pthread_attr_destroy(&attr);
+      goto fail;
+    }
+  atomic_fetch_add(&decoder->refs, 1);
+  int status = pthread_create(&thread, &attr, primary_radio_decode_thread, decoder);
+  pthread_attr_destroy(&attr);
+  if (!status)
+    return 0;
+  primary_radio_decode_unref(decoder);
+
+ fail:
+  primary_radio_decoder_detach(session);
+  return -1;
+}
+
+static void
+primary_radio_stop_after_decoder(struct airplay_session *session, const char *reason)
+{
+  if (session->primary_radio_decoder)
+    primary_radio_decode_cancel(session->primary_radio_decoder);
+  else
+    sequence_start(AIRPLAY_SEQ_STOP, session, NULL, reason);
+}
