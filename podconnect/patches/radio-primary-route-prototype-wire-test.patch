+/* RED uses the installed primary session constructor for both outputs. */
+struct airplay_primary_radio_route { uint64_t device_id, epoch; };
+static int
+airplay_primary_radio_start(struct output_device *device, struct airplay_primary_radio_route *route)
+{
+  int ret = outputs_device_start(device, NULL, false);
+  if (ret != 1) return -1;
+  *route = (struct airplay_primary_radio_route){ device->id, device->session_epoch };
+  return 0;
+}
+static int
+airplay_primary_radio_write(const struct airplay_primary_radio_route *route, struct output_buffer *obuf)
+{
+  (void)route;
+  airplay_write(obuf);
+  return 0;
+}
+static int
+airplay_primary_radio_revoke(const struct airplay_primary_radio_route *route)
+{
+  return airplay_device_stop(outputs_device_get(route->device_id), -1);
+}
+
+/* Two real transient receiver sessions in one primary player process. */
+static void
+primary_radio_wire_receiver(struct recovery_wire_fixture *f, struct event_base *base,
+    uint64_t id, const char *host)
+{
+  struct sockaddr_in address = { .sin_family = AF_INET };
+  struct airplay_extra *extra = calloc(1, sizeof(*extra));
+  struct output_device *device = calloc(1, sizeof(*device));
+  socklen_t length = sizeof(address);
+
+  assert(extra && device && inet_pton(AF_INET, host, &address.sin_addr) == 1);
+  f->base = base;
+  f->primary_route_receiver = true;
+  f->mode = 30; /* Reuse the ordinary 35% volume and transient receiver path. */
+  f->plain = evbuffer_new();
+  f->listener = evconnlistener_new_bind(base, recovery_wire_accept, f,
+      LEV_OPT_CLOSE_ON_FREE, 2, (struct sockaddr *)&address, sizeof(address));
+  assert(f->plain && f->listener);
+  assert(!getsockname(evconnlistener_get_fd(f->listener), (struct sockaddr *)&address, &length));
+
+  device->id = id;
+  device->name = strdup(id == 1 ? "primary-route-music-fixture" : "primary-route-radio-fixture");
+  device->type = OUTPUT_TYPE_AIRPLAY;
+  device->type_name = "AirPlay";
+  device->advertised = true;
+  device->quality = (struct media_quality){ 44100, 16, 2 };
+  device->v4_address = strdup(host);
+  device->v4_port = ntohs(address.sin_port);
+  device->extra_device_info = extra;
+  extra->mdns_name = strdup(device->name);
+  extra->supports_encryption = true;
+  f->device = outputs_device_add(device, false);
+  assert(f->device && !f->device->auth_key);
+  assert(!outputs_device_volume_register(f->device, 35, -1));
+
+  address.sin_port = 0;
+  f->udp_fd = socket(AF_INET, SOCK_DGRAM, 0);
+  assert(f->udp_fd >= 0 && !bind(f->udp_fd, (struct sockaddr *)&address, sizeof(address)));
+  assert(!getsockname(f->udp_fd, (struct sockaddr *)&address, &length));
+  f->udp_port = ntohs(address.sin_port);
+}
+
+static void
+primary_radio_wire_receiver_reset(struct recovery_wire_fixture *f)
+{
+  if (f->peer) bufferevent_free(f->peer);
+  f->peer = NULL;
+  pair_cipher_free(f->cipher);
+  f->cipher = NULL;
+  pair_setup_free(f->pair);
+  f->pair = NULL;
+  evbuffer_drain(f->plain, evbuffer_get_length(f->plain));
+  f->pair_messages = 0;
+  f->session_uri[0] = '\0';
+}
+
+static void
+primary_radio_wire_wait(struct recovery_wire_fixture *f, bool connected)
+{
+  for (int tries = 0; tries < 2000 && !f->failed; tries++)
+    {
+      struct airplay_session *session = f->device->session;
+      if ((!connected && !session)
+          || (connected && session && (session->state & AIRPLAY_STATE_F_CONNECTED)))
+        return;
+      event_base_loop(f->base, EVLOOP_NONBLOCK);
+      usleep(1000);
+    }
+  assert(!"receiver did not reach the expected real session state");
+}
+
+static int
+primary_radio_wire_packets(struct recovery_wire_fixture *f, uint16_t *sequence)
+{
+  uint8_t packet[4096];
+  ssize_t n;
+  int count = 0;
+
+  while ((n = recv(f->udp_fd, packet, sizeof(packet), MSG_DONTWAIT)) >= 0)
+    if (n > 12 && packet[0] >> 6 == 2 && (packet[1] & 0x7f) == AIRPLAY_RTP_PAYLOADTYPE)
+      {
+        *sequence = ((uint16_t)packet[2] << 8) | packet[3];
+        count++;
+      }
+  return count;
+}
+
+static int
+primary_radio_wire_case(void)
+{
+  struct recovery_wire_fixture music = { .udp_fd = -1 }, radio = { .udp_fd = -1 };
+  struct airplay_primary_radio_route route, next;
+  struct event_base *base = event_base_new();
+  char database[] = "/tmp/primary-radio-wire-db-XXXXXX";
+  int file = mkstemp(database), result = 0;
+  uint16_t music_seq = 0, radio_seq = 0, first_music_seq;
+  uint8_t a[AIRPLAY_SAMPLES_PER_PACKET * 4] = { 0 }, b[sizeof(a)];
+  struct output_buffer music_pcm = { 0 }, radio_pcm = { 0 };
+
+  assert(base && file >= 0 && !close(file));
+  evbase_player = base;
+  cfg = cfg_init(toplvl_cfg, CFGF_NONE);
+  assert(cfg);
+  cfg_setstr(cfg_getsec(cfg, "general"), "db_path", database);
+  assert(db_init(ATTENTION_TEST_SQLEXT_PATH) == 0 && db_perthread_init() == 0);
+  outputs_attention_uuid(outputs_process);
+  assert(outputs_attention_startup() == 0);
+  assert(airplay_init() == -1); /* Existing harness suppresses public sockets/discovery. */
+  keep_alive_timer = evtimer_new(base, airplay_keep_alive_timer_cb, NULL);
+  outputs_deferredev = evtimer_new(base, deferred_cb, NULL);
+  assert(keep_alive_timer && outputs_deferredev);
+  radio_wire_private_service(&airplay_timing_svc, timing_svc_cb, base);
+  radio_wire_private_service(&airplay_control_svc, control_svc_cb, base);
+  outputs_buffer_duration_ms = cfg_getint(cfg_getsec(cfg, "general"), "start_buffer_ms");
+  primary_radio_wire_receiver(&music, base, 1, "127.0.0.1");
+  primary_radio_wire_receiver(&radio, base, 2, "127.0.0.2");
+  active_recovery_wire = &music;
+
+  outputs_device_select(music.device, -1);
+  assert(outputs_device_start(music.device, NULL, false) == 1);
+  primary_radio_wire_wait(&music, true);
+  assert(music.cipher && music.pair_messages == 2 && music.volumes == 1);
+  memset(b, 0x19, sizeof(b));
+  music_pcm.data[0] = (struct output_data){
+    .quality = music.device->quality, .buffer = a, .bufsize = sizeof(a), .samples = AIRPLAY_SAMPLES_PER_PACKET,
+  };
+  radio_pcm.data[0] = (struct output_data){
+    .quality = radio.device->quality, .buffer = b, .bufsize = sizeof(b), .samples = AIRPLAY_SAMPLES_PER_PACKET,
+  };
+  clock_gettime(CLOCK_MONOTONIC, &music_pcm.pts);
+  airplay_write(&music_pcm);
+  assert(primary_radio_wire_packets(&music, &music_seq) == 1);
+  first_music_seq = music_seq;
+
+  assert(airplay_primary_radio_start(radio.device, &route) == 0);
+#ifdef RADIO_PRIMARY_SESSION_PROOF
+  assert(airplay_primary_radio_write(&route, &radio_pcm) < 0); /* Before real cipher/setup. */
+#endif
+  active_recovery_wire = &radio;
+  primary_radio_wire_wait(&radio, true);
+  assert(radio.cipher && radio.pair_messages == 2 && radio.volumes == 1 && !radio.device->auth_key);
+  assert(!radio.device->selected && music.device->selected);
+  clock_gettime(CLOCK_MONOTONIC, &music_pcm.pts);
+  airplay_write(&music_pcm);
+  assert(primary_radio_wire_packets(&music, &music_seq) == 1 && music_seq == (uint16_t)(first_music_seq + 1));
+  if (primary_radio_wire_packets(&radio, &radio_seq))
+    {
+      fputs("RADIO_PRIMARY_WIRE_RED: actual B receiver got A's audio on the same-format fan-out\n", stderr);
+      result = 1;
+      goto cleanup;
+    }
+
+  clock_gettime(CLOCK_MONOTONIC, &radio_pcm.pts);
+  assert(airplay_primary_radio_write(&route, &radio_pcm) == 0);
+  assert(primary_radio_wire_packets(&radio, &radio_seq) == 1);
+  assert(primary_radio_wire_packets(&music, &music_seq) == 0);
+  assert(airplay_primary_radio_revoke(&route) == 0);
+  assert(airplay_primary_radio_write(&route, &radio_pcm) < 0);
+  packets_resend(radio.device->session, radio_seq, 1);
+  assert(primary_radio_wire_packets(&radio, &radio_seq) == 0);
+  clock_gettime(CLOCK_MONOTONIC, &music_pcm.pts);
+  airplay_write(&music_pcm);
+  assert(primary_radio_wire_packets(&music, &music_seq) == 1 && music_seq == (uint16_t)(first_music_seq + 2));
+  primary_radio_wire_wait(&radio, false);
+  assert(radio.teardowns == 1 && music.teardowns == 0);
+
+  primary_radio_wire_receiver_reset(&radio);
+  assert(airplay_primary_radio_start(radio.device, &next) == 0);
+  primary_radio_wire_wait(&radio, true);
+  assert(radio.cipher && next.epoch != route.epoch);
+  assert(airplay_primary_radio_write(&route, &radio_pcm) < 0 && airplay_primary_radio_revoke(&route) < 0);
+  assert(primary_radio_wire_packets(&radio, &radio_seq) == 0);
+  assert(airplay_primary_radio_write(&next, &radio_pcm) == 0);
+  assert(primary_radio_wire_packets(&radio, &radio_seq) == 1);
+
+  primary_radio_wire_receiver_reset(&radio); /* Real unexpected RTSP disconnect. */
+  primary_radio_wire_wait(&radio, false);
+  assert(airplay_primary_radio_write(&next, &radio_pcm) < 0);
+  assert(radio.pc70_peer_sessions == 2 && radio.teardowns == 1 && music.teardowns == 0);
+
+  radio.primary_route_auth_required = true;
+  assert(airplay_primary_radio_start(radio.device, &next) == 0);
+  primary_radio_wire_wait(&radio, false);
+  assert(radio.pc70_peer_sessions == 3 && !radio.cipher && !radio.pair_messages
+      && !radio.device->auth_key && radio.teardowns == 1);
+  assert(music.device->session && ((struct airplay_session *)music.device->session)->state == AIRPLAY_STATE_STREAMING);
+  puts("PASS two real primary transient AirPlay sessions: separate RTP, scoped revoke, stale epoch denied, auth-required refusal");
+
+ cleanup:
+  while (airplay_sessions) session_cleanup(airplay_sessions);
+  while (outputs_device_list) outputs_device_remove(outputs_device_list);
+  struct recovery_wire_fixture *receivers[] = { &music, &radio };
+  for (size_t i = 0; i < ARRAY_SIZE(receivers); i++)
+    {
+      struct recovery_wire_fixture *receiver = receivers[i];
+      primary_radio_wire_receiver_reset(receiver);
+      evconnlistener_free(receiver->listener);
+      evbuffer_free(receiver->plain);
+      close(receiver->udp_fd);
+    }
+  service_stop(&airplay_timing_svc);
+  service_stop(&airplay_control_svc);
+  event_free(keep_alive_timer);
+  event_free(outputs_deferredev);
+  db_perthread_deinit();
+  db_deinit();
+  cfg_free(cfg);
+  event_base_free(base);
+  unlink(database);
+  return result;
+}
