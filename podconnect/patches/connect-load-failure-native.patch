+func TestPC58UnplayableFallbackRetainsContextOrStopsOnce(t *testing.T) {
+	for _, restricted := range []bool{true, false} {
+		for _, success := range []bool{true, false} {
+			name := "unsupported"
+			if restricted {
+				name = "restricted"
+			}
+			if success {
+				name += "_then_valid"
+			} else {
+				name += "_all_unplayable"
+			}
+			t.Run(name, func(t *testing.T) {
+				ctx := context.Background()
+				log := &librespot.NullLogger{}
+				events, _ := (evtimpl.Impl{}).NewEventManager(log, nil, nil, nil, "")
+				first, second := "spotify:track:0000000000000000000003", "spotify:track:0000000000000000000004"
+				media := func(uri string) *metadatapb.Track {
+					id, _ := librespot.SpotifyIdFromUri(uri)
+					return &metadatapb.Track{Gid: id.Id(), Name: proto.String("fixture-track"), Duration: proto.Int32(300000), Number: proto.Int32(1), DiscNumber: proto.Int32(1), Album: &metadatapb.Album{Name: proto.String("fixture-album"), Date: &metadatapb.Date{}}}
+				}
+				inactive, metadata := 0, 0
+				sp := pc13Spclient(t, pc13RoundTrip(func(r *http.Request) (*http.Response, error) {
+					if strings.HasSuffix(r.URL.Path, "/inactive") {
+						inactive++
+						return &http.Response{StatusCode: 204, Body: http.NoBody, Header: make(http.Header), Request: r}, nil
+					}
+					if r.Method == http.MethodPut {
+						return &http.Response{StatusCode: 200, Body: http.NoBody, Header: make(http.Header), Request: r}, nil
+					}
+					metadata++
+					b, _ := io.ReadAll(r.Body)
+					var query extmetadatapb.BatchedEntityRequest
+					if err := proto.Unmarshal(b, &query); err != nil {
+						t.Fatal(err)
+					}
+					entity := query.EntityRequest[0]
+					kind := entity.Query[0].ExtensionKind
+					var body proto.Message
+					if kind == extmetadatapb.ExtensionKind_TRACK_V4 {
+						track := media(entity.EntityUri)
+						if restricted {
+							track.Restriction = []*metadatapb.Restriction{{CountryRestriction: &metadatapb.Restriction_CountriesAllowed{CountriesAllowed: ""}}}
+						}
+						body = track
+					} else {
+						body = &audiofilespb.AudioFilesExtensionResponse{}
+					}
+					data, _ := anypb.New(body)
+					raw, _ := proto.Marshal(&extmetadatapb.BatchedExtensionResponse{ExtendedMetadata: []*extmetadatapb.EntityExtensionDataArray{{ExtensionKind: kind, ExtensionData: []*extmetadatapb.EntityExtensionData{{EntityUri: entity.EntityUri, Header: &extmetadatapb.EntityExtensionDataHeader{StatusCode: 200}, ExtensionData: data}}}}})
+					return &http.Response{StatusCode: 200, Body: io.NopCloser(bytes.NewReader(raw)), Header: make(http.Header), Request: r}, nil
+				}))
+				path := filepath.Join(t.TempDir(), "pcm.fifo")
+				if err := syscall.Mkfifo(path, 0600); err != nil {
+					t.Fatal(err)
+				}
+				reader, err := os.OpenFile(path, os.O_RDONLY|syscall.O_NONBLOCK, 0)
+				if err != nil {
+					t.Fatal(err)
+				}
+				defer reader.Close()
+				country := "DK"
+				worker, err := player.NewPlayer(&player.Options{Log: log, Spclient: sp, Events: events, CountryCode: &country, AudioBackend: "pipe", AudioOutputPipe: path, AudioOutputPipeFormat: "s16le"})
+				if err != nil {
+					t.Fatal(err)
+				}
+				defer worker.Close()
+				p := pc13ExistingPlayer(t, true)
+				p.player = worker
+				p.app.cfg.ZeroconfEnabled = true
+				p.app.cfg.DisableAutoplay = true
+				p.logout = make(chan *AppPlayer, 1)
+				p.sess = &session.Session{}
+				nextSessionField(p.sess, "sp", sp)
+				nextSessionField(p.sess, "events", events)
+				p.spotConnId = "fixture-owner"
+				p.hasInitialConnectState = true
+				p.prodInfo = &ProductInfo{}
+				p.prefetchTimer = time.NewTimer(time.Hour)
+				defer p.prefetchTimer.Stop()
+				list, err := tracks.NewTrackListFromContext(ctx, log, nil, &connectpb.Context{Uri: pc13ContextURI, Pages: []*connectpb.ContextPage{{Tracks: []*connectpb.ContextTrack{{Uri: first}, {Uri: second}}}}})
+				if err != nil {
+					t.Fatal(err)
+				}
+				if err := list.TrySeek(ctx, func(*connectpb.ContextTrack) bool { return true }); err != nil {
+					t.Fatal(err)
+				}
+				p.state.tracks = list
+				p.state.player.Track = list.CurrentTrack()
+				p.state.player.Options = &connectpb.ContextPlayerOptions{RepeatingTrack: true}
+				p.state.player.IsPaused = false
+				if success {
+					p.secondaryStream = &player.Stream{Source: &contentInertSource{}, Media: librespot.NewMediaFromTrack(media(second))}
+				}
+				hasNext, err := p.advanceNext(ctx, false, true)
+				if success {
+					if err != nil || !hasNext || p.aliasRetired || p.roomVolumeClosing || p.state.tracks != list || p.primaryStream == nil || p.state.player.Track.Uri != second || !p.state.player.IsPlaying || p.state.player.IsBuffering || inactive != 0 || len(p.logout) != 0 {
+						t.Fatal("recoverable skip destroyed context or failed valid successor", hasNext, err)
+					}
+				} else {
+					if err == nil || hasNext || !p.aliasRetired || !p.roomVolumeClosing || p.state.player.IsPlaying || p.state.player.IsBuffering || p.primaryStream != nil || inactive != 1 || len(p.logout) != 1 {
+						t.Fatal("exhausted fallback did not terminalize once", hasNext, err, inactive)
+					}
+				}
+				expected := 1
+				if !restricted {
+					expected = 2
+				}
+				if !success {
+					expected *= 2
+				}
+				if metadata != expected {
+					t.Fatal("unexpected typed metadata attempts", metadata, expected)
+				}
+			})
+		}
+	}
