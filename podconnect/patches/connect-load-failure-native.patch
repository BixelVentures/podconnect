+// Extends the existing no-output/dealer fixture; inert provider HTTP responses,
+// actual daemon loadCurrentTrack/NewStream and actual Player output admission.
+func TestPC58FailedLoadRetiresActorAndFreezesState(t *testing.T) {
+	for _, mode := range []string{"newstream_initial", "newstream_retained_output", "output_admission_initial"} {
+		t.Run(mode, func(t *testing.T) {
+			ctx := context.Background()
+			log := &librespot.NullLogger{}
+			events, _ := (evtimpl.Impl{}).NewEventManager(log, nil, nil, nil, "")
+			var publications []*connectpb.PutStateRequest
+			metadataRequests, creates, inactive := 0, 0, 0
+			var failedPrepared *contentInertSource
+			sp := pc13Spclient(t, pc13RoundTrip(func(r *http.Request) (*http.Response, error) {
+				if strings.HasSuffix(r.URL.Path, "/inactive") {
+					inactive++
+					return &http.Response{StatusCode: 204, Body: http.NoBody, Header: make(http.Header), Request: r}, nil
+				}
+				if r.Method == http.MethodPut {
+					var v connectpb.PutStateRequest
+					b, _ := io.ReadAll(r.Body)
+					if err := proto.Unmarshal(b, &v); err == nil {
+						publications = append(publications, &v)
+					}
+					return &http.Response{StatusCode: 200, Body: http.NoBody, Header: make(http.Header), Request: r}, nil
+				}
+				metadataRequests++
+				return &http.Response{StatusCode: 404, Body: io.NopCloser(strings.NewReader("not found")), Header: make(http.Header), Request: r}, nil
+			}))
+			path := filepath.Join(t.TempDir(), "pcm.fifo")
+			if err := syscall.Mkfifo(path, 0600); err != nil {
+				t.Fatal(err)
+			}
+			reader, err := os.OpenFile(path, os.O_RDONLY|syscall.O_NONBLOCK, 0)
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer reader.Close()
+			worker, err := player.NewPlayer(&player.Options{Log: log, Spclient: sp, Events: events, AudioBackend: "pipe", AudioOutputPipe: path, AudioOutputPipeFormat: "s16le", WithNewOutput: func(create func() (output.Output, error)) (output.Output, error) {
+				creates++
+				if mode == "output_admission_initial" {
+					return nil, ErrAliasConflict
+				}
+				return create()
+			}})
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer worker.Close()
+			p := pc13ExistingPlayer(t, false)
+			p.player = worker
+			p.state.reset()
+			p.state.device.SelectedAliasId = 1
+			p.app.cfg.DeviceName = "local fixture"
+			p.app.cfg.ZeroconfEnabled = true
+			p.logout = make(chan *AppPlayer, 1)
+			p.sess = &session.Session{}
+			nextSessionField(p.sess, "sp", sp)
+			nextSessionField(p.sess, "events", events)
+			p.spotConnId = "fixture-owner"
+			p.hasInitialConnectState = true
+			p.prefetchTimer = time.NewTimer(time.Hour)
+			defer p.prefetchTimer.Stop()
+			if mode == "newstream_retained_output" {
+				old := &contentInertSource{}
+				if err := worker.SetPrimaryStream(old, true, false); err != nil {
+					t.Fatal(err)
+				}
+				p.primaryStream = &player.Stream{Source: old, Media: librespot.NewMediaFromTrack(&metadatapb.Track{Duration: proto.Int32(300000)})}
+			}
+			track := "spotify:track:0000000000000000000003"
+			req := pc13PlayRequest(t)
+			req.Command.Options.InitiallyPaused = false
+			req.Command.Context = &connectpb.Context{Uri: pc13ContextURI, Pages: []*connectpb.ContextPage{{Tracks: []*connectpb.ContextTrack{{Uri: track}}}}}
+			if mode == "output_admission_initial" {
+				id, _ := librespot.SpotifyIdFromUri(track)
+				failedPrepared = &contentInertSource{}
+				p.secondaryStream = &player.Stream{Source: failedPrepared, Media: librespot.NewMediaFromTrack(&metadatapb.Track{Gid: id.Id(), Name: proto.String("fixture-track"), Duration: proto.Int32(300000), Number: proto.Int32(1), DiscNumber: proto.Int32(1), Album: &metadatapb.Album{Name: proto.String("fixture-album"), Date: &metadatapb.Date{}}})}
+			}
+			err = p.handlePlayerCommandWithSpclient(ctx, req, sp)
+			if err == nil {
+				t.Fatal("fixture failed to reach intended load failure")
+			}
+
+			loadFailure := err.Error()
+			if p.state.player.IsPlaying || p.state.player.IsBuffering || p.state.active || p.primaryStream != nil || !p.aliasRetired || !p.roomVolumeClosing {
+				t.Fatal("failed committed load retained playing state or actor authority", p.state.player)
+			}
+			if len(publications) != 1 || !publications[0].Device.PlayerState.IsPlaying || !publications[0].Device.PlayerState.IsBuffering {
+				t.Fatal("expected existing pre-effect buffering publication", len(publications))
+			}
+			p.state.player.Timestamp = time.Now().Add(-2 * time.Second).UnixMilli()
+			position := p.state.trackPosition()
+			if position != 0 {
+				t.Fatal("failed position advanced", position)
+			}
+			var next dealer.RequestPayload
+			next.Command.Endpoint = "resume"
+			nextErr := p.handlePlayerCommandWithSpclient(ctx, next, sp)
+			if !errors.Is(nextErr, ErrAliasConflict) {
+				t.Fatal("failed actor admitted later resume", nextErr)
+			}
+			if inactive != 1 {
+				t.Fatal("inactive publication not attempted exactly once", inactive)
+			}
+			if failedPrepared != nil && failedPrepared.closes.Load() != 1 {
+				t.Fatal("unadopted prepared decoder not closed once", failedPrepared.closes.Load())
+			}
+			if len(p.logout) != 1 || <-p.logout != p {
+				t.Fatal("normal logout not requested exactly once")
+			}
+			if err := worker.Pause(); err == nil {
+				t.Fatal("failed actor retained an output")
+			}
+			p.handlePlayerEvent(ctx, &player.Event{Type: player.EventTypePlay})
+			p.handlePlayerEvent(ctx, &player.Event{Type: player.EventTypePause})
+			if p.state.player.IsPlaying || p.state.player.IsPaused || len(publications) != 1 {
+				t.Fatal("queued old event revived failed actor")
+			}
+			if mode == "newstream_retained_output" && creates != 1 {
+				t.Fatal("old worker output retried")
+			}
+
+			// A different authenticated actor can use the normal output owner only
+			// after the failed writer has been stopped. No retry belongs to old p.
+			fresh := pc13ExistingPlayer(t, false)
+			fresh.state.reset()
+			fresh.app = p.app
+			fresh.prodInfo = &ProductInfo{}
+			fresh.sess = p.sess
+			fresh.spotConnId = "fresh-owner"
+			fresh.hasInitialConnectState = true
+			fresh.prefetchTimer = time.NewTimer(time.Hour)
+			defer fresh.prefetchTimer.Stop()
+			nextWorker, err := player.NewPlayer(&player.Options{Log: log, Spclient: sp, Events: events, AudioBackend: "pipe", AudioOutputPipe: path, AudioOutputPipeFormat: "s16le", WithNewOutput: func(create func() (output.Output, error)) (output.Output, error) {
+				return fresh.app.withNewOutput(fresh, create)
+			}})
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer nextWorker.Close()
+			fresh.player = nextWorker
+			id, _ := librespot.SpotifyIdFromUri(track)
+			fresh.secondaryStream = &player.Stream{Source: &contentInertSource{}, Media: librespot.NewMediaFromTrack(&metadatapb.Track{Gid: id.Id(), Name: proto.String("fixture-track"), Duration: proto.Int32(300000), Number: proto.Int32(1), DiscNumber: proto.Int32(1), Album: &metadatapb.Album{Name: proto.String("fixture-album"), Date: &metadatapb.Date{}}})}
+			req.Command.Options.InitiallyPaused = true
+			if err := fresh.handlePlayerCommandWithSpclient(ctx, req, sp); err != nil {
+				t.Fatal("next fresh explicit command rejected", err)
+			}
+			if fresh.primaryStream == nil || !fresh.state.player.IsPlaying || fresh.state.player.IsBuffering || !fresh.state.player.IsPaused || fresh.app.openedWriterOwner != fresh {
+				t.Fatal("fresh command did not own its real paused FIFO output")
+			}
+			beforeFresh := fresh.primaryStream
+			p.handlePlayerEvent(ctx, &player.Event{Type: player.EventTypePlay})
+			if fresh.primaryStream != beforeFresh || fresh.aliasRetired || fresh.roomVolumeClosing || fresh.app.openedWriterOwner != fresh {
+				t.Fatal("late failed actor event affected fresh owner")
+			}
+			t.Logf("failure=%s; next old resume=%v; stopped=true position=%d; metadata requests=%d output creates=%d; fresh output accepted", loadFailure, nextErr, position, metadataRequests, creates)
+		})
+	}
+}
