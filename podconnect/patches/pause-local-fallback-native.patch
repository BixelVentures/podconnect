+
+// Green 13 Nov 16:08: after a selection start the bound route could not be
+// bound and every pause answered 409 while the music played. The pause must
+// still stop the engine: the next command always goes through.
+func TestPauseStopsTheEngineWhenTheBoundRouteIsUnavailable(t *testing.T) {
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) { w.WriteHeader(http.StatusConflict) }))
+	defer srv.Close()
+	app, owner, _ := retirementOwnerFixture(t, srv.URL, "start")
+	app.cfg = &Config{AudioBackend: "pipe", ExternalVolume: true, RoomTransportOwnToneURL: srv.URL}
+	app.log = &librespot.NullLogger{}
+	owner.state = pc13ExistingPlayer(t, true).state
+	owner.sess = &session.Session{}
+	owner.prefetchTimer = time.NewTimer(time.Hour)
+	defer owner.prefetchTimer.Stop()
+	writer := app.openedWriter
+	current, err := owner.player.Start35CurrentSource(context.Background())
+	if err != nil {
+		t.Fatal(err)
+	}
+	held := &retirementHeldRead{entered: make(chan struct{}), release: make(chan struct{})}
+	defer held.CancelRead()
+	owner.primaryStream = &player.Stream{Source: held}
+	guard := func(m func()) error { m(); return nil }
+	if _, _, err = owner.player.Start35(context.Background(), "publish", held, current, writer.PipeIdentity, "1", guard); err != nil {
+		t.Fatal(err)
+	}
+	if _, _, err = owner.player.Start35(context.Background(), "resume", nil, held, writer.PipeIdentity, "1", guard); err != nil {
+		t.Fatal(err)
+	}
+	select {
+	case <-held.entered:
+	case <-time.After(time.Second):
+		t.Fatal("no held read")
+	}
+	if handled, err := owner.pauseBoundRoom(context.Background()); !handled || err == nil {
+		t.Fatalf("fixture: bound route unexpectedly available: handled=%t err=%v", handled, err)
+	}
+	done := make(chan error, 1)
+	go func() { done <- owner.pause(context.Background()) }()
+	select {
+	case err = <-done:
+		if err != nil {
+			t.Fatalf("pause refused while the bound route was unavailable: %v", err)
+		}
+	case <-time.After(2 * time.Second):
+		held.CancelRead()
+		t.Fatal("pause blocked")
+	}
+	if !owner.state.player.IsPaused {
+		t.Fatal("engine not paused")
+	}
+	held.CancelRead()
+	owner.player.Close()
+}
