+package output
+
+import (
+	"context"
+	"fmt"
+	"os"
+	"strconv"
+	"syscall"
+)
+
+type PipeIdentity struct {
+	Device string `json:"device"`
+	Inode  string `json:"inode"`
+	Type   string `json:"type"`
+}
+type StartPipeOutput interface {
+	GuardedPipeOutput
+	FenceStart()
+	WithStartLock(context.Context, func(PipeIdentity, func(bool)) error) error
+}
+
+func (out *pipeOutput) FenceStart() { out.startFenced.Store(true) }
+func (out *pipeOutput) WithStartLock(ctx context.Context, apply func(PipeIdentity, func(bool)) error) error {
+	if err := LockTransport(ctx, &out.lock); err != nil {
+		return err
+	}
+	defer out.lock.Unlock()
+	if out.closed {
+		return fmt.Errorf("start pipe closed")
+	}
+	info, err := out.file.Stat()
+	if err != nil {
+		return err
+	}
+	stat, ok := info.Sys().(*syscall.Stat_t)
+	if !ok || info.Mode()&os.ModeNamedPipe == 0 {
+		return fmt.Errorf("actual descriptor is not FIFO")
+	}
+	identity := PipeIdentity{strconv.FormatUint(uint64(stat.Dev), 10), strconv.FormatUint(uint64(stat.Ino), 10), "fifo"}
+	return apply(identity, func(paused bool) { out.paused = paused; out.startFenced.Store(paused); out.cond.Broadcast() })
+}
