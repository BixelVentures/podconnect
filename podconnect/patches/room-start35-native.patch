+		return false
+	}
+	if !op.Published {
+		return p.contentCurrentLocked(op.Capture)
+	}
+	c := op.Capture
+	return c.processCurrent() && p.state == c.State && p.state.player == op.Prepared && p.primaryStream == op.Stream && p.sess == c.Session && p.player == c.Player && p.spotConnId == c.Connection && p.roomNativeIntent == c.Intent && p.aliasIncarnation == op.Intended.AliasIncarnation && p.roomContentIncarnation == c.Incarnation && p.app.deviceId == c.Scope.TargetID && p.app.cfg.AudioBackend == "pipe" && p.app.cfg.ExternalVolume && p.app.cfg.Bitrate == c.Bitrate && contentAccountMatches(p.sess, c.Scope.AccountUserID) && p.aliasFingerprint == c.Registry && p.aliasRevision == op.Intended.AliasRevision && p.state.device.SelectedAliasId == c.TargetAlias && p.state.player.SessionId == op.Intended.SessionID && p.app.cfg.AudioOutputPipe == c.Pipe && p.app.cfg.AudioOutputPipeFormat == c.Format && p.app.cfg.RoomTransportOwnToneURL == c.OwnTone && p.transportMappingCurrentLocked()
+}
+func (p *AppPlayer) applyContentStep(step contentStep) error {
+	op := step.Operation
+	p.aliasMu.Lock()
+	op.mu.Lock()
+	valid := p.contentEffectCurrentLocked(op, step.Context) && contentAccountMatches(p.sess, op.Capture.Scope.AccountUserID)
+	if step.Phase == "quiesce" {
+		valid = valid && op.CReceipt != nil && op.CReceipt.Phase == "gate_closed_reader_ready" && op.CReceipt.GateClosed
+	}
+	op.mu.Unlock()
+	p.aliasMu.Unlock()
+	if !valid {
+		return ErrAliasConflict
+	}
+	op.mu.Lock()
+	expected := op.Capture.Source
+	if op.Published {
+		expected = op.Stream.Source
+	}
+	pipe, epoch := op.Pipe, op.Epoch
+	op.mu.Unlock()
+	if step.Phase == "quiesce" {
+		if cancel, ok := expected.(interface{ CancelRead() }); ok {
+			cancel.CancelRead()
+		}
+	}
+	var newSource librespot.AudioSource
+	if step.Phase == "publish" {
+		newSource = op.Stream.Source
+	}
+	ctx, cancel := context.WithDeadline(step.Context, op.Until)
+	defer cancel()
+	actualPipe, actualEpoch, err := p.player.Start35(ctx, step.Phase, newSource, expected, pipe, epoch, func(mutate func()) error {
+		p.aliasMu.Lock()
+		defer p.aliasMu.Unlock()
+		op.mu.Lock()
+		defer op.mu.Unlock()
+		if !p.contentEffectCurrentLocked(op, ctx) || !contentAccountMatches(p.sess, op.Capture.Scope.AccountUserID) {
+			return ErrAliasConflict
+		}
+		if step.Phase == "publish" && (!op.Quiescent || op.CReceipt == nil || op.CReceipt.Phase != "route_ready_closed") {
+			return ErrAliasConflict
+		}
+		if step.Phase == "resume" && (!op.Published || op.CReceipt == nil || op.CReceipt.Phase != "opened") {
+			return ErrAliasConflict
+		}
+		mutate()
+		if step.Phase == "publish" {
+			p.primaryStream = op.Stream
+			p.secondaryStream = nil
+			p.state.tracks = op.Tracks
+			p.state.player = op.Prepared
+			p.state.active = true
+			p.state.device.Volume = uint32(player.MaxStateVolume * 35 / 100)
+			if p.prefetchTimer != nil {
+				p.prefetchTimer.Stop()
+			}
+			p.state.device.SelectedAliasId = op.Capture.TargetAlias
+			p.aliasRevision = op.Intended.AliasRevision
+			op.Published = true
+			actualRoom, actualHomepod := "", ""
+			for _, alias := range p.aliasRegistry {
+				if alias.ID == p.state.device.SelectedAliasId {
+					actualRoom, actualHomepod = alias.RoomID, alias.HomePodID
+					break
+				}
+			}
+			actualAccount, _ := p.sess.BoundUsername()
+			actual := roomTransportIdentity{actualAccount, p.app.deviceId, actualRoom, actualHomepod, p.spotConnId, p.state.player.SessionId, p.aliasIncarnation, p.aliasFingerprint, p.aliasRevision}
+			op.Actual = &actual
+		}
+		if step.Phase == "resume" {
+			p.state.setPaused(false)
+			p.state.player.IsBuffering = false
+			p.state.player.Timestamp = time.Now().UnixMilli()
+			p.state.player.PositionAsOfTimestamp = 0
+			p.state.player.PlaybackId = hex.EncodeToString(op.Stream.PlaybackId)
+		}
+		return nil
+	})
+	if err != nil {
+		return err
+	}
+	op.mu.Lock()
+	op.Pipe = actualPipe
+	op.Epoch = actualEpoch
+	if step.Phase == "quiesce" {
+		op.Quiescent = true
+	}
+	op.mu.Unlock()
+	return nil
+}
+func (op *contentOperation) actorStep(ctx context.Context, phase string) error {
+	reply := make(chan error, 1)
+	step := contentStep{op, phase, ctx, reply}
+	select {
+	case op.Owner.roomContentSteps <- step:
+	case <-ctx.Done():
+		return ctx.Err()
+	}
+	// Join a submitted player/pipe mutator even if HTTP cancellation races it.
+	return <-reply
+}
+func (p *AppPlayer) waitContentReservation(ctx context.Context) bool {
+	p.aliasMu.Lock()
+	reservation := p.roomContentReservation
+	p.aliasMu.Unlock()
+	if reservation == nil {
+		return ctx.Err() == nil
+	}
+	op := reservation.Operation
+	timer := time.NewTimer(max(0, time.Until(reservation.Until)))
+	defer timer.Stop()
+	stopRequested := false
+	for {
+		select {
+		case step := <-p.roomContentSteps:
+			if step.Operation != op {
+				step.Reply <- ErrAliasConflict
+				continue
+			}
+			step.Reply <- p.applyContentStep(step)
+		case <-op.TerminalSignal:
+			op.mu.Lock()
+			completed := op.State == "complete"
+			op.mu.Unlock()
+			if completed && p.primaryStream == op.Stream && p.state.player == op.Prepared && p.roomNativeIntent == op.Capture.Intent && op.Loader != nil {
+				op.Loader.PublishEvents()
+				p.sess.Events().PostPrimaryStreamLoad(op.Stream, false)
+				p.emitSelectedAlias(op.Capture.TargetAlias, p.aliasBinding())
+				observed, stop := context.WithTimeout(context.Background(), time.Second)
+				p.handlePlayerEvent(observed, &player.Event{Type: player.EventTypePlay})
+				stop()
+			}
+			p.aliasMu.Lock()
+			if p.roomContentReservation == reservation {
+				p.roomContentReservation = nil
+			}
+			closing := p.roomVolumeClosing
+			p.aliasMu.Unlock()
+			return !closing && !stopRequested && ctx.Err() == nil
+		case <-ctx.Done():
+			stopRequested = true
+			op.cancelContent()
+			go p.Close()
+			ctx = context.Background()
+		case <-timer.C:
+			op.mu.Lock()
+			quiescent := op.Quiescent
+			failedStart := op.Possible && op.State != "complete"
+			op.mu.Unlock()
+			op.cancelContent()
+			if failedStart {
+				op.finish("unknown")
+			} else {
+				op.finish("cancelled")
+			}
+			p.aliasMu.Lock()
+			if !quiescent || failedStart {
+				p.roomContentQuarantined = true
+			}
+			if p.roomContentReservation == reservation {
+				p.roomContentReservation = nil
+			}
+			closing := p.roomVolumeClosing
+			p.aliasMu.Unlock()
+			return !closing && !stopRequested && ctx.Err() == nil
+		}
+	}
+}
+func (p *AppPlayer) retireContentOwner() {
+	p.aliasMu.Lock()
+	reservation := p.roomContentReservation
+	p.aliasMu.Unlock()
+	if reservation == nil {
+		return
+	}
+	reservation.Operation.cancelContent()
+	timer := time.NewTimer(max(0, time.Until(reservation.Until)))
+	defer timer.Stop()
+	select {
+	case <-timer.C:
+	case <-reservation.Operation.TerminalSignal:
+	}
+}
+
+func contentAccountMatches(s *session.Session, want string) bool {
+	actual, ok := s.BoundUsername()
+	return ok && actual == want
+}
