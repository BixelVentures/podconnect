+
+func (store *contentStore) put(op *contentOperation) bool {
+	store.mu.Lock()
+	if store.Records == nil {
+		store.Records = map[string]*contentOperation{}
+	}
+	var abandoned []*contentOperation
+	for id, old := range store.Records {
+		old.mu.Lock()
+		expired := (!old.Claimed && time.Now().After(old.Expires)) || (old.Terminal && old.State != "unknown" && time.Now().After(old.RetainUntil))
+		old.mu.Unlock()
+		if expired {
+			delete(store.Records, id)
+			abandoned = append(abandoned, old)
+		}
+	}
+	accepted := len(store.Records) < 128
+	if accepted {
+		store.Records[op.Offer.OfferID] = op
+	}
+	store.mu.Unlock()
+	for _, old := range abandoned {
+		old.discard()
+	}
+	return accepted
+}
+func (store *contentStore) get(id, binding string) *contentOperation {
+	store.mu.Lock()
+	defer store.mu.Unlock()
+	op := store.Records[id]
+	if op == nil || op.Offer.BindingID != binding {
+		return nil
+	}
+	return op
+}
+func contentDigest(v any) string {
+	raw, _ := json.Marshal(v)
+	sum := sha256.Sum256(raw)
+	return hex.EncodeToString(sum[:])
+}
+func (op *contentOperation) receipt(endpoint string) contentReceipt {
+	op.mu.Lock()
+	defer op.mu.Unlock()
+	complete := op.State == "complete"
+	return contentReceipt{"podconnect.native_room_content_" + endpoint + ".v1", complete, op.Offer.OfferID, op.Offer.BindingID, op.State, complete, op.Offer.OfferID, 35, op.Capture.Scope.RoomID, op.Capture.Scope.HomePodID, false}
+}
+func (op *contentOperation) finish(state string) {
+	op.mu.Lock()
+	defer op.mu.Unlock()
+	if op.Terminal {
+		return
+	}
+	op.State = state
+	op.Terminal = true
+	op.RetainUntil = time.Now().Add(time.Minute)
+	if (state == "complete" || state == "rejected" || state == "cancelled") && op.TerminalSignal != nil {
+		close(op.TerminalSignal)
+	}
+}
+func (op *contentOperation) discard() {
+	op.mu.Lock()
+	stream := op.Stream
+	adopted := op.Published
+	if !adopted {
+		op.Stream = nil
+	}
+	op.mu.Unlock()
+	if stream != nil && !adopted {
+		if closer, ok := stream.Source.(io.Closer); ok {
+			_ = closer.Close()
+		}
+	}
+}
+func (p *AppPlayer) contentBusyLocked() bool {
+	// Only the actor park retires the reservation and installs quarantine atomically.
+	// An elapsed deadline alone cannot open a scheduling gap for another owner.
+	return p.roomContentQuarantined || p.roomContentReservation != nil
+}
