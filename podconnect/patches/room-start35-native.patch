+				}
+				if mode == "wrong-content" && endpoint == "prepare" {
+					reply.ContentDigest = strings.Repeat("f", 64)
+				}
+				if (mode == "open-fails" && endpoint == "open") || (mode == "complete-fails" && endpoint == "complete") {
+					reply.Phase = "unknown"
+					reply.GateClosed = true
+					reply.Actual = nil
+				}
+				_ = json.NewEncoder(w).Encode(reply)
+			}))
+			defer owner.Close()
+			op.Capture.OwnTone = owner.URL
+			p.app.cfg.RoomTransportOwnToneURL = owner.URL
+			server := &ConcreteApiServer{requests: make(chan ApiRequest)}
+			done := make(chan struct{})
+			go func() {
+				defer close(done)
+				for request := range server.requests {
+					value, err := p.handleApiRequest(context.Background(), request)
+					request.Reply(value, err)
+				}
+			}()
+			stopped := make(chan struct{})
+			go func() {
+				defer close(stopped)
+				for {
+					select {
+					case step := <-p.roomContentSteps:
+						op.mu.Lock()
+						nativeSteps = append(nativeSteps, step.Phase)
+						switch step.Phase {
+						case "quiesce":
+							if op.Pipe.Inode != "2" {
+								op.mu.Unlock()
+								step.Reply <- ErrAliasConflict
+								continue
+							}
