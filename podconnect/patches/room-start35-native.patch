+package ap
+
+// BoundUsername is a read of the actual authenticated welcome, not an idle
+// playback-session surrogate. Disconnect/uninitialized state fails closed.
+func (ap *Accesspoint) BoundUsername() (string, bool) {
+	if ap == nil {
+		return "", false
+	}
+	if !ap.connMu.TryRLock() {
+		return "", false
+	}
+	defer ap.connMu.RUnlock()
+	select {
+	case <-ap.done:
+		return "", false
+	default:
+	}
+	if ap.conn == nil || ap.encConn == nil {
+		return "", false
+	}
+	if ap.welcome == nil || ap.welcome.CanonicalUsername == nil || *ap.welcome.CanonicalUsername == "" {
+		return "", false
+	}
+	return *ap.welcome.CanonicalUsername, true
+}
