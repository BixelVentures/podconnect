+package ap
+
+import (
+	pb "github.com/devgianlu/go-librespot/proto/spotify"
+	"testing"
+)
+
+// Local pointer/closed-state regression, not a provider authentication proof.
+func TestStart35BoundUsernameRequiresLiveAuthenticatedOwner(t *testing.T) {
+	var absent *Accesspoint
+	if _, ok := absent.BoundUsername(); ok {
+		t.Fatal("nil admitted")
+	}
+	name := "local-fixture"
+	owner := &Accesspoint{done: make(chan struct{}), welcome: &pb.APWelcome{CanonicalUsername: &name}}
+	if _, ok := owner.BoundUsername(); ok {
+		t.Fatal("retained welcome without connection admitted")
+	}
+	owner.conn = newBlockingConn()
+	owner.encConn = &shannonConn{}
+	if got, ok := owner.BoundUsername(); !ok || got != name {
+		t.Fatal("local live owner lookup failed", got, ok)
+	}
+	owner.connMu.Lock()
+	if _, ok := owner.BoundUsername(); ok {
+		t.Fatal("busy authentication admitted")
+	}
+	owner.connMu.Unlock()
+	close(owner.done)
+	if _, ok := owner.BoundUsername(); ok {
+		t.Fatal("closed owner retained authentication")
+	}
+}
