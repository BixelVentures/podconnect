+		go func() {
+			ctx, stop := context.WithTimeout(context.Background(), time.Second)
+			defer stop()
+			_, _ = op.cCall(ctx, "POST", "cancel", struct {
+				Token       string `json:"token"`
+				Reservation string `json:"native_reservation_id"`
+			}{token, reservation})
+		}()
+	}
+}
+func (op *contentOperation) cPoll(ctx context.Context, reply contentCReceipt, want string) (contentCReceipt, error) {
+	for reply.Phase != want {
+		if reply.Phase == "unknown" || reply.Phase == "rejected_before_admission" || reply.Phase == "expired_before_admission" || reply.Phase == "cancelled_before_admission" {
+			return reply, ErrAliasConflict
+		}
+		timer := time.NewTimer(50 * time.Millisecond)
+		select {
+		case <-timer.C:
+		case <-ctx.Done():
+			timer.Stop()
+			return reply, ctx.Err()
+		}
+		var err error
+		reply, err = op.cCall(ctx, "GET", "result/"+reply.Token, nil)
+		if err != nil {
+			return reply, err
+		}
+	}
+	return reply, nil
+}
+func (op *contentOperation) commit(ctx context.Context, server *ConcreteApiServer) {
+	op.mu.Lock()
+	if op.Claimed && !op.CommitClaimed && !op.Terminal && op.State == "staged" && !time.Now().Before(op.StagedUntil) {
+		op.mu.Unlock()
+		op.discard()
+		op.finish("rejected")
+		return
+	}
+	if op.CommitClaimed || !op.Claimed || op.State != "staged" || op.Cancelled || op.Terminal || !time.Now().Before(op.StagedUntil) {
+		op.mu.Unlock()
+		return
+	}
+	op.CommitClaimed = true
+	op.State = "committing"
+	ctx, cancel := context.WithTimeout(ctx, 14*time.Second)
+	op.Cancel = cancel
+	op.mu.Unlock()
+	defer cancel()
+	defer op.discard()
+	failed := func() {
+		op.mu.Lock()
+		reply := op.CReceipt
+		possible := op.Possible
+		cancelled := op.Cancelled || ctx.Err() != nil
+		op.mu.Unlock()
+		state := "unknown"
+		if !possible || (reply != nil && !reply.Possible && reply.Drained && (reply.Phase == "rejected_before_admission" || reply.Phase == "cancelled_before_admission" || reply.Phase == "expired_before_admission")) {
+			state = "rejected"
+			if cancelled {
+				state = "cancelled"
+			}
+		}
+		if possible {
+			op.cancelContent()
+		}
+		op.finish(state)
+	}
+	if ctx.Err() != nil {
+		failed()
+		return
+	}
+	prepared, err := op.cCall(ctx, "POST", "prepare", op.cPrepareBody())
+	if err != nil || prepared.Phase != "prepared" {
+		failed()
+		return
+	}
+	if _, err = server.roomTransportAsk(ctx, apiContentConsume, contentActorRequest{Operation: op, Context: ctx}); err != nil {
+		op.cancelContent()
+		failed()
+		return
+	}
+	critical, stopCritical := context.WithDeadline(ctx, op.Until)
+	defer stopCritical()
+	op.mu.Lock()
+	op.Possible = true
+	op.mu.Unlock()
+	reply, err := op.cCall(critical, "POST", "commit", struct {
+		Token       string                 `json:"token"`
+		Offer       string                 `json:"offer_id"`
+		Binding     string                 `json:"binding_id"`
+		Digest      string                 `json:"content_digest"`
+		Incarnation string                 `json:"native_incarnation"`
+		Revision    string                 `json:"native_revision"`
+		Reservation string                 `json:"native_reservation_id"`
+		Old         *roomTransportIdentity `json:"old_native_owner"`
+		Drained     bool                   `json:"pending_native_mutators_drained"`
+	}{prepared.Token, op.Offer.OfferID, op.Offer.BindingID, op.ContentDigest, op.Capture.Incarnation, op.Revision, op.ReservationID, op.Capture.OldOwner, true})
+	if err == nil {
+		reply, err = op.cPoll(critical, reply, "gate_closed_reader_ready")
+	}
+	if err != nil || reply.Pipe == nil {
+		failed()
+		return
+	}
+	op.mu.Lock()
+	op.Pipe = outputPipe(reply.Pipe)
+	op.mu.Unlock()
+	if err = op.actorStep(critical, "quiesce"); err != nil {
+		failed()
+		return
+	}
+	op.mu.Lock()
+	pipe, epoch := op.Pipe, op.Epoch
+	op.mu.Unlock()
+	reply, err = op.cCall(critical, "POST", "barrier", struct {
+		Token       string `json:"token"`
+		Reservation string `json:"native_reservation_id"`
+		Epoch       string `json:"writer_source_epoch"`
+		Pipe        any    `json:"pipe_identity"`
+		Digest      string `json:"expected_input_path_digest"`
+		Quiescent   bool   `json:"writer_quiescent"`
+	}{prepared.Token, op.ReservationID, epoch, pipe, op.Capture.PipeDigest, true})
+	if err == nil {
+		reply, err = op.cPoll(critical, reply, "route_ready_closed")
+	}
+	if err != nil {
+		failed()
+		return
+	}
+	if err = op.actorStep(critical, "publish"); err != nil {
+		failed()
+		return
+	}
+	reply, err = op.cCall(critical, "POST", "open", struct {
+		Token       string                `json:"token"`
+		Reservation string                `json:"native_reservation_id"`
+		Epoch       string                `json:"writer_source_epoch"`
+		Actual      roomTransportIdentity `json:"committed_native_owner"`
+	}{prepared.Token, op.ReservationID, epoch, *op.Actual})
+	if err != nil || reply.Phase != "opened" {
+		failed()
+		return
+	}
+	if err = op.actorStep(critical, "resume"); err != nil {
+		failed()
+		return
+	}
+	// Only this bookkeeping ACK can release the actor and report completion.
+	// The C durable ownership journal remains present after this ACK.
+	reply, err = op.cCall(ctx, "POST", "complete", struct {
+		Token       string                `json:"token"`
+		Reservation string                `json:"native_reservation_id"`
+		Epoch       string                `json:"writer_source_epoch"`
+		Actual      roomTransportIdentity `json:"committed_native_owner"`
+		Drained     bool                  `json:"native_mutators_drained"`
+	}{prepared.Token, op.ReservationID, epoch, *op.Actual, true})
+	if err != nil || reply.Phase != "completed" {
+		failed()
+		return
+	}
+	op.mu.Lock()
+	cancelled := op.Cancelled || ctx.Err() != nil
+	op.mu.Unlock()
+	if cancelled {
+		failed()
+		return
+	}
+	op.finish("complete")
+}
+func outputPipe(identity *outputPipeIdentity) output.PipeIdentity {
+	if identity == nil {
+		return output.PipeIdentity{}
+	}
+	return output.PipeIdentity{Device: identity.Device, Inode: identity.Inode, Type: identity.Type}
+}
