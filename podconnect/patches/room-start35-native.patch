+								t.Error("resume before actualopen")
+							}
+						}
+						op.mu.Unlock()
+						step.Reply <- nil
+					case <-done:
+						return
+					}
+				}
+			}()
+			op.commit(context.Background(), server)
+			receipt := op.receipt("commit")
+			close(server.requests)
+			<-done
+			<-stopped
+			if (mode == "complete") != receipt.Accepted {
+				t.Fatal("wrong final completion", mode, receipt)
+			}
+			if mode == "complete" {
+				if strings.Join(nativeSteps, ",") != "quiesce,publish,resume" {
+					t.Fatal(nativeSteps)
+				}
+				op.commit(context.Background(), server)
+				op.cancelContent()
+				cMu.Lock()
+				if strings.Join(calls, ",") != "prepare,commit,barrier,open,complete" {
+					t.Fatal("complete replay/cancel mutated", calls)
+				}
+				cMu.Unlock()
+			} else if receipt.State != "unknown" && mode != "wrong-content" {
+				t.Fatal("postgateuncertainty relabelled", receipt)
+			}
+		})
