+type contentCReceipt struct {
+	Schema        string                 `json:"schema"`
+	OK            bool                   `json:"ok"`
+	Token         string                 `json:"token"`
+	OfferID       string                 `json:"offer_id"`
+	BindingID     string                 `json:"binding_id"`
+	ContentDigest string                 `json:"content_digest"`
+	Incarnation   string                 `json:"native_incarnation"`
+	Revision      string                 `json:"native_revision"`
+	ReservationID string                 `json:"native_reservation_id"`
+	Policy        string                 `json:"policy_revision"`
+	Percent       int                    `json:"start_volume_percent"`
+	Intended      roomTransportIdentity  `json:"intended_native_owner"`
+	Actual        *roomTransportIdentity `json:"actual_native_owner"`
+	Target        contentTarget          `json:"target_identity"`
+	Route         *roomVolumeRoute       `json:"route_identity"`
+	InputDigest   string                 `json:"input_path_digest"`
+	Pipe          *outputPipeIdentity    `json:"pipe_identity"`
+	InputEpoch    string                 `json:"input_epoch"`
+	WriterEpoch   string                 `json:"writer_source_epoch"`
+	Phase         string                 `json:"phase"`
+	Possible      bool                   `json:"possible_effect"`
+	Drained       bool                   `json:"contexts_drained"`
+	GateClosed    bool                   `json:"gate_closed"`
+	Retired       bool                   `json:"deadline_retired"`
+	PinRemaining  int                    `json:"pin_remaining_ms"`
+	Expires       int                    `json:"expires_after_ms"`
+	Physical      bool                   `json:"physical_result_verified"`
+}
+type outputPipeIdentity struct {
+	Device string `json:"device"`
+	Inode  string `json:"inode"`
+	Type   string `json:"type"`
+}
+
+func strictContentJSON(raw []byte, out any) error {
+	var fields map[string]json.RawMessage
+	if strictVolumeJSON(raw, &fields) != nil {
+		return ErrBadRequest
+	}
+	typ := reflect.TypeOf(out).Elem()
+	for i := 0; i < typ.NumField(); i++ {
+		field := typ.Field(i)
+		tag := strings.Split(field.Tag.Get("json"), ",")
+		if len(tag) == 0 || tag[0] == "" || tag[0] == "-" {
+			continue
+		}
+		value, ok := fields[tag[0]]
+		optional := len(tag) > 1 && tag[1] == "omitempty"
+		if !ok {
+			if optional {
+				continue
+			}
+			return ErrBadRequest
+		}
+		if string(value) == "null" {
+			if field.Type.Kind() == reflect.Pointer && (tag[0] == "route_identity" || tag[0] == "pipe_identity" || tag[0] == "actual_native_owner" || tag[0] == "old_native_owner") {
+				continue
+			}
+			return ErrBadRequest
+		}
+		child := field.Type
+		if child.Kind() == reflect.Pointer {
+			child = child.Elem()
+		}
+		if !queueRequiredJSON(value, child) {
+			return ErrBadRequest
+		}
+	}
+	decoder := json.NewDecoder(bytes.NewReader(raw))
+	decoder.DisallowUnknownFields()
+	return decoder.Decode(out)
+}
+func contentHTTP(ctx context.Context, method, url string, payload, out any) error {
+	var body io.Reader
+	if payload != nil {
+		raw, err := json.Marshal(payload)
+		if err != nil {
+			return err
+		}
+		body = bytes.NewReader(raw)
+	}
+	req, err := http.NewRequestWithContext(ctx, method, url, body)
+	if err != nil {
+		return err
+	}
+	if payload != nil {
+		req.Header.Set("Content-Type", "application/json")
+	}
+	client := &http.Client{Timeout: time.Second, CheckRedirect: func(*http.Request, []*http.Request) error { return ErrAliasConflict }}
+	reply, err := client.Do(req)
+	if err != nil {
+		return err
+	}
+	defer reply.Body.Close()
+	raw, err := io.ReadAll(io.LimitReader(reply.Body, 16385))
+	if err != nil || len(raw) > 16384 || reply.StatusCode != 200 {
+		return ErrAliasConflict
+	}
+	return strictContentJSON(raw, out)
+}
+func (c *contentCapture) endpoint(suffix string) string {
