+package daemon
+
+import (
+	"os"
+	"runtime"
+	"strconv"
+	"strings"
+	"sync"
+)
+
+// This certificate comes only from the native process's own Linux namespace.
+// C independently checks /proc before accepting it and retains it durably.
+type contentProcess struct {
+	BootID     string `json:"boot_id"`
+	PID        string `json:"pid"`
+	StartTicks string `json:"proc_start_ticks"`
+}
+
+var contentSelf struct {
+	once        sync.Once
+	certificate contentProcess
+	valid       bool
+}
+
+func nativeContentProcess() (contentProcess, bool) {
+	contentSelf.once.Do(func() {
+		if runtime.GOOS != "linux" {
+			return
+		}
+		boot, err := os.ReadFile("/proc/sys/kernel/random/boot_id")
+		if err != nil {
+			return
+		}
+		stat, err := os.ReadFile("/proc/self/stat")
+		if err != nil {
+			return
+		}
+		end := strings.LastIndex(string(stat), ") ")
+		if end < 0 {
+			return
+		}
+		fields := strings.Fields(string(stat)[end+2:])
+		if len(fields) <= 19 {
+			return
+		}
+		c := contentProcess{strings.TrimSpace(string(boot)), strconv.Itoa(os.Getpid()), fields[19]}
+		if !volumeUUID.MatchString(c.BootID) || !volumeCounter(c.PID) || c.PID == "0" || !volumeCounter(c.StartTicks) || c.StartTicks == "0" {
+			return
+		}
+		contentSelf.certificate, contentSelf.valid = c, true
+	})
+	return contentSelf.certificate, contentSelf.valid
+}
+func (c *contentCapture) processCurrent() bool {
+	actual, valid := nativeContentProcess()
+	return valid && c.Process == actual
+}
