+package player
+
+import (
+	"context"
+	librespot "github.com/devgianlu/go-librespot"
+	"github.com/devgianlu/go-librespot/audio"
+	metadatapb "github.com/devgianlu/go-librespot/proto/spotify/metadata"
+	"net/http"
+	"time"
+)
+
+// Captured by the AppPlayer actor, then used by one detached preparation only.
+// Neither country changes, CDN quarantine nor event publication touches the live
+// player's mutable loader fields while network preparation runs.
+type StreamPreparation struct {
+	loader *Player
+	events *stagedStreamEvents
+}
+
+func (p *Player) CaptureStreamPreparation() *StreamPreparation {
+	country := ""
+	if p.countryCode != nil {
+		country = *p.countryCode
+	}
+	events := &stagedStreamEvents{EventManager: p.events}
+	loader := &Player{log: p.log, flacEnabled: p.flacEnabled, normalisationEnabled: p.normalisationEnabled, normalisationUseAlbumGain: p.normalisationUseAlbumGain, normalisationPregain: p.normalisationPregain, countryCode: &country, sp: p.sp, audioKey: p.audioKey, events: events, cdnQuarantine: map[string]time.Time{}}
+	for k, v := range p.cdnQuarantine {
+		loader.cdnQuarantine[k] = v
+	}
+	return &StreamPreparation{loader, events}
+}
+func (preparation *StreamPreparation) NewStream(ctx context.Context, client *http.Client, id librespot.SpotifyId, bitrate int) (*Stream, error) {
+	return preparation.loader.NewStream(ctx, client, id, bitrate, 0)
+}
+func (preparation *StreamPreparation) PublishEvents() {
+	for _, event := range preparation.events.pending {
+		event()
+	}
+	preparation.events.pending = nil
+}
+
+type stagedStreamEvents struct {
+	EventManager
+	pending []func()
+}
+
+func (e *stagedStreamEvents) PreStreamLoadNew(id []byte, spot librespot.SpotifyId, position int64) {
+	e.pending = append(e.pending, func() { e.EventManager.PreStreamLoadNew(id, spot, position) })
+}
+func (e *stagedStreamEvents) PostStreamResolveAudioFile(id []byte, bitrate int32, media *librespot.Media, file *metadatapb.AudioFile) {
+	e.pending = append(e.pending, func() { e.EventManager.PostStreamResolveAudioFile(id, bitrate, media, file) })
+}
+func (e *stagedStreamEvents) PostStreamRequestAudioKey(id []byte) {
+	e.pending = append(e.pending, func() { e.EventManager.PostStreamRequestAudioKey(id) })
+}
+func (e *stagedStreamEvents) PostStreamResolveStorage(id []byte) {
+	e.pending = append(e.pending, func() { e.EventManager.PostStreamResolveStorage(id) })
+}
+func (e *stagedStreamEvents) PostStreamInitHttpChunkReader(id []byte, reader *audio.HttpChunkedReader) {
+	e.pending = append(e.pending, func() { e.EventManager.PostStreamInitHttpChunkReader(id, reader) })
+}
