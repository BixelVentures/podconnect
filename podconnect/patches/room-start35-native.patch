+package daemon
+
+import (
+	"context"
+	"encoding/json"
+	"io"
+	"net/http"
+	"time"
+)
+
+func contentBody(w http.ResponseWriter, r *http.Request, out any) bool {
+	if r.Method != "POST" {
+		w.WriteHeader(405)
+		return false
+	}
+	if r.URL.RawQuery != "" {
+		w.WriteHeader(400)
+		return false
+	}
+	defer r.Body.Close()
+	raw, err := io.ReadAll(io.LimitReader(r.Body, 16385))
+	if err != nil || len(raw) > 16384 || strictContentJSON(raw, out) != nil {
+		w.WriteHeader(400)
+		return false
+	}
+	return true
+}
+func contentWrite(w http.ResponseWriter, value any) {
+	w.Header().Set("Content-Type", "application/json")
+	w.Header().Set("Cache-Control", "no-store")
+	_ = json.NewEncoder(w).Encode(value)
+}
+func (s *ConcreteApiServer) handleContentControls(w http.ResponseWriter, r *http.Request) {
+	if r.Method != "GET" {
+		w.WriteHeader(405)
+		return
+	}
+	q := r.URL.Query()
+	if len(q) != 4 {
+		w.WriteHeader(400)
+		return
+	}
+	for _, key := range []string{"account_user_id", "target_id", "room_id", "homepod_id"} {
+		if len(q[key]) != 1 || q.Get(key) == "" || len(q.Get(key)) > 160 {
+			w.WriteHeader(400)
+			return
+		}
+	}
+	scope := roomVolumeScope{q.Get("account_user_id"), q.Get("target_id"), q.Get("room_id"), q.Get("homepod_id")}
+	ctx, cancel := context.WithTimeout(r.Context(), 3*time.Second)
+	defer cancel()
+	value, err := s.roomTransportAsk(ctx, apiContentObserve, scope)
+	if err != nil {
+		roomTransportResponse(w, nil, err)
+		return
+	}
+	capture, ok := value.(*contentCapture)
+	if !ok || capture == nil {
+		roomTransportResponse(w, nil, ErrAliasConflict)
+		return
+	}
+	state, err := capture.readCState(ctx)
+	if err != nil {
+		roomTransportResponse(w, nil, err)
+		return
+	}
+	value, err = s.roomTransportAsk(ctx, apiContentOffer, contentOfferActorRequest{capture, state.Target, ctx})
+	if err != nil {
+		roomTransportResponse(w, nil, err)
+		return
+	}
+	op, ok := value.(*contentOperation)
+	if !ok || op == nil || !s.roomContents.put(op) {
+		roomTransportResponse(w, nil, ErrAliasConflict)
+		return
+	}
+	contentWrite(w, struct {
+		Schema   string          `json:"schema"`
+		Ready    bool            `json:"ready"`
+		Scope    roomVolumeScope `json:"scope"`
+		Actions  []string        `json:"actions"`
+		Offer    contentOffer    `json:"start_offer"`
+		Physical bool            `json:"physical_result_verified"`
+		Registry string          `json:"alias_registry"`
+		Digest   string          `json:"input_path_digest"`
+		OwnTone  string          `json:"own_tone_url"`
+	}{"podconnect.native_room_content_controls.v1", true, scope, []string{"play_track", "play_context"}, op.Offer, false, capture.Registry, capture.PipeDigest, capture.OwnTone})
+}
+func (s *ConcreteApiServer) handleContentPrepare(w http.ResponseWriter, r *http.Request) {
+	var request contentPrepareRequest
+	if !contentBody(w, r, &request) {
+		return
+	}
+	if !validContentRequest(request) {
+		w.WriteHeader(400)
+		return
+	}
+	op := s.roomContents.get(request.Offer.OfferID, request.Offer.BindingID)
+	if op == nil {
+		w.WriteHeader(409)
+		return
+	}
+	ctx, cancel := context.WithTimeout(r.Context(), 3*time.Second)
+	defer cancel()
+	_, err := s.roomTransportAsk(ctx, apiContentClaim, contentActorRequest{op, ctx, request})
+	if err != nil {
+		roomTransportResponse(w, nil, err)
+		return
+	}
+	go op.stage()
+	contentWrite(w, op.receipt("prepare"))
+}
+func (s *ConcreteApiServer) contentID(w http.ResponseWriter, r *http.Request) *contentOperation {
+	var request contentIDRequest
+	if !contentBody(w, r, &request) {
+		return nil
+	}
+	if !volumeHex32.MatchString(request.OfferID) || !volumeHex64.MatchString(request.BindingID) {
+		w.WriteHeader(400)
+		return nil
+	}
+	op := s.roomContents.get(request.OfferID, request.BindingID)
+	if op == nil {
+		w.WriteHeader(409)
+	}
+	return op
+}
+func (s *ConcreteApiServer) handleContentCommit(w http.ResponseWriter, r *http.Request) {
+	op := s.contentID(w, r)
+	if op == nil {
+		return
+	}
+	op.commit(r.Context(), s)
+	contentWrite(w, op.receipt("commit"))
+}
+func (s *ConcreteApiServer) handleContentCancel(w http.ResponseWriter, r *http.Request) {
+	op := s.contentID(w, r)
+	if op == nil {
+		return
+	}
+	op.cancelContent()
+	op.mu.Lock()
+	claimed, critical, state := op.Claimed, op.CommitClaimed, op.State
+	op.mu.Unlock()
+	if !claimed || (!critical && state == "staged") {
+		op.discard()
+		op.finish("cancelled")
+	}
+	contentWrite(w, op.receipt("cancel"))
+}
+func (s *ConcreteApiServer) handleContentResult(w http.ResponseWriter, r *http.Request) {
+	if r.Method != "GET" {
+		w.WriteHeader(405)
+		return
+	}
+	q := r.URL.Query()
+	if len(q) != 2 || len(q["offer_id"]) != 1 || len(q["binding_id"]) != 1 || !volumeHex32.MatchString(q.Get("offer_id")) || !volumeHex64.MatchString(q.Get("binding_id")) {
+		w.WriteHeader(400)
+		return
+	}
+	op := s.roomContents.get(q.Get("offer_id"), q.Get("binding_id"))
+	if op == nil {
+		w.WriteHeader(409)
+		return
+	}
+	contentWrite(w, op.receipt("result"))
+}
