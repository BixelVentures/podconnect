+package player
+
+import (
+	"context"
+	"fmt"
+	librespot "github.com/devgianlu/go-librespot"
+	"github.com/devgianlu/go-librespot/output"
+	"strconv"
+	"sync"
+	"time"
+)
+
+type start35Command struct {
+	ctx              context.Context
+	phase            string
+	source, expected librespot.AudioSource
+	pipe             output.PipeIdentity
+	epoch            string
+	guard            output.TransportGuard
+}
+type start35Result struct {
+	Pipe   output.PipeIdentity
+	Epoch  string
+	Source librespot.AudioSource
+	Err    error
+}
+
+func (p *Player) Start35(ctx context.Context, phase string, source, expected librespot.AudioSource, pipe output.PipeIdentity, epoch string, guard output.TransportGuard) (output.PipeIdentity, string, error) {
+	reply := make(chan any, 1)
+	select {
+	case p.cmd <- playerCmd{start: &start35Command{ctx, phase, source, expected, pipe, epoch, guard}, resp: reply}:
+	case <-ctx.Done():
+		return output.PipeIdentity{}, "", ctx.Err()
+	}
+	result := (<-reply).(start35Result)
+	return result.Pipe, result.Epoch, result.Err
+}
+func (p *Player) applyStart35(command *start35Command, out *output.Output, source *SwitchingAudioSource, volume float32) (result start35Result, err error) {
+	if command.phase == "snapshot" {
+		lock, ok := source.cond.L.(*sync.Mutex)
+		if !ok {
+			return result, fmt.Errorf("source mutex unavailable")
+		}
+		if e := output.LockTransport(command.ctx, lock); e != nil {
+			return result, e
+		}
+		result.Source = source.source[source.which]
+		lock.Unlock()
+		return result, nil
+	}
+	if command.phase != "quiesce" && command.phase != "publish" && command.phase != "resume" {
+		return result, fmt.Errorf("bad start phase")
+	}
+	if command.phase == "quiesce" && p.startEpoch == ^uint64(0) {
+		return result, fmt.Errorf("start epoch exhausted")
+	}
+	if command.phase == "quiesce" && *out == nil {
+		if p.newPausedOutput == nil {
+			return result, fmt.Errorf("no paused pipe factory")
+		}
+		candidate, e := p.newPausedOutput(source, volume)
+		if e != nil {
+			return result, e
+		}
+		// Created already paused; never supply a source through legacy SetPrimary.
+		*out = candidate
+	}
+	if *out == nil {
+		return result, fmt.Errorf("no start pipe")
+	}
+	pipe, ok := (*out).(output.StartPipeOutput)
+	if !ok {
+		return result, fmt.Errorf("no start pipe owner")
+	}
+	if command.phase == "quiesce" {
+		pipe.FenceStart()
+	}
+	var displaced []librespot.AudioSource
+	err = pipe.WithStartLock(command.ctx, func(identity output.PipeIdentity, setPaused func(bool)) error {
+		lock, ok := source.cond.L.(*sync.Mutex)
+		if !ok {
+			return fmt.Errorf("no source lock")
+		}
+		if e := output.LockTransport(command.ctx, lock); e != nil {
+			return e
+		}
+		defer lock.Unlock()
+		if source.source[source.which] != command.expected {
+			return fmt.Errorf("start source changed")
+		}
+		if command.pipe.Type != "" && command.pipe != identity {
+			return fmt.Errorf("FIFO incarnation changed")
+		}
+		if command.phase != "quiesce" && (command.epoch == "" || command.epoch != strconv.FormatUint(p.startEpoch, 10)) {
+			return fmt.Errorf("writer epoch changed")
+		}
+		return command.guard(func() {
+			switch command.phase {
+			case "quiesce":
+				p.startEpoch++
+				setPaused(true)
+			case "publish":
+				displaced = append(displaced, source.source[source.which], source.source[!source.which])
+				source.source[source.which] = command.source
+				delete(source.source, !source.which)
+				source.cond.Broadcast()
+				// Drop every pre-barrier EOF/player callback while its source is locked.
+				for {
+					select {
+					case <-source.done:
+					default:
+						goto sourceDrained
+					}
+				}
+			sourceDrained:
+				for {
+					select {
+					case <-p.ev:
+					default:
+						goto eventsDrained
+					}
+				}
+			eventsDrained:
+				p.startedPlaying = time.Now()
+				setPaused(true)
+			case "resume":
+				setPaused(false)
+			}
+			result.Pipe = identity
+			result.Epoch = strconv.FormatUint(p.startEpoch, 10)
+		})
+	})
+	if err == nil && result.Epoch == "" {
+		err = fmt.Errorf("start epoch exhausted")
+	}
+	if err == nil {
+		seen := map[librespot.AudioSource]bool{}
+		for _, old := range displaced {
+			if old != nil && old != command.source && !seen[old] {
+				seen[old] = true
+				_ = closeAudioDecoder(old)
+			}
+		}
+	}
+	return result, err
+}
+
+func (p *Player) Start35CurrentSource(ctx context.Context) (librespot.AudioSource, error) {
+	ctx, cancel := context.WithTimeout(ctx, 3*time.Second)
+	defer cancel()
+	reply := make(chan any, 1)
+	select {
+	case p.cmd <- playerCmd{start: &start35Command{ctx: ctx, phase: "snapshot"}, resp: reply}:
+	case <-ctx.Done():
+		return nil, ctx.Err()
+	}
+	r := (<-reply).(start35Result)
+	return r.Source, r.Err
+}
