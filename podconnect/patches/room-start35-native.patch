+func (p *AppPlayer) consumeContent(request contentActorRequest) (any, error) {
+	op := request.Operation
+	if op == nil {
+		return nil, ErrAliasConflict
+	}
+	p.aliasMu.Lock()
+	defer p.aliasMu.Unlock()
+	op.mu.Lock()
+	defer op.mu.Unlock()
+	if request.Context.Err() != nil || op.Owner != p || !op.CommitClaimed || op.Cancelled || op.Stream == nil || op.Stream.Source == nil || op.Prepared == nil || op.Tracks == nil || !volumeHex64.MatchString(op.ContentDigest) || op.CReceipt == nil || op.CReceipt.Phase != "prepared" || op.ReservationID != "" || op.Terminal || !time.Now().Before(op.StagedUntil) || !p.contentCurrentLocked(op.Capture) || p.roomVolumeReservedLocked() || p.contentBusyLocked() {
+		return nil, ErrAliasConflict
+	}
+	id, err := randomQueueID(16)
+	if err != nil {
+		return nil, err
+	}
+	op.ReservationID = id
+	op.Until = time.Now().Add(12 * time.Second)
+	op.RetainUntil = op.Until.Add(time.Minute)
+	p.roomContentReservation = &contentReservation{op, op.Until}
+	return op, nil
