+package player
+
+import (
+	"context"
+	"errors"
+	librespot "github.com/devgianlu/go-librespot"
+	"github.com/devgianlu/go-librespot/output"
+	"testing"
+	"time"
+)
+
+type startBackend struct {
+	transportTestOutput
+	fenced   bool
+	identity output.PipeIdentity
+}
+
+func (backend *startBackend) FenceStart() { backend.fenced = true }
+func (backend *startBackend) WithStartLock(ctx context.Context, apply func(output.PipeIdentity, func(bool)) error) error {
+	if ctx.Err() != nil {
+		return ctx.Err()
+	}
+	return apply(backend.identity, func(paused bool) { backend.paused = paused; backend.fenced = paused })
+}
+func TestStart35ActualSourceOwnerPausedPublicationAndEpochFence(t *testing.T) {
+	backend := &startBackend{identity: output.PipeIdentity{Device: "1", Inode: "2", Type: "fifo"}}
+	var out output.Output = backend
+	source := NewSwitchingAudioSource()
+	old := &transportSource{id: 1}
+	next := &transportSource{id: 2}
+	source.SetPrimary(old)
+	source.done <- struct{}{}
+	p := &Player{ev: make(chan Event, 4)}
+	p.ev <- Event{Type: EventTypeNotPlaying}
+	allowed := true
+	guard := func(mutate func()) error {
+		if !allowed {
+			return errors.New("revoked")
+		}
+		mutate()
+		return nil
+	}
+	result, err := p.applyStart35(&start35Command{ctx: context.Background(), phase: "quiesce", expected: old, guard: guard}, &out, source, 1)
+	if err != nil || !backend.paused || result.Epoch != "1" {
+		t.Fatal("quiescence not actual", result, err)
+	}
+	allowed = false
+	_, err = p.applyStart35(&start35Command{ctx: context.Background(), phase: "publish", source: next, expected: old, pipe: result.Pipe, epoch: result.Epoch, guard: guard}, &out, source, 1)
+	if err == nil || source.source[source.which] != librespot.AudioSource(old) {
+		t.Fatal("revoked start published")
+	}
+	allowed = true
+	_, err = p.applyStart35(&start35Command{ctx: context.Background(), phase: "publish", source: next, expected: old, pipe: result.Pipe, epoch: result.Epoch, guard: guard}, &out, source, 1)
+	if err != nil || !backend.paused || source.source[source.which] != librespot.AudioSource(next) || len(source.done) != 0 || len(p.ev) != 0 {
+		t.Fatal("new source not paused or old callbacks retained", err)
+	}
+	_, err = p.applyStart35(&start35Command{ctx: context.Background(), phase: "resume", expected: next, pipe: result.Pipe, epoch: "2", guard: guard}, &out, source, 1)
+	if err == nil || !backend.paused {
+		t.Fatal("foreign writer epoch resumed")
+	}
+	ctx, cancel := context.WithDeadline(context.Background(), time.Now().Add(-time.Millisecond))
+	defer cancel()
+	_, err = p.applyStart35(&start35Command{ctx: ctx, phase: "resume", expected: next, pipe: result.Pipe, epoch: result.Epoch, guard: guard}, &out, source, 1)
+	if err == nil || !backend.paused {
+		t.Fatal("late resume admitted")
+	}
+	_, err = p.applyStart35(&start35Command{ctx: context.Background(), phase: "resume", expected: next, pipe: result.Pipe, epoch: result.Epoch, guard: guard}, &out, source, 1)
+	if err != nil || backend.paused {
+		t.Fatal("guarded resume absent", err)
+	}
+}
