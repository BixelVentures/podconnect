+	c := op.Capture
+	op.Intended = roomTransportIdentity{c.Scope.AccountUserID, c.Scope.TargetID, c.Scope.RoomID, c.Scope.HomePodID, c.Connection, futureSession, p.aliasIncarnation, c.Registry, c.AliasRevision + 1}
