+		terminalState = "rejected"
+		return
+	}
+	state := op.Prepared
+	state.SessionId = op.Intended.SessionID
+	state.ContextUri = spotCtx.Uri
+	state.ContextUrl = spotCtx.Url
+	state.ContextMetadata = spotCtx.Metadata
+	state.Restrictions = spotCtx.Restrictions
+	state.ContextRestrictions = spotCtx.Restrictions
+	state.Options = &connectpb.ContextPlayerOptions{}
+	state.Suppressions = &connectpb.Suppressions{}
+	state.PlayOrigin = &connectpb.PlayOrigin{FeatureIdentifier: "go-librespot", FeatureVersion: librespot.VersionNumberString()}
+	state.Track = list.CurrentTrack()
+	state.PrevTracks = list.PrevTracks()
+	state.NextTracks = list.NextTracks(ctx, nil)
+	state.Index = list.Index()
+	state.IsPlaying = true
+	state.IsPaused = true
+	state.IsBuffering = false
+	state.PositionAsOfTimestamp = 0
+	state.Timestamp = time.Now().UnixMilli()
+	id, err := librespot.SpotifyIdFromUri(state.Track.Uri)
+	if err != nil {
+		terminalState = "rejected"
+		return
+	}
+	stream, err := op.Loader.NewStream(ctx, op.Owner.app.client, *id, op.Capture.Bitrate)
+	if err != nil {
+		terminalState = "rejected"
+		return
+	}
+	op.mu.Lock()
+	op.Stream = stream
+	op.Tracks = list
+	cancelled = op.Cancelled || ctx.Err() != nil
+	if !cancelled {
+		state.PlaybackId = hex.EncodeToString(stream.PlaybackId)
+		state.Duration = int64(stream.Media.Duration())
+		op.ContentDigest = contentDigest(struct {
+			Action, URI                              string
+			Args                                     contentArgs
+			FirstTrack, PlaybackID, Session, Binding string
+		}{op.Action, op.URI, op.Args, state.Track.Uri, state.PlaybackId, state.SessionId, op.Offer.BindingID})
+		op.State = "staged"
+		op.StagedUntil = time.Now().Add(5 * time.Second)
+		op.RetainUntil = op.StagedUntil.Add(15 * time.Second)
+	}
+	op.mu.Unlock()
+	if cancelled {
+		terminalState = "cancelled"
+		return
+	}
+	// Ownership remains with the staged operation until guarded publication.
+	op.mu.Lock()
+	op.Stream = stream
+	op.mu.Unlock()
+	keepStaged = true
+	time.AfterFunc(5*time.Second, func() {
+		op.mu.Lock()
+		expired := !op.CommitClaimed && !op.Terminal && time.Now().After(op.StagedUntil)
+		if expired {
+			op.Cancelled = true
+		}
+		op.mu.Unlock()
+		if expired {
+			op.discard()
+			op.finish("rejected")
+		}
+	})
+}
