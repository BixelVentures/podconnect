+func testDealerRoomChangeRetainedOwner(t *testing.T, p *AppPlayer, stream *player.Stream, ctx context.Context, wire *dealerMoveWire) {
+	t.Helper()
+	p.app.mpris = mpris.DummyServer{}
+	events, _ := (evtimpl.Impl{}).NewEventManager(p.app.log, nil, nil, nil, "")
+	nextSessionField(p.sess, "events", events)
+	nextSessionField(p.sess, "dealer", dealer.NewDealer(p.app.log, &http.Client{}, nil, nil))
+	p.logout = make(chan *AppPlayer, 1)
+	p.app.cfg.ZeroconfEnabled = true
+	nextSessionField(p.sess, "sp", pc13Spclient(t, pc13RoundTrip(func(r *http.Request) (*http.Response, error) {
+		return &http.Response{StatusCode: 204, Body: http.NoBody, Header: make(http.Header), Request: r}, nil
+	})))
+	// Actual existing START and optional public MOVE precede this boundary.
+	// Only the next provider decoder is inert; Dealer transfer and Pause
+	// execute their shipped bodies against the retained real FIFO/C owner.
+	aliasEvents := func() int {
+		count := 0
+		if server, ok := p.app.server.(*aliasTestServer); ok {
+			for _, event := range server.events {
+				if event.Type == "selected_alias" {
+					count++
+				}
+			}
+		}
+		return count
+	}
+	beforeAliasEvents := aliasEvents()
+	beforeAlias, beforeRevision := p.state.device.SelectedAliasId, p.aliasRevision
+	beforeStart, beforeMove := p.app.startCustody, p.app.moveCustody
+	beforeWriter, beforeGeneration := p.app.openedWriter, p.app.openedWriterGeneration
+	destination := uint32(1)
+	if beforeAlias == 1 {
+		destination = 2
+	}
+	if os.Getenv("PC_DEALER_ROOM_CHANGE_SAME_ALIAS") != "" {
+		destination = beforeAlias
+	}
+	transfer := pc13TransferState()
+	nextURI := "spotify:track:0000000000000000000003"
+	nextID, _ := librespot.SpotifyIdFromUri(nextURI)
+	nextMedia := librespot.NewMediaFromTrack(&metadatapb.Track{Gid: nextID.Id(), Name: proto.String("inert next decoder"), Duration: proto.Int32(300000), Number: proto.Int32(1), DiscNumber: proto.Int32(1), Album: &metadatapb.Album{Name: proto.String("fixture"), Date: &metadatapb.Date{}}})
+	transfer.Playback.CurrentTrack = &connectpb.ContextTrack{Uri: nextURI}
+	transfer.Playback.Timestamp = time.Now().UnixMilli()
+	transfer.Playback.IsPaused = false
+	transfer.CurrentSession.OriginalSessionId = proto.String(p.state.player.SessionId)
+	transfer.CurrentSession.Context.Pages = []*connectpb.ContextPage{{Tracks: []*connectpb.ContextTrack{transfer.Playback.CurrentTrack}}}
+	req := recoveryRequest()
+	req.TargetAliasId = proto.Uint32(destination)
+	req.Command.Data, _ = proto.Marshal(transfer)
+	p.secondaryStream = &player.Stream{Source: &contentInertSource{}, Media: nextMedia}
+	p.prodInfo = &ProductInfo{}
+	if p.prefetchTimer == nil {
+		p.prefetchTimer = time.NewTimer(time.Hour)
+		defer p.prefetchTimer.Stop()
+	}
+	if os.Getenv("PC_DEALER_ROOM_CHANGE_RETAINED_MOVE") != "" {
+		if err := p.handlePlayerCommandWithSpclient(ctx, req, p.sess.Spclient()); err != nil {
+			t.Fatal("first actual Dealer MOVE", err)
+		}
+		if p.app.startCustody != nil || p.app.moveCustody == nil || !p.app.moveCustody.Terminal || p.app.moveCustody.State != "complete" {
+			t.Fatal("first actual MOVE not retained")
+		}
+		beforeAlias, beforeRevision = p.state.device.SelectedAliasId, p.aliasRevision
+		beforeStart, beforeMove = p.app.startCustody, p.app.moveCustody
+		beforeWriter, beforeGeneration = p.app.openedWriter, p.app.openedWriterGeneration
+		req.TargetAliasId = proto.Uint32(3 - beforeAlias)
+		p.secondaryStream = &player.Stream{Source: &contentInertSource{}, Media: nextMedia}
+	}
+	negative := os.Getenv("PC_DEALER_ROOM_CHANGE_NEGATIVE")
+	switch negative {
+	case "conflicting_alias":
+		req.Command.TargetAliasId = proto.Uint32(beforeAlias)
+	case "invalid_alias":
+		req.TargetAliasId = proto.Uint32(uint32(len(p.aliasRegistry) + 1))
+	case "system_initiated":
+		req.Command.Options.SystemInitiated = true
+	case "unknown_custody":
+		p.app.moveCustodyUnknown = true
+	case "cancel_before":
+		cancelled, stop := context.WithCancel(ctx)
+		stop()
+		ctx = cancelled
+	case "load_failure":
+		// This incumbent worker mode normally uses a prefetched inert decoder;
+		// supply its existing provider/event dependencies before testing failure.
+		fields := reflect.ValueOf(p.player).Elem()
+		for name, value := range map[string]any{"events": events, "sp": p.sess.Spclient()} {
+			field := fields.FieldByName(name)
+			reflect.NewAt(field.Type(), unsafe.Pointer(field.UnsafeAddr())).Elem().Set(reflect.ValueOf(value))
+		}
+		p.secondaryStream = nil
+	}
+	transferErr := p.handlePlayerCommandWithSpclient(ctx, req, p.sess.Spclient())
+	if negative != "" {
+		if negative == "cancel_after_possible" || negative == "stale_after_possible" {
+			p.Close()
+		} // Join the incumbent asynchronous close before observing its fields.
+		if aliasEvents() != beforeAliasEvents {
+			t.Fatal("failed Dealer transfer published a selected alias")
+		}
+		if transferErr == nil {
+			t.Fatal("negative Dealer transfer acknowledged", negative)
+		}
+		if negative == "cancel_after_possible" || negative == "stale_after_possible" {
+			if !p.roomMoveQuarantined || p.roomMoveReservation != nil {
+				t.Fatal("uncertain MOVE lost quarantine/exact cleanup", negative)
+			}
+			if wire == nil || wire.operation.Load() == nil {
+				t.Fatal("missing actual failed MOVE operation")
+			}
+			failed := wire.operation.Load()
+			before, generation := p.app.moveCustody, p.app.openedWriterGeneration
+			failed.finish("complete")
+			failed.mu.Lock()
+			state, terminal := failed.State, failed.Terminal
+			delayedErr := p.app.supersedeMoveCustody(context.Background(), failed)
+			failed.mu.Unlock()
+			if !terminal || state != "unknown" || delayedErr == nil || !p.roomMoveQuarantined || p.app.moveCustody != before || p.app.openedWriterGeneration != generation {
+				t.Fatal("late failed-operation completion escaped quarantine/generation")
+			}
+		} else if negative == "load_failure" {
+			if !p.aliasRetired || !p.roomVolumeClosing || p.state.player.IsPlaying || p.primaryStream != nil {
+				t.Fatal("posthandoff load failure did not seal actor", transferErr)
+			}
+		} else if p.state.device.SelectedAliasId != beforeAlias || p.aliasRevision != beforeRevision || p.app.startCustody != beforeStart || p.app.moveCustody != beforeMove || p.app.openedWriter != beforeWriter {
+			t.Fatal("rejected transfer changed owner", negative, transferErr)
+		}
+		t.Logf("negative=%s transferErr=%v quarantined=%t aliasRetired=%t reservationCleared=%t", negative, transferErr, p.roomMoveQuarantined, p.aliasRetired, p.roomMoveReservation == nil)
+		return
+	}
+
+	var pause dealer.RequestPayload
+	pause.Command.Endpoint = "pause"
+	pauseErr := p.handlePlayerCommandWithSpclient(ctx, pause, p.sess.Spclient())
+	t.Logf("actual Dealer boundary priorStart=%t priorMove=%t alias=%d->%d revision=%d->%d transferErr=%v pauseErr=%v sameCustody=%t sameWriter=%t sameGeneration=%t paused=%t", beforeStart != nil, beforeMove != nil, beforeAlias, p.state.device.SelectedAliasId, beforeRevision, p.aliasRevision, transferErr, pauseErr, beforeStart == p.app.startCustody && beforeMove == p.app.moveCustody, beforeWriter == p.app.openedWriter, beforeGeneration == p.app.openedWriterGeneration, p.state.player.IsPaused)
+	if transferErr != nil {
+		t.Fatal("Dealer transfer failed before the suspected owner boundary", transferErr)
+	}
+	if pauseErr != nil {
+		t.Fatal("REGRESSION: acknowledged Dealer transfer left its Spotify Pause without current bound output owner", pauseErr)
+	}
+	expectedEvents := 1
+	if os.Getenv("PC_DEALER_ROOM_CHANGE_RETAINED_MOVE") != "" {
+		expectedEvents = 2
+	}
+	if aliasEvents()-beforeAliasEvents != expectedEvents {
+		t.Fatal("early or duplicate selected-alias publication", aliasEvents()-beforeAliasEvents, expectedEvents)
+	}
+	return
+}
