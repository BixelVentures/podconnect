+// This existing local C protocol double validates native requests and drives
+// actual native consume/quiesce/switch/resume/final-writer verification. It does
+// not execute OwnTone or write a C journal.
+type dealerMoveWire struct {
+	operation atomic.Pointer[moveOperation]
+	state     moveCState
+	receipt   moveCReceipt
+	calls     []string
+}
+
+func (f *dealerMoveWire) reply(t *testing.T, p *AppPlayer, w http.ResponseWriter, r *http.Request) {
+	t.Helper()
+	endpoint := r.URL.Path[strings.LastIndex(r.URL.Path, "/")+1:]
+	f.calls = append(f.calls, endpoint)
+	var body map[string]json.RawMessage
+	if err := json.NewDecoder(r.Body).Decode(&body); err != nil {
+		t.Fatal(err)
+	}
+	read := func(key string, out any) {
+		if err := json.Unmarshal(body[key], out); err != nil {
+			t.Fatalf("move %s missing %s: %v", endpoint, key, err)
+		}
+	}
+	if endpoint == "state" {
+		var old roomTransportIdentity
+		var digest string
+		read("old_native_owner", &old)
+		read("expected_input_path_digest", &digest)
+		target := strings.Split(r.URL.Path, "/")[3]
+		route := roomVolumeRoute{"00000000-0000-0000-0000-000000000001", old.HomePodID, "1", "1", "1", "1", "1", "1", digest}
+		f.state = moveCState{Schema: "podconnect.output_move_state.v1", OK: true, Ready: true, Policy: movePolicy, SessionVolume: 35, OldBaseRevision: "1", TargetBaseRevision: "1", OldRoute: route, Target: contentTarget{Process: route.Process, DeviceID: target, Incarnation: "1"}, InputDigest: digest, Paused: p.state.player.IsPaused}
+		_ = json.NewEncoder(w).Encode(f.state)
+		return
+	}
+	if endpoint == "prepare" {
+		f.receipt = moveCReceipt{OK: true, Token: strings.Repeat("f", 32), Policy: movePolicy, SessionVolume: 35, OldBaseRevision: "1", TargetBaseRevision: "1", OldRoute: f.state.OldRoute, Target: f.state.Target, InputDigest: f.state.InputDigest, InputEpoch: "0", WriterEpoch: "0", Phase: "prepared", Expires: 8000}
+		read("offer_id", &f.receipt.OfferID)
+		read("binding_id", &f.receipt.BindingID)
+		read("native_incarnation", &f.receipt.Incarnation)
+		read("native_revision", &f.receipt.Revision)
+		read("old_native_owner", &f.receipt.OldOwner)
+		read("intended_native_owner", &f.receipt.Intended)
+	} else {
+		if endpoint != "cancel" {
+			read("native_reservation_id", &f.receipt.ReservationID)
+		}
+		f.receipt.Possible = true
+		f.receipt.GateClosed = true
+		f.receipt.PinRemaining = 14000
+		f.receipt.Drained = true
+		f.receipt.Pipe = &outputPipeIdentity{Device: p.app.openedWriter.Device, Inode: p.app.openedWriter.Inode, Type: "fifo"}
+		f.receipt.Phase = map[string]string{"commit": "gate_closed_reader_ready", "barrier": "route_ready_closed", "open": "opened", "complete": "completed", "cancel": "unknown"}[endpoint]
+		if endpoint == "commit" {
+			f.operation.Store(p.roomMoveReservation.Operation)
+		}
+
+		if endpoint == "commit" && os.Getenv("PC_DEALER_ROOM_CHANGE_NEGATIVE") == "cancel_after_possible" {
+			op := p.roomMoveReservation.Operation
+			op.mu.Lock()
+			cancel := op.Cancel
+			op.mu.Unlock()
+			cancel()
+		}
+		if endpoint == "barrier" && os.Getenv("PC_DEALER_ROOM_CHANGE_NEGATIVE") == "stale_after_possible" {
+			p.aliasMu.Lock()
+			p.aliasRevision++
+			p.aliasMu.Unlock()
+		}
+
+		if endpoint == "barrier" {
+			read("writer_source_epoch", &f.receipt.WriterEpoch)
+			f.receipt.InputEpoch = f.receipt.WriterEpoch
+			route := f.state.OldRoute
+			route.DeviceID = f.state.Target.DeviceID
+			f.receipt.Route = &route
+		}
+		if endpoint == "open" || endpoint == "complete" {
+			f.receipt.GateClosed = false
+			actual := f.receipt.Intended
+			f.receipt.Actual = &actual
+		}
+	}
+	f.receipt.Schema = "podconnect.output_move_" + endpoint + ".v1"
+	_ = json.NewEncoder(w).Encode(f.receipt)
+}
+
+func TestDealerRoomChangeUsesExistingMoveOwner(t *testing.T) {
+	cases := []string{"completed_start", "completed_move", "same_alias", "conflicting_alias", "invalid_alias", "system_initiated", "unknown_custody", "cancel_before", "cancel_after_possible", "stale_after_possible", "load_failure"}
+	for _, name := range cases {
+		t.Run(name, func(t *testing.T) {
+			t.Setenv("PC_DEALER_ROOM_CHANGE_REGRESSION", "1")
+			if name == "completed_move" {
+				t.Setenv("PC_DEALER_ROOM_CHANGE_RETAINED_MOVE", "1")
+			}
+			if name == "same_alias" {
+				t.Setenv("PC_DEALER_ROOM_CHANGE_SAME_ALIAS", "1")
+			}
+			if name != "completed_start" && name != "completed_move" && name != "same_alias" {
+				t.Setenv("PC_DEALER_ROOM_CHANGE_NEGATIVE", name)
+			}
+			TestPreparedDealerSTARTUsesRealFIFOAndPreservesTransfer(t)
+		})
+	}
+}
