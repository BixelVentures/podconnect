+type contentInertSource struct {
+	closes    atomic.Int32
+	finite    bool
+	remaining int
+	eofFile   string
+}
+
+func (s *contentInertSource) Read(p []float32) (int, error) {
+	if !s.finite {
+		return 0, nil
+	}
+	if s.remaining == 0 {
+		if s.eofFile != "" {
+			_ = os.WriteFile(s.eofFile, []byte("observed\n"), 0600)
+		}
+		return 0, io.EOF
+	}
+	n := min(len(p), s.remaining)
+	for i := 0; i < n; i++ {
+		p[i] = 0.01
+	}
+	s.remaining -= n
+	return n, nil
+}
+func (*contentInertSource) PositionMs() int64         { return 0 }
+func (*contentInertSource) SetPositionMs(int64) error { return nil }
+func (s *contentInertSource) Close() error            { s.closes.Add(1); return nil }
 
