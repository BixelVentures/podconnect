+// SeekTransferred keeps the authenticated dealer's supplied current track when
+// a later context page is unavailable. It never substitutes cached first media.
+// The bool distinguishes a detached track so callers cannot claim shuffled
+// context continuity. Existing generic TrySeek and control paths are unchanged.
+func (tl *List) SeekTransferred(ctx context.Context, track *connectpb.ContextTrack) (bool, error) {
+	if err := ctx.Err(); err != nil {
+		return false, err
+	}
+	if track == nil {
+		return false, fmt.Errorf("missing transferred track")
+	}
+	target := librespot.ContextTrackToProvidedTrack(tl.ctx.Type(), track)
+	if target.Uri == "" {
+		return false, fmt.Errorf("missing transferred media identity")
+	}
+	match := func(row *connectpb.ContextTrack) bool {
+		return row != nil && librespot.ContextTrackToProvidedTrack(tl.ctx.Type(), row).Uri == target.Uri
+	}
+	if tl.playingQueue && (len(tl.queue) == 0 || !match(tl.queue[0]) || (track.Uid != "" && tl.queue[0].Uid != track.Uid)) {
+		return false, fmt.Errorf("transferred queue current identity differs")
+	}
+	err := tl.Seek(ctx, match)
+	if err == nil {
+		return false, nil
+	}
+	if ctx.Err() != nil {
+		return false, ctx.Err()
+	}
+	var status *spclient.ContextPageStatusError
+	if len(tl.tracks.list) == 0 || !errors.As(err, &status) || status.StatusCode != 404 {
+		return false, err
+	}
+	detached := proto.Clone(track).(*connectpb.ContextTrack)
+	if strings.HasPrefix(tl.ctx.Uri(), "spotify:station:") {
+		if detached.Metadata == nil {
+			detached.Metadata = make(map[string]string)
+		}
+		detached.Metadata["autoplay.is_autoplay"] = "true"
+	}
+	tl.tracks.moveInjected(detached, err)
+	return true, nil
 }
 
