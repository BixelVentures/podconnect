+func TestTransferredTrackLater404IsDetachedAndDoesNotRetry(t *testing.T) {
+	for _, queued := range []bool{false, true} {
+		t.Run(fmt.Sprint(queued), func(t *testing.T) {
+			ctx := context.Background()
+			first := &connectpb.ContextTrack{Uri: "spotify:track:0000000000000000000001", Uid: "cached"}
+			target := &connectpb.ContextTrack{Uri: "spotify:track:0000000000000000000009", Uid: "requested", Metadata: map[string]string{"from": "transfer"}}
+			list, err := NewTrackListFromContext(ctx, &librespot.NullLogger{}, nil, &connectpb.Context{Uri: "spotify:playlist:0000000000000000000001", Pages: []*connectpb.ContextPage{{Tracks: []*connectpb.ContextTrack{first}}}})
+			if err != nil {
+				t.Fatal(err)
+			}
+			missing := &spclient.ContextPageStatusError{URL: "hm://fixture/later", StatusCode: 404}
+			pageCalls := make(map[int]int)
+			list.tracks.pages = queuePreparePages(func(_ context.Context, index int) ([]*connectpb.ContextTrack, error) {
+				pageCalls[index]++
+				if pageCalls[index] > 1 {
+					t.Error("repeated failed context read", index)
+				}
+				if index == 0 {
+					return []*connectpb.ContextTrack{first}, nil
+				}
+				return nil, missing
+			})
+			if queued {
+				list.AddToQueue(proto.Clone(target).(*connectpb.ContextTrack))
+			}
+			next := &connectpb.ContextTrack{Uri: "spotify:track:0000000000000000000008", Uid: "next"}
+			list.AddToQueue(next)
+			list.SetPlayingQueue(queued)
+			beforeQueue := append([]*connectpb.ContextTrack(nil), list.queue...)
+			injected, err := list.SeekTransferred(ctx, target)
+			if err != nil || !injected || list.CurrentTrack().Uri != target.Uri || list.CurrentTrack().Uid != target.Uid || list.tracks.get().pageIdx != -1 || list.tracks.get().itemIdx != -1 || list.Index().Page != 0 || list.Index().Track != 0 {
+				t.Fatal("exact detached transferred current lost", injected, err)
+			}
+			if list.tracks.get().item == target || list.tracks.get().item.Metadata["from"] != "transfer" {
+				t.Fatal("injected track shares caller storage or lost metadata")
+			}
+			if !reflect.DeepEqual(beforeQueue, list.queue) || list.playingQueue != queued {
+				t.Fatal("supplied queue changed")
+			}
+			if err := list.ToggleShuffle(ctx, true); err == nil || list.shuffled {
+				t.Fatal("unavailable detached context claimed shuffle")
+			}
+			upcoming := list.NextTracks(ctx, nil)
+			if len(upcoming) != 2 || upcoming[0].Uri != next.Uri || upcoming[1].Uri != first.Uri {
+				t.Fatal("queue/cached context order invented", upcoming)
+			}
+			if _, err = list.AllTracksWithError(ctx); !errors.Is(err, missing) {
+				t.Fatal("failed continuation falsely complete", err)
+			}
+			prepared, err := list.PrepareTransport(ctx, false, 0)
+			if err != nil || prepared.CurrentTrack().Uri != next.Uri || list.CurrentTrack().Uri != target.Uri || prepared.tracks.injectedFetchErr != list.tracks.injectedFetchErr {
+				t.Fatal("detached next borrowed/mutated original cursor or retried", err)
+			}
+		})
+	}
+}
