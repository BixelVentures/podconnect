+func TestTransferredTrackRefusesOtherFailuresCancelAndForeignQueue(t *testing.T) {
+	for _, mode := range []string{"403", "429", "500", "cancel", "first-page404", "foreign-queue-uri", "foreign-queue-uid"} {
+		t.Run(mode, func(t *testing.T) {
+			ctx, cancel := context.WithCancel(context.Background())
+			defer cancel()
+			first := &connectpb.ContextTrack{Uri: "spotify:track:0000000000000000000001"}
+			target := &connectpb.ContextTrack{Uri: "spotify:track:0000000000000000000009", Uid: "requested"}
+			list, err := NewTrackListFromContext(ctx, &librespot.NullLogger{}, nil, &connectpb.Context{Uri: "spotify:playlist:0000000000000000000001", Pages: []*connectpb.ContextPage{{Tracks: []*connectpb.ContextTrack{first}}}})
+			if err != nil {
+				t.Fatal(err)
+			}
+			pageCalls := 0
+			var responseStatus = 404
+			list.tracks.pages = queuePreparePages(func(_ context.Context, index int) ([]*connectpb.ContextTrack, error) {
+				pageCalls++
+				if strings.HasPrefix(mode, "foreign-queue") {
+					t.Error("foreign queue caused context I/O")
+				}
+				if mode == "first-page404" {
+					return nil, &spclient.ContextPageStatusError{URL: "hm://fixture/first", StatusCode: 404}
+				}
+				if index == 0 {
+					return []*connectpb.ContextTrack{first}, nil
+				}
+				if mode == "cancel" {
+					cancel()
+				}
+				return nil, &spclient.ContextPageStatusError{URL: "hm://fixture/later", StatusCode: responseStatus}
+			})
+			if strings.HasPrefix(mode, "foreign-queue") {
+				wrong := proto.Clone(target).(*connectpb.ContextTrack)
+				if mode == "foreign-queue-uri" {
+					wrong.Uri = first.Uri
+				} else {
+					wrong.Uid = "foreign"
+				}
+				list.AddToQueue(wrong)
+				list.SetPlayingQueue(true)
+			} else {
+				if mode == "403" {
+					responseStatus = 403
+				}
+				if mode == "429" {
+					responseStatus = 429
+				}
+				if mode == "500" {
+					responseStatus = 500
+				}
+			}
+			injected, err := list.SeekTransferred(ctx, target)
+			if strings.HasPrefix(mode, "foreign-queue") && pageCalls != 0 {
+				t.Fatal("foreign current spent context reads")
+			}
+			if err == nil || injected || list.tracks.injectedFetchErr != nil || list.tracks.pos != -1 {
+				t.Fatal("negative context/queue gained current track", mode, injected, err)
+			}
+		})
+	}
