+			var writer output.MovePipeIdentity
+			server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				var body map[string]json.RawMessage
+				_ = json.NewDecoder(r.Body).Decode(&body)
+				var reservation string
+				_ = json.Unmarshal(body["native_reservation_id"], &reservation)
+				actualPhase := "prepare"
+				if strings.HasSuffix(r.URL.Path, "/complete") {
+					actualPhase = "complete"
+				}
+				if actualPhase == phase {
+					close(entered)
+					<-release
+				}
+				_ = json.NewEncoder(w).Encode(retirementReply("start", actualPhase, reservation, writer))
+			}))
+			defer server.Close()
+			app, owner, _ := retirementOwnerFixture(t, server.URL, "start")
+			defer owner.player.Close()
+			writer = app.openedWriter
+			var a *retirementAttempt
+			if phase == "complete" {
+				a = app.prepareCompletedRetirementFor(owner)
+				if a == nil {
+					t.Fatal("prepare failed")
+				}
+				owner.player.Close()
+			}
+			done := make(chan struct{})
+			go func() {
+				if phase == "prepare" {
+					_ = app.prepareCompletedRetirementFor(owner)
+				} else {
+					app.completeRetirementFor(a)
+				}
+				close(done)
+			}()
+			select {
+			case <-entered:
+			case <-time.After(time.Second):
+				t.Fatal("C await not entered")
+			}
+			next := &AppPlayer{}
+			nextOp := &contentOperation{Owner: next}
+			nextAttempt := &retirementAttempt{owner: next}
+			app.moveCustodyMu.Lock()
+			app.startCustody, app.retirementPending = nextOp, nextAttempt
+			app.openedWriterOwner = next
