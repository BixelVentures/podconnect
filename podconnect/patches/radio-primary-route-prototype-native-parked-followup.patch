new file mode 100644
--- /dev/null
+++ b/daemon/radio_primary_parked_restart.go
@@ -0,0 +1,117 @@
+package daemon
+
+import "context"
+
+func primaryParkedStopReceipt(h *radioHold) (radioPrimaryStopReceipt, bool) {
+	if !primaryRadioReleased(h) || h.PrimaryPark == nil || !h.WriterParked || h.PauseUncertain || !validPrimaryRadioHold(h) {
+		return radioPrimaryStopReceipt{}, false
+	}
+	action := h.PrimaryAction
+	if action == "" && h.PrimaryPending.Stopped != nil {
+		action = h.PrimaryPending.Stopped.Action
+	}
+	receipt := radioPrimaryStopReceipt{radioPrimaryStopRequest: radioPrimaryStopRequest{
+		Schema: primaryRadioStopSchema, Phase: "released", Action: action, radioPrimaryBinding: *h.Primary,
+	}, TeardownCSeq: h.PrimaryPending.Released}
+	return receipt, volumeUUID.MatchString(action) && receipt.TeardownCSeq > 0
+}
+
+func primaryPreviousRelease(receipt *radioPrimaryStopReceipt) *radioPrimaryPreviousRelease {
+	return &radioPrimaryPreviousRelease{receipt.radioPrimaryBinding, receipt.Action, receipt.TeardownCSeq}
+}
+
+func (p *AppPlayer) reservePrimaryParkedRestart(r radioPrimaryCommand, h *radioHold, release radioPrimaryStopReceipt, generation uint64) (any, error) {
+	if h.owner != p || h.primary == nil || p.primaryStream != h.primary || h.PrimaryReturn != nil ||
+		r.Target != h.Request.TargetID || r.From != "" && r.From != r.Target || primaryReplacementPending(h) ||
+		p.state == nil || p.state.player == nil || !p.state.player.IsPaused {
+		return nil, ErrAliasConflict
+	}
+	r.Owner = r.Generation
+	h.Phase, h.PrimaryAction = "primary_reserved", release.Action
+	h.PrimaryPending = &radioPrimaryPending{Reserve: r, ParkedRestart: true, PriorRelease: &release, Released: release.TeardownCSeq}
+	p.app.radio.Generation = generation
+	if err := p.app.persistRadioLocked(); err != nil {
+		return nil, err
+	}
+	r.Phase = "reserved"
+	return radioPrimaryReply{radioPrimaryCommand: r}, nil
+}
+
+func (p *AppPlayer) primaryRadioParkedRestartActor(ctx context.Context, r radioPrimaryCommand, h *radioHold, device string) (any, error) {
+	op := h.PrimaryPending
+	if r.Session != nil || op.PriorRelease == nil || h.PrimaryPark == nil || !h.WriterParked {
+		return nil, ErrAliasConflict
+	}
+	if r.Phase == "start" || r.Phase == "result" && r.ForPhase == "start" {
+		if !op.Decoded || r.Station != op.Station {
+			return nil, ErrAliasConflict
+		}
+		return p.primaryRadioReplacementStart(ctx, r, h)
+	}
+	if r.Phase != "prepare_start" && !(r.Phase == "result" && r.ForPhase == "prepare_start") {
+		return nil, ErrAliasConflict
+	}
+	if !nativeOwnerASCII(r.Station, 31) || op.Station != "" && r.Station != op.Station {
+		return nil, ErrAliasConflict
+	}
+	if op.ReplacementRejected && r.Phase == "result" {
+		r.Phase = "rejected"
+		return radioPrimaryReply{radioPrimaryCommand: r}, nil
+	}
+	if h.Phase != "primary_reserved" && !(h.Phase == "primary_replacement_released" && r.Phase == "result") || op.Started != nil {
+		return nil, ErrAliasConflict
+	}
+
+	wire := radioPrimaryStartWire{Schema: cPrimaryStartSchema, Phase: "result", Action: r.Action,
+		Station: r.Station, Generation: r.Generation, Predecessor: &op.PriorRelease.radioPrimaryBinding,
+		PriorRelease: primaryPreviousRelease(op.PriorRelease)}
+	if r.Phase == "prepare_start" {
+		if r.ForPhase != "" || op.Target != nil {
+			return nil, ErrAliasConflict
+		}
+		target, err := p.primaryRadioCStart(ctx, radioPrimaryStartWire{
+			Schema: cPrimaryStartSchema, Phase: "preflight_replace_target",
+			radioPrimaryTarget: radioPrimaryTarget{Device: device}, Predecessor: wire.Predecessor, PriorRelease: wire.PriorRelease,
+		}, false)
+		op.Station = r.Station
+		if err != nil {
+			return p.rejectPrimaryParkedRestart(r, h) // Only a read was attempted.
+		}
+		op.Target = &target.radioPrimaryTarget
+		if err = p.app.persistRadioLocked(); err != nil {
+			return nil, err
+		}
+		wire.Phase = "preflight_replace"
+	}
+	if op.Target == nil || op.Target.Device != device || op.Station != r.Station {
+		return nil, ErrAliasConflict
+	}
+	wire.radioPrimaryTarget = *op.Target
+	ack, err := p.primaryRadioCStart(ctx, wire, false)
+	if err != nil {
+		return nil, err
+	}
+	switch ack.Phase {
+	case "pending":
+		r.Phase = "pending"
+	case "decoded":
+		op.Decoded, h.Phase, r.Phase = true, "primary_replacement_released", "prepared"
+	case "rejected":
+		return p.rejectPrimaryParkedRestart(r, h)
+	default:
+		return nil, ErrAliasConflict
+	}
+	if err = p.app.persistRadioLocked(); err != nil {
+		return nil, err
+	}
+	return radioPrimaryReply{radioPrimaryCommand: r}, nil
+}
+
+func (p *AppPlayer) rejectPrimaryParkedRestart(r radioPrimaryCommand, h *radioHold) (any, error) {
+	h.PrimaryPending.ReplacementRejected, h.PrimaryPending.ReplacementDone = true, true
+	h.Phase, r.Phase = "primary_released", "rejected"
+	if err := p.app.persistRadioLocked(); err != nil {
+		return nil, err
+	}
+	return radioPrimaryReply{radioPrimaryCommand: r}, nil
+}
