diff --git a/src/httpd_jsonapi_transport_bound.inc.c b/src/httpd_jsonapi_transport_bound.inc.c
new file mode 100644
index 0000000..26461a3
--- /dev/null
+++ b/src/httpd_jsonapi_transport_bound.inc.c
@@ -0,0 +1,68 @@
+/* Closed private native-owner wire helpers. Duplicate/trailing rejection is
+ * performed for the complete nested body before any owner command executes. */
+static int transport_native_counter(json_object *o,const char *key,uint64_t *out)
+{
+  char canonical[32]; const char *value;
+  if (attention_parse_u64(o,key,out)<0) return -1;
+  value=jparse_str_from_obj(o,key); snprintf(canonical,sizeof(canonical),"%" PRIu64,*out);
+  return strcmp(value,canonical) ? -1 : 0;
+}
+static int transport_native_parse(json_object *body,struct output_native_owner *owner,uint64_t *revision)
+{
+  json_object *o,*n;
+  if (!json_object_object_get_ex(body,"native_owner",&o) || !json_object_is_type(o,json_type_object)
+      || json_object_object_length(o)!=9
+      || !transport_json_string(o,"account_user_id",owner->account_user_id,sizeof(owner->account_user_id))
+      || !transport_json_string(o,"target_id",owner->target_id,sizeof(owner->target_id))
+      || !transport_json_string(o,"room_id",owner->room_id,sizeof(owner->room_id))
+      || !transport_json_string(o,"homepod_id",owner->homepod_id,sizeof(owner->homepod_id))
+      || !transport_json_string(o,"connection_id",owner->connection_id,sizeof(owner->connection_id))
+      || !transport_json_string(o,"session_id",owner->session_id,sizeof(owner->session_id))
+      || !transport_json_string(o,"alias_incarnation",owner->alias_incarnation,sizeof(owner->alias_incarnation))
+      || !transport_json_string(o,"alias_registry",owner->alias_registry,sizeof(owner->alias_registry))
+      || !json_object_object_get_ex(o,"alias_revision",&n) || !json_object_is_type(n,json_type_int)
+      || json_object_get_int64(n)<0 || json_object_get_int64(n)>=9007199254740992LL) return -1;
+  owner->alias_revision=json_object_get_int64(n);
+  if (revision && (transport_native_counter(body,"native_revision",revision)<0 || !*revision || *revision==UINT64_MAX)) return -1;
+  return 0;
+}
+static json_object *transport_native_json(const struct output_native_owner *s)
+{
+  json_object *o=json_object_new_object();
+  json_object_object_add(o,"account_user_id",json_object_new_string(s->account_user_id));
+  json_object_object_add(o,"target_id",json_object_new_string(s->target_id));
+  json_object_object_add(o,"room_id",json_object_new_string(s->room_id));
+  json_object_object_add(o,"homepod_id",json_object_new_string(s->homepod_id));
+  json_object_object_add(o,"connection_id",json_object_new_string(s->connection_id));
+  json_object_object_add(o,"session_id",json_object_new_string(s->session_id));
+  json_object_object_add(o,"alias_incarnation",json_object_new_string(s->alias_incarnation));
+  json_object_object_add(o,"alias_registry",json_object_new_string(s->alias_registry));
+  json_object_object_add(o,"alias_revision",json_object_new_int64(s->alias_revision)); return o;
+}
+static void transport_native_binding_json(json_object *reply,const struct output_native_owner *owner,uint64_t revision)
+{
+  json_object_object_add(reply,"native_owner",transport_native_json(owner));
+  attention_json_u64(reply,"native_revision",revision);
+}
+static int jsonapi_reply_transport_bound_state(struct httpd_request *hreq)
+{
+  struct output_transport_identity identity; struct output_native_owner owner={0};
+  uint64_t id; bool busy; size_t i;
+  json_object *body=transport_parse_body_limit(hreq->in_body,8192),*reply,*actions;
+  const char *names[]={"pause","resume","next","previous"}; int ret=HTTP_BADREQUEST;
+  if (!body || json_object_object_length(body)!=1 || transport_native_parse(body,&owner,NULL)<0
+      || safe_atou64(hreq->path_parts[2],&id)<0) goto out;
+  ret=409;
+  if (player_transport_bound_state_get(id,&owner,&identity,&busy)<0) goto out;
+  reply=json_object_new_object(); actions=json_object_new_array();
+  json_object_object_add(reply,"schema",json_object_new_string("podconnect.output_transport_state.v2"));
+  json_object_object_add(reply,"ok",json_object_new_boolean(true));
+  json_object_object_add(reply,"identity",transport_identity_json(&identity));
+  json_object_object_add(reply,"busy",json_object_new_boolean(busy));
+  if (!busy) for (i=0;i<ARRAY_SIZE(names);i++) json_object_array_add(actions,json_object_new_string(names[i]));
+  json_object_object_add(reply,"actions",actions);
+  json_object_object_add(reply,"physical_result_verified",json_object_new_boolean(false));
+  ret=transport_json_reply(hreq,reply);
+ out:
+  jparse_free(body); return ret;
+}
