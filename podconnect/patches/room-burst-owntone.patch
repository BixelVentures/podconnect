diff --git a/src/outputs_transport_custody.inc.c b/src/outputs_transport_custody.inc.c
new file mode 100644
index 0000000..549bbf5
--- /dev/null
+++ b/src/outputs_transport_custody.inc.c
@@ -0,0 +1,95 @@
+/* Included by the player event-loop output owner. No network wait/lock. */
+static struct output_native_owner transport_custody_owner;
+static struct output_transport_identity transport_custody_identity;
+static struct timespec transport_custody_expiry;
+static uint64_t transport_admission_generation=1, transport_custody_revision;
+static bool transport_custody_live, transport_custody_lost, transport_generation_exhausted;
+
+static bool native_owner_equal(const struct output_native_owner *a,const struct output_native_owner *b)
+{
+  return !strcmp(a->account_user_id,b->account_user_id) && !strcmp(a->target_id,b->target_id)
+    && !strcmp(a->room_id,b->room_id) && !strcmp(a->homepod_id,b->homepod_id)
+    && !strcmp(a->connection_id,b->connection_id) && !strcmp(a->session_id,b->session_id)
+    && !strcmp(a->alias_incarnation,b->alias_incarnation) && !strcmp(a->alias_registry,b->alias_registry)
+    && a->alias_revision==b->alias_revision;
+}
+static bool native_owner_text(const char *s,size_t capacity)
+{
+  size_t n=strnlen(s,capacity),i;
+  if (!n || n==capacity) return false;
+  for (i=0;i<n;i++) if ((unsigned char)s[i]<32 || (unsigned char)s[i]>=127 || s[i]=='"' || s[i]=='\\') return false;
+  return true;
+}
+static bool native_owner_valid(const struct output_native_owner *o,uint64_t device_id)
+{
+  uint64_t homepod; char canonical[32];
+  if (!o || !native_owner_text(o->account_user_id,sizeof(o->account_user_id))
+      || !native_owner_text(o->target_id,sizeof(o->target_id)) || !native_owner_text(o->room_id,sizeof(o->room_id))
+      || !native_owner_text(o->homepod_id,sizeof(o->homepod_id)) || !native_owner_text(o->connection_id,sizeof(o->connection_id))
+      || !native_owner_text(o->session_id,sizeof(o->session_id)) || !native_owner_text(o->alias_incarnation,sizeof(o->alias_incarnation))
+      || !native_owner_text(o->alias_registry,sizeof(o->alias_registry)) || o->alias_revision>=9007199254740992ULL
+      || safe_atou64(o->homepod_id,&homepod)<0 || !homepod || homepod!=device_id) return false;
+  snprintf(canonical,sizeof(canonical),"%" PRIu64,homepod);
+  return !strcmp(canonical,o->homepod_id);
+}
+static void transport_generation_advance(void)
+{
+  if (transport_admission_generation==UINT64_MAX) transport_generation_exhausted=true;
+  else transport_admission_generation++;
+}
+static bool transport_custody_busy(void)
+{
+  if (transport_custody_live && !transport_remaining(&transport_custody_expiry)) {
+    transport_custody_live=false; transport_generation_advance();
+  }
+  return transport_custody_live || transport_generation_exhausted;
+}
+static bool transport_bound_available(uint64_t id,const struct output_native_owner *owner,uint64_t revision)
+{
+  struct output_transport_identity actual;
+  bool live;
+  (void)outputs_transport_busy();
+  live=transport_custody_busy();
+  if (transport_generation_exhausted || transport_admission_generation==UINT64_MAX || !native_owner_valid(owner,id) || transport_pin || room_volume_pin_busy()
+      || room_volume_undrained() || transport_identity_get(id,&actual)<0) return false;
+  if (live) {
+    if (!transport_identity_equal(&actual,&transport_custody_identity)) transport_custody_lost=true;
+    if (transport_custody_lost || !native_owner_equal(owner,&transport_custody_owner)) return false;
+  }
+  /* A read has revision zero. Same owner never reuses an earlier ordinal,
+   * including across route-custody expiry; a new actor incarnation differs. */
+  if (revision && native_owner_equal(owner,&transport_custody_owner) && revision<=transport_custody_revision) return false;
+  return revision!=UINT64_MAX;
+}
+static bool transport_custody_admit(uint64_t id,const struct output_native_owner *owner,uint64_t revision,
+    uint64_t generation,const struct output_transport_identity *identity)
+{
+  struct timespec expiry;
+  if (!revision || !transport_bound_available(id,owner,revision) || generation!=transport_admission_generation
+      || transport_admission_generation==UINT64_MAX || clock_gettime(CLOCK_MONOTONIC,&expiry)<0) return false;
+  expiry.tv_sec+=10;
+  if (!transport_custody_live || expiry.tv_sec>transport_custody_expiry.tv_sec
+      || (expiry.tv_sec==transport_custody_expiry.tv_sec && expiry.tv_nsec>transport_custody_expiry.tv_nsec))
+    transport_custody_expiry=expiry;
+  transport_custody_owner=*owner; transport_custody_identity=*identity; transport_custody_revision=revision;
+  transport_custody_live=true; transport_custody_lost=false; transport_generation_advance();
+  return true;
+}
+static bool transport_custody_current(const struct output_native_owner *owner,const struct output_transport_identity *identity,uint64_t revision)
+{
+  struct output_transport_identity actual;
+  return transport_custody_busy() && !transport_generation_exhausted && !transport_custody_lost
+    && native_owner_equal(owner,&transport_custody_owner) && transport_custody_revision==revision
+    && transport_identity_equal(identity,&transport_custody_identity)
+    && transport_identity_get(identity->device_id,&actual)==0 && transport_identity_equal(identity,&actual);
+}
+static unsigned transport_custody_remaining(const struct output_native_owner *owner,const struct output_transport_identity *identity)
+{
+  return transport_custody_busy() && native_owner_equal(owner,&transport_custody_owner)
+    && transport_identity_equal(identity,&transport_custody_identity) ? transport_remaining(&transport_custody_expiry) : 0;
+}
+int outputs_transport_bound_state_get(uint64_t id,const struct output_native_owner *owner,struct output_transport_identity *identity,bool *busy)
+{
+  if (!busy || !native_owner_valid(owner,id) || transport_identity_get(id,identity)<0) return -1;
+  *busy=!transport_bound_available(id,owner,0); return 0;
+}
