diff --git a/output/radio_handoff.go b/output/radio_handoff.go
new file mode 100644
index 0000000..45dec97
--- /dev/null
+++ b/output/radio_handoff.go
@@ -0,0 +1,195 @@
+package output
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"os"
+	"strconv"
+	"syscall"
+	"time"
+)
+
+// RadioPipeBinding is native-owned custody, not a caller-provided resume grant.
+// The daemon verifies C's durable source-specific hold/ticket before invoking
+// these methods. No endpoint directly maps arbitrary caller fields onto them.
+type RadioPipeBinding struct {
+	Token      string           `json:"token"`
+	Generation uint64           `json:"generation"`
+	Writer     MovePipeIdentity `json:"writer"`
+}
+type RadioPipeState struct {
+	Binding      RadioPipeBinding `json:"binding"`
+	Suspended    bool             `json:"suspended"`
+	WriterClosed bool             `json:"writer_closed"`
+	PendingBytes int              `json:"pending_bytes"`
+	PositionMS   *int64           `json:"position_ms,omitempty"`
+}
+type RadioPipeOutput interface {
+	Output
+	PauseRadio(context.Context, RadioPipeBinding) (RadioPipeState, error)
+	SuspendRadio(context.Context, RadioPipeBinding) (RadioPipeState, error)
+	ReacquireRadio(context.Context, RadioPipeBinding) (RadioPipeState, error)
+	CompleteRadioReacquire(context.Context, RadioPipeBinding) (RadioPipeState, error)
+	RadioState(context.Context) (RadioPipeState, error)
+}
+
+func validRadioPipeBinding(b RadioPipeBinding) bool {
+	if len(b.Token) != 32 || b.Generation == 0 {
+		return false
+	}
+	for _, c := range b.Token {
+		if !(c >= 'a' && c <= 'f' || c >= '0' && c <= '9') {
+			return false
+		}
+	}
+	return b.Writer.Type == "fifo" && b.Writer.Device != "" && b.Writer.Inode != "" && b.Writer.FD != ""
+}
+func (out *pipeOutput) radioStateLocked() RadioPipeState {
+	return RadioPipeState{Binding: out.radioBinding, Suspended: out.radioSuspended.Load(), WriterClosed: out.fileClosed, PendingBytes: len(out.pendingPCM)}
+}
+func (out *pipeOutput) RadioState(ctx context.Context) (RadioPipeState, error) {
+	if e := LockTransport(ctx, &out.lock); e != nil {
+		return RadioPipeState{}, e
+	}
+	defer out.lock.Unlock()
+	return out.radioStateLocked(), nil
+}
+
+// lockRadioControl joins an active write without leaving the player worker
+// blocked behind a decoder Read after the command's deadline. Cancellation
+// removes only this control intent; it never cancels or closes the decoder.
+func (out *pipeOutput) lockRadioControl(ctx context.Context) error {
+	if err := LockTransport(ctx, &out.control); err != nil {
+		return err
+	}
+	out.controlPending.Store(true)
+	if !out.fileClosed {
+		if err := out.file.SetWriteDeadline(time.Now()); err != nil && !errors.Is(err, os.ErrClosed) {
+			out.controlPending.Store(false)
+			out.control.Unlock()
+			return err
+		}
+	}
+	if err := LockTransport(ctx, &out.lock); err != nil {
+		// Keep the cancellation marker through the active Write's return. If
+		// it were cleared here, its deadline error could retire Spotify as a
+		// real output failure. Cleanup joins in the background without keeping
+		// the player command worker blocked behind a stalled decoder Read.
+		go func() {
+			out.lock.Lock()
+			_ = out.unlockControl()
+		}()
+		return err
+	}
+	return nil
+}
+
+// PauseRadio is the only handoff pause. It validates the reserved writer under
+// the same bounded join and cannot later pause a replacement after timeout.
+func (out *pipeOutput) PauseRadio(ctx context.Context, b RadioPipeBinding) (RadioPipeState, error) {
+	if !validRadioPipeBinding(b) {
+		return RadioPipeState{}, fmt.Errorf("invalid radio binding")
+	}
+	if err := out.lockRadioControl(ctx); err != nil {
+		return RadioPipeState{}, err
+	}
+	defer out.unlockControl()
+	if ctx.Err() != nil {
+		return RadioPipeState{}, ctx.Err()
+	}
+	if out.closed || out.fileClosed || out.radioSuspended.Load() || out.OpenedWriterIdentity() != b.Writer {
+		return RadioPipeState{}, fmt.Errorf("radio pause writer changed")
+	}
+	out.paused = true
+	return out.radioStateLocked(), nil
+}
+func (out *pipeOutput) SuspendRadio(ctx context.Context, b RadioPipeBinding) (RadioPipeState, error) {
+	if e := ctx.Err(); e != nil {
+		return RadioPipeState{}, e
+	}
+	if !validRadioPipeBinding(b) {
+		return RadioPipeState{}, fmt.Errorf("invalid radio binding")
+	}
+	if e := out.lockRadioControl(ctx); e != nil {
+		return RadioPipeState{}, e
+	}
+	defer out.unlockControl()
+	if e := ctx.Err(); e != nil {
+		return RadioPipeState{}, e
+	}
+	if out.radioSuspended.Load() {
+		if out.radioBinding == b {
+			return out.radioStateLocked(), nil
+		}
+		return RadioPipeState{}, fmt.Errorf("foreign suspended owner")
+	}
+	if out.closed || out.fileClosed || !out.paused || out.OpenedWriterIdentity() != b.Writer {
+		return RadioPipeState{}, fmt.Errorf("radio suspend requires exact current paused writer")
+	}
+	// controlPending interrupted and joined the original file.Write under lock.
+	// Keep decoder/source and the exact unwritten PCM/error suffix untouched.
+	out.radioBinding = b
+	out.radioSuspended.Store(true)
+	if e := out.file.Close(); e != nil {
+		return out.radioStateLocked(), e
+	}
+	out.fileClosed = true
+	return out.radioStateLocked(), nil
+}
+func (out *pipeOutput) ReacquireRadio(ctx context.Context, b RadioPipeBinding) (RadioPipeState, error) {
+	if e := ctx.Err(); e != nil {
+		return RadioPipeState{}, e
+	}
+	if e := out.lockRadioControl(ctx); e != nil {
+		return RadioPipeState{}, e
+	}
+	defer out.unlockControl()
+	if e := ctx.Err(); e != nil {
+		return RadioPipeState{}, e
+	}
+	if !out.radioSuspended.Load() || out.radioBinding != b || out.closed || !out.fileClosed || !out.paused {
+		return RadioPipeState{}, fmt.Errorf("radio reacquire binding changed")
+	}
+	fd, e := os.OpenFile(out.pipePath, os.O_WRONLY|syscall.O_NONBLOCK, 0)
+	if e != nil {
+		return RadioPipeState{}, e
+	}
+	info, e := fd.Stat()
+	if e != nil {
+		fd.Close()
+		return RadioPipeState{}, e
+	}
+	stat, ok := info.Sys().(*syscall.Stat_t)
+	if !ok || info.Mode()&os.ModeNamedPipe == 0 || strconv.FormatUint(uint64(stat.Dev), 10) != b.Writer.Device || strconv.FormatUint(uint64(stat.Ino), 10) != b.Writer.Inode {
+		fd.Close()
+		return RadioPipeState{}, fmt.Errorf("radio reacquire FIFO replaced")
+	}
+	writer := MovePipeIdentity{PipeIdentity: PipeIdentity{Device: b.Writer.Device, Inode: b.Writer.Inode, Type: "fifo"}, FD: strconv.FormatUint(uint64(fd.Fd()), 10)}
+	out.file = fd
+	out.fileClosed = false
+	out.radioWriter.Store(&writer)
+	// Reacquire only reopens a PAUSED output. The same explicit user command must
+	// separately pass actor admission and call Resume; no constructor emits PCM.
+	// Keep the suspension fence through C writer/barrier confirmation.
+	out.paused = true
+	return out.radioStateLocked(), nil
+}
+func (out *pipeOutput) RadioSuspended() bool { return out.radioSuspended.Load() }
+
+// CompleteRadioReacquire is called only after Native validates the exact
+// already-consumed C reacquire and new-writer barrier receipt. It stays paused.
+func (out *pipeOutput) CompleteRadioReacquire(ctx context.Context, b RadioPipeBinding) (RadioPipeState, error) {
+	if e := ctx.Err(); e != nil {
+		return RadioPipeState{}, e
+	}
+	if e := out.lockRadioControl(ctx); e != nil {
+		return RadioPipeState{}, e
+	}
+	defer out.unlockControl()
+	if ctx.Err() != nil || !out.radioSuspended.Load() || out.radioBinding != b || out.closed || out.fileClosed || !out.paused || out.radioWriter.Load() == nil {
+		return RadioPipeState{}, fmt.Errorf("radio writer confirmation changed")
+	}
+	out.radioSuspended.Store(false)
+	return out.radioStateLocked(), nil
+}
