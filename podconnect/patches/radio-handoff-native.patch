+package daemon
+
+import (
+	"context"
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"sync/atomic"
+	"testing"
+)
+
+func TestRadioParkedBridgeRejectsAmbiguousFutureBeforeAnyRequest(t *testing.T) {
+	p, _ := contentFixture(t)
+	var calls atomic.Int32
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) { calls.Add(1); w.WriteHeader(500) }))
+	defer server.Close()
+	p.app.cfg.RoomTransportOwnToneURL = server.URL
+	h := &radioHold{Parked: &radioParkedHold{}}
+	for _, r := range []radioParkedBridgeRequest{
+		{},
+		{Resume: &radioParkedResumeFuture{}, Start: &radioAbsenceFuture{}},
+		{Resume: &radioParkedResumeFuture{}, Move: &moveCPrepare{}},
+		{Start: &radioAbsenceFuture{}, Move: &moveCPrepare{}},
+	} {
+		if _, err := p.radioParkedBridgeCall(context.Background(), h, r, 0); err == nil {
+			t.Fatal("ambiguous bridge acquired a grant")
+		}
+	}
+	if calls.Load() != 0 || h.ParkedBridge != nil || h.ParkedBridgeLatest != nil {
+		t.Fatal("invalid future reached C or persistent custody")
+	}
+}
+
+// Pure DTO guard: this fixture is not a receiver acceptance receipt.
+func TestRadioParkedCurrentWireDoesNotProjectHistoricalOrMixedAuthority(t *testing.T) {
+	owner := roomTransportIdentity{}
+	writer := queueWriterWire{}
+	parent := radioCBinding{Token: strings.Repeat("a", 32)}
+	absence := radioAbsenceSource{Kind: "global"}
+	for _, kind := range []string{"live", "parked", "global_absence"} {
+		capture := &radioParkedCurrentCapture{Kind: kind, Owner: &owner, Writer: &writer, SourceHold: &parent, Absence: &absence}
+		raw, err := json.Marshal(capture.wire())
+		if err != nil {
+			t.Fatal(err)
+		}
+		var fields map[string]json.RawMessage
+		if json.Unmarshal(raw, &fields) != nil {
+			t.Fatal("invalid current-source DTO")
+		}
+		switch kind {
+		case "live":
+			if len(fields) != 3 || fields["native_owner"] == nil || fields["writer_proof"] == nil {
+				t.Fatal("live proof leaked another source variant")
+			}
+		case "parked":
+			if len(fields) != 2 || fields["source_hold"] == nil {
+				t.Fatal("closed writer was represented as live")
+			}
+		case "global_absence":
+			if len(fields) != 2 || fields["source_absence"] == nil {
+				t.Fatal("absence inherited historical Spotify authority")
+			}
+		}
+	}
+}
