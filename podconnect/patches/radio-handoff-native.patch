@@ -0,0 +1,283 @@
+package daemon
+
+import (
+	"context"
+	"encoding/json"
+	"strings"
+	"time"
+)
+
+const apiRadioMoveRefresh ApiRequestType = "radio_move_refresh"
+
+type radioMoveRequest struct {
+	Schema         string       `json:"schema"`
+	Phase          string       `json:"phase"`
+	Hold           any          `json:"hold"`
+	Future         moveCPrepare `json:"future_move"`
+	Intent         string       `json:"intent_id"`
+	Challenge      string       `json:"challenge,omitempty"`
+	Generation     string       `json:"drain_generation,omitempty"`
+	Signature      string       `json:"drain_signature,omitempty"`
+	VolumeKind     string       `json:"final_volume_kind,omitempty"`
+	VolumePercent  *int         `json:"final_volume_percent,omitempty"`
+	VolumeRevision string       `json:"final_volume_revision,omitempty"`
+}
+type radioMoveReply struct {
+	Schema             string          `json:"schema"`
+	Purpose            string          `json:"purpose"`
+	Hold               json.RawMessage `json:"hold"`
+	Future             moveCPrepare    `json:"future_move"`
+	Intent             string          `json:"intent_id"`
+	Challenge          string          `json:"challenge"`
+	ChallengeSignature string          `json:"challenge_signature"`
+	Phase              string          `json:"phase"`
+	Physical           bool            `json:"physical_result_verified"`
+	ExecutionVolume    *int            `json:"execution_volume_percent,omitempty"`
+}
+
+func radioHoldProofMatches(raw json.RawMessage, h *radioHold) bool {
+	if h.Parked != nil {
+		var value radioParkedBinding
+		return strictVolumeJSON(raw, &value) == nil && value == h.Parked.Binding
+	}
+	if h.Absence != nil {
+		var value radioAbsenceBinding
+		return strictVolumeJSON(raw, &value) == nil && contentDigest(value) == contentDigest(h.Absence.Binding)
+	}
+	var value radioCBinding
+	return strictVolumeJSON(raw, &value) == nil && value == h.Proof
+}
+
+func (c *moveCapture) radioReadCState(ctx context.Context) (moveCState, error) {
+	if c.Radio == nil {
+		return c.readCState(ctx)
+	}
+	var reply struct {
+		Schema   string          `json:"schema"`
+		Purpose  string          `json:"purpose"`
+		Hold     json.RawMessage `json:"hold"`
+		State    moveCState      `json:"move_state"`
+		Physical bool            `json:"physical_result_verified"`
+	}
+	request := struct {
+		Schema string `json:"schema"`
+		Hold   any    `json:"hold"`
+		Source any    `json:"source_state"`
+	}{"podconnect.output_radio_move_observation.v1", radioHoldProof(c.Radio.hold), c.stateBody()}
+	// The capture carries the configured owner endpoint, never a caller URL.
+	endpoint := strings.TrimSuffix(c.OwnTone, "/") + "/api/outputs/" + c.Scope.HomePodID + "/radio-handoff/move-state"
+	if err := radioControlHTTP(ctx, "POST", endpoint, c.Radio.controlToken, request, &reply); err != nil || reply.Schema != request.Schema || reply.Purpose != "radio_move_v1" || reply.Physical || !radioHoldProofMatches(reply.Hold, c.Radio.hold) || !reply.State.valid(c) {
+		return moveCState{}, ErrAliasConflict
+	}
+	return reply.State, nil
+}
+
+func (p *AppPlayer) radioMoveCall(ctx context.Context, h *radioHold, request radioMoveRequest) (radioMoveReply, error) {
+	var reply radioMoveReply
+	endpoint := strings.TrimSuffix(p.app.cfg.RoomTransportOwnToneURL, "/") + "/api/outputs/" + request.Future.Intended.HomePodID + "/radio-handoff/move"
+	if err := radioControlHTTP(ctx, "POST", endpoint, p.app.cfg.RadioHandoffControlToken, request, &reply); err != nil || reply.Schema != request.Schema || reply.Purpose != "radio_move_v1" || reply.Physical || !radioHoldProofMatches(reply.Hold, h) || reply.Future != request.Future || reply.Intent != request.Intent || !volumeHex32.MatchString(reply.Challenge) || !volumeHex64.MatchString(reply.ChallengeSignature) || request.Challenge != "" && reply.Challenge != request.Challenge {
+		return reply, ErrAliasConflict
+	}
+	return reply, nil
+}
+
+// The original MOVE stays tied to the same source, writer, queue and offer.
+// Its commit consumes radio custody without constructing or opening a route.
+func (p *AppPlayer) refreshRadioMove(ctx context.Context, call moveActorRequest) (any, error) {
+	op := call.Operation
+	if op != nil && op.Radio != nil && op.Radio.Parked {
+		return p.refreshRadioParkedMove(ctx, call)
+	}
+	if op == nil {
+		return nil, ErrAliasConflict
+	}
+	p.aliasMu.Lock()
+	op.mu.Lock()
+	valid := op.Owner == p && op.Radio != nil && op.Radio == op.Capture.Radio && op.Radio.HoldTarget == op.Capture.Scope.RoomID && op.CommitClaimed && op.Claimed && op.State == "committing" && !op.Cancelled && !op.Terminal && !op.RadioRefreshConsumed && time.Now().Before(op.StagedUntil) && time.Now().Before(op.RadioCommitDeadline) && p.moveCurrentLocked(op.Capture)
+	if !valid {
+		op.mu.Unlock()
+		p.aliasMu.Unlock()
+		return nil, ErrAliasConflict
+	}
+	app := p.app
+	app.radio.mu.Lock()
+	h := app.radio.Holds[op.Radio.HoldTarget]
+	valid = h == op.Radio.hold && op.Radio.ClaimIntent == app.radio.Intent && (h.Phase == "prepared" || h.Phase == "suspended")
+	if valid {
+		op.RadioRefreshConsumed = true
+		op.RadioPossible = true
+		h.Phase = "move_binding"
+	}
+	app.radio.mu.Unlock()
+	if !valid {
+		op.mu.Unlock()
+		p.aliasMu.Unlock()
+		return nil, ErrAliasConflict
+	}
+	future := op.cPrepareRequest()
+	op.mu.Unlock()
+	p.aliasMu.Unlock()
+	ctx, cancel := context.WithDeadline(ctx, op.RadioCommitDeadline)
+	defer cancel()
+	intent, err := randomQueueID(16)
+	if err != nil {
+		return nil, err
+	}
+	intent = intent[:8] + "-" + intent[8:12] + "-" + intent[12:16] + "-" + intent[16:20] + "-" + intent[20:]
+	r := radioMoveRequest{Schema: "podconnect.output_radio_move.v1", Phase: "challenge", Hold: radioHoldProof(h), Future: future, Intent: intent}
+	persist := func(phase string, reply *radioMoveReply) error {
+		app.radio.mu.Lock()
+		defer app.radio.mu.Unlock()
+		if app.radio.Holds[op.Radio.HoldTarget] != h || h.Phase != "move_binding" {
+			return ErrAliasConflict
+		}
+		snapshot := r
+		h.Move = &snapshot
+		h.MovePhase = phase
+		if reply != nil {
+			saved := *reply
+			h.MoveLatest = &saved
+			h.ObservedAt = time.Now().UTC().Format(time.RFC3339Nano)
+		}
+		return app.persistRadioLocked()
+	}
+	failed := true
+	defer func() {
+		if failed {
+			app.radio.mu.Lock()
+			h.Phase = "unknown"
+			_ = app.persistRadioLocked()
+			app.radio.mu.Unlock()
+		}
+	}()
+	if err = persist("challenge_pending", nil); err != nil {
+		return nil, err
+	}
+	challenge, err := p.radioMoveCall(ctx, h, r)
+	if err != nil || challenge.Phase != "challenge" {
+		return nil, ErrAliasConflict
+	}
+	r.Challenge = challenge.Challenge
+	if err = persist("challenge", &challenge); err != nil {
+		return nil, err
+	}
+	challengeJSON, _ := json.Marshal(struct {
+		Challenge string `json:"challenge"`
+		Signature string `json:"challenge_signature"`
+	}{challenge.Challenge, challenge.ChallengeSignature})
+	callback := radioPreemptRequest{"podconnect.radio-preempt.v1", h.Request.ProcessID, h.Request.HandoffID, h.Request.Generation, radioHoldToken(h), h.Request.TargetID, intent, "transfer", challengeJSON}
+	var stopped radioPreemptReply
+	if err = radioAuthenticatedHTTP(ctx, strings.TrimSuffix(app.cfg.RadioHandoffOwnerURL, "/")+"/api/radio/native-preempt", app.cfg.RadioHandoffControlToken, callback, &stopped); err != nil {
+		return nil, err
+	}
+	if stopped.Schema != callback.Schema || stopped.ProcessID != callback.ProcessID || stopped.HandoffID != callback.HandoffID || stopped.Generation != callback.Generation || stopped.ActionID != intent || !stopped.Terminal {
+		return nil, ErrAliasConflict
+	}
+	var ticket radioDrainTicket
+	if json.Unmarshal(stopped.Ticket, &ticket) != nil || !ticket.valid(r.Challenge) {
+		return nil, ErrAliasConflict
+	}
+	app.radio.mu.Lock()
+	h.SenderDrain = append(json.RawMessage(nil), stopped.Ticket...)
+	app.radio.mu.Unlock()
+	r.Phase = "commit"
+	r.Generation = ticket.Generation
+	r.Signature = ticket.Signature
+	r.VolumeKind, r.VolumePercent, r.VolumeRevision = ticket.VolumeKind, ticket.VolumePercent, ticket.VolumeRevision
+	if err = persist("commit_pending", &challenge); err != nil {
+		return nil, err
+	}
+	bound, err := p.radioMoveCall(ctx, h, r)
+	if err != nil || bound.Phase != "bound_move" || bound.ExecutionVolume == nil || *bound.ExecutionVolume < 0 || *bound.ExecutionVolume > 100 || ticket.VolumeKind == "receiver_acknowledged" && *bound.ExecutionVolume != *ticket.VolumePercent {
+		return nil, ErrAliasConflict
+	}
+	if err = persist("bound_move", &bound); err != nil {
+		return nil, err
+	}
+	p.aliasMu.Lock()
+	op.mu.Lock()
+	volume := *bound.ExecutionVolume
+	op.RadioExecutionVolume = &volume
+	// Source and writer never changed during the custody-only transition.
+	oldStage := op.Capture.Radio
+	op.Capture.Radio = nil
+	valid = ctx.Err() == nil && !op.Cancelled && !op.Terminal && p.moveCurrentLocked(op.Capture)
+	if !valid {
+		op.Capture.Radio = oldStage
+	}
+	op.mu.Unlock()
+	p.aliasMu.Unlock()
+	if !valid {
+		return nil, ErrAliasConflict
+	}
+	app.radio.mu.Lock()
+	h.Phase = "move_bound"
+	err = app.persistRadioLocked()
+	app.radio.mu.Unlock()
+	if err != nil {
+		return nil, err
+	}
+	failed = false
+	return op, nil
+}
+
+// Called inside the final actual worker/source/owner verification boundary.
+func (p *AppPlayer) completeRadioMoveLocked(op *moveOperation) error {
+	if op.Radio == nil {
+		return nil
+	}
+	app := p.app
+	app.radio.mu.Lock()
+	defer app.radio.mu.Unlock()
+	h := app.radio.Holds[op.Radio.HoldTarget]
+	if h == nil || h != op.Radio.hold || h.Phase != "move_bound" || !radioMoveBindingCompleted(h) || op.CReceipt == nil || op.CReceipt.Phase != "completed" || op.Actual == nil || *op.Actual != op.Intended {
+		return ErrAliasConflict
+	}
+	if op.RadioExecutionVolume == nil || op.CReceipt.SessionVolume != *op.RadioExecutionVolume {
+		return ErrAliasConflict
+	}
+	if err := p.adoptRadioVolume(op.CReceipt.SessionVolume); err != nil {
+		return err
+	}
+	if err := app.retireRadioLocked(h, op.CReceipt); err != nil {
+		return err
+	}
+	app.refreshRadioOutputFenceLocked()
+	globalAbsence := false
+	for _, left := range app.radio.Holds {
+		if left.Absence != nil && left.Absence.Binding.Source.Kind != "target" {
+			globalAbsence = true
+		}
+	}
+	app.radioAbsenceFence.Store(globalAbsence)
+	return nil
+}
+
+func (p *AppPlayer) radioMoveIntentCurrent(op *moveOperation) bool {
+	if op.Radio == nil {
+		return true
+	}
+	p.app.radio.mu.Lock()
+	defer p.app.radio.mu.Unlock()
+	h := p.app.radio.Holds[op.Radio.HoldTarget]
+	return !p.app.radio.failed && h == op.Radio.hold && h != nil && h.Phase == "move_bound" && p.app.radio.Intent == op.Radio.ClaimIntent
+}
+
+func (p *AppPlayer) unknownRadioMove(op *moveOperation) {
+	if op.Radio == nil {
+		return
+	}
+	p.app.radio.mu.Lock()
+	defer p.app.radio.mu.Unlock()
+	if h := p.app.radio.Holds[op.Radio.HoldTarget]; h == op.Radio.hold && h != nil {
+		h.Phase = "unknown"
+		_ = p.app.persistRadioLocked()
+	}
+}
+
+func radioMoveBindingCompleted(h *radioHold) bool {
+	if h.Parked != nil {
+		return h.ParkedBridgeLatest != nil && h.ParkedBridgeLatest.Phase == "bound_move"
+	}
+	return h.MoveLatest != nil && h.MoveLatest.Phase == "bound_move"
+}
