+	"github.com/devgianlu/go-librespot/tracks"
+	"google.golang.org/protobuf/proto"
+)
+
+// Inert custody DTOs isolate canonical staging eligibility, not C admission.
+// The process certificate and FIFO identity come from this actual process/path;
+// full runtime evolution separately obtains H and all C permits from real APIs.
+func globalContentAdmissionFixture(t *testing.T) (*AppPlayer, *contentOperation, *radioHold) {
+	t.Helper()
+	p, seed := contentFixture(t)
+	path := filepath.Join(t.TempDir(), "cold.fifo")
+	if err := syscall.Mkfifo(path, 0600); err != nil {
+		t.Fatal(err)
+	}
+	p.app.cfg.AudioOutputPipe = path
+	p.app.cfg.RadioHandoffControlToken = strings.Repeat("f", 32)
+	p.app.cfg.RadioHandoffOwnerURL = "http://127.0.0.1:3689"
+	p.app.cfg.RadioHandoffStatePath = filepath.Join(t.TempDir(), "radio.json")
+	if err := p.app.initRadio(); err != nil {
+		t.Fatal(err)
+	}
+	p.primaryStream = nil
+	p.primaryLoadOrdinal = 0
+	p.state.player.SessionId = ""
+	p.state.player.Track = nil
+	p.state.tracks = nil
+	p.state.active = false
+	p.state.player.IsPlaying = false
+	c := seed.Capture
+	c.Radio = nil
+	c.Primary = nil
+	c.Source = nil
+	c.OldOwner = nil
+	c.SessionID = ""
+	c.Pipe = path
+	c.PipeDigest = contentDigestBytes(path)
+	source, err := p.app.radioAbsenceSource()
+	if err != nil {
+		t.Fatal(err)
+	}
+	h := &radioHold{Request: radioRequest{TargetID: "r0"}, Phase: "suspended", Absence: &radioAbsenceHold{Signature: strings.Repeat("c", 64), Binding: radioAbsenceBinding{Schema: "podconnect.output_radio_absence.v1", Source: source, Output: radioAbsenceReceiver{Process: "00000000-0000-0000-0000-000000000001", DeviceID: "101", Incarnation: "1", SessionEpoch: "0", RouteRevision: "0", BaseRevision: "1", AttentionRevision: "0"}, Token: strings.Repeat("a", 32), Digest: strings.Repeat("b", 64), InitialVolume: 35, VolumeProvenance: "stored_manual_base"}}}
+	h.Request = radioRequest{Schema: "podconnect.native_radio_handoff.v1", ProcessID: radioProcessID(c.Process), TargetID: "r0", HandoffID: "00000000-0000-0000-0000-000000000002", Generation: "1", ActionID: "00000000-0000-0000-0000-000000000003", Peer: radioPeer{Process: "00000000-0000-0000-0000-000000000004", Epoch: "1", Digest: h.Absence.Binding.Digest}, ExpectedRevision: "0"}
+	h.Absence.Binding.HandoffID, h.Absence.Binding.Generation, h.Absence.Binding.Revision = h.Request.HandoffID, h.Request.Generation, "1"
+	h.Absence.Binding.RadioProcess, h.Absence.Binding.SenderPeer, h.Absence.Binding.RadioEpoch = h.Request.Peer.Process, h.Request.Peer.Process, h.Request.Peer.Epoch
+	p.app.radio.Holds["r0"] = h
+	p.app.radioAbsenceFence.Store(true)
+	value, err := p.offerContent(contentOfferActorRequest{Capture: c, Target: seed.Target, Context: context.Background()})
+	if err != nil {
+		t.Fatal(err)
+	}
+	return p, value.(*contentOperation), h
+}
+func TestRadioGlobalColdContentClaimConsumeStagesWithoutOutputPermission(t *testing.T) {
+	p, op, h := globalContentAdmissionFixture(t)
+	proof := contentDigest(h.Absence.Binding)
+	request := contentActorRequest{Operation: op, Context: context.Background(), Request: contentPrepareRequest{Scope: op.Capture.Scope, Offer: op.Offer, Action: "play_track", Args: contentArgs{TrackURI: "spotify:track:0000000000000000000004", MaxVolume: 35}}}
+	if !p.radioGlobalContentAdmission(request) {
+		t.Fatal("exact unrelated cold destination cannot stage")
+	}
+	if _, err := p.handleApiRequest(context.Background(), ApiRequest{Type: apiContentClaim, Data: request}); err != nil {
+		t.Fatal("canonical public claim rejected", err)
+	}
+	if op.Radio != nil || op.Capture.Radio != nil || !op.Claimed || p.primaryStream != nil || p.app.startCustody != nil || p.app.openedWriterGeneration != 0 || contentDigest(h.Absence.Binding) != proof {
+		t.Fatal("staging adopted unrelated hold or output")
+	}
+	// Consume's own prepared-content checks remain in force. Explicit inert
+	// preconditions exercise its actor surface only, never its source/START path.
+	op.CommitClaimed = true
+	op.State = "committing"
+	op.StagedUntil = time.Now().Add(time.Second)
+	op.ContentDigest = strings.Repeat("d", 64)
+	op.Stream = &player.Stream{Source: &contentInertSource{}}
+	op.Tracks = &tracks.List{}
+	op.Prepared = proto.Clone(p.state.player).(*connectpb.PlayerState)
+	op.CReceipt = &contentCReceipt{Phase: "prepared"}
+	if _, err := p.handleApiRequest(context.Background(), ApiRequest{Type: apiContentConsume, Data: contentActorRequest{Operation: op, Context: context.Background()}}); err != nil {
+		t.Fatal("canonical public consume rejected", err)
+	}
+	if p.primaryStream != nil || p.app.startCustody != nil || p.app.openedWriterGeneration != 0 || op.Radio != nil || contentDigest(h.Absence.Binding) != proof {
+		t.Fatal("consume granted playback/output")
+	}
+	if p.app.absenceEvolutionPermitCurrentLocked(op) {
+		t.Fatal("staging bypassed missing C-derived evolution permit")
+	}
+	if err := p.app.permitStartOutput(op); err == nil {
+		t.Fatal("staging bypassed reader-ready/output admission")
+	}
+}
+func TestRadioGlobalColdContentEligibilityRejectsUnresolvedOrStaleCapture(t *testing.T) {
+	cases := []struct {
+		name   string
+		change func(*AppPlayer, *contentOperation, *radioHold)
+	}{
+		{"stale native intent", func(p *AppPlayer, _ *contentOperation, _ *radioHold) { p.roomNativeIntent++ }},
+		{"foreign owner", func(_ *AppPlayer, o *contentOperation, _ *radioHold) { o.Owner = &AppPlayer{} }},
+		{"malformed target", func(_ *AppPlayer, o *contentOperation, _ *radioHold) { o.Capture.Scope.HomePodID = "999" }},
+		{"held B", func(p *AppPlayer, _ *contentOperation, _ *radioHold) { p.app.radio.Holds["r1"] = &radioHold{} }},
+		{"faulted journal", func(p *AppPlayer, _ *contentOperation, _ *radioHold) { p.app.radio.failed = true }},
+		{"unknown hold", func(_ *AppPlayer, _ *contentOperation, h *radioHold) { h.Phase = "unknown" }},
+		{"target absence", func(_ *AppPlayer, _ *contentOperation, h *radioHold) {
+			h.Absence.Binding.Source.Kind = "target"
+			h.Absence.Binding.Source.Live = &radioAbsenceLive{}
+		}},
+		{"sourceful hold", func(p *AppPlayer, _ *contentOperation, h *radioHold) { h.Absence = nil; h.owner = p }},
+		{"parked hold", func(_ *AppPlayer, _ *contentOperation, h *radioHold) { h.Parked = &radioParkedHold{} }},
+		{"pending custody", func(_ *AppPlayer, _ *contentOperation, h *radioHold) { h.Absence.Custody = &radioAbsenceCustody{} }},
+		{"evolved hold", func(_ *AppPlayer, _ *contentOperation, h *radioHold) { h.Phase = "source_evolved" }},
+		{"missing signature", func(_ *AppPlayer, _ *contentOperation, h *radioHold) { h.Absence.Signature = "" }},
+		{"malformed hold identity", func(_ *AppPlayer, _ *contentOperation, h *radioHold) { h.Absence.Binding.HandoffID = "wrong" }},
+		{"malformed token", func(_ *AppPlayer, _ *contentOperation, h *radioHold) { h.Absence.Binding.Token = "bad" }},
+		{"foreign process", func(_ *AppPlayer, _ *contentOperation, h *radioHold) { h.Absence.Binding.Source.Process.PID = "999999" }},
+		{"replaced FIFO", func(p *AppPlayer, _ *contentOperation, _ *radioHold) {
+			old := p.app.cfg.AudioOutputPipe
+			tmp := old + ".old"
+			if err := syscall.Rename(old, tmp); err != nil {
+				t.Fatal(err)
+			}
+			if err := syscall.Mkfifo(old, 0600); err != nil {
+				t.Fatal(err)
+			}
+		}},
+		{"duplicate physical member", func(p *AppPlayer, _ *contentOperation, h *radioHold) {
+			other := *h
+			other.Request.TargetID = "other"
+			p.app.radio.Holds["other"] = &other
+		}},
+		{"cancelled operation", func(_ *AppPlayer, o *contentOperation, _ *radioHold) { o.Cancelled = true }},
+		{"terminal operation", func(_ *AppPlayer, o *contentOperation, _ *radioHold) { o.Terminal = true }},
+		{"fake radio stage", func(_ *AppPlayer, o *contentOperation, _ *radioHold) { o.Capture.Radio = &radioContentStage{} }},
+		{"retained primary", func(_ *AppPlayer, o *contentOperation, _ *radioHold) { o.Capture.Primary = &player.Stream{} }},
+		{"old playback session", func(_ *AppPlayer, o *contentOperation, _ *radioHold) { o.Capture.SessionID = "old" }},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			p, op, h := globalContentAdmissionFixture(t)
+			tc.change(p, op, h)
+			intent, writer := p.app.radio.Intent, p.app.openedWriterGeneration
+			if p.radioGlobalContentAdmission(contentActorRequest{Operation: op, Context: context.Background()}) {
+				t.Fatal("unresolved/stale canonical staging eligible")
+			}
+			if p.app.radio.Intent != intent || p.app.openedWriterGeneration != writer || p.primaryStream != nil || p.app.startCustody != nil {
+				t.Fatal("eligibility rejection caused effects")
+			}
+		})
+	}
+}
