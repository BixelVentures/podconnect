+package daemon
+
+import (
+	"context"
+	"strconv"
+	"strings"
+
+	"github.com/devgianlu/go-librespot/output"
+)
+
+// Observe an unheld destination while the original source's actual worker and
+// FIFO remain parked. This returns metadata only; no child hold is allocated.
+func (p *AppPlayer) radioObserveParkedSource(ctx context.Context, target string) radioSourceAvailability {
+	if p == nil || p.app == nil || p.app.cfg == nil || p.player == nil || p.primaryStream == nil || p.sess == nil || p.state == nil || p.state.player == nil || ctx.Err() != nil {
+		return radioSourceAvailability{}
+	}
+	app := p.app
+	app.radio.mu.Lock()
+	defer app.radio.mu.Unlock()
+	if app.radio.failed || app.radio.Holds[target] != nil {
+		return radioSourceAvailability{}
+	}
+	var source *radioHold
+	for _, h := range app.radio.Holds {
+		if h.SourceMove != nil && h.SourceMovePhase != "opened" {
+			return radioSourceAvailability{}
+		}
+		if h.Parked == nil && h.Absence == nil && h.owner == p && h.WriterParked && h.RequiresPause && h.Phase == "suspended" {
+			if source != nil {
+				return radioSourceAvailability{}
+			}
+			source = h
+		}
+	}
+	if source == nil || source.primary != p.primaryStream || source.PausedBefore == nil || source.Request.TargetID == target {
+		return radioSourceAvailability{}
+	}
+	proof := source.Proof
+	if proof.Owner.SessionID == "" || proof.Owner.ConnectionID == "" || proof.Owner.SessionID != p.state.player.SessionId || proof.Owner.ConnectionID != p.spotConnId {
+		return radioSourceAvailability{}
+	}
+	generation, err := strconv.ParseUint(proof.Generation, 10, 64)
+	if err != nil || generation == 0 || generation == ^uint64(0) || !volumeCounter(proof.Generation) || proof.Generation != source.Request.Generation || !volumeHex32.MatchString(proof.Token) || proof.Schema != "podconnect.output_radio_handoff.v1" || !proof.Output.valid() || !volumeHex64.MatchString(proof.Digest) {
+		return radioSourceAvailability{}
+	}
+	actual, err := p.player.Start35CurrentSource(ctx)
+	if err != nil || actual != source.primary.Source {
+		return radioSourceAvailability{}
+	}
+	status, err := p.player.InspectRadio(ctx)
+	binding := output.RadioPipeBinding{Token: proof.Token, Generation: generation, Writer: output.MovePipeIdentity{PipeIdentity: proof.Writer.Pipe, FD: proof.Writer.FD}}
+	if err != nil || !status.Suspended || !status.WriterClosed || status.Binding != binding {
+		return radioSourceAvailability{}
+	}
+	hp := ""
+	seen := map[string]bool{}
+	if len(app.cfg.DeviceAliasRoomIDs) != len(app.cfg.DeviceAliases) || len(app.cfg.DeviceAliasHomePodIDs) != len(app.cfg.DeviceAliases) {
+		return radioSourceAvailability{}
+	}
+	for i, room := range app.cfg.DeviceAliasRoomIDs {
+		if seen[room] {
+			return radioSourceAvailability{}
+		}
+		seen[room] = true
+		if room == target {
+			hp = app.cfg.DeviceAliasHomePodIDs[i]
+		}
+	}
+	if !homePodIDPattern.MatchString(hp) || hp == proof.Output.DeviceID {
+		return radioSourceAvailability{}
+	}
+	request := struct {
+		Schema string        `json:"schema"`
+		Source radioCBinding `json:"source_hold"`
+	}{"podconnect.output_radio_parked_absence_observation.v1", proof}
+	var observed radioParkedObservation
+	endpoint := strings.TrimSuffix(app.cfg.RoomTransportOwnToneURL, "/") + "/api/outputs/" + hp + "/radio-parked-absence/observe"
+	if radioControlHTTP(ctx, "POST", endpoint, app.cfg.RadioHandoffControlToken, request, &observed) != nil {
+		return radioSourceAvailability{}
+	}
+	b := observed.Proof
+	if observed.Schema != request.Schema || !observed.OK || observed.Physical || b.Schema != "podconnect.output_radio_parked_absence.v1" || b.SourceHold != proof || !b.Source.valid() || b.Source.InputGeneration == "0" || b.Source.InputItemID == "0" || b.Source.DeviceID != proof.Output.DeviceID || b.Source.DeviceIncarnation != proof.Output.DeviceIncarnation || b.Source.Process != proof.Output.Process || b.Source.InputPathDigest != proof.Writer.InputDigest || b.Output.Process != proof.Output.Process || b.Output.DeviceID != hp || !volumeCounter(b.Output.Incarnation) || b.Output.Incarnation == "0" || !volumeHex64.MatchString(b.Digest) || b.Digest == proof.Digest || b.InitialVolume < 0 || b.InitialVolume > 100 || b.VolumeProvenance != "stored_manual_base" {
+		return radioSourceAvailability{}
+	}
+	return radioSourceAvailability{b.Digest, b.Output.Process, b.Output.Incarnation}
+}
