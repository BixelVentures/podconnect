diff --git a/player/radio_handoff.go b/player/radio_handoff.go
new file mode 100644
index 0000000..5bdba4b
--- /dev/null
+++ b/player/radio_handoff.go
@@ -0,0 +1,160 @@
+package player
+
+import (
+	"context"
+	"fmt"
+	"github.com/devgianlu/go-librespot/output"
+	"sync"
+)
+
+type radioPlayerCommand struct {
+	ctx     context.Context
+	kind    string
+	binding output.RadioPipeBinding
+	guard   func() error
+	admit   func(func() (output.Output, error)) (output.Output, error)
+}
+type radioPlayerResult struct {
+	state output.RadioPipeState
+	err   error
+}
+
+func (p *Player) radioCommand(ctx context.Context, kind string, b output.RadioPipeBinding, guard func() error, admit func(func() (output.Output, error)) (output.Output, error)) (output.RadioPipeState, error) {
+	response := make(chan any, 1)
+	command := &radioPlayerCommand{ctx, kind, b, guard, admit}
+	select {
+	case <-ctx.Done():
+		return output.RadioPipeState{}, ctx.Err()
+	case <-p.closeDone:
+		return output.RadioPipeState{}, fmt.Errorf("player closed")
+	case p.cmd <- playerCmd{radio: command, resp: response}:
+	}
+	select {
+	case <-ctx.Done():
+		return output.RadioPipeState{}, ctx.Err()
+	case <-p.closeDone:
+		return output.RadioPipeState{}, fmt.Errorf("player closed")
+	case raw := <-response:
+		r, ok := raw.(radioPlayerResult)
+		if !ok {
+			return output.RadioPipeState{}, fmt.Errorf("radio player receipt changed")
+		}
+		return r.state, r.err
+	}
+}
+func (p *Player) PauseRadio(ctx context.Context, b output.RadioPipeBinding, guard func() error) (output.RadioPipeState, error) {
+	if guard == nil {
+		return output.RadioPipeState{}, fmt.Errorf("radio pause lacks owner admission")
+	}
+	return p.radioCommand(ctx, "pause", b, guard, nil)
+}
+func (p *Player) SuspendRadio(ctx context.Context, b output.RadioPipeBinding, guard func() error) (output.RadioPipeState, error) {
+	return p.radioCommand(ctx, "suspend", b, guard, nil)
+}
+func (p *Player) InspectRadio(ctx context.Context) (output.RadioPipeState, error) {
+	return p.radioCommand(ctx, "state", output.RadioPipeBinding{}, nil, nil)
+}
+
+// ReacquireRadio performs no Play/Resume and emits no playback event. Native must
+// prove exact C ticket consumption before supplying the guarded writer registry.
+func (p *Player) ReacquireRadio(ctx context.Context, b output.RadioPipeBinding, guard func() error, admit func(func() (output.Output, error)) (output.Output, error)) (output.RadioPipeState, error) {
+	if guard == nil || admit == nil {
+		return output.RadioPipeState{}, fmt.Errorf("radio reacquire lacks owner admission")
+	}
+	return p.radioCommand(ctx, "reacquire", b, guard, admit)
+}
+func (p *Player) CompleteRadioReacquire(ctx context.Context, b output.RadioPipeBinding, guard func() error) (output.RadioPipeState, error) {
+	if guard == nil {
+		return output.RadioPipeState{}, fmt.Errorf("radio confirmation lacks owner admission")
+	}
+	return p.radioCommand(ctx, "complete", b, guard, nil)
+}
+func (p *Player) applyRadioCommand(command *radioPlayerCommand, out output.Output) (output.RadioPipeState, error) {
+	if command == nil || command.ctx == nil || command.ctx.Err() != nil {
+		return output.RadioPipeState{}, fmt.Errorf("radio command unavailable")
+	}
+	pipe, ok := out.(output.RadioPipeOutput)
+	if !ok {
+		return output.RadioPipeState{}, fmt.Errorf("radio requires actual pipe output")
+	}
+	if command.guard != nil {
+		if e := command.guard(); e != nil {
+			return output.RadioPipeState{}, e
+		}
+	}
+	switch command.kind {
+	case "pause":
+		if command.guard == nil {
+			return output.RadioPipeState{}, fmt.Errorf("radio pause lacks owner admission")
+		}
+		return pipe.PauseRadio(command.ctx, command.binding)
+	case "state":
+		return pipe.RadioState(command.ctx)
+	case "complete":
+		if command.guard == nil {
+			return output.RadioPipeState{}, fmt.Errorf("radio confirmation lacks owner admission")
+		}
+		return pipe.CompleteRadioReacquire(command.ctx, command.binding)
+	case "suspend":
+		if command.guard == nil {
+			return output.RadioPipeState{}, fmt.Errorf("radio suspend lacks owner admission")
+		}
+		return pipe.SuspendRadio(command.ctx, command.binding)
+	case "reacquire":
+		var state output.RadioPipeState
+		admitted, e := command.admit(func() (output.Output, error) {
+			var err error
+			state, err = pipe.ReacquireRadio(command.ctx, command.binding)
+			return out, err
+		})
+		if e != nil {
+			return output.RadioPipeState{}, e
+		}
+		if admitted != out {
+			return output.RadioPipeState{}, fmt.Errorf("radio admitted a different output")
+		}
+		return state, nil
+	default:
+		return output.RadioPipeState{}, fmt.Errorf("unsupported radio operation")
+	}
+}
+func radioOutputSuspended(out output.Output) bool {
+	if out == nil {
+		return false
+	}
+	if p, ok := out.(interface{ RadioSuspended() bool }); ok {
+		return p.RadioSuspended()
+	}
+	return false
+}
+
+// radioPausedPosition runs on the command worker after the real writer joined
+// and paused, while no decoder Read can begin. It never queues another command.
+func (p *Player) radioPausedPosition(ctx context.Context) (*int64, error) {
+	if p.source == nil {
+		return nil, fmt.Errorf("radio paused source unavailable")
+	}
+	lock, ok := p.source.cond.L.(*sync.Mutex)
+	if !ok {
+		return nil, fmt.Errorf("radio source mutex unavailable")
+	}
+	if err := output.LockTransport(ctx, lock); err != nil {
+		return nil, err
+	}
+	defer lock.Unlock()
+	source := p.source.source[p.source.which]
+	if source == nil {
+		return nil, fmt.Errorf("radio paused decoder unavailable")
+	}
+	// Pipe reads now run outside the source mutex. A pending decoder read is
+	// still owned by the parked source; use its last observed position instead
+	// of entering the blocked decoder while handoff holds the worker.
+	position := p.source.lastPosition.Load()
+	if p.source.active.Load() == nil {
+		position = source.PositionMs()
+	}
+	if position < 0 || ctx.Err() != nil {
+		return nil, fmt.Errorf("radio paused position unavailable")
+	}
+	return &position, nil
+}
