+package output
+
+import (
+	"bytes"
+	"context"
+	"errors"
+	"os"
+	"strings"
+	"sync"
+	"syscall"
+	"testing"
+	"time"
+)
+
+func radioPipeBinding(out *pipeOutput) RadioPipeBinding {
+	return RadioPipeBinding{strings.Repeat("a", 32), 11, out.OpenedWriterIdentity()}
+}
+func TestRadioSuspendPreservesActualPausedPCMAndReacquireDoesNotPlay(t *testing.T) {
+	r := &startRead{entered: make(chan struct{})}
+	out, read, _ := startPipeFixture(t, r)
+	payload := []byte{1, 2, 3, 4, 5, 6}
+	out.lock.Lock()
+	out.pendingPCM = append([]byte(nil), payload...)
+	out.lock.Unlock()
+	b := radioPipeBinding(out)
+	state, e := out.SuspendRadio(context.Background(), b)
+	if e != nil || !state.Suspended || !state.WriterClosed || state.PendingBytes != len(payload) {
+		t.Fatal(state, e)
+	}
+	fd := out.openedWriter.FD
+	if fd == "" {
+		t.Fatal("no original descriptor")
+	}
+	if e = out.Resume(); e == nil {
+		t.Fatal("generic resume reclaimed radio hold")
+	}
+	if e = out.Drop(); e == nil {
+		t.Fatal("generic drop changed retained PCM")
+	}
+	ran := false
+	if e = out.WithSourceChange(func(func(bool)) error { ran = true; return nil }); e == nil || ran {
+		t.Fatal("source mutated while suspended")
+	}
+	if e = out.WithSourceReplacement(func(func(bool)) error { ran = true; return nil }); e == nil || ran {
+		t.Fatal("replacement boundary bypassed radio suspension")
+	}
+	if e = out.WithStartLock(context.Background(), func(PipeIdentity, func(bool)) error { ran = true; return nil }); e == nil || ran {
+		t.Fatal("START bypassed radio suspension")
+	}
+	bad := b
+	bad.Token = strings.Repeat("b", 32)
+	if _, e = out.ReacquireRadio(context.Background(), bad); e == nil {
+		t.Fatal("foreign ticket opened FIFO")
+	}
+	state, e = out.ReacquireRadio(context.Background(), b)
+	if e != nil || !state.Suspended || state.WriterClosed || state.PendingBytes != len(payload) {
+		t.Fatal(state, e)
+	}
+	got := make([]byte, len(payload))
+	if _, e = syscall.Read(int(read.Fd()), got); e != syscall.EAGAIN {
+		t.Fatal("reacquire emitted PCM without explicit resume", e, got)
+	}
+	if e = out.Resume(); e == nil {
+		t.Fatal("reopened writer resumed before C confirmation")
+	}
+	if _, e = out.CompleteRadioReacquire(context.Background(), b); e != nil {
+		t.Fatal(e)
+	}
+	if e = out.Resume(); e != nil {
+		t.Fatal(e)
+	}
+	deadline := time.Now().Add(time.Second)
+	var n int
+	for time.Now().Before(deadline) {
+		n, e = syscall.Read(int(read.Fd()), got)
+		if n > 0 {
+			break
+		}
+		if e != syscall.EAGAIN {
+			t.Fatal(e)
+		}
+		time.Sleep(time.Millisecond)
+	}
+	if n != len(payload) || !bytes.Equal(got, payload) {
+		t.Fatal("retained PCM changed", n, e, got)
+	}
+}
+func TestRadioSuspendRejectsCurrentPlayingWriterAndWrongIdentity(t *testing.T) {
+	out, _, _ := startPipeFixture(t, &startRead{entered: make(chan struct{})})
+	b := radioPipeBinding(out)
+	bad := b
+	bad.Writer.Inode = "999"
+	if _, e := out.SuspendRadio(context.Background(), bad); e == nil {
+		t.Fatal("wrong writer adopted")
+	}
+	out.lock.Lock()
+	out.paused = false
+	out.lock.Unlock()
+	if _, e := out.SuspendRadio(context.Background(), b); e == nil {
+		t.Fatal("unpaused writer suspended")
+	}
+	out.lock.Lock()
+	out.paused = true
+	out.lock.Unlock()
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	if _, e := out.SuspendRadio(ctx, b); !errors.Is(e, context.Canceled) {
+		t.Fatal(e)
+	}
+	s, _ := out.RadioState(context.Background())
+	if s.Suspended || s.WriterClosed {
+		t.Fatal("failed admission affected writer", s)
+	}
+}
+func TestRadioReacquireRefusesReplacedFIFO(t *testing.T) {
+	out, _, path := startPipeFixture(t, &startRead{entered: make(chan struct{})})
+	b := radioPipeBinding(out)
+	if _, e := out.SuspendRadio(context.Background(), b); e != nil {
+		t.Fatal(e)
+	}
+	if e := os.Remove(path); e != nil {
+		t.Fatal(e)
+	}
+	if e := syscall.Mkfifo(path, 0600); e != nil {
+		t.Fatal(e)
+	}
+	read, e := os.OpenFile(path, os.O_RDONLY|syscall.O_NONBLOCK, 0)
+	if e != nil {
+		t.Fatal(e)
+	}
+	defer read.Close()
+	if _, e = out.ReacquireRadio(context.Background(), b); e == nil {
+		t.Fatal("replaced source opened")
+	}
+	s, _ := out.RadioState(context.Background())
+	if !s.Suspended || !s.WriterClosed {
+		t.Fatal("failed reacquire removed custody", s)
+	}
+}
+
+// A57 decoder read no longer holds the writer mutex. Expired operations still
+// do nothing; a fresh exact Pause and read-only inspection must now complete
+// without waiting for or cancelling the retained decoder.
+func TestRadioExpiredPauseCannotMutateButFreshPauseJoinsBlockedReaderPromptly(t *testing.T) {
+	reader := &startRead{entered: make(chan struct{}), release: make(chan struct{})}
+	out, _, _ := startPipeFixture(t, reader)
+	var releaseOnce sync.Once
+	release := func() { releaseOnce.Do(func() { close(reader.release) }) }
+	t.Cleanup(release)
+	b := radioPipeBinding(out)
+	if err := out.Resume(); err != nil {
+		t.Fatal(err)
+	}
+	<-reader.entered
+	expired, expire := context.WithCancel(context.Background())
+	expire()
+	if _, err := out.PauseRadio(expired, b); !errors.Is(err, context.Canceled) {
+		t.Fatal("expired pause admitted", err)
+	}
+	inspect, cancelInspect := context.WithTimeout(context.Background(), 15*time.Millisecond)
+	defer cancelInspect()
+	before, err := out.RadioState(inspect)
+	if err != nil || before.Suspended || before.WriterClosed || before.Binding.Token != "" {
+		t.Fatal("inspection lost original live writer", before, err)
+	}
+	out.lock.Lock()
+	pausedBefore := out.paused
+	out.lock.Unlock()
+	if pausedBefore {
+		t.Fatal("expired pause changed playback")
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), 15*time.Millisecond)
+	defer cancel()
+	if _, err := out.PauseRadio(ctx, b); err != nil {
+		t.Fatal("fresh pause blocked on retained decoder", err)
+	}
+	if err := out.lockRadioControl(context.Background()); err != nil {
+		t.Fatal(err)
+	}
+	paused, suspended, writer := out.paused, out.radioSuspended.Load(), out.OpenedWriterIdentity()
+	out.unlockControl()
+	if !paused || suspended || writer != b.Writer {
+		t.Fatal("pause changed decoder custody", paused, suspended, writer)
+	}
+	select {
+	case <-reader.release:
+		t.Fatal("pause cancelled decoder")
+	default:
+	}
+	release()
+	if reader.reads.Load() == 0 {
+		t.Fatal("actual decoder did not run")
+	}
+}
