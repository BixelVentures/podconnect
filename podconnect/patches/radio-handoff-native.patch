@@ -0,0 +1,289 @@
+package player
+
+import (
+	"context"
+	"errors"
+	"io"
+	"strings"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	librespot "github.com/devgianlu/go-librespot"
+	"github.com/devgianlu/go-librespot/output"
+)
+
+// This crosses the actual command worker and real kernel FIFO. No replacement
+// output or simulated writer is admitted during either suspension phase.
+func TestRadioActualWorkerRetainsSourceAndRequiresConfirmedExplicitPlay(t *testing.T) {
+	var actual output.RadioPipeOutput
+	p, err := NewPlayer(&Options{Log: &librespot.NullLogger{}, AudioBackend: "pipe", AudioOutputPipe: queueFIFO(t), AudioOutputPipeFormat: "s16le", ExternalVolume: true, WithNewOutput: func(create func() (output.Output, error)) (output.Output, error) {
+		out, e := create()
+		if e == nil {
+			actual = out.(output.RadioPipeOutput)
+		}
+		return out, e
+	}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer p.Close()
+	original := &queueEOFSource{identity: 71}
+	if err = p.SetPrimaryStream(original, true, false); err != nil {
+		t.Fatal(err)
+	}
+	writer := actual.(interface {
+		OpenedWriterIdentity() output.MovePipeIdentity
+	}).OpenedWriterIdentity()
+	binding := output.RadioPipeBinding{Token: strings.Repeat("a", 32), Generation: 9, Writer: writer}
+	guardCalls := 0
+	guard := func() error { guardCalls++; return nil }
+	state, err := p.SuspendRadio(context.Background(), binding, guard)
+	if err != nil || !state.Suspended || !state.WriterClosed {
+		t.Fatal(state, err)
+	}
+	// Deliver a real source completion notification after the writer is parked.
+	// The worker must retain it without advancing AppPlayer's queue while radio
+	// owns the receiver; the exact same source resumes only by explicit intent.
+	if event := <-p.Receive(); event.Type != EventTypePause {
+		t.Fatal("initial pause missing", event)
+	}
+	p.source.pendingDone.Add(1)
+	p.source.done <- struct{}{}
+	deadline := time.Now().Add(time.Second)
+	for p.source.pendingDone.Load() != 0 && time.Now().Before(deadline) {
+		if _, e := p.InspectRadio(context.Background()); e != nil {
+			t.Fatal(e)
+		}
+	}
+	if p.source.pendingDone.Load() != 0 {
+		t.Fatal("worker did not join completion")
+	}
+	select {
+	case event := <-p.Receive():
+		t.Fatal("parked source advanced queue", event)
+	default:
+	}
+	if p.ClaimOutputFailure(1, nil) {
+		t.Fatal("parked live writer falsely retired")
+	}
+	if retained, e := p.Start35CurrentSource(context.Background()); e != nil || retained != librespot.AudioSource(original) {
+		t.Fatal("read-only snapshot lost retained source", retained, e)
+	}
+	if err = p.Play(); err == nil {
+		t.Fatal("generic play bypassed receiver custody")
+	}
+	if err = p.SetPrimaryStream(&queueEOFSource{identity: 72}, true, false); err == nil {
+		t.Fatal("source replacement bypassed parked writer")
+	}
+	if err = p.SeekMs(100); err == nil {
+		t.Fatal("seek altered retained source")
+	}
+	denied := errors.New("owner changed")
+	if _, err = p.ReacquireRadio(context.Background(), binding, func() error { return denied }, func(create func() (output.Output, error)) (output.Output, error) {
+		t.Fatal("denied owner reached writer admission")
+		return nil, nil
+	}); !errors.Is(err, denied) {
+		t.Fatal(err)
+	}
+	state, err = p.InspectRadio(context.Background())
+	if err != nil || !state.WriterClosed {
+		t.Fatal("denied admission opened FIFO", state, err)
+	}
+	state, err = p.ReacquireRadio(context.Background(), binding, guard, func(create func() (output.Output, error)) (output.Output, error) { return create() })
+	if err != nil || !state.Suspended || state.WriterClosed {
+		t.Fatal(state, err)
+	}
+	if err = p.Play(); err == nil {
+		t.Fatal("reopened writer played before actual C barrier")
+	}
+	if _, err = p.CompleteRadioReacquire(context.Background(), binding, guard); err != nil {
+		t.Fatal(err)
+	}
+	// Inspect the source under the same lock used by its actual reader.
+	p.source.cond.L.Lock()
+	retained := p.source.source[p.source.which] == librespot.AudioSource(original)
+	p.source.cond.L.Unlock()
+	if !retained || guardCalls != 3 {
+		t.Fatal("retained decoder or admissions changed", retained, guardCalls)
+	}
+	// Completion alone leaves the output paused. Only this explicit command plays.
+	select {
+	case event := <-p.Receive():
+		t.Fatal("reacquire emitted playback event", event)
+	default:
+	}
+	if err = p.Play(); err != nil {
+		t.Fatal(err)
+	}
+	if event := <-p.Receive(); event.Type != EventTypeResume {
+		t.Fatal("explicit resume event missing", event)
+	}
+	if event := <-p.Receive(); event.Type != EventTypeNotPlaying {
+		t.Fatal("retained completion missing", event)
+	}
+}
+
+func TestRadioCompletionReceiptsKeepActualDecoderAcrossQueuedSourceReplacement(t *testing.T) {
+	source := NewSwitchingAudioSource()
+	first, second, replacement := &queueEOFSource{identity: 1}, &queueEOFSource{identity: 2}, &queueEOFSource{identity: 3}
+	source.SetPrimary(first)
+	source.SetSecondary(second)
+	samples := make([]float32, 4)
+	_, _ = source.Read(samples)
+	_, _ = source.Read(samples)
+	// A command can replace primary before the player selects its coalesced Done.
+	// EOF receipts must still identify the actual exhausted decoders in order.
+	source.SetPrimary(replacement)
+	receipts := source.TakeDoneReceipts()
+	if len(receipts) != 2 || receipts[0] != librespot.AudioSource(first) || receipts[1] != librespot.AudioSource(second) {
+		t.Fatal("completion identities followed replacement", receipts)
+	}
+	if n := source.TakeDone(); n != 0 {
+		t.Fatal("completion consumed twice", n)
+	}
+}
+
+type radioBlockedDecoder struct {
+	entered       chan struct{}
+	release       chan struct{}
+	positionCalls atomic.Int64
+}
+
+func (s *radioBlockedDecoder) Read(samples []float32) (int, error) {
+	select {
+	case <-s.entered:
+	default:
+		close(s.entered)
+	}
+	<-s.release
+	return 0, io.EOF
+}
+func (s *radioBlockedDecoder) PositionMs() int64       { s.positionCalls.Add(1); return 7 }
+func (*radioBlockedDecoder) SetPositionMs(int64) error { return nil }
+
+func TestRadioActualWorkerPausesBlockedReadWithCachedPositionAndRetainedDecoder(t *testing.T) {
+	var actual output.Output
+	decoder := &radioBlockedDecoder{entered: make(chan struct{}), release: make(chan struct{})}
+	p, err := NewPlayer(&Options{Log: &librespot.NullLogger{}, AudioBackend: "pipe", AudioOutputPipe: queueFIFO(t), AudioOutputPipeFormat: "s16le", ExternalVolume: true, WithNewOutput: func(create func() (output.Output, error)) (output.Output, error) {
+		out, e := create()
+		actual = out
+		return out, e
+	}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer p.Close()
+	defer close(decoder.release)
+	if err = p.SetPrimaryStream(decoder, false, false); err != nil {
+		t.Fatal(err)
+	}
+	<-decoder.entered
+	binding := output.RadioPipeBinding{Token: strings.Repeat("a", 32), Generation: 10, Writer: actual.(interface {
+		OpenedWriterIdentity() output.MovePipeIdentity
+	}).OpenedWriterIdentity()}
+	ctx, cancel := context.WithTimeout(context.Background(), 15*time.Millisecond)
+	defer cancel()
+	positionCalls := decoder.positionCalls.Load()
+	state, err := p.PauseRadio(ctx, binding, func() error { return nil })
+	if err != nil || state.PositionMS == nil || *state.PositionMS != 7 || state.Suspended || state.WriterClosed {
+		t.Fatal("blocked read pause lost retained writer or observed position", state, err)
+	}
+	if decoder.positionCalls.Load() != positionCalls {
+		t.Fatal("pause entered the blocked decoder instead of cached observed position")
+	}
+	// The57 async reader no longer owns the writer mutex. Pause must acknowledge
+	// promptly without cancelling/closing that retained decoder, and the actual
+	// worker must remain available for subsequent owner checks.
+	joined := make(chan bool, 1)
+	go func() { joined <- p.ClaimOutputFailure(1, nil) }()
+	select {
+	case claimed := <-joined:
+		if claimed {
+			t.Fatal("live writer falsely retired")
+		}
+	case <-time.After(time.Second):
+		t.Fatal("paused blocked decoder stranded player command loop")
+	}
+	select {
+	case <-decoder.release:
+		t.Fatal("handoff cancelled retained decoder")
+	default:
+	}
+}
+
+type radioPositionDecoder struct{ position int64 }
+
+func (*radioPositionDecoder) Read([]float32) (int, error)   { return 0, io.EOF }
+func (s *radioPositionDecoder) PositionMs() int64           { return s.position }
+func (s *radioPositionDecoder) SetPositionMs(v int64) error { s.position = v; return nil }
+func TestRadioPauseReturnsActualBoundedWorkerPositionWithoutSecondCommand(t *testing.T) {
+	var actual output.Output
+	p, err := NewPlayer(&Options{Log: &librespot.NullLogger{}, AudioBackend: "pipe", AudioOutputPipe: queueFIFO(t), AudioOutputPipeFormat: "s16le", ExternalVolume: true, WithNewOutput: func(create func() (output.Output, error)) (output.Output, error) {
+		out, e := create()
+		actual = out
+		return out, e
+	}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer p.Close()
+	decoder := &radioPositionDecoder{position: 12345}
+	if err = p.SetPrimaryStream(decoder, true, false); err != nil {
+		t.Fatal(err)
+	}
+	binding := output.RadioPipeBinding{Token: strings.Repeat("a", 32), Generation: 11, Writer: actual.(interface {
+		OpenedWriterIdentity() output.MovePipeIdentity
+	}).OpenedWriterIdentity()}
+	state, err := p.PauseRadio(context.Background(), binding, func() error { return nil })
+	if err != nil || state.PositionMS == nil || *state.PositionMS != 12345 {
+		t.Fatal("actual paused decoder position lost", state, err)
+	}
+	// The position receipt precedes publication of the Pause event, so callers
+	// never need an extra command while the worker waits for its event consumer.
+	if decoder.position != 12345 {
+		t.Fatal("pause sought retained decoder")
+	}
+}
+
+func TestRadioDeferredEOFReceiptsKeepDecoderIdentityAfterAsyncEmission(t *testing.T) {
+	source := NewSwitchingAudioSource()
+	source.asyncRead = true
+	first, second, replacement := &queueEOFSource{identity: 101}, &queueEOFSource{identity: 102}, &queueEOFSource{identity: 103}
+	source.SetPrimary(first)
+	source.SetSecondary(second)
+	samples := make([]float32, 4)
+	_, _ = source.Read(samples)
+	if len(source.TakeDoneReceipts()) != 0 {
+		t.Fatal("EOF published before retained PCM emission")
+	}
+	if !source.ResolveDeferredEOF() {
+		t.Fatal("first EOF did not advance actual successor")
+	}
+	_, _ = source.Read(samples)
+	if source.ResolveDeferredEOF() {
+		t.Fatal("last EOF invented successor")
+	}
+	source.SetPrimary(replacement)
+	receipts := source.TakeDoneReceipts()
+	if len(receipts) != 2 || receipts[0] != librespot.AudioSource(first) || receipts[1] != librespot.AudioSource(second) {
+		t.Fatal("deferred completions lost actual decoder identity", receipts)
+	}
+	if len(source.TakeDoneReceipts()) != 0 || source.ResolveDeferredEOF() {
+		t.Fatal("completion replayed")
+	}
+}
+func TestRadioDeferredEOFOfReplacedLeaseCannotAdvanceOrPublish(t *testing.T) {
+	source := NewSwitchingAudioSource()
+	source.asyncRead = true
+	first, second := &queueEOFSource{identity: 201}, &queueEOFSource{identity: 202}
+	source.SetPrimary(first)
+	_, _ = source.Read(make([]float32, 4))
+	source.SetPrimary(second)
+	if source.ResolveDeferredEOF() || len(source.TakeDoneReceipts()) != 0 {
+		t.Fatal("old EOF changed replacement")
+	}
+	if !source.IsCurrent(second) {
+		t.Fatal("replacement lost")
+	}
+}
