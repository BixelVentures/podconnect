@@ -0,0 +1,60 @@
+package daemon
+
+import (
+	"context"
+	librespot "github.com/devgianlu/go-librespot"
+	"github.com/devgianlu/go-librespot/output"
+	"github.com/devgianlu/go-librespot/player"
+	"github.com/devgianlu/go-librespot/session"
+	"strconv"
+	"time"
+)
+
+// A one-use actual C open receipt permits continuing the exact retained FIFO
+// suffix. It is never an authority to choose new content or a different room.
+type radioResumeMarker struct {
+	Live    bool
+	Primary *player.Stream
+	Source  librespot.AudioSource
+	Player  *player.Player
+	Session *session.Session
+	Owner   roomTransportIdentity
+	Writer  queueWriterWire
+}
+
+func (p *AppPlayer) consumeRadioResume(ctx context.Context) (bool, bool, error) {
+	marker := p.radioResume
+	p.radioResume = nil
+	if marker == nil {
+		return false, false, nil
+	}
+	if p.primaryStream != marker.Primary || p.primaryStream == nil || p.primaryStream.Source != marker.Source || p.player != marker.Player || p.sess != marker.Session {
+		return false, false, nil
+	}
+	ctx, cancel := context.WithTimeout(ctx, 3*time.Second)
+	defer cancel()
+	expected := output.MovePipeIdentity{PipeIdentity: marker.Writer.Pipe, FD: marker.Writer.FD}
+	writer, epoch, err := p.player.RoomMove(ctx, "verify", marker.Source, expected, marker.Writer.Epoch, marker.Live, func(mutate func()) error {
+		p.aliasMu.Lock()
+		defer p.aliasMu.Unlock()
+		account, bound := p.sess.BoundUsername()
+		if !bound || account != marker.Owner.AccountUserID || p.state == nil || p.state.player == nil || p.state.player.IsPaused == marker.Live || p.spotConnId != marker.Owner.ConnectionID || p.state.player.SessionId != marker.Owner.SessionID || p.aliasIncarnation != marker.Owner.AliasIncarnation || p.aliasFingerprint != marker.Owner.AliasRegistry || p.aliasRevision != marker.Owner.AliasRevision || p.primaryStream != marker.Primary || p.primaryStream.Source != marker.Source {
+			return ErrAliasConflict
+		}
+		binding := p.aliasBindingLocked()
+		if binding == nil || !binding.Ready || binding.RoomID != marker.Owner.RoomID {
+			return ErrAliasConflict
+		}
+		p.app.moveCustodyMu.Lock()
+		defer p.app.moveCustodyMu.Unlock()
+		if p.app.openedWriterOwner != p || p.app.openedWriter != expected || strconv.FormatUint(p.app.openedWriterGeneration, 10) != marker.Writer.Generation {
+			return ErrAliasConflict
+		}
+		mutate()
+		return nil
+	})
+	if err != nil || writer != expected || epoch != marker.Writer.Epoch {
+		return false, false, ErrAliasConflict
+	}
+	return true, marker.Live, nil
+}
