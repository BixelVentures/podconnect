@@ -0,0 +1,48 @@
+package daemon
+
+// An operation rejection is deliberately not a source-hold receipt. It grants
+// no sender, target, cancellation, resume or physical-observation authority.
+type radioRejection struct {
+	Request        radioRequest `json:"request"`
+	Schema         string       `json:"schema"`
+	Rejected       bool         `json:"operation_rejected"`
+	EffectsStarted bool         `json:"effects_started"`
+	Terminal       bool         `json:"terminal"`
+	Reason         string       `json:"reason"`
+}
+
+func radioRejectionKey(r radioRequest) string { return contentDigest(r) }
+func (r radioRejection) wire() any {
+	return struct {
+		Schema           string    `json:"schema"`
+		ProcessID        string    `json:"process_id"`
+		TargetID         string    `json:"target_id"`
+		HandoffID        string    `json:"handoff_id"`
+		Generation       string    `json:"generation"`
+		ActionID         string    `json:"action_id"`
+		Peer             radioPeer `json:"sender_peer"`
+		ExpectedRevision string    `json:"expected_native_revision"`
+		Rejected         bool      `json:"operation_rejected"`
+		EffectsStarted   bool      `json:"effects_started"`
+		Terminal         bool      `json:"terminal"`
+		Reason           string    `json:"reason"`
+	}{r.Schema, r.Request.ProcessID, r.Request.TargetID, r.Request.HandoffID, r.Request.Generation, r.Request.ActionID, r.Request.Peer, r.Request.ExpectedRevision, r.Rejected, r.EffectsStarted, r.Terminal, r.Reason}
+}
+func (app *App) rejectStaleRadioLocked(r radioRequest) (any, error) {
+	if app.radio.Rejected == nil {
+		app.radio.Rejected = map[string]radioRejection{}
+	}
+	key := radioRejectionKey(r)
+	if prior, ok := app.radio.Rejected[key]; ok && prior.Request == r {
+		return prior.wire(), nil
+	}
+	if len(app.radio.Rejected) >= 128 {
+		return nil, ErrAliasConflict
+	}
+	rejected := radioRejection{Request: r, Schema: "podconnect.native_radio_handoff_rejected.v1", Rejected: true, EffectsStarted: false, Terminal: true, Reason: "stale_intent"}
+	app.radio.Rejected[key] = rejected
+	if err := app.persistRadioLocked(); err != nil {
+		return nil, err
+	}
+	return rejected.wire(), nil
+}
