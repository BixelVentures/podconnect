+
+func (p *AppPlayer) captureRadioSourceMove(ctx context.Context, c *contentCapture) (*moveCapture, *radioSourceMoveStage, error) {
+	if p == nil || p.app == nil || c == nil || c.Player != p.player || c.Session != p.sess || c.Primary == nil || c.Source == nil || c.OldOwner == nil || c.State == nil || c.PlayerState == nil || c.State.tracks == nil {
+		return nil, nil, ErrAliasConflict
+	}
+	app := p.app
+	app.radio.mu.Lock()
+	var hold *radioHold
+	for _, h := range app.radio.Holds {
+		if h.SourceMove != nil && h.SourceMovePhase != "opened" {
+			app.radio.mu.Unlock()
+			return nil, nil, ErrAliasConflict
+		}
+		if h.owner == p && h.Absence == nil && h.WriterParked && h.RequiresPause && h.Phase == "suspended" {
+			if hold != nil {
+				app.radio.mu.Unlock()
+				return nil, nil, ErrAliasConflict
+			}
+			hold = h
+		}
+	}
+	if hold == nil || app.radio.failed || app.radio.Holds[c.Scope.RoomID] != nil || hold.Request.TargetID == c.Scope.RoomID || hold.Proof.Owner != *c.OldOwner || hold.PausedBefore == nil || hold.primary != c.Primary {
+		app.radio.mu.Unlock()
+		return nil, nil, ErrAliasConflict
+	}
+	stage := &radioSourceMoveStage{hold: hold, HoldTarget: hold.Request.TargetID, ProcessID: hold.Request.ProcessID, HandoffID: hold.Request.HandoffID, Generation: hold.Request.Generation, Token: hold.Proof.Token, ClaimIntent: app.radio.Intent, RestorePaused: *hold.PausedBefore}
+	app.radio.mu.Unlock()
+	actual, err := p.player.Start35CurrentSource(ctx)
+	if err != nil || actual != c.Source {
+		return nil, nil, ErrAliasConflict
+	}
+	state, err := p.player.InspectRadio(ctx)
+	generation, genErr := strconv.ParseUint(hold.Request.Generation, 10, 64)
+	binding := output.RadioPipeBinding{Token: hold.Proof.Token, Generation: generation, Writer: output.MovePipeIdentity{PipeIdentity: hold.Proof.Writer.Pipe, FD: hold.Proof.Writer.FD}}
+	if err != nil || genErr != nil || !state.Suspended || !state.WriterClosed || state.Binding != binding || !c.PlayerState.IsPaused || !c.PlayerState.IsPlaying || !c.State.active {
+		return nil, nil, ErrAliasConflict
+	}
+	percent := int(math.Round(float64(c.State.device.Volume) * 100 / float64(player.MaxStateVolume)))
+	stage.State = radioSourceMoveState{c.Process, *c.OldOwner, c.Incarnation, c.Pipe, c.PipeDigest, hold.Proof.Writer.Epoch, strconv.FormatUint(c.State.tracks.TransportRevision(), 10), percent}
+	request := struct {
+		Schema string               `json:"schema"`
+		Hold   radioCBinding        `json:"hold"`
+		State  radioSourceMoveState `json:"source_state"`
+		Target string               `json:"target_id"`
+	}{"podconnect.output_radio_source_move_observation.v1", hold.Proof, stage.State, c.Scope.HomePodID}
+	endpoint := strings.TrimSuffix(c.OwnTone, "/") + "/api/outputs/" + hold.Proof.Output.DeviceID + "/radio-handoff/source-move-state"
+	var observed radioSourceMoveObservation
+	if radioControlHTTP(ctx, http.MethodPost, endpoint, app.cfg.RadioHandoffControlToken, request, &observed) != nil || observed.Schema != request.Schema || !observed.OK || observed.Purpose != "radio_source_move_v1" || observed.Physical || observed.Hold != hold.Proof || observed.State != stage.State || observed.Target.DeviceID != c.Scope.HomePodID || observed.Target.Process != hold.Proof.Output.Process || !volumeCounter(observed.Target.Incarnation) || observed.Target.Incarnation == "0" || !volumeCounter(observed.TargetBaseRevision) || !observed.Source.valid() || observed.Source.Process != hold.Proof.Output.Process || observed.Source.InputPathDigest != c.PipeDigest || !volumeHex64.MatchString(observed.Peer) || observed.Peer == hold.Proof.Digest {
+		return nil, nil, ErrAliasConflict
+	}
+	stage.Observation = observed
+	capture := &moveCapture{contentCapture: c, Tracks: c.State.tracks, QueueRevision: c.State.tracks.TransportRevision(), Paused: c.PlayerState.IsPaused, StateVolume: c.State.device.Volume, SourceMove: stage}
+	return capture, stage, nil
+}
+
+// Called with aliasMu held: metadata checks only, no worker wait or effects.
+func (p *AppPlayer) radioSourceMoveCurrentLocked(c *moveCapture) bool {
+	if c == nil || c.SourceMove == nil || c.OldOwner == nil || p.app == nil {
+		return false
+	}
+	s := c.SourceMove
+	if p.player != c.Player || p.sess != c.Session || p.primaryStream != c.Primary || p.primaryStream == nil || p.primaryStream.Source != c.Source || p.state != c.State || p.state.player != c.PlayerState || !p.state.active || !p.state.player.IsPlaying || p.state.player.IsPaused != c.Paused || p.state.device.Volume != c.StateVolume || p.state.tracks != c.Tracks || c.Tracks.TransportRevision() != c.QueueRevision || p.aliasRetired || p.roomVolumeClosing || p.aliasRevision != c.AliasRevision || p.aliasFingerprint != c.Registry || p.aliasIncarnation != c.AliasIncarnation || p.spotConnId != c.Connection || p.state.player.SessionId != c.SessionID {
+		return false
+	}
+	p.app.radio.mu.Lock()
+	defer p.app.radio.mu.Unlock()
+	h := p.app.radio.Holds[s.HoldTarget]
+	for _, pending := range p.app.radio.Holds {
+		if pending.SourceMove != nil && pending.SourceMovePhase != "opened" && (pending != h || s.OfferID == "" || pending.SourceMove.Future.OfferID != s.OfferID) {
+			return false
+		}
+	}
+	return !p.app.radio.failed && h == s.hold && h != nil && h.Absence == nil && h.owner == p && h.Phase == "suspended" && h.WriterParked && h.PausedBefore != nil && *h.PausedBefore == s.RestorePaused && h.primary == c.Primary && h.Proof.Token == s.Token && h.Request.ProcessID == s.ProcessID && h.Request.HandoffID == s.HandoffID && h.Request.Generation == s.Generation && p.app.radio.Holds[c.Scope.RoomID] == nil
+}
+func (p *AppPlayer) radioSourceMoveOfferState(c *moveCapture) (contentTarget, int, string, error) {
+	if c == nil || c.SourceMove == nil {
+		return contentTarget{}, 0, "", ErrAliasConflict
+	}
+	// Canonical offerMove already holds aliasMu.
+	if !p.radioSourceMoveCurrentLocked(c) {
+		return contentTarget{}, 0, "", ErrAliasConflict
+	}
+	s := c.SourceMove
+	return s.Observation.Target, s.State.Volume, contentDigest(s.Observation), nil
+}
+func (p *AppPlayer) radioSourceMoveCall(ctx context.Context, h *radioHold, r radioSourceMoveRequest) (radioSourceMoveReceipt, error) {
+	var out radioSourceMoveReceipt
+	endpoint := strings.TrimSuffix(p.app.cfg.RoomTransportOwnToneURL, "/") + "/api/outputs/" + h.Proof.Output.DeviceID + "/radio-handoff/source-move"
+	if err := radioControlHTTP(ctx, http.MethodPost, endpoint, p.app.cfg.RadioHandoffControlToken, r, &out); err != nil {
+		return out, err
+	}
+	a := out.Receiver
+	if out.Schema != r.Schema || !out.OK || out.Purpose != "radio_source_move_v1" || out.Physical || out.Hold != r.Hold || out.Future != r.Future || out.Expected != r.Expected || out.IntentID != r.IntentID || !volumeHex32.MatchString(out.Token) || r.Token != "" && out.Token != r.Token || a.Schema != "podconnect.output_radio_other_target.v1" || !a.OK || a.Purpose != "radio_other_target_v1" || a.Physical || a.Token != out.Token || a.IntentID != r.IntentID || a.Revision != r.Future.Revision || a.Owner != r.Future.Owner || a.Intended != r.Future.Intended || a.Phase != out.Phase || !volumeCounter(a.Generation) || a.Generation == "0" || !volumeHex64.MatchString(a.Peer) || a.Peer == r.Hold.Digest || !a.Source.valid() || a.Source.Process != r.Hold.Output.Process || a.Source.InputPathDigest != r.Future.PathDigest || a.Source.InputGeneration != r.Expected.Source.InputGeneration || a.Source.InputItemID != r.Expected.Source.InputItemID {
+		return out, ErrAliasConflict
+	}
+	return out, nil
+}
+
+func (op *moveOperation) commitRadioSourceMove(ctx context.Context, server *ConcreteApiServer) error {
+	_, err := server.roomTransportAsk(ctx, apiRadioSourceMoveCommit, moveActorRequest{Operation: op, Context: ctx})
+	if err != nil {
+		op.mu.Lock()
+		possible := op.RadioPossible
+		completed := op.Terminal && op.State == "complete"
+		op.mu.Unlock()
+		if completed {
+			return nil
+		}
+		if possible {
+			op.unknownRadioSourceMove()
+			op.finish("unknown")
+		} else {
+			op.finish("rejected")
+		}
+	}
+	return err
+}
+func (op *moveOperation) unknownRadioSourceMove() {
+	if op == nil || op.Owner == nil || op.SourceMove == nil {
+		return
+	}
+	op.mu.Lock()
+	possible := op.RadioPossible
+	completed := op.Terminal && op.State == "complete"
+	reopening := op.SourceMove.reopening
+	op.mu.Unlock()
+	if !possible || completed {
+		return
+	}
+	app := op.Owner.app
+	s := op.SourceMove
+	app.radio.mu.Lock()
+	defer app.radio.mu.Unlock()
+	h := app.radio.Holds[s.HoldTarget]
+	if h != s.hold {
+		return
+	}
+	h.SourceMovePhase = "unknown"
+	h.PauseUncertain = reopening
+	if reopening {
+		h.WriterParked = false
+	}
+	_ = app.persistRadioLocked()
+}
+
+// This runs on the actual AppPlayer owner, after the original one-use MOVE
+// claim. There is no secondary offer, URI load, Seek, or Native intent.
+func (p *AppPlayer) radioSourceMoveCommit(parent context.Context, call moveActorRequest) (any, error) {
+	op := call.Operation
+	if op == nil || op.Owner != p || op.SourceMove == nil || op.Capture == nil {
+		return nil, ErrAliasConflict
+	}
+	callCtx, stopCall := queueOperationContext(parent, call.Context)
+	defer stopCall()
+	ctx, cancel := context.WithTimeout(callCtx, 8*time.Second)
+	defer cancel()
+	p.aliasMu.Lock()
+	op.mu.Lock()
+	claimErr := p.validateRadioSourceMoveClaimLocked(op, ctx)
+	s := op.SourceMove
+	if s.OfferID == "" {
+		s.OfferID = op.Offer.OfferID
+	}
+	if s.OfferID != op.Offer.OfferID {
+		op.mu.Unlock()
+		p.aliasMu.Unlock()
+		return nil, ErrAliasConflict
+	}
+	c := op.Capture
+	future := radioSourceMoveFuture{s.State, op.Offer.OfferID, op.Offer.BindingID, op.Revision, movePolicy, op.Intended}
+	op.mu.Unlock()
+	p.aliasMu.Unlock()
+	if claimErr != nil {
+		return nil, claimErr
+	}
+	actual, err := p.player.Start35CurrentSource(ctx)
+	if err != nil || actual != c.Source {
+		return nil, ErrAliasConflict
+	}
+	state, err := p.player.InspectRadio(ctx)
+	generation, parseErr := strconv.ParseUint(s.Generation, 10, 64)
+	binding := output.RadioPipeBinding{Token: s.Token, Generation: generation, Writer: output.MovePipeIdentity{PipeIdentity: s.hold.Proof.Writer.Pipe, FD: s.hold.Proof.Writer.FD}}
+	if err != nil || parseErr != nil || !state.Suspended || !state.WriterClosed || state.Binding != binding {
+		return nil, ErrAliasConflict
+	}
+	intent, err := randomQueueID(16)
+	if err != nil {
+		return nil, err
+	}
+	intent = intent[:8] + "-" + intent[8:12] + "-" + intent[12:16] + "-" + intent[16:20] + "-" + intent[20:]
+	request := radioSourceMoveRequest{Schema: "podconnect.output_radio_source_move.v1", Phase: "prepare", Hold: s.hold.Proof, Future: future, IntentID: intent, Expected: radioSourceMoveExpected{s.Observation.Source, s.Observation.Target, s.Observation.TargetBaseRevision, s.Observation.Peer}}
+	app := p.app
+	h := s.hold
+	persist := func(phase string, receipt *radioSourceMoveReceipt) error {
+		app.radio.mu.Lock()
+		if app.radio.failed || app.radio.Holds[s.HoldTarget] != h || h.Phase != "suspended" || app.radio.Intent != s.ClaimIntent || h.Proof.Token != s.Token || app.radio.Holds[c.Scope.RoomID] != nil {
+			app.radio.mu.Unlock()
+			return ErrAliasConflict
+		}
+		copy := request
+		if request.Writer != nil {
+			w := *request.Writer
+			copy.Writer = &w
+		}
+		h.SourceMove = &copy
+		h.SourceMovePhase = phase
+		if receipt != nil {
+			copy := *receipt
+			h.SourceMoveLatest = &copy
+		}
+		err := app.persistRadioLocked()
+		app.radio.mu.Unlock()
+		if err == nil && receipt != nil {
+			copy := *receipt
+			op.mu.Lock()
+			op.SourceMoveReceipt = &copy
+			op.mu.Unlock()
+		}
+		return err
+	}
+	if err = persist("prepare_pending", nil); err != nil {
+		return nil, err
+	}
+	op.mu.Lock()
+	op.RadioPossible = true
+	op.mu.Unlock()
+	fail := func(err error) (any, error) { op.unknownRadioSourceMove(); return nil, err }
+	ack, err := p.radioSourceMoveCall(ctx, h, request)
+	if err != nil || ack.Phase != "prepared" {
+		return fail(ErrAliasConflict)
+	}
+	request.Token = ack.Token
+	if err = persist("prepared", &ack); err != nil {
+		return fail(err)
+	}
+	request.Phase = "commit"
+	if err = persist("commit_pending", &ack); err != nil {
+		return fail(err)
+	}
+	ack, err = p.radioSourceMoveCall(ctx, h, request)
+	if err != nil {
+		return fail(err)
+	}
+	for ack.Phase == "connecting" {
+		select {
+		case <-ctx.Done():
+			return fail(ctx.Err())
+		case <-time.After(25 * time.Millisecond):
+		}
+		query := request
+		query.Phase = "state"
+		ack, err = p.radioSourceMoveCall(ctx, h, query)
+		if err != nil {
+			return fail(err)
+		}
+	}
+	if ack.Phase != "route_ready" {
+		return fail(ErrAliasConflict)
+	}
+	if err = persist("route_ready", &ack); err != nil {
+		return fail(err)
+	}
+	guard := func() error {
+		if ctx.Err() != nil {
+			return ctx.Err()
+		}
+		p.aliasMu.Lock()
+		defer p.aliasMu.Unlock()
+		op.mu.Lock()
+		defer op.mu.Unlock()
+		if !p.radioSourceMoveClaimCurrentLocked(op, ctx) {
+			return ErrAliasConflict
+		}
+		return nil
+	}
+	if err = persist("writer_reopen_pending", &ack); err != nil {
+		return fail(err)
+	}
+	op.mu.Lock()
+	s.reopening = true
+	op.mu.Unlock()
+	_, err = p.player.ReacquireRadio(ctx, binding, guard, func(create func() (output.Output, error)) (output.Output, error) {
+		app.moveCustodyMu.Lock()
+		defer app.moveCustodyMu.Unlock()
+		if app.openedWriterOwner != p {
+			return nil, ErrAliasConflict
+		}
+		return app.openRegisteredOutputLocked(p, create)
+	})
+	if err != nil {
+		return fail(err)
+	}
+	app.moveCustodyMu.Lock()
+	writer, wg, wo := app.openedWriter, app.openedWriterGeneration, app.openedWriterOwner
+	app.moveCustodyMu.Unlock()
+	process, known := nativeContentProcess()
+	if !known || process != future.Process || wg == 0 || wo != p || writer.Type != "fifo" {
+		return fail(ErrAliasConflict)
+	}
+	fresh := queueWriterWire{process, writer.FD, writer.PipeIdentity, future.Epoch, strconv.FormatUint(wg, 10), future.PathDigest}
+	request.Writer = &fresh
+	request.Phase = "barrier"
+	if err = persist("barrier_pending", &ack); err != nil {
+		return fail(err)
+	}
+	ack, err = p.radioSourceMoveCall(ctx, h, request)
+	if err != nil || ack.Phase != "barrier_ready" || !ack.Receiver.Barrier || ack.Receiver.Writer == nil || *ack.Receiver.Writer != fresh {
+		return fail(ErrAliasConflict)
+	}
+	request.Phase = "open"
+	if err = persist("open_pending", &ack); err != nil {
+		return fail(err)
+	}
+	ack, err = p.radioSourceMoveCall(ctx, h, request)
+	if err != nil || ack.Phase != "opened" || !ack.Receiver.Barrier || ack.Receiver.Writer == nil || *ack.Receiver.Writer != fresh || ack.Receiver.Route == nil || !ack.Receiver.Route.valid() || ack.Receiver.Route.DeviceID != future.Intended.HomePodID {
+		return fail(ErrAliasConflict)
+	}
+	if err = persist("opened", &ack); err != nil {
+		return fail(err)
+	}
+	if _, err = p.player.CompleteRadioReacquire(ctx, binding, guard); err != nil {
+		return fail(err)
+	}
+	if err = p.adoptRadioIntendedOwner(future.Owner, future.Intended); err != nil {
+		return fail(err)
+	}
+	inner := radioOtherRequest{Schema: "podconnect.output_radio_other_target.v1", Phase: "open", Hold: request.Hold, IntentID: request.IntentID, Revision: future.Revision, Owner: future.Owner, Intended: future.Intended, Token: request.Token, Source: &ack.Receiver.Source, Writer: &fresh}
+	// This provenance is from the actual composed receiver producer, not a
+	// fabricated normal MOVE receipt with a nonexistent old receiver route.
+	app.moveCustodyMu.Lock()
+	app.radioReacquiredWriter = nil
+	app.radioParkedWriter = nil
+	app.radioOtherWriter = &radioOtherWriter{Owner: p, Player: p.player, Session: p.sess, Identity: future.Intended, Writer: writer, Epoch: fresh.Epoch, Process: process, Generation: wg, Grant: inner, StartAt: app.startCustody, MoveAt: app.moveCustody}
+	app.moveCustodyMu.Unlock()
+	complete := func(mutate func()) error {
+		p.aliasMu.Lock()
+		defer p.aliasMu.Unlock()
+		op.mu.Lock()
+		defer op.mu.Unlock()
+		if ctx.Err() != nil || op.Cancelled || op.Terminal || op.Owner != p || op.SourceMove != s || op.SourceMoveReceipt == nil || op.SourceMoveReceipt.Phase != "opened" || p.player != c.Player || p.sess != c.Session || p.primaryStream != c.Primary || p.primaryStream.Source != c.Source || p.state != c.State || p.state.player != c.PlayerState || p.state.tracks != c.Tracks || c.Tracks.TransportRevision() != c.QueueRevision || p.roomNativeIntent != c.Intent || p.state.device.Volume != c.StateVolume || p.aliasRetired || p.roomVolumeClosing || p.aliasRevision != future.Intended.AliasRevision || p.aliasFingerprint != future.Intended.AliasRegistry || p.spotConnId != future.Intended.ConnectionID || p.state.player.SessionId != future.Intended.SessionID {
+			return ErrAliasConflict
+		}
+		app.moveCustodyMu.Lock()
+		registered := app.openedWriterOwner == p && app.openedWriter == writer && app.openedWriterGeneration == wg
+		app.moveCustodyMu.Unlock()
+		if !registered {
+			return ErrAliasConflict
+		}
+		app.radio.mu.Lock()
+		if app.radio.Holds[s.HoldTarget] != h || h.Proof.Token != s.Token || h.Phase != "suspended" || app.radio.Intent != s.ClaimIntent || app.radio.Holds[c.Scope.RoomID] != nil || h.PausedBefore == nil || *h.PausedBefore != s.RestorePaused {
+			app.radio.mu.Unlock()
+			return ErrAliasConflict
+		}
+		h.OtherGrant = &inner
+		h.OtherGrantPhase = "opened"
+		h.WriterParked = false
+		h.PauseUncertain = false
+		err := app.persistRadioLocked()
+		app.radio.mu.Unlock()
+		if err != nil {
+			return err
+		}
+		if ctx.Err() != nil {
+			return ctx.Err()
+		}
+		mutate()
+		p.state.setPaused(s.RestorePaused)
+		p.state.player.Timestamp = time.Now().UnixMilli()
+		actual := future.Intended
+		op.Actual = &actual
+		op.Switched = true
+		op.Pipe = writer
+		op.Epoch = fresh.Epoch
+		op.State = "complete"
+		op.Terminal = true
+		op.RetainUntil = time.Now().Add(time.Minute)
+		if op.TerminalSignal != nil {
+			close(op.TerminalSignal)
+		}
+		return nil
+	}
+	if s.RestorePaused {
+		_, _, err = p.player.RoomMove(ctx, "inspect", c.Source, output.MovePipeIdentity{}, "", false, complete)
+	} else {
+		err = p.player.GuardedQueueTransport(ctx, nil, c.Source, writer, fresh.Epoch, complete)
+	}
+	if err != nil {
+		return fail(err)
+	}
+	p.emitSelectedAlias(c.TargetAlias, p.aliasBinding())
+	return true, nil
+}
diff --git a/daemon/radio_source_move_admission.go b/daemon/radio_source_move_admission.go
