+}
+
+func TestRadioTargetAbsencePreservesOtherRoomAndRestartRemainsUnknown(t *testing.T) {
+	app := radioTestApp(t)
+	p := &AppPlayer{app: app}
+	h := &radioHold{Phase: "suspended", Absence: &radioAbsenceHold{Binding: radioAbsenceBinding{Source: radioAbsenceSource{Kind: "target"}}}}
+	app.radio.Holds["stue"] = h
+	if p.radioMutationAllowed("stue") || !p.radioMutationAllowed("kontor") {
+		t.Fatal("target absence blocked actual unrelated live source or released held room")
+	}
+	h.Phase = "unknown"
+	if p.radioMutationAllowed("kontor") {
+		t.Fatal("unknown target absence invented a fresh live source proof")
+	}
+}
+
+func TestRadioPrivateOwnerHTTPAuthenticatesAndNeverForwardsToken(t *testing.T) {
+	var received atomic.Int32
+	destination := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		received.Add(1)
+		t.Error("radio auth token followed redirect")
+	}))
+	defer destination.Close()
+	token := strings.Repeat("d", 32)
+	owner := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if r.Header.Get("X-PodConnect-Token") != token {
+			t.Error("missing radio control auth")
+		}
+		if r.URL.Path == "/redirect" {
+			http.Redirect(w, r, destination.URL, http.StatusTemporaryRedirect)
+			return
+		}
+		w.Header().Set("Content-Type", "application/json")
+		_, _ = w.Write([]byte(`{"ok":true}`))
+	}))
+	defer owner.Close()
+	var reply struct {
+		OK bool `json:"ok"`
+	}
+	if err := radioControlHTTP(context.Background(), "POST", owner.URL, token, struct{}{}, &reply); err != nil || !reply.OK {
+		t.Fatal(reply, err)
+	}
+	if err := radioControlHTTP(context.Background(), "POST", owner.URL+"/redirect", token, struct{}{}, &reply); err == nil || received.Load() != 0 {
+		t.Fatal("redirect forwarded private token", err)
+	}
+}
