--- /dev/null
+++ b/daemon/radio_source_move_admission.go
@@ -0,0 +1,46 @@
+package daemon
+
+import (
+	"context"
+	"time"
+)
+
+func (p *AppPlayer) radioSourceMoveIntentBlocked() bool {
+	if p == nil || p.app == nil {
+		return false
+	}
+	p.app.radio.mu.Lock()
+	defer p.app.radio.mu.Unlock()
+	for _, h := range p.app.radio.Holds {
+		if h.SourceMove != nil && h.SourceMovePhase != "opened" {
+			return true
+		}
+	}
+	return false
+}
+
+// Called by the source-only actor with aliasMu and op.mu held. The original
+// opaque MOVE is consumed once; C proof and route effects stay in its producer.
+func (p *AppPlayer) validateRadioSourceMoveClaimLocked(op *moveOperation, ctx context.Context) error {
+	if op == nil || op.RadioRefreshConsumed || op.SourceMoveReceipt != nil || !p.radioSourceMoveClaimCurrentLocked(op, ctx) {
+		return ErrAliasConflict
+	}
+	op.RadioRefreshConsumed = true
+	return nil
+}
+
+// Used again at the exact writer reopen barrier, without consuming another
+// operation or minting another intent.
+func (p *AppPlayer) radioSourceMoveClaimCurrentLocked(op *moveOperation, ctx context.Context) bool {
+	if ctx.Err() != nil || op == nil || op.Owner != p || op.SourceMove == nil || op.Capture == nil || op.SourceMove != op.Capture.SourceMove || op.Radio == nil || op.Capture.Radio != op.Radio || !op.Claimed || !op.CommitClaimed || op.Cancelled || op.Terminal || op.State != "committing" || (!time.Now().Before(op.StagedUntil) && !op.RadioRefreshConsumed) || op.RadioCommitDeadline.IsZero() || !time.Now().Before(op.RadioCommitDeadline) || !p.moveCurrentLocked(op.Capture) || op.CReceipt != nil || !nativeBoundOwnerValid(op.Intended) || op.Intended.SessionID != op.Capture.SessionID || op.Intended.RoomID != op.Capture.Scope.RoomID || op.Intended.HomePodID != op.Capture.Scope.HomePodID {
+		return false
+	}
+	app := p.app
+	app.radio.mu.Lock()
+	defer app.radio.mu.Unlock()
+	h := app.radio.Holds[op.SourceMove.HoldTarget]
+	if app.radio.failed || h == nil || h != op.SourceMove.hold || h.owner != p || h.primary == nil || h.primary != p.primaryStream || h.PausedBefore == nil || !h.WriterParked || h.Phase != "suspended" || app.radio.Holds[op.Capture.Scope.RoomID] != nil || op.SourceMove.ClaimIntent != app.radio.Intent || op.Radio.ClaimIntent != app.radio.Intent {
+		return false
+	}
+	return true
+}
diff --git a/daemon/radio_source_move_test.go b/daemon/radio_source_move_test.go
new file mode 100644
index 0000000..ccca7c4
--- /dev/null
+++ b/daemon/radio_source_move_test.go
@@ -0,0 +1,69 @@
+package daemon
+
+import (
+	"context"
+	"testing"
+)
+
+// The parked-source protocol must not disguise a normal live-route MOVE, and
+// a decoded copy must retain the original immutable future-operation tuple.
+func TestRadioSourceMoveFuturePinsRetainedVolumeAndOriginalOffer(t *testing.T) {
+	state := radioSourceMoveState{Incarnation: "native", Epoch: "7", QueueRevision: "8", Volume: 40}
+	a := radioSourceMoveFuture{radioSourceMoveState: state, OfferID: "original", BindingID: "binding", Revision: "9", Policy: movePolicy}
+	b := a
+	if contentDigest(a) != contentDigest(b) {
+		t.Fatal("same retained operation changed identity")
+	}
+	b.Volume = 35
+	if contentDigest(a) == contentDigest(b) {
+		t.Fatal("source40 replaced with selected-content35")
+	}
+	b = a
+	b.QueueRevision = "10"
+	if contentDigest(a) == contentDigest(b) {
+		t.Fatal("changed queue reused original operation")
+	}
+	b = a
+	b.OfferID = "replacement"
+	if contentDigest(a) == contentDigest(b) {
+		t.Fatal("replacement offer reused original operation")
+	}
+}
+func TestRadioSourceMoveMissingRealRetainedSourceRejectsBeforeObservation(t *testing.T) {
+	p := &AppPlayer{}
+	if _, _, err := p.captureRadioSourceMove(context.Background(), nil); err == nil {
+		t.Fatal("missing actual retained source granted a capture")
+	}
+	if p.radioSourceMoveCurrentLocked(nil) {
+		t.Fatal("empty snapshot is current")
+	}
+}
+
+// The actor's terminal publication is authoritative when the transport reply is
+// lost after publication. This exercises the real request/wait cancellation seam.
+func TestRadioSourceMoveDeadlineAfterTerminalPublicationKeepsCompletion(t *testing.T) {
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	server := &ConcreteApiServer{requests: make(chan ApiRequest)}
+	op := &moveOperation{RadioPossible: true}
+	published := make(chan struct{})
+	go func() {
+		<-server.requests
+		op.mu.Lock()
+		op.State = "complete"
+		op.Terminal = true
+		op.mu.Unlock()
+		close(published)
+		// Deliberately withhold the reply: only cancellation can end the real wait.
+		cancel()
+	}()
+	if err := op.commitRadioSourceMove(ctx, server); err != nil {
+		t.Fatal("lost terminal reply rewrote successful operation", err)
+	}
+	<-published
+	op.mu.Lock()
+	defer op.mu.Unlock()
+	if !op.Terminal || op.State != "complete" {
+		t.Fatal("actual terminal publication lost", op.State)
+	}
+}
diff --git a/daemon/radio_terminal.go b/daemon/radio_terminal.go
new file mode 100644
index 0000000..3588455
--- /dev/null
+++ b/daemon/radio_terminal.go
@@ -0,0 +1,103 @@
+package daemon
+
+import (
+	"encoding/json"
+	"strconv"
+	"time"
+)
+
+const radioTerminalLimit = 32
+
+// A historical completed operation is not a fresh observation of any source.
+// The producer separately reads its actual sender before settling preemption.
+type radioTerminal struct {
+	Request radioRequest    `json:"request"`
+	Token   string          `json:"token"`
+	Source  json.RawMessage `json:"source_proof"`
+	Drain   json.RawMessage `json:"sender_drain"`
+	Commit  json.RawMessage `json:"native_commit"`
+	At      string          `json:"committed_at"`
+}
+
+func radioTerminalKey(r radioRequest) string {
+	return contentDigest(struct{ Process, Target, Handoff, Generation string }{r.ProcessID, r.TargetID, r.HandoffID, r.Generation})
+}
+func (t *radioTerminal) matches(r radioRequest) bool {
+	return t != nil && t.Request.ProcessID == r.ProcessID && t.Request.TargetID == r.TargetID && t.Request.HandoffID == r.HandoffID && t.Request.Generation == r.Generation && t.Request.Peer == r.Peer && t.Request.ExpectedRevision == r.ExpectedRevision && (r.Token == "" || r.Token == t.Token)
+}
+func (t *radioTerminal) wire(r radioRequest) any {
+	return struct {
+		Schema     string          `json:"schema"`
+		Process    string          `json:"process_id"`
+		Target     string          `json:"target_id"`
+		Handoff    string          `json:"handoff_id"`
+		Generation string          `json:"generation"`
+		Action     string          `json:"action_id"`
+		Peer       radioPeer       `json:"sender_peer"`
+		Revision   string          `json:"expected_native_revision"`
+		Token      string          `json:"token"`
+		Phase      string          `json:"phase"`
+		Terminal   bool            `json:"terminal"`
+		Effects    bool            `json:"effects_started"`
+		Source     json.RawMessage `json:"source_proof"`
+		Drain      json.RawMessage `json:"sender_drain"`
+		Commit     json.RawMessage `json:"native_commit"`
+		At         string          `json:"committed_at"`
+	}{"podconnect.native_radio_handoff_preempted.v1", r.ProcessID, r.TargetID, r.HandoffID, r.Generation, r.ActionID, r.Peer, r.ExpectedRevision, t.Token, "preempted", true, true, t.Source, t.Drain, t.Commit, t.At}
+}
+
+// Called under radio.mu only after the exact actual C completed/opened receipt
+// and the worker/source/owner boundary have been verified. One journal replace
+// records completion and releases the hold together, before new admission.
+func (app *App) retireRadioLocked(h *radioHold, commit any) error {
+	if h == nil || app.radio.Holds[h.Request.TargetID] != h || !volumeHex32.MatchString(radioHoldToken(h)) || len(h.SenderDrain) == 0 || !json.Valid(h.SenderDrain) {
+		return ErrAliasConflict
+	}
+	var drain radioDrainTicket
+	if json.Unmarshal(h.SenderDrain, &drain) != nil || !drain.valid(drain.Challenge) {
+		return ErrAliasConflict
+	}
+	proof, err := json.Marshal(radioHoldProof(h))
+	if err != nil {
+		return err
+	}
+	ack, err := json.Marshal(commit)
+	if err != nil || len(ack) == 0 || string(ack) == "null" {
+		return ErrAliasConflict
+	}
+	record := &radioTerminal{h.Request, radioHoldToken(h), proof, append(json.RawMessage(nil), h.SenderDrain...), ack, time.Now().UTC().Format(time.RFC3339Nano)}
+	if app.radio.Terminal == nil {
+		app.radio.Terminal = map[string]*radioTerminal{}
+	}
+	key := radioTerminalKey(h.Request)
+	prior := app.radio.Terminal[key]
+	var evictedKey string
+	var evicted *radioTerminal
+	if prior == nil && len(app.radio.Terminal) >= radioTerminalLimit {
+		oldest := ^uint64(0)
+		for candidate, value := range app.radio.Terminal {
+			generation, _ := strconv.ParseUint(value.Request.Generation, 10, 64)
+			if generation < oldest {
+				oldest = generation
+				evictedKey = candidate
+				evicted = value
+			}
+		}
+		delete(app.radio.Terminal, evictedKey)
+	}
+	app.radio.Terminal[key] = record
+	delete(app.radio.Holds, h.Request.TargetID)
+	if err = app.persistRadioLocked(); err != nil {
+		app.radio.Holds[h.Request.TargetID] = h
+		if prior == nil {
+			delete(app.radio.Terminal, key)
+		} else {
+			app.radio.Terminal[key] = prior
+		}
+		if evicted != nil {
+			app.radio.Terminal[evictedKey] = evicted
+		}
+		return err
+	}
+	return nil
+}
diff --git a/daemon/radio_terminal_test.go b/daemon/radio_terminal_test.go
