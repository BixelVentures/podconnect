+	p.state.player.PlayOrigin = &connectpb.PlayOrigin{}
+	if !bootEmpty {
+		p.state.player.Track = &connectpb.ProvidedTrack{Uri: "spotify:track:0000000000000000000003"}
+	}
+	selectedProvider := os.Getenv("PC_NATIVE_RADIO_HTTP_SELECTED_PROVIDER")
+	if selectedProvider != "" && selectedProvider != "1" {
+		t.Fatal("invalid explicit offline selected-content provider flag")
+	}
+	sp := p.sess.Spclient()
+	if selectedProvider != "1" {
+		events, _ := (evtimpl.Impl{}).NewEventManager(app.log, nil, nil, nil, "")
+		nextSessionField(p.sess, "events", events)
+		sp = pc13Spclient(t, pc13RoundTrip(func(r *http.Request) (*http.Response, error) {
+			return &http.Response{StatusCode: 204, Body: http.NoBody, Header: make(http.Header), Request: r}, nil
+		}))
+		nextSessionField(p.sess, "sp", sp)
+	}
+	if bootEmpty && (selectedProvider != "1" || expectReturn != "selected" || stream != nil || p.primaryStream != nil || p.state.tracks != nil || p.state.player.Track != nil) {
+		t.Fatal("boot-empty wire server requires honest empty source and selected-return provider")
+	}
+	if !bootEmpty {
+		// A real track-list object keeps ordinary worker Pause event handling intact.
+		list, err := tracks.NewTrackListFromContext(context.Background(), app.log, sp, &connectpb.Context{Uri: p.state.player.Track.Uri, Pages: []*connectpb.ContextPage{{Tracks: []*connectpb.ContextTrack{{Uri: p.state.player.Track.Uri}}}}})
+		if err != nil {
+			t.Fatal(err)
+		}
+		if err = list.TrySeek(context.Background(), func(*connectpb.ContextTrack) bool { return true }); err != nil {
+			t.Fatal(err)
+		}
+		p.state.tracks = list
+	}
+	primary, session, queue := p.primaryStream, p.sess, p.state.tracks
+	app.moveCustodyMu.Lock()
+	originalWriterOwner, originalWriterGeneration, originalWriter := app.openedWriterOwner, app.openedWriterGeneration, app.openedWriter
+	app.moveCustodyMu.Unlock()
+	ctx, cancel := context.WithTimeout(context.Background(), time.Duration(seconds)*time.Second)
+	actorRequests := make(chan ApiRequest)
+	actorDone, dispatchDone := make(chan struct{}), make(chan struct{})
+	app.ownerMu.Lock()
+	app.currentPlayer, app.currentAPI, app.currentDone = p, actorRequests, actorDone
+	app.ownerMu.Unlock()
+	var bootFirstSource *player.Stream
+	var bootFirstQueue *tracks.List
+	observeBootEvolution := func() {
+		if !bootEmpty || bootFirstSource != nil || p.primaryStream == nil || p.state.tracks == nil || p.state.player.Track == nil || p.state.player.Track.Uri != "spotify:track:0000000000000000000004" || p.state.device.SelectedAliasId != 1 || app.startCustody == nil || app.startCustody.CReceipt == nil || app.startCustody.CReceipt.Phase != "completed" {
+			return
+		}
+		bootFirstSource, bootFirstQueue = p.primaryStream, p.state.tracks
+		t.Log("VERIFIED boot-empty first selected B source/queue and actual completed C START publication; historical global hold remains owned by actual radio APIs")
+	}
+	var radioCalls sync.WaitGroup
+	go func() {
+		defer close(actorDone)
+		for {
+			select {
+			case <-ctx.Done():
+				return
+			case req := <-actorRequests:
+				if req.Type == apiRadioHandoff {
+					observed, forwarded := radioWireObserveRequest(t, req, "actor")
+					keep := p.dispatchAPIAndPark(ctx, observed)
+					observeBootEvolution()
+					<-forwarded
+					if !keep {
+						return
+					}
+					continue
+				}
+				if !p.dispatchAPIAndPark(ctx, req) {
+					return
+				}
+				observeBootEvolution()
+			case ev, open := <-worker.Receive():
+				if !open {
+					return
+				}
+				p.handlePlayerEvent(ctx, &ev)
+				observeBootEvolution()
+			case <-p.prefetchTimer.C:
+				p.prefetchNext(ctx)
+			}
+		}
+	}()
+	go func() {
+		defer close(dispatchDone)
+		for {
+			select {
+			case <-ctx.Done():
+				return
+			case req := <-server.Receive():
+				if req.Type == apiRadioHTTP {
+					radioCalls.Add(1)
+					go func() {
+						defer radioCalls.Done()
+						observed, forwarded := radioWireObserveRequest(t, req, "http_dispatch")
+						app.handleRadioAPI(ctx, observed)
+						<-forwarded
+					}()
+				} else {
+					select {
+					case actorRequests <- req:
+					case <-ctx.Done():
+						req.Reply(nil, ctx.Err())
+					}
+				}
+			}
+		}
+	}()
+	var cleanupOnce sync.Once
+	cleanup := func() {
+		cleanupOnce.Do(func() {
+			cancel()
+			_ = server.Close()
+			<-dispatchDone
+			radioCalls.Wait()
+			<-actorDone
+			app.ownerMu.Lock()
+			app.currentPlayer, app.currentAPI, app.currentDone = nil, nil, nil
+			app.ownerMu.Unlock()
+		})
+	}
+	defer cleanup()
+	process, valid := nativeContentProcess()
+	if !valid {
+		t.Fatal("missing real Native process identity")
+	}
+	selected, err := worker.Start35CurrentSource(ctx)
+	if bootEmpty {
+		app.moveCustodyMu.Lock()
+		noWriter := app.openedWriterOwner == nil && app.openedWriterGeneration == 0 && app.openedWriter.FD == ""
+		app.moveCustodyMu.Unlock()
+		if err != nil || selected != nil || p.primaryStream != nil || app.startCustody != nil || !noWriter {
+			t.Fatal("wire seam lost actual boot-empty precondition", err)
+		}
+	} else if err != nil || selected != stream.Source || p.primaryStream != stream || app.startCustody == nil || app.startCustody.CReceipt == nil || app.startCustody.CReceipt.Phase != "completed" {
+		t.Fatal("wire seam lacks actual completed source", err)
+	}
+	var readyScope roomVolumeScope
