@@ -0,0 +1,70 @@
+package daemon
+
+import (
+	"context"
+	"encoding/json"
+	"strings"
+	"testing"
+)
+
+// Journal fixtures validate durable correlation, not receiver/C acceptance.
+func TestRadioTerminalHistorySurvivesRestartWithoutInventingFreshObservation(t *testing.T) {
+	app := radioTestApp(t)
+	r := radioRequest{Schema: "podconnect.native_radio_handoff.v1", ProcessID: strings.Repeat("a", 64), TargetID: "stue", HandoffID: "00000000-0000-0000-0000-000000000001", Generation: "7", ExpectedRevision: "0", ActionID: "00000000-0000-0000-0000-000000000002", Peer: radioPeer{"00000000-0000-0000-0000-000000000003", "4", strings.Repeat("b", 64)}}
+	percent := 20
+	drain, _ := json.Marshal(radioDrainTicket{"9", strings.Repeat("c", 64), strings.Repeat("d", 32), "receiver_acknowledged", &percent, "2"})
+	h := &radioHold{Request: r, Proof: radioCBinding{Schema: "podconnect.output_radio_handoff.v1", Token: strings.Repeat("e", 32)}, SenderDrain: drain, Actions: map[string]bool{}}
+	app.radio.Holds[r.TargetID] = h
+	if err := app.retireRadioLocked(h, map[string]any{"schema": "test.fixture.actual_commit", "phase": "opened"}); err != nil {
+		t.Fatal(err)
+	}
+	if app.radio.Holds[r.TargetID] != nil {
+		t.Fatal("completed hold was not released")
+	}
+	first, err := app.radioReadResult(context.Background(), r)
+	if err != nil {
+		t.Fatal(err)
+	}
+	firstBytes, _ := json.Marshal(first)
+	var wire map[string]json.RawMessage
+	if json.Unmarshal(firstBytes, &wire) != nil || string(wire["schema"]) != `"podconnect.native_radio_handoff_preempted.v1"` || string(wire["phase"]) != `"preempted"` || wire["observed_at"] != nil || wire["committed_at"] == nil || wire["native_commit"] == nil || wire["sender_drain"] == nil {
+		t.Fatalf("invalid terminal variant: %s", firstBytes)
+	}
+	restart := &App{cfg: app.cfg}
+	if err = restart.initRadio(); err != nil {
+		t.Fatal(err)
+	}
+	second, err := restart.radioReadResult(context.Background(), r)
+	if err != nil {
+		t.Fatal(err)
+	}
+	secondBytes, _ := json.Marshal(second)
+	if string(secondBytes) != string(firstBytes) {
+		t.Fatal("restart changed historical receipt or manufactured fresh observation time")
+	}
+	r.Token = strings.Repeat("f", 32)
+	if _, err = restart.radioReadResult(context.Background(), r); err == nil {
+		t.Fatal("wrong token read terminal proof")
+	}
+}
+
+func TestRadioDrainVolumeRequiresActualZeroAndSignedKind(t *testing.T) {
+	zero := 0
+	ticket := radioDrainTicket{"1", strings.Repeat("a", 64), strings.Repeat("b", 32), "receiver_acknowledged", &zero, "1"}
+	if !ticket.valid(ticket.Challenge) {
+		t.Fatal("actual acknowledged zero rejected")
+	}
+	ticket.VolumePercent = nil
+	if ticket.valid(ticket.Challenge) {
+		t.Fatal("missing volume silently became zero")
+	}
+	ticket.VolumePercent = &zero
+	ticket.VolumeRevision = "0"
+	if ticket.valid(ticket.Challenge) {
+		t.Fatal("unacknowledged revision accepted as receiver ACK")
+	}
+	ticket.VolumeKind = "unchanged_source_base"
+	if !ticket.valid(ticket.Challenge) {
+		t.Fatal("signed unchanged base rejected")
+	}
+}
