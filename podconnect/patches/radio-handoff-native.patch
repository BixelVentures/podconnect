@@ -0,0 +1,329 @@
+package daemon
+
+import (
+	"context"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"os"
+	"path/filepath"
+	"strconv"
+	"strings"
+	"syscall"
+	"time"
+)
+
+type radioAbsenceRoute struct {
+	Identity roomVolumeRoute `json:"output_identity"`
+	Digest   string          `json:"receiver_key_digest"`
+}
+type radioAbsenceLive struct {
+	WriterFD        string              `json:"writer_fd"`
+	InputGeneration string              `json:"input_generation"`
+	InputItemID     string              `json:"input_item_id"`
+	InputEpoch      string              `json:"input_epoch"`
+	Routes          []radioAbsenceRoute `json:"selected_routes"`
+}
+type radioAbsenceSource struct {
+	Kind     string             `json:"kind"`
+	Live     *radioAbsenceLive  `json:"live_source,omitempty"`
+	Process  contentProcess     `json:"native_process"`
+	Registry string             `json:"registry_digest"`
+	Path     string             `json:"input_path"`
+	Digest   string             `json:"input_path_digest"`
+	Pipe     outputPipeIdentity `json:"pipe_identity"`
+}
+type radioAbsenceReceiver struct {
+	Process           string `json:"process"`
+	DeviceID          string `json:"device_id"`
+	Incarnation       string `json:"device_incarnation"`
+	SessionEpoch      string `json:"session_epoch"`
+	RouteRevision     string `json:"route_revision"`
+	BaseRevision      string `json:"base_revision"`
+	AttentionRevision string `json:"attention_revision"`
+}
+type radioAbsenceBinding struct {
+	Schema           string               `json:"schema"`
+	Source           radioAbsenceSource   `json:"source_absence"`
+	Output           radioAbsenceReceiver `json:"output_identity"`
+	HandoffID        string               `json:"handoff_id"`
+	Token            string               `json:"token,omitempty"`
+	Generation       string               `json:"generation"`
+	Revision         string               `json:"native_revision"`
+	SenderPeer       string               `json:"sender_peer"`
+	RadioProcess     string               `json:"radio_process"`
+	RadioEpoch       string               `json:"radio_owner_epoch"`
+	Digest           string               `json:"receiver_key_digest"`
+	InitialVolume    int                  `json:"initial_volume_percent"`
+	VolumeProvenance string               `json:"volume_provenance"`
+}
+type radioAbsenceHold struct {
+	Custody       *radioAbsenceCustody        `json:"custody,omitempty"`
+	CurrentStart  *radioAbsenceCurrentRequest `json:"current_start,omitempty"`
+	CurrentLatest *radioAbsenceCurrentReply   `json:"current_start_latest,omitempty"`
+	Binding       radioAbsenceBinding         `json:"binding"`
+	Signature     string                      `json:"suspended_signature,omitempty"`
+	Start         *radioAbsenceStartRequest   `json:"future_start_binding,omitempty"`
+	StartLatest   *radioAbsenceStartReply     `json:"future_start_latest,omitempty"`
+}
+type radioAbsenceObservation struct {
+	Schema           string               `json:"schema"`
+	OK               bool                 `json:"ok"`
+	Absent           bool                 `json:"source_absent"`
+	Proof            *radioAbsenceBinding `json:"proof"`
+	VolumeProvenance string               `json:"volume_provenance"`
+	Physical         bool                 `json:"physical_result_verified"`
+}
+type radioAbsenceCReply struct {
+	radioAbsenceBinding
+	OK        bool   `json:"ok"`
+	Purpose   string `json:"purpose"`
+	Phase     string `json:"phase"`
+	Signature string `json:"suspended_signature,omitempty"`
+	Physical  bool   `json:"physical_result_verified"`
+}
+
+func radioHoldProof(h *radioHold) any {
+	if h.Parked != nil {
+		return h.Parked.Binding
+	}
+	if h.Absence != nil {
+		return h.Absence.Binding
+	}
+	return h.Proof
+}
+func radioHoldToken(h *radioHold) string {
+	if h.Parked != nil {
+		return h.Parked.Binding.Token
+	}
+	if h.Absence != nil {
+		return h.Absence.Binding.Token
+	}
+	return h.Proof.Token
+}
+func radioHoldSignature(h *radioHold) string {
+	if h.Parked != nil {
+		return h.Parked.Signature
+	}
+	if h.Absence != nil {
+		return h.Absence.Signature
+	}
+	if h.Latest != nil {
+		return h.Latest.Signature
+	}
+	return ""
+}
+func (app *App) radioAbsenceSource() (radioAbsenceSource, error) {
+	var out radioAbsenceSource
+	process, valid := nativeContentProcess()
+	if !valid || app.cfg == nil || app.cfg.AudioBackend != "pipe" || app.cfg.AudioOutputPipeFormat != "s16le" || !app.cfg.ExternalVolume || !filepath.IsAbs(app.cfg.AudioOutputPipe) || !roomTransportURL(app.cfg.RoomTransportOwnToneURL) {
+		return out, ErrAliasConflict
+	}
+	info, err := os.Lstat(app.cfg.AudioOutputPipe)
+	if err != nil || info.Mode()&os.ModeNamedPipe == 0 {
+		return out, ErrAliasConflict
+	}
+	stat, valid := info.Sys().(*syscall.Stat_t)
+	if !valid {
+		return out, ErrAliasConflict
+	}
+	raw, err := json.Marshal(struct {
+		Aliases, Rooms, Homepods []string
+		Pipe, Format             string
+	}{app.cfg.DeviceAliases, app.cfg.DeviceAliasRoomIDs, app.cfg.DeviceAliasHomePodIDs, app.cfg.AudioOutputPipe, app.cfg.AudioOutputPipeFormat})
+	if err != nil {
+		return out, err
+	}
+	registry := sha256.Sum256(raw)
+	out = radioAbsenceSource{Kind: "global", Process: process, Registry: hex.EncodeToString(registry[:]), Path: app.cfg.AudioOutputPipe, Digest: contentDigestBytes(app.cfg.AudioOutputPipe), Pipe: outputPipeIdentity{strconv.FormatUint(uint64(stat.Dev), 10), strconv.FormatUint(uint64(stat.Ino), 10), "fifo"}}
+	return out, nil
+}
+func (app *App) radioAbsenceCall(ctx context.Context, h *radioHold, action string) (radioAbsenceCReply, error) {
+	var reply radioAbsenceCReply
+	if h.Absence == nil {
+		return reply, ErrAliasConflict
+	}
+	b := h.Absence.Binding
+	endpoint := strings.TrimSuffix(app.cfg.RoomTransportOwnToneURL, "/") + "/api/outputs/" + b.Output.DeviceID + "/radio-absence/" + action
+	if err := radioControlHTTP(ctx, "POST", endpoint, app.cfg.RadioHandoffControlToken, b, &reply); err != nil {
+		return reply, err
+	}
+	expected := b
+	expected.Token = reply.Token
+	if reply.Schema != "podconnect.output_radio_absence.v1" || !reply.OK || reply.Purpose != "radio_absence_v1" || reply.Physical || contentDigest(reply.radioAbsenceBinding) != contentDigest(expected) || !volumeHex32.MatchString(reply.Token) || b.Token != "" && b.Token != reply.Token || reply.Phase != "prepared" && reply.Phase != "suspended" && reply.Phase != "unknown" || reply.Phase == "suspended" && !volumeHex64.MatchString(reply.Signature) {
+		return reply, ErrAliasConflict
+	}
+	return reply, nil
+}
+
+// Called by the App's existing serialized API dispatcher, including before a
+// Spotify login exists. Only verified C source presence selects the old lane.
+func (app *App) radioAbsenceAPI(ctx context.Context, c radioHTTPCall) (bool, any, error) {
+	if !app.radioEnabled() {
+		return false, nil, nil
+	}
+	app.radio.mu.Lock()
+	h := app.radio.Holds[c.Request.TargetID]
+	if h != nil && h.Absence == nil {
+		app.radio.mu.Unlock()
+		return false, nil, nil
+	}
+	if h != nil {
+		if h.Request.ProcessID != c.Request.ProcessID || h.Request.HandoffID != c.Request.HandoffID || h.Request.Generation != c.Request.Generation || h.Request.Peer != c.Request.Peer || h.Request.ExpectedRevision != c.Request.ExpectedRevision || c.Request.Token != "" && c.Request.Token != radioHoldToken(h) {
+			app.radio.mu.Unlock()
+			return true, nil, ErrAliasConflict
+		}
+		if c.Action == "result" {
+			if h.Absence.Custody == nil && (strings.HasPrefix(h.Phase, "content_") || strings.HasPrefix(h.Phase, "move_") || h.Phase == "reacquiring") {
+				data := radioReply(h, c.Request)
+				app.radio.mu.Unlock()
+				return true, data, nil
+			}
+			snapshot := *h
+			absenceSnapshot := *h.Absence
+			snapshot.Absence = &absenceSnapshot
+			app.radio.mu.Unlock()
+			if snapshot.Absence.Binding.Token == "" {
+				return true, radioReply(&snapshot, c.Request), nil
+			}
+			state, err := app.radioAbsenceState(ctx, &snapshot)
+			if err != nil {
+				return true, nil, err
+			}
+			app.radio.mu.Lock()
+			defer app.radio.mu.Unlock()
+			if app.radio.Holds[c.Request.TargetID] != h {
+				return true, nil, ErrAliasConflict
+			}
+			if state.Custody != nil {
+				if err = app.installAbsenceCustodyLocked(h, state.Custody); err != nil {
+					return true, nil, err
+				}
+				data, err := radioCustodyWire(h, c.Request)
+				return true, data, err
+			}
+			// Once evolution was observed, an old absence response cannot restore it.
+			if h.Absence.Custody != nil || state.Original == nil {
+				return true, nil, ErrAliasConflict
+			}
+			ack := state.Original
+			h.Phase = ack.Phase
+			h.ObservedAt = time.Now().UTC().Format(time.RFC3339Nano)
+			h.Absence.Signature = ack.Signature
+			if err = app.persistRadioLocked(); err != nil {
+				return true, nil, err
+			}
+			return true, radioReply(h, c.Request), nil
+		}
+		if c.Action != "suspend" || h.Phase != "prepared" || strconv.FormatUint(app.radio.Intent, 10) != h.Absence.Binding.Revision || h.Actions["suspend:"+c.Request.ActionID] || len(h.Actions) >= 4096 {
+			app.radio.mu.Unlock()
+			return true, nil, ErrAliasConflict
+		}
+		h.Actions["suspend:"+c.Request.ActionID] = true
+		h.Phase = "unknown"
+		if err := app.persistRadioLocked(); err != nil {
+			app.radio.mu.Unlock()
+			return true, nil, err
+		}
+		ack, err := app.radioAbsenceCall(ctx, h, "confirm")
+		if err == nil {
+			h.Phase = ack.Phase
+			h.ObservedAt = time.Now().UTC().Format(time.RFC3339Nano)
+			h.Absence.Signature = ack.Signature
+			err = app.persistRadioLocked()
+		}
+		data := radioReply(h, c.Request)
+		app.radio.mu.Unlock()
+		return true, data, err
+	}
+	app.radio.mu.Unlock()
+	if c.Action != "reserve" {
+		return false, nil, nil
+	}
+	source, err := app.radioAbsenceSource()
+	if err != nil {
+		return true, nil, err
+	}
+	target := ""
+	seen := map[string]bool{}
+	if len(app.cfg.DeviceAliasRoomIDs) != len(app.cfg.DeviceAliases) || len(app.cfg.DeviceAliasHomePodIDs) != len(app.cfg.DeviceAliases) {
+		return true, nil, ErrAliasConflict
+	}
+	for i, room := range app.cfg.DeviceAliasRoomIDs {
+		if seen[room] {
+			return true, nil, ErrAliasConflict
+		}
+		seen[room] = true
+		if room == c.Request.TargetID {
+			target = app.cfg.DeviceAliasHomePodIDs[i]
+		}
+	}
+	if !homePodIDPattern.MatchString(target) {
+		return true, nil, ErrAliasConflict
+	}
+	var observed radioAbsenceObservation
+	body := struct {
+		Schema string             `json:"schema"`
+		Source radioAbsenceSource `json:"source_absence"`
+	}{"podconnect.output_radio_absence_observation.v1", source}
+	endpoint := strings.TrimSuffix(app.cfg.RoomTransportOwnToneURL, "/") + "/api/outputs/" + target + "/radio-absence/observe"
+	if err = radioControlHTTP(ctx, "POST", endpoint, app.cfg.RadioHandoffControlToken, body, &observed); err != nil {
+		return true, nil, err
+	}
+	if observed.Schema != body.Schema || !observed.OK || observed.Physical {
+		return true, nil, ErrAliasConflict
+	}
+	if !observed.Absent {
+		return false, nil, nil
+	}
+	if observed.Proof == nil || !radioAbsenceCoreEqual(observed.Proof.Source, source) || observed.Proof.Output.DeviceID != target || observed.Proof.Output.Process == "" || !volumeHex64.MatchString(observed.Proof.Digest) || observed.Proof.Digest != c.Request.Peer.Digest || observed.Proof.InitialVolume < 0 || observed.Proof.InitialVolume > 100 || observed.VolumeProvenance != "stored_manual_base" {
+		return true, nil, ErrAliasConflict
+	}
+	app.radio.mu.Lock()
+	defer app.radio.mu.Unlock()
+	if app.radio.Holds[c.Request.TargetID] == nil && c.Request.ExpectedRevision != strconv.FormatUint(app.radio.Intent, 10) {
+		data, rejectErr := app.rejectStaleRadioLocked(c.Request)
+		return true, data, rejectErr
+	}
+	generation, parseErr := strconv.ParseUint(c.Request.Generation, 10, 64)
+	if parseErr != nil || generation <= app.radio.Generation || app.radio.Intent == ^uint64(0) || c.Request.ExpectedRevision != strconv.FormatUint(app.radio.Intent, 10) || app.radio.Holds[c.Request.TargetID] != nil || c.Request.Token != "" || app.radio.failed || ctx.Err() != nil {
+		return true, nil, ErrAliasConflict
+	}
+	// The atomic native output admission veto is installed before C's final
+	// kernel proof. No login or synthetic AppPlayer owns this absence receipt.
+	if observed.Proof.Source.Kind == "global" {
+		app.radioAbsenceFence.Store(true)
+	}
+	app.radio.Intent++
+	app.radio.Generation = generation
+	binding := *observed.Proof
+	binding.Schema = "podconnect.output_radio_absence.v1"
+	binding.HandoffID = c.Request.HandoffID
+	binding.Generation = c.Request.Generation
+	binding.Revision = strconv.FormatUint(app.radio.Intent, 10)
+	binding.SenderPeer = c.Request.Peer.Process
+	binding.RadioProcess = c.Request.Peer.Process
+	binding.RadioEpoch = c.Request.Peer.Epoch
+	binding.VolumeProvenance = "stored_manual_base"
+	binding.Token = ""
+	h = &radioHold{Request: c.Request, Phase: "unknown", Actions: map[string]bool{"reserve:" + c.Request.ActionID: true}, Absence: &radioAbsenceHold{Binding: binding}}
+	app.radio.Holds[c.Request.TargetID] = h
+	if err = app.persistRadioLocked(); err != nil {
+		return true, nil, err
+	}
+	ack, err := app.radioAbsenceCall(ctx, h, "prepare")
+	if err != nil {
+		return true, nil, err
+	}
+	h.Absence.Binding.Token = ack.Token
+	h.Phase = ack.Phase
+	h.ObservedAt = time.Now().UTC().Format(time.RFC3339Nano)
+	if err = app.persistRadioLocked(); err != nil {
+		return true, nil, err
+	}
+	return true, radioReply(h, c.Request), nil
+}
+
+func radioAbsenceCoreEqual(a, b radioAbsenceSource) bool {
+	return a.Process == b.Process && a.Registry == b.Registry && a.Path == b.Path && a.Digest == b.Digest && a.Pipe == b.Pipe && (a.Kind == "global" && a.Live == nil || a.Kind == "target" && a.Live != nil && len(a.Live.Routes) > 0 && len(a.Live.Routes) <= 16)
+}
diff --git a/daemon/radio_absence_actual_c41_test.go b/daemon/radio_absence_actual_c41_test.go
new file mode 100644
index 0000000..432e8b3
--- /dev/null
+++ b/daemon/radio_absence_actual_c41_test.go
@@ -0,0 +1,81 @@
+package daemon
+
+import (
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"os"
+	"testing"
+	"time"
+)
+
+// Actual C41 formatter/DB bytes, already expired. This is a historical wire
+// artifact, not a current Native response, process scope or retained-use grant.
+func TestRadioAbsenceEvolutionActualC41Artifact(t *testing.T) {
+	raw, err := os.ReadFile("testdata/radio-evolved-custody-c41.json")
+	if err != nil {
+		t.Fatal(err)
+	}
+	sum := sha256.Sum256(raw)
+	if hex.EncodeToString(sum[:]) != "a1bd238a419adb1daa063cdc4131a1af780e8e7c848d53ebc70cdc8e97a1d284" {
+		t.Fatal("actual captured C bytes changed")
+	}
+	var k radioAbsenceCustody
+	if err = decodeRadioNullable(raw, &k, "original_suspended_signature", "evolution.start_future.old_native_owner", "evolution.completion", "target_continuity"); err != nil {
+		t.Fatal("actual closed C41 schema rejected", err)
+	}
+	if k.Schema != "podconnect.output_radio_absence_custody.v1" || !k.OK || k.Physical || k.Phase != "source_evolved" || k.OriginalPhase != "suspended" || k.Signature == nil || !volumeHex64.MatchString(*k.Signature) || k.Continuity == nil || !radioEvolutionCompletionMatches(k.Evolution.Completion, k.Evolution) || *k.Evolution.Completion.Pipe != k.Hold.Source.Pipe {
+		t.Fatal("actual frozen P/custody correlation rejected")
+	}
+	at, e1 := time.Parse(time.RFC3339Nano, k.Continuity.ObservedAt)
+	until, e2 := time.Parse(time.RFC3339Nano, k.Continuity.ValidUntil)
+	if e1 != nil || e2 != nil || !until.After(at) || until.Sub(at) > 2*time.Second || !time.Now().After(until) {
+		t.Fatal("artifact is not a naturally expired captured continuity observation")
+	}
+	var live radioAbsenceCustody
+	if decodeRadioAbsenceCustody(raw, &live) == nil {
+		t.Fatal("archived C artifact became fresh live authority")
+	}
+	// Direct C fixture has no original Native room/action query. This is an
+	// explicitly synthetic READ query for testing the actual serializer only.
+	query := radioRequest{Schema: "podconnect.native_radio_handoff.v1", ProcessID: radioProcessID(k.Hold.Source.Process), TargetID: "synthetic-artifact-read-target", HandoffID: k.Hold.HandoffID, Generation: k.Hold.Generation, ActionID: k.Hold.HandoffID, Peer: radioPeer{k.Hold.RadioProcess, k.Hold.RadioEpoch, k.Hold.Digest}, Token: k.Hold.Token, ExpectedRevision: k.Hold.Revision}
+	h := &radioHold{Request: query, Absence: &radioAbsenceHold{Binding: k.Hold, Signature: *k.Signature, Custody: &k}}
+	wrapper, err := radioCustodyWire(h, query)
+	if err != nil {
+		t.Fatal(err)
+	}
+	envelope, err := json.Marshal(wrapper)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var read struct {
+		Schema      string              `json:"schema"`
+		Source      radioAbsenceBinding `json:"source_proof"`
+		Custody     radioAbsenceCustody `json:"custody_proof"`
+		Terminal    bool                `json:"terminal"`
+		CustodyOnly bool                `json:"custody_only"`
+	}
+	if json.Unmarshal(envelope, &read) != nil || read.Schema != "podconnect.native_radio_handoff_custody.v1" || read.Terminal || !read.CustodyOnly || contentDigest(read.Source) != contentDigest(k.Hold) || contentDigest(read.Custody) != contentDigest(k) {
+		t.Fatal("serializer changed captured custody or claimed a fresh source")
+	}
+	var outer map[string]json.RawMessage
+	if json.Unmarshal(envelope, &outer) != nil || outer["observed_at"] != nil {
+		t.Fatal("historical wrapper claimed fresh outer source observation")
+	}
+	if path := os.Getenv("PC_NATIVE_EVOLUTION_WRAPPER_ARTIFACT"); path != "" {
+		if err = os.WriteFile(path, append(envelope, '\n'), 0600); err != nil {
+			t.Fatal(err)
+		}
+		metadata := struct {
+			Kind      string `json:"kind"`
+			Query     string `json:"query_provenance"`
+			Authority string `json:"authority"`
+			Original  string `json:"original_c_sha256"`
+			Captured  string `json:"captured_at"`
+		}{"actual-C-K-P-and-actual-Native-serializer", "synthetic-read-correlation-no-original-Native-query-exists", "historical-wire-schema-only-not-Native-API-response-or-live-grant", hex.EncodeToString(sum[:]), k.Continuity.ObservedAt}
+		m, _ := json.Marshal(metadata)
+		if err = os.WriteFile(path+".meta.json", append(m, '\n'), 0600); err != nil {
+			t.Fatal(err)
+		}
+	}
+}
diff --git a/daemon/radio_absence_current_start.go b/daemon/radio_absence_current_start.go
