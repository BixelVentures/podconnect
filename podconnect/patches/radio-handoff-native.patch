index 0000000..2cbf7e5
--- /dev/null
+++ b/daemon/radio_reacquire.go
@@ -0,0 +1,429 @@
+package daemon
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"github.com/devgianlu/go-librespot/output"
+	"io"
+	"net/http"
+	"strconv"
+	"strings"
+	"time"
+)
+
+type radioReacquire struct {
+	Schema           string                `json:"schema"`
+	Phase            string                `json:"phase"`
+	Hold             radioCBinding         `json:"hold"`
+	IntentID         string                `json:"intent_id"`
+	Revision         string                `json:"native_revision"`
+	Owner            roomTransportIdentity `json:"current_native_owner"`
+	Intended         roomTransportIdentity `json:"intended_native_owner"`
+	Challenge        string                `json:"challenge,omitempty"`
+	DrainGeneration  string                `json:"drain_generation,omitempty"`
+	Signature        string                `json:"drain_signature,omitempty"`
+	VolumeKind       string                `json:"final_volume_kind,omitempty"`
+	VolumePercent    *int                  `json:"final_volume_percent,omitempty"`
+	VolumeRevision   string                `json:"final_volume_revision,omitempty"`
+	Writer           *queueWriterWire      `json:"current_writer_proof,omitempty"`
+	Source           *roomVolumeRoute      `json:"current_source_identity,omitempty"`
+	StartOfferID     string                `json:"start_offer_id,omitempty"`
+	StartBindingID   string                `json:"start_binding_id,omitempty"`
+	StartDigest      string                `json:"start_content_digest,omitempty"`
+	StartIncarnation string                `json:"start_native_incarnation,omitempty"`
+	StartRevision    string                `json:"start_native_revision,omitempty"`
+}
+type radioReacquireReply struct {
+	Schema             string                `json:"schema"`
+	OK                 bool                  `json:"ok"`
+	Purpose            string                `json:"purpose"`
+	Phase              string                `json:"phase"`
+	Challenge          string                `json:"challenge"`
+	ChallengeSignature string                `json:"challenge_signature"`
+	IntentID           string                `json:"intent_id"`
+	Revision           string                `json:"native_revision"`
+	Owner              roomTransportIdentity `json:"current_native_owner"`
+	Intended           roomTransportIdentity `json:"intended_native_owner"`
+	Writer             *queueWriterWire      `json:"current_writer_proof,omitempty"`
+	Source             *roomVolumeRoute      `json:"current_source_identity,omitempty"`
+	Route              *roomVolumeRoute      `json:"route_identity,omitempty"`
+	Barrier            bool                  `json:"writer_barrier_verified"`
+	Pause              bool                  `json:"pause_native"`
+	Physical           bool                  `json:"physical_result_verified"`
+	CurrentVolume      *int                  `json:"current_volume_percent,omitempty"`
+	CurrentBase        string                `json:"current_base_revision,omitempty"`
+	VolumeKind         string                `json:"final_volume_kind,omitempty"`
+	VolumePercent      *int                  `json:"final_volume_percent,omitempty"`
+	VolumeRevision     string                `json:"final_volume_revision,omitempty"`
+	FutureStartBound   bool                  `json:"future_start_bound,omitempty"`
+	StartOfferID       string                `json:"start_offer_id,omitempty"`
+	StartBindingID     string                `json:"start_binding_id,omitempty"`
+	StartDigest        string                `json:"start_content_digest,omitempty"`
+	StartIncarnation   string                `json:"start_native_incarnation,omitempty"`
+	StartRevision      string                `json:"start_native_revision,omitempty"`
+}
+type radioPreemptRequest struct {
+	Schema     string          `json:"schema"`
+	ProcessID  string          `json:"native_process_id"`
+	HandoffID  string          `json:"handoff_id"`
+	Generation string          `json:"generation"`
+	Token      string          `json:"token"`
+	TargetID   string          `json:"target_id"`
+	ActionID   string          `json:"action_id"`
+	Cause      string          `json:"cause"`
+	Challenge  json.RawMessage `json:"reacquire_challenge"`
+}
+type radioPreemptReply struct {
+	Schema     string          `json:"schema"`
+	ProcessID  string          `json:"native_process_id"`
+	HandoffID  string          `json:"handoff_id"`
+	Generation string          `json:"generation"`
+	Token      string          `json:"token"`
+	TargetID   string          `json:"target_id"`
+	ActionID   string          `json:"action_id"`
+	Cause      string          `json:"cause"`
+	Challenge  string          `json:"reacquire_challenge"`
+	Terminal   bool            `json:"terminal"`
+	Ticket     json.RawMessage `json:"drain_ticket"`
+}
+
+type radioDrainTicket struct {
+	Generation     string `json:"drain_generation"`
+	Signature      string `json:"drain_signature"`
+	Challenge      string `json:"reacquire_challenge"`
+	VolumeKind     string `json:"final_volume_kind"`
+	VolumePercent  *int   `json:"final_volume_percent"`
+	VolumeRevision string `json:"final_volume_revision"`
+}
+
+func (t radioDrainTicket) valid(challenge string) bool {
+	return volumeCounter(t.Generation) && t.Generation != "0" && volumeHex64.MatchString(t.Signature) && volumeHex32.MatchString(t.Challenge) && t.Challenge == challenge && t.VolumePercent != nil && *t.VolumePercent >= 0 && *t.VolumePercent <= 100 && volumeCounter(t.VolumeRevision) && (t.VolumeKind == "receiver_acknowledged" && t.VolumeRevision != "0" || t.VolumeKind == "unchanged_source_base" && t.VolumeRevision == "0")
+}
+
+func (p *AppPlayer) radioReacquireCall(ctx context.Context, h *radioHold, r radioReacquire) (*radioReacquireReply, error) {
+	if r.Phase != "state" {
+		if err := p.radioReacquireCheckpoint(h, r, r.Phase+"_attempted", nil); err != nil {
+			return nil, err
+		}
+	}
+	var ack radioReacquireReply
+	endpoint := strings.TrimSuffix(p.app.cfg.RoomTransportOwnToneURL, "/") + "/api/outputs/" + h.Proof.Output.DeviceID + "/radio-handoff/reacquire"
+	if err := radioControlHTTP(ctx, http.MethodPost, endpoint, p.app.cfg.RadioHandoffControlToken, r, &ack); err != nil {
+		return nil, err
+	}
+	if ack.Schema != "podconnect.output_radio_reacquire.v1" || ack.Purpose != "radio_reacquire_v1" || !ack.OK || ack.Physical || ack.IntentID != r.IntentID || ack.Revision != r.Revision || ack.Owner != r.Owner || ack.Intended != r.Intended || !volumeHex32.MatchString(ack.Challenge) || !volumeHex64.MatchString(ack.ChallengeSignature) || r.Challenge != "" && r.Challenge != ack.Challenge {
+		return nil, ErrAliasConflict
+	}
+	if r.VolumeKind != "" && (ack.VolumeKind != r.VolumeKind || ack.VolumePercent == nil || r.VolumePercent == nil || *ack.VolumePercent != *r.VolumePercent || ack.VolumeRevision != r.VolumeRevision) {
+		return nil, ErrAliasConflict
+	}
+	if ack.Phase == "route_ready" || ack.Phase == "barrier_ready" || ack.Phase == "opened" {
+		if ack.Route == nil || !ack.Route.valid() || ack.Route.DeviceID != h.Proof.Output.DeviceID || ack.Route.Process != h.Proof.Output.Process || ack.Route.DeviceIncarnation != h.Proof.Output.DeviceIncarnation || r.Source == nil || ack.Route.InputPathDigest != r.Source.InputPathDigest || ack.Route.InputGeneration != r.Source.InputGeneration || ack.Route.InputItemID != r.Source.InputItemID {
+			return nil, ErrAliasConflict
+		}
+	}
+	if r.Phase == "barrier" || r.Phase == "open" || r.Phase == "bind_start" {
+		if ack.Writer == nil || r.Writer == nil || *ack.Writer != *r.Writer {
+			return nil, ErrAliasConflict
+		}
+	}
+	if err := p.radioReacquireCheckpoint(h, r, ack.Phase, &ack); err != nil {
+		return nil, err
+	}
+	return &ack, nil
+}
+
+// preemptRadio is invoked only by the current actor's explicit user intent.
+// Reacquisition does not resume or replace the retained Spotify source.
+func (p *AppPlayer) preemptRadio(ctx context.Context, target, cause string) error {
+	return p.preemptRadioMode(ctx, target, cause, false)
+}
+func (p *AppPlayer) preemptRadioMode(ctx context.Context, target, cause string, keepMuted bool) error {
+	return p.preemptRadioPolicy(ctx, target, cause, keepMuted, false)
+}
+func (p *AppPlayer) preemptRadioPolicy(ctx context.Context, target, cause string, keepMuted, preserveOwner bool) error {
+	app := p.app
+	app.radio.mu.Lock()
+	h := app.radio.Holds[target]
+	if h == nil {
+		app.radio.mu.Unlock()
+		return nil
+	}
+	if h.owner != p || (h.Phase != "suspended" && h.Phase != "prepared") || h.Latest == nil || (h.Latest.Phase != "suspended" && h.Latest.Phase != "prepared") || !volumeHex32.MatchString(h.Proof.Token) {
+		app.radio.mu.Unlock()
+		return ErrAliasConflict
+	}
+	globalIntent := app.radio.Intent
+	h.Phase = "reacquiring"
+	if err := app.persistRadioLocked(); err != nil {
+		app.radio.mu.Unlock()
+		return err
+	}
+	app.radio.mu.Unlock()
+	failed := true
+	defer func() {
+		if failed {
+			app.radio.mu.Lock()
+			h.Phase = "unknown"
+			_ = app.persistRadioLocked()
+			app.radio.mu.Unlock()
+		}
+	}()
+	ctx, cancel := context.WithTimeout(ctx, 8*time.Second)
+	defer cancel()
+	owner, intended, err := p.radioOwnersForIntent(target)
+	if err != nil {
+		return err
+	}
+	revision, err := p.nextNativeIntent()
+	if err != nil {
+		return err
+	}
+	intent, err := randomQueueID(16)
+	if err != nil {
+		return err
+	}
+	// UUIDs are independent operation identities; randomQueueID is raw hex.
+	intent = intent[:8] + "-" + intent[8:12] + "-" + intent[12:16] + "-" + intent[16:20] + "-" + intent[20:]
+	r := radioReacquire{Schema: "podconnect.output_radio_reacquire.v1", Phase: "challenge", Hold: h.Proof, IntentID: intent, Revision: revision, Owner: owner, Intended: intended}
+	challenge, err := p.radioReacquireCall(ctx, h, r)
+	if err != nil {
+		return err
+	}
+	challengeEnvelope, _ := json.Marshal(struct {
+		Challenge string `json:"challenge"`
+		Signature string `json:"challenge_signature"`
+	}{challenge.Challenge, challenge.ChallengeSignature})
+	callback := radioPreemptRequest{"podconnect.radio-preempt.v1", h.Request.ProcessID, h.Request.HandoffID, h.Request.Generation, h.Proof.Token, target, intent, cause, challengeEnvelope}
+	var stopped radioPreemptReply
+	endpoint := strings.TrimSuffix(app.cfg.RadioHandoffOwnerURL, "/") + "/api/radio/native-preempt"
+	if err = radioAuthenticatedHTTP(ctx, endpoint, app.cfg.RadioHandoffControlToken, callback, &stopped); err != nil {
+		return err
+	}
+	if stopped.Schema != callback.Schema || stopped.ProcessID != callback.ProcessID || stopped.HandoffID != callback.HandoffID || stopped.Generation != callback.Generation || stopped.ActionID != intent || !stopped.Terminal {
+		return ErrAliasConflict
+	}
+	var ticket radioDrainTicket
+	if json.Unmarshal(stopped.Ticket, &ticket) != nil || !ticket.valid(challenge.Challenge) {
+		return ErrAliasConflict
+	}
+	app.radio.mu.Lock()
+	h.SenderDrain = append(json.RawMessage(nil), stopped.Ticket...)
+	app.radio.mu.Unlock()
+	if challenge.Source == nil || challenge.Source.Process != h.Proof.Output.Process || challenge.Source.InputPathDigest != h.Proof.Writer.InputDigest {
+		return ErrAliasConflict
+	}
+
+	r.Phase = "commit"
+	r.Challenge = challenge.Challenge
+	r.DrainGeneration = ticket.Generation
+	r.Signature = ticket.Signature
+	r.VolumeKind, r.VolumePercent, r.VolumeRevision = ticket.VolumeKind, ticket.VolumePercent, ticket.VolumeRevision
+	declared := h.Proof.Writer
+	if !h.WriterParked {
+		current, err := p.captureQueueWriter(ctx, owner, nil)
+		if err != nil {
+			return err
+		}
+		declared = current.Wire
+	}
+	r.Writer = &declared
+	r.Source = challenge.Source
+	committed, err := p.radioReacquireCall(ctx, h, r)
+	if err != nil {
+		return err
+	}
+	if committed.Pause != h.WriterParked {
+		return ErrAliasConflict
+	}
+	gen, _ := strconv.ParseUint(h.Request.Generation, 10, 64)
+	b := output.RadioPipeBinding{Token: h.Proof.Token, Generation: gen, Writer: output.MovePipeIdentity{PipeIdentity: h.Proof.Writer.Pipe, FD: h.Proof.Writer.FD}}
+	guard := func() error {
+		if ctx.Err() != nil {
+			return ctx.Err()
+		}
+		app.radio.mu.Lock()
+		defer app.radio.mu.Unlock()
+		if app.radio.Holds[target] != h || h.Phase != "reacquiring" {
+			return ErrAliasConflict
+		}
+		return nil
+	}
+	if h.WriterParked {
+		if err = p.radioReacquireCheckpoint(h, r, "writer_open_attempted", nil); err != nil {
+			return err
+		}
+		_, err = p.player.ReacquireRadio(ctx, b, guard, func(create func() (output.Output, error)) (output.Output, error) {
+			app.moveCustodyMu.Lock()
+			defer app.moveCustodyMu.Unlock()
+			if app.openedWriterOwner != p {
+				return nil, ErrAliasConflict
+			}
+			return app.openRegisteredOutputLocked(p, create)
+		})
+		if err != nil {
+			return err
+		}
+	}
+	app.moveCustodyMu.Lock()
+	writer, writerGeneration, writerOwner := app.openedWriter, app.openedWriterGeneration, app.openedWriterOwner
+	app.moveCustodyMu.Unlock()
+	process, valid := nativeContentProcess()
+	if !valid || writerOwner != p || writerGeneration == 0 || writer.Type != "fifo" {
+		return ErrAliasConflict
+	}
+	fresh := queueWriterWire{process, writer.FD, writer.PipeIdentity, declared.Epoch, strconv.FormatUint(writerGeneration, 10), declared.InputDigest}
+	r.Phase = "state"
+	for {
+		status, e := p.radioReacquireCall(ctx, h, r)
+		if e != nil {
+			return e
+		}
+		if status.Phase == "route_ready" {
+			break
+		}
+		if status.Phase != "connecting" && status.Phase != "consumed" {
+			return ErrAliasConflict
+		}
+		select {
+		case <-ctx.Done():
+			return ctx.Err()
+		case <-time.After(50 * time.Millisecond):
+		}
+	}
+	r.Writer = &fresh
+	r.Phase = "barrier"
+	barrier, err := p.radioReacquireCall(ctx, h, r)
+	if err != nil || barrier.Phase != "barrier_ready" || !barrier.Barrier || barrier.Writer == nil || *barrier.Writer != fresh {
+		return ErrAliasConflict
+	}
+
+	if keepMuted {
+		if h.WriterParked {
+			if _, err = p.player.CompleteRadioReacquire(ctx, b, guard); err != nil {
+				return err
+			}
+		}
+		if !preserveOwner {
+			if err = p.adoptRadioIntendedOwner(r.Owner, r.Intended); err != nil {
+				return err
+			}
+		}
+		app.radio.mu.Lock()
+		defer app.radio.mu.Unlock()
+		if app.radio.Holds[target] != h || h.Phase != "reacquiring" {
+			return ErrAliasConflict
+		}
+		h.WriterParked = false
+		h.Phase = "content_ready"
+		if err = app.persistRadioLocked(); err != nil {
+			return err
+		}
+		failed = false
+		return nil
+	}
+	r.Phase = "open"
+	opened, err := p.radioReacquireCall(ctx, h, r)
+	if err != nil || opened.Phase != "opened" || !opened.Barrier || opened.Writer == nil || *opened.Writer != fresh {
+		return ErrAliasConflict
+	}
+	if h.WriterParked {
+		if _, err = p.player.CompleteRadioReacquire(ctx, b, guard); err != nil {
+			return err
+		}
+	}
+	if err = p.adoptRadioIntendedOwner(r.Owner, r.Intended); err != nil {
+		return err
+	}
+	if opened.CurrentVolume == nil || !volumeCounter(opened.CurrentBase) {
+		return ErrAliasConflict
+	}
+	if err = p.adoptRadioVolume(*opened.CurrentVolume); err != nil {
+		return err
+	}
+	proof, err := p.captureRadioReacquiredWriter(ctx, h, r, opened, fresh, r.Intended, globalIntent)
+	if err != nil {
+		return err
+	}
+	if err = p.commitRadioReacquiredWriter(ctx, h, proof, cause); err != nil {
+		return err
+	}
+	failed = false
+	return nil
+}
+
+func radioAuthenticatedHTTP(ctx context.Context, endpoint, token string, payload, out any) error {
+	return radioControlHTTP(ctx, http.MethodPost, endpoint, token, payload, out)
+}
+func radioControlHTTP(ctx context.Context, method, endpoint, token string, payload, out any) error {
+	var raw []byte
+	var err error
+	if payload != nil {
+		raw, err = json.Marshal(payload)
+		if err != nil {
+			return err
+		}
+	}
+	req, err := http.NewRequestWithContext(ctx, method, endpoint, bytes.NewReader(raw))
+	if err != nil {
+		return err
+	}
+	req.Header.Set("Content-Type", "application/json")
+	req.Header.Set("X-PodConnect-Token", token)
+	client := &http.Client{Timeout: 8 * time.Second, CheckRedirect: func(*http.Request, []*http.Request) error { return ErrAliasConflict }}
+	response, err := client.Do(req)
+	if err != nil {
+		return err
+	}
+	defer response.Body.Close()
+	raw, err = io.ReadAll(io.LimitReader(response.Body, 16385))
+	if err != nil || len(raw) > 16384 || response.StatusCode != http.StatusOK {
+		return ErrAliasConflict
+	}
+	if observation, ok := out.(*radioAbsenceObservation); ok {
+		return decodeRadioAbsenceObservation(raw, observation)
+	}
+	switch typed := out.(type) {
+	case *radioPreemptReply:
+		return decodeRadioPreemptReply(raw, typed)
+	case *radioAbsenceCurrentState:
+		return decodeRadioAbsenceCurrentState(raw, typed)
+	case *radioAbsenceCurrentReply:
+		return decodeRadioAbsenceCurrentReply(raw, typed)
+	case *radioAbsenceStateUnion:
+		return decodeRadioAbsenceState(raw, typed)
+	case *radioParkedBridgeState:
+		return decodeRadioParkedBridgeState(raw, typed)
+	case *radioParkedBridgeReply:
+		return decodeRadioParkedBridgeReply(raw, typed)
+	case *radioAbsenceStartReply:
+		return decodeRadioAbsenceStartReply(raw, typed)
+	}
+	return strictVolumeJSON(raw, out)
+}
+
+func (p *AppPlayer) radioReacquireCheckpoint(h *radioHold, r radioReacquire, phase string, ack *radioReacquireReply) error {
+	app := p.app
+	app.radio.mu.Lock()
+	defer app.radio.mu.Unlock()
+	if app.radio.Holds[h.Request.TargetID] != h || (h.Phase != "reacquiring" && !(h.Phase == "content_ready" && r.Phase == "bind_start")) {
+		return ErrAliasConflict
+	}
+	copy := r
+	if r.Writer != nil {
+		w := *r.Writer
+		copy.Writer = &w
+	}
+	if r.Source != nil {
+		s := *r.Source
+		copy.Source = &s
+	}
+	h.Reacquire = &copy
+	h.ReacquirePhase = phase
+	if ack != nil {
+		h.ReacquireLatest = ack
+		h.ObservedAt = time.Now().UTC().Format(time.RFC3339Nano)
+	}
+	return app.persistRadioLocked()
+}
