+		"stale_target": func(k *radioAbsenceCustody) {
+			copy := *k.Continuity
+			copy.ValidUntil = now.Format(time.RFC3339Nano)
+			k.Continuity = &copy
+		},
+		"target_future": func(k *radioAbsenceCustody) {
+			copy := *k.Continuity
+			copy.ObservedAt = time.Now().Add(time.Second).Format(time.RFC3339Nano)
+			k.Continuity = &copy
+		},
+		"foreign_process": func(k *radioAbsenceCustody) { k.Evolution.Process = "00000000-0000-0000-0000-000000000009" },
+	}
+	for name, change := range tests {
+		t.Run(name, func(t *testing.T) {
+			k := evolved
+			change(&k)
+			var out radioAbsenceCustody
+			if decodeRadioAbsenceCustody(radioEvolutionRaw(t, k), &out) == nil {
+				t.Fatal("invalid custody branch accepted")
+			}
+		})
+	}
+	raw := strings.Replace(string(radioEvolutionRaw(t, pending)), `"target_continuity":null`, `"target_continuity":null,"extra":true`, 1)
+	var out radioAbsenceCustody
+	if decodeRadioAbsenceCustody([]byte(raw), &out) == nil {
+		t.Fatal("unknown key accepted")
+	}
+	h.Absence.Custody = &evolved
+	query := h.Request
+	query.Token = h.Absence.Binding.Token
+	wire, err := radioCustodyWire(h, query)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var fields map[string]json.RawMessage
+	_ = json.Unmarshal(radioEvolutionRaw(t, wire), &fields)
+	if len(fields) != 15 || string(fields["terminal"]) != "false" || string(fields["custody_only"]) != "true" || fields["observed_at"] != nil {
+		t.Fatal("custody became ordinary grant or fresh source observation", len(fields))
+	}
+	if string(fields["schema"]) != `"podconnect.native_radio_handoff_custody.v1"` {
+		t.Fatal("outer schema overwritten by original query")
+	}
+	query.Token = ""
+	if _, err = radioCustodyWire(h, query); err == nil {
+		t.Fatal("custody acquired a lost token")
+	}
+}
+func TestRadioAbsenceEvolutionOwnReaderPermitAndCompletionFailure(t *testing.T) {
+	app, h, op, k := radioEvolutionFixture(t)
+	immutable := contentDigest(h.Absence.Binding)
+	observed := h.ObservedAt
+	if app.absenceEvolutionPermitCurrentLocked(op) {
+		t.Fatal("global absence allowed ordinary writer")
+	}
+	if err := app.checkAbsenceEvolutionB(op); err != nil {
+		t.Fatal(err)
+	}
+	h.Phase = "prepared"
+	h.Absence.Signature = ""
+	if err := app.checkAbsenceEvolutionB(op); err == nil || h.Phase != "prepared" || h.Absence.Custody != nil {
+		t.Fatal("prepared race acquired or poisoned custody")
+	}
+	h.Phase = "suspended"
+	h.Absence.Signature = *k.Signature
+	var replyMu sync.Mutex
+	reply := k
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if strings.HasSuffix(r.URL.Path, "/radio-handoff/capabilities") {
+			replyRadioEvolutionCapability(w, h)
+			return
+		}
+		if r.Header.Get("X-PodConnect-Token") != app.cfg.RadioHandoffControlToken {
+			t.Error("missing auth")
+		}
+		replyMu.Lock()
+		defer replyMu.Unlock()
+		_ = json.NewEncoder(w).Encode(reply)
+	}))
+	defer server.Close()
+	app.cfg.RoomTransportOwnToneURL = server.URL
+	if err := app.captureAbsenceEvolutionPermit(context.Background(), op, false); err != nil {
+		t.Fatal(err)
+	}
+	if !app.radioAbsenceFence.Load() || !app.absenceEvolutionPermitCurrentLocked(op) || h.ObservedAt != observed || contentDigest(h.Absence.Binding) != immutable {
+		t.Fatal("scoped permit mutated source grant/fence")
+	}
+	originalToken := op.CReceipt.Token
+	op.CReceipt.Token = strings.Repeat("9", 32)
+	if app.absenceEvolutionPermitCurrentLocked(op) {
+		t.Fatal("foreign canonical token borrowed permit")
+	}
+	op.CReceipt.Token = originalToken
+	oldSerial := h.Absence.Custody.Evolution.Serial
+	h.Absence.Custody.Evolution.Serial = "8"
+	if app.absenceEvolutionPermitCurrentLocked(op) {
+		t.Fatal("stale batch borrowed permit")
+	}
+	h.Absence.Custody.Evolution.Serial = oldSerial
+	// C is already complete, but its independent evolution completion journal is
+	// not. The exact admitted B permit stays valid, A remains pending/fenced.
+	op.CReceipt = radioEvolutionCompleted(k).Evolution.Completion
+	if err := app.captureAbsenceEvolutionPermit(context.Background(), op, true); err == nil {
+		t.Fatal("pending audit claimed complete")
+	}
+	if !app.radioAbsenceFence.Load() || h.Phase != "evolution_pending" || !app.absenceEvolutionPermitCurrentLocked(op) {
+		t.Fatal("metadata failure revoked existing exact B writer or released A")
+	}
+	k = radioEvolutionCompleted(k)
+	replyMu.Lock()
+	reply = k
+	replyMu.Unlock()
+	if err := app.captureAbsenceEvolutionPermit(context.Background(), op, true); err != nil {
+		t.Fatal(err)
+	}
+	if app.radioAbsenceFence.Load() || !radioAbsenceEvolved(h) || radioGlobalCustodyRequired(h) || h.ObservedAt != observed || contentDigest(h.Absence.Binding) != immutable {
+		t.Fatal("completed audit changed H or failed target-only classification")
+	}
+	// B2 is independent of B1 audit: its genuine canonical command is not pinned
+	// to B1's old source/session by a historical audit.
+	other := &contentOperation{Capture: &contentCapture{Scope: roomVolumeScope{HomePodID: "102"}}}
+	if err := app.checkAbsenceEvolutionB(other); err != nil {
+		t.Fatal("historical B1 blocked newer B2", err)
+	}
+	restart := &App{cfg: app.cfg}
+	if err := restart.initRadio(); err != nil {
+		t.Fatal(err)
+	}
+	if radioAbsenceEvolved(restart.radio.Holds[h.Request.TargetID]) || !restart.radioAbsenceFence.Load() {
+		t.Fatal("journal restart restored live authority")
+	}
+}
+
+func replyRadioEvolutionCapability(w http.ResponseWriter, h *radioHold) {
+	digest := h.Absence.Binding.Digest
+	_ = json.NewEncoder(w).Encode(radioAvailabilityCapability{Schema: "podconnect.output_radio_capability.v1", Purpose: "radio_handoff_v1", Process: h.Absence.Binding.Output.Process, DeviceID: h.Absence.Binding.Output.DeviceID, Incarnation: h.Absence.Binding.Output.Incarnation, ControllerID: "ABCDEF0123456789", Protocol: true, Sourceful: true, Signing: true, Pairing: true, Digest: &digest})
+}
+
+func TestRadioAbsenceEvolutionPreEffectUnknownGlobalGuard(t *testing.T) {
+	app, h, op, _ := radioEvolutionFixture(t)
+	app.radio.failed = true
+	if err := app.checkAbsenceEvolutionB(op); err == nil {
