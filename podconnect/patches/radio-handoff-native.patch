+	"time"
+
+	"github.com/devgianlu/go-librespot/player"
+)
+
+func TestRadioActualVolumeAdoptionRetiresQueuedUpdateAndDebounce(t *testing.T) {
+	p, _ := contentFixture(t)
+	p.volumeUpdate = make(chan float32, 1)
+	p.volumeUpdate <- 0.35
+	p.radioVolumeTimer = time.NewTimer(time.Hour)
+	p.radioVolumeTimer.Reset(time.Nanosecond)
+	time.Sleep(time.Millisecond)
+	if err := p.adoptRadioVolume(20); err != nil {
+		t.Fatal(err)
+	}
+	if p.state.device.Volume != uint32(math.Round(0.20*float64(player.MaxStateVolume))) {
+		t.Fatal("receiver volume not adopted")
+	}
+	select {
+	case <-p.volumeUpdate:
+		t.Fatal("pre-handoff35 remained queued")
+	default:
+	}
+	select {
+	case <-p.radioVolumeTimer.C:
+		t.Fatal("pre-handoff35 debounce remained armed")
+	default:
+	}
+	if err := p.adoptRadioVolume(0); err != nil || p.state.device.Volume != 0 {
+		t.Fatal("actual zero receiver volume was lost")
+	}
+}
