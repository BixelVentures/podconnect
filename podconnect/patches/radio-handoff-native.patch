+	for _, raw := range []string{`{"schema":"podconnect.native_radio_handoff.v1","generation":1}`, `{"schema":"podconnect.native_radio_handoff.v1","unknown":true}`} {
+		if strictVolumeJSON([]byte(raw), &r) == nil {
+			t.Fatalf("accepted %s", raw)
+		}
+	}
+}
+
+func TestRadioPreflightCASRejectsNewerSpotifyIntentBeforeAnyEffect(t *testing.T) {
+	app := radioTestApp(t)
+	p := &AppPlayer{app: app}
+	// Decoder preparation captured revision zero. Even an identical subsequent
+	// explicit intent advances the native epoch, without depending on metadata.
+	if err := p.invalidateRadioPreflight(); err != nil {
+		t.Fatal(err)
+	}
+	request := radioRequest{Schema: "podconnect.native_radio_handoff.v1", ProcessID: strings.Repeat("a", 64), TargetID: "stue", HandoffID: "00000000-0000-0000-0000-000000000001", Generation: "1", ActionID: "00000000-0000-0000-0000-000000000002", Peer: radioPeer{"00000000-0000-0000-0000-000000000003", "1", strings.Repeat("b", 64)}, ExpectedRevision: "0"}
+	receipt, err := p.radioHandoffActor(context.Background(), radioActorRequest{Action: "reserve", Request: request, Context: context.Background()})
+	if err != nil {
+		t.Fatalf("expected durable no-effect rejection: %v", err)
+	}
+	raw, _ := json.Marshal(receipt)
+	var fields map[string]json.RawMessage
+	if json.Unmarshal(raw, &fields) != nil || string(fields["effects_started"]) != "false" || string(fields["terminal"]) != "true" || fields["proof"] != nil || fields["token"] != nil || fields["observed_at"] != nil {
+		t.Fatalf("rejection granted source authority: %s", raw)
+	}
+	if len(app.radio.Holds) != 0 || app.radio.Generation != 0 {
+		t.Fatal("stale preparation reserved custody")
+	}
+	restart := &App{cfg: app.cfg}
+	if err = restart.initRadio(); err != nil {
+		t.Fatal(err)
+	}
+	recovered, err := restart.radioReadResult(context.Background(), request)
+	if err != nil {
+		t.Fatal(err)
+	}
+	restored, _ := json.Marshal(recovered)
+	if string(raw) != string(restored) {
+		t.Fatal("lost exact rejected operation after restart")
+	}
+	if err = p.invalidateRadioPreflight(); err != nil || app.radio.Intent != 2 {
+		t.Fatal("same-track intent did not advance epoch")
+	}
+}
+
+func TestRadioReplyPreservesCurrentActionAndActualCBindingToken(t *testing.T) {
+	h := &radioHold{Request: radioRequest{Schema: "podconnect.native_radio_handoff.v1", ActionID: "reserve"}, Proof: radioCBinding{Token: strings.Repeat("c", 32), InitialVolume: 27}, Phase: "prepared"}
+	current := h.Request
+	current.ActionID = "suspend"
+	raw, err := json.Marshal(radioReply(h, current))
+	if err != nil {
+		t.Fatal(err)
+	}
+	var wire struct {
+		Schema string `json:"schema"`
+		Action string `json:"action_id"`
+		Token  string `json:"token"`
+		Proof  struct {
+			Token  string `json:"token"`
+			Volume int    `json:"initial_volume_percent"`
+		} `json:"proof"`
+	}
+	if err = json.Unmarshal(raw, &wire); err != nil {
+		t.Fatal(err)
+	}
+	if wire.Schema != "podconnect.native_radio_handoff.v1" || wire.Action != "suspend" || wire.Token != h.Proof.Token || wire.Proof.Token != h.Proof.Token || wire.Proof.Volume != 27 {
+		t.Fatalf("lost durable C binding: %s", raw)
+	}
+}
+
+func TestRadioQueuedEOFRetainedUntilSameSourceExplicitIntent(t *testing.T) {
+	app := radioTestApp(t)
+	primary := &player.Stream{}
+	p := &AppPlayer{app: app, primaryStream: primary}
+	app.radio.Holds["stue"] = &radioHold{owner: p, WriterParked: true, Phase: "suspended"}
+	for i := 0; i < 2; i++ {
+		p.handlePlayerEvent(context.Background(), &player.Event{Type: player.EventTypeNotPlaying})
+	}
+	if p.primaryStream != primary || len(p.radioDeferredEOF) != 2 {
+		t.Fatal("parked queued EOF discarded or advanced source")
+	}
+	if got := p.takeRadioDeferredEOF(); len(got) != 2 {
+		t.Fatal("did not retain exact queued EOF fanout")
+	}
+	if got := p.takeRadioDeferredEOF(); len(got) != 0 {
+		t.Fatal("replayed deferred EOF twice")
+	}
+	p.handlePlayerEvent(context.Background(), &player.Event{Type: player.EventTypeNotPlaying})
+	p.primaryStream = &player.Stream{}
+	if got := p.takeRadioDeferredEOF(); len(got) != 0 {
+		t.Fatal("old queued EOF applied to replacement decoder")
+	}
+}
+
+func TestRadioSharedCustodyKeepsUnheldPhysicalTargetUsable(t *testing.T) {
+	app := radioTestApp(t)
+	p := &AppPlayer{app: app}
+	app.radio.Holds["stue"] = &radioHold{owner: p, Phase: "suspended", RequiresPause: false, WriterParked: false}
+	if !p.radioHeld() || p.radioMutationAllowed("stue") || !p.radioMutationAllowed("kontor") {
+		t.Fatal("shared radio hold leaked physical scope")
+	}
+	app.radio.Holds["stue"].WriterParked = true
+	if p.radioMutationAllowed("kontor") {
+		t.Fatal("parked writer granted generic unheld output without C grant")
+	}
+	app.radio.Holds["stue"].WriterParked = false
+	app.radio.Holds["stue"].owner = nil
+	if p.radioMutationAllowed("kontor") {
+		t.Fatal("unknown replacement custody granted effects")
+	}
+}
+
+func TestRadioUncertainPauseRetainsQueuedEOFWithoutClaimingClosedWriter(t *testing.T) {
+	app := radioTestApp(t)
+	primary := &player.Stream{}
+	p := &AppPlayer{app: app, primaryStream: primary}
+	h := &radioHold{owner: p, RequiresPause: true, PauseUncertain: true, Phase: "unknown"}
+	app.radio.Holds["stue"] = h
+	p.handlePlayerEvent(context.Background(), &player.Event{Type: player.EventTypeNotPlaying})
+	if h.WriterParked || p.primaryStream != primary || len(p.radioDeferredEOF) != 1 {
+		t.Fatal("uncertain bounded pause advanced EOF or invented closed writer")
