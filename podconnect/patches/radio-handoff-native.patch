@@ -0,0 +1,225 @@
+package daemon
+
+import (
+	"context"
+	"encoding/json"
+	"strings"
+)
+
+// The old no-writer hold supplies receiver custody only. This separate input
+// describes the real current source; it never changes the signed historical H.
+type radioAbsenceCurrentObservation struct {
+	Source      roomVolumeRoute      `json:"source_identity"`
+	ReaderEpoch string               `json:"input_reader_epoch"`
+	Publication string               `json:"input_publication_generation"`
+	Target      radioAbsenceReceiver `json:"target_identity"`
+	Digest      string               `json:"receiver_key_digest"`
+	Percent     int                  `json:"target_volume_percent"`
+	Serial      string               `json:"evolution_serial"`
+	Effect      string               `json:"effect_generation"`
+	Members     string               `json:"member_set_digest"`
+}
+type radioAbsenceCurrentState struct {
+	Schema      string                         `json:"schema"`
+	OK          bool                           `json:"ok"`
+	Purpose     string                         `json:"purpose"`
+	Hold        radioAbsenceBinding            `json:"hold"`
+	Current     radioParkedCurrentWire         `json:"current_source"`
+	Observation radioAbsenceCurrentObservation `json:"observation"`
+	Physical    bool                           `json:"physical_result_verified"`
+}
+type radioAbsenceCurrentRequest struct {
+	Schema          string                         `json:"schema"`
+	Phase           string                         `json:"phase"`
+	Hold            radioAbsenceBinding            `json:"hold"`
+	Current         radioParkedCurrentWire         `json:"current_source"`
+	Observation     radioAbsenceCurrentObservation `json:"observation"`
+	Future          radioAbsenceFuture             `json:"future_start"`
+	IntentID        string                         `json:"intent_id"`
+	Challenge       string                         `json:"challenge,omitempty"`
+	DrainGeneration string                         `json:"drain_generation,omitempty"`
+	DrainSignature  string                         `json:"drain_signature,omitempty"`
+	VolumeKind      string                         `json:"final_volume_kind,omitempty"`
+	VolumePercent   *int                           `json:"final_volume_percent,omitempty"`
+	VolumeRevision  string                         `json:"final_volume_revision,omitempty"`
+}
+type radioAbsenceCurrentReply struct {
+	Schema      string                         `json:"schema"`
+	OK          bool                           `json:"ok"`
+	Purpose     string                         `json:"purpose"`
+	Hold        radioAbsenceBinding            `json:"hold"`
+	Current     radioParkedCurrentWire         `json:"current_source"`
+	Observation radioAbsenceCurrentObservation `json:"observation"`
+	Future      radioAbsenceFuture             `json:"future_start"`
+	IntentID    string                         `json:"intent_id"`
+	Phase       string                         `json:"phase"`
+	Challenge   string                         `json:"challenge"`
+	Signature   string                         `json:"challenge_signature"`
+	Effect      string                         `json:"effect_generation"`
+	Target      contentTarget                  `json:"target_identity"`
+	Physical    bool                           `json:"physical_result_verified"`
+}
+
+func radioAbsenceCurrentValid(h radioAbsenceBinding, c radioParkedCurrentWire, o radioAbsenceCurrentObservation) bool {
+	return c.Kind == "live" && c.Owner != nil && nativeBoundOwnerValid(*c.Owner) && c.Writer != nil && c.SourceHold == nil && c.Absence == nil && volumeCounter(c.Writer.FD) && volumeCounter(c.Writer.Epoch) && c.Writer.Epoch != "0" && volumeCounter(c.Writer.Generation) && c.Writer.Generation != "0" && c.Writer.Pipe.Type == "fifo" && volumeCounter(c.Writer.Pipe.Device) && volumeCounter(c.Writer.Pipe.Inode) && c.Writer.Process == h.Source.Process && c.Writer.InputDigest == h.Source.Digest && o.Source.valid() && o.Source.Process == h.Output.Process && o.Source.DeviceID == c.Owner.HomePodID && o.Source.InputPathDigest == c.Writer.InputDigest && o.Source.InputGeneration != "0" && o.Source.InputItemID != "0" && volumeCounter(o.ReaderEpoch) && o.ReaderEpoch != "0" && volumeCounter(o.Publication) && o.Publication != "0" && radioAbsenceReceiverValid(o.Target) && o.Target.Process == h.Output.Process && o.Target.DeviceID == h.Output.DeviceID && o.Target.Incarnation == h.Output.Incarnation && o.Digest == h.Digest && o.Percent >= 0 && o.Percent <= 100 && volumeCounter(o.Serial) && o.Serial != "0" && volumeCounter(o.Effect) && o.Effect != "0" && volumeHex64.MatchString(o.Members)
+}
+func decodeRadioAbsenceCurrentState(raw []byte, out *radioAbsenceCurrentState) error {
+	var s radioAbsenceCurrentState
+	if err := strictVolumeJSON(raw, &s); err != nil {
+		return err
+	}
+	if s.Schema != "podconnect.output_radio_absence_current_observation.v1" || !s.OK || s.Purpose != "radio_absence_current_start_v1" || s.Physical || !radioAbsenceCurrentValid(s.Hold, s.Current, s.Observation) {
+		return ErrBadRequest
+	}
+	*out = s
+	return nil
+}
+func decodeRadioAbsenceCurrentReply(raw []byte, out *radioAbsenceCurrentReply) error {
+	var s radioAbsenceCurrentReply
+	if err := strictVolumeJSON(raw, &s); err != nil {
+		return err
+	}
+	if s.Schema != "podconnect.output_radio_absence_current_start.v1" || !s.OK || s.Purpose != "radio_absence_current_start_v1" || s.Physical || !radioAbsenceCurrentValid(s.Hold, s.Current, s.Observation) || s.Future.OldOwner == nil || *s.Future.OldOwner != *s.Current.Owner || s.Future.Policy != start35Policy || s.Future.Percent != 35 || s.Future.Intended.HomePodID != s.Hold.Output.DeviceID || !nativeBoundOwnerValid(s.Future.Intended) || !volumeUUID.MatchString(s.IntentID) || !volumeHex32.MatchString(s.Challenge) || !volumeHex64.MatchString(s.Signature) || !volumeCounter(s.Effect) || s.Effect == "0" || s.Target.Process != s.Hold.Output.Process || s.Target.DeviceID != s.Hold.Output.DeviceID || s.Target.Incarnation != s.Hold.Output.Incarnation {
+		return ErrBadRequest
+	}
+	switch s.Phase {
+	case "challenge", "bound_start", "delegated", "completed", "unknown":
+	default:
+		return ErrBadRequest
+	}
+	*out = s
+	return nil
+}
+func (p *AppPlayer) radioAbsenceCurrentCall(ctx context.Context, r radioAbsenceCurrentRequest) (radioAbsenceCurrentReply, error) {
+	var out radioAbsenceCurrentReply
+	endpoint := strings.TrimSuffix(p.app.cfg.RoomTransportOwnToneURL, "/") + "/api/outputs/" + r.Hold.Output.DeviceID + "/radio-absence/current-start"
+	if err := radioControlHTTP(ctx, "POST", endpoint, p.app.cfg.RadioHandoffControlToken, r, &out); err != nil {
+		return out, err
+	}
+	if contentDigest(out.Hold) != contentDigest(r.Hold) || contentDigest(out.Current) != contentDigest(r.Current) || out.Observation != r.Observation || contentDigest(out.Future) != contentDigest(r.Future) || out.IntentID != r.IntentID || r.Challenge != "" && out.Challenge != r.Challenge {
+		return out, ErrAliasConflict
+	}
+	return out, nil
+}
+func (p *AppPlayer) bindRadioAbsenceCurrentStart(parent context.Context, h *radioHold, op *contentOperation) error {
+	if h == nil || h.Absence == nil || op == nil || op.Radio == nil {
+		return ErrAliasConflict
+	}
+	ctx, cancel := context.WithDeadline(parent, op.RadioCommitDeadline)
+	defer cancel()
+	app := p.app
+	app.radio.mu.Lock()
+	valid := !app.radio.failed && app.radio.Holds[h.Request.TargetID] == h && radioAbsenceEvolved(h) && op.Radio.ClaimIntent == app.radio.Intent
+	hold := h.Absence.Binding
+	custody := h.Absence.Custody
+	app.radio.mu.Unlock()
+	if !valid {
+		return ErrAliasConflict
+	}
+	current, err := p.captureRadioParkedCurrent(ctx, false)
+	if err != nil || current.Kind != "live" || current.Intent != op.Radio.ClaimIntent {
+		return ErrAliasConflict
+	}
+	op.mu.Lock()
+	future := radioContentFuture(op)
+	valid = op.CommitClaimed && !op.Cancelled && !op.Terminal && op.State == "committing" && op.Stream != nil && op.Stream.Source != nil && op.Prepared != nil && op.Prepared.SessionId == op.Intended.SessionID && future.OldOwner != nil && *future.OldOwner == *current.Owner && future.Intended.HomePodID == hold.Output.DeviceID
+	op.mu.Unlock()
+	if !valid {
+		return ErrAliasConflict
+	}
+	var observed radioAbsenceCurrentState
+	endpoint := strings.TrimSuffix(app.cfg.RoomTransportOwnToneURL, "/") + "/api/outputs/" + hold.Output.DeviceID + "/radio-absence/current-start-state"
+	body := struct {
+		Schema  string                 `json:"schema"`
+		Hold    radioAbsenceBinding    `json:"hold"`
+		Current radioParkedCurrentWire `json:"current_source"`
+	}{"podconnect.output_radio_absence_current_observation.v1", hold, current.wire()}
+	if err = radioControlHTTP(ctx, "POST", endpoint, app.cfg.RadioHandoffControlToken, body, &observed); err != nil {
+		return err
+	}
+	if contentDigest(observed.Hold) != contentDigest(hold) || contentDigest(observed.Current) != contentDigest(current.wire()) || observed.Observation.Serial != custody.Evolution.Serial || observed.Observation.Members != custody.Evolution.MembersDigest {
+		return ErrAliasConflict
+	}
+	if err = p.radioParkedCurrentStill(ctx, current); err != nil {
+		return err
+	}
+	id, err := randomQueueID(16)
+	if err != nil {
+		return err
+	}
+	id = id[:8] + "-" + id[8:12] + "-" + id[12:16] + "-" + id[16:20] + "-" + id[20:]
+	r := radioAbsenceCurrentRequest{Schema: "podconnect.output_radio_absence_current_start.v1", Phase: "challenge", Hold: hold, Current: current.wire(), Observation: observed.Observation, Future: future, IntentID: id}
+	persist := func(phase string, ack *radioAbsenceCurrentReply) error {
+		app.radio.mu.Lock()
+		defer app.radio.mu.Unlock()
+		if app.radio.failed || app.radio.Holds[h.Request.TargetID] != h || app.radio.Intent != op.Radio.ClaimIntent || !h.evolutionActive {
+			return ErrAliasConflict
+		}
+		copy := r
+		h.Absence.CurrentStart = &copy
+		if ack != nil {
+			a := *ack
+			h.Absence.CurrentLatest = &a
+		}
+		h.Phase = phase
+		return app.persistRadioLocked()
+	}
+	if err = persist("content_reacquiring", nil); err != nil {
+		return err
+	}
+	failed := true
+	defer func() {
+		if failed {
+			app.radio.mu.Lock()
+			h.Phase = "unknown"
+			_ = app.persistRadioLocked()
+			app.radio.mu.Unlock()
+		}
+	}()
+	challenge, err := p.radioAbsenceCurrentCall(ctx, r)
+	if err != nil || challenge.Phase != "challenge" {
+		return ErrAliasConflict
+	}
+	r.Challenge = challenge.Challenge
+	if err = persist("content_drain_pending", &challenge); err != nil {
+		return err
+	}
+	ticket, raw, err := p.radioParkedBridgeDrain(ctx, h, radioParkedBridgeRequest{IntentID: id}, challenge.Challenge, challenge.Signature, "play")
+	if err != nil {
+		return err
+	}
+	if err = p.radioParkedCurrentStill(ctx, current); err != nil {
+		return err
+	}
+	r.Phase = "commit"
+	r.DrainGeneration = ticket.Generation
+	r.DrainSignature = ticket.Signature
+	r.VolumeKind = ticket.VolumeKind
+	r.VolumePercent = ticket.VolumePercent
+	r.VolumeRevision = ticket.VolumeRevision
+	app.radio.mu.Lock()
+	h.SenderDrain = append(json.RawMessage(nil), raw...)
+	app.radio.mu.Unlock()
+	if err = persist("content_bind_pending", &challenge); err != nil {
+		return err
+	}
+	bound, err := p.radioAbsenceCurrentCall(ctx, r)
+	if err != nil || bound.Phase != "bound_start" || bound.Effect != challenge.Effect {
+		return ErrAliasConflict
+	}
+	if err = p.radioParkedCurrentStill(ctx, current); err != nil {
+		return err
+	}
+	op.mu.Lock()
+	op.Target = bound.Target
+	op.mu.Unlock()
+	if err = persist("content_bound", &bound); err != nil {
+		return err
+	}
+	failed = false
+	return nil
+}
+
+func radioAbsenceReceiverValid(r radioAbsenceReceiver) bool {
+	return volumeUUID.MatchString(r.Process) && volumeCounter(r.DeviceID) && r.DeviceID != "0" && volumeCounter(r.Incarnation) && r.Incarnation != "0" && volumeCounter(r.SessionEpoch) && volumeCounter(r.RouteRevision) && volumeCounter(r.BaseRevision) && r.BaseRevision != "0" && volumeCounter(r.AttentionRevision)
+}
