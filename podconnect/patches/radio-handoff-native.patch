+package daemon
+
+import (
+	"encoding/json"
+	"strings"
+	"testing"
+
+	"github.com/devgianlu/go-librespot/output"
+)
+
+func TestRadioAbsenceCurrentStartClosedLiveSource(t *testing.T) {
+	_, h, op, k := radioEvolutionFixture(t)
+	owner := op.Intended
+	writer := queueWriterWire{Process: h.Absence.Binding.Source.Process, FD: "8", Pipe: output.PipeIdentity{Device: "1", Inode: "2", Type: "fifo"}, Epoch: "2", Generation: "3", InputDigest: h.Absence.Binding.Source.Digest}
+	current := radioParkedCurrentWire{Kind: "live", Owner: &owner, Writer: &writer}
+	observed := radioAbsenceCurrentObservation{Source: roomVolumeRoute{k.Evolution.Process, owner.HomePodID, "1", "2", "3", "4", "2", "2", writer.InputDigest}, ReaderEpoch: "2", Publication: "3", Target: h.Absence.Binding.Output, Digest: h.Absence.Binding.Digest, Percent: 35, Serial: "1", Effect: "1", Members: k.Evolution.MembersDigest}
+	state := radioAbsenceCurrentState{Schema: "podconnect.output_radio_absence_current_observation.v1", OK: true, Purpose: "radio_absence_current_start_v1", Hold: h.Absence.Binding, Current: current, Observation: observed}
+	var decoded radioAbsenceCurrentState
+	if err := decodeRadioAbsenceCurrentState(radioEvolutionRaw(t, state), &decoded); err != nil {
+		t.Fatal("valid actual formatter shape rejected", err)
+	}
+	future := k.Evolution.Future
+	future.OldOwner = &owner
+	future.Intended.HomePodID = h.Absence.Binding.Output.DeviceID
+	future.Intended.RoomID = h.Request.TargetID
+	future.Intended.SessionID = "new-original-selected-session"
+	future.Intended.AliasRevision++
+	reply := radioAbsenceCurrentReply{Schema: "podconnect.output_radio_absence_current_start.v1", OK: true, Purpose: state.Purpose, Hold: state.Hold, Current: current, Observation: observed, Future: future, IntentID: "00000000-0000-0000-0000-000000000009", Phase: "challenge", Challenge: strings.Repeat("1", 32), Signature: strings.Repeat("2", 64), Effect: "2", Target: contentTarget{state.Hold.Output.Process, state.Hold.Output.DeviceID, state.Hold.Output.Incarnation}}
+	var out radioAbsenceCurrentReply
+	for _, phase := range []string{"challenge", "bound_start", "delegated", "completed", "unknown"} {
+		reply.Phase = phase
+		if err := decodeRadioAbsenceCurrentReply(radioEvolutionRaw(t, reply), &out); err != nil {
+			t.Fatal("legitimate closed phase rejected", phase, err)
+		}
+	}
+	for name, alter := range map[string]func(*radioAbsenceCurrentReply){
+		"historical_no_writer": func(r *radioAbsenceCurrentReply) {
+			r.Current = radioParkedCurrentWire{Kind: "global_absence", Absence: &r.Hold.Source}
+		},
+		"mixed_parked_hold":   func(r *radioAbsenceCurrentReply) { hold := radioCBinding{}; r.Current.SourceHold = &hold },
+		"no_current_oldowner": func(r *radioAbsenceCurrentReply) { r.Future.OldOwner = nil },
+		"wrong_current_session": func(r *radioAbsenceCurrentReply) {
+			n := *r.Future.OldOwner
+			n.SessionID = "old-B1"
+			r.Future.OldOwner = &n
+		},
+		"unknown_publication": func(r *radioAbsenceCurrentReply) { r.Observation.Publication = "0" },
+		"reused_epoch":        func(r *radioAbsenceCurrentReply) { w := *r.Current.Writer; w.Epoch = "0"; r.Current.Writer = &w },
+		"foreign_c_process": func(r *radioAbsenceCurrentReply) {
+			r.Observation.Source.Process = "00000000-0000-0000-0000-000000000099"
+		},
+		"old_target_not_original":  func(r *radioAbsenceCurrentReply) { r.Target.DeviceID = "999" },
+		"new_content_wrong_volume": func(r *radioAbsenceCurrentReply) { r.Future.Percent = 20 },
+	} {
+		t.Run(name, func(t *testing.T) {
+			r := reply
+			alter(&r)
+			if decodeRadioAbsenceCurrentReply(radioEvolutionRaw(t, r), &out) == nil {
+				t.Fatal("mixed/stale current authority accepted")
+			}
+		})
+	}
+	raw := strings.Replace(string(radioEvolutionRaw(t, reply)), `"phase":"unknown"`, `"phase":"unknown","fresh_ready":true`, 1)
+	if decodeRadioAbsenceCurrentReply([]byte(raw), &out) == nil {
+		t.Fatal("foreign readiness field accepted")
+	}
+	var fields map[string]json.RawMessage
+	_ = json.Unmarshal(radioEvolutionRaw(t, reply), &fields)
+	delete(fields, "effect_generation")
+	if decodeRadioAbsenceCurrentReply(radioEvolutionRaw(t, fields), &out) == nil {
+		t.Fatal("missing effect generation accepted")
+	}
+}
diff --git a/daemon/radio_absence_evolution.go b/daemon/radio_absence_evolution.go
