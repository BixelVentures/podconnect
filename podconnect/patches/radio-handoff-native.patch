@@ -0,0 +1,217 @@
+package daemon
+
+import (
+	"context"
+	"encoding/json"
+	"strings"
+)
+
+type radioParkedCurrentWire struct {
+	Kind       string                 `json:"kind"`
+	Owner      *roomTransportIdentity `json:"native_owner,omitempty"`
+	Writer     *queueWriterWire       `json:"writer_proof,omitempty"`
+	SourceHold *radioCBinding         `json:"source_hold,omitempty"`
+	Absence    *radioAbsenceSource    `json:"source_absence,omitempty"`
+}
+
+func (c *radioParkedCurrentCapture) wire() radioParkedCurrentWire {
+	out := radioParkedCurrentWire{Kind: c.Kind}
+	switch c.Kind {
+	case "live":
+		out.Owner = c.Owner
+		out.Writer = c.Writer
+	case "parked":
+		out.SourceHold = c.SourceHold
+	case "global_absence":
+		out.Absence = c.Absence
+	}
+	return out
+}
+
+type radioParkedBridgeObservation struct {
+	Source  *roomVolumeRoute     `json:"source_identity"`
+	Absence *radioAbsenceSource  `json:"source_absence"`
+	Output  radioAbsenceReceiver `json:"output_identity"`
+	Digest  string               `json:"receiver_key_digest"`
+}
+type radioParkedBridgeState struct {
+	Schema      string                       `json:"schema"`
+	OK          bool                         `json:"ok"`
+	Purpose     string                       `json:"purpose"`
+	Hold        radioParkedBinding           `json:"hold"`
+	Current     radioParkedCurrentWire       `json:"current_source"`
+	Observation radioParkedBridgeObservation `json:"observation"`
+	Physical    bool                         `json:"physical_result_verified"`
+}
+type radioParkedResumeFuture struct {
+	Intended roomTransportIdentity `json:"intended_native_owner"`
+}
+type radioParkedBridgeRequest struct {
+	Schema          string                       `json:"schema"`
+	Phase           string                       `json:"phase"`
+	Hold            radioParkedBinding           `json:"hold"`
+	IntentID        string                       `json:"intent_id"`
+	Revision        string                       `json:"native_revision"`
+	Current         radioParkedCurrentWire       `json:"current_source"`
+	Observation     radioParkedBridgeObservation `json:"observation"`
+	Resume          *radioParkedResumeFuture     `json:"future_resume,omitempty"`
+	Start           *radioAbsenceFuture          `json:"future_start,omitempty"`
+	Move            *moveCPrepare                `json:"future_move,omitempty"`
+	Challenge       string                       `json:"challenge,omitempty"`
+	DrainGeneration string                       `json:"drain_generation,omitempty"`
+	DrainSignature  string                       `json:"drain_signature,omitempty"`
+	VolumeKind      string                       `json:"final_volume_kind,omitempty"`
+	VolumePercent   *int                         `json:"final_volume_percent,omitempty"`
+	VolumeRevision  string                       `json:"final_volume_revision,omitempty"`
+	Writer          *queueWriterWire             `json:"current_writer_proof,omitempty"`
+}
+
+// Observing source and target is read-only. The child historical source_hold
+// never supplies current owner, writer or source readiness.
+func (p *AppPlayer) radioObserveParkedBridge(ctx context.Context, h *radioHold, current *radioParkedCurrentCapture) (radioParkedBridgeState, error) {
+	var out radioParkedBridgeState
+	if h == nil || h.Parked == nil || current == nil {
+		return out, ErrAliasConflict
+	}
+	request := struct {
+		Schema  string                 `json:"schema"`
+		Hold    radioParkedBinding     `json:"hold"`
+		Current radioParkedCurrentWire `json:"current_source"`
+	}{"podconnect.output_radio_parked_bridge_observation.v1", h.Parked.Binding, current.wire()}
+	endpoint := strings.TrimSuffix(p.app.cfg.RoomTransportOwnToneURL, "/") + "/api/outputs/" + h.Parked.Binding.Output.DeviceID + "/radio-parked-absence/bridge-state"
+	if err := radioControlHTTP(ctx, "POST", endpoint, p.app.cfg.RadioHandoffControlToken, request, &out); err != nil {
+		return out, err
+	}
+	if out.Schema != request.Schema || !out.OK || out.Purpose != "radio_parked_bridge_v1" || out.Physical || out.Hold != request.Hold || contentDigest(out.Current) != contentDigest(request.Current) || out.Observation.Output.Process != h.Parked.Binding.Output.Process || out.Observation.Output.DeviceID != h.Parked.Binding.Output.DeviceID || out.Observation.Output.Incarnation != h.Parked.Binding.Output.Incarnation || out.Observation.Digest != h.Parked.Binding.Digest {
+		return out, ErrAliasConflict
+	}
+	if current.Kind == "global_absence" {
+		if out.Observation.Source != nil || out.Observation.Absence == nil || contentDigest(out.Observation.Absence) != contentDigest(current.Absence) {
+			return out, ErrAliasConflict
+		}
+	} else if out.Observation.Source == nil || !out.Observation.Source.valid() || out.Observation.Absence != nil {
+		return out, ErrAliasConflict
+	} else {
+		source := out.Observation.Source
+		expectedProcess, expectedDigest := "", ""
+		if current.Kind == "live" && current.Writer != nil {
+			expectedProcess, expectedDigest = h.Parked.Binding.Output.Process, current.Writer.InputDigest
+		}
+		if current.Kind == "parked" && current.SourceHold != nil {
+			expectedProcess, expectedDigest = current.SourceHold.Output.Process, current.SourceHold.Writer.InputDigest
+		}
+		if source.Process != expectedProcess || source.InputPathDigest != expectedDigest || source.InputGeneration == "0" || source.InputItemID == "0" {
+			return out, ErrAliasConflict
+		}
+	}
+	return out, nil
+}
+
+func (p *AppPlayer) radioParkedBridgeDrain(ctx context.Context, h *radioHold, request radioParkedBridgeRequest, challenge, signature, cause string) (radioDrainTicket, json.RawMessage, error) {
+	var ticket radioDrainTicket
+	envelope, _ := json.Marshal(struct {
+		Challenge string `json:"challenge"`
+		Signature string `json:"challenge_signature"`
+	}{challenge, signature})
+	callback := radioPreemptRequest{"podconnect.radio-preempt.v1", h.Request.ProcessID, h.Request.HandoffID, h.Request.Generation, radioHoldToken(h), h.Request.TargetID, request.IntentID, cause, envelope}
+	var stopped radioPreemptReply
+	endpoint := strings.TrimSuffix(p.app.cfg.RadioHandoffOwnerURL, "/") + "/api/radio/native-preempt"
+	if err := radioAuthenticatedHTTP(ctx, endpoint, p.app.cfg.RadioHandoffControlToken, callback, &stopped); err != nil {
+		return ticket, nil, err
+	}
+	if stopped.Schema != callback.Schema || stopped.ProcessID != callback.ProcessID || stopped.HandoffID != callback.HandoffID || stopped.Generation != callback.Generation || stopped.Token != callback.Token || stopped.TargetID != callback.TargetID || stopped.ActionID != callback.ActionID || stopped.Cause != callback.Cause || !stopped.Terminal || json.Unmarshal(stopped.Ticket, &ticket) != nil || !ticket.valid(challenge) {
+		return ticket, nil, ErrAliasConflict
+	}
+	return ticket, append(json.RawMessage(nil), stopped.Ticket...), nil
+}
+
+type radioParkedBridgeReply struct {
+	Schema             string                       `json:"schema"`
+	OK                 bool                         `json:"ok"`
+	Purpose            string                       `json:"purpose"`
+	Hold               radioParkedBinding           `json:"hold"`
+	Current            radioParkedCurrentWire       `json:"current_source"`
+	Observation        radioParkedBridgeObservation `json:"observation"`
+	IntentID           string                       `json:"intent_id"`
+	Revision           string                       `json:"native_revision"`
+	Resume             *radioParkedResumeFuture     `json:"future_resume,omitempty"`
+	Start              *radioAbsenceFuture          `json:"future_start,omitempty"`
+	Move               *moveCPrepare                `json:"future_move,omitempty"`
+	Phase              string                       `json:"phase"`
+	Challenge          string                       `json:"challenge"`
+	ChallengeSignature string                       `json:"challenge_signature"`
+	RequiresPause      bool                         `json:"requires_native_pause"`
+	Barrier            bool                         `json:"writer_barrier_verified"`
+	Physical           bool                         `json:"physical_result_verified"`
+	Route              *roomVolumeRoute             `json:"route_identity"`
+	Writer             *queueWriterWire             `json:"current_writer_proof"`
+	CurrentVolume      *int                         `json:"current_volume_percent"`
+	CurrentBase        *string                      `json:"current_base_revision"`
+	EffectGeneration   string                       `json:"effect_generation"`
+	ExecutionVolume    *int                         `json:"execution_volume_percent,omitempty"`
+}
+
+func (p *AppPlayer) radioParkedBridgeCheckpoint(h *radioHold, r radioParkedBridgeRequest, intent uint64, phase string, ack *radioParkedBridgeReply) error {
+	app := p.app
+	app.radio.mu.Lock()
+	defer app.radio.mu.Unlock()
+	if app.radio.failed || app.radio.Holds[h.Request.TargetID] != h || h.Parked == nil || app.radio.Intent != intent {
+		return ErrAliasConflict
+	}
+	if ack != nil && (!volumeCounter(ack.EffectGeneration) || ack.EffectGeneration == "0" || h.ParkedBridgeLatest != nil && h.ParkedBridgeLatest.IntentID == r.IntentID && h.ParkedBridgeLatest.EffectGeneration != ack.EffectGeneration) {
+		return ErrAliasConflict
+	}
+	snapshot := r
+	h.ParkedBridge = &snapshot
+	h.ParkedBridgePhase = phase
+	if ack != nil {
+		copyAck := *ack
+		h.ParkedBridgeLatest = &copyAck
+	}
+	return app.persistRadioLocked()
+}
+func (p *AppPlayer) radioParkedBridgeCall(ctx context.Context, h *radioHold, r radioParkedBridgeRequest, intent uint64) (radioParkedBridgeReply, error) {
+	var out radioParkedBridgeReply
+	if ctx.Err() != nil {
+		return out, ctx.Err()
+	}
+	branches := 0
+	if r.Resume != nil {
+		branches++
+	}
+	if r.Start != nil {
+		branches++
+	}
+	if r.Move != nil {
+		branches++
+	}
+	if branches != 1 {
+		return out, ErrAliasConflict
+	}
+	if r.Phase != "state" {
+		if err := p.radioParkedBridgeCheckpoint(h, r, intent, r.Phase+"_attempted", nil); err != nil {
+			return out, err
+		}
+	}
+	endpoint := strings.TrimSuffix(p.app.cfg.RoomTransportOwnToneURL, "/") + "/api/outputs/" + r.Hold.Output.DeviceID + "/radio-parked-absence/bridge"
+	payload := r
+	if payload.Phase == "state" {
+		payload.DrainGeneration, payload.DrainSignature, payload.VolumeKind, payload.VolumeRevision = "", "", "", ""
+		payload.VolumePercent, payload.Writer = nil, nil
+	}
+	if err := radioControlHTTP(ctx, "POST", endpoint, p.app.cfg.RadioHandoffControlToken, payload, &out); err != nil {
+		return out, err
+	}
+	if out.Schema != r.Schema || !out.OK || out.Purpose != "radio_parked_bridge_v1" || out.Physical || out.Hold != r.Hold || contentDigest(out.Current) != contentDigest(r.Current) || contentDigest(out.Observation) != contentDigest(r.Observation) || out.IntentID != r.IntentID || out.Revision != r.Revision || contentDigest(out.Resume) != contentDigest(r.Resume) || contentDigest(out.Start) != contentDigest(r.Start) || contentDigest(out.Move) != contentDigest(r.Move) || !volumeHex32.MatchString(out.Challenge) || !volumeHex64.MatchString(out.ChallengeSignature) || r.Challenge != "" && out.Challenge != r.Challenge || out.RequiresPause != (r.Current.Kind == "parked") {
+		return out, ErrAliasConflict
+	}
+	switch out.Phase {
+	case "challenge", "consumed", "connecting", "route_ready", "barrier_ready", "opened", "bound_start", "bound_move", "delegated", "completed", "unknown":
+	default:
+		return out, ErrAliasConflict
+	}
+	if err := p.radioParkedBridgeCheckpoint(h, r, intent, out.Phase, &out); err != nil {
+		return out, err
+	}
+	return out, nil
+}
