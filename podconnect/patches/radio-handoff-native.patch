+package daemon
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"net/http"
+	"net/http/httptest"
+	"path/filepath"
+	"strings"
+	"sync/atomic"
+	"syscall"
+	"testing"
+)
+
+// Test-only independent corroboration for the actual idle HTTP fixture. These
+// reads grant no command and must not create a Spotify actor, writer or hold.
+func radioAssertIdleAvailability(t *testing.T, ctx context.Context, app *App, target, device string, source radioAbsenceSource) bool {
+	t.Helper()
+	app.radio.mu.Lock()
+	intent, generation, holds := app.radio.Intent, app.radio.Generation, len(app.radio.Holds)
+	app.radio.mu.Unlock()
+	base := strings.TrimSuffix(app.cfg.RoomTransportOwnToneURL, "/") + "/api/outputs/" + device
+	var capability radioAvailabilityCapability
+	if err := radioControlHTTP(ctx, http.MethodGet, base+"/radio-handoff/capabilities", app.cfg.RadioHandoffControlToken, nil, &capability); err != nil || capability.Schema != "podconnect.output_radio_capability.v1" || capability.Purpose != "radio_handoff_v1" || !radioControllerIDValid(capability.ControllerID) || capability.DeviceID != device || !volumeUUID.MatchString(capability.Process) || !volumeCounter(capability.Incarnation) || capability.Incarnation == "0" || capability.Physical {
+		t.Fatal("actual idle capability metadata unavailable", err)
+	}
+	metadataSupported := capability.Protocol && capability.Signing && capability.Pairing && capability.Digest != nil && volumeHex64.MatchString(*capability.Digest)
+	expected := false
+	admissionOpen := false
+	if metadataSupported {
+		var admission radioAvailabilityAdmission
+		admissionOpen = radioControlHTTP(ctx, http.MethodGet, base+"/radio-admission", app.cfg.RadioHandoffControlToken, nil, &admission) == nil && admission.Schema == "podconnect.output_radio_admission.v1" && !admission.Physical && admission.Open && admission.Process == capability.Process && admission.DeviceID == capability.DeviceID && admission.Incarnation == capability.Incarnation
+	}
+	if metadataSupported && admissionOpen && capability.Absence {
+		request := struct {
+			Schema string             `json:"schema"`
+			Source radioAbsenceSource `json:"source_absence"`
+		}{"podconnect.output_radio_absence_observation.v1", source}
+		var observed radioAbsenceObservation
+		if radioControlHTTP(ctx, http.MethodPost, base+"/radio-absence/observe", app.cfg.RadioHandoffControlToken, request, &observed) == nil && observed.Schema == request.Schema && observed.OK && !observed.Physical && observed.Absent && observed.Proof != nil {
+			proof := observed.Proof
+			expected = radioAbsenceCoreEqual(proof.Source, source) && proof.Output.DeviceID == device && proof.Output.Process == capability.Process && proof.Output.Incarnation == capability.Incarnation && proof.Digest == *capability.Digest && proof.InitialVolume >= 0 && proof.InitialVolume <= 100 && observed.VolumeProvenance == "stored_manual_base"
+		}
+	}
+	var state struct {
+		Controller string        `json:"controller_id"`
+		Targets    []radioTarget `json:"configured_targets"`
+		Missing    []string      `json:"missing_proofs"`
+	}
+	raw, _ := json.Marshal(app.radioStateObserved(ctx))
+	if json.Unmarshal(raw, &state) != nil || (metadataSupported && state.Controller != capability.ControllerID || !metadataSupported && state.Controller != "") || len(state.Targets) != 1 || state.Targets[0].ID != target || state.Targets[0].HomePodID != device {
+		t.Fatal("actual target/controller mapping disagrees with read-only C metadata")
+	}
+	if state.Targets[0].Selectable != expected || state.Targets[0].Availability != map[bool]string{true: "available", false: "unknown"}[expected] || expected && len(state.Missing) != 0 || !expected && (len(state.Missing) != 1 || state.Missing[0] != "fresh_receiver_source_proof") {
+		t.Fatal("availability is not backed by actual per-target proof")
+	}
+	app.radio.mu.Lock()
+	unchanged := app.radio.Intent == intent && app.radio.Generation == generation && len(app.radio.Holds) == holds
+	app.radio.mu.Unlock()
+	app.ownerMu.Lock()
+	unchanged = unchanged && app.currentPlayer == nil && app.currentAPI == nil && app.currentDone == nil
+	app.ownerMu.Unlock()
+	app.moveCustodyMu.Lock()
+	unchanged = unchanged && app.openedWriterOwner == nil && app.openedWriterGeneration == 0 && app.startCustody == nil && app.moveCustody == nil
+	app.moveCustodyMu.Unlock()
+	after, err := app.radioAbsenceSource()
+	if !unchanged || err != nil || !radioAbsenceCoreEqual(after, source) {
+		t.Fatal("read-only availability changed source/process/FIFO or created authority", err)
+	}
+	return expected
+}
+
+func TestRadioIdleAvailabilityRequiresFreshProofAndCleanJournal(t *testing.T) {
+	// These explicit C HTTP fixtures test Native composition only; actual C43
+	// startup latch and physical pairing are proven in separate real wire runs.
+	for _, mode := range []string{"available", "metadata_only", "unsupported", "wrong_process", "failed_journal", "unknown_hold"} {
+		t.Run(mode, func(t *testing.T) {
+			app := radioTestApp(t)
+			app.cfg.DeviceAliases = []string{"Stuen"}
+			app.cfg.DeviceAliasRoomIDs = []string{"stue"}
+			app.cfg.DeviceAliasHomePodIDs = []string{"101"}
+			app.cfg.RoomTransportOwnToneURL = "http://127.0.0.1:8081"
+			app.cfg.AudioBackend = "pipe"
+			app.cfg.ExternalVolume = true
+			app.cfg.AudioOutputPipeFormat = "s16le"
+			app.cfg.AudioOutputPipe = filepath.Join(t.TempDir(), "idle.fifo")
+			if err := syscall.Mkfifo(app.cfg.AudioOutputPipe, 0600); err != nil {
+				t.Fatal(err)
+			}
+			source, err := app.radioAbsenceSource()
+			if err != nil {
+				t.Fatal(err)
+			}
+			digest := strings.Repeat("c", 64)
+			var gets, admissions, observes, effects atomic.Int32
+			capability := radioAvailabilityCapability{Schema: "podconnect.output_radio_capability.v1", Purpose: "radio_handoff_v1", Process: "00000000-0000-0000-0000-000000000001", DeviceID: "101", Incarnation: "1", ControllerID: "ABCDEF0123456789", Protocol: true, Absence: mode != "unsupported", Signing: true, Pairing: true, Digest: &digest}
+			server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				if r.Header.Get("X-PodConnect-Token") != app.cfg.RadioHandoffControlToken {
+					t.Error("missing authentication")
+					w.WriteHeader(403)
+					return
+				}
+				if r.Method == http.MethodGet && strings.HasSuffix(r.URL.Path, "/radio-handoff/capabilities") {
+					gets.Add(1)
+					_ = json.NewEncoder(w).Encode(capability)
+					return
+				}
+				if r.Method == http.MethodGet && strings.HasSuffix(r.URL.Path, "/radio-admission") {
+					admissions.Add(1)
+					_ = json.NewEncoder(w).Encode(radioAvailabilityAdmission{"podconnect.output_radio_admission.v1", capability.Process, capability.DeviceID, capability.Incarnation, true, false})
+					return
+				}
+				if r.Method == http.MethodPost && strings.HasSuffix(r.URL.Path, "/radio-absence/observe") {
+					observes.Add(1)
+					if mode == "metadata_only" {
+						_ = json.NewEncoder(w).Encode(radioAbsenceObservation{Schema: "podconnect.output_radio_absence_observation.v1", OK: true})
+						return
+					}
+					proof := &radioAbsenceBinding{Schema: "podconnect.output_radio_absence.v1", Source: source, Output: radioAbsenceReceiver{Process: capability.Process, DeviceID: "101", Incarnation: "1", SessionEpoch: "0", RouteRevision: "0", BaseRevision: "1", AttentionRevision: "0"}, Digest: digest, InitialVolume: 35, VolumeProvenance: "stored_manual_base"}
+					if mode == "wrong_process" {
+						proof.Output.Process = "00000000-0000-0000-0000-000000000099"
+					}
+					_ = json.NewEncoder(w).Encode(radioAbsenceObservation{Schema: "podconnect.output_radio_absence_observation.v1", OK: true, Absent: true, Proof: proof, VolumeProvenance: "stored_manual_base"})
+					return
+				}
+				effects.Add(1)
+				w.WriteHeader(500)
+			}))
+			defer server.Close()
+			app.cfg.RoomTransportOwnToneURL = server.URL
+			if mode == "failed_journal" {
+				app.radio.failed = true
+			}
+			if mode == "unknown_hold" {
+				_, h, _, _ := radioEvolutionFixture(t)
+				h.Phase = "unknown"
+				app.radio.Holds["stue"] = h
+			}
+			if mode == "failed_journal" || mode == "unknown_hold" {
+				raw, _ := json.Marshal(app.radioStateObserved(context.Background()))
+				var state struct {
+					Targets []radioTarget `json:"configured_targets"`
+					Missing []string      `json:"missing_proofs"`
+				}
+				_ = json.Unmarshal(raw, &state)
+				wantMetadataReads := int32(0)
+				if mode == "unknown_hold" {
+					wantMetadataReads = 1 // controller metadata only; no admission/source probe.
+				}
+				if len(state.Targets) != 1 || state.Targets[0].Selectable || state.Targets[0].Availability != "unknown" || state.Targets[0].ReceiverDigest != "" || len(state.Missing) == 0 || gets.Load() != wantMetadataReads || admissions.Load() != 0 || observes.Load() != 0 {
+					t.Fatal("failed/unknown custody bypassed quarantine")
+				}
+			} else if got := radioAssertIdleAvailability(t, context.Background(), app, "stue", "101", source); got != (mode == "available") {
+				t.Fatal("wrong availability result")
+			}
+			if effects.Load() != 0 || app.openedWriterGeneration != 0 || app.currentPlayer != nil {
+				t.Fatal("availability caused an effect")
+			}
+		})
+	}
+}
+
+// Observation-only completion is a negative effect oracle, not a hold or grant.
+func radioIdleObservationUnchanged(app *App, source radioAbsenceSource) error {
+	app.radio.mu.Lock()
+	clean := !app.radio.failed && len(app.radio.Holds) == 0 && app.radio.Intent == 0 && app.radio.Generation == 0
+	app.radio.mu.Unlock()
+	app.ownerMu.Lock()
+	clean = clean && app.currentPlayer == nil && app.currentAPI == nil && app.currentDone == nil
+	app.ownerMu.Unlock()
+	app.moveCustodyMu.Lock()
+	clean = clean && app.openedWriterOwner == nil && app.openedWriterGeneration == 0 && app.openedWriter.FD == "" && app.startCustody == nil && app.moveCustody == nil && app.startOutputPermit == nil && app.retirementPending == nil
+	app.moveCustodyMu.Unlock()
+	after, err := app.radioAbsenceSource()
+	if !clean || err != nil || source.Kind != "global" || source.Live != nil || !radioAbsenceCoreEqual(after, source) {
+		return fmt.Errorf("idle observation changed custody/process/FIFO/source or created player/writer")
+	}
+	return nil
+}
+func TestRadioIdleObservationOnlyHasNoCommandAuthority(t *testing.T) {
+	app := radioTestApp(t)
+	app.cfg.RoomTransportOwnToneURL = "http://127.0.0.1:8081"
+	app.cfg.AudioBackend = "pipe"
+	app.cfg.ExternalVolume = true
+	app.cfg.AudioOutputPipeFormat = "s16le"
+	app.cfg.AudioOutputPipe = filepath.Join(t.TempDir(), "observe.fifo")
+	if err := syscall.Mkfifo(app.cfg.AudioOutputPipe, 0600); err != nil {
+		t.Fatal(err)
+	}
+	source, err := app.radioAbsenceSource()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err = radioIdleObservationUnchanged(app, source); err != nil {
+		t.Fatal(err)
+	}
+	for _, kind := range []string{"intent", "generation", "hold", "writer"} {
+		t.Run(kind, func(t *testing.T) {
+			switch kind {
+			case "intent":
+				app.radio.Intent = 1
+			case "generation":
+				app.radio.Generation = 1
+			case "hold":
+				app.radio.Holds["stue"] = &radioHold{}
+			case "writer":
+				app.openedWriterGeneration = 1
+			}
+			if radioIdleObservationUnchanged(app, source) == nil {
+				t.Fatal("effectful observation-only fixture accepted")
+			}
+			app.radio.Intent = 0
+			app.radio.Generation = 0
+			delete(app.radio.Holds, "stue")
+			app.openedWriterGeneration = 0
+		})
+	}
+}
