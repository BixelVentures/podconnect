@@ -0,0 +1,84 @@
+package daemon
+
+import (
+	"context"
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"path/filepath"
+	"strings"
+	"sync/atomic"
+	"testing"
+)
+
+// A locally admitted actor fixture exercises the real HTTP/offer/claim path.
+// It does not stand in for a Spotify login, C custody or HomePod acceptance.
+func TestRadioBoundContentBrowseAndClaimPreserveCurrentPlayback(t *testing.T) {
+	p, seed := contentFixture(t)
+	var calls atomic.Int32
+	cserver := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) { calls.Add(1); w.WriteHeader(500) }))
+	defer cserver.Close()
+	p.app.cfg.RadioHandoffControlToken = strings.Repeat("f", 32)
+	p.app.cfg.RadioHandoffOwnerURL = cserver.URL
+	p.app.cfg.RadioHandoffStatePath = filepath.Join(t.TempDir(), "radio.json")
+	p.app.cfg.RoomTransportOwnToneURL = cserver.URL
+	seed.Capture.OwnTone = cserver.URL
+	h := &radioHold{owner: p, Request: radioRequest{TargetID: "r1", HandoffID: "00000000-0000-0000-0000-000000000001", Generation: "1"}, Proof: radioCBinding{Token: strings.Repeat("e", 32)}, Phase: "suspended", Latest: &radioCReply{Phase: "suspended"}, WriterParked: true}
+	p.app.radio.Holds = map[string]*radioHold{"r1": h}
+	stage, err := p.radioContentSnapshot(seed.Capture.Scope)
+	if err != nil {
+		t.Fatal(err)
+	}
+	seed.Capture.Radio = stage
+	oldState, oldPlayer, oldTracks, oldPrimary := p.state, p.state.player, p.state.tracks, p.primaryStream
+	server := &ConcreteApiServer{requests: make(chan ApiRequest)}
+	done := make(chan struct{})
+	defer close(done)
+	go func() {
+		for {
+			select {
+			case <-done:
+				return
+			case req := <-server.requests:
+				if req.Type == apiContentObserve {
+					req.Reply(seed.Capture, nil)
+				} else {
+					value, e := p.handleApiRequest(context.Background(), req)
+					req.Reply(value, e)
+				}
+			}
+		}
+	}()
+	req := httptest.NewRequest("GET", "/player/room_content/controls?account_user_id=account&target_id=engine&room_id=r1&homepod_id=202", nil)
+	recorder := httptest.NewRecorder()
+	server.handleContentControls(recorder, req)
+	if recorder.Code != 200 {
+		t.Fatalf("controls rejected %d %s", recorder.Code, recorder.Body.String())
+	}
+	var controls struct {
+		Schema   string       `json:"schema"`
+		Ready    bool         `json:"ready"`
+		Offer    contentOffer `json:"start_offer"`
+		Physical bool         `json:"physical_result_verified"`
+	}
+	if err = json.Unmarshal(recorder.Body.Bytes(), &controls); err != nil {
+		t.Fatal(err)
+	}
+	if controls.Schema != "podconnect.native_room_content_controls.v1" || !controls.Ready || controls.Physical || !volumeHex32.MatchString(controls.Offer.OfferID) || !volumeHex64.MatchString(controls.Offer.BindingID) {
+		t.Fatal(recorder.Body.String())
+	}
+	if calls.Load() != 0 || p.app.radio.Intent != 0 || p.state != oldState || p.state.player != oldPlayer || p.state.tracks != oldTracks || p.primaryStream != oldPrimary {
+		t.Fatal("read-only browsing changed playback or manufactured C observation")
+	}
+	op := server.roomContents.get(controls.Offer.OfferID, controls.Offer.BindingID)
+	if op == nil || op.Radio != stage || op.Target != (contentTarget{}) {
+		t.Fatal("deferred target was presented as C proof")
+	}
+	request := contentPrepareRequest{Scope: seed.Capture.Scope, Offer: controls.Offer, Action: "play_track", Args: contentArgs{TrackURI: "spotify:track:0123456789012345678901", MaxVolume: 35}}
+	if _, err = p.handleApiRequest(context.Background(), ApiRequest{Type: apiContentClaim, Data: contentActorRequest{Operation: op, Context: context.Background(), Request: request}}); err != nil {
+		t.Fatal(err)
+	}
+	if calls.Load() != 0 || !op.Claimed || op.URI != request.Args.TrackURI || op.Offer != controls.Offer || op.Radio.ClaimIntent != p.app.radio.Intent || p.state != oldState || p.state.player != oldPlayer || p.state.tracks != oldTracks || p.primaryStream != oldPrimary {
+		t.Fatal("claim changed sound/queue or lost original authorized URI")
+	}
+}
diff --git a/daemon/radio_global_content_admission.go b/daemon/radio_global_content_admission.go
new file mode 100644
index 0000000..d2dc25a
--- /dev/null
+++ b/daemon/radio_global_content_admission.go
@@ -0,0 +1,61 @@
+package daemon
+
+// Only staging/consuming a canonical cold START on an unrelated receiver is
+// eligible here. This is not output permission: existing C evolution admission,
+// reader-ready receipt and exact evolution permit still precede construction.
+func (p *AppPlayer) radioGlobalContentAdmission(request contentActorRequest) bool {
+	if p == nil || p.app == nil || request.Context == nil || request.Context.Err() != nil || request.Operation == nil {
+		return false
+	}
+	op := request.Operation
+	p.aliasMu.Lock()
+	defer p.aliasMu.Unlock()
+	op.mu.Lock()
+	defer op.mu.Unlock()
+	c := op.Capture
+	if op.Owner != p || op.Radio != nil || c == nil || c.Radio != nil || op.Cancelled || op.Terminal || c.Primary != nil || c.Source != nil || c.OldOwner != nil || c.SessionID != "" || !p.contentCurrentLocked(c) {
+		return false
+	}
+	targetMapped := false
+	for _, alias := range p.aliasRegistry {
+		if alias.ID == c.TargetAlias && alias.RoomID == c.Scope.RoomID && alias.HomePodID == c.Scope.HomePodID {
+			targetMapped = true
+		}
+	}
+	if !targetMapped || !homePodIDPattern.MatchString(c.Scope.HomePodID) {
+		return false
+	}
+	// Reuse the existing production pre-PREPARE policy; it must also be checked
+	// again at commit, and cannot replace the later C-derived evolution permit.
+	if p.app.checkAbsenceEvolutionB(op) != nil {
+		return false
+	}
+	current, err := p.app.radioAbsenceSource()
+	if err != nil || current.Process != c.Process || current.Path != c.Pipe || current.Digest != c.PipeDigest {
+		return false
+	}
+	app := p.app
+	app.radio.mu.Lock()
+	defer app.radio.mu.Unlock()
+	if app.radio.failed || len(app.radio.Holds) == 0 || app.radio.Holds[c.Scope.RoomID] != nil {
+		return false
+	}
+	devices, digests := map[string]bool{}, map[string]bool{}
+	for room, h := range app.radio.Holds {
+		if h == nil || !validRadioRequest(h.Request) || h.Request.ProcessID != radioProcessID(c.Process) || h.Request.TargetID != room || room == c.Scope.RoomID || h.owner != nil || h.primary != nil || h.Parked != nil || h.Absence == nil || h.WriterParked || h.RequiresPause || h.PauseUncertain || h.Phase != "suspended" || radioAbsenceEvolved(h) || !radioGlobalCustodyRequired(h) || h.Absence.Custody != nil || h.evolutionActive || !volumeHex64.MatchString(h.Absence.Signature) {
+			return false
+		}
+		b := h.Absence.Binding
+		heldMapped := false
+		for _, alias := range p.aliasRegistry {
+			if alias.RoomID == room && alias.HomePodID == b.Output.DeviceID {
+				heldMapped = true
+			}
+		}
+		if !heldMapped || b.Schema != "podconnect.output_radio_absence.v1" || b.HandoffID != h.Request.HandoffID || b.Generation != h.Request.Generation || !volumeCounter(b.Revision) || b.Revision == "0" || b.RadioProcess != h.Request.Peer.Process || b.RadioEpoch != h.Request.Peer.Epoch || b.SenderPeer != h.Request.Peer.Process || b.Digest != h.Request.Peer.Digest || b.Source.Kind != "global" || b.Source.Live != nil || !radioAbsenceCoreEqual(b.Source, current) || !radioAbsenceReceiverValid(b.Output) || b.Output.DeviceID == c.Scope.HomePodID || !volumeHex32.MatchString(b.Token) || !volumeHex64.MatchString(b.Digest) || b.VolumeProvenance != "stored_manual_base" || b.InitialVolume < 0 || b.InitialVolume > 100 || devices[b.Output.DeviceID] || digests[b.Digest] {
+			return false
+		}
+		devices[b.Output.DeviceID], digests[b.Digest] = true, true
+	}
+	return true
+}
