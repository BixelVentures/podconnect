diff --git a/daemon/radio_absence_observation.go b/daemon/radio_absence_observation.go
new file mode 100644
index 0000000..507efb8
--- /dev/null
+++ b/daemon/radio_absence_observation.go
@@ -0,0 +1,59 @@
+package daemon
+
+import (
+	"bytes"
+	"encoding/json"
+)
+
+// The C observation is a closed union: source presence has an explicit null
+// proof, while absence carries the full independently validated proof. Keep
+// this nullable field out of the generic non-null command decoder.
+func decodeRadioAbsenceObservation(raw []byte, out *radioAbsenceObservation) error {
+	var fields map[string]json.RawMessage
+	if err := strictVolumeJSON(raw, &fields); err != nil {
+		return err
+	}
+	if len(fields) != 6 {
+		return ErrBadRequest
+	}
+	for _, key := range []string{"schema", "ok", "source_absent", "proof", "volume_provenance", "physical_result_verified"} {
+		if _, exists := fields[key]; !exists {
+			return ErrBadRequest
+		}
+	}
+	proof := fields["proof"]
+	delete(fields, "proof")
+	metadata, err := json.Marshal(fields)
+	if err != nil {
+		return err
+	}
+	var wire struct {
+		Schema           string `json:"schema"`
+		OK               bool   `json:"ok"`
+		Absent           bool   `json:"source_absent"`
+		VolumeProvenance string `json:"volume_provenance"`
+		Physical         bool   `json:"physical_result_verified"`
+	}
+	if err = strictVolumeJSON(metadata, &wire); err != nil {
+		return err
+	}
+	if wire.Schema != "podconnect.output_radio_absence_observation.v1" || !wire.OK || wire.Physical {
+		return ErrBadRequest
+	}
+	candidate := radioAbsenceObservation{Schema: wire.Schema, OK: wire.OK, Absent: wire.Absent, VolumeProvenance: wire.VolumeProvenance, Physical: wire.Physical}
+	if !wire.Absent {
+		if !bytes.Equal(bytes.TrimSpace(proof), []byte("null")) || wire.VolumeProvenance != "" {
+			return ErrBadRequest
+		}
+	} else {
+		if wire.VolumeProvenance != "stored_manual_base" {
+			return ErrBadRequest
+		}
+		candidate.Proof = new(radioAbsenceBinding)
+		if err = strictVolumeJSON(proof, candidate.Proof); err != nil {
+			return err
+		}
+	}
+	*out = candidate
+	return nil
+}
diff --git a/daemon/radio_absence_observation_test.go b/daemon/radio_absence_observation_test.go
new file mode 100644
index 0000000..d5ca374
--- /dev/null
+++ b/daemon/radio_absence_observation_test.go
@@ -0,0 +1,62 @@
+package daemon
+
+import (
+	"context"
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+)
+
+func TestRadioAbsenceObservationClosedSourcePresence(t *testing.T) {
+	const present = `{"schema":"podconnect.output_radio_absence_observation.v1","ok":true,"source_absent":false,"proof":null,"volume_provenance":"","physical_result_verified":false}`
+	var generic radioAbsenceObservation
+	if strictVolumeJSON([]byte(present), &generic) == nil {
+		t.Fatal("generic non-null command decoder unexpectedly accepts null")
+	}
+	tests := map[string]string{
+		"valid_false_null": present,
+		"missing_proof":    strings.Replace(present, `"proof":null,`, "", 1),
+		"unknown_field":    strings.Replace(present, `"proof":null`, `"proof":null,"unexpected":true`, 1),
+		"true_null":        strings.Replace(present, `"source_absent":false`, `"source_absent":true`, 1),
+		"false_nonnull":    strings.Replace(present, `"proof":null`, `"proof":{}`, 1),
+		"null_boolean":     strings.Replace(present, `"source_absent":false`, `"source_absent":null`, 1),
+		"duplicate_proof":  strings.Replace(present, `"proof":null`, `"proof":null,"proof":null`, 1),
+		"physical_claim":   strings.Replace(present, `"physical_result_verified":false`, `"physical_result_verified":true`, 1),
+	}
+	for name, raw := range tests {
+		t.Run(name, func(t *testing.T) {
+			var observed radioAbsenceObservation
+			err := decodeRadioAbsenceObservation([]byte(raw), &observed)
+			if name == "valid_false_null" {
+				if err != nil || observed.Absent || observed.Proof != nil || !observed.OK {
+					t.Fatal("actual source-presence observation rejected", err)
+				}
+			} else if err == nil {
+				t.Fatal("malformed union accepted")
+			}
+		})
+	}
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if r.Header.Get("X-PodConnect-Token") != "private-test-token" {
+			t.Error("missing actual radio authentication header")
+		}
+		w.Header().Set("Content-Type", "application/json")
+		_, _ = w.Write([]byte(present))
+	}))
+	defer server.Close()
+	var observed radioAbsenceObservation
+	if err := radioControlHTTP(context.Background(), "POST", server.URL, "private-test-token", struct{}{}, &observed); err != nil || observed.Absent || observed.Proof != nil {
+		t.Fatal("HTTP path failed sourceful-lane observation", err)
+	}
+	// The special decoder cannot grant an absence from a structurally incomplete
+	// positive branch; semantic process/target/kernel proof remains in the actor.
+	raw, err := json.Marshal(map[string]any{"schema": "podconnect.output_radio_absence_observation.v1", "ok": true, "source_absent": true, "proof": map[string]any{}, "volume_provenance": "stored_manual_base", "physical_result_verified": false})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if decodeRadioAbsenceObservation(raw, &observed) == nil {
+		t.Fatal("incomplete positive absence proof accepted")
+	}
+}
diff --git a/daemon/radio_absence_start.go b/daemon/radio_absence_start.go
