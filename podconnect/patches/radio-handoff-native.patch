+}
+
+func TestRadioAbsenceEvolutionCompletionSingleSnapshot(t *testing.T) {
+	_, _, _, pending := radioEvolutionFixture(t)
+	valid := radioEvolutionCompleted(pending)
+	if !radioEvolutionCompletionMatches(valid.Evolution.Completion, valid.Evolution) {
+		t.Fatal("actual completed formatter shape refused")
+	}
+	for name, alter := range map[string]func(*contentCReceipt){
+		"target_process":     func(p *contentCReceipt) { p.Target.Process = "00000000-0000-0000-0000-000000000099" },
+		"target_device":      func(p *contentCReceipt) { p.Target.DeviceID = "999" },
+		"target_incarnation": func(p *contentCReceipt) { p.Target.Incarnation = "9" },
+		"route_input_digest": func(p *contentCReceipt) { p.Route.InputPathDigest = strings.Repeat("f", 64) },
+		"input_epoch":        func(p *contentCReceipt) { p.InputEpoch = "0" },
+		"writer_epoch":       func(p *contentCReceipt) { p.WriterEpoch = "0" },
+		"possible_effect":    func(p *contentCReceipt) { p.Possible = false },
+		"closed_gate":        func(p *contentCReceipt) { p.GateClosed = true },
+	} {
+		t.Run(name, func(t *testing.T) {
+			k := valid
+			p := *valid.Evolution.Completion
+			route := *p.Route
+			p.Route = &route
+			k.Evolution.Completion = &p
+			alter(&p)
+			if radioEvolutionCompletionMatches(&p, k.Evolution) {
+				t.Fatal("mixed/non-completed snapshot credited")
+			}
+			var decoded radioAbsenceCustody
+			if decodeRadioAbsenceCustody(radioEvolutionRaw(t, k), &decoded) == nil {
+				t.Fatal("mixed P released evolution decoder boundary")
+			}
