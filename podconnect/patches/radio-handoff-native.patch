+
+func TestRadioRelease56ManualPendingRejectsBeforeIntent(t *testing.T) {
+	app := radioTestApp(t)
+	p := &AppPlayer{app: app}
+	app.manualRelease = &nativeTransportOffer{}
+	before := app.radio.Intent
+	for _, kind := range []ApiRequestType{ApiRequestTypeResume, ApiRequestTypePause, ApiRequestTypePlay, ApiRequestTypeNext, ApiRequestTypeSetVolume} {
+		if _, err := p.handleApiRequest(context.Background(), ApiRequest{Type: kind}); err != ErrAliasConflict {
+			t.Fatalf("%s admitted during manual release: %v", kind, err)
+		}
+	}
+	for _, kind := range []mpris.MediaPlayer2PlayerCommandType{mpris.MediaPlayer2PlayerCommandTypePlay, mpris.MediaPlayer2PlayerCommandTypePause} {
+		if err := p.handleMprisEvent(context.Background(), mpris.MediaPlayer2PlayerCommand{Type: kind}); err != ErrAliasConflict {
+			t.Fatalf("MPRIS admitted during manual release: %v", err)
+		}
+	}
+	if app.radio.Intent != before || len(app.radio.Holds) != 0 {
+		t.Fatal("rejected manual-release command mutated radio custody")
+	}
+}
+
+// Rejected requests must not invalidate an already prepared radio operation,
+// mutate native intent, or reach a player/transport effect after busy admission.
+func TestRadioRelease56BusyAndDealerRejectBeforeRadioIntent(t *testing.T) {
+	for _, admission := range []string{"manual-release", "volume-reservation", "content-closing"} {
+		t.Run(admission, func(t *testing.T) {
+			app := radioTestApp(t)
+			app.log = &librespot.NullLogger{}
+			p := &AppPlayer{app: app}
+			switch admission {
+			case "manual-release":
+				app.manualRelease = &nativeTransportOffer{}
+			case "volume-reservation":
+				p.roomVolumeReservation = &nativeRoomVolumeReservation{Until: time.Now().Add(time.Minute)}
+			case "content-closing":
+				p.roomVolumeClosing = true
+			}
+			before := app.radio.Intent
+			nativeBefore := p.roomNativeIntent
+			for _, endpoint := range []string{"play", "resume", "pause", "transfer"} {
+				var req dealer.RequestPayload
+				req.Command.Endpoint = endpoint
+				if err := p.handlePlayerCommandWithSpclient(context.Background(), req, nil); err != ErrAliasConflict {
+					t.Fatalf("dealer %s admitted while %s: %v", endpoint, admission, err)
+				}
+			}
+			for _, kind := range []ApiRequestType{ApiRequestTypeResume, ApiRequestTypePause, ApiRequestTypePlay, ApiRequestTypePlayPause, ApiRequestTypeNext, ApiRequestTypeSetVolume} {
+				if _, err := p.handleApiRequest(context.Background(), ApiRequest{Type: kind}); err != ErrAliasConflict {
+					t.Fatalf("API %s admitted while %s: %v", kind, admission, err)
+				}
+			}
+			for _, kind := range []mpris.MediaPlayer2PlayerCommandType{mpris.MediaPlayer2PlayerCommandTypePlay, mpris.MediaPlayer2PlayerCommandTypePause, mpris.MediaPlayer2PlayerCommandTypePlayPause} {
+				if err := p.handleMprisEvent(context.Background(), mpris.MediaPlayer2PlayerCommand{Type: kind}); err != ErrAliasConflict {
+					t.Fatalf("MPRIS admitted while %s: %v", admission, err)
+				}
+			}
+			if app.radio.Intent != before || p.roomNativeIntent != nativeBefore || len(app.radio.Holds) != 0 || app.radio.Generation != 0 || len(app.radio.Terminal) != 0 || len(app.radio.Rejected) != 0 {
+				t.Fatal("rejected request changed preflight, native intent, radio custody or terminal state")
+			}
+		})
+	}
+}
+
+// This tests the metadata-only MOVE custody join. Actual FD and C authority
+// remain covered separately by the worker/FIFO and factory contract suites.
+func TestRadioRelease56SpecializedCustodyIsNotHistoricalCompletion(t *testing.T) {
+	p, old := contentFixture(t)
+	app := p.app
+	identity := *old.Capture.OldOwner
+	process, valid := nativeContentProcess()
+	if !valid {
+		t.Skip("requires Linux process identity")
+	}
+	writer := output.MovePipeIdentity{PipeIdentity: output.PipeIdentity{Device: "1", Inode: "2", Type: "fifo"}, FD: "3"}
+	app.startCustody = old
+	app.openedWriterOwner, app.openedWriter, app.openedWriterGeneration = p, writer, 7
+	proof := &radioOtherWriter{Owner: p, Player: p.player, Session: p.sess, Identity: identity, Process: process, Writer: writer, Epoch: "9", Generation: 7, StartAt: old}
+	app.radioOtherWriter = proof
+	current, err := app.completedWriterCurrent(p, identity)
+	if err != nil || current == nil || current.radio != proof || current.custodyStart != old || current.custodyMove != nil || current.start != nil || current.move != nil {
+		t.Fatalf("specialized completion credited history or lost strict custody: %#v %v", current, err)
+	}
+	app.startCustody = &contentOperation{}
+	if _, err = app.completedWriterCurrent(p, identity); err != ErrAliasConflict {
+		t.Fatal("replacement custody retained old radio proof")
+	}
+	app.startCustody = old
+	app.moveCustodyUnknown = true
+	if _, err = app.completedWriterCurrent(p, identity); err != ErrAliasConflict {
+		t.Fatal("unknown custody bypassed by radio proof")
+	}
+}
