+					t.Fatal("unavailable radio altered original live Native source/session/queue/writer", fmt.Sprint(sourceErr, stateErr))
+				}
+				t.Log("VERIFIED unavailable radio left no hold and preserved original live Native source/session/queue and exact registered writer")
+			} else if expectReturn == "1" || expectReturn == "selected" {
+				app.radio.mu.Lock()
+				holdReleased := app.radio.Holds[readyScope.RoomID] == nil
