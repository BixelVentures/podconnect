+	"time"
+
+	"github.com/devgianlu/go-librespot/output"
+	"github.com/devgianlu/go-librespot/player"
+	"github.com/devgianlu/go-librespot/session"
+)
+
+// Native boundary composition only: C descriptors are explicit HTTP fixtures,
+// not C runtime or pairing evidence. The retained decoder, process certificate,
+// worker/output lock, FIFO FD, epoch and registered generation are actual.
+func testSourcefulReacquiredWriter(t *testing.T, p *AppPlayer, worker *player.Player, stream *player.Stream) {
+	t.Helper()
+	ctx, cancel := context.WithTimeout(context.Background(), 3*time.Second)
+	defer cancel()
+	current, intended, err := p.radioOwnersForIntent("r0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	process, valid := nativeContentProcess()
+	if !valid {
+		t.Fatal("missing real process certificate")
+	}
+	pipe, epoch, err := worker.RoomMove(ctx, "inspect", stream.Source, output.MovePipeIdentity{}, "", true, func(mutate func()) error { mutate(); return nil })
+	if err != nil {
+		t.Fatal(err)
+	}
+	wire := queueWriterWire{process, pipe.FD, pipe.PipeIdentity, epoch, strconv.FormatUint(p.app.openedWriterGeneration, 10), contentDigestBytes(p.app.cfg.AudioOutputPipe)}
+	cprocess := "00000000-0000-0000-0000-000000000001"
+	route := roomVolumeRoute{cprocess, intended.HomePodID, "1", "2", "3", "4", "1", "1", wire.InputDigest}
+	volume := 35
+	request := radioRequest{Schema: "podconnect.native_radio_handoff.v1", ProcessID: radioProcessID(process), TargetID: intended.RoomID, HandoffID: "00000000-0000-0000-0000-000000000011", Generation: "7", ExpectedRevision: "0", ActionID: "00000000-0000-0000-0000-000000000012", Peer: radioPeer{"00000000-0000-0000-0000-000000000013", "1", strings.Repeat("d", 64)}}
+	hold := &radioHold{Request: request, Phase: "reacquiring", owner: p, primary: stream, Actions: map[string]bool{}, Proof: radioCBinding{Schema: "podconnect.output_radio_handoff.v1", Owner: intended, Revision: "1", Writer: wire, Output: route, HandoffID: request.HandoffID, Generation: "7", SourceEpoch: epoch, SenderPeer: request.Peer.Process, RadioProcess: request.Peer.Process, RadioEpoch: "1", Digest: request.Peer.Digest, Token: strings.Repeat("b", 32), InitialVolume: 35}}
+	revision, err := p.nextNativeIntent()
+	if err != nil {
+		t.Fatal(err)
+	}
+	r := radioReacquire{Schema: "podconnect.output_radio_reacquire.v1", Phase: "open", Hold: hold.Proof, IntentID: "00000000-0000-0000-0000-000000000014", Revision: revision, Owner: current, Intended: intended, Challenge: strings.Repeat("c", 32), DrainGeneration: "9", Signature: strings.Repeat("d", 64), VolumeKind: "receiver_acknowledged", VolumePercent: &volume, VolumeRevision: "2", Writer: &wire, Source: &route}
+	ack := radioReacquireReply{Schema: r.Schema, OK: true, Purpose: "radio_reacquire_v1", Phase: "opened", Challenge: r.Challenge, ChallengeSignature: strings.Repeat("e", 64), IntentID: r.IntentID, Revision: r.Revision, Owner: current, Intended: intended, Writer: &wire, Source: &route, Route: &route, Barrier: true, CurrentVolume: &volume, CurrentBase: "2", VolumeKind: r.VolumeKind, VolumePercent: &volume, VolumeRevision: r.VolumeRevision}
+	owner := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, req *http.Request) {
+		if req.Header.Get("X-PodConnect-Token") != strings.Repeat("a", 32) {
+			w.WriteHeader(403)
+			return
+		}
+		switch req.URL.Path {
+		case "/api/outputs/" + intended.HomePodID + "/radio-handoff/reacquire":
+			var body radioReacquire
+			if json.NewDecoder(req.Body).Decode(&body) != nil || contentDigest(body) != contentDigest(r) {
+				w.WriteHeader(400)
+				return
+			}
+			_ = json.NewEncoder(w).Encode(ack)
+		case "/api/outputs/" + intended.HomePodID + "/radio-handoff/source-state":
+			_ = json.NewEncoder(w).Encode(radioReacquiredSource{"podconnect.output_radio_source_state.v1", true, intended, wire, route, hold.Proof.Digest, volume, "radio_handoff_v1", false})
+		default:
+			w.WriteHeader(404)
+		}
+	}))
+	defer owner.Close()
+	p.app.cfg.RadioHandoffControlToken = strings.Repeat("a", 32)
+	p.app.cfg.RadioHandoffOwnerURL = owner.URL
+	p.app.cfg.RadioHandoffStatePath = filepath.Join(t.TempDir(), "sourceful.json")
+	p.app.cfg.RoomTransportOwnToneURL = owner.URL
+	if err = p.app.initRadio(); err != nil {
+		t.Fatal(err)
+	}
+	p.app.radio.Holds[request.TargetID] = hold
+	hold.SenderDrain, _ = json.Marshal(radioDrainTicket{"9", r.Signature, r.Challenge, r.VolumeKind, &volume, r.VolumeRevision})
+	observed, err := p.radioReacquireCall(ctx, hold, r)
+	if err != nil {
+		t.Fatal("closed OPEN receipt validation", err)
+	}
+	if err = p.adoptRadioIntendedOwner(current, intended); err != nil {
+		t.Fatal(err)
+	}
+	if _, err = p.captureQueueWriter(ctx, intended, nil); err == nil {
+		t.Fatal("old START receipt improperly authorized a different intended owner")
+	}
+	proof, err := p.captureRadioReacquiredWriter(ctx, hold, r, observed, wire, intended, p.app.radio.Intent)
+	if err != nil {
+		t.Fatal("actual FIFO/source verified receipt capture", err)
+	}
+	if p.app.radioReacquiredWriter != nil {
+		t.Fatal("candidate published authority before durable terminal")
+	}
+	p.app.radio.Intent++
+	if err = p.commitRadioReacquiredWriter(ctx, hold, proof, "resume"); err == nil {
+		t.Fatal("newer global user intent published old receipt")
+	}
+	p.app.radio.Intent--
+	p.roomNativeIntent++
+	if err = p.commitRadioReacquiredWriter(ctx, hold, proof, "resume"); err == nil {
+		t.Fatal("newer source intent published old receipt")
+	}
+	p.roomNativeIntent--
+
+	oldSession := p.sess
+	p.sess = &session.Session{}
+	if err = p.commitRadioReacquiredWriter(ctx, hold, proof, "resume"); err == nil {
+		t.Fatal("replacement session published old receipt")
+	}
+	p.sess = oldSession
+	if p.app.radioReacquiredWriter != nil || p.app.radio.Holds[request.TargetID] != hold {
+		t.Fatal("failed late guard retired source custody")
+	}
+	if err = p.commitRadioReacquiredWriter(ctx, hold, proof, "resume"); err != nil {
+		t.Fatal("durable sourceful publication", err)
+	}
+	captured, err := p.captureQueueWriter(ctx, intended, nil)
+	if err != nil || captured == nil || captured.Wire != wire || captured.Completed == nil || captured.Completed.reacquired != proof {
+		t.Fatal("positive next-cycle current writer recapture", err)
+	}
+	if p.app.radio.Holds[request.TargetID] != nil || p.app.radio.Terminal[radioTerminalKey(request)] == nil {
+		t.Fatal("new authority lacked terminal source hold receipt")
+	}
+	wrong := intended
+	wrong.SessionID += "-stale"
+	if _, err = p.captureQueueWriter(ctx, wrong, nil); err == nil {
+		t.Fatal("stale intended session reused writer")
+	}
+	oldSource := stream.Source
+	stream.Source = &contentInertSource{}
+	if _, err = p.captureQueueWriter(ctx, intended, nil); err == nil {
+		t.Fatal("replaced decoder metadata reused receipt")
+	}
+	stream.Source = oldSource
+	p.sess = &session.Session{}
+	if _, err = p.captureQueueWriter(ctx, intended, nil); err == nil {
+		t.Fatal("replaced session reused receipt")
+	}
+	p.sess = oldSession
+	if err = worker.SetPrimaryStream(&contentInertSource{}, false, false); err != nil {
+		t.Fatal(err)
+	}
+	if p.app.openedWriter != pipe {
+		t.Fatal("stale-epoch test did not retain exact FIFO FD")
+	}
+	if _, err = p.captureQueueWriter(ctx, intended, nil); err == nil {
+		t.Fatal("same FD with a replaced source/epoch reused receipt")
+	}
+}
