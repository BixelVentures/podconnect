+)
+
+// This inspects the actual native process and kernel FIFO without constructing
+// an AppPlayer, Spotify account, decoder, receiver or fake capability response.
+func TestRadioAbsenceSourceUsesRealNoLoginProcessAndFIFO(t *testing.T) {
+	if runtime.GOOS != "linux" {
+		t.Skip("production native process proof is Linux-only")
+	}
+	app := radioTestApp(t)
+	path := filepath.Join(t.TempDir(), "native.pipe")
+	if err := syscall.Mkfifo(path, 0600); err != nil {
+		t.Fatal(err)
+	}
+	app.cfg.AudioBackend = "pipe"
+	app.cfg.AudioOutputPipe = path
+	app.cfg.AudioOutputPipeFormat = "s16le"
+	app.cfg.ExternalVolume = true
+	app.cfg.RoomTransportOwnToneURL = "http://127.0.0.1:3689"
+	proof, err := app.radioAbsenceSource()
+	if err != nil {
+		t.Fatal(err)
+	}
+	process, valid := nativeContentProcess()
+	if !valid || proof.Process != process || proof.Path != path || proof.Digest != contentDigestBytes(path) || proof.Pipe.Type != "fifo" || proof.Pipe.Device == "" || proof.Pipe.Inode == "" || len(proof.Registry) != 64 {
+		t.Fatalf("actual process/FIFO binding missing: %+v", proof)
+	}
+	again, err := app.radioAbsenceSource()
+	if err != nil || again != proof {
+		t.Fatal("unchanged source did not retain identity", err)
+	}
+	app.cfg.DeviceAliasRoomIDs[0] = "changed-room"
+	changed, err := app.radioAbsenceSource()
+	if err != nil || changed.Registry == proof.Registry {
+		t.Fatal("registry change borrowed earlier absence", err)
+	}
+	if err = os.Remove(path); err != nil {
+		t.Fatal(err)
+	}
+	if err = os.WriteFile(path, []byte("ordinary file"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	if _, err = app.radioAbsenceSource(); err == nil {
+		t.Fatal("ordinary file accepted as absence FIFO")
+	}
+}
+func TestRadioAbsenceProofContainsNoSyntheticSpotifyOwner(t *testing.T) {
+	h := &radioHold{Absence: &radioAbsenceHold{Binding: radioAbsenceBinding{Schema: "podconnect.output_radio_absence.v1", Token: "0123456789abcdef0123456789abcdef"}, Signature: "signed-absence"}}
+	if _, ok := radioHoldProof(h).(radioAbsenceBinding); !ok {
+		t.Fatal("absence disguised as Spotify proof")
+	}
+	if radioHoldToken(h) != h.Absence.Binding.Token || radioHoldSignature(h) != "signed-absence" {
+		t.Fatal("absence identity/signature lost")
+	}
+}
+
+func TestRadioTargetAbsenceBindingRoundTripUsesSemanticIdentity(t *testing.T) {
+	b := radioAbsenceBinding{Schema: "podconnect.output_radio_absence.v1", Source: radioAbsenceSource{Kind: "target", Live: &radioAbsenceLive{WriterFD: "7", InputGeneration: "4", InputItemID: "3", InputEpoch: "8", Routes: []radioAbsenceRoute{{Identity: roomVolumeRoute{DeviceID: "102"}, Digest: "physical-other"}}}}}
+	raw, err := json.Marshal(b)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var decoded radioAbsenceBinding
+	if err = json.Unmarshal(raw, &decoded); err != nil {
+		t.Fatal(err)
+	}
+	if b.Source.Live == decoded.Source.Live || contentDigest(b) != contentDigest(decoded) {
+		t.Fatal("decoded real source proof did not retain semantic identity")
+	}
+	decoded.Source.Live.Routes[0].Identity.DeviceID = "103"
+	if contentDigest(b) == contentDigest(decoded) {
+		t.Fatal("different physical route borrowed earlier proof")
+	}
+}
+func TestRadioControllerIdentityRequiresActualCanonicalValue(t *testing.T) {
+	for _, id := range []string{"", "0000000000000000", "abcdef0123456789", "ABCDEF012345678G"} {
+		if radioControllerIDValid(id) {
+			t.Fatalf("invalid registered identity accepted: %s", id)
+		}
+	}
+	if !radioControllerIDValid("ABCDEF0123456789") {
+		t.Fatal("canonical actual identity rejected")
+	}
+}
diff --git a/daemon/radio_admission.go b/daemon/radio_admission.go
new file mode 100644
index 0000000..54674ed
--- /dev/null
+++ b/daemon/radio_admission.go
@@ -0,0 +1,180 @@
+package daemon
+
+import "context"
+
+// Resolve the physical room before changing an alias, source, decoder or FIFO.
+func (p *AppPlayer) radioIntentTarget(requested *uint32) (string, error) {
+	if p == nil || p.app == nil || p.state == nil || p.state.device == nil {
+		return "", ErrAliasConflict
+	}
+	p.aliasMu.Lock()
+	defer p.aliasMu.Unlock()
+	alias := p.state.device.SelectedAliasId
+	if requested != nil {
+		alias = resolveDeviceAlias(alias, *requested, len(p.aliasRegistry))
+	}
+	for _, a := range p.aliasRegistry {
+		if a.ID == alias && a.RoomID != "" {
+			return a.RoomID, nil
+		}
+	}
+	return "", ErrAliasConflict
+}
+func (p *AppPlayer) radioAdmitExplicit(ctx context.Context, target, cause string) error {
+	if !p.radioHeld() {
+		return nil
+	}
+	p.app.radio.mu.Lock()
+	h := p.app.radio.Holds[target]
+	exclusive := false
+	otherGranted := false
+	for _, other := range p.app.radio.Holds {
+		if other.OtherGrant != nil && other.OtherGrant.Intended.RoomID == target {
+			otherGranted = true
+		}
+		if radioGlobalCustodyRequired(other) {
+			exclusive = true
+		}
+	}
+	failed := p.app.radio.failed
+	p.app.radio.mu.Unlock()
+	if failed || target == "" {
+		return ErrAliasConflict
+	}
+	if h != nil {
+		if h.Parked != nil {
+			return p.preemptParkedRadio(ctx, target, cause)
+		}
+		return p.preemptRadio(ctx, target, cause)
+	}
+	if exclusive || otherGranted {
+		return p.radioAdmitOtherTarget(ctx, target, cause)
+	}
+	return nil // A shared live writer keeps serving unheld physical destinations.
+}
+func (p *AppPlayer) radioMutationAllowed(target string) bool {
+	if p == nil || p.app == nil {
+		return true
+	}
+	p.app.radio.mu.Lock()
+	defer p.app.radio.mu.Unlock()
+	if p.app.radio.failed || p.app.radio.Holds[target] != nil {
+		return false
+	}
+	for _, h := range p.app.radio.Holds {
+		if radioGlobalCustodyRequired(h) {
+			return false
+		}
+	}
+	return true
+}
+
+// A proven target-only absence leaves the actual live source on other rooms
+// untouched. Restart/unknown receipts still require a fresh admission proof.
+func radioGlobalCustodyRequired(h *radioHold) bool {
+	if h.Parked != nil || radioAbsenceEvolved(h) {
+		return false // Receiver-only custody never owns the retained global FIFO.
+	}
+	if h.WriterParked || h.PauseUncertain {
+		return true
+	}
+	if h.Absence != nil && h.Absence.Binding.Source.Kind == "target" && (h.Phase == "prepared" || h.Phase == "suspended") {
+		return false
+	}
+	return h.owner == nil
+}
+
+func (p *AppPlayer) radioSourceOwner() (roomTransportIdentity, error) {
+	if p == nil || p.sess == nil {
+		return roomTransportIdentity{}, ErrAliasConflict
+	}
+	account, bound := p.sess.BoundUsername()
+	if !bound {
+		return roomTransportIdentity{}, ErrAliasConflict
+	}
+	room, err := p.radioIntentTarget(nil)
+	if err != nil {
+		return roomTransportIdentity{}, err
+	}
+	p.aliasMu.Lock()
+	hp := ""
+	for _, alias := range p.aliasRegistry {
+		if alias.RoomID == room {
+			hp = alias.HomePodID
+		}
+	}
+	p.aliasMu.Unlock()
+	return p.roomTransportIdentity(account, p.app.deviceId, room, hp)
+}
+
+func (p *AppPlayer) radioOwnersForIntent(target string) (roomTransportIdentity, roomTransportIdentity, error) {
+	zero := roomTransportIdentity{}
+	if p.sess == nil {
+		return zero, zero, ErrAliasConflict
+	}
+	account, bound := p.sess.BoundUsername()
+	if !bound {
+		return zero, zero, ErrAliasConflict
+	}
+	currentTarget, err := p.radioIntentTarget(nil)
+	if err != nil {
+		return zero, zero, err
+	}
+	var currentHP string
+	p.aliasMu.Lock()
+	for _, a := range p.aliasRegistry {
+		if a.RoomID == currentTarget {
+			currentHP = a.HomePodID
+		}
+	}
+	p.aliasMu.Unlock()
+	current, err := p.roomTransportIdentity(account, p.app.deviceId, currentTarget, currentHP)
+	if err != nil {
+		return zero, zero, err
+	}
+	intended := current
+	p.aliasMu.Lock()
+	defer p.aliasMu.Unlock()
+	if p.aliasRetired || !p.transportMappingCurrentLocked() {
+		return zero, zero, ErrAliasConflict
+	}
+	found := false
+	for _, a := range p.aliasRegistry {
+		if a.RoomID == target {
+			intended.RoomID = a.RoomID
+			intended.HomePodID = a.HomePodID
+			found = true
+		}
+	}
+	if !found {
+		return zero, zero, ErrAliasConflict
+	}
+	if target != current.RoomID {
+		if current.AliasRevision >= 1<<53-1 {
+			return zero, zero, ErrAliasConflict
+		}
+		intended.AliasRevision = current.AliasRevision + 1
+	}
+	return current, intended, nil
+}
+
+func (p *AppPlayer) adoptRadioIntendedOwner(current, intended roomTransportIdentity) error {
+	p.aliasMu.Lock()
+	defer p.aliasMu.Unlock()
+	if p.aliasRetired || p.aliasIncarnation != current.AliasIncarnation || p.aliasFingerprint != current.AliasRegistry || p.aliasRevision != current.AliasRevision || p.spotConnId != current.ConnectionID || p.state == nil || p.state.player == nil || p.state.player.SessionId != current.SessionID {
+		return ErrAliasConflict
+	}
+	for _, a := range p.aliasRegistry {
+		if a.RoomID == intended.RoomID && a.HomePodID == intended.HomePodID {
+			if a.ID != p.state.device.SelectedAliasId {
+				p.advanceAliasRevisionLocked()
+			}
+			if p.aliasRevision != intended.AliasRevision {
+				return ErrAliasConflict
+			}
+			p.state.device.SelectedAliasId = a.ID
+			return nil
+		}
+	}
+	return ErrAliasConflict
+}
diff --git a/daemon/radio_availability.go b/daemon/radio_availability.go
new file mode 100644
index 0000000..a04e63a
--- /dev/null
+++ b/daemon/radio_availability.go
@@ -0,0 +1,214 @@
+package daemon
+
+import (
+	"context"
+	"encoding/json"
+	"net/http"
+	"strings"
+	"time"
+)
+
+type radioSourceAvailability struct{ Digest, Process, Incarnation string }
+
+type radioAvailabilityCapability struct {
+	Schema       string  `json:"schema"`
+	Purpose      string  `json:"purpose"`
+	Process      string  `json:"process_id"`
+	DeviceID     string  `json:"device_id"`
+	Incarnation  string  `json:"device_incarnation"`
+	ControllerID string  `json:"controller_id"`
+	Protocol     bool    `json:"protocol_supported"`
+	Sourceful    bool    `json:"sourceful_supported"`
+	Absence      bool    `json:"source_absence_supported"`
+	Signing      bool    `json:"signing_configured"`
+	Pairing      bool    `json:"pairing_available"`
+	Digest       *string `json:"receiver_key_digest"`
+	Physical     bool    `json:"physical_result_verified"`
+}
+
+// This pure target-custody check is separate from protocol metadata and from
+// the actual source/receiver proof. It allocates no reservation or permission.
+type radioAvailabilityAdmission struct {
+	Schema      string `json:"schema"`
+	Process     string `json:"process_id"`
+	DeviceID    string `json:"device_id"`
+	Incarnation string `json:"device_incarnation"`
+	Open        bool   `json:"admission_open"`
+	Physical    bool   `json:"physical_result_verified"`
+}
+
+func radioControllerIDValid(id string) bool {
+	if len(id) != 16 || id == "0000000000000000" {
+		return false
+	}
+	for _, c := range id {
+		if !(c >= '0' && c <= '9' || c >= 'A' && c <= 'F') {
+			return false
+		}
+	}
+	return true
+}
+
+// Availability is a fresh observation, never an effect permit. Every command
+// still obtains its own exact receiver/source reservation before any effect.
+func (app *App) radioStateObserved(ctx context.Context) any {
+	var state struct {
+		Schema       string         `json:"schema"`
+		ProcessID    string         `json:"process_id"`
+		Process      contentProcess `json:"native_process"`
+		Targets      []radioTarget  `json:"configured_targets"`
+		Missing      []string       `json:"missing_proofs"`
+		Revision     string         `json:"native_revision"`
+		ControllerID string         `json:"controller_id"`
+	}
+	raw, _ := json.Marshal(app.radioState())
+	if json.Unmarshal(raw, &state) != nil || !app.radioEnabled() {
+		return state
+	}
+	source, err := app.radioAbsenceSource()
+	if err != nil {
+		return state
+	}
+	ctx, cancel := context.WithTimeout(ctx, 8*time.Second)
+	defer cancel()
+	state.Missing = []string{}
+	anyAvailable := false
+	for i := range state.Targets {
+		target := &state.Targets[i]
+		app.radio.mu.Lock()
+		held := app.radio.Holds[target.ID] != nil
+		failed := app.radio.failed
+		app.radio.mu.Unlock()
+		if failed {
+			continue
+		}
+		base := strings.TrimSuffix(app.cfg.RoomTransportOwnToneURL, "/") + "/api/outputs/" + target.HomePodID
+		var capability radioAvailabilityCapability
+		if radioControlHTTP(ctx, http.MethodGet, base+"/radio-handoff/capabilities", app.cfg.RadioHandoffControlToken, nil, &capability) != nil || capability.Schema != "podconnect.output_radio_capability.v1" || capability.Purpose != "radio_handoff_v1" || !volumeUUID.MatchString(capability.Process) || capability.DeviceID != target.HomePodID || !volumeCounter(capability.Incarnation) || capability.Incarnation == "0" || !radioControllerIDValid(capability.ControllerID) || capability.Physical || !capability.Protocol || !capability.Signing || !capability.Pairing || capability.Digest == nil || !volumeHex64.MatchString(*capability.Digest) {
+			continue
+		}
+		if state.ControllerID != "" && state.ControllerID != capability.ControllerID {
+			state.Missing = []string{"conflicting_c_controller_identity"}
+			for j := range state.Targets {
+				state.Targets[j].Selectable = false
+				state.Targets[j].Availability = "unknown"
+				state.Targets[j].ReceiverDigest = ""
+			}
+			state.ControllerID = ""
+			return state
+		}
+		state.ControllerID = capability.ControllerID
+		// Current controller metadata remains observable while custody is held;
+		// it neither opens admission nor publishes a target pairing proof.
+		if held {
+			continue
+		}
+		var admission radioAvailabilityAdmission
+		if radioControlHTTP(ctx, http.MethodGet, base+"/radio-admission", app.cfg.RadioHandoffControlToken, nil, &admission) != nil || admission.Schema != "podconnect.output_radio_admission.v1" || admission.Physical || !admission.Open || admission.Process != capability.Process || admission.DeviceID != capability.DeviceID || admission.Incarnation != capability.Incarnation {
+			continue // Unknown custody must never fall through to either source lane.
+		}
+		available := false
+		if capability.Absence {
+			request := struct {
+				Schema string             `json:"schema"`
+				Source radioAbsenceSource `json:"source_absence"`
+			}{"podconnect.output_radio_absence_observation.v1", source}
+			var observed radioAbsenceObservation
+			if radioControlHTTP(ctx, http.MethodPost, base+"/radio-absence/observe", app.cfg.RadioHandoffControlToken, request, &observed) == nil && observed.Schema == request.Schema && observed.OK && !observed.Physical && observed.Absent {
+				proof := observed.Proof
+				available = proof != nil && radioAbsenceCoreEqual(proof.Source, source) && proof.Output.DeviceID == target.HomePodID && proof.Output.Process == capability.Process && proof.Output.Incarnation == capability.Incarnation && proof.Digest == *capability.Digest && proof.InitialVolume >= 0 && proof.InitialVolume <= 100 && observed.VolumeProvenance == "stored_manual_base"
+			}
+		}
+		if !available && capability.Sourceful {
+			actual := app.radioObserveActor(ctx, target.ID)
+			available = actual.Digest == *capability.Digest && actual.Process == capability.Process && actual.Incarnation == capability.Incarnation
+		}
+		if available {
+			target.Availability = "available"
+			target.Selectable = true
+			target.ReceiverDigest = *capability.Digest
+			anyAvailable = true
+		}
+	}
+	if !anyAvailable {
+		state.Missing = append(state.Missing, "fresh_receiver_source_proof")
+	}
+	return state
+}
+func (app *App) radioObserveActor(ctx context.Context, target string) radioSourceAvailability {
+	app.ownerMu.Lock()
+	ch, done := app.currentAPI, app.currentDone
+	app.ownerMu.Unlock()
+	if ch == nil {
+		return radioSourceAvailability{}
+	}
+	req, wait := NewApiRequest(apiRadioHandoff, radioActorRequest{Action: "observe", Request: radioRequest{TargetID: target}, Context: ctx})
+	select {
+	case ch <- req:
+		value, err := wait(ctx)
+		valid, ok := value.(radioSourceAvailability)
+		if err == nil && ok {
+			return valid
+		}
+		return radioSourceAvailability{}
+	case <-done:
+		return radioSourceAvailability{}
+	case <-ctx.Done():
+		return radioSourceAvailability{}
+	}
+}
+func (p *AppPlayer) radioObserveSource(ctx context.Context, target string) (any, error) {
+	if p == nil || p.sess == nil || p.app == nil {
+		return radioSourceAvailability{}, nil
+	}
+	app := p.app
+	app.radio.mu.Lock()
+	blocked := app.radio.failed || app.radio.Holds[target] != nil
+	app.radio.mu.Unlock()
+	if blocked {
+		return radioSourceAvailability{}, nil
+	}
+	hp := ""
+	for i, id := range app.cfg.DeviceAliasRoomIDs {
+		if id == target && i < len(app.cfg.DeviceAliasHomePodIDs) {
+			hp = app.cfg.DeviceAliasHomePodIDs[i]
+		}
+	}
+	if !homePodIDPattern.MatchString(hp) {
+		return radioSourceAvailability{}, nil
+	}
+	owner, err := p.radioSourceOwner()
+	if err != nil {
+		return radioSourceAvailability{}, nil
+	}
+	writer, err := p.captureQueueWriter(ctx, owner, nil)
+	if err != nil {
+		// A retained, actually parked writer cannot supply a live writer proof.
+		// Observe that distinct existing C lane without reserving a target.
+		return p.radioObserveParkedSource(ctx, target), nil
+	}
+	payload := struct {
+		Schema string                `json:"schema"`
+		Owner  roomTransportIdentity `json:"native_owner"`
+		Writer queueWriterWire       `json:"writer_proof"`
+	}{"podconnect.output_radio_source_state.v1", owner, writer.Wire}
+	var state struct {
+		Schema   string                `json:"schema"`
+		OK       bool                  `json:"ok"`
+		Owner    roomTransportIdentity `json:"native_owner"`
+		Writer   queueWriterWire       `json:"writer_proof"`
+		Identity roomVolumeRoute       `json:"output_identity"`
+		Digest   string                `json:"receiver_key_digest"`
+		Volume   int                   `json:"initial_volume_percent"`
+		Purpose  string                `json:"purpose"`
+		Physical bool                  `json:"physical_result_verified"`
+	}
+	endpoint := strings.TrimSuffix(app.cfg.RoomTransportOwnToneURL, "/") + "/api/outputs/" + hp + "/radio-handoff/source-state"
+	if radioControlHTTP(ctx, http.MethodPost, endpoint, app.cfg.RadioHandoffControlToken, payload, &state) != nil {
+		return radioSourceAvailability{}, nil
+	}
+	if state.Schema == payload.Schema && state.OK && !state.Physical && state.Purpose == "radio_handoff_v1" && state.Owner == owner && state.Writer == writer.Wire && state.Identity.valid() && state.Identity.DeviceID == hp && state.Identity.InputPathDigest == writer.Wire.InputDigest && volumeHex64.MatchString(state.Digest) && state.Volume >= 0 && state.Volume <= 100 {
+		return radioSourceAvailability{state.Digest, state.Identity.Process, state.Identity.DeviceIncarnation}, nil
+	}
+	return radioSourceAvailability{}, nil
+}
diff --git a/daemon/radio_availability_admission_test.go b/daemon/radio_availability_admission_test.go
new file mode 100644
index 0000000..005ab61
--- /dev/null
+++ b/daemon/radio_availability_admission_test.go
@@ -0,0 +1,192 @@
+package daemon
+
+import (
+	"context"
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"path/filepath"
+	"strings"
+	"sync/atomic"
+	"syscall"
+	"testing"
+	"time"
+)
+
+func TestRadioAvailabilityAdmissionFencesBothSourceLanes(t *testing.T) {
+	// Explicit HTTP and actor response fixtures isolate the production read-only
+	// admission fence. They are not actual C/source/pairing readiness evidence.
+	for _, mode := range []string{"open_absence", "open_sourceful", "open_no_fresh_proof", "held", "closed", "wrong_process", "wrong_device", "wrong_incarnation", "wrong_schema", "physical_true", "extra_field", "missing_open", "null_open", "malformed", "http_unavailable", "no_response"} {
+		t.Run(mode, func(t *testing.T) {
+			app := radioTestApp(t)
+			app.cfg.DeviceAliases = []string{"Stuen"}
+			app.cfg.DeviceAliasRoomIDs = []string{"stue"}
+			app.cfg.DeviceAliasHomePodIDs = []string{"101"}
+			app.cfg.RoomTransportOwnToneURL = "http://127.0.0.1:8081"
+			app.cfg.AudioBackend = "pipe"
+			app.cfg.ExternalVolume = true
+			app.cfg.AudioOutputPipeFormat = "s16le"
+			app.cfg.AudioOutputPipe = filepath.Join(t.TempDir(), "admission.fifo")
+			if err := syscall.Mkfifo(app.cfg.AudioOutputPipe, 0600); err != nil {
+				t.Fatal(err)
+			}
+			source, err := app.radioAbsenceSource()
+			if err != nil {
+				t.Fatal(err)
+			}
+			if mode == "held" {
+				app.radio.Holds["stue"] = &radioHold{}
+			}
+			digest := strings.Repeat("c", 64)
+			capability := radioAvailabilityCapability{Schema: "podconnect.output_radio_capability.v1", Purpose: "radio_handoff_v1", Process: "00000000-0000-0000-0000-000000000001", DeviceID: "101", Incarnation: "1", ControllerID: "ABCDEF0123456789", Protocol: true, Sourceful: true, Absence: true, Signing: true, Pairing: true, Digest: &digest}
+			var caps, admissions, absence, actors, effects atomic.Int32
+			server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				if r.Header.Get("X-PodConnect-Token") != app.cfg.RadioHandoffControlToken {
+					t.Error("missing radio authentication")
+					w.WriteHeader(403)
+					return
+				}
+				switch {
+				case r.Method == http.MethodGet && strings.HasSuffix(r.URL.Path, "/radio-handoff/capabilities"):
+					caps.Add(1)
+					_ = json.NewEncoder(w).Encode(capability)
+				case r.Method == http.MethodGet && strings.HasSuffix(r.URL.Path, "/radio-admission"):
+					admissions.Add(1)
+					if mode == "http_unavailable" {
+						w.WriteHeader(503)
+						return
+					}
+					if mode == "no_response" {
+						connection, _, e := w.(http.Hijacker).Hijack()
+						if e != nil {
+							t.Error(e)
+						} else {
+							_ = connection.Close()
+						}
+						return
+					}
+					if mode == "malformed" {
+						_, _ = w.Write([]byte(`{"schema":`))
+						return
+					}
+					proof := radioAvailabilityAdmission{"podconnect.output_radio_admission.v1", capability.Process, capability.DeviceID, capability.Incarnation, true, false}
+					switch mode {
+					case "closed":
+						proof.Open = false
+					case "wrong_process":
+						proof.Process = "00000000-0000-0000-0000-000000000099"
+					case "wrong_device":
+						proof.DeviceID = "102"
+					case "wrong_incarnation":
+						proof.Incarnation = "2"
+					case "wrong_schema":
+						proof.Schema = "podconnect.output_radio_capability.v1"
+					case "physical_true":
+						proof.Physical = true
+					}
+					if mode == "extra_field" || mode == "missing_open" || mode == "null_open" {
+						raw, _ := json.Marshal(proof)
+						var fields map[string]any
+						_ = json.Unmarshal(raw, &fields)
+						switch mode {
+						case "extra_field":
+							fields["grant"] = true
+						case "missing_open":
+							delete(fields, "admission_open")
+						case "null_open":
+							fields["admission_open"] = nil
+						}
+						_ = json.NewEncoder(w).Encode(fields)
+						return
+					}
+					_ = json.NewEncoder(w).Encode(proof)
+				case r.Method == http.MethodPost && strings.HasSuffix(r.URL.Path, "/radio-absence/observe"):
+					absence.Add(1)
+					if mode == "open_absence" {
+						proof := &radioAbsenceBinding{Schema: "podconnect.output_radio_absence.v1", Source: source, Output: radioAbsenceReceiver{Process: capability.Process, DeviceID: "101", Incarnation: "1", BaseRevision: "1"}, Digest: digest, InitialVolume: 35, VolumeProvenance: "stored_manual_base"}
+						_ = json.NewEncoder(w).Encode(radioAbsenceObservation{Schema: "podconnect.output_radio_absence_observation.v1", OK: true, Absent: true, Proof: proof, VolumeProvenance: "stored_manual_base"})
+					} else {
+						_ = json.NewEncoder(w).Encode(radioAbsenceObservation{Schema: "podconnect.output_radio_absence_observation.v1", OK: true})
+					}
+				default:
+					effects.Add(1)
+					w.WriteHeader(500)
+				}
+			}))
+			defer server.Close()
+			app.cfg.RoomTransportOwnToneURL = server.URL
+			ctx, cancel := context.WithTimeout(context.Background(), 2*time.Second)
+			defer cancel()
+			requests := make(chan ApiRequest)
+			app.currentAPI = requests
+			app.currentDone = make(chan struct{})
+			stopped := make(chan struct{})
+			go func() {
+				defer close(stopped)
+				for {
+					select {
+					case <-ctx.Done():
+						return
+					case request := <-requests:
+						if request.Type != apiRadioHandoff {
+							effects.Add(1)
+							request.Reply(nil, ErrBadRequest)
+							continue
+						}
+						typed, ok := request.Data.(radioActorRequest)
+						if !ok || typed.Action != "observe" || typed.Request.TargetID != "stue" {
+							effects.Add(1)
+							request.Reply(nil, ErrBadRequest)
+							continue
+						}
+						actors.Add(1)
+						observed := radioSourceAvailability{}
+						if mode == "open_sourceful" {
+							observed = radioSourceAvailability{digest, capability.Process, capability.Incarnation}
+						}
+						request.Reply(observed, nil)
+					}
+				}
+			}()
+			raw, _ := json.Marshal(app.radioStateObserved(ctx))
+			cancel()
+			<-stopped
+			var state struct {
+				Controller string        `json:"controller_id"`
+				Targets    []radioTarget `json:"configured_targets"`
+				Missing    []string      `json:"missing_proofs"`
+			}
+			if json.Unmarshal(raw, &state) != nil {
+				t.Fatal("state malformed")
+			}
+			available := mode == "open_absence" || mode == "open_sourceful"
+			if len(state.Targets) != 1 || state.Controller != capability.ControllerID || state.Targets[0].Selectable != available || state.Targets[0].Availability != map[bool]string{true: "available", false: "unknown"}[available] || available && len(state.Missing) != 0 || !available && (len(state.Missing) != 1 || state.Missing[0] != "fresh_receiver_source_proof") {
+				t.Fatal("admission/source evidence did not determine honest state", string(raw))
+			}
+			if available && state.Targets[0].ReceiverDigest != digest || !available && state.Targets[0].ReceiverDigest != "" {
+				t.Fatal("receiver digest escaped fresh available-proof boundary", string(raw))
+			}
+			if !available && strings.Contains(string(raw), `"receiver_key_digest"`) {
+				t.Fatal("unavailable/held target must omit pairing-proof metadata", string(raw))
+			}
+			open := strings.HasPrefix(mode, "open_")
+			wantAbsence := int32(0)
+			wantActor := int32(0)
+			if open {
+				wantAbsence = 1
+			}
+			if mode == "open_sourceful" || mode == "open_no_fresh_proof" {
+				wantActor = 1
+			}
+			admissionReadsValid := admissions.Load() == 1 || mode == "no_response" && admissions.Load() == 2 // net/http may retry an effect-free GET on a reused closed connection.
+			wantHolds := 0
+			if mode == "held" {
+				wantHolds = 1
+				admissionReadsValid = admissions.Load() == 0
+			}
+			if caps.Load() != 1 || !admissionReadsValid || absence.Load() != wantAbsence || actors.Load() != wantActor || effects.Load() != 0 || len(app.radio.Holds) != wantHolds || app.radio.Intent != 0 || app.radio.Generation != 0 || app.openedWriterGeneration != 0 {
+				t.Fatalf("closed/foreign gate fell through or read caused effects caps=%d admission=%d absence=%d actor=%d effects=%d", caps.Load(), admissions.Load(), absence.Load(), actors.Load(), effects.Load())
+			}
+		})
+	}
+}
diff --git a/daemon/radio_content_staging.go b/daemon/radio_content_staging.go
new file mode 100644
index 0000000..6f1716a
--- /dev/null
+++ b/daemon/radio_content_staging.go
@@ -0,0 +1,267 @@
+package daemon
+
+import (
+	"context"
+	"strconv"
+	"time"
+)
+
+const apiRadioContentRefresh ApiRequestType = "radio_content_refresh"
+
+// This binds a deferred C observation to real, durable radio custody. It is not
+// a C readiness receipt. No radio transition runs while browsing or staging URI.
+type radioContentStage struct {
+	HandoffID      string
+	Generation     string
+	Token          string
+	HoldTarget     string
+	ClaimIntent    uint64
+	CurrentAbsence bool
+	Absence        bool
+	Parked         bool
+	hold           *radioHold
+	controlToken   string
+}
+
+func (p *AppPlayer) radioContentSnapshot(scope roomVolumeScope) (*radioContentStage, error) {
+	if p == nil || p.app == nil {
+		return nil, nil
+	}
+	app := p.app
+	app.radio.mu.Lock()
+	defer app.radio.mu.Unlock()
+	if app.radio.failed {
+		return nil, ErrAliasConflict
+	}
+	h := app.radio.Holds[scope.RoomID]
+	if h == nil {
+		for _, candidate := range app.radio.Holds {
+			if candidate.WriterParked {
+				if h != nil {
+					return nil, ErrAliasConflict
+				}
+				h = candidate
+			}
+		}
+	}
+	if h == nil {
+		return nil, nil
+	}
+	if (h.owner != p && h.Absence == nil && h.Parked == nil) || (h.Latest == nil && h.Absence == nil && h.Parked == nil) || (h.Phase != "prepared" && h.Phase != "suspended" && h.Phase != "content_ready" && h.Phase != "content_bound" && !(h.Phase == "source_evolved" && radioAbsenceEvolved(h))) || !volumeHex32.MatchString(radioHoldToken(h)) {
+		return nil, ErrAliasConflict
+	}
+	return &radioContentStage{HandoffID: h.Request.HandoffID, Generation: h.Request.Generation, Token: radioHoldToken(h), HoldTarget: h.Request.TargetID, CurrentAbsence: radioAbsenceEvolved(h), Absence: h.Absence != nil, Parked: h.Parked != nil, hold: h, controlToken: app.cfg.RadioHandoffControlToken}, nil
+}
+func (p *AppPlayer) radioContentCurrent(stage *radioContentStage) bool {
+	if stage == nil {
+		return true
+	}
+	app := p.app
+	app.radio.mu.Lock()
+	defer app.radio.mu.Unlock()
+	h := app.radio.Holds[stage.HoldTarget]
+	return !app.radio.failed && h != nil && h == stage.hold && (h.owner == p || h.Absence != nil || h.Parked != nil) && h.Request.HandoffID == stage.HandoffID && h.Request.Generation == stage.Generation && radioHoldToken(h) == stage.Token && (h.Phase == "prepared" || h.Phase == "suspended" || stage.CurrentAbsence && h.Phase == "source_evolved" && radioAbsenceEvolved(h))
+}
+
+// refreshRadioContent runs only after the original opaque command has been
+// consumed by commit. It never broadens the accepted URI, scope or lifetime.
+func (p *AppPlayer) refreshRadioContent(ctx context.Context, request contentActorRequest) (any, error) {
+	op := request.Operation
+	if op == nil {
+		return nil, ErrAliasConflict
+	}
+	p.aliasMu.Lock()
+	op.mu.Lock()
+	valid := op.Owner == p && op.Radio != nil && op.Radio == op.Capture.Radio && op.CommitClaimed && op.Claimed && op.State == "committing" && !op.Cancelled && !op.Terminal && !op.RadioRefreshConsumed && time.Now().Before(op.StagedUntil) && p.contentCurrentLocked(op.Capture) && op.Stream != nil && op.Stream.Source != nil && op.Prepared != nil && op.Prepared.SessionId == op.Intended.SessionID && op.URI != "" && validContentRequest(contentPrepareRequest{Action: op.Action, Args: op.Args}) && !op.RadioCommitDeadline.IsZero() && time.Now().Before(op.RadioCommitDeadline)
+	if !valid {
+		op.mu.Unlock()
+		p.aliasMu.Unlock()
+		return nil, ErrAliasConflict
+	}
+	p.app.radio.mu.Lock()
+	valid = op.Radio.ClaimIntent == p.app.radio.Intent
+	p.app.radio.mu.Unlock()
+	if !valid {
+		op.mu.Unlock()
+		p.aliasMu.Unlock()
+		return nil, ErrAliasConflict
+	}
+	op.RadioRefreshConsumed = true
+	op.RadioPossible = true // Only the exact current intent may begin radio drain.
+	originalScope, originalURI, originalSession := op.Capture.Scope, op.URI, op.Intended.SessionID
+	op.mu.Unlock()
+	p.aliasMu.Unlock()
+	ctx, cancel := context.WithDeadline(ctx, op.RadioCommitDeadline)
+	defer cancel()
+	// A muted C-to-START custody bridge is required here. Opening the old stream
+	// first would briefly play it when another room already serves live Spotify.
+	if err := p.radioPrepareContentTransition(ctx, op); err != nil {
+		return nil, err
+	}
+	fresh, err := p.captureContent(originalScope)
+	if err != nil {
+		return nil, err
+	}
+	fresh.Radio = nil
+	var state contentCState
+	if op.Radio.Absence || op.Radio.Parked {
+		state.Target = op.Target
+		if op.Radio.Absence && !op.Radio.CurrentAbsence && op.Radio.hold.Absence.Binding.Source.Kind != "target" || op.Radio.Parked && op.Radio.hold.ParkedBridge != nil && op.Radio.hold.ParkedBridge.Current.Kind == "global_absence" {
+			fresh.OldOwner = nil
+		}
+	} else {
+		state, err = fresh.readCState(ctx)
+		if err != nil {
+			return nil, err
+		}
+	}
+
+	p.aliasMu.Lock()
+	op.mu.Lock()
+	if ctx.Err() != nil || op.Cancelled || op.Terminal || op.URI != originalURI || op.Capture.Scope != originalScope || op.Intended.SessionID != originalSession || !p.contentCurrentLocked(fresh) || p.roomNativeIntent == ^uint64(0) || p.aliasRevision >= 1<<53-1 {
+		op.mu.Unlock()
+		p.aliasMu.Unlock()
+		return nil, ErrAliasConflict
+	}
+	if !op.Radio.Absence && !op.Radio.Parked {
+		p.roomNativeIntent++
+	}
+	fresh.Intent = p.roomNativeIntent
+	op.Capture = fresh
+	op.Target = state.Target
+	if !op.Radio.Absence && !op.Radio.Parked {
+		op.Revision = strconv.FormatUint(p.roomNativeIntent, 10)
+	}
+	if !op.Radio.Absence && !op.Radio.Parked {
+		op.Intended = roomTransportIdentity{originalScope.AccountUserID, originalScope.TargetID, originalScope.RoomID, originalScope.HomePodID, fresh.Connection, originalSession, p.aliasIncarnation, fresh.Registry, fresh.AliasRevision + 1}
+	}
+	valid = nativeBoundOwnerValid(op.Intended)
+	op.mu.Unlock()
+	p.aliasMu.Unlock()
+	if !valid {
+		return nil, ErrAliasConflict
+	}
+	if err = p.bindRadioContentStart(ctx, op); err != nil {
+		return nil, err
+	}
+	return op, nil
+}
+func (p *AppPlayer) radioPrepareContentTransition(ctx context.Context, op *contentOperation) error {
+	if op.Radio == nil {
+		return ErrAliasConflict
+	}
+	if op.Radio.Parked {
+		return p.bindRadioParkedStart(ctx, op.Radio.hold, op)
+	}
+	if op.Radio.CurrentAbsence {
+		return p.bindRadioAbsenceCurrentStart(ctx, op.Radio.hold, op)
+	}
+	if op.Radio.Absence {
+		return p.bindRadioAbsenceStart(ctx, op.Radio.hold, op)
+	}
+	if op.Radio.HoldTarget == op.Capture.Scope.RoomID {
+		return p.preemptRadioMode(ctx, op.Capture.Scope.RoomID, "play", true)
+	}
+	return p.radioAdmitOtherTarget(ctx, op.Capture.Scope.RoomID, "play")
+}
+func (p *AppPlayer) bindRadioContentStart(ctx context.Context, op *contentOperation) error {
+	stage := op.Radio
+	if stage == nil {
+		return nil
+	}
+	if stage.Absence || stage.Parked {
+		return nil
+	}
+	if stage.HoldTarget != op.Capture.Scope.RoomID {
+		return nil
+	}
+	app := p.app
+	app.radio.mu.Lock()
+	h := app.radio.Holds[stage.HoldTarget]
+	if h == nil || h != stage.hold || h.Phase != "content_ready" || h.Reacquire == nil || h.ReacquireLatest == nil || h.ReacquireLatest.Phase != "barrier_ready" || !h.ReacquireLatest.Barrier {
+		app.radio.mu.Unlock()
+		return ErrAliasConflict
+	}
+	r := *h.Reacquire
+	app.radio.mu.Unlock()
+	r.Phase = "bind_start"
+	r.StartOfferID = op.Offer.OfferID
+	r.StartBindingID = op.Offer.BindingID
+	r.StartDigest = op.ContentDigest
+	r.StartIncarnation = op.Capture.Incarnation
+	r.StartRevision = op.Revision
+	ack, err := p.radioReacquireCall(ctx, h, r)
+	if err != nil {
+		return err
+	}
+	if ack.Phase != "barrier_ready" || !ack.Barrier || !ack.FutureStartBound || ack.StartOfferID != r.StartOfferID || ack.StartBindingID != r.StartBindingID || ack.StartDigest != r.StartDigest || ack.StartIncarnation != r.StartIncarnation || ack.StartRevision != r.StartRevision {
+		return ErrAliasConflict
+	}
+	app.radio.mu.Lock()
+	defer app.radio.mu.Unlock()
+	if app.radio.Holds[stage.HoldTarget] != h || h.Phase != "content_ready" {
+		return ErrAliasConflict
+	}
+	h.Phase = "content_bound"
+	return app.persistRadioLocked()
+}
+func (p *AppPlayer) completeRadioContent(op *contentOperation) error {
+	if op.Radio == nil || op.Radio.HoldTarget != op.Capture.Scope.RoomID {
+		return nil
+	}
+	p.aliasMu.Lock()
+	op.mu.Lock()
+	valid := op.Owner == p && op.Published && op.Terminal && op.State == "complete" && op.CReceipt != nil && op.CReceipt.Phase == "completed" && op.CReceipt.Actual != nil && *op.CReceipt.Actual == op.Intended && op.Actual != nil && *op.Actual == op.Intended && p.primaryStream == op.Stream && p.state.player == op.Prepared && p.roomNativeIntent == op.Capture.Intent && op.CReceipt.Route != nil && op.CReceipt.Route.DeviceID == op.Capture.Scope.HomePodID
+	op.mu.Unlock()
+	p.aliasMu.Unlock()
+	if !valid {
+		return ErrAliasConflict
+	}
+	app := p.app
+	app.radio.mu.Lock()
+	defer app.radio.mu.Unlock()
+	h := app.radio.Holds[op.Radio.HoldTarget]
+	if h == nil || h != op.Radio.hold || h.Phase != "content_bound" {
+		return ErrAliasConflict
+	}
+	if err := app.retireRadioLocked(h, op.CReceipt); err != nil {
+		return err
+	}
+	anyAbsence := false
+	for _, remaining := range app.radio.Holds {
+		if remaining.Absence != nil && remaining.Absence.Binding.Source.Kind != "target" && !radioAbsenceEvolved(remaining) {
+			anyAbsence = true
+		}
+	}
+	app.radioAbsenceFence.Store(anyAbsence)
+	app.refreshRadioOutputFenceLocked()
+	return nil
+}
+
+func (p *AppPlayer) radioContentIntentCurrent(op *contentOperation) bool {
+	if op.Radio == nil {
+		return true
+	}
+	p.app.radio.mu.Lock()
+	defer p.app.radio.mu.Unlock()
+	h := p.app.radio.Holds[op.Radio.HoldTarget]
+	if p.app.radio.failed || h == nil || h != op.Radio.hold || p.app.radio.Intent != op.Radio.ClaimIntent {
+		return false
+	}
+	if op.Radio.HoldTarget == op.Capture.Scope.RoomID {
+		return h.Phase == "content_bound"
+	}
+	return h.Phase == "prepared" || h.Phase == "suspended"
+}
+
+func (p *AppPlayer) unknownRadioContent(op *contentOperation) {
+	if op.Radio == nil {
+		return
+	}
+	p.app.radio.mu.Lock()
+	defer p.app.radio.mu.Unlock()
+	if h := p.app.radio.Holds[op.Radio.HoldTarget]; h != nil && h == op.Radio.hold {
+		h.Phase = "unknown"
+		_ = p.app.persistRadioLocked()
+	}
+}
