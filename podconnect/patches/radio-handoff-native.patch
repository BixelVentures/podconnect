@@ -0,0 +1,706 @@
+package daemon
+
+// Native radio custody is default off. A persisted uncertain hold is never
+// released by a timeout, session replacement, process restart or API retry.
+import (
+	"context"
+	"crypto/sha256"
+	"crypto/subtle"
+	"encoding/hex"
+	"encoding/json"
+	"fmt"
+	"net/http"
+	"os"
+	"path/filepath"
+	"strconv"
+	"strings"
+	"sync"
+	"time"
+
+	"github.com/devgianlu/go-librespot/output"
+	"github.com/devgianlu/go-librespot/player"
+)
+
+const apiRadioHTTP ApiRequestType = "radio_http"
+const apiRadioHandoff ApiRequestType = "radio_handoff"
+
+type radioPeer struct {
+	Process string `json:"radio_process"`
+	Epoch   string `json:"radio_owner_epoch"`
+	Digest  string `json:"receiver_key_digest"`
+}
+type radioRequest struct {
+	Schema           string    `json:"schema"`
+	ProcessID        string    `json:"process_id"`
+	TargetID         string    `json:"target_id"`
+	HandoffID        string    `json:"handoff_id"`
+	Generation       string    `json:"generation"`
+	ActionID         string    `json:"action_id"`
+	Peer             radioPeer `json:"sender_peer"`
+	Token            string    `json:"token,omitempty"`
+	ExpectedRevision string    `json:"expected_native_revision"`
+}
+type radioCBinding struct {
+	Schema        string                `json:"schema"`
+	Owner         roomTransportIdentity `json:"native_owner"`
+	Revision      string                `json:"native_revision"`
+	Writer        queueWriterWire       `json:"writer_proof"`
+	Output        roomVolumeRoute       `json:"output_identity"`
+	HandoffID     string                `json:"handoff_id"`
+	Generation    string                `json:"generation"`
+	SourceEpoch   string                `json:"source_owner_epoch"`
+	SenderPeer    string                `json:"sender_peer"`
+	RadioProcess  string                `json:"radio_process"`
+	RadioEpoch    string                `json:"radio_owner_epoch"`
+	Digest        string                `json:"receiver_key_digest"`
+	Token         string                `json:"token,omitempty"`
+	InitialVolume int                   `json:"initial_volume_percent"`
+}
+type radioCReply struct {
+	radioCBinding
+	Purpose       string   `json:"purpose"`
+	OK            bool     `json:"ok"`
+	Actions       []string `json:"actions"`
+	Physical      bool     `json:"physical_result_verified"`
+	Phase         string   `json:"phase"`
+	RequiresPause bool     `json:"requires_native_pause"`
+	StopCode      int      `json:"stop_code"`
+	StopCSeq      int      `json:"stop_cseq"`
+	Signature     string   `json:"suspended_signature,omitempty"`
+}
+type radioHold struct {
+	evolutionActive    bool
+	Request            radioRequest              `json:"request"`
+	Proof              radioCBinding             `json:"proof"`
+	Phase              string                    `json:"phase"`
+	RequiresPause      bool                      `json:"requires_native_pause"`
+	Actions            map[string]bool           `json:"actions"`
+	Latest             *radioCReply              `json:"latest,omitempty"`
+	ObservedAt         string                    `json:"observed_at,omitempty"`
+	WriterParked       bool                      `json:"writer_parked"`
+	PauseUncertain     bool                      `json:"pause_uncertain,omitempty"`
+	PausedBefore       *bool                     `json:"paused_before,omitempty"`
+	OtherGrant         *radioOtherRequest        `json:"other_target_grant,omitempty"`
+	OtherGrantPhase    string                    `json:"other_target_phase,omitempty"`
+	OtherObserved      *radioOtherObservation    `json:"other_target_observed,omitempty"`
+	Reacquire          *radioReacquire           `json:"reacquire,omitempty"`
+	ReacquirePhase     string                    `json:"reacquire_phase,omitempty"`
+	ReacquireLatest    *radioReacquireReply      `json:"reacquire_latest,omitempty"`
+	Absence            *radioAbsenceHold         `json:"absence,omitempty"`
+	Parked             *radioParkedHold          `json:"parked_absence,omitempty"`
+	ParkedBridge       *radioParkedBridgeRequest `json:"parked_bridge,omitempty"`
+	ParkedBridgePhase  string                    `json:"parked_bridge_phase,omitempty"`
+	ParkedBridgeLatest *radioParkedBridgeReply   `json:"parked_bridge_latest,omitempty"`
+	Move               *radioMoveRequest         `json:"move_binding,omitempty"`
+	MovePhase          string                    `json:"move_phase,omitempty"`
+	MoveLatest         *radioMoveReply           `json:"move_latest,omitempty"`
+	SenderDrain        json.RawMessage           `json:"sender_drain,omitempty"`
+	SourceMove         *radioSourceMoveRequest   `json:"source_move,omitempty"`
+	SourceMoveLatest   *radioSourceMoveReceipt   `json:"source_move_latest,omitempty"`
+	SourceMovePhase    string                    `json:"source_move_phase,omitempty"`
+	primary            *player.Stream
+	owner              *AppPlayer
+}
+type radioRegistry struct {
+	mu         sync.Mutex
+	Holds      map[string]*radioHold     `json:"holds"`
+	Rejected   map[string]radioRejection `json:"rejected"`
+	Terminal   map[string]*radioTerminal `json:"terminal,omitempty"`
+	Generation uint64                    `json:"generation"`
+	Intent     uint64                    `json:"intent"`
+	failed     bool
+}
+type radioHTTPCall struct {
+	Token, Action string
+	Request       radioRequest
+	Context       context.Context
+}
+type radioActorRequest struct {
+	Action  string
+	Request radioRequest
+	Context context.Context
+}
+type radioTarget struct {
+	ID             string `json:"id"`
+	Name           string `json:"name"`
+	HomePodID      string `json:"homepod_id"`
+	Availability   string `json:"availability"`
+	Selectable     bool   `json:"selectable"`
+	Default        bool   `json:"default"`
+	ReceiverDigest string `json:"receiver_key_digest,omitempty"`
+}
+
+func radioProcessID(p contentProcess) string {
+	b, _ := json.Marshal(p)
+	sum := sha256.Sum256(b)
+	return hex.EncodeToString(sum[:])
+}
+func (app *App) radioEnabled() bool {
+	return app.cfg != nil && len(app.cfg.RadioHandoffControlToken) >= 32 && roomTransportURL(app.cfg.RadioHandoffOwnerURL) && filepath.IsAbs(app.cfg.RadioHandoffStatePath)
+}
+func (app *App) initRadio() error {
+	app.radio.Holds = map[string]*radioHold{}
+	app.radio.Rejected = map[string]radioRejection{}
+	if !app.radioEnabled() {
+		return nil
+	}
+	info, err := os.Lstat(app.cfg.RadioHandoffStatePath)
+	if os.IsNotExist(err) {
+		return nil
+	}
+	if err != nil || !info.Mode().IsRegular() || info.Mode().Perm()&0077 != 0 {
+		return fmt.Errorf("radio handoff journal is not private regular file")
+	}
+	raw, err := os.ReadFile(app.cfg.RadioHandoffStatePath)
+	if err != nil {
+		return err
+	}
+	var disk struct {
+		Holds      map[string]*radioHold     `json:"holds"`
+		Rejected   map[string]radioRejection `json:"rejected"`
+		Terminal   map[string]*radioTerminal `json:"terminal,omitempty"`
+		Generation uint64                    `json:"generation"`
+		Intent     uint64                    `json:"intent"`
+	}
+	if len(raw) > 1048576 || strictVolumeJSON(raw, &disk) != nil || disk.Holds == nil {
+		return fmt.Errorf("invalid radio handoff journal")
+	}
+	for key, h := range disk.Holds {
+		if h == nil || key != h.Request.TargetID || !validRadioRequest(h.Request) || h.Actions == nil {
+			return fmt.Errorf("invalid radio hold")
+		}
+		if h.Parked != nil && (h.Absence != nil || h.WriterParked || h.PauseUncertain || h.RequiresPause) {
+			return fmt.Errorf("invalid parked receiver custody")
+		}
+		h.Phase = "unknown"
+		if h.Parked != nil {
+			// A parked child owns only its receiver, including after restart.
+		} else if h.Absence != nil && h.Absence.Binding.Source.Kind != "target" {
+			app.radioAbsenceFence.Store(true)
+		} else if h.Absence == nil {
+			app.radioOutputFence.Store(true)
+		}
+	}
+	app.radio.Holds, app.radio.Generation, app.radio.Intent = disk.Holds, disk.Generation, disk.Intent
+	if len(disk.Terminal) > radioTerminalLimit {
+		return fmt.Errorf("radio terminal journal oversized")
+	}
+	app.radio.Terminal = disk.Terminal
+	for key, terminal := range app.radio.Terminal {
+		if terminal == nil || key != radioTerminalKey(terminal.Request) || !validRadioRequest(terminal.Request) || !volumeHex32.MatchString(terminal.Token) || !json.Valid(terminal.Source) || !json.Valid(terminal.Drain) || !json.Valid(terminal.Commit) {
+			return fmt.Errorf("invalid radio terminal journal")
+		}
+		if _, err := time.Parse(time.RFC3339Nano, terminal.At); err != nil {
+			return fmt.Errorf("invalid radio terminal timestamp")
+		}
+	}
+	if len(disk.Rejected) > 128 {
+		return fmt.Errorf("radio rejection journal oversized")
+	}
+	if disk.Rejected != nil {
+		app.radio.Rejected = disk.Rejected
+	}
+	for key, rejected := range app.radio.Rejected {
+		if key != radioRejectionKey(rejected.Request) || !validRadioRequest(rejected.Request) || rejected.Schema != "podconnect.native_radio_handoff_rejected.v1" || !rejected.Rejected || rejected.EffectsStarted || !rejected.Terminal || rejected.Reason != "stale_intent" || rejected.Request.Token != "" {
+			return fmt.Errorf("invalid radio rejection journal")
+		}
+	}
+	return nil
+}
+func (app *App) persistRadioLocked() error {
+	b, err := json.Marshal(&app.radio)
+	if err != nil {
+		return err
+	}
+	path := app.cfg.RadioHandoffStatePath
+	// Exclusive sibling creation and atomic rename preserve old durable custody on failure.
+	f, err := os.OpenFile(path+".pending", os.O_WRONLY|os.O_CREATE|os.O_EXCL, 0600)
+	if err != nil {
+		app.radio.failed = true
+		return err
+	}
+	defer os.Remove(path + ".pending")
+	if _, err = f.Write(b); err == nil {
+		err = f.Sync()
+	}
+	closeErr := f.Close()
+	if err == nil {
+		err = closeErr
+	}
+	if err == nil {
+		err = os.Rename(path+".pending", path)
+	}
+	if err == nil {
+		var d *os.File
+		d, err = os.Open(filepath.Dir(path))
+		if err == nil {
+			err = d.Sync()
+			d.Close()
+		}
+	}
+	if err != nil {
+		app.radio.failed = true
+	}
+	return err
+}
+func validRadioRequest(r radioRequest) bool {
+	return volumeCounter(r.ExpectedRevision) && r.Schema == "podconnect.native_radio_handoff.v1" && volumeHex64.MatchString(r.ProcessID) && nativeOwnerASCII(r.TargetID, 255) && volumeUUID.MatchString(r.HandoffID) && volumeCounter(r.Generation) && r.Generation != "0" && volumeUUID.MatchString(r.ActionID) && volumeUUID.MatchString(r.Peer.Process) && volumeCounter(r.Peer.Epoch) && r.Peer.Epoch != "0" && volumeHex64.MatchString(r.Peer.Digest)
+}
+func (app *App) radioState() any {
+	app.radio.mu.Lock()
+	revision := strconv.FormatUint(app.radio.Intent, 10)
+	app.radio.mu.Unlock()
+	process, valid := nativeContentProcess()
+	targets := []radioTarget{}
+	cfg := app.cfg
+	if cfg != nil && len(cfg.DeviceAliasRoomIDs) == len(cfg.DeviceAliases) && len(cfg.DeviceAliasRoomIDs) == len(cfg.DeviceAliasHomePodIDs) {
+		seen := map[string]bool{}
+		for i, id := range cfg.DeviceAliasRoomIDs {
+			if id == "" || seen[id] || !homePodIDPattern.MatchString(cfg.DeviceAliasHomePodIDs[i]) {
+				targets = nil
+				break
+			}
+			seen[id] = true
+			targets = append(targets, radioTarget{id, cfg.DeviceAliases[i], cfg.DeviceAliasHomePodIDs[i], "unknown", false, i == 0, ""})
+		}
+	}
+	missing := []string{"fresh_explicit_intent_reacquire_ticket", "global_clean_absence_without_spotify_writer"}
+	if !valid {
+		missing = append(missing, "linux_native_process_identity")
+	}
+	if !app.radioEnabled() {
+		missing = append(missing, "radio_handoff_configuration")
+	}
+	return struct {
+		Schema    string         `json:"schema"`
+		ProcessID string         `json:"process_id"`
+		Process   contentProcess `json:"native_process"`
+		Targets   []radioTarget  `json:"configured_targets"`
+		Missing   []string       `json:"missing_proofs"`
+		Revision  string         `json:"native_revision"`
+	}{"podconnect.native_radio_handoff_state.v1", radioProcessID(process), process, targets, missing, revision}
+}
+func (s *ConcreteApiServer) handleRadioHTTP(w http.ResponseWriter, r *http.Request) {
+	action := strings.TrimPrefix(r.URL.Path, "/radio/handoff/")
+	call := radioHTTPCall{Token: r.Header.Get("X-PodConnect-Token"), Action: action, Context: r.Context()}
+	if action == "state" {
+		if r.Method != http.MethodGet || r.URL.RawQuery != "" {
+			w.WriteHeader(400)
+			return
+		}
+	} else {
+		if action != "reserve" && action != "suspend" && action != "result" && action != "reacquire" {
+			w.WriteHeader(404)
+			return
+		}
+		if !roomTransportBody(w, r, &call.Request) {
+			return
+		}
+	}
+	ctx, cancel := context.WithTimeout(r.Context(), 8*time.Second)
+	defer cancel()
+	data, err := s.roomTransportAsk(ctx, apiRadioHTTP, call)
+	if err == ErrForbidden {
+		w.WriteHeader(403)
+		return
+	}
+	roomTransportResponse(w, data, err)
+}
+func (app *App) handleRadioAPI(ctx context.Context, req ApiRequest) {
+	c, ok := req.Data.(radioHTTPCall)
+	if !ok || app.cfg == nil || app.cfg.RadioHandoffControlToken == "" || subtle.ConstantTimeCompare([]byte(c.Token), []byte(app.cfg.RadioHandoffControlToken)) != 1 {
+		req.Reply(nil, ErrForbidden)
+		return
+	}
+	if c.Action == "state" {
+		req.Reply(app.radioStateObserved(ctx), nil)
+		return
+	}
+	process, ok := nativeContentProcess()
+	if !app.radioEnabled() || !validRadioRequest(c.Request) {
+		req.Reply(nil, ErrAliasConflict)
+		return
+	}
+	if c.Action == "result" {
+		app.radio.mu.Lock()
+		terminal := app.radio.Terminal[radioTerminalKey(c.Request)]
+		if terminal.matches(c.Request) {
+			data := terminal.wire(c.Request)
+			app.radio.mu.Unlock()
+			req.Reply(data, nil)
+			return
+		}
+		app.radio.mu.Unlock()
+	}
+	if !ok || c.Request.ProcessID != radioProcessID(process) {
+		req.Reply(nil, ErrAliasConflict)
+		return
+	}
+	if c.Action == "reserve" {
+		app.radio.mu.Lock()
+		stale := app.radio.Holds[c.Request.TargetID] == nil && c.Request.Token == "" && c.Request.ExpectedRevision != strconv.FormatUint(app.radio.Intent, 10)
+		if stale {
+			data, err := app.rejectStaleRadioLocked(c.Request)
+			app.radio.mu.Unlock()
+			req.Reply(data, err)
+			return
+		}
+		app.radio.mu.Unlock()
+	}
+	// A released56 manual-release transaction owns the source until its
+	// exact terminal cleanup. Read-only radio results remain available.
+	if c.Action != "result" && c.Action != "observe" && app.manualReleasePending() {
+		req.Reply(nil, ErrAliasConflict)
+		return
+	}
+	if handled, data, err := app.radioParkedAPI(ctx, c); handled {
+		req.Reply(data, err)
+		return
+	}
+	if handled, data, err := app.radioAbsenceAPI(ctx, c); handled {
+		req.Reply(data, err)
+		return
+	}
+	if c.Action == "result" {
+		data, err := app.radioReadResult(ctx, c.Request)
+		req.Reply(data, err)
+		return
+	}
+	app.ownerMu.Lock()
+	ch, done := app.currentAPI, app.currentDone
+	app.ownerMu.Unlock()
+	if ch == nil {
+		req.Reply(nil, ErrAliasConflict)
+		return
+	}
+	actor, wait := NewApiRequest(apiRadioHandoff, radioActorRequest{c.Action, c.Request, c.Context})
+	select {
+	case ch <- actor:
+		data, err := wait(ctx)
+		req.Reply(data, err)
+	case <-done:
+		req.Reply(nil, ErrAliasConflict)
+	case <-ctx.Done():
+		req.Reply(nil, ctx.Err())
+	}
+}
+func (p *AppPlayer) radioHeld() bool {
+	if p == nil || p.app == nil {
+		return false
+	}
+	p.app.radio.mu.Lock()
+	defer p.app.radio.mu.Unlock()
+	return p.app.radio.failed || len(p.app.radio.Holds) > 0
+}
+
+func (p *AppPlayer) radioHandoffActor(ctx context.Context, a radioActorRequest) (any, error) {
+	ctx, cancel := queueOperationContext(ctx, a.Context)
+	defer cancel()
+	if a.Action == "observe" {
+		return p.radioObserveSource(ctx, a.Request.TargetID)
+	}
+	app := p.app
+	app.radio.mu.Lock()
+	defer app.radio.mu.Unlock()
+	if app.radio.failed || ctx.Err() != nil {
+		return nil, ErrAliasConflict
+	}
+	r := a.Request
+	h := app.radio.Holds[r.TargetID]
+	if a.Action == "reserve" {
+		if h == nil && r.Token == "" && r.ExpectedRevision != strconv.FormatUint(app.radio.Intent, 10) {
+			return app.rejectStaleRadioLocked(r)
+		}
+		if h != nil || r.Token != "" || p.radioHasExclusiveLocked() || p.roomVolumeBusy() || p.sess == nil {
+			return nil, ErrAliasConflict
+		}
+		var hp string
+		for i, id := range app.cfg.DeviceAliasRoomIDs {
+			if id == r.TargetID && i < len(app.cfg.DeviceAliasHomePodIDs) {
+				hp = app.cfg.DeviceAliasHomePodIDs[i]
+			}
+		}
+		owner, err := p.radioSourceOwner()
+		if err != nil {
+			return nil, err
+		}
+		writer, err := p.captureQueueWriter(ctx, owner, nil)
+		if err != nil {
+			return nil, err
+		}
+		revision, err := p.nextNativeIntent()
+		if err != nil {
+			return nil, err
+		}
+		var state struct {
+			Schema   string                `json:"schema"`
+			OK       bool                  `json:"ok"`
+			Owner    roomTransportIdentity `json:"native_owner"`
+			Writer   queueWriterWire       `json:"writer_proof"`
+			Identity roomVolumeRoute       `json:"output_identity"`
+			Digest   string                `json:"receiver_key_digest"`
+			Volume   int                   `json:"initial_volume_percent"`
+			Purpose  string                `json:"purpose"`
+			Physical bool                  `json:"physical_result_verified"`
+		}
+		endpoint := strings.TrimSuffix(app.cfg.RoomTransportOwnToneURL, "/") + "/api/outputs/" + hp + "/radio-handoff/source-state"
+		payload := struct {
+			Schema string                `json:"schema"`
+			Owner  roomTransportIdentity `json:"native_owner"`
+			Writer queueWriterWire       `json:"writer_proof"`
+		}{"podconnect.output_radio_source_state.v1", owner, writer.Wire}
+		if err = radioControlHTTP(ctx, http.MethodPost, endpoint, app.cfg.RadioHandoffControlToken, payload, &state); err != nil || state.Schema != payload.Schema || !state.OK || state.Physical || state.Purpose != "radio_handoff_v1" || state.Owner != owner || state.Writer != writer.Wire || !state.Identity.valid() || state.Identity.DeviceID != hp || state.Identity.InputPathDigest != writer.Wire.InputDigest || state.Digest != r.Peer.Digest || state.Volume < 0 || state.Volume > 100 {
+			return nil, ErrAliasConflict
+		}
+
+		gen, err := strconv.ParseUint(r.Generation, 10, 64)
+		if err != nil || gen <= app.radio.Generation {
+			return nil, ErrAliasConflict
+		}
+		app.radio.Generation = gen
+		h = &radioHold{Request: r, Proof: radioCBinding{Schema: "podconnect.output_radio_handoff.v1", Owner: owner, Revision: revision, Writer: writer.Wire, Output: state.Identity, HandoffID: r.HandoffID, Generation: r.Generation, SourceEpoch: writer.Wire.Epoch, SenderPeer: r.Peer.Process, RadioProcess: r.Peer.Process, RadioEpoch: r.Peer.Epoch, Digest: r.Peer.Digest, InitialVolume: state.Volume}, Phase: "reserved", Actions: map[string]bool{"reserve:" + r.ActionID: true}, owner: p, primary: p.primaryStream}
+		app.radioOutputFence.Store(true)
+		app.radio.Holds[r.TargetID] = h
+		if err = app.persistRadioLocked(); err != nil {
+			return nil, err
+		}
+		// No preparation effect is retried after any ambiguous response.
+		ack, err := p.radioOwnerCall(ctx, h, "prepare")
+		if err != nil {
+			h.Phase = "unknown"
+			_ = app.persistRadioLocked()
+			return nil, err
+		}
+		h.Proof.Token = ack.Token
+		h.RequiresPause = ack.RequiresPause
+		h.Phase = ack.Phase
+		h.Latest = ack
+		h.ObservedAt = time.Now().UTC().Format(time.RFC3339Nano)
+		if err = app.persistRadioLocked(); err != nil {
+			return nil, err
+		}
+		return radioReply(h, r), nil
+	}
+	if h == nil || h.owner != p || h.Request.ProcessID != r.ProcessID || h.Request.HandoffID != r.HandoffID || h.Request.Generation != r.Generation || h.Request.Peer != r.Peer || h.Request.ExpectedRevision != r.ExpectedRevision || (r.Token != h.Proof.Token || !volumeHex32.MatchString(r.Token)) && !(a.Action == "result" && r.Token == "") || h.Actions[a.Action+":"+r.ActionID] {
+		return nil, ErrAliasConflict
+	}
+	h.Actions[a.Action+":"+r.ActionID] = true
+	if err := app.persistRadioLocked(); err != nil {
+		return nil, err
+	}
+	switch a.Action {
+	case "suspend":
+		if h.Phase != "prepared" || r.ExpectedRevision != strconv.FormatUint(app.radio.Intent, 10) {
+			return nil, ErrAliasConflict
+		}
+		if h.RequiresPause && (h.primary == nil || p.primaryStream != h.primary) {
+			return nil, ErrAliasConflict
+		}
+		h.Phase = "unknown"
+		// A bounded pause may finish without delivering its receipt. Keep EOF
+		// custody until exact suspension is observed; timeout never advances queue.
+		if h.RequiresPause {
+			paused := p.state.player.IsPaused
+			h.PausedBefore = &paused
+		}
+		h.PauseUncertain = h.RequiresPause
+		if err := app.persistRadioLocked(); err != nil {
+			return nil, err
+		}
+		if h.RequiresPause {
+			generation, _ := strconv.ParseUint(h.Proof.Generation, 10, 64)
+			b := output.RadioPipeBinding{Token: h.Proof.Token, Generation: generation, Writer: output.MovePipeIdentity{PipeIdentity: h.Proof.Writer.Pipe, FD: h.Proof.Writer.FD}}
+			guard := func() error {
+				if ctx.Err() != nil {
+					return ctx.Err()
+				}
+				app.moveCustodyMu.Lock()
+				defer app.moveCustodyMu.Unlock()
+				if app.openedWriterOwner != p || app.openedWriter != b.Writer {
+					return ErrAliasConflict
+				}
+				return nil
+			}
+			paused, err := p.player.PauseRadio(ctx, b, guard)
+			if err != nil {
+				return nil, err
+			}
+			if paused.PositionMS == nil {
+				return nil, ErrAliasConflict
+			}
+			p.state.player.PositionAsOfTimestamp = *paused.PositionMS
+			p.state.player.Timestamp = time.Now().UnixMilli()
+			p.state.setPaused(true)
+			state, err := p.player.SuspendRadio(ctx, b, guard)
+			if err != nil || !state.Suspended || !state.WriterClosed {
+				return nil, ErrAliasConflict
+			}
+			h.WriterParked = true
+			h.PauseUncertain = false
+			if err = app.persistRadioLocked(); err != nil {
+				return nil, err
+			}
+		}
+		ack, err := p.radioOwnerCall(ctx, h, "confirm")
+		if err != nil {
+			_ = app.persistRadioLocked()
+			return nil, err
+		}
+		h.Latest = ack
+		h.ObservedAt = time.Now().UTC().Format(time.RFC3339Nano)
+		h.Phase = ack.Phase
+	case "result":
+		if h.Proof.Token == "" {
+			return radioReply(h, r), nil
+		}
+		ack, err := p.radioOwnerCall(ctx, h, "state")
+		if err != nil {
+			return nil, err
+		}
+		h.Latest = ack
+		h.ObservedAt = time.Now().UTC().Format(time.RFC3339Nano)
+		h.Phase = ack.Phase
+	case "reacquire":
+		return nil, ErrAliasConflict // Requires real one-shot receiver ticket; never synthesize it.
+	default:
+		return nil, ErrBadRequest
+	}
+	if err := app.persistRadioLocked(); err != nil {
+		return nil, err
+	}
+	return radioReply(h, r), nil
+}
+func (p *AppPlayer) radioHasExclusiveLocked() bool {
+	for _, h := range p.app.radio.Holds {
+		if radioGlobalCustodyRequired(h) {
+			return true
+		}
+	}
+	return false
+}
+func (p *AppPlayer) radioOwnerCall(ctx context.Context, h *radioHold, action string) (*radioCReply, error) {
+	var ack radioCReply
+	endpoint := strings.TrimSuffix(p.app.cfg.RoomTransportOwnToneURL, "/") + "/api/outputs/" + h.Proof.Output.DeviceID + "/radio-handoff/" + action
+	if err := radioControlHTTP(ctx, http.MethodPost, endpoint, p.app.cfg.RadioHandoffControlToken, h.Proof, &ack); err != nil {
+		return nil, err
+	}
+	if action != "prepare" && ack.RequiresPause != h.RequiresPause {
+		return nil, ErrAliasConflict
+	}
+	expected := h.Proof
+	expected.Token = ack.Token
+	if !ack.OK || ack.Purpose != "radio_handoff_v1" || ack.Physical || ack.radioCBinding != expected || !volumeHex32.MatchString(ack.Token) || h.Proof.Token != "" && ack.Token != h.Proof.Token || (ack.Phase != "prepared" && ack.Phase != "stopping" && ack.Phase != "suspended" && ack.Phase != "unknown") || ack.Phase == "suspended" && !volumeHex64.MatchString(ack.Signature) {
+		return nil, ErrAliasConflict
+	}
+	return &ack, nil
+}
+func radioReply(h *radioHold, requests ...radioRequest) any {
+	request := h.Request
+	if len(requests) > 0 {
+		request = requests[0]
+	}
+	return struct {
+		Schema string `json:"schema"`
+		radioRequest
+		Token              string `json:"token"`
+		Phase              string `json:"phase"`
+		Proof              any    `json:"proof"`
+		RequiresPause      bool   `json:"requires_native_pause"`
+		ObservedAt         string `json:"observed_at"`
+		SuspendedSignature string `json:"suspended_signature,omitempty"`
+	}{"podconnect.native_radio_handoff.v1", request, radioHoldToken(h), h.Phase, radioHoldProof(h), h.RequiresPause, h.ObservedAt, radioHoldSignature(h)}
+}
+
+// radioExclusiveParked prevents a stale EOF event from consuming the retained
+// queue while its exact writer is in radio custody.
+func (p *AppPlayer) radioExclusiveParked() bool {
+	if p == nil || p.app == nil {
+		return false
+	}
+	p.app.radio.mu.Lock()
+	defer p.app.radio.mu.Unlock()
+	for _, h := range p.app.radio.Holds {
+		if h.owner == p && (h.WriterParked || h.PauseUncertain) {
+			return true
+		}
+	}
+	return false
+}
+
+// Every explicit intent invalidates older radio preflight, even same-track play.
+func (p *AppPlayer) invalidateRadioPreflight() error {
+	if p == nil || p.app == nil || !p.app.radioEnabled() {
+		return nil
+	}
+	p.app.radio.mu.Lock()
+	defer p.app.radio.mu.Unlock()
+	if p.app.radio.Intent == ^uint64(0) {
+		return ErrAliasConflict
+	}
+	p.app.radio.Intent++
+	return nil
+}
+
+// Passive result reads cannot queue behind an explicit actor waiting for the
+// manager's preempt callback; that callback may itself need this persisted hold.
+func (app *App) radioReadResult(ctx context.Context, r radioRequest) (any, error) {
+	app.radio.mu.Lock()
+	if terminal := app.radio.Terminal[radioTerminalKey(r)]; terminal.matches(r) {
+		data := terminal.wire(r)
+		app.radio.mu.Unlock()
+		return data, nil
+	}
+	if rejected, ok := app.radio.Rejected[radioRejectionKey(r)]; ok && rejected.Request == r {
+		app.radio.mu.Unlock()
+		return rejected.wire(), nil
+	}
+	h := app.radio.Holds[r.TargetID]
+	if h == nil || h.Request.ProcessID != r.ProcessID || h.Request.HandoffID != r.HandoffID || h.Request.Generation != r.Generation || h.Request.ExpectedRevision != r.ExpectedRevision || h.Request.Peer != r.Peer || r.Token != "" && r.Token != h.Proof.Token {
+		app.radio.mu.Unlock()
+		return nil, ErrAliasConflict
+	}
+	snapshot := *h
+	if h.Phase == "reacquiring" || strings.HasPrefix(h.Phase, "content_") || strings.HasPrefix(h.Phase, "move_") || h.Proof.Token == "" || h.owner == nil {
+		data := radioReply(h, r)
+		app.radio.mu.Unlock()
+		return data, nil
+	}
+	app.radio.mu.Unlock()
+	ack, err := snapshot.owner.radioOwnerCall(ctx, &snapshot, "state")
+	if err != nil {
+		return nil, err
+	}
+	app.radio.mu.Lock()
+	defer app.radio.mu.Unlock()
+	if app.radio.Holds[r.TargetID] != h || h.Proof != snapshot.Proof || h.Phase != snapshot.Phase {
+		return nil, ErrAliasConflict
+	}
+	h.Latest = ack
+	h.ObservedAt = time.Now().UTC().Format(time.RFC3339Nano)
+	h.Phase = ack.Phase
+	if err = app.persistRadioLocked(); err != nil {
+		return nil, err
+	}
+	return radioReply(h, r), nil
+}
+
+func (p *AppPlayer) takeRadioDeferredEOF() []*player.Event {
+	events, source := p.radioDeferredEOF, p.radioDeferredSource
+	p.radioDeferredEOF, p.radioDeferredSource = nil, nil
+	if source == nil || source != p.primaryStream {
+		return nil
+	}
+	return events
+}
+
+// Writer admission reads only atomics under moveCustodyMu, never radio.mu.
+// Only an exact committed START permit or dedicated C handoff may create FIFO.
+func (app *App) refreshRadioOutputFenceLocked() {
+	held := app.radio.failed
+	for _, h := range app.radio.Holds {
+		if h.Absence == nil && h.Parked == nil {
+			held = true
+		}
+	}
+	app.radioOutputFence.Store(held)
+}
