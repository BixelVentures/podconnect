index 0000000..a748325
--- /dev/null
+++ b/daemon/radio_absence_start.go
@@ -0,0 +1,176 @@
+package daemon
+
+import (
+	"context"
+	"encoding/json"
+	"strings"
+)
+
+type radioAbsenceFuture struct {
+	Process     contentProcess         `json:"native_process"`
+	OfferID     string                 `json:"offer_id"`
+	BindingID   string                 `json:"binding_id"`
+	Digest      string                 `json:"content_digest"`
+	Incarnation string                 `json:"native_incarnation"`
+	Revision    string                 `json:"native_revision"`
+	OldOwner    *roomTransportIdentity `json:"old_native_owner"`
+	Intended    roomTransportIdentity  `json:"intended_native_owner"`
+	Path        string                 `json:"expected_input_path"`
+	PathDigest  string                 `json:"expected_input_path_digest"`
+	Policy      string                 `json:"policy_revision"`
+	Percent     int                    `json:"start_volume_percent"`
+}
+type radioAbsenceStartRequest struct {
+	Schema          string              `json:"schema"`
+	Phase           string              `json:"phase"`
+	Hold            radioAbsenceBinding `json:"hold"`
+	Future          radioAbsenceFuture  `json:"future_start"`
+	IntentID        string              `json:"intent_id"`
+	Challenge       string              `json:"challenge,omitempty"`
+	DrainGeneration string              `json:"drain_generation,omitempty"`
+	DrainSignature  string              `json:"drain_signature,omitempty"`
+	VolumeKind      string              `json:"final_volume_kind,omitempty"`
+	VolumePercent   *int                `json:"final_volume_percent,omitempty"`
+	VolumeRevision  string              `json:"final_volume_revision,omitempty"`
+}
+type radioAbsenceStartReply struct {
+	Schema             string              `json:"schema"`
+	OK                 bool                `json:"ok"`
+	Purpose            string              `json:"purpose"`
+	Phase              string              `json:"phase"`
+	Hold               radioAbsenceBinding `json:"hold"`
+	Future             radioAbsenceFuture  `json:"future_start"`
+	IntentID           string              `json:"intent_id"`
+	Challenge          string              `json:"challenge"`
+	ChallengeSignature string              `json:"challenge_signature"`
+	Target             contentTarget       `json:"target_identity"`
+	Physical           bool                `json:"physical_result_verified"`
+}
+
+func (p *AppPlayer) radioAbsenceStartCall(ctx context.Context, h *radioHold, r radioAbsenceStartRequest) (radioAbsenceStartReply, error) {
+	var out radioAbsenceStartReply
+	endpoint := strings.TrimSuffix(p.app.cfg.RoomTransportOwnToneURL, "/") + "/api/outputs/" + r.Hold.Output.DeviceID + "/radio-absence/bind-start"
+	if err := radioControlHTTP(ctx, "POST", endpoint, p.app.cfg.RadioHandoffControlToken, r, &out); err != nil {
+		return out, err
+	}
+	if out.Schema != r.Schema || !out.OK || out.Purpose != "radio_absence_start_v1" || out.Physical || contentDigest(out.Hold) != contentDigest(r.Hold) || contentDigest(out.Future) != contentDigest(r.Future) || out.IntentID != r.IntentID || !volumeHex32.MatchString(out.Challenge) || !volumeHex64.MatchString(out.ChallengeSignature) || r.Challenge != "" && out.Challenge != r.Challenge || out.Target.DeviceID != r.Hold.Output.DeviceID || out.Target.Process != r.Hold.Output.Process || out.Target.Incarnation != r.Hold.Output.Incarnation {
+		return out, ErrAliasConflict
+	}
+	return out, nil
+}
+
+// Bind the original consumed and prepared content operation. No old track is
+// resumed and the native output fence remains until the real START gate ACK.
+func (p *AppPlayer) bindRadioAbsenceStart(parent context.Context, h *radioHold, op *contentOperation) error {
+	if p == nil || p.app == nil || h == nil || h.Absence == nil || op == nil || op.Radio == nil || op.Capture == nil {
+		return ErrAliasConflict
+	}
+	ctx, cancel := context.WithDeadline(parent, op.RadioCommitDeadline)
+	defer cancel()
+	app := p.app
+	app.radio.mu.Lock()
+	if app.radio.failed || app.radio.Holds[h.Request.TargetID] != h || op.Radio.hold != h || op.Radio.ClaimIntent != app.radio.Intent || (h.Phase != "prepared" && h.Phase != "suspended") {
+		app.radio.mu.Unlock()
+		return ErrAliasConflict
+	}
+	binding := h.Absence.Binding
+	app.radio.mu.Unlock()
+	op.mu.Lock()
+	if !op.CommitClaimed || op.Cancelled || op.Terminal || op.State != "committing" || op.Stream == nil || op.Stream.Source == nil || op.Prepared == nil || op.Prepared.SessionId != op.Intended.SessionID || op.Intended.HomePodID != binding.Output.DeviceID || op.Revision == "" || !volumeHex64.MatchString(op.ContentDigest) {
+		op.mu.Unlock()
+		return ErrAliasConflict
+	}
+	future := radioAbsenceFuture{op.Capture.Process, op.Offer.OfferID, op.Offer.BindingID, op.ContentDigest, op.Capture.Incarnation, op.Revision, nil, op.Intended, op.Capture.Pipe, op.Capture.PipeDigest, start35Policy, 35}
+	if binding.Source.Kind == "target" {
+		future.OldOwner = op.Capture.OldOwner
+		if future.OldOwner == nil {
+			op.mu.Unlock()
+			return ErrAliasConflict
+		}
+	}
+	op.mu.Unlock()
+	intent, err := randomQueueID(16)
+	if err != nil {
+		return err
+	}
+	intent = intent[:8] + "-" + intent[8:12] + "-" + intent[12:16] + "-" + intent[16:20] + "-" + intent[20:]
+	request := radioAbsenceStartRequest{Schema: "podconnect.output_radio_absence_start.v1", Phase: "challenge", Hold: binding, Future: future, IntentID: intent}
+	persist := func(phase string, reply *radioAbsenceStartReply) error {
+		app.radio.mu.Lock()
+		defer app.radio.mu.Unlock()
+		if app.radio.Holds[h.Request.TargetID] != h || app.radio.Intent != op.Radio.ClaimIntent {
+			return ErrAliasConflict
+		}
+		h.Phase = phase
+		snapshot := request
+		h.Absence.Start = &snapshot
+		if reply != nil {
+			snapshotReply := *reply
+			h.Absence.StartLatest = &snapshotReply
+		}
+		return app.persistRadioLocked()
+	}
+	if err = persist("content_reacquiring", nil); err != nil {
+		return err
+	}
+	failed := true
+	defer func() {
+		if failed {
+			app.radio.mu.Lock()
+			h.Phase = "unknown"
+			_ = app.persistRadioLocked()
+			app.radio.mu.Unlock()
+		}
+	}()
+	challenge, err := p.radioAbsenceStartCall(ctx, h, request)
+	if err != nil || challenge.Phase != "challenge" {
+		return ErrAliasConflict
+	}
+	request.Challenge = challenge.Challenge
+	envelope, _ := json.Marshal(struct {
+		Challenge string `json:"challenge"`
+		Signature string `json:"challenge_signature"`
+	}{challenge.Challenge, challenge.ChallengeSignature})
+	callback := radioPreemptRequest{"podconnect.radio-preempt.v1", h.Request.ProcessID, h.Request.HandoffID, h.Request.Generation, binding.Token, h.Request.TargetID, intent, "play", envelope}
+	if err = persist("content_drain_pending", &challenge); err != nil {
+		return err
+	}
+	var stopped radioPreemptReply
+	endpoint := strings.TrimSuffix(app.cfg.RadioHandoffOwnerURL, "/") + "/api/radio/native-preempt"
+	if err = radioAuthenticatedHTTP(ctx, endpoint, app.cfg.RadioHandoffControlToken, callback, &stopped); err != nil {
+		return err
+	}
+	if stopped.Schema != callback.Schema || stopped.ProcessID != callback.ProcessID || stopped.HandoffID != callback.HandoffID || stopped.Generation != callback.Generation || stopped.ActionID != intent || !stopped.Terminal {
+		return ErrAliasConflict
+	}
+	var ticket radioDrainTicket
+	if json.Unmarshal(stopped.Ticket, &ticket) != nil || !ticket.valid(request.Challenge) {
+		return ErrAliasConflict
+	}
+	request.Phase = "commit"
+	request.DrainGeneration = ticket.Generation
+	request.DrainSignature = ticket.Signature
+	request.VolumeKind, request.VolumePercent, request.VolumeRevision = ticket.VolumeKind, ticket.VolumePercent, ticket.VolumeRevision
+	app.radio.mu.Lock()
+	if app.radio.Holds[h.Request.TargetID] != h || app.radio.Intent != op.Radio.ClaimIntent {
+		app.radio.mu.Unlock()
+		return ErrAliasConflict
+	}
+	h.SenderDrain = append(json.RawMessage(nil), stopped.Ticket...)
+	app.radio.mu.Unlock()
+	if err = persist("content_bind_pending", &challenge); err != nil {
+		return err
+	}
+	bound, err := p.radioAbsenceStartCall(ctx, h, request)
+	if err != nil || bound.Phase != "bound_start" {
+		return ErrAliasConflict
+	}
+	op.mu.Lock()
+	op.Target = bound.Target
+	op.mu.Unlock()
+	if err = persist("content_bound", &bound); err != nil {
+		return err
+	}
+	failed = false
+	return nil
+}
