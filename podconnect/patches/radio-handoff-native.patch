@@ -0,0 +1,381 @@
+package daemon
+
+import (
+	"context"
+	"encoding/json"
+	"sort"
+	"strings"
+	"time"
+)
+
+type radioAbsenceEvolution struct {
+	Serial        string             `json:"serial"`
+	Process       string             `json:"c_process"`
+	Future        radioAbsenceFuture `json:"start_future"`
+	Token         string             `json:"start_token"`
+	Reservation   string             `json:"native_reservation_id"`
+	MembersDigest string             `json:"member_set_digest"`
+	Effect        string             `json:"effect_generation"`
+	Completion    *contentCReceipt   `json:"completion"`
+}
+type radioTargetContinuity struct {
+	Identity   radioAbsenceReceiver `json:"identity"`
+	Digest     string               `json:"receiver_key_digest"`
+	Handoff    string               `json:"handoff_id"`
+	Generation string               `json:"generation"`
+	Serial     string               `json:"evolution_serial"`
+	Effect     string               `json:"effect_generation"`
+	ObservedAt string               `json:"observed_at"`
+	ValidUntil string               `json:"valid_until"`
+}
+type radioAbsenceCustody struct {
+	Schema        string                 `json:"schema"`
+	OK            bool                   `json:"ok"`
+	Purpose       string                 `json:"purpose"`
+	Hold          radioAbsenceBinding    `json:"hold"`
+	OriginalPhase string                 `json:"original_phase"`
+	Signature     *string                `json:"original_suspended_signature"`
+	Phase         string                 `json:"phase"`
+	Evolution     radioAbsenceEvolution  `json:"evolution"`
+	Continuity    *radioTargetContinuity `json:"target_continuity"`
+	Physical      bool                   `json:"physical_result_verified"`
+}
+type radioAbsenceStateUnion struct {
+	Original *radioAbsenceCReply
+	Custody  *radioAbsenceCustody
+}
+type radioEvolutionPermit struct {
+	hold  *radioHold
+	proof radioAbsenceCustody
+}
+
+func decodeRadioAbsenceCustody(raw []byte, out *radioAbsenceCustody) error {
+	var k radioAbsenceCustody
+	if err := decodeRadioNullable(raw, &k, "original_suspended_signature", "evolution.start_future.old_native_owner", "evolution.completion", "target_continuity"); err != nil {
+		return err
+	}
+	if k.Schema != "podconnect.output_radio_absence_custody.v1" || !k.OK || k.Purpose != "radio_absence_custody_v1" || k.Physical || k.Hold.Source.Kind != "global" || k.Hold.Source.Live != nil || !volumeHex32.MatchString(k.Hold.Token) || k.Evolution.Process != k.Hold.Output.Process || !volumeCounter(k.Evolution.Serial) || k.Evolution.Serial == "0" || !volumeCounter(k.Evolution.Effect) || k.Evolution.Effect == "0" || !volumeHex64.MatchString(k.Evolution.MembersDigest) || !volumeHex32.MatchString(k.Evolution.Token) || !volumeHex32.MatchString(k.Evolution.Reservation) {
+		return ErrBadRequest
+	}
+	if k.OriginalPhase == "suspended" {
+		if k.Signature == nil || !volumeHex64.MatchString(*k.Signature) {
+			return ErrBadRequest
+		}
+	} else if k.OriginalPhase != "prepared" || k.Signature != nil {
+		return ErrBadRequest
+	}
+	f := k.Evolution.Future
+	if f.Process != k.Hold.Source.Process || f.Path != k.Hold.Source.Path || f.PathDigest != k.Hold.Source.Digest || f.Intended.HomePodID == k.Hold.Output.DeviceID || !nativeBoundOwnerValid(f.Intended) || !volumeHex32.MatchString(f.OfferID) || !volumeHex64.MatchString(f.BindingID) || !volumeHex64.MatchString(f.Digest) || !volumeHex32.MatchString(f.Incarnation) || !volumeCounter(f.Revision) || f.Revision == "0" || f.Policy != start35Policy || f.Percent != 35 {
+		return ErrBadRequest
+	}
+	switch k.Phase {
+	case "evolution_pending":
+		if k.Evolution.Completion != nil || k.Continuity != nil {
+			return ErrBadRequest
+		}
+	case "source_evolved":
+		if k.OriginalPhase != "suspended" || !radioEvolutionCompletionMatches(k.Evolution.Completion, k.Evolution) || *k.Evolution.Completion.Pipe != k.Hold.Source.Pipe {
+			return ErrBadRequest
+		}
+	case "evolution_unknown":
+		if k.Continuity != nil || k.Evolution.Completion != nil && !radioEvolutionCompletionMatches(k.Evolution.Completion, k.Evolution) {
+			return ErrBadRequest
+		}
+	default:
+		return ErrBadRequest
+	}
+	if c := k.Continuity; c != nil {
+		at, e := time.Parse(time.RFC3339Nano, c.ObservedAt)
+		until, e2 := time.Parse(time.RFC3339Nano, c.ValidUntil)
+		now := time.Now()
+		if k.Phase != "source_evolved" || k.OriginalPhase != "suspended" || !radioAbsenceReceiverValid(c.Identity) || c.Identity.Process != k.Hold.Output.Process || c.Identity.DeviceID != k.Hold.Output.DeviceID || c.Identity.Incarnation != k.Hold.Output.Incarnation || c.Digest != k.Hold.Digest || c.Handoff != k.Hold.HandoffID || c.Generation != k.Hold.Generation || c.Serial != k.Evolution.Serial || c.Effect != k.Evolution.Effect || e != nil || e2 != nil || at.After(now) || !until.After(now) || !until.After(at) || until.Sub(at) > 2*time.Second {
+			return ErrBadRequest
+		}
+	}
+	*out = k
+	return nil
+}
+func decodeRadioAbsenceState(raw []byte, out *radioAbsenceStateUnion) error {
+	var discriminator struct {
+		Schema string `json:"schema"`
+	}
+	if json.Unmarshal(raw, &discriminator) != nil {
+		return ErrBadRequest
+	}
+	if discriminator.Schema == "podconnect.output_radio_absence_custody.v1" {
+		var k radioAbsenceCustody
+		if err := decodeRadioAbsenceCustody(raw, &k); err != nil {
+			return err
+		}
+		*out = radioAbsenceStateUnion{Custody: &k}
+		return nil
+	}
+	if discriminator.Schema != "podconnect.output_radio_absence.v1" {
+		return ErrBadRequest
+	}
+	var original radioAbsenceCReply
+	if err := strictVolumeJSON(raw, &original); err != nil {
+		return err
+	}
+	*out = radioAbsenceStateUnion{Original: &original}
+	return nil
+}
+func radioEvolutionCompletionMatches(p *contentCReceipt, e radioAbsenceEvolution) bool {
+	f := e.Future
+	return p != nil && p.Schema == "podconnect.output_start_complete.v1" && p.OK && p.Phase == "completed" && !p.Physical && p.Token == e.Token && p.OfferID == f.OfferID && p.BindingID == f.BindingID && p.ContentDigest == f.Digest && p.Incarnation == f.Incarnation && p.Revision == f.Revision && p.ReservationID == e.Reservation && p.Intended == f.Intended && p.Actual != nil && *p.Actual == f.Intended && p.Route != nil && p.Route.valid() && p.Route.Process == e.Process && p.Route.DeviceID == f.Intended.HomePodID &&
+		p.Target.Process == e.Process && p.Target.DeviceID == f.Intended.HomePodID && p.Target.Incarnation == p.Route.DeviceIncarnation && volumeCounter(p.Target.Incarnation) && p.Target.Incarnation != "0" &&
+		p.Route.InputPathDigest == f.PathDigest && volumeCounter(p.InputEpoch) && p.InputEpoch != "0" && volumeCounter(p.WriterEpoch) && p.WriterEpoch != "0" && p.Possible && !p.GateClosed && p.Pipe != nil && p.Pipe.Type == "fifo" && p.InputDigest == f.PathDigest && p.Policy == start35Policy && p.Percent == 35 && p.Drained
+}
+func (app *App) radioAbsenceState(ctx context.Context, h *radioHold) (radioAbsenceStateUnion, error) {
+	var out radioAbsenceStateUnion
+	actual, valid := nativeContentProcess()
+	if !valid || h == nil || h.Absence == nil || h.Absence.Binding.Source.Process != actual || h.Request.ProcessID != radioProcessID(actual) {
+		return out, ErrAliasConflict
+	}
+	endpoint := strings.TrimSuffix(app.cfg.RoomTransportOwnToneURL, "/") + "/api/outputs/" + h.Absence.Binding.Output.DeviceID + "/radio-absence/state"
+	if err := radioControlHTTP(ctx, "POST", endpoint, app.cfg.RadioHandoffControlToken, h.Absence.Binding, &out); err != nil {
+		return out, err
+	}
+	if out.Custody != nil {
+		k := out.Custody
+		// A restored historical batch cannot self-attest the primary process that
+		// currently serves HTTP. Metadata corroborates process/key scope only; it is
+		// never used as availability or a source/effect grant.
+		var current radioAvailabilityCapability
+		capabilityURL := strings.TrimSuffix(app.cfg.RoomTransportOwnToneURL, "/") + "/api/outputs/" + h.Absence.Binding.Output.DeviceID + "/radio-handoff/capabilities"
+		if err := radioControlHTTP(ctx, "GET", capabilityURL, app.cfg.RadioHandoffControlToken, nil, &current); err != nil || current.Schema != "podconnect.output_radio_capability.v1" || current.Purpose != "radio_handoff_v1" || current.Physical || current.Process != k.Evolution.Process || current.DeviceID != h.Absence.Binding.Output.DeviceID || current.Incarnation != h.Absence.Binding.Output.Incarnation || current.Digest == nil || *current.Digest != h.Absence.Binding.Digest {
+			return out, ErrAliasConflict
+		}
+		if contentDigest(k.Hold) != contentDigest(h.Absence.Binding) || k.Evolution.Process != h.Absence.Binding.Output.Process || h.Absence.Signature != "" && (k.Signature == nil || *k.Signature != h.Absence.Signature) {
+			return out, ErrAliasConflict
+		}
+	} else if out.Original == nil || !out.Original.OK || out.Original.Purpose != "radio_absence_v1" || out.Original.Physical || contentDigest(out.Original.radioAbsenceBinding) != contentDigest(h.Absence.Binding) || out.Original.Phase != "prepared" && out.Original.Phase != "suspended" && out.Original.Phase != "unknown" || out.Original.Phase == "suspended" && !volumeHex64.MatchString(out.Original.Signature) {
+		return out, ErrAliasConflict
+	}
+	return out, nil
+}
+func radioCustodyWire(h *radioHold, r radioRequest) (any, error) {
+	k := h.Absence.Custody
+	if k == nil || r.Token == "" || r.Token != h.Absence.Binding.Token {
+		return nil, ErrAliasConflict
+	}
+	return struct {
+		Schema           string               `json:"schema"`
+		ProcessID        string               `json:"process_id"`
+		TargetID         string               `json:"target_id"`
+		HandoffID        string               `json:"handoff_id"`
+		Generation       string               `json:"generation"`
+		ActionID         string               `json:"action_id"`
+		Peer             radioPeer            `json:"sender_peer"`
+		Token            string               `json:"token"`
+		ExpectedRevision string               `json:"expected_native_revision"`
+		Phase            string               `json:"phase"`
+		Terminal         bool                 `json:"terminal"`
+		CustodyOnly      bool                 `json:"custody_only"`
+		Source           radioAbsenceBinding  `json:"source_proof"`
+		Signature        *string              `json:"original_suspended_signature"`
+		Custody          *radioAbsenceCustody `json:"custody_proof"`
+	}{"podconnect.native_radio_handoff_custody.v1", r.ProcessID, r.TargetID, r.HandoffID, r.Generation, r.ActionID, r.Peer, r.Token, r.ExpectedRevision, k.Phase, false, true, h.Absence.Binding, k.Signature, k}, nil
+}
+func radioAbsenceEvolved(h *radioHold) bool {
+	return h != nil && h.Absence != nil && h.evolutionActive && h.Absence.Custody != nil && h.Absence.Custody.Phase == "source_evolved" && h.Absence.Custody.OriginalPhase == "suspended" && h.Absence.Custody.Signature != nil && *h.Absence.Custody.Signature == h.Absence.Signature && volumeHex64.MatchString(h.Absence.Signature)
+}
+func (app *App) installAbsenceCustodyLocked(h *radioHold, k *radioAbsenceCustody) error {
+	if app.radio.failed || h.Absence == nil || k == nil || contentDigest(k.Hold) != contentDigest(h.Absence.Binding) {
+		return ErrAliasConflict
+	}
+	if prior := h.Absence.Custody; prior != nil && (prior.Evolution.Serial != k.Evolution.Serial || contentDigest(prior.Evolution.Future) != contentDigest(k.Evolution.Future) || prior.Evolution.Token != k.Evolution.Token || prior.Phase == "source_evolved" && k.Phase != "source_evolved") {
+		return ErrAliasConflict
+	}
+	copy := *k
+	h.Absence.Custody = &copy
+	if h.Absence.CurrentStart == nil {
+		h.Phase = k.Phase
+	}
+	// Only a fresh same-process authenticated C receipt activates metadata.
+	h.evolutionActive = true
+	if err := app.persistRadioLocked(); err != nil {
+		return err
+	}
+	app.refreshAbsenceEvolutionFenceLocked()
+	return nil
+}
+func (app *App) refreshAbsenceEvolutionFenceLocked() {
+	blocked := app.radio.failed
+	for _, h := range app.radio.Holds {
+		if h.Absence != nil && h.Absence.Binding.Source.Kind == "global" && !radioAbsenceEvolved(h) {
+			blocked = true
+		}
+	}
+	app.radioAbsenceFence.Store(blocked)
+}
+func (app *App) checkAbsenceEvolutionB(op *contentOperation) error {
+	if op.Radio != nil {
+		return nil
+	}
+	app.radio.mu.Lock()
+	defer app.radio.mu.Unlock()
+	if app.radio.failed {
+		return ErrAliasConflict
+	}
+	for _, h := range app.radio.Holds {
+		if radioAbsenceEvolved(h) || !radioGlobalCustodyRequired(h) {
+			continue
+		}
+		// The only provisional exception is a known previously suspended global
+		// absence that this exact new destination will evolve. Unknown sourceful,
+		// restored, pending and failed custody must reject before C PREPARE.
+		if h.Absence == nil || h.Absence.Binding.Source.Kind != "global" || h.Absence.Binding.Output.DeviceID == op.Capture.Scope.HomePodID || h.Phase != "suspended" || !volumeHex64.MatchString(h.Absence.Signature) || h.Absence.Custody != nil {
+			return ErrAliasConflict
+		}
+	}
+	return nil
+}
+func radioContentFuture(op *contentOperation) radioAbsenceFuture {
+	return radioAbsenceFuture{op.Capture.Process, op.Offer.OfferID, op.Offer.BindingID, op.ContentDigest, op.Capture.Incarnation, op.Revision, op.Capture.OldOwner, op.Intended, op.Capture.Pipe, op.Capture.PipeDigest, start35Policy, 35}
+}
+func (app *App) captureAbsenceEvolutionPermit(ctx context.Context, op *contentOperation, completed bool) error {
+	if op.Radio != nil {
+		return nil
+	}
+	app.radio.mu.Lock()
+	var holds []*radioHold
+	snapshots := map[*radioHold]*radioHold{}
+	devices, digests := map[string]bool{}, map[string]bool{}
+	invalid := false
+	for _, h := range app.radio.Holds {
+		if h.Absence != nil && h.Absence.Binding.Source.Kind == "global" && h.Absence.Binding.Output.DeviceID != op.Capture.Scope.HomePodID && !radioAbsenceEvolved(h) {
+			holds = append(holds, h)
+			copy := *h
+			absence := *h.Absence
+			copy.Absence = &absence
+			snapshots[h] = &copy
+			id, key := h.Absence.Binding.Output.DeviceID, h.Absence.Binding.Digest
+			if devices[id] || digests[key] {
+				invalid = true
+			}
+			devices[id], digests[key] = true, true
+		}
+	}
+	app.radio.mu.Unlock()
+	if invalid || len(holds) > 16 {
+		return ErrAliasConflict
+	}
+	if len(holds) == 0 {
+		return nil
+	}
+	sort.Slice(holds, func(i, j int) bool { return holds[i].Request.TargetID < holds[j].Request.TargetID })
+	var permits []radioEvolutionPermit
+	serial, digest := "", ""
+	op.mu.Lock()
+	receipt := op.CReceipt
+	future := radioContentFuture(op)
+	reservation := op.ReservationID
+	token := ""
+	if receipt != nil {
+		token = receipt.Token
+	}
+	op.mu.Unlock()
+	if receipt == nil || receipt.Phase != "gate_closed_reader_ready" && !completed || receipt.Phase != "completed" && completed {
+		return ErrAliasConflict
+	}
+	for _, h := range holds {
+		state, err := app.radioAbsenceState(ctx, snapshots[h])
+		if err != nil || state.Custody == nil {
+			return ErrAliasConflict
+		}
+		k := state.Custody
+		phase := "evolution_pending"
+		if completed {
+			phase = "source_evolved"
+		}
+		if k.Phase != phase || k.OriginalPhase != "suspended" || k.Signature == nil || *k.Signature != snapshots[h].Absence.Signature || contentDigest(k.Evolution.Future) != contentDigest(future) || k.Evolution.Token != token || k.Evolution.Reservation != reservation || serial != "" && serial != k.Evolution.Serial || digest != "" && digest != k.Evolution.MembersDigest {
+			return ErrAliasConflict
+		}
+		serial, digest = k.Evolution.Serial, k.Evolution.MembersDigest
+		permits = append(permits, radioEvolutionPermit{h, *k})
+	}
+	app.radio.mu.Lock()
+	defer app.radio.mu.Unlock()
+	for _, permit := range permits {
+		if app.radio.Holds[permit.hold.Request.TargetID] != permit.hold || contentDigest(permit.hold.Absence.Binding) != contentDigest(permit.proof.Hold) || permit.hold.Absence.Signature != *permit.proof.Signature {
+			return ErrAliasConflict
+		}
+	}
+	for _, h := range app.radio.Holds {
+		if h.Absence != nil && h.Absence.Binding.Source.Kind == "global" && h.Absence.Binding.Output.DeviceID != op.Capture.Scope.HomePodID && !radioAbsenceEvolved(h) && snapshots[h] == nil {
+			return ErrAliasConflict
+		}
+	}
+	// Publish all Native members with one journal replacement, after all real C
+	// members have been checked. A failed save keeps the transition fenced.
+	for _, permit := range permits {
+		h := permit.hold
+		k := permit.proof
+		if prior := h.Absence.Custody; prior != nil && (prior.Evolution.Serial != k.Evolution.Serial || contentDigest(prior.Evolution.Future) != contentDigest(k.Evolution.Future) || prior.Evolution.Token != k.Evolution.Token) {
+			return ErrAliasConflict
+		}
+	}
+	for _, permit := range permits {
+		h := permit.hold
+		k := permit.proof
+		h.Absence.Custody = &k
+		h.Phase = k.Phase
+		h.evolutionActive = true
+	}
+	if err := app.persistRadioLocked(); err != nil {
+		return err
+	}
+	app.refreshAbsenceEvolutionFenceLocked()
+	if !completed {
+		// This is the same worker-owned operation. Do not invert op.mu -> radio.mu.
+		app.radio.mu.Unlock()
+		op.mu.Lock()
+		op.AbsenceEvolutionPermit = permits
+		op.mu.Unlock()
+		app.radio.mu.Lock()
+	}
+	return nil
+}
+
+// Called under the content operation mutex, before the actual worker mutation.
+// The audit alone is insufficient: canonical own token/reader receipt and the
+// still-live operation guard remain mandatory at the caller.
+func (app *App) absenceEvolutionPermitCurrentLocked(op *contentOperation) bool {
+	if op.Radio != nil {
+		return true
+	}
+	app.radio.mu.Lock()
+	defer app.radio.mu.Unlock()
+	if app.radio.failed {
+		// Only final verification of a previously admitted, actually completed B may
+		// survive a subsequent independent audit-save fault. This cannot authorize
+		// quiesce/new output (which requires READER_READY), or any later command.
+		if !op.AbsenceEvolutionCompletionPending || op.CReceipt == nil || op.CReceipt.Phase != "completed" || len(op.AbsenceEvolutionPermit) == 0 {
+			return false
+		}
+		for _, permit := range op.AbsenceEvolutionPermit {
+			if app.radio.Holds[permit.hold.Request.TargetID] != permit.hold || permit.hold.Absence == nil || contentDigest(permit.hold.Absence.Binding) != contentDigest(permit.proof.Hold) || contentDigest(permit.proof.Evolution.Future) != contentDigest(radioContentFuture(op)) || op.CReceipt.Token != permit.proof.Evolution.Token || op.ReservationID != permit.proof.Evolution.Reservation {
+				return false
+			}
+		}
+		return true
+	}
+	for _, h := range app.radio.Holds {
+		if h.Absence == nil || h.Absence.Binding.Source.Kind != "global" || h.Absence.Binding.Output.DeviceID == op.Capture.Scope.HomePodID || radioAbsenceEvolved(h) {
+			continue
+		}
+		found := false
+		for _, permit := range op.AbsenceEvolutionPermit {
+			k := h.Absence.Custody
+			if permit.hold == h && h.evolutionActive && k != nil && k.Phase == "evolution_pending" && k.Evolution.Serial == permit.proof.Evolution.Serial && k.Evolution.MembersDigest == permit.proof.Evolution.MembersDigest && contentDigest(k.Hold) == contentDigest(permit.proof.Hold) && contentDigest(k.Evolution.Future) == contentDigest(radioContentFuture(op)) && op.CReceipt != nil && k.Evolution.Token == op.CReceipt.Token && k.Evolution.Reservation == op.ReservationID {
+				found = true
+				break
+			}
+		}
+		if !found {
+			return false
+		}
+	}
+	return true
+}
