+	connectpb "github.com/devgianlu/go-librespot/proto/spotify/connectstate"
+	"github.com/devgianlu/go-librespot/tracks"
+)
+
+func radioWireLoopbackURL(raw string) bool {
+	parsed, err := url.Parse(raw)
+	return err == nil && parsed.Scheme == "http" && parsed.Hostname() == "127.0.0.1" && parsed.Port() != "" && parsed.User == nil && parsed.RawQuery == "" && parsed.Fragment == "" && (parsed.Path == "" || parsed.Path == "/")
+}
+func radioWireTmpPath(t *testing.T, name string) string {
+	t.Helper()
+	path := os.Getenv(name)
+	if !filepath.IsAbs(path) || !strings.HasPrefix(filepath.Clean(path), "/tmp/") {
+		t.Fatalf("%s must name an explicit inert namespace /tmp file", name)
+	}
+	if _, err := os.Lstat(path); !os.IsNotExist(err) {
+		t.Fatalf("%s already exists or cannot be checked", name)
+	}
+	return path
+}
+
+// Observe the real response without changing its data, error, dispatch context,
+// or reply timing. Only finite diagnostic labels and error types enter logs.
+func radioWireObserveRequest(t *testing.T, req ApiRequest, lane string) (ApiRequest, <-chan struct{}) {
+	original := req
+	req.resp = make(chan apiResponse, 1)
+	done := make(chan struct{})
+	go func() {
+		defer close(done)
+		response := <-req.resp
+		if response.err != nil {
+			code := "other"
+			switch {
+			case errors.Is(response.err, context.Canceled):
+				code = "context_canceled"
+			case errors.Is(response.err, context.DeadlineExceeded):
+				code = "context_deadline"
+			case errors.Is(response.err, ErrAliasConflict):
+				code = "alias_conflict"
+			case errors.Is(response.err, ErrBadRequest):
+				code = "bad_request"
+			case errors.Is(response.err, ErrNoSession):
+				code = "no_session"
+			default:
+				message := response.err.Error()
+				if strings.HasPrefix(message, "json: unknown field ") {
+					if field, parseErr := strconv.Unquote(strings.TrimPrefix(message, "json: unknown field ")); parseErr == nil && len(field) > 0 && len(field) <= 64 {
+						safe := true
+						for _, char := range field {
+							if char != '_' && (char < 'a' || char > 'z') {
+								safe = false
+								break
+							}
+						}
+						if safe {
+							code = "json_unknown_field:" + field
+						}
+					}
+				}
+				switch message {
+				case "queue writer is moving, fenced, or changed pause state":
+					code = "writer_moving_fenced_or_pause_changed"
+				case "move final source, writer, or paused state changed":
+					code = "final_source_writer_or_pause_changed"
+				case "native primary source changed":
+					code = "primary_source_changed"
+				case "no existing pipe output":
+					code = "pipe_output_missing"
+				case "actual output writer descriptor unavailable":
+					code = "writer_descriptor_missing"
+				}
+			}
+			t.Logf("actual Native wire response lane=%s type=%s error_type=%T code=%s", lane, original.Type, response.err, code)
+		}
+		original.Reply(response.data, response.err)
+	}()
+	return req, done
+}
+
+// This explicit-env seam serves the actual production Native HTTP router and
+// current AppPlayer. Its source and AP edge are the existing finite-source test
+// fixture; C/sourcehold/sender DTOs are never fabricated here. It proves neither
+// a production radio-owner/cgroup factory nor physical receiver acceptance.
+func testServeActualRadioHTTP(t *testing.T, p *AppPlayer, worker *player.Player, stream *player.Stream) {
+	t.Helper()
+	if os.Getenv("PC_NATIVE_START_MODE") != "actual-c-radio-http" {
+		t.Fatal("wire seam requires its explicit mode")
+	}
+	token, ownerURL := os.Getenv("PC_NATIVE_RADIO_CONTROL_TOKEN"), os.Getenv("PC_NATIVE_RADIO_OWNER_URL")
+	if !(volumeHex32.MatchString(token) || volumeHex64.MatchString(token)) || !radioWireLoopbackURL(ownerURL) || !radioWireLoopbackURL(p.app.cfg.RoomTransportOwnToneURL) {
+		t.Fatal("wire seam requires matching private token and real isolated loopback endpoints")
+	}
+	readyFile, releaseFile := radioWireTmpPath(t, "PC_NATIVE_RADIO_HTTP_READY"), radioWireTmpPath(t, "PC_NATIVE_RADIO_HTTP_RELEASE")
+	if readyFile == releaseFile {
+		t.Fatal("ready and release files must differ")
+	}
+	port := 0
+	if raw := os.Getenv("PC_NATIVE_RADIO_HTTP_PORT"); raw != "" {
+		var err error
+		port, err = strconv.Atoi(raw)
+		if err != nil || port < 0 || port > 65535 {
+			t.Fatal("invalid wire fixture port")
+		}
+	}
+	seconds := 60
+	if raw := os.Getenv("PC_NATIVE_RADIO_HTTP_TIMEOUT_SECONDS"); raw != "" {
+		var err error
+		seconds, err = strconv.Atoi(raw)
+		if err != nil || seconds < 10 || seconds > 120 {
+			t.Fatal("invalid bounded wire deadline")
+		}
+	}
+	bootEmpty := os.Getenv("PC_NATIVE_RADIO_HTTP_BOOT_EMPTY") == "1"
+	expectReturn := os.Getenv("PC_NATIVE_RADIO_HTTP_EXPECT_RETURN")
+	if expectReturn != "" && expectReturn != "1" && expectReturn != "selected" && expectReturn != "unchanged" {
+		t.Fatal("invalid explicit wire return expectation")
+	}
+	if expectReturn == "unchanged" && bootEmpty {
+		t.Fatal("unchanged wire expectation requires an original live source")
+	}
+	// The existing content fixture does not run newAppPlayer. Initialize its
+	// ordinary stopped prefetch timer before exercising the real Resume caller.
+	p.prefetchTimer = time.NewTimer(time.Hour)
+	p.prefetchTimer.Stop()
+	defer p.prefetchTimer.Stop()
+	app := p.app
+	app.cfg.RadioHandoffControlToken = token
+	app.cfg.RadioHandoffOwnerURL = ownerURL
+	app.cfg.RadioHandoffStatePath = filepath.Join(t.TempDir(), "wire-radio.json")
+	if err := app.initRadio(); err != nil {
