+package daemon
+
+import (
+	"context"
+	"strconv"
+	"strings"
+
+	librespot "github.com/devgianlu/go-librespot"
+	"github.com/devgianlu/go-librespot/output"
+	"github.com/devgianlu/go-librespot/player"
+	"github.com/devgianlu/go-librespot/session"
+)
+
+type radioReacquiredSource struct {
+	Schema        string                `json:"schema"`
+	OK            bool                  `json:"ok"`
+	Owner         roomTransportIdentity `json:"native_owner"`
+	Writer        queueWriterWire       `json:"writer_proof"`
+	Output        roomVolumeRoute       `json:"output_identity"`
+	Digest        string                `json:"receiver_key_digest"`
+	InitialVolume int                   `json:"initial_volume_percent"`
+	Purpose       string                `json:"purpose"`
+	Physical      bool                  `json:"physical_result_verified"`
+}
+
+// This authority comes from the actual sourceful OPENED acknowledgement and a
+// subsequent authenticated source-state observation, never from an old START
+// or an invented OTHER grant. The immutable hold remains in terminal history.
+type radioReacquiredWriter struct {
+	Intent       uint64
+	GlobalIntent uint64
+	Owner        *AppPlayer
+	Player       *player.Player
+	Session      *session.Session
+	Primary      *player.Stream
+	Source       librespot.AudioSource
+	Identity     roomTransportIdentity
+	Wire         queueWriterWire
+	Writer       output.MovePipeIdentity
+	Process      contentProcess
+	Generation   uint64
+	Hold         radioCBinding
+	Receipt      radioReacquireReply
+	Observed     radioReacquiredSource
+	StartAt      *contentOperation
+	MoveAt       *moveOperation
+}
+
+func (p *AppPlayer) captureRadioReacquiredWriter(ctx context.Context, h *radioHold, r radioReacquire, ack *radioReacquireReply, writer queueWriterWire, intended roomTransportIdentity, globalIntent uint64) (*radioReacquiredWriter, error) {
+	if p == nil || p.app == nil || h == nil || ack == nil || p.primaryStream == nil || p.primaryStream.Source == nil || p.sess == nil || p.player == nil || p.state == nil || p.state.player == nil {
+		return nil, ErrAliasConflict
+	}
+	app := p.app
+	app.radio.mu.Lock()
+	verified := !app.radio.failed && app.radio.Intent == globalIntent && app.radio.Holds[h.Request.TargetID] == h && h.Reacquire != nil && h.ReacquireLatest != nil && h.ReacquirePhase == "opened" && contentDigest(*h.Reacquire) == contentDigest(r) && contentDigest(*h.ReacquireLatest) == contentDigest(*ack)
+	app.radio.mu.Unlock()
+	if !verified || r.Phase != "open" || r.Hold != h.Proof || r.Intended != intended || ack.Intended != intended || ack.Owner != r.Owner || ack.IntentID != r.IntentID || ack.Revision != r.Revision || ack.Challenge != r.Challenge || ack.Phase != "opened" || !ack.Barrier || ack.Physical || ack.Writer == nil || *ack.Writer != writer || ack.Source == nil || ack.Source.InputPathDigest != writer.InputDigest || ack.Route == nil || !ack.Route.valid() || ack.Route.Process != h.Proof.Output.Process || ack.Route.DeviceID != intended.HomePodID || ack.CurrentVolume == nil || !volumeCounter(ack.CurrentBase) || ack.CurrentBase == "0" {
+		return nil, ErrAliasConflict
+	}
+	var observed radioReacquiredSource
+	request := struct {
+		Owner  roomTransportIdentity `json:"native_owner"`
+		Writer queueWriterWire       `json:"writer_proof"`
+		Schema string                `json:"schema"`
+	}{intended, writer, "podconnect.output_radio_source_state.v1"}
+	endpoint := strings.TrimSuffix(app.cfg.RoomTransportOwnToneURL, "/") + "/api/outputs/" + intended.HomePodID + "/radio-handoff/source-state"
+	if err := radioControlHTTP(ctx, "POST", endpoint, app.cfg.RadioHandoffControlToken, request, &observed); err != nil {
+		return nil, err
+	}
+	if observed.Schema != request.Schema || !observed.OK || observed.Purpose != "radio_handoff_v1" || observed.Physical || observed.Owner != intended || observed.Writer != writer || observed.Output != *ack.Route || observed.Digest != h.Proof.Digest || observed.InitialVolume != *ack.CurrentVolume {
+		return nil, ErrAliasConflict
+	}
+	intent, intentErr := strconv.ParseUint(r.Revision, 10, 64)
+	if intentErr != nil || p.roomNativeIntent != intent {
+		return nil, ErrAliasConflict
+	}
+	generation, err := strconv.ParseUint(writer.Generation, 10, 64)
+	if err != nil || generation == 0 || !volumeCounter(writer.Epoch) || writer.Epoch == "0" {
+		return nil, ErrAliasConflict
+	}
+	primary, source, paused := p.primaryStream, p.primaryStream.Source, p.state.player.IsPaused
+	actual := output.MovePipeIdentity{PipeIdentity: writer.Pipe, FD: writer.FD}
+	_, _, err = p.player.RoomMove(ctx, "verify", source, actual, writer.Epoch, !paused, func(mutate func()) error {
+		p.aliasMu.Lock()
+		defer p.aliasMu.Unlock()
+		account, bound := p.sess.BoundUsername()
+		binding := p.aliasBindingLocked()
+		if ctx.Err() != nil || !bound || account != intended.AccountUserID || p.primaryStream != primary || p.primaryStream.Source != source || p.state.player.IsPaused != paused || p.state.player.SessionId != intended.SessionID || p.spotConnId != intended.ConnectionID || p.aliasIncarnation != intended.AliasIncarnation || p.aliasFingerprint != intended.AliasRegistry || p.aliasRevision != intended.AliasRevision || binding == nil || !binding.Ready || binding.RoomID != intended.RoomID || !p.radioReacquiredAliasCurrentLocked(intended) {
+			return ErrAliasConflict
+		}
+		app.moveCustodyMu.Lock()
+		defer app.moveCustodyMu.Unlock()
+		if app.openedWriterOwner != p || app.openedWriter != actual || app.openedWriterGeneration != generation {
+			return ErrAliasConflict
+		}
+		mutate()
+		return nil
+	})
+	if err != nil {
+		return nil, err
+	}
+	app.moveCustodyMu.Lock()
+	defer app.moveCustodyMu.Unlock()
+	process, valid := nativeContentProcess()
+	if !valid || process != writer.Process || app.openedWriterOwner != p || app.openedWriter != actual || app.openedWriterGeneration != generation {
+		return nil, ErrAliasConflict
+	}
+	return &radioReacquiredWriter{intent, globalIntent, p, p.player, p.sess, primary, source, intended, writer, actual, process, generation, h.Proof, *ack, observed, app.startCustody, app.moveCustody}, nil
+}
+
+func (app *App) completedRadioReacquiredWriterCurrentLocked(owner *AppPlayer, identity roomTransportIdentity) (*completedWriter, bool, error) {
+	proof := app.radioReacquiredWriter
+	if proof == nil {
+		return nil, false, nil
+	}
+	if op := app.startCustody; op != nil && op != proof.StartAt {
+		op.mu.Lock()
+		newer := op.Owner == owner && op.Terminal && op.State == "complete" && op.Actual != nil && sameCompletedRoom(*op.Actual, identity) && op.CReceipt != nil && op.CReceipt.Phase == "completed"
+		op.mu.Unlock()
+		if newer {
+			return nil, false, nil
+		}
+	}
+	if op := app.moveCustody; op != nil && op != proof.MoveAt {
+		op.mu.Lock()
+		newer := op.Owner == owner && op.Terminal && op.State == "complete" && op.Actual != nil && sameCompletedRoom(*op.Actual, identity) && op.CReceipt != nil && op.CReceipt.Phase == "completed"
+		op.mu.Unlock()
+		if newer {
+			return nil, false, nil
+		}
+	}
+	if app.startCustody != proof.StartAt || app.moveCustody != proof.MoveAt {
+		return nil, true, ErrAliasConflict
+	}
+	process, valid := nativeContentProcess()
+	if !valid || process != proof.Process || owner == nil || owner.player == nil || owner.sess == nil || owner.state == nil || owner.state.player == nil || proof.Owner != owner || proof.Player != owner.player || proof.Session != owner.sess || proof.Primary != owner.primaryStream || owner.primaryStream == nil || proof.Source != owner.primaryStream.Source || proof.Identity != identity || owner.state.player.SessionId != identity.SessionID || owner.spotConnId != identity.ConnectionID || app.openedWriterOwner != owner || app.openedWriter != proof.Writer || app.openedWriterGeneration != proof.Generation || proof.Receipt.Phase != "opened" || !proof.Receipt.Barrier || proof.Receipt.Writer == nil || *proof.Receipt.Writer != proof.Wire || proof.Observed.Writer != proof.Wire || proof.Observed.Owner != identity {
+		return nil, true, ErrAliasConflict
+	}
+	return &completedWriter{reacquired: proof, custodyStart: proof.StartAt, custodyMove: proof.MoveAt, writer: proof.Writer, epoch: proof.Wire.Epoch}, true, nil
+}
+
+// Credit completion inside the actual source/output verification boundary.
+// A late EOF, reused FD with a new epoch, or a replacement owner cannot publish
+// authority between the C observation and durable Native terminal receipt.
+func (p *AppPlayer) commitRadioReacquiredWriter(ctx context.Context, h *radioHold, proof *radioReacquiredWriter, cause string) error {
+	if p == nil || p.player == nil || proof == nil || p.state == nil || p.state.player == nil || proof.Owner != p {
+		return ErrAliasConflict
+	}
+	paused := p.state.player.IsPaused
+	_, _, err := p.player.RoomMove(ctx, "verify", proof.Source, proof.Writer, proof.Wire.Epoch, !paused, func(mutate func()) error {
+		p.aliasMu.Lock()
+		defer p.aliasMu.Unlock()
+		binding := p.aliasBindingLocked()
+		if binding == nil || !binding.Ready || binding.RoomID != proof.Identity.RoomID || !p.radioReacquiredAliasCurrentLocked(proof.Identity) {
+			return ErrAliasConflict
+		}
+		if ctx.Err() != nil || p.player != proof.Player || p.sess != proof.Session || p.primaryStream != proof.Primary || p.primaryStream == nil || p.primaryStream.Source != proof.Source || p.state.player.IsPaused != paused || p.state.player.SessionId != proof.Identity.SessionID || p.spotConnId != proof.Identity.ConnectionID || p.roomNativeIntent != proof.Intent || p.aliasRevision != proof.Identity.AliasRevision || p.aliasIncarnation != proof.Identity.AliasIncarnation || p.aliasFingerprint != proof.Identity.AliasRegistry {
+			return ErrAliasConflict
+		}
+		app := p.app
+		app.radio.mu.Lock()
+		defer app.radio.mu.Unlock()
+		if app.radio.failed || app.radio.Intent != proof.GlobalIntent || app.radio.Holds[h.Request.TargetID] != h || h.ReacquireLatest == nil || contentDigest(*h.ReacquireLatest) != contentDigest(proof.Receipt) || h.ReacquirePhase != "opened" {
+			return ErrAliasConflict
+		}
+		app.moveCustodyMu.Lock()
+		current := app.openedWriterOwner == p && app.openedWriter == proof.Writer && app.openedWriterGeneration == proof.Generation
+		app.moveCustodyMu.Unlock()
+		if !current {
+			return ErrAliasConflict
+		}
+		mutate()
+		if err := app.retireRadioLocked(h, &proof.Receipt); err != nil {
+			return err
+		}
+		app.moveCustodyMu.Lock()
+		app.radioReacquiredWriter = proof
+		app.radioParkedWriter, app.radioOtherWriter = nil, nil
+		app.moveCustodyMu.Unlock()
+		if cause == "resume" {
+			p.radioResume = &radioResumeMarker{Live: !paused, Primary: proof.Primary, Source: proof.Source, Player: proof.Player, Session: proof.Session, Owner: proof.Identity, Writer: proof.Wire}
+		}
+		app.refreshRadioOutputFenceLocked()
+		return nil
+	})
+	return err
+}
+
+func (p *AppPlayer) radioReacquiredAliasCurrentLocked(identity roomTransportIdentity) bool {
+	if p.state == nil || p.state.device == nil || p.app == nil || p.app.deviceId != identity.TargetID {
+		return false
+	}
+	for _, alias := range p.aliasRegistry {
+		if alias.ID == p.state.device.SelectedAliasId {
+			return alias.RoomID == identity.RoomID && alias.HomePodID == identity.HomePodID
+		}
+	}
+	return false
+}
