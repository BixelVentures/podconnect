+
+	"github.com/devgianlu/go-librespot/output"
+	"github.com/devgianlu/go-librespot/player"
+)
+
+// Local owner fixtures verify staging effects, not provider or receiver proof.
+func TestRadioMoveStagesOriginalOfferWithoutReceiverReservation(t *testing.T) {
+	for _, parked := range []bool{false, true} {
+		t.Run(map[bool]string{false: "sourceful", true: "parked_child"}[parked], func(t *testing.T) {
+			p, seed := contentFixture(t)
+			var calls atomic.Int32
+			server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) { calls.Add(1); w.WriteHeader(500) }))
+			defer server.Close()
+			p.app.cfg.RadioHandoffControlToken = strings.Repeat("f", 32)
+			p.app.cfg.RadioHandoffOwnerURL = server.URL
+			p.app.cfg.RadioHandoffStatePath = filepath.Join(t.TempDir(), "radio.json")
+			p.app.cfg.RoomTransportOwnToneURL = server.URL
+			seed.Capture.OwnTone = server.URL
+			p.state.active = true
+			p.state.player.IsPlaying = true
+			p.primaryStream = &player.Stream{Source: &contentInertSource{}}
+			seed.Capture.Primary, seed.Capture.Source = p.primaryStream, p.primaryStream.Source
+			h := &radioHold{owner: p, Request: radioRequest{TargetID: "r1", HandoffID: "00000000-0000-0000-0000-000000000001", Generation: "1"}, Proof: radioCBinding{Token: strings.Repeat("e", 32)}, Phase: "suspended", Latest: &radioCReply{Phase: "suspended"}}
+			if parked {
+				h.owner = nil
+				h.Latest = nil
+				h.Proof = radioCBinding{}
+				h.Parked = &radioParkedHold{Binding: radioParkedBinding{Token: strings.Repeat("e", 32)}}
+			}
+			p.app.radio.Holds = map[string]*radioHold{"r1": h}
+			stage, err := p.radioContentSnapshot(seed.Capture.Scope)
+			if err != nil {
+				t.Fatal(err)
+			}
+			seed.Capture.Radio = stage
+			// Explicit inert registered-writer CAS precondition for this staging
+			// unit. This numeric tuple is not an actual FD or runtime permission.
+			writer := output.MovePipeIdentity{PipeIdentity: output.PipeIdentity{Device: "1", Inode: "2", Type: "fifo"}, FD: "7"}
+			p.app.openedWriter, p.app.openedWriterOwner, p.app.openedWriterGeneration = writer, p, 7
+			capture := &moveCapture{contentCapture: seed.Capture, Tracks: p.state.tracks, QueueRevision: p.state.tracks.TransportRevision(), Paused: p.state.player.IsPaused, StateVolume: p.state.device.Volume, WriterPipe: writer, WriterGeneration: 7, WriterEpoch: "1"}
+			process := "11111111-1111-4111-8111-111111111111"
+			state := moveCState{Schema: "podconnect.output_move_state.v1", OK: true, Ready: true, Policy: movePolicy, SessionVolume: 27, OldBaseRevision: "1", TargetBaseRevision: "2", OldRoute: roomVolumeRoute{Process: process, DeviceID: capture.OldOwner.HomePodID, DeviceIncarnation: "1", SessionEpoch: "2", RouteRevision: "3", SelectionRevision: "4", InputGeneration: "5", InputItemID: "6", InputPathDigest: capture.PipeDigest}, Target: contentTarget{Process: process, DeviceID: capture.Scope.HomePodID, Incarnation: "1"}, InputDigest: capture.PipeDigest, Paused: capture.Paused}
+			value, err := p.offerMove(moveOfferActorRequest{Capture: capture, State: state, Context: context.Background()})
+			if err != nil {
+				t.Fatal(err)
+			}
+			op := value.(*moveOperation)
+			originalOffer := op.Offer
+			request := movePrepareRequest{Scope: capture.Scope, Offer: op.Offer, Action: "move_existing_session"}
+			if parked {
+				if err = p.invalidateRadioPreflight(); err != nil {
+					t.Fatal(err)
+				}
+				originalIntent := p.app.radio.Intent
+				if _, err = p.claimMove(moveActorRequest{Operation: op, Request: request, Context: context.Background()}); err != nil {
+					t.Fatal(err)
+				}
+				if p.app.radio.Intent != originalIntent || op.Radio.ClaimIntent != originalIntent {
+					t.Fatal("inline explicit Resume invented a second global intent")
+				}
+				op.inlineActor = true
+			} else if _, err = p.handleApiRequest(context.Background(), ApiRequest{Type: apiMoveClaim, Data: moveActorRequest{Operation: op, Request: request, Context: context.Background()}}); err != nil {
+				t.Fatal(err)
+			}
+			oldPrimary, oldTracks, oldPlayer := p.primaryStream, p.state.tracks, p.state.player
+			op.prepare(context.Background())
+			if calls.Load() != 0 || op.CReceipt != nil || op.State != "staged" || op.Offer != originalOffer || op.Capture != capture || p.primaryStream != oldPrimary || p.state.tracks != oldTracks || p.state.player != oldPlayer || op.Radio.ClaimIntent != p.app.radio.Intent {
+				t.Fatal("MOVE prepare changed receiver/source or lost original offer")
+			}
+			if err = p.invalidateRadioPreflight(); err != nil {
+				t.Fatal(err)
+			}
+			op.CommitClaimed = true
+			op.State = "committing"
+			op.RadioCommitDeadline = time.Now().Add(14 * time.Second)
+			if _, err = op.askMoveActor(context.Background(), nil, apiRadioMoveRefresh); parked && err == nil {
+				t.Fatal("stale inline MOVE commit accepted")
+			}
+			if _, err = p.refreshRadioMove(context.Background(), moveActorRequest{Operation: op, Context: context.Background()}); err == nil {
+				t.Fatal("stale MOVE commit accepted")
+			}
+			if calls.Load() != 0 || op.Possible || op.RadioRefreshConsumed || h.Phase != "suspended" || p.primaryStream != oldPrimary || p.state.tracks != oldTracks {
+				t.Fatal("stale MOVE performed an effect or consumed radio custody")
+			}
+		})
+	}
+}
diff --git a/daemon/radio_nullable_decode.go b/daemon/radio_nullable_decode.go
new file mode 100644
index 0000000..b1fb1fe
--- /dev/null
+++ b/daemon/radio_nullable_decode.go
@@ -0,0 +1,199 @@
+package daemon
+
+import (
+	"bytes"
+	"encoding/json"
+	"reflect"
+	"strings"
+)
+
+// Only the private radio response variants below use this validator. Nullable
+// paths are explicit required keys, never optional command fields or authority.
+// The shared command decoder remains unchanged.
+func decodeRadioNullable(raw []byte, out any, nullable ...string) error {
+	var scanned map[string]json.RawMessage
+	if err := strictVolumeJSON(raw, &scanned); err != nil {
+		return err
+	}
+	paths := make(map[string]bool, len(nullable))
+	for _, path := range nullable {
+		paths[path] = true
+	}
+	var required func(json.RawMessage, reflect.Type, string) bool
+	required = func(value json.RawMessage, typ reflect.Type, path string) bool {
+		if bytes.Equal(bytes.TrimSpace(value), []byte("null")) {
+			return paths[path]
+		}
+		if typ.Kind() == reflect.Pointer {
+			return required(value, typ.Elem(), path)
+		}
+		switch typ.Kind() {
+		case reflect.Struct:
+			var object map[string]json.RawMessage
+			if json.Unmarshal(value, &object) != nil || object == nil {
+				return false
+			}
+			for i := 0; i < typ.NumField(); i++ {
+				field := typ.Field(i)
+				tags := strings.Split(field.Tag.Get("json"), ",")
+				if tags[0] == "" || tags[0] == "-" {
+					continue
+				}
+				child, exists := object[tags[0]]
+				if !exists {
+					if len(tags) > 1 && tags[1] == "omitempty" {
+						continue
+					}
+					return false
+				}
+				next := tags[0]
+				if path != "" {
+					next = path + "." + next
+				}
+				if !required(child, field.Type, next) {
+					return false
+				}
+			}
+		case reflect.Slice:
+			var array []json.RawMessage
+			if json.Unmarshal(value, &array) != nil || array == nil {
+				return false
+			}
+			for _, child := range array {
+				if !required(child, typ.Elem(), path+"[]") {
+					return false
+				}
+			}
+		}
+		return true
+	}
+	if !required(raw, reflect.TypeOf(out).Elem(), "") {
+		return ErrBadRequest
+	}
+	decoder := json.NewDecoder(bytes.NewReader(raw))
+	decoder.DisallowUnknownFields()
+	return decoder.Decode(out)
+}
+
+func radioParkedCurrentObservationValid(current radioParkedCurrentWire, observation radioParkedBridgeObservation) bool {
+	switch current.Kind {
+	case "live":
+		return current.Owner != nil && current.Writer != nil && current.SourceHold == nil && current.Absence == nil && observation.Source != nil && observation.Source.valid() && observation.Absence == nil
+	case "parked":
+		return current.Owner == nil && current.Writer == nil && current.SourceHold != nil && current.Absence == nil && observation.Source != nil && observation.Source.valid() && observation.Absence == nil
+	case "global_absence":
+		return current.Owner == nil && current.Writer == nil && current.SourceHold == nil && current.Absence != nil && current.Absence.Kind == "global" && current.Absence.Live == nil && observation.Source == nil && observation.Absence != nil && observation.Absence.Kind == "global" && observation.Absence.Live == nil && contentDigest(current.Absence) == contentDigest(observation.Absence)
+	}
+	return false
+}
+
+func decodeRadioParkedBridgeState(raw []byte, out *radioParkedBridgeState) error {
+	var candidate radioParkedBridgeState
+	if err := decodeRadioNullable(raw, &candidate, "observation.source_identity", "observation.source_absence"); err != nil {
+		return err
+	}
+	if candidate.Schema != "podconnect.output_radio_parked_bridge_observation.v1" || !candidate.OK || candidate.Purpose != "radio_parked_bridge_v1" || candidate.Physical || !radioParkedCurrentObservationValid(candidate.Current, candidate.Observation) {
+		return ErrBadRequest
+	}
+	*out = candidate
+	return nil
+}
+
+func decodeRadioParkedBridgeReply(raw []byte, out *radioParkedBridgeReply) error {
+	var candidate radioParkedBridgeReply
+	if err := decodeRadioNullable(raw, &candidate, "observation.source_identity", "observation.source_absence", "future_start.old_native_owner", "route_identity", "current_writer_proof", "current_volume_percent", "current_base_revision"); err != nil {
+		return err
+	}
+	if candidate.Schema != "podconnect.output_radio_parked_bridge.v1" || !candidate.OK || candidate.Purpose != "radio_parked_bridge_v1" || candidate.Physical || !radioParkedCurrentObservationValid(candidate.Current, candidate.Observation) || candidate.RequiresPause != (candidate.Current.Kind == "parked") {
+		return ErrBadRequest
+	}
+	branches := 0
+	if candidate.Resume != nil {
+		branches++
+		if candidate.Current.Kind != "parked" {
+			return ErrBadRequest
+		}
+	}
+	if candidate.Start != nil {
+		branches++
+		if (candidate.Start.OldOwner == nil) != (candidate.Current.Kind == "global_absence") {
+			return ErrBadRequest
+		}
+	}
+	if candidate.Move != nil {
+		branches++
+		if candidate.Current.Kind != "live" {
+			return ErrBadRequest
+		}
+	}
+	if branches != 1 || (candidate.CurrentVolume == nil) != (candidate.CurrentBase == nil) {
+		return ErrBadRequest
+	}
+	if candidate.CurrentVolume != nil && (*candidate.CurrentVolume < 0 || *candidate.CurrentVolume > 100 || !volumeCounter(*candidate.CurrentBase) || *candidate.CurrentBase == "0") {
+		return ErrBadRequest
+	}
+	if candidate.ExecutionVolume != nil && (candidate.Move == nil || *candidate.ExecutionVolume < 0 || *candidate.ExecutionVolume > 100 || (candidate.Phase != "bound_move" && candidate.Phase != "delegated" && candidate.Phase != "completed")) {
+		return ErrBadRequest
+	}
+	switch candidate.Phase {
+	case "challenge", "consumed":
+		if candidate.Route != nil || candidate.Writer != nil || candidate.CurrentVolume != nil || candidate.Barrier {
+			return ErrBadRequest
+		}
+	case "connecting":
+		if candidate.Resume == nil || candidate.Writer != nil || candidate.CurrentVolume != nil || candidate.Barrier {
+			return ErrBadRequest
+		}
+	case "route_ready":
+		if candidate.Resume == nil || candidate.Route == nil || !candidate.Route.valid() || candidate.Writer != nil || candidate.CurrentVolume != nil || candidate.Barrier {
+			return ErrBadRequest
+		}
+	case "barrier_ready":
+		if candidate.Resume == nil || candidate.Route == nil || !candidate.Route.valid() || candidate.Writer == nil || !candidate.Barrier || candidate.CurrentVolume != nil {
+			return ErrBadRequest
+		}
+	case "opened":
+		if candidate.Resume == nil || candidate.Route == nil || !candidate.Route.valid() || candidate.Writer == nil || !candidate.Barrier || candidate.CurrentVolume == nil {
+			return ErrBadRequest
+		}
+	case "bound_start":
+		if candidate.Start == nil || candidate.Route != nil || candidate.CurrentVolume != nil || (candidate.Writer != nil) != candidate.RequiresPause || candidate.Barrier != candidate.RequiresPause {
+			return ErrBadRequest
+		}
+	case "bound_move":
+		if candidate.Move == nil || candidate.Route != nil || candidate.Writer != nil || candidate.CurrentVolume != nil || candidate.Barrier || candidate.ExecutionVolume == nil {
+			return ErrBadRequest
+		}
+	case "delegated", "completed":
+		if candidate.Move != nil && candidate.ExecutionVolume == nil {
+			return ErrBadRequest
+		}
+		// These retain the original bridge observation; the canonical operation's
+		// own receipt, rather than these nullable fields, owns successor authority.
+	case "unknown":
+		if candidate.Barrier {
+			return ErrBadRequest
+		}
+	default:
+		return ErrBadRequest
+	}
+	*out = candidate
+	return nil
+}
+
+func decodeRadioAbsenceStartReply(raw []byte, out *radioAbsenceStartReply) error {
+	var candidate radioAbsenceStartReply
+	if err := decodeRadioNullable(raw, &candidate, "future_start.old_native_owner"); err != nil {
+		return err
+	}
+	if candidate.Schema != "podconnect.output_radio_absence_start.v1" || !candidate.OK || candidate.Purpose != "radio_absence_start_v1" || candidate.Physical || (candidate.Hold.Source.Kind != "global" && candidate.Hold.Source.Kind != "target") || (candidate.Future.OldOwner == nil) != (candidate.Hold.Source.Kind == "global") {
+		return ErrBadRequest
+	}
+	switch candidate.Phase {
+	case "challenge", "bound_start", "delegated", "unknown":
+	default:
+		return ErrBadRequest
+	}
+	*out = candidate
+	return nil
+}
diff --git a/daemon/radio_nullable_decode_test.go b/daemon/radio_nullable_decode_test.go
new file mode 100644
index 0000000..0f60327
--- /dev/null
+++ b/daemon/radio_nullable_decode_test.go
@@ -0,0 +1,218 @@
+package daemon
+
+import (
+	"context"
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+)
+
+// These are closed formatter-shaped wire tests, not receiver readiness proof.
+func TestRadioParkedNullableObservationAndPhaseWire(t *testing.T) {
+	route := roomVolumeRoute{"00000000-0000-0000-0000-000000000001", "1", "1", "2", "3", "4", "1", "1", strings.Repeat("a", 64)}
+	owner, writer, hold := roomTransportIdentity{}, queueWriterWire{}, radioCBinding{}
+	absence := radioAbsenceSource{Kind: "global"}
+	marshal := func(value any) []byte {
+		t.Helper()
+		raw, err := json.Marshal(value)
+		if err != nil {
+			t.Fatal(err)
+		}
+		return raw
+	}
+	for _, kind := range []string{"live", "parked", "global_absence"} {
+		t.Run(kind, func(t *testing.T) {
+			current := radioParkedCurrentWire{Kind: kind}
+			observation := radioParkedBridgeObservation{Source: &route}
+			switch kind {
+			case "live":
+				current.Owner = &owner
+				current.Writer = &writer
+			case "parked":
+				current.SourceHold = &hold
+			case "global_absence":
+				current.Absence = &absence
+				observation.Source = nil
+				observation.Absence = &absence
+			}
+			state := radioParkedBridgeState{Schema: "podconnect.output_radio_parked_bridge_observation.v1", OK: true, Purpose: "radio_parked_bridge_v1", Current: current, Observation: observation}
+			raw := marshal(state)
+			var decoded radioParkedBridgeState
+			if err := decodeRadioParkedBridgeState(raw, &decoded); err != nil {
+				t.Fatal("actual formatter nullable observation rejected", err)
+			}
+			for _, field := range []string{"source_identity", "source_absence"} {
+				var root map[string]json.RawMessage
+				_ = json.Unmarshal(raw, &root)
+				var observed map[string]json.RawMessage
+				_ = json.Unmarshal(root["observation"], &observed)
+				delete(observed, field)
+				root["observation"] = marshal(observed)
+				if decodeRadioParkedBridgeState(marshal(root), &decoded) == nil {
+					t.Fatalf("missing required %s accepted", field)
+				}
+			}
+			mixed := state
+			mixed.Observation.Source = &route
+			mixed.Observation.Absence = &absence
+			if decodeRadioParkedBridgeState(marshal(mixed), &decoded) == nil {
+				t.Fatal("mixed source/absence accepted")
+			}
+			empty := state
+			empty.Observation.Source = nil
+			empty.Observation.Absence = nil
+			if decodeRadioParkedBridgeState(marshal(empty), &decoded) == nil {
+				t.Fatal("no current proof accepted")
+			}
+			reply := radioParkedBridgeReply{Schema: "podconnect.output_radio_parked_bridge.v1", OK: true, Purpose: "radio_parked_bridge_v1", Current: current, Observation: observation, Phase: "challenge", RequiresPause: kind == "parked"}
+			if kind == "parked" {
+				reply.Resume = &radioParkedResumeFuture{}
+			} else {
+				reply.Start = &radioAbsenceFuture{}
+				if kind == "live" {
+					reply.Start.OldOwner = &owner
+				}
+			}
+			var ack radioParkedBridgeReply
+			if err := decodeRadioParkedBridgeReply(marshal(reply), &ack); err != nil {
+				t.Fatal("challenge nulls rejected", err)
+			}
+			for _, field := range []string{"route_identity", "current_writer_proof", "current_volume_percent", "current_base_revision"} {
+				var root map[string]json.RawMessage
+				_ = json.Unmarshal(marshal(reply), &root)
+				delete(root, field)
+				if decodeRadioParkedBridgeReply(marshal(root), &ack) == nil {
+					t.Fatalf("missing %s accepted", field)
+				}
+			}
+			extra := strings.Replace(string(marshal(reply)), `"ok":true`, `"ok":true,"extra":null`, 1)
+			if decodeRadioParkedBridgeReply([]byte(extra), &ack) == nil {
+				t.Fatal("unknown nullable key accepted")
+			}
+			if kind != "parked" {
+				reply.Phase = "bound_start"
+				if err := decodeRadioParkedBridgeReply(marshal(reply), &ack); err != nil {
+					t.Fatal("unpaused future START nulls rejected", err)
+				}
+				return
+			}
+			reply.Phase = "connecting" // C can expose only a partial identity here.
+			reply.Route = &roomVolumeRoute{DeviceID: "1"}
+			if err := decodeRadioParkedBridgeReply(marshal(reply), &ack); err != nil {
+				t.Fatal("connecting partial route rejected", err)
+			}
+			reply.Phase = "route_ready"
+			reply.Route = &route
+			if err := decodeRadioParkedBridgeReply(marshal(reply), &ack); err != nil {
+				t.Fatal("route-ready before writer rejected", err)
+			}
+			reply.Phase = "barrier_ready"
+			reply.Writer = &writer
+			reply.Barrier = true
+			if err := decodeRadioParkedBridgeReply(marshal(reply), &ack); err != nil {
+				t.Fatal("barrier-ready without manual volume rejected", err)
+			}
+			// Parked selected START has no target constructor/route, but its
+			// consumed paused-source barrier must carry the fresh writer.
+			startReply := reply
+			startReply.Resume = nil
+			startReply.Start = &radioAbsenceFuture{OldOwner: &owner}
+			startReply.Phase = "bound_start"
+			startReply.Route = nil
+			if err := decodeRadioParkedBridgeReply(marshal(startReply), &ack); err != nil {
+				t.Fatal("parked bound START rejected", err)
+			}
+			startReply.Writer = nil
+			if decodeRadioParkedBridgeReply(marshal(startReply), &ack) == nil {
+				t.Fatal("parked bound START missing barrier writer accepted")
+			}
+			reply.Phase = "opened"
+			if decodeRadioParkedBridgeReply(marshal(reply), &ack) == nil {
+				t.Fatal("opened without actual manual base accepted")
+			}
+			volume, base := 20, "2"
+			reply.CurrentVolume = &volume
+			reply.CurrentBase = &base
+			if err := decodeRadioParkedBridgeReply(marshal(reply), &ack); err != nil {
+				t.Fatal("actual opened nullable union rejected", err)
+			}
+			reply.Route = nil
+			if decodeRadioParkedBridgeReply(marshal(reply), &ack) == nil {
+				t.Fatal("opened without target route accepted")
+			}
+			reply.Route = &route
+			reply.CurrentBase = nil
+			if decodeRadioParkedBridgeReply(marshal(reply), &ack) == nil {
+				t.Fatal("split manual volume receipt accepted")
+			}
+		})
+	}
+	// Canonical LIVE MOVE has no target constructor in this pure grant.
+	live := radioParkedCurrentWire{Kind: "live", Owner: &owner, Writer: &writer}
+	level := 20
+	moveReply := radioParkedBridgeReply{Schema: "podconnect.output_radio_parked_bridge.v1", OK: true, Purpose: "radio_parked_bridge_v1", Current: live, Observation: radioParkedBridgeObservation{Source: &route}, Move: &moveCPrepare{}, Phase: "bound_move", ExecutionVolume: &level}
+	var moveAck radioParkedBridgeReply
+	if err := decodeRadioParkedBridgeReply(marshal(moveReply), &moveAck); err != nil {
+		t.Fatal("canonical bound MOVE grant rejected", err)
+	}
+	for _, phase := range []string{"bound_move", "delegated", "completed"} {
+		moveReply.Phase = phase
+		moveReply.ExecutionVolume = nil
+		if decodeRadioParkedBridgeReply(marshal(moveReply), &moveAck) == nil {
+			t.Fatal("MOVE omitted actual execution volume", phase)
+		}
+		moveReply.ExecutionVolume = &level
+	}
+	// The actual authenticated transport must select the typed decoder, too.
+	current := radioParkedCurrentWire{Kind: "global_absence", Absence: &absence}
+	state := radioParkedBridgeState{Schema: "podconnect.output_radio_parked_bridge_observation.v1", OK: true, Purpose: "radio_parked_bridge_v1", Current: current, Observation: radioParkedBridgeObservation{Absence: &absence}}
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) { _, _ = w.Write(marshal(state)) }))
+	defer server.Close()
+	var decoded radioParkedBridgeState
+	if err := radioControlHTTP(context.Background(), "POST", server.URL, "private-test-token", struct{}{}, &decoded); err != nil {
+		t.Fatal("real HTTP typed dispatch rejected", err)
+	}
+}
+
+func TestRadioNullableFutureStartOldOwnerDiscriminator(t *testing.T) {
+	for _, kind := range []string{"global", "target"} {
+		t.Run(kind, func(t *testing.T) {
+			reply := radioAbsenceStartReply{Schema: "podconnect.output_radio_absence_start.v1", OK: true, Purpose: "radio_absence_start_v1", Phase: "challenge", Hold: radioAbsenceBinding{Source: radioAbsenceSource{Kind: kind}}}
+			if kind == "target" {
+				reply.Future.OldOwner = &roomTransportIdentity{}
+			}
+			encode := func() []byte {
+				raw, err := json.Marshal(reply)
+				if err != nil {
+					t.Fatal(err)
+				}
+				return raw
+			}
+			var decoded radioAbsenceStartReply
+			raw := encode()
+			if err := decodeRadioAbsenceStartReply(raw, &decoded); err != nil {
+				t.Fatal("legal old-owner variant rejected", err)
+			}
+			var root map[string]json.RawMessage
+			_ = json.Unmarshal(raw, &root)
+			var future map[string]json.RawMessage
+			_ = json.Unmarshal(root["future_start"], &future)
+			delete(future, "old_native_owner")
+			root["future_start"], _ = json.Marshal(future)
+			missing, _ := json.Marshal(root)
+			if decodeRadioAbsenceStartReply(missing, &decoded) == nil {
+				t.Fatal("missing old owner key accepted")
+			}
+			if kind == "global" {
+				reply.Future.OldOwner = &roomTransportIdentity{}
+			} else {
+				reply.Future.OldOwner = nil
+			}
+			if decodeRadioAbsenceStartReply(encode(), &decoded) == nil {
+				t.Fatal("old owner contrary to source kind accepted")
+			}
+		})
+	}
+}
diff --git a/daemon/radio_other_target.go b/daemon/radio_other_target.go
new file mode 100644
index 0000000..94660be
--- /dev/null
+++ b/daemon/radio_other_target.go
@@ -0,0 +1,384 @@
+package daemon
+
+import (
+	"context"
+	"github.com/devgianlu/go-librespot/output"
+	"github.com/devgianlu/go-librespot/player"
+	"github.com/devgianlu/go-librespot/session"
+	"strconv"
+	"strings"
+	"time"
+)
+
+// Immutable provenance installed only after the separate C grant opened and
+// the actual writer completed its two-phase admission.
+type radioOtherWriter struct {
+	Owner      *AppPlayer
+	Player     *player.Player
+	Session    *session.Session
+	Identity   roomTransportIdentity
+	Writer     output.MovePipeIdentity
+	Epoch      string
+	Process    contentProcess
+	Generation uint64
+	Grant      radioOtherRequest
+	StartAt    *contentOperation
+	MoveAt     *moveOperation
+}
+
+func (app *App) completedRadioOtherWriterCurrentLocked(owner *AppPlayer, identity roomTransportIdentity) (*completedWriter, bool, error) {
+	proof := app.radioOtherWriter
+	if proof == nil {
+		return nil, false, nil
+	}
+	// A subsequent real START completed a newer source; its existing native/C
+	// custody supersedes this earlier receiver grant without rewriting it.
+	if op := app.startCustody; op != nil && op != proof.StartAt {
+		op.mu.Lock()
+		newer := op.Owner == owner && op.Terminal && op.State == "complete" && op.Actual != nil && sameCompletedRoom(*op.Actual, identity) && op.CReceipt != nil && op.CReceipt.Phase == "completed"
+		op.mu.Unlock()
+		if newer {
+			return nil, false, nil
+		}
+	}
+	if op := app.moveCustody; op != nil && op != proof.MoveAt {
+		op.mu.Lock()
+		newer := op.Owner == owner && op.Terminal && op.State == "complete" && op.Actual != nil && sameCompletedRoom(*op.Actual, identity) && op.CReceipt != nil && op.CReceipt.Phase == "completed"
+		op.mu.Unlock()
+		if newer {
+			return nil, false, nil
+		}
+	}
+	if app.startCustody != proof.StartAt || app.moveCustody != proof.MoveAt {
+		return nil, true, ErrAliasConflict
+	}
+	observed, valid := nativeContentProcess()
+	if !valid || observed != proof.Process || owner == nil || proof.Owner != owner || proof.Player != owner.player || proof.Session != owner.sess || !sameCompletedRoom(proof.Identity, identity) || app.openedWriterOwner != owner || app.openedWriter != proof.Writer || app.openedWriterGeneration != proof.Generation || proof.Epoch == "" {
+		return nil, true, ErrAliasConflict
+	}
+	return &completedWriter{radio: proof, custodyStart: proof.StartAt, custodyMove: proof.MoveAt, writer: proof.Writer, epoch: proof.Epoch}, true, nil
+}
+
+type radioOtherObservation struct {
+	Owner  roomTransportIdentity `json:"native_owner"`
+	Writer queueWriterWire       `json:"writer_proof"`
+	Route  roomVolumeRoute       `json:"route_identity"`
+}
+type radioOtherRequest struct {
+	Schema        string                 `json:"schema"`
+	Phase         string                 `json:"phase"`
+	Hold          radioCBinding          `json:"hold"`
+	IntentID      string                 `json:"intent_id"`
+	Revision      string                 `json:"native_revision"`
+	Owner         roomTransportIdentity  `json:"current_native_owner"`
+	Intended      roomTransportIdentity  `json:"intended_native_owner"`
+	Token         string                 `json:"token,omitempty"`
+	Source        *roomVolumeRoute       `json:"current_source_identity,omitempty"`
+	Writer        *queueWriterWire       `json:"current_writer_proof,omitempty"`
+	ObservedOwner *roomTransportIdentity `json:"observed_native_owner,omitempty"`
+}
+type radioOtherReply struct {
+	Schema          string                 `json:"schema"`
+	OK              bool                   `json:"ok"`
+	Purpose         string                 `json:"purpose"`
+	Phase           string                 `json:"phase"`
+	Token           string                 `json:"token"`
+	IntentID        string                 `json:"intent_id"`
+	Revision        string                 `json:"native_revision"`
+	Owner           roomTransportIdentity  `json:"current_native_owner"`
+	Intended        roomTransportIdentity  `json:"intended_native_owner"`
+	Source          roomVolumeRoute        `json:"current_source_identity"`
+	Writer          *queueWriterWire       `json:"current_writer_proof,omitempty"`
+	Route           *roomVolumeRoute       `json:"route_identity,omitempty"`
+	Peer            string                 `json:"receiver_key_digest"`
+	Generation      string                 `json:"generation"`
+	Barrier         bool                   `json:"writer_barrier_verified"`
+	Physical        bool                   `json:"physical_result_verified"`
+	ObservedCurrent bool                   `json:"observed_current"`
+	ObservedOwner   *roomTransportIdentity `json:"observed_native_owner,omitempty"`
+	ObservedWriter  *queueWriterWire       `json:"observed_writer_proof,omitempty"`
+	ObservedRoute   *roomVolumeRoute       `json:"observed_route_identity,omitempty"`
+}
+
+func (p *AppPlayer) radioOtherCall(ctx context.Context, h *radioHold, r radioOtherRequest) (radioOtherReply, error) {
+	var ack radioOtherReply
+	endpoint := strings.TrimSuffix(p.app.cfg.RoomTransportOwnToneURL, "/") + "/api/outputs/" + h.Proof.Output.DeviceID + "/radio-handoff/other-target"
+	if err := radioControlHTTP(ctx, "POST", endpoint, p.app.cfg.RadioHandoffControlToken, r, &ack); err != nil {
+		return ack, err
+	}
+	if ack.Schema != r.Schema || !ack.OK || ack.Purpose != "radio_other_target_v1" || ack.Physical || ack.IntentID != r.IntentID || ack.Revision != r.Revision || ack.Owner != r.Owner || ack.Intended != r.Intended || !volumeHex32.MatchString(ack.Token) || r.Token != "" && r.Token != ack.Token || !volumeHex64.MatchString(ack.Peer) || ack.Peer == h.Proof.Digest || ack.Source.Process != h.Proof.Output.Process || ack.Source.InputPathDigest != h.Proof.Writer.InputDigest || ack.Source.InputItemID == "0" || !volumeCounter(ack.Generation) || ack.Generation == "0" {
+		return ack, ErrAliasConflict
+	}
+	return ack, nil
+}
+
+// The actor calls this before changing an alias/source. The original radio
+// record is never consumed: only the separate receiver grant owns reopening.
+func (p *AppPlayer) radioAdmitOtherTarget(parent context.Context, target, cause string) error {
+	if p == nil || p.app == nil || p.player == nil || p.sess == nil || p.state == nil || p.state.player == nil || p.state.device == nil || target == "" || cause == "" {
+		return ErrAliasConflict
+	}
+	ctx, cancel := context.WithTimeout(parent, 8*time.Second)
+	defer cancel()
+	app := p.app
+	app.radio.mu.Lock()
+	var h *radioHold
+	for _, candidate := range app.radio.Holds {
+		if candidate.Parked != nil {
+			continue // Independent receiver custody never owns the parked FIFO.
+		}
+		if candidate.owner == nil || candidate.RequiresPause {
+			if h != nil {
+				app.radio.mu.Unlock()
+				return ErrAliasConflict
+			}
+			h = candidate
+		}
+	}
+	if app.radio.failed || app.radio.Holds[target] != nil || h == nil || h.owner != p || h.Phase != "suspended" {
+		app.radio.mu.Unlock()
+		return ErrAliasConflict
+	}
+	app.radio.mu.Unlock()
+	state, err := p.player.InspectRadio(ctx)
+	if err != nil {
+		return err
+	}
+	if !state.Suspended {
+		app.radio.mu.Lock()
+		stored := h.OtherGrant
+		opened := h.OtherGrantPhase == "opened" && !h.WriterParked && stored != nil && stored.Intended.RoomID == target
+		var observed radioOtherRequest
+		if stored != nil {
+			observed = *stored
+		}
+		app.radio.mu.Unlock()
+		if !opened || state.WriterClosed || observed.Writer == nil || observed.Source == nil {
+			return ErrAliasConflict
+		}
+		actual, identityErr := p.roomTransportIdentity(observed.Intended.AccountUserID, app.deviceId, target, observed.Intended.HomePodID)
+		if identityErr != nil {
+			return ErrAliasConflict
+		}
+		app.moveCustodyMu.Lock()
+		registered, wg, wo := app.openedWriter, app.openedWriterGeneration, app.openedWriterOwner
+		app.moveCustodyMu.Unlock()
+		if wo != p || wg == 0 || p.primaryStream == nil || p.primaryStream.Source == nil {
+			return ErrAliasConflict
+		}
+		primary, paused := p.primaryStream, p.state.player.IsPaused
+		pipe, epoch, inspectErr := p.player.RoomMove(ctx, "inspect", primary.Source, output.MovePipeIdentity{}, "", !paused, func(mutate func()) error {
+			p.aliasMu.Lock()
+			defer p.aliasMu.Unlock()
+			if ctx.Err() != nil || p.primaryStream != primary || p.spotConnId != actual.ConnectionID || p.state.player.SessionId != actual.SessionID || p.state.player.IsPaused != paused || p.aliasRevision != actual.AliasRevision || p.aliasRetired || p.roomVolumeClosing {
+				return ErrAliasConflict
+			}
+			app.moveCustodyMu.Lock()
+			defer app.moveCustodyMu.Unlock()
+			if app.openedWriterOwner != p || app.openedWriter != registered || app.openedWriterGeneration != wg {
+				return ErrAliasConflict
+			}
+			mutate()
+			return nil
+		})
+		process, valid := nativeContentProcess()
+		if inspectErr != nil || !valid || pipe != registered || epoch == "" {
+			return ErrAliasConflict
+		}
+		expected := queueWriterWire{process, registered.FD, registered.PipeIdentity, epoch, strconv.FormatUint(wg, 10), observed.Writer.InputDigest}
+		observed.Phase = "state"
+		observed.ObservedOwner = &actual
+		observed.Writer = &expected
+		ack, readErr := p.radioOtherCall(ctx, h, observed)
+		if readErr != nil || (ack.Phase != "opened" && ack.Phase != "delegated") || !ack.ObservedCurrent || ack.ObservedOwner == nil || *ack.ObservedOwner != actual || ack.ObservedWriter == nil || *ack.ObservedWriter != expected || ack.ObservedRoute == nil || ack.ObservedRoute.DeviceID != actual.HomePodID || ack.ObservedRoute.InputPathDigest != expected.InputDigest {
+			return ErrAliasConflict
+		}
+		app.radio.mu.Lock()
+		if app.radio.Holds[h.Request.TargetID] != h || h.WriterParked || h.Phase != "suspended" {
+			app.radio.mu.Unlock()
+			return ErrAliasConflict
+		}
+		h.OtherObserved = &radioOtherObservation{actual, expected, *ack.ObservedRoute}
+		journalErr := app.persistRadioLocked()
+		app.radio.mu.Unlock()
+		if journalErr != nil {
+			return journalErr
+		}
+		app.moveCustodyMu.Lock()
+		app.radioReacquiredWriter = nil
+		app.radioParkedWriter = nil
+		app.radioOtherWriter = &radioOtherWriter{Owner: p, Player: p.player, Session: p.sess, Identity: actual, Writer: registered, Epoch: epoch, Process: process, Generation: wg, Grant: observed, StartAt: app.startCustody, MoveAt: app.moveCustody}
+		app.moveCustodyMu.Unlock()
+		return nil
+	}
+	if !state.WriterClosed {
+		return ErrAliasConflict
+	}
+	account, bound := p.sess.BoundUsername()
+	if !bound || account != h.Proof.Owner.AccountUserID {
+		return ErrAliasConflict
+	}
+	p.aliasMu.Lock()
+	binding := p.aliasBindingLocked()
+	var destination ApiAlias
+	for _, a := range p.aliasRegistry {
+		if a.RoomID == target {
+			destination = a
+		}
+	}
+	revision := p.aliasRevision
+	if destination.ID != p.state.device.SelectedAliasId {
+		if revision >= 1<<53-1 {
+			p.aliasMu.Unlock()
+			return ErrAliasConflict
+		}
+		revision++
+	}
+	if binding == nil || !binding.Ready || destination.ID == 0 || destination.HomePodID == h.Proof.Output.DeviceID || p.aliasRetired || p.roomVolumeClosing {
+		p.aliasMu.Unlock()
+		return ErrAliasConflict
+	}
+	owner := roomTransportIdentity{account, app.deviceId, target, destination.HomePodID, p.spotConnId, p.state.player.SessionId, binding.Incarnation, binding.Registry, revision}
+	p.aliasMu.Unlock()
+	if !nativeBoundOwnerValid(owner) {
+		return ErrAliasConflict
+	}
+	nativeRevision, err := p.nextNativeIntent()
+	if err != nil {
+		return err
+	}
+	intent, err := randomQueueID(16)
+	if err != nil {
+		return err
+	}
+	intent = intent[:8] + "-" + intent[8:12] + "-" + intent[12:16] + "-" + intent[16:20] + "-" + intent[20:]
+	currentOwner, ownerErr := p.roomTransportIdentity(account, app.deviceId, h.Proof.Owner.RoomID, h.Proof.Owner.HomePodID)
+	if ownerErr != nil || currentOwner != h.Proof.Owner {
+		return ErrAliasConflict
+	}
+	r := radioOtherRequest{Schema: "podconnect.output_radio_other_target.v1", Phase: "prepare", Hold: h.Proof, IntentID: intent, Revision: nativeRevision, Owner: currentOwner, Intended: owner}
+	prepared, err := p.radioOtherCall(ctx, h, r)
+	if err != nil || prepared.Phase != "prepared" {
+		return ErrAliasConflict
+	}
+	r.Token = prepared.Token
+	r.Source = &prepared.Source
+	r.Writer = &h.Proof.Writer
+	r.Phase = "commit"
+	possible := true
+	defer func() {
+		if possible {
+			app.radio.mu.Lock()
+			app.radio.failed = true
+			h.OtherGrantPhase = "unknown"
+			_ = app.persistRadioLocked()
+			app.radio.mu.Unlock()
+		}
+	}()
+	persist := func(phase string) error {
+		app.radio.mu.Lock()
+		defer app.radio.mu.Unlock()
+		if app.radio.Holds[h.Request.TargetID] != h || h.Phase != "suspended" {
+			return ErrAliasConflict
+		}
+		snapshot := r
+		h.OtherGrant = &snapshot
+		h.OtherGrantPhase = phase
+		return app.persistRadioLocked()
+	}
+	if err = persist("commit_pending"); err != nil {
+		return err
+	}
+	ack, err := p.radioOtherCall(ctx, h, r)
+	if err != nil {
+		return err
+	}
+	for ack.Phase == "connecting" {
+		select {
+		case <-ctx.Done():
+			return ctx.Err()
+		case <-time.After(25 * time.Millisecond):
+		}
+		q := r
+		q.Phase = "state"
+		ack, err = p.radioOtherCall(ctx, h, q)
+		if err != nil {
+			return err
+		}
+	}
+	if ack.Phase != "route_ready" {
+		return ErrAliasConflict
+	}
+	generation, _ := strconv.ParseUint(h.Request.Generation, 10, 64)
+	b := output.RadioPipeBinding{Token: h.Proof.Token, Generation: generation, Writer: output.MovePipeIdentity{PipeIdentity: h.Proof.Writer.Pipe, FD: h.Proof.Writer.FD}}
+	guard := func() error {
+		if ctx.Err() != nil {
+			return ctx.Err()
+		}
+		app.radio.mu.Lock()
+		defer app.radio.mu.Unlock()
+		if app.radio.failed || app.radio.Holds[h.Request.TargetID] != h || h.Phase != "suspended" {
+			return ErrAliasConflict
+		}
+		return nil
+	}
+	if err = persist("writer_reopen_pending"); err != nil {
+		return err
+	}
+	if _, err = p.player.ReacquireRadio(ctx, b, guard, func(create func() (output.Output, error)) (output.Output, error) {
+		app.moveCustodyMu.Lock()
+		defer app.moveCustodyMu.Unlock()
+		if app.openedWriterOwner != p {
+			return nil, ErrAliasConflict
+		}
+		return app.openRegisteredOutputLocked(p, create)
+	}); err != nil {
+		return err
+	}
+	app.moveCustodyMu.Lock()
+	writer, wg, wo := app.openedWriter, app.openedWriterGeneration, app.openedWriterOwner
+	app.moveCustodyMu.Unlock()
+	process, valid := nativeContentProcess()
+	if !valid || wg == 0 || wo != p || writer.Type != "fifo" {
+		return ErrAliasConflict
+	}
+	fresh := queueWriterWire{process, writer.FD, writer.PipeIdentity, h.Proof.Writer.Epoch, strconv.FormatUint(wg, 10), h.Proof.Writer.InputDigest}
+	r.Writer = &fresh
+	r.Phase = "barrier"
+	if err = persist("barrier_pending"); err != nil {
+		return err
+	}
+	ack, err = p.radioOtherCall(ctx, h, r)
+	if err != nil || ack.Phase != "barrier_ready" || !ack.Barrier || ack.Writer == nil || *ack.Writer != fresh {
+		return ErrAliasConflict
+	}
+	r.Phase = "open"
+	if err = persist("open_pending"); err != nil {
+		return err
+	}
+	ack, err = p.radioOtherCall(ctx, h, r)
+	if err != nil || ack.Phase != "opened" || !ack.Barrier || ack.Writer == nil || *ack.Writer != fresh {
+		return ErrAliasConflict
+	}
+	if _, err = p.player.CompleteRadioReacquire(ctx, b, guard); err != nil {
+		return err
+	}
+	if err = p.adoptRadioIntendedOwner(r.Owner, r.Intended); err != nil {
+		return err
+	}
+	app.moveCustodyMu.Lock()
+	app.radioReacquiredWriter = nil
+	app.radioParkedWriter = nil
+	app.radioOtherWriter = &radioOtherWriter{Owner: p, Player: p.player, Session: p.sess, Identity: owner, Writer: writer, Epoch: fresh.Epoch, Process: process, Generation: wg, Grant: r, StartAt: app.startCustody, MoveAt: app.moveCustody}
+	app.moveCustodyMu.Unlock()
+	app.radio.mu.Lock()
+	h.WriterParked = false
+	h.OtherGrantPhase = "opened"
+	err = app.persistRadioLocked()
+	app.radio.mu.Unlock()
+	if err != nil {
+		return err
+	}
+	possible = false
+	return nil
+}
diff --git a/daemon/radio_parked_absence.go b/daemon/radio_parked_absence.go
