@@ -0,0 +1,296 @@
+package daemon
+
+import (
+	"context"
+	"strconv"
+	"strings"
+	"time"
+
+	"github.com/devgianlu/go-librespot/output"
+)
+
+const apiRadioParkedHandoff ApiRequestType = "radio_parked_handoff"
+
+type radioParkedBinding struct {
+	Schema           string               `json:"schema"`
+	SourceHold       radioCBinding        `json:"source_hold"`
+	Source           roomVolumeRoute      `json:"parked_source"`
+	Output           radioAbsenceReceiver `json:"output_identity"`
+	HandoffID        string               `json:"handoff_id"`
+	Token            string               `json:"token,omitempty"`
+	Generation       string               `json:"generation"`
+	Revision         string               `json:"native_revision"`
+	SenderPeer       string               `json:"sender_peer"`
+	RadioProcess     string               `json:"radio_process"`
+	RadioEpoch       string               `json:"radio_owner_epoch"`
+	Digest           string               `json:"receiver_key_digest"`
+	InitialVolume    int                  `json:"initial_volume_percent"`
+	VolumeProvenance string               `json:"volume_provenance"`
+}
+type radioParkedHold struct {
+	Binding   radioParkedBinding `json:"binding"`
+	Signature string             `json:"suspended_signature,omitempty"`
+}
+type radioParkedReply struct {
+	radioParkedBinding
+	OK        bool   `json:"ok"`
+	Purpose   string `json:"purpose"`
+	Phase     string `json:"phase"`
+	Signature string `json:"suspended_signature,omitempty"`
+	Physical  bool   `json:"physical_result_verified"`
+}
+type radioParkedObservation struct {
+	Schema   string             `json:"schema"`
+	OK       bool               `json:"ok"`
+	Proof    radioParkedBinding `json:"proof"`
+	Physical bool               `json:"physical_result_verified"`
+}
+
+func (app *App) radioParkedCall(ctx context.Context, b radioParkedBinding, phase string) (radioParkedReply, error) {
+	var out radioParkedReply
+	endpoint := strings.TrimSuffix(app.cfg.RoomTransportOwnToneURL, "/") + "/api/outputs/" + b.Output.DeviceID + "/radio-parked-absence/" + phase
+	if err := radioControlHTTP(ctx, "POST", endpoint, app.cfg.RadioHandoffControlToken, b, &out); err != nil {
+		return out, err
+	}
+	expected := b
+	expected.Token = out.Token
+	if !out.OK || out.Physical || out.Purpose != "radio_parked_absence_v1" || out.radioParkedBinding != expected || !volumeHex32.MatchString(out.Token) || b.Token != "" && b.Token != out.Token || out.Phase != "prepared" && out.Phase != "suspended" && out.Phase != "unknown" || out.Phase == "suspended" && !volumeHex64.MatchString(out.Signature) {
+		return out, ErrAliasConflict
+	}
+	return out, nil
+}
+
+// Existing child custody is always handled here, including malformed requests.
+// Its historical source linkage is never a requirement for passive results.
+func (app *App) radioParkedAPI(ctx context.Context, c radioHTTPCall) (bool, any, error) {
+	app.radio.mu.Lock()
+	h := app.radio.Holds[c.Request.TargetID]
+	child := h != nil && h.Parked != nil
+	candidate := false
+	if h == nil && c.Action == "reserve" {
+		for _, v := range app.radio.Holds {
+			if v.Parked == nil && v.Absence == nil && v.WriterParked && v.RequiresPause && v.Phase == "suspended" && v.owner != nil {
+				candidate = true
+				break
+			}
+		}
+	}
+	if !child && !candidate {
+		app.radio.mu.Unlock()
+		return false, nil, nil
+	}
+	if child {
+		if h.Request.ProcessID != c.Request.ProcessID || h.Request.HandoffID != c.Request.HandoffID || h.Request.Generation != c.Request.Generation || h.Request.Peer != c.Request.Peer || h.Request.ExpectedRevision != c.Request.ExpectedRevision || c.Request.Token != "" && c.Request.Token != h.Parked.Binding.Token {
+			app.radio.mu.Unlock()
+			return true, nil, ErrAliasConflict
+		}
+		if c.Action == "result" {
+			if h.ParkedBridge != nil {
+				data := radioReply(h, c.Request)
+				app.radio.mu.Unlock()
+				return true, data, nil
+			}
+			b := h.Parked.Binding
+			if b.Token == "" {
+				data := radioReply(h, c.Request)
+				app.radio.mu.Unlock()
+				return true, data, nil
+			}
+			app.radio.mu.Unlock()
+			ack, err := app.radioParkedCall(ctx, b, "state")
+			if err != nil {
+				return true, nil, err
+			}
+			app.radio.mu.Lock()
+			defer app.radio.mu.Unlock()
+			if app.radio.Holds[c.Request.TargetID] != h || h.Parked.Binding != b {
+				return true, nil, ErrAliasConflict
+			}
+			h.Phase = ack.Phase
+			h.Parked.Signature = ack.Signature
+			h.ObservedAt = time.Now().UTC().Format(time.RFC3339Nano)
+			if err = app.persistRadioLocked(); err != nil {
+				return true, nil, err
+			}
+			return true, radioReply(h, c.Request), nil
+		}
+		if c.Action != "suspend" {
+			app.radio.mu.Unlock()
+			return true, nil, ErrAliasConflict
+		}
+	}
+	app.radio.mu.Unlock()
+	app.ownerMu.Lock()
+	ch, done := app.currentAPI, app.currentDone
+	app.ownerMu.Unlock()
+	if ch == nil {
+		return true, nil, ErrAliasConflict
+	}
+	req, wait := NewApiRequest(apiRadioParkedHandoff, c)
+	select {
+	case ch <- req:
+		data, err := wait(ctx)
+		return true, data, err
+	case <-done:
+		return true, nil, ErrAliasConflict
+	case <-ctx.Done():
+		return true, nil, ctx.Err()
+	}
+}
+
+// Caller holds app.radio.mu. Child C bindings and later Native commands share
+// one monotonic revision boundary; the immutable parent proof is only a floor.
+func (p *AppPlayer) nextRadioParkedRevisionLocked(sourceRevision string) (string, error) {
+	source, err := strconv.ParseUint(sourceRevision, 10, 64)
+	if err != nil || source == 0 || !volumeCounter(sourceRevision) {
+		return "", ErrAliasConflict
+	}
+	p.aliasMu.Lock()
+	defer p.aliasMu.Unlock()
+	latest := p.app.radio.Intent
+	if p.roomNativeIntent > latest {
+		latest = p.roomNativeIntent
+	}
+	if source > latest {
+		latest = source
+	}
+	// C forbids the sentinel MAX value too. Reject before touching either
+	// counter so overflow cannot poison the remaining explicit intent state.
+	if latest >= ^uint64(0)-1 {
+		return "", ErrAliasConflict
+	}
+	latest++
+	p.app.radio.Intent, p.roomNativeIntent = latest, latest
+	return strconv.FormatUint(latest, 10), nil
+}
+
+// This runs on the existing Native owner. It reads the actual retained source
+// and closed FIFO, and never issues a second pause, close, seek or decoder load.
+func (p *AppPlayer) radioParkedActor(parent context.Context, c radioHTTPCall) (any, error) {
+	ctx, cancel := queueOperationContext(parent, c.Context)
+	defer cancel()
+	app := p.app
+	app.radio.mu.Lock()
+	defer app.radio.mu.Unlock()
+	if app.radio.failed || ctx.Err() != nil || p.player == nil || p.primaryStream == nil {
+		return nil, ErrAliasConflict
+	}
+	child := app.radio.Holds[c.Request.TargetID]
+	var source *radioHold
+	for _, h := range app.radio.Holds {
+		if h.SourceMove != nil && h.SourceMovePhase != "opened" {
+			return nil, ErrAliasConflict
+		}
+		if h.Parked == nil && h.Absence == nil && h.owner == p && h.WriterParked && h.RequiresPause && h.Phase == "suspended" {
+			if source != nil {
+				return nil, ErrAliasConflict
+			}
+			source = h
+		}
+	}
+	if source == nil || source.primary != p.primaryStream || source.PausedBefore == nil || source.Request.TargetID == c.Request.TargetID {
+		return nil, ErrAliasConflict
+	}
+	if child != nil && (child.Parked == nil || child.Parked.Binding.SourceHold != source.Proof) {
+		return nil, ErrAliasConflict
+	}
+	actual, err := p.player.Start35CurrentSource(ctx)
+	if err != nil || actual != source.primary.Source {
+		return nil, ErrAliasConflict
+	}
+	status, err := p.player.InspectRadio(ctx)
+	generation, e := strconv.ParseUint(source.Request.Generation, 10, 64)
+	binding := output.RadioPipeBinding{Token: source.Proof.Token, Generation: generation, Writer: output.MovePipeIdentity{PipeIdentity: source.Proof.Writer.Pipe, FD: source.Proof.Writer.FD}}
+	if err != nil || e != nil || !status.Suspended || !status.WriterClosed || status.Binding != binding {
+		return nil, ErrAliasConflict
+	}
+	if child != nil {
+		if c.Action != "suspend" || child.Phase != "prepared" || child.Parked.Binding.Revision != strconv.FormatUint(app.radio.Intent, 10) || child.Actions["suspend:"+c.Request.ActionID] || len(child.Actions) >= 4096 {
+			return nil, ErrAliasConflict
+		}
+		child.Actions["suspend:"+c.Request.ActionID] = true
+		child.Phase = "unknown"
+		if err = app.persistRadioLocked(); err != nil {
+			return nil, err
+		}
+		ack, callErr := app.radioParkedCall(ctx, child.Parked.Binding, "confirm")
+		if callErr != nil {
+			return nil, callErr
+		}
+		child.Phase = ack.Phase
+		child.Parked.Signature = ack.Signature
+		child.ObservedAt = time.Now().UTC().Format(time.RFC3339Nano)
+		if err = app.persistRadioLocked(); err != nil {
+			return nil, err
+		}
+		return radioReply(child, c.Request), nil
+	}
+	if c.Action != "reserve" || c.Request.Token != "" {
+		return nil, ErrAliasConflict
+	}
+	if c.Request.ExpectedRevision != strconv.FormatUint(app.radio.Intent, 10) {
+		return app.rejectStaleRadioLocked(c.Request)
+	}
+	target := ""
+	seen := map[string]bool{}
+	if len(app.cfg.DeviceAliasRoomIDs) != len(app.cfg.DeviceAliases) || len(app.cfg.DeviceAliasHomePodIDs) != len(app.cfg.DeviceAliases) {
+		return nil, ErrAliasConflict
+	}
+	for i, room := range app.cfg.DeviceAliasRoomIDs {
+		if seen[room] {
+			return nil, ErrAliasConflict
+		}
+		seen[room] = true
+		if room == c.Request.TargetID {
+			target = app.cfg.DeviceAliasHomePodIDs[i]
+		}
+	}
+	if !homePodIDPattern.MatchString(target) {
+		return nil, ErrAliasConflict
+	}
+	var observed radioParkedObservation
+	request := struct {
+		Schema string        `json:"schema"`
+		Source radioCBinding `json:"source_hold"`
+	}{"podconnect.output_radio_parked_absence_observation.v1", source.Proof}
+	endpoint := strings.TrimSuffix(app.cfg.RoomTransportOwnToneURL, "/") + "/api/outputs/" + target + "/radio-parked-absence/observe"
+	if err = radioControlHTTP(ctx, "POST", endpoint, app.cfg.RadioHandoffControlToken, request, &observed); err != nil {
+		return nil, err
+	}
+	b := observed.Proof
+	if observed.Schema != request.Schema || !observed.OK || observed.Physical || b.Schema != "podconnect.output_radio_parked_absence.v1" || b.SourceHold != source.Proof || !b.Source.valid() || b.Source.Process != source.Proof.Output.Process || b.Source.InputPathDigest != source.Proof.Writer.InputDigest || b.Output.Process != source.Proof.Output.Process || b.Output.DeviceID != target || !volumeCounter(b.Output.Incarnation) || b.Output.Incarnation == "0" || b.Digest != c.Request.Peer.Digest || b.Digest == source.Proof.Digest || b.InitialVolume < 0 || b.InitialVolume > 100 || b.VolumeProvenance != "stored_manual_base" {
+		return nil, ErrAliasConflict
+	}
+	newGeneration, err := strconv.ParseUint(c.Request.Generation, 10, 64)
+	if err != nil || newGeneration <= app.radio.Generation || app.radio.Intent == ^uint64(0) || ctx.Err() != nil {
+		return nil, ErrAliasConflict
+	}
+	revision, err := p.nextRadioParkedRevisionLocked(source.Proof.Revision)
+	if err != nil {
+		return nil, err
+	}
+	app.radio.Generation = newGeneration
+	b.HandoffID = c.Request.HandoffID
+	b.Generation = c.Request.Generation
+	b.Revision = revision
+	b.SenderPeer = c.Request.Peer.Process
+	b.RadioProcess = c.Request.Peer.Process
+	b.RadioEpoch = c.Request.Peer.Epoch
+	b.Token = ""
+	child = &radioHold{Request: c.Request, Phase: "unknown", Actions: map[string]bool{"reserve:" + c.Request.ActionID: true}, Parked: &radioParkedHold{Binding: b}}
+	app.radio.Holds[c.Request.TargetID] = child
+	if err = app.persistRadioLocked(); err != nil {
+		return nil, err
+	}
+	ack, err := app.radioParkedCall(ctx, b, "prepare")
+	if err != nil {
+		return nil, err
+	}
+	child.Parked.Binding.Token = ack.Token
+	child.Phase = ack.Phase
+	child.ObservedAt = time.Now().UTC().Format(time.RFC3339Nano)
+	if err = app.persistRadioLocked(); err != nil {
+		return nil, err
+	}
+	return radioReply(child, c.Request), nil
+}
