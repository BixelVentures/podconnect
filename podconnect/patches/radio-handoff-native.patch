+package daemon
+
+import (
+	"math"
+
+	"github.com/devgianlu/go-librespot/player"
+)
+
+// An actual receiver/base receipt updates presentation only. The physical
+// receiver already accepted the volume under its own custody operation.
+func (p *AppPlayer) adoptRadioVolume(percent int) error {
+	if percent < 0 || percent > 100 || p.state == nil || p.state.device == nil {
+		return ErrAliasConflict
+	}
+	// Pipe mixer updates are emitted synchronously before the worker barrier.
+	// Clear both a buffered old update and an already armed debounce event.
+	if p.radioVolumeTimer != nil {
+		p.radioVolumeTimer.Stop()
+		select {
+		case <-p.radioVolumeTimer.C:
+		default:
+		}
+	}
+	select {
+	case <-p.volumeUpdate:
+	default:
+	}
+	p.state.device.Volume = uint32(math.Round(float64(percent) * float64(player.MaxStateVolume) / 100))
+	return nil
+}
