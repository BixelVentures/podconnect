+package daemon
+
+import "context"
+
+// Bind the exact original selected-content offer. The old track's destination
+// is never constructed or opened by this consume-only bridge.
+func (p *AppPlayer) bindRadioParkedStart(parent context.Context, h *radioHold, op *contentOperation) error {
+	if h == nil || h.Parked == nil || op == nil || op.Radio == nil || !op.Radio.Parked {
+		return ErrAliasConflict
+	}
+	ctx, cancel := context.WithDeadline(parent, op.RadioCommitDeadline)
+	defer cancel()
+	current, err := p.captureRadioParkedCurrent(ctx, true)
+	if err != nil {
+		return err
+	}
+	if current.Intent != op.Radio.ClaimIntent {
+		return ErrAliasConflict
+	}
+	op.mu.Lock()
+	valid := op.CommitClaimed && op.Claimed && op.State == "committing" && !op.Cancelled && !op.Terminal && op.Stream != nil && op.Stream.Source != nil && op.Prepared != nil && op.Prepared.SessionId == op.Intended.SessionID && op.Intended.HomePodID == h.Parked.Binding.Output.DeviceID
+	if !valid {
+		op.mu.Unlock()
+		return ErrAliasConflict
+	}
+	future := radioAbsenceFuture{op.Capture.Process, op.Offer.OfferID, op.Offer.BindingID, op.ContentDigest, op.Capture.Incarnation, op.Revision, op.Capture.OldOwner, op.Intended, op.Capture.Pipe, op.Capture.PipeDigest, start35Policy, 35}
+	if current.Kind == "global_absence" {
+		future.OldOwner = nil
+	} else if current.Owner == nil || future.OldOwner == nil || *future.OldOwner != *current.Owner {
+		op.mu.Unlock()
+		return ErrAliasConflict
+	}
+	op.mu.Unlock()
+	r := radioParkedBridgeRequest{Revision: op.Revision, Start: &future}
+	r, ack, err := p.beginRadioParkedBridge(ctx, h, current, r, "play")
+	if err != nil {
+		p.unknownRadioParkedBridge(h)
+		return err
+	}
+	failed := true
+	defer func() {
+		if failed {
+			p.unknownRadioParkedBridge(h)
+		}
+	}()
+	if current.Kind == "parked" {
+		if ack.Phase != "consumed" {
+			return ErrAliasConflict
+		}
+		writer, binding, e := p.radioParkedBridgeWriter(ctx, h, current)
+		if e != nil {
+			return e
+		}
+		r.Phase = "barrier"
+		r.Writer = &writer
+		ack, err = p.radioParkedBridgeCall(ctx, h, r, current.Intent)
+		if err != nil || ack.Phase != "bound_start" || !ack.Barrier || ack.Writer == nil || *ack.Writer != writer {
+			return ErrAliasConflict
+		}
+		if _, err = p.player.CompleteRadioReacquire(ctx, binding, p.radioParkedBridgeGuard(ctx, h, current)); err != nil {
+			return err
+		}
+	} else if ack.Phase != "bound_start" {
+		return ErrAliasConflict
+	}
+	op.mu.Lock()
+	op.Target = contentTarget{Process: ack.Observation.Output.Process, DeviceID: ack.Observation.Output.DeviceID, Incarnation: ack.Observation.Output.Incarnation}
+	op.mu.Unlock()
+	app := p.app
+	app.radio.mu.Lock()
+	defer app.radio.mu.Unlock()
+	if app.radio.failed || app.radio.Holds[h.Request.TargetID] != h || app.radio.Intent != current.Intent {
+		return ErrAliasConflict
+	}
+	if current.global != nil {
+		current.global.WriterParked = false
+		current.global.PauseUncertain = false
+	}
+	h.Phase = "content_bound"
+	if err = app.persistRadioLocked(); err != nil {
+		return err
+	}
+	failed = false
+	return nil
+}
diff --git a/daemon/radio_parked_current.go b/daemon/radio_parked_current.go
new file mode 100644
index 0000000..34c92d3
--- /dev/null
+++ b/daemon/radio_parked_current.go
@@ -0,0 +1,123 @@
+package daemon
+
+import (
+	"context"
+	"strconv"
+
+	"github.com/devgianlu/go-librespot/output"
+	"github.com/devgianlu/go-librespot/player"
+)
+
+// This capture describes current source authority independently of the child
+// receiver's immutable historical source_hold. C must observe and bind it before
+// it can authorize any constructor, FIFO reopen or selected-content START.
+type radioParkedCurrentCapture struct {
+	Kind       string
+	Owner      *roomTransportIdentity
+	Writer     *queueWriterWire
+	SourceHold *radioCBinding
+	Absence    *radioAbsenceSource
+	Intent     uint64
+	primary    *player.Stream
+	global     *radioHold
+}
+
+func (p *AppPlayer) captureRadioParkedCurrent(ctx context.Context, allowAbsence bool) (*radioParkedCurrentCapture, error) {
+	if p == nil || p.app == nil || p.player == nil {
+		return nil, ErrAliasConflict
+	}
+	app := p.app
+	app.radio.mu.Lock()
+	if app.radio.failed {
+		app.radio.mu.Unlock()
+		return nil, ErrAliasConflict
+	}
+	capture := &radioParkedCurrentCapture{Intent: app.radio.Intent, primary: p.primaryStream}
+	app.radio.mu.Unlock()
+	actual, err := p.player.Start35CurrentSource(ctx)
+	if err != nil {
+		return nil, err
+	}
+	if p.primaryStream == nil || p.primaryStream.Source == nil {
+		if actual != nil {
+			return nil, ErrAliasConflict
+		}
+		if !allowAbsence {
+			return nil, ErrAliasConflict
+		}
+		absence, err := app.radioAbsenceSource()
+		if err != nil {
+			return nil, err
+		}
+		capture.Kind = "global_absence"
+		capture.Absence = &absence
+		return capture, nil
+	}
+	if actual != capture.primary.Source {
+		return nil, ErrAliasConflict
+	}
+	owner, err := p.radioSourceOwner()
+	if err != nil {
+		return nil, err
+	}
+	capture.Owner = &owner
+	status, err := p.player.InspectRadio(ctx)
+	if err != nil {
+		return nil, err
+	}
+	if !status.Suspended {
+		if status.WriterClosed {
+			return nil, ErrAliasConflict
+		}
+		writer, err := p.captureQueueWriter(ctx, owner, nil)
+		if err != nil {
+			return nil, err
+		}
+		capture.Kind = "live"
+		capture.Writer = &writer.Wire
+		return capture, nil
+	}
+	if !status.WriterClosed {
+		return nil, ErrAliasConflict
+	}
+	app.radio.mu.Lock()
+	defer app.radio.mu.Unlock()
+	if app.radio.failed || app.radio.Intent != capture.Intent {
+		return nil, ErrAliasConflict
+	}
+	for _, h := range app.radio.Holds {
+		if h.Parked != nil || h.Absence != nil || !h.WriterParked || h.PauseUncertain || h.owner != p || h.primary != capture.primary || h.Phase != "suspended" {
+			continue
+		}
+		generation, err := strconv.ParseUint(h.Request.Generation, 10, 64)
+		binding := output.RadioPipeBinding{Token: h.Proof.Token, Generation: generation, Writer: output.MovePipeIdentity{PipeIdentity: h.Proof.Writer.Pipe, FD: h.Proof.Writer.FD}}
+		if err != nil || !volumeHex32.MatchString(h.Proof.Token) || status.Binding != binding || capture.global != nil {
+			return nil, ErrAliasConflict
+		}
+		capture.global = h
+		snapshot := h.Proof
+		capture.SourceHold = &snapshot
+	}
+	if capture.global == nil {
+		return nil, ErrAliasConflict
+	}
+	capture.Kind = "parked"
+	return capture, nil
+}
+
+func (p *AppPlayer) radioParkedCurrentStill(ctx context.Context, c *radioParkedCurrentCapture) error {
+	if c == nil || p.primaryStream != c.primary {
+		return ErrAliasConflict
+	}
+	p.app.radio.mu.Lock()
+	valid := !p.app.radio.failed && p.app.radio.Intent == c.Intent
+	p.app.radio.mu.Unlock()
+	if !valid {
+		return ErrAliasConflict
+	}
+	fresh, err := p.captureRadioParkedCurrent(ctx, c.Kind == "global_absence")
+	if err != nil || fresh.primary != c.primary || fresh.global != c.global || contentDigest(fresh.wire()) != contentDigest(c.wire()) {
+		return ErrAliasConflict
+	}
+	return nil
+}
diff --git a/daemon/radio_parked_move.go b/daemon/radio_parked_move.go
new file mode 100644
index 0000000..7a6b70f
--- /dev/null
+++ b/daemon/radio_parked_move.go
@@ -0,0 +1,164 @@
+package daemon
+
+import (
+	"context"
+	"encoding/json"
+	"strconv"
+	"time"
+)
+
+// An explicit live-source Resume uses the real canonical MOVE pipeline. Its
+// opaque offer is minted from actual current source/receiver observation and
+// claimed under this already admitted user intent, without a second global
+// intent or a second renderer implementation.
+func (p *AppPlayer) resumeLiveParkedRadioViaMove(ctx context.Context, target, cause string, current *radioParkedCurrentCapture) error {
+	if current == nil || current.Kind != "live" || current.Owner == nil || current.Writer == nil {
+		return ErrAliasConflict
+	}
+	_, intended, err := p.radioOwnersForIntent(target)
+	if err != nil {
+		return err
+	}
+	scope := roomVolumeScope{current.Owner.AccountUserID, p.app.deviceId, target, intended.HomePodID}
+	capture, err := p.captureMove(scope)
+	if err != nil {
+		return err
+	}
+	expected := current.Writer
+	if capture.Radio == nil || !capture.Radio.Parked || capture.Primary != current.primary || capture.WriterFD != expected.FD || capture.WriterEpoch != expected.Epoch || capture.WriterPipe.PipeIdentity != expected.Pipe {
+		return ErrAliasConflict
+	}
+	state, err := capture.radioReadCState(ctx)
+	if err != nil {
+		return err
+	}
+	value, err := p.offerMove(moveOfferActorRequest{Capture: capture, State: state, Context: ctx})
+	if err != nil {
+		return err
+	}
+	op, ok := value.(*moveOperation)
+	if !ok || op == nil {
+		return ErrAliasConflict
+	}
+	request := movePrepareRequest{Scope: scope, Offer: op.Offer, Action: "move_existing_session"}
+	if _, err = p.claimMove(moveActorRequest{Operation: op, Request: request, Context: ctx}); err != nil {
+		return err
+	}
+	if op.Radio.ClaimIntent != current.Intent {
+		return ErrAliasConflict
+	}
+	op.inlineActor = true
+	op.radioExplicitCause = cause
+	op.prepare(ctx)
+	op.commit(ctx, nil)
+	op.mu.Lock()
+	complete := op.Terminal && op.State == "complete" && op.Actual != nil && *op.Actual == op.Intended && op.CReceipt != nil && op.CReceipt.Phase == "completed"
+	actual, pipe, epoch := op.Intended, op.Pipe, op.Epoch
+	op.mu.Unlock()
+	if !complete {
+		return ErrAliasConflict
+	}
+	if cause == "resume" && p.primaryStream == current.primary {
+		app := p.app
+		app.moveCustodyMu.Lock()
+		generation, owner, writer := app.openedWriterGeneration, app.openedWriterOwner, app.openedWriter
+		app.moveCustodyMu.Unlock()
+		process, valid := nativeContentProcess()
+		if !valid || generation == 0 || owner != p || writer != pipe {
+			return ErrAliasConflict
+		}
+		wire := queueWriterWire{process, pipe.FD, pipe.PipeIdentity, epoch, strconv.FormatUint(generation, 10), capture.PipeDigest}
+		p.radioResume = &radioResumeMarker{Live: !p.state.player.IsPaused, Primary: p.primaryStream, Source: p.primaryStream.Source, Player: p.player, Session: p.sess, Owner: actual, Writer: wire}
+	}
+	return nil
+}
+
+// The radio part is consume-only. The original MOVE capture/offer stays
+// immutable; canonical MOVE still owns retirement, construction and playback.
+func (p *AppPlayer) refreshRadioParkedMove(parent context.Context, call moveActorRequest) (any, error) {
+	op := call.Operation
+	if op == nil {
+		return nil, ErrAliasConflict
+	}
+	p.aliasMu.Lock()
+	op.mu.Lock()
+	valid := op.Owner == p && op.Radio != nil && op.Radio.Parked && op.Radio == op.Capture.Radio && op.Radio.HoldTarget == op.Capture.Scope.RoomID && op.CommitClaimed && op.Claimed && op.State == "committing" && !op.Cancelled && !op.Terminal && !op.RadioRefreshConsumed && time.Now().Before(op.StagedUntil) && time.Now().Before(op.RadioCommitDeadline) && p.moveCurrentLocked(op.Capture)
+	if !valid {
+		op.mu.Unlock()
+		p.aliasMu.Unlock()
+		return nil, ErrAliasConflict
+	}
+	future := op.cPrepareRequest()
+	op.mu.Unlock()
+	p.aliasMu.Unlock()
+	ctx, cancel := context.WithDeadline(parent, op.RadioCommitDeadline)
+	defer cancel()
+	app := p.app
+	app.radio.mu.Lock()
+	h := app.radio.Holds[op.Radio.HoldTarget]
+	valid = !app.radio.failed && h == op.Radio.hold && h != nil && h.Parked != nil && h.Phase == "suspended" && app.radio.Intent == op.Radio.ClaimIntent
+	app.radio.mu.Unlock()
+	if !valid {
+		return nil, ErrAliasConflict
+	}
+	current, err := p.captureRadioParkedCurrent(ctx, false)
+	if err != nil || current.Kind != "live" || current.Intent != op.Radio.ClaimIntent || current.primary != op.Capture.Primary {
+		return nil, ErrAliasConflict
+	}
+	op.mu.Lock()
+	op.RadioRefreshConsumed = true
+	op.RadioPossible = true
+	op.mu.Unlock()
+	r := radioParkedBridgeRequest{Revision: op.Revision, Move: &future}
+	cause := "transfer"
+	if op.inlineActor && (op.radioExplicitCause == "resume" || op.radioExplicitCause == "transfer") {
+		cause = op.radioExplicitCause
+	}
+	_, bound, err := p.beginRadioParkedBridge(ctx, h, current, r, cause)
+	if err != nil {
+		p.unknownRadioParkedBridge(h)
+		return nil, err
+	}
+	failed := true
+	defer func() {
+		if failed {
+			p.unknownRadioParkedBridge(h)
+		}
+	}()
+	if bound.Phase != "bound_move" || bound.ExecutionVolume == nil || *bound.ExecutionVolume < 0 || *bound.ExecutionVolume > 100 {
+		return nil, ErrAliasConflict
+	}
+	app.radio.mu.Lock()
+	var ticket radioDrainTicket
+	err = json.Unmarshal(h.SenderDrain, &ticket)
+	app.radio.mu.Unlock()
+	if err != nil || !ticket.valid(bound.Challenge) || ticket.VolumeKind == "receiver_acknowledged" && *bound.ExecutionVolume != *ticket.VolumePercent {
+		return nil, ErrAliasConflict
+	}
+	p.aliasMu.Lock()
+	op.mu.Lock()
+	volume := *bound.ExecutionVolume
+	op.RadioExecutionVolume = &volume
+	oldStage := op.Capture.Radio
+	op.Capture.Radio = nil
+	valid = ctx.Err() == nil && !op.Cancelled && !op.Terminal && p.moveCurrentLocked(op.Capture)
+	if !valid {
+		op.Capture.Radio = oldStage
+	}
+	op.mu.Unlock()
+	p.aliasMu.Unlock()
+	if !valid {
+		return nil, ErrAliasConflict
+	}
+	app.radio.mu.Lock()
+	defer app.radio.mu.Unlock()
+	if app.radio.Holds[h.Request.TargetID] != h || app.radio.Intent != current.Intent {
+		return nil, ErrAliasConflict
+	}
+	h.Phase = "move_bound"
+	if err = app.persistRadioLocked(); err != nil {
+		return nil, err
+	}
+	failed = false
+	return op, nil
+}
diff --git a/daemon/radio_parked_registry_test.go b/daemon/radio_parked_registry_test.go
new file mode 100644
index 0000000..b3c02e1
--- /dev/null
+++ b/daemon/radio_parked_registry_test.go
@@ -0,0 +1,131 @@
+package daemon
+
+import (
+	"encoding/json"
+	"strconv"
+	"strings"
+	"testing"
+)
+
+// This journal fixture proves custody classification and immutable linkage only.
+// It is not evidence of C acceptance, sender drain or physical playback.
+func TestRadioParkedChildRemainsTargetOnlyAfterParentRetiresAndRestart(t *testing.T) {
+	app := radioTestApp(t)
+	r := radioRequest{Schema: "podconnect.native_radio_handoff.v1", ProcessID: strings.Repeat("a", 64), TargetID: "kontor", HandoffID: "00000000-0000-0000-0000-000000000011", Generation: "8", ExpectedRevision: "0", ActionID: "00000000-0000-0000-0000-000000000012", Peer: radioPeer{"00000000-0000-0000-0000-000000000013", "4", strings.Repeat("b", 64)}}
+	parent := radioCBinding{Schema: "podconnect.output_radio_handoff.v1", HandoffID: "00000000-0000-0000-0000-000000000001", Generation: "7", Token: strings.Repeat("c", 32)}
+	h := &radioHold{Request: r, Phase: "suspended", Actions: map[string]bool{}, Parked: &radioParkedHold{Binding: radioParkedBinding{SourceHold: parent, Token: strings.Repeat("d", 32)}}}
+	app.radio.Holds[r.TargetID] = h // The original source hold has already retired.
+	for _, phase := range []string{"prepared", "suspended", "unknown"} {
+		h.Phase = phase
+		if radioGlobalCustodyRequired(h) {
+			t.Fatalf("child acquired global custody in %s", phase)
+		}
+	}
+	h.Phase = "suspended"
+	app.refreshRadioOutputFenceLocked()
+	if app.radioOutputFence.Load() || app.radioAbsenceFence.Load() {
+		t.Fatal("receiver-only child fenced global output")
+	}
+	p := &AppPlayer{app: app}
+	if !p.radioMutationAllowed("stue") || p.radioMutationAllowed("kontor") {
+		t.Fatal("child admission escaped its physical target")
+	}
+	before, _ := json.Marshal(h.Parked.Binding.SourceHold)
+	if err := app.persistRadioLocked(); err != nil {
+		t.Fatal(err)
+	}
+	restart := &App{cfg: app.cfg}
+	if err := restart.initRadio(); err != nil {
+		t.Fatal(err)
+	}
+	child := restart.radio.Holds[r.TargetID]
+	if child == nil || child.Parked == nil || child.Phase != "unknown" || radioGlobalCustodyRequired(child) || restart.radioOutputFence.Load() || restart.radioAbsenceFence.Load() {
+		t.Fatal("restart converted child to global custody or required retired parent")
+	}
+	after, _ := json.Marshal(child.Parked.Binding.SourceHold)
+	if string(before) != string(after) {
+		t.Fatal("immutable source hold linkage changed after retirement/restart")
+	}
+}
+
+func TestRadioParkedJournalRejectsMixedGlobalCustody(t *testing.T) {
+	for _, mixed := range []string{"absence", "writer", "pause", "requires_pause"} {
+		t.Run(mixed, func(t *testing.T) {
+			app := radioTestApp(t)
+			r := radioRequest{Schema: "podconnect.native_radio_handoff.v1", ProcessID: strings.Repeat("a", 64), TargetID: "stue", HandoffID: "00000000-0000-0000-0000-000000000001", Generation: "7", ExpectedRevision: "0", ActionID: "00000000-0000-0000-0000-000000000002", Peer: radioPeer{"00000000-0000-0000-0000-000000000003", "4", strings.Repeat("b", 64)}}
+			h := &radioHold{Request: r, Actions: map[string]bool{}, Parked: &radioParkedHold{}}
+			switch mixed {
+			case "absence":
+				h.Absence = &radioAbsenceHold{}
+			case "writer":
+				h.WriterParked = true
+			case "pause":
+				h.PauseUncertain = true
+			case "requires_pause":
+				h.RequiresPause = true
+			}
+			app.radio.Holds[r.TargetID] = h
+			if err := app.persistRadioLocked(); err != nil {
+				t.Fatal(err)
+			}
+			if err := (&App{cfg: app.cfg}).initRadio(); err == nil {
+				t.Fatal("accepted contradictory parked child authority")
+			}
+		})
+	}
+}
+
+// Numeric allocation is not custody proof; the external two-C Move test must
+// still accept the immutable parent and actual parked source independently.
+func TestRadioParkedRevisionJoinsExistingNativeAndRadioIntents(t *testing.T) {
+	for _, tc := range []struct {
+		name          string
+		radio, native uint64
+		source        string
+		want          uint64
+	}{
+		{"actual first Move regression", 0, 2, "2", 3},
+		{"stale source floor", 7, 2, "1", 8},
+		{"newer source floor", 1, 2, "11", 12},
+		{"newer Native command", 3, 12, "2", 13},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			app := radioTestApp(t)
+			app.radio.Intent = tc.radio
+			p := &AppPlayer{app: app, roomNativeIntent: tc.native}
+			app.radio.mu.Lock()
+			got, err := p.nextRadioParkedRevisionLocked(tc.source)
+			app.radio.mu.Unlock()
+			if err != nil || got != strconv.FormatUint(tc.want, 10) || app.radio.Intent != tc.want || p.roomNativeIntent != tc.want {
+				t.Fatalf("revision counters diverged: %q %v radio%d native%d", got, err, app.radio.Intent, p.roomNativeIntent)
+			}
+			// A later ordinary source command cannot reuse the child revision.
+			next, err := p.nextNativeIntent()
+			if err != nil || next != strconv.FormatUint(tc.want+1, 10) {
+				t.Fatalf("later source intent reused child revision: %q %v", next, err)
+			}
+		})
+	}
+}
+func TestRadioParkedRevisionInvalidOrExhaustedLeavesBothCountersUntouched(t *testing.T) {
+	for _, tc := range []struct {
+		source        string
+		radio, native uint64
+	}{
+		{"", 3, 4}, {"0", 3, 4}, {"02", 3, 4}, {"-1", 3, 4}, {"18446744073709551616", 3, 4},
+		{"18446744073709551615", 3, 4}, {"18446744073709551614", 3, 4},
+		{"2", ^uint64(0), 4}, {"2", 3, ^uint64(0)}, {"2", ^uint64(0) - 1, 4}, {"2", 3, ^uint64(0) - 1},
+	} {
+		t.Run(tc.source+"/"+strconv.FormatUint(tc.radio, 10)+"/"+strconv.FormatUint(tc.native, 10), func(t *testing.T) {
+			app := radioTestApp(t)
+			app.radio.Intent = tc.radio
+			p := &AppPlayer{app: app, roomNativeIntent: tc.native}
+			app.radio.mu.Lock()
+			_, err := p.nextRadioParkedRevisionLocked(tc.source)
+			app.radio.mu.Unlock()
+			if err == nil || app.radio.Intent != tc.radio || p.roomNativeIntent != tc.native {
+				t.Fatal("invalid revision changed intent counters")
+			}
+		})
+	}
+}
diff --git a/daemon/radio_parked_resume.go b/daemon/radio_parked_resume.go
new file mode 100644
index 0000000..330c469
--- /dev/null
+++ b/daemon/radio_parked_resume.go
@@ -0,0 +1,128 @@
+package daemon
+
+import (
+	"context"
+	"strconv"
+	"time"
+)
+
+// Resume attaches only this child's physical destination to the actual current
+// source. An unrelated live renderer is never paused, sought or restarted.
+func (p *AppPlayer) preemptParkedRadio(parent context.Context, target, cause string) error {
+	if cause != "resume" && cause != "transfer" {
+		return ErrAliasConflict
+	}
+	ctx, cancel := context.WithTimeout(parent, 8*time.Second)
+	defer cancel()
+	app := p.app
+	app.radio.mu.Lock()
+	h := app.radio.Holds[target]
+	if app.radio.failed || h == nil || h.Parked == nil || h.Phase != "suspended" {
+		app.radio.mu.Unlock()
+		return ErrAliasConflict
+	}
+	app.radio.mu.Unlock()
+	current, err := p.captureRadioParkedCurrent(ctx, false)
+	if err != nil {
+		return err
+	}
+	if current.Kind == "live" {
+		return p.resumeLiveParkedRadioViaMove(ctx, target, cause, current)
+	}
+	owner, intended, err := p.radioOwnersForIntent(target)
+	if err != nil || current.Owner == nil || owner != *current.Owner {
+		return ErrAliasConflict
+	}
+	revision, err := p.nextNativeIntent()
+	if err != nil {
+		return err
+	}
+	request := radioParkedBridgeRequest{Revision: revision, Resume: &radioParkedResumeFuture{intended}}
+	request, ack, err := p.beginRadioParkedBridge(ctx, h, current, request, cause)
+	if err != nil {
+		p.unknownRadioParkedBridge(h)
+		return err
+	}
+	failed := true
+	defer func() {
+		if failed {
+			p.unknownRadioParkedBridge(h)
+		}
+	}()
+	if _, err = p.radioParkedWaitRoute(ctx, h, current, request, ack); err != nil {
+		return err
+	}
+	writer, binding, err := p.radioParkedBridgeWriter(ctx, h, current)
+	if err != nil {
+		return err
+	}
+	request.Phase = "barrier"
+	request.Writer = &writer
+	barrier, err := p.radioParkedBridgeCall(ctx, h, request, current.Intent)
+	if err != nil || barrier.Phase != "barrier_ready" || !barrier.Barrier || barrier.Writer == nil || *barrier.Writer != writer {
+		return ErrAliasConflict
+	}
+	request.Phase = "open"
+	opened, err := p.radioParkedBridgeCall(ctx, h, request, current.Intent)
+	if err != nil || opened.Phase != "opened" || !opened.Barrier || opened.Writer == nil || *opened.Writer != writer || opened.Route == nil || !opened.Route.valid() || opened.Route.DeviceID != intended.HomePodID || opened.CurrentVolume == nil || opened.CurrentBase == nil || !volumeCounter(*opened.CurrentBase) || *opened.CurrentBase == "0" {
+		return ErrAliasConflict
+	}
+	if current.Kind == "parked" {
+		if _, err = p.player.CompleteRadioReacquire(ctx, binding, p.radioParkedBridgeGuard(ctx, h, current)); err != nil {
+			return err
+		}
+	}
+	if err = p.adoptRadioIntendedOwner(owner, intended); err != nil {
+		return err
+	}
+	if err = p.adoptRadioVolume(*opened.CurrentVolume); err != nil {
+		return err
+	}
+	proof, err := p.captureRadioParkedWriter(ctx, request, opened, writer, intended)
+	if err != nil {
+		return err
+	}
+	if cause == "resume" && p.primaryStream != nil {
+		p.radioResume = &radioResumeMarker{Live: current.Kind == "live" && !p.state.player.IsPaused, Primary: p.primaryStream, Source: p.primaryStream.Source, Player: p.player, Session: p.sess, Owner: intended, Writer: writer}
+	}
+	app.radio.mu.Lock()
+	defer app.radio.mu.Unlock()
+	if app.radio.Holds[target] != h || app.radio.Intent != current.Intent {
+		return ErrAliasConflict
+	}
+	if current.global != nil {
+		current.global.WriterParked = false
+		current.global.PauseUncertain = false
+	}
+	if err = app.retireRadioLocked(h, opened); err != nil {
+		return err
+	}
+	app.moveCustodyMu.Lock()
+	app.radioParkedWriter = proof
+	app.radioReacquiredWriter, app.radioOtherWriter = nil, nil
+	app.moveCustodyMu.Unlock()
+	app.refreshRadioOutputFenceLocked()
+	failed = false
+	return nil
+}
+
+func (p *AppPlayer) unknownRadioParkedBridge(h *radioHold) {
+	app := p.app
+	app.radio.mu.Lock()
+	defer app.radio.mu.Unlock()
+	if app.radio.Holds[h.Request.TargetID] == h {
+		h.Phase = "unknown"
+		h.ParkedBridgePhase = "unknown"
+		_ = app.persistRadioLocked()
+	}
+}
+
+// Reconstruct only the actual registered writer identity; no historical child
+// source or parent FD is asserted live by this receipt.
+func radioParkedWriterGeneration(writer queueWriterWire) (uint64, error) {
+	generation, err := strconv.ParseUint(writer.Generation, 10, 64)
+	if err != nil || generation == 0 {
+		return 0, ErrAliasConflict
+	}
+	return generation, nil
+}
diff --git a/daemon/radio_parked_transition.go b/daemon/radio_parked_transition.go
new file mode 100644
index 0000000..5e17397
--- /dev/null
+++ b/daemon/radio_parked_transition.go
@@ -0,0 +1,166 @@
+package daemon
+
+import (
+	"context"
+	"encoding/json"
+	"strconv"
+	"time"
+
+	"github.com/devgianlu/go-librespot/output"
+)
+
+func radioBridgeIntentID() (string, error) {
+	id, err := randomQueueID(16)
+	if err != nil {
+		return "", err
+	}
+	return id[:8] + "-" + id[8:12] + "-" + id[12:16] + "-" + id[16:20] + "-" + id[20:], nil
+}
+
+// Drain the child sender under its own signed custody. The captured current
+// source is independent, and is checked again after the external drain join.
+func (p *AppPlayer) beginRadioParkedBridge(ctx context.Context, h *radioHold, current *radioParkedCurrentCapture, r radioParkedBridgeRequest, cause string) (radioParkedBridgeRequest, radioParkedBridgeReply, error) {
+	var ack radioParkedBridgeReply
+	app := p.app
+	if current == nil {
+		return r, ack, ErrAliasConflict
+	}
+	observed, err := p.radioObserveParkedBridge(ctx, h, current)
+	if err != nil {
+		return r, ack, err
+	}
+	r.Schema = "podconnect.output_radio_parked_bridge.v1"
+	r.Phase = "challenge"
+	r.Hold = h.Parked.Binding
+	r.Current = current.wire()
+	r.Observation = observed.Observation
+	r.IntentID, err = radioBridgeIntentID()
+	if err != nil {
+		return r, ack, err
+	}
+	app.radio.mu.Lock()
+	if app.radio.failed || app.radio.Holds[h.Request.TargetID] != h || h.Phase != "suspended" || app.radio.Intent != current.Intent {
+		app.radio.mu.Unlock()
+		return r, ack, ErrAliasConflict
+	}
+	if r.Start != nil {
+		h.Phase = "content_reacquiring"
+	} else if r.Move != nil {
+		h.Phase = "move_binding"
+	} else {
+		h.Phase = "reacquiring"
+	}
+	err = app.persistRadioLocked()
+	app.radio.mu.Unlock()
+	if err != nil {
+		return r, ack, err
+	}
+	ack, err = p.radioParkedBridgeCall(ctx, h, r, current.Intent)
+	if err != nil || ack.Phase != "challenge" {
+		return r, ack, ErrAliasConflict
+	}
+	r.Challenge = ack.Challenge
+	ticket, raw, err := p.radioParkedBridgeDrain(ctx, h, r, ack.Challenge, ack.ChallengeSignature, cause)
+	if err != nil {
+		return r, ack, err
+	}
+	if err = p.radioParkedCurrentStill(ctx, current); err != nil {
+		return r, ack, err
+	}
+	r.Phase = "commit"
+	r.DrainGeneration, r.DrainSignature = ticket.Generation, ticket.Signature
+	r.VolumeKind, r.VolumePercent, r.VolumeRevision = ticket.VolumeKind, ticket.VolumePercent, ticket.VolumeRevision
+	app.radio.mu.Lock()
+	if app.radio.Holds[h.Request.TargetID] != h || app.radio.Intent != current.Intent {
+		app.radio.mu.Unlock()
+		return r, ack, ErrAliasConflict
+	}
+	h.SenderDrain = append(json.RawMessage(nil), raw...)
+	err = app.persistRadioLocked()
+	app.radio.mu.Unlock()
+	if err != nil {
+		return r, ack, err
+	}
+	ack, err = p.radioParkedBridgeCall(ctx, h, r, current.Intent)
+	return r, ack, err
+}
+
+func (p *AppPlayer) radioParkedBridgeGuard(ctx context.Context, h *radioHold, c *radioParkedCurrentCapture) func() error {
+	return func() error {
+		if ctx.Err() != nil {
+			return ctx.Err()
+		}
+		app := p.app
+		app.radio.mu.Lock()
+		defer app.radio.mu.Unlock()
+		if app.radio.failed || app.radio.Holds[h.Request.TargetID] != h || app.radio.Intent != c.Intent || p.primaryStream != c.primary || h.ParkedBridge == nil || h.ParkedBridgePhase == "unknown" {
+			return ErrAliasConflict
+		}
+		if c.global != nil && (app.radio.Holds[c.global.Request.TargetID] != c.global || c.global.owner != p || c.global.primary != c.primary || c.SourceHold == nil || c.global.Proof != *c.SourceHold || !c.global.WriterParked) {
+			return ErrAliasConflict
+		}
+		return nil
+	}
+}
+
+func (p *AppPlayer) radioParkedBridgeWriter(ctx context.Context, h *radioHold, c *radioParkedCurrentCapture) (queueWriterWire, output.RadioPipeBinding, error) {
+	var out queueWriterWire
+	var binding output.RadioPipeBinding
+	if c.Kind == "live" {
+		if c.Writer == nil {
+			return out, binding, ErrAliasConflict
+		}
+		return *c.Writer, binding, nil
+	}
+	if c.Kind != "parked" || c.global == nil || c.SourceHold == nil {
+		return out, binding, ErrAliasConflict
+	}
+	gen, err := strconv.ParseUint(c.global.Request.Generation, 10, 64)
+	if err != nil {
+		return out, binding, err
+	}
+	old := c.SourceHold.Writer
+	binding = output.RadioPipeBinding{Token: c.SourceHold.Token, Generation: gen, Writer: output.MovePipeIdentity{PipeIdentity: old.Pipe, FD: old.FD}}
+	_, err = p.player.ReacquireRadio(ctx, binding, p.radioParkedBridgeGuard(ctx, h, c), func(create func() (output.Output, error)) (output.Output, error) {
+		app := p.app
+		app.moveCustodyMu.Lock()
+		defer app.moveCustodyMu.Unlock()
+		if app.openedWriterOwner != p {
+			return nil, ErrAliasConflict
+		}
+		return app.openRegisteredOutputLocked(p, create)
+	})
+	if err != nil {
+		return out, binding, err
+	}
+	app := p.app
+	app.moveCustodyMu.Lock()
+	writer, generation, owner := app.openedWriter, app.openedWriterGeneration, app.openedWriterOwner
+	app.moveCustodyMu.Unlock()
+	process, valid := nativeContentProcess()
+	if !valid || owner != p || generation == 0 || writer.Type != "fifo" {
+		return out, binding, ErrAliasConflict
+	}
+	out = queueWriterWire{process, writer.FD, writer.PipeIdentity, old.Epoch, strconv.FormatUint(generation, 10), old.InputDigest}
+	return out, binding, nil
+}
+
+func (p *AppPlayer) radioParkedWaitRoute(ctx context.Context, h *radioHold, c *radioParkedCurrentCapture, r radioParkedBridgeRequest, ack radioParkedBridgeReply) (radioParkedBridgeReply, error) {
+	for ack.Phase != "route_ready" {
+		if ack.Phase != "consumed" && ack.Phase != "connecting" {
+			return ack, ErrAliasConflict
+		}
+		select {
+		case <-ctx.Done():
+			return ack, ctx.Err()
+		case <-time.After(50 * time.Millisecond):
+		}
+		r.Phase = "state"
+		var err error
+		ack, err = p.radioParkedBridgeCall(ctx, h, r, c.Intent)
+		if err != nil {
+			return ack, err
+		}
+	}
+	return ack, nil
+}
diff --git a/daemon/radio_parked_writer.go b/daemon/radio_parked_writer.go
new file mode 100644
index 0000000..b87decd
--- /dev/null
+++ b/daemon/radio_parked_writer.go
@@ -0,0 +1,95 @@
+package daemon
+
+import (
+	"context"
+
+	"github.com/devgianlu/go-librespot/output"
+	"github.com/devgianlu/go-librespot/player"
+	"github.com/devgianlu/go-librespot/session"
+)
+
+// Authority is published only after actual C OPENED and the durable Native
+// terminal receipt. This is not an ordinary START, MOVE or other-target receipt.
+type radioParkedWriter struct {
+	Owner      *AppPlayer
+	Player     *player.Player
+	Session    *session.Session
+	Primary    *player.Stream
+	Identity   roomTransportIdentity
+	Wire       queueWriterWire
+	Writer     output.MovePipeIdentity
+	Process    contentProcess
+	Generation uint64
+	Receipt    radioParkedBridgeReply
+	StartAt    *contentOperation
+	MoveAt     *moveOperation
+}
+
+func (p *AppPlayer) captureRadioParkedWriter(ctx context.Context, r radioParkedBridgeRequest, ack radioParkedBridgeReply, writer queueWriterWire, intended roomTransportIdentity) (*radioParkedWriter, error) {
+	if ack.Phase != "opened" || !ack.Barrier || ack.Writer == nil || *ack.Writer != writer || r.Resume == nil || r.Resume.Intended != intended || p.primaryStream == nil || p.primaryStream.Source == nil || p.state == nil || p.state.player == nil {
+		return nil, ErrAliasConflict
+	}
+	generation, err := radioParkedWriterGeneration(writer)
+	if err != nil {
+		return nil, err
+	}
+	actual := output.MovePipeIdentity{PipeIdentity: writer.Pipe, FD: writer.FD}
+	primary, paused := p.primaryStream, p.state.player.IsPaused
+	_, _, err = p.player.RoomMove(ctx, "verify", primary.Source, actual, writer.Epoch, !paused, func(mutate func()) error {
+		if ctx.Err() != nil || p.primaryStream != primary || p.state.player.IsPaused != paused {
+			return ErrAliasConflict
+		}
+		app := p.app
+		app.moveCustodyMu.Lock()
+		defer app.moveCustodyMu.Unlock()
+		if app.openedWriterOwner != p || app.openedWriter != actual || app.openedWriterGeneration != generation {
+			return ErrAliasConflict
+		}
+		mutate()
+		return nil
+	})
+	if err != nil {
+		return nil, err
+	}
+	app := p.app
+	app.moveCustodyMu.Lock()
+	defer app.moveCustodyMu.Unlock()
+	process, valid := nativeContentProcess()
+	if !valid || process != writer.Process || app.openedWriterOwner != p || app.openedWriter != actual || app.openedWriterGeneration != generation {
+		return nil, ErrAliasConflict
+	}
+	return &radioParkedWriter{p, p.player, p.sess, primary, intended, writer, actual, process, generation, ack, app.startCustody, app.moveCustody}, nil
+}
+
+func (app *App) completedRadioParkedWriterCurrentLocked(owner *AppPlayer, identity roomTransportIdentity) (*completedWriter, bool, error) {
+	proof := app.radioParkedWriter
+	if proof == nil {
+		return nil, false, nil
+	}
+	// Real newer canonical custody supersedes the bridge; its receipt is checked
+	// by the ordinary completed-writer path instead of rewriting this proof.
+	if op := app.startCustody; op != nil && op != proof.StartAt {
+		op.mu.Lock()
+		newer := op.Owner == owner && op.Terminal && op.State == "complete" && op.Actual != nil && sameCompletedRoom(*op.Actual, identity) && op.CReceipt != nil && op.CReceipt.Phase == "completed"
+		op.mu.Unlock()
+		if newer {
+			return nil, false, nil
+		}
+	}
+	if op := app.moveCustody; op != nil && op != proof.MoveAt {
+		op.mu.Lock()
+		newer := op.Owner == owner && op.Terminal && op.State == "complete" && op.Actual != nil && sameCompletedRoom(*op.Actual, identity) && op.CReceipt != nil && op.CReceipt.Phase == "completed"
+		op.mu.Unlock()
+		if newer {
+			return nil, false, nil
+		}
+	}
+	if app.startCustody != proof.StartAt || app.moveCustody != proof.MoveAt {
+		return nil, true, ErrAliasConflict
+	}
+	process, valid := nativeContentProcess()
+	if !valid || process != proof.Process || owner == nil || proof.Owner != owner || proof.Player != owner.player || proof.Session != owner.sess || proof.Primary != owner.primaryStream || !sameCompletedRoom(proof.Identity, identity) || app.openedWriterOwner != owner || app.openedWriter != proof.Writer || app.openedWriterGeneration != proof.Generation || proof.Receipt.Phase != "opened" || !proof.Receipt.Barrier {
+		return nil, true, ErrAliasConflict
+	}
+	return &completedWriter{parked: proof, custodyStart: proof.StartAt, custodyMove: proof.MoveAt, writer: proof.Writer, epoch: proof.Wire.Epoch}, true, nil
+}
diff --git a/daemon/radio_playback_intent.go b/daemon/radio_playback_intent.go
new file mode 100644
index 0000000..eaf372a
--- /dev/null
+++ b/daemon/radio_playback_intent.go
@@ -0,0 +1,52 @@
+package daemon
+
+import (
+	"context"
+	"strconv"
+
+	"github.com/devgianlu/go-librespot/output"
+)
+
+// The caller has already advanced the explicit user intent epoch, including an
+// equal-value Pause. Record the choice only for the exact retained source.
+func (p *AppPlayer) radioRetainedPause(ctx context.Context, target string) (bool, error) {
+	app := p.app
+	app.radio.mu.Lock()
+	var h *radioHold
+	for _, hold := range app.radio.Holds {
+		if hold.owner == p && hold.WriterParked && hold.Proof.Owner.RoomID == target {
+			if h != nil {
+				app.radio.mu.Unlock()
+				return true, ErrAliasConflict
+			}
+			h = hold
+		}
+	}
+	if h == nil {
+		app.radio.mu.Unlock()
+		return false, nil
+	}
+	valid := h.primary != nil && p.primaryStream == h.primary && h.PausedBefore != nil && p.state != nil && p.state.player != nil && p.state.player.IsPaused && h.Phase == "suspended"
+	app.radio.mu.Unlock()
+	if !valid {
+		return true, ErrAliasConflict
+	}
+	source, err := p.player.Start35CurrentSource(ctx)
+	if err != nil || source != h.primary.Source {
+		return true, ErrAliasConflict
+	}
+	state, err := p.player.InspectRadio(ctx)
+	generation, _ := strconv.ParseUint(h.Proof.Generation, 10, 64)
+	binding := output.RadioPipeBinding{Token: h.Proof.Token, Generation: generation, Writer: output.MovePipeIdentity{PipeIdentity: h.Proof.Writer.Pipe, FD: h.Proof.Writer.FD}}
+	if err != nil || !state.Suspended || !state.WriterClosed || state.Binding != binding {
+		return true, ErrAliasConflict
+	}
+	app.radio.mu.Lock()
+	defer app.radio.mu.Unlock()
+	if app.radio.Holds[h.Request.TargetID] != h || !h.WriterParked || h.primary != p.primaryStream || h.Phase != "suspended" {
+		return true, ErrAliasConflict
+	}
+	paused := true
+	h.PausedBefore = &paused
+	return true, app.persistRadioLocked()
+}
diff --git a/daemon/radio_playback_intent_test.go b/daemon/radio_playback_intent_test.go
new file mode 100644
index 0000000..2caf816
--- /dev/null
+++ b/daemon/radio_playback_intent_test.go
@@ -0,0 +1,172 @@
+package daemon
+
+import (
+	"context"
+	"os"
+	"path/filepath"
+	"strconv"
+	"strings"
+	"syscall"
+	"testing"
+	"time"
+
+	librespot "github.com/devgianlu/go-librespot"
+	"github.com/devgianlu/go-librespot/mpris"
+	"github.com/devgianlu/go-librespot/output"
+	"github.com/devgianlu/go-librespot/player"
+)
+
+// A real local worker/FIFO proves equal-value Pause custody, not receiver audio.
+func TestRadioEqualValueUserPauseRetainsNewAuthorityOnRealParkedFIFO(t *testing.T) {
+	p, seed := contentFixture(t)
+	path := filepath.Join(t.TempDir(), "retained.fifo")
+	if err := syscall.Mkfifo(path, 0600); err != nil {
+		t.Fatal(err)
+	}
+	reader, err := os.OpenFile(path, os.O_RDWR|syscall.O_NONBLOCK, 0600)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer reader.Close()
+	p.app.cfg.RadioHandoffControlToken = strings.Repeat("f", 32)
+	p.app.cfg.RadioHandoffOwnerURL = "http://127.0.0.1:8080"
+	p.app.cfg.RadioHandoffStatePath = filepath.Join(t.TempDir(), "radio.json")
+	p.app.cfg.AudioOutputPipe = path
+	if err = p.app.initRadio(); err != nil {
+		t.Fatal(err)
+	}
+	p.volumeUpdate = make(chan float32, 1)
+	worker, err := player.NewPlayer(&player.Options{Log: &librespot.NullLogger{}, AudioBackend: "pipe", AudioOutputPipe: path, AudioOutputPipeFormat: "s16le", ExternalVolume: true, VolumeUpdate: p.volumeUpdate, WithNewOutput: func(create func() (output.Output, error)) (output.Output, error) {
+		p.app.moveCustodyMu.Lock()
+		defer p.app.moveCustodyMu.Unlock()
+		return p.app.openRegisteredOutputLocked(p, create)
+	}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer worker.Close()
+	source := &contentInertSource{}
+	if err = worker.SetPrimaryStream(source, false, false); err != nil {
+		t.Fatal(err)
+	}
+	p.player = worker
+	p.primaryStream = &player.Stream{Source: source}
+	p.state.player.IsPaused = false
+	p.state.player.IsPlaying = true
+	p.state.active = true
+	ctx, cancel := context.WithTimeout(context.Background(), 2*time.Second)
+	defer cancel()
+	writer, epoch, err := worker.RoomMove(ctx, "snapshot", source, output.MovePipeIdentity{}, "", true, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	binding := output.RadioPipeBinding{Token: strings.Repeat("e", 32), Generation: 7, Writer: writer}
+	guard := func() error {
+		p.app.moveCustodyMu.Lock()
+		defer p.app.moveCustodyMu.Unlock()
+		if p.app.openedWriterOwner != p || p.app.openedWriter != writer {
+			return ErrAliasConflict
+		}
+		return nil
+	}
+	if _, err = worker.PauseRadio(ctx, binding, guard); err != nil {
+		t.Fatal(err)
+	}
+	if _, err = worker.SuspendRadio(ctx, binding, guard); err != nil {
+		t.Fatal(err)
+	}
+	p.state.setPaused(true)
+	process, valid := nativeContentProcess()
+	if !valid {
+		t.Fatal("actual process unavailable")
+	}
+	pausedBefore := false
+	owner := *seed.Capture.OldOwner
+	r := radioRequest{Schema: "podconnect.native_radio_handoff.v1", ProcessID: radioProcessID(process), TargetID: owner.RoomID, HandoffID: "00000000-0000-0000-0000-000000000001", Generation: "7", ExpectedRevision: "0", ActionID: "00000000-0000-0000-0000-000000000002", Peer: radioPeer{"00000000-0000-0000-0000-000000000003", "4", strings.Repeat("b", 64)}}
+	h := &radioHold{Request: r, owner: p, primary: p.primaryStream, Phase: "suspended", WriterParked: true, RequiresPause: true, PausedBefore: &pausedBefore, Actions: map[string]bool{}, Proof: radioCBinding{Owner: owner, Token: binding.Token, Generation: "7", Writer: queueWriterWire{Process: process, FD: writer.FD, Pipe: writer.PipeIdentity, Epoch: epoch, Generation: strconv.FormatUint(p.app.openedWriterGeneration, 10), InputDigest: contentDigestBytes(path)}}}
+	p.app.radio.Holds[r.TargetID] = h
+	// The locally admitted fixture is not an authenticated provider session.
+	// Production current-source capture must not reinterpret it as one.
+	if _, e := p.captureRadioParkedCurrent(ctx, false); e == nil {
+		t.Fatal("unbound provider fixture acquired production current-source authority")
+	}
+	// Independently exercise the scoped late writer guard using real parked
+	// worker custody. The request below is a guard fixture, not a C receipt.
+	child := &radioHold{Request: radioRequest{TargetID: "child"}, Parked: &radioParkedHold{Binding: radioParkedBinding{SourceHold: radioCBinding{Token: strings.Repeat("9", 32)}}}, ParkedBridge: &radioParkedBridgeRequest{}}
+	p.app.radio.Holds["child"] = child
+	snapshot := h.Proof
+	current := &radioParkedCurrentCapture{Kind: "parked", Owner: &owner, SourceHold: &snapshot, Intent: p.app.radio.Intent, primary: p.primaryStream, global: h}
+	guardCurrent := p.radioParkedBridgeGuard(ctx, child, current)
+	if guardCurrent() != nil {
+		t.Fatal("exact scoped current writer was rejected")
+	}
+	oldProof := h.Proof
+	h.Proof.Token = strings.Repeat("8", 32)
+	if guardCurrent() == nil {
+		t.Fatal("changed current writer custody passed bridge guard")
+	}
+	h.Proof = oldProof
+	originalPrimary := p.primaryStream
+	p.primaryStream = &player.Stream{Source: source}
+	if guardCurrent() == nil {
+		t.Fatal("replacement current source passed bridge guard")
+	}
+	p.primaryStream = originalPrimary
+	p.app.radio.Intent++
+	if guardCurrent() == nil {
+		t.Fatal("newer user intent passed old bridge capture")
+	}
+	p.app.radio.Intent--
+	if guardCurrent() != nil {
+		t.Fatal("exact current capture was not retained")
+	}
+	delete(p.app.radio.Holds, "child")
+	// An old journal without explicit playback provenance must never default
+	// to "was playing" and silently restore sound on another room.
+	missing := h.PausedBefore
+	h.PausedBefore = nil
+	probe := *seed.Capture
+	probe.Player = worker
+	probe.Primary = p.primaryStream
+	probe.Source = source
+	probe.Pipe = path
+	probe.PipeDigest = contentDigestBytes(path)
+	if _, _, e := p.captureRadioSourceMove(ctx, &probe); e == nil {
+		t.Fatal("source-only MOVE guessed missing pre-radio playback intent")
+	}
+	h.PausedBefore = missing
+	oldPrimary, oldTracks, oldSession := p.primaryStream, p.state.tracks, p.sess
+	for i := uint64(1); i <= 2; i++ {
+		if _, err = p.handleApiRequest(context.Background(), ApiRequest{Type: ApiRequestTypePause}); err != nil {
+			t.Fatal(err)
+		}
+		if p.app.radio.Intent != i || h.PausedBefore == nil || !*h.PausedBefore || !h.WriterParked || p.primaryStream != oldPrimary || p.state.tracks != oldTracks || p.sess != oldSession {
+			t.Fatal("equal-value Pause lost authority or mutated retained session")
+		}
+		state, e := worker.InspectRadio(ctx)
+		if e != nil || !state.Suspended || !state.WriterClosed || state.Binding != binding {
+			t.Fatal("Pause reopened or changed parked FIFO")
+		}
+	}
+}
+
+func TestRadioUnresolvedSourceMoveBlocksNewIntentBeforeClaim(t *testing.T) {
+	p, _ := contentFixture(t)
+	p.app.cfg.RadioHandoffControlToken = strings.Repeat("f", 32)
+	p.app.cfg.RadioHandoffOwnerURL = "http://127.0.0.1:8080"
+	p.app.cfg.RadioHandoffStatePath = filepath.Join(t.TempDir(), "radio.json")
+	p.app.radio.Holds = map[string]*radioHold{"old": {SourceMove: &radioSourceMoveRequest{}, SourceMovePhase: "unknown", WriterParked: true}}
+	p.app.radio.Intent = 9
+	oldPrimary, oldTracks, oldRevision := p.primaryStream, p.state.tracks, p.roomNativeIntent
+	for _, typ := range []ApiRequestType{apiMoveClaim, apiContentClaim, ApiRequestTypePlay, ApiRequestTypeResume} {
+		if _, err := p.handleApiRequest(context.Background(), ApiRequest{Type: typ}); err == nil {
+			t.Fatal("unresolved transfer accepted new intent", typ)
+		}
+		if p.app.radio.Intent != 9 || p.roomNativeIntent != oldRevision || p.primaryStream != oldPrimary || p.state.tracks != oldTracks {
+			t.Fatal("unresolved transfer advanced intent or mutated source")
+		}
+	}
+	if err := p.handleMprisEvent(context.Background(), mpris.MediaPlayer2PlayerCommand{Type: mpris.MediaPlayer2PlayerCommandTypePlay}); err == nil || p.app.radio.Intent != 9 {
+		t.Fatal("MPRIS accepted an intent while source transfer unresolved")
+	}
+}
diff --git a/daemon/radio_preempt_decode.go b/daemon/radio_preempt_decode.go
new file mode 100644
index 0000000..4bef793
--- /dev/null
+++ b/daemon/radio_preempt_decode.go
@@ -0,0 +1,41 @@
+package daemon
+
+import (
+	"bytes"
+	"encoding/json"
+)
+
+// The ticket is an opaque C OBJECT, not a byte-array command. Keep the outer
+// callback envelope closed and required, then leave ticket authentication and
+// its exact challenge/volume tuple to the existing receiver verifier.
+func decodeRadioPreemptReply(raw []byte, out *radioPreemptReply) error {
+	var fields map[string]json.RawMessage
+	if err := strictVolumeJSON(raw, &fields); err != nil {
+		return err
+	}
+	keys := []string{"schema", "native_process_id", "handoff_id", "generation", "token", "target_id", "action_id", "cause", "reacquire_challenge", "terminal", "drain_ticket"}
+	if len(fields) != len(keys) {
+		return ErrBadRequest
+	}
+	for _, key := range keys {
+		v, ok := fields[key]
+		if !ok || bytes.Equal(bytes.TrimSpace(v), []byte("null")) {
+			return ErrBadRequest
+		}
+	}
+	var ticket map[string]json.RawMessage
+	if err := strictVolumeJSON(fields["drain_ticket"], &ticket); err != nil || len(ticket) == 0 {
+		return ErrBadRequest
+	}
+	var candidate radioPreemptReply
+	decoder := json.NewDecoder(bytes.NewReader(raw))
+	decoder.DisallowUnknownFields()
+	if err := decoder.Decode(&candidate); err != nil {
+		return err
+	}
+	if candidate.Schema != "podconnect.radio-preempt.v1" || !volumeHex64.MatchString(candidate.ProcessID) || !volumeUUID.MatchString(candidate.HandoffID) || !volumeCounter(candidate.Generation) || candidate.Generation == "0" || !volumeHex32.MatchString(candidate.Token) || !nativeOwnerASCII(candidate.TargetID, 255) || !volumeUUID.MatchString(candidate.ActionID) || !volumeHex32.MatchString(candidate.Challenge) || !candidate.Terminal || (candidate.Cause != "play" && candidate.Cause != "resume" && candidate.Cause != "transfer") {
+		return ErrBadRequest
+	}
+	*out = candidate
+	return nil
+}
diff --git a/daemon/radio_preempt_decode_test.go b/daemon/radio_preempt_decode_test.go
new file mode 100644
index 0000000..5184d37
--- /dev/null
+++ b/daemon/radio_preempt_decode_test.go
@@ -0,0 +1,66 @@
+package daemon
+
+import (
+	"encoding/json"
+	"os"
+	"strings"
+	"testing"
+)
+
+func TestRadioPreemptClosedOpaqueObjectTicket(t *testing.T) {
+	value := radioPreemptReply{Schema: "podconnect.radio-preempt.v1", ProcessID: strings.Repeat("a", 64), HandoffID: "00000000-0000-0000-0000-000000000001", Generation: "1", Token: strings.Repeat("b", 32), TargetID: "room", ActionID: "00000000-0000-0000-0000-000000000002", Cause: "play", Challenge: strings.Repeat("c", 32), Terminal: true, Ticket: json.RawMessage(`{"drain_generation":"1","opaque_actual_C_extension":true}`)}
+	raw := radioEvolutionRaw(t, value)
+	var generic radioPreemptReply
+	if strictVolumeJSON(raw, &generic) == nil {
+		t.Fatal("regression no longer reproduces generic byte-array mismatch")
+	}
+	var decoded radioPreemptReply
+	if err := decodeRadioPreemptReply(raw, &decoded); err != nil || string(decoded.Ticket) != string(value.Ticket) {
+		t.Fatal("opaque object not preserved byte-exact", err)
+	}
+	var fields map[string]json.RawMessage
+	_ = json.Unmarshal(raw, &fields)
+	for name, bad := range map[string]json.RawMessage{"null": json.RawMessage(`null`), "array": json.RawMessage(`[]`), "scalar": json.RawMessage(`"ticket"`), "empty_object": json.RawMessage(`{}`)} {
+		t.Run(name, func(t *testing.T) {
+			copy := map[string]json.RawMessage{}
+			for k, v := range fields {
+				copy[k] = v
+			}
+			copy["drain_ticket"] = bad
+			if decodeRadioPreemptReply(radioEvolutionRaw(t, copy), &decoded) == nil {
+				t.Fatal("non-ticket accepted")
+			}
+		})
+	}
+	for _, key := range []string{"drain_ticket", "terminal", "reacquire_challenge"} {
+		copy := map[string]json.RawMessage{}
+		for k, v := range fields {
+			copy[k] = v
+		}
+		delete(copy, key)
+		if decodeRadioPreemptReply(radioEvolutionRaw(t, copy), &decoded) == nil {
+			t.Fatal("missing envelope field accepted", key)
+		}
+	}
+	fields["extra"] = json.RawMessage(`true`)
+	if decodeRadioPreemptReply(radioEvolutionRaw(t, fields), &decoded) == nil {
+		t.Fatal("unknown envelope field accepted")
+	}
+}
+
+func TestRadioPreemptProductionGoMarshalerBytes(t *testing.T) {
+	// Generated by the real Go production reply + setDrainTicket marshaler path.
+	// Values are synthetic protocol fixtures, not sender/custody/runtime proof.
+	raw, err := os.ReadFile("testdata/radio-preempt-go-reply.json")
+	if err != nil {
+		t.Fatal(err)
+	}
+	var reply radioPreemptReply
+	if err = decodeRadioPreemptReply(raw, &reply); err != nil {
+		t.Fatal("actual Go production marshal bytes rejected by Native", err)
+	}
+	var ticket radioDrainTicket
+	if err = json.Unmarshal(reply.Ticket, &ticket); err != nil || !ticket.valid(reply.Challenge) || reply.Token != strings.Repeat("2", 32) || reply.TargetID != "room-A" || reply.Cause != "play" {
+		t.Fatal("cross-language immutable ticket/correlation mismatch", err)
+	}
+}
diff --git a/daemon/radio_reacquire.go b/daemon/radio_reacquire.go
