+/* Check the retained decoder and claim its predecessor on the same player
+ * turn. Only an exact, receiver-free candidate can be retired as no-effect. */
 int
+outputs_airplay_primary_radio_claim_replace_stop(const struct output_primary_radio_custody *expected, const char *action)
+{
+  struct primary_radio_station_operation *candidate = primary_radio_replacement_stop_candidate(expected, action);
+  struct output_primary_radio_custody actual;
+  if (!candidate || outputs_primary_radio_custody_read(expected->device_id, &actual) != 1
+      || !outputs_primary_radio_session_equal(expected, &actual))
+    return -1;
+  if (actual.stop_action[0])
+    return strcmp(actual.stop_action, action) ? -1 : 0;
+  if (candidate->replacement_stop_rejected)
+    return 1;
+  if (!candidate->decode_only || candidate->admitted_route.device_id
+      || (candidate->decoder && candidate->decoder->session))
+    return -1;
+
+  struct airplay_session *session = primary_radio_station_predecessor(expected);
+  if (!session)
+    return -1;
+  const struct output_primary_radio_start_request *request = &candidate->request;
+  struct output_primary_radio_start_request current;
+  if (candidate->result.phase != OUTPUT_PRIMARY_RADIO_START_DECODED || !candidate->decoder
+      || outputs_airplay_primary_station_replace_target(request->device_id, expected, &current) < 0
+      || !primary_radio_station_same_target(request, &current)
+      || !primary_radio_decode_frame_ready(candidate->decoder) || !primary_radio_station_before_deadline(candidate))
+    {
+      candidate->replacement_stop_rejected = true;
+      primary_radio_station_finish(candidate, OUTPUT_PRIMARY_RADIO_START_REJECTED);
+      if (candidate->decoder)
+        primary_radio_decoder_drop(candidate->decoder);
+      return 1;
+    }
+  if (primary_radio_claim_stop(session, action) < 0)
+    return -1;
+  primary_radio_stop_after_decoder(session, "primary_radio_replace_revoke");
+  return 0;
+}
