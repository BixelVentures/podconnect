 /* Capture credential policy when a real constructor is admitted. The session
  * keeps this provenance after scopes/generations advance; a later error must
  * not erase the primary pairing used by a radio-caused reconnect. */
+/* A primary return delegates to the existing Spotify START owner. Its
+ * exact token must never borrow the legacy radio sender's durable pairing. */
+int
+outputs_primary_spotify_start_owner(uint64_t id, const char *token)
+{
+  struct radio_handoff_slot *source = token ? radio_handoff_find(id) : NULL;
+  if (!source || source->result.phase != OUTPUT_RADIO_REACQUIRED
+      || source->result.resume.phase != OUTPUT_RADIO_REACQUIRE_DELEGATED
+      || !radio_primary_park_command(&source->result.command))
+    return 0;
+  return !strcmp(token, source->result.resume.delegated_token) ? 1 : -1;
+}
