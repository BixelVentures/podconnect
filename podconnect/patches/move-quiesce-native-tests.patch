+func TestMoveControlCancellationReturnsBeforeOwnedWaiterRestoresUnderLock(t *testing.T) {
+	out, _, _ := startPipeFixture(t, &startRead{entered: make(chan struct{})})
+	expired, cancel := context.WithCancel(context.Background())
+	cancel()
+	calls := 0
+	if err := out.WithMoveControlLock(expired, func(PipeIdentity, func(bool)) error { calls++; return nil }); err != context.Canceled || calls != 0 || out.controlPending.Load() {
+		t.Fatal("expired command announced control", err, calls)
+	}
+	out.lock.Lock()
+	ctx, stop := context.WithTimeout(context.Background(), 20*time.Millisecond)
+	defer stop()
+	done := make(chan error, 1)
+	go func() {
+		done <- out.WithMoveControlLock(ctx, func(PipeIdentity, func(bool)) error { calls++; return nil })
+	}()
+	if err := <-done; !errors.Is(err, context.DeadlineExceeded) {
+		out.lock.Unlock()
+		t.Fatal(err)
+	}
+	if !out.controlPending.Load() {
+		out.lock.Unlock()
+		t.Fatal("cancellation cleared pending before owned lock join")
+	}
+	out.lock.Unlock()
+	until := time.Now().Add(time.Second)
+	joined := false
+	for time.Now().Before(until) {
+		if out.control.TryLock() {
+			joined = true
+			out.control.Unlock()
+			break
+		}
+		time.Sleep(time.Millisecond)
+	}
+	if !joined || out.controlPending.Load() || calls != 0 {
+		t.Fatal("owned waiter failed to restore control after join", joined, calls)
+	}
+	if err := out.Pause(); err != nil {
+		t.Fatal("later normal control blocked", err)
+	}
+}
