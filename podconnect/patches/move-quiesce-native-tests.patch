+func TestRoomMoveQuiesceRejectsExpiredOrForeignOutputBeforeControlSetter(t *testing.T) {
+	backend := &moveBackend{identity: output.PipeIdentity{Device: "1", Inode: "2", Type: "fifo"}, fd: "42"}
+	var out output.Output = backend
+	source := NewSwitchingAudioSource()
+	primary := &transportSource{id: 1}
+	source.SetPrimary(primary)
+	p := &Player{}
+	guard := func(mutate func()) error { mutate(); return nil }
+	snapshot, err := p.applyRoomMove(&roomMoveCommand{ctx: context.Background(), phase: "snapshot", expectedSource: primary, wasPlaying: true}, &out, source)
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, mode := range []string{"fd", "epoch", "expired"} {
+		ctx := context.Background()
+		epoch := snapshot.Epoch
+		if mode == "fd" {
+			backend.fd = "43"
+		} else {
+			backend.fd = "42"
+		}
+		if mode == "epoch" {
+			epoch = "1"
+		}
+		if mode == "expired" {
+			var cancel context.CancelFunc
+			ctx, cancel = context.WithCancel(ctx)
+			cancel()
+		}
+		_, err = p.applyRoomMove(&roomMoveCommand{ctx: ctx, phase: "quiesce", expectedSource: primary, pipe: snapshot.Pipe, epoch: epoch, wasPlaying: true, guard: guard}, &out, source)
+		if err == nil || backend.controls != 0 || backend.fenced || backend.paused || p.startEpoch != 0 {
+			t.Fatal("foreign/expired command reached control setter", mode, err, backend.controls)
+		}
+	}
