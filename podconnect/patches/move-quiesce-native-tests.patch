+func TestMoveControlDeadlineSetterErrorJoinsBeforePendingClear(t *testing.T) {
+	out, _, _ := startPipeFixture(t, &startRead{entered: make(chan struct{})})
+	file, err := os.CreateTemp(t.TempDir(), "unsupported-deadline")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer file.Close()
+	out.lock.Lock()
+	original := out.file
+	out.file = file
+	out.lock.Unlock()
+	calls := 0
+	err = out.WithMoveControlLock(context.Background(), func(PipeIdentity, func(bool)) error { calls++; return nil })
+	out.lock.Lock()
+	out.file = original
+	pending := out.controlPending.Load()
+	out.lock.Unlock()
+	if err == nil || calls != 0 || pending {
+		t.Fatal("setter error did not restore under owned lock", err, calls, pending)
+	}
+	if !out.control.TryLock() {
+		t.Fatal("setter error retained control")
+	}
+	out.control.Unlock()
+}
