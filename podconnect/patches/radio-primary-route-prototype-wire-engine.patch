+/* These entry points remain local to the primary output owner. The isolated
+ * fixture calls them on its player thread; no Manager/Native path is enabled. */
+static int
+airplay_primary_radio_start(struct output_device *device, struct airplay_primary_radio_route *route)
+{
+  struct airplay_session *session;
+
+  if (!device || !route || device->type != OUTPUT_TYPE_AIRPLAY || !device->advertised
+      || device->selected || device->session || device->route_revision == UINT64_MAX
+      || outputs_transport_busy() || outputs_radio_handoff_blocked(device->id)
+      || outputs_radio_sender_role())
+    return -1;
+
+  session = session_make_for_source(device, -1, true);
+  if (!session)
+    return -1;
+
+  *route = (struct airplay_primary_radio_route) {
+    device->id, session->device_incarnation, session->session_epoch, device->route_revision,
+  };
+  sequence_start(AIRPLAY_SEQ_START, session, NULL, "primary_radio_start");
+  return 0;
+}
+
+static struct airplay_session *
+airplay_primary_radio_session(const struct airplay_primary_radio_route *route)
+{
+  struct output_device *device = outputs_device_get(route->device_id);
+  struct airplay_session *session = device && device->type == OUTPUT_TYPE_AIRPLAY ? device->session : NULL;
+
+  if (!session || !session->primary_radio || !primary_radio_binding_current(session)
+      || route->incarnation != session->device_incarnation || route->epoch != session->session_epoch
+      || route->revision != session->primary_radio_route_revision)
+    return NULL;
+
+  return session;
+}
+
+static int
+airplay_primary_radio_write(const struct airplay_primary_radio_route *route, struct output_buffer *obuf)
+{
+  struct airplay_session *session = airplay_primary_radio_session(route);
+
+  if (!session || !attention_emission_current(session, NULL))
+    return -1;
+
+  airplay_write_source(obuf, session);
+  return 0;
+}
+
+static int
+airplay_primary_radio_revoke(const struct airplay_primary_radio_route *route)
+{
+  struct airplay_session *session = airplay_primary_radio_session(route);
+
+  if (!session || session->primary_radio_revoked || !session->control_cipher_ctx
+      || !(session->state & AIRPLAY_STATE_F_CONNECTED))
+    return -1;
+
+  session->primary_radio_revoked = true;
+  sequence_start(AIRPLAY_SEQ_STOP, session, NULL, "primary_radio_revoke");
+  return 0;
 }
 
