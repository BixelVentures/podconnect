+func TestQueueHTTPRejectsUnboundedOpenAndURIScopeBeforeActor(t *testing.T) {
+	server := &ConcreteApiServer{requests: make(chan ApiRequest, 1)}
+	good := `{"account_user_id":"u","room_id":"r0","observation_id":"` + strings.Repeat("a", 32) + `","session_id":"s","queue_revision":7,"occurrence_id":"` + strings.Repeat("b", 24) + `"}`
+	for _, raw := range []string{`{}`, strings.Replace(good, `"queue_revision":7`, `"queue_revision":null`, 1), strings.Replace(good, `"room_id":"r0"`, `"room_id":"r0","room_id":"r1"`, 1), strings.Replace(good, `"session_id":"s"`, `"uri":"spotify:track:AAAAAAAAAAAAAAAAAAAAAA","session_id":"s"`, 1), good + ` {}`, strings.Repeat("x", 2049)} {
+		out := httptest.NewRecorder()
+		server.handleQueueOccurrence(out, httptest.NewRequest("POST", "/player/queue_occurrence", strings.NewReader(raw)))
+		if out.Code != 400 {
+			t.Fatalf("bad protocol reached actor %d", out.Code)
+		}
+		select {
+		case <-server.requests:
+			t.Fatal("invalid message dispatched")
+		default:
+		}
+	}
+}
+func TestQueueHTTPActualActorQueueCancellationCannotMutate(t *testing.T) {
+	server := &ConcreteApiServer{requests: make(chan ApiRequest, 1)}
+	p := &AppPlayer{}
+	ctx, cancel := context.WithCancel(context.Background())
+	request := httptest.NewRequest("GET", "/player/queue_occurrences?account_user_id=u&room_id=r0", nil).WithContext(ctx)
+	done := make(chan struct{})
+	out := httptest.NewRecorder()
+	go func() { defer close(done); server.handleQueueOccurrences(out, request) }()
+	var req ApiRequest
+	select {
+	case req = <-server.requests:
+	case <-time.After(time.Second):
+		t.Fatal("actor queue not reached")
+	}
+	cancel()
+	select {
+	case <-done:
+	case <-time.After(time.Second):
+		t.Fatal("cancel did not end HTTP request")
+	}
+	result, err := p.handleApiRequest(context.Background(), req)
+	req.Reply(result, err)
+	if err == nil || p.queueOccurrenceOffer != nil || out.Code != http.StatusGatewayTimeout {
+		t.Fatal("cancelled owner minted offer")
+	}
+}
