+package tracks
+
+import (
+	"context"
+	"fmt"
+	librespot "github.com/devgianlu/go-librespot"
+	connectpb "github.com/devgianlu/go-librespot/proto/spotify/connectstate"
+	"math"
+)
+
+const MaxQueueOccurrences = 20
+
+type QueueOccurrence struct {
+	Position int    `json:"position"`
+	URI      string `json:"uri"`
+	UID      string `json:"uid"`
+	Queued   bool   `json:"queued"`
+}
+
+type QueueObservation struct {
+	Revision  uint64            `json:"queue_revision"`
+	Items     []QueueOccurrence `json:"items"`
+	Truncated bool              `json:"truncated"`
+}
+
+func (tl *List) invalidateQueueObservation() {
+	if tl.queueRevision == math.MaxUint64 {
+		tl.queueRevisionExhausted = true
+		return
+	}
+	tl.queueRevision++
+}
+
+// ObserveUpcoming is called only by the existing serialized native player owner.
+// It exposes the same upcoming order GoNext consumes, never the REST account queue.
+func (tl *List) ObserveUpcoming(ctx context.Context) (QueueObservation, error) {
+	result := QueueObservation{Revision: tl.queueRevision, Items: []QueueOccurrence{}}
+	if tl.queueRevisionExhausted || tl.tracks == nil || tl.tracks.pos < 0 || tl.ctx == nil {
+		return result, fmt.Errorf("queue occurrence owner unavailable")
+	}
+	appendTrack := func(track *connectpb.ContextTrack, queued bool) error {
+		if track == nil || (track.Uri == "" && len(track.Gid) != 16) {
+			return fmt.Errorf("unidentified upcoming occurrence")
+		}
+		provided := librespot.ContextTrackToProvidedTrack(tl.ctx.Type(), track)
+		if provided.Uri == "" {
+			return fmt.Errorf("unidentified upcoming occurrence")
+		}
+		result.Items = append(result.Items, QueueOccurrence{Position: len(result.Items), URI: provided.Uri, UID: track.Uid, Queued: queued})
+		return nil
+	}
+	start := 0
+	if tl.playingQueue {
+		start = 1
+	}
+	if start > len(tl.queue) {
+		return result, fmt.Errorf("invalid playing queue cursor")
+	}
+	for _, track := range tl.queue[start:] {
+		if len(result.Items) == MaxQueueOccurrences {
+			break
+		}
+		if err := appendTrack(track, true); err != nil {
+			return QueueObservation{}, err
+		}
+	}
+	iter := tl.tracks.iterHere()
+	for len(result.Items) < MaxQueueOccurrences && iter.next(ctx) {
+		if err := appendTrack(iter.get().item, false); err != nil {
+			return QueueObservation{}, err
+		}
+	}
+	if len(result.Items) == MaxQueueOccurrences {
+		result.Truncated = len(tl.queue)-start > MaxQueueOccurrences || iter.next(ctx)
+	}
+	if err := ctx.Err(); err != nil {
+		return QueueObservation{}, err
+	}
+	if err := iter.error(); err != nil {
+		return QueueObservation{}, err
+	}
+	return result, nil
+}
+
+// SelectUpcoming never falls back to another track and loads no audio. Its caller
+// must compare process/List/session/connection/alias and consume its opaque token
+// before calling; a bare revision is not cross-session authority.
+func (tl *List) SelectUpcoming(ctx context.Context, revision uint64, position int) error {
+	if tl.queueRevisionExhausted || revision != tl.queueRevision || position < 0 || position >= MaxQueueOccurrences {
+		return fmt.Errorf("stale or invalid queue occurrence")
+	}
+	observation, err := tl.ObserveUpcoming(ctx)
+	if err != nil {
+		return err
+	}
+	if position >= len(observation.Items) {
+		return fmt.Errorf("queue occurrence missing")
+	}
+	start := 0
+	if tl.playingQueue {
+		start = 1
+	}
+	manual := len(tl.queue) - start
+	if position < manual {
+		if err := ctx.Err(); err != nil {
+			return err
+		}
+		tl.invalidateQueueObservation()
+		tl.queue = tl.queue[start+position:]
+		tl.playingQueue = true
+		return nil
+	}
+	// Locate first, then commit once. Failed/cancelled page reads cannot trim
+	// the manual queue, rewind the context, or move the audible player.
+	iter := tl.tracks.iterHere()
+	for remaining := position - manual; remaining >= 0; remaining-- {
+		if !iter.next(ctx) {
+			return fmt.Errorf("queue occurrence disappeared: %v", iter.error())
+		}
+	}
+	if err := ctx.Err(); err != nil {
+		return err
+	}
+	tl.invalidateQueueObservation()
+	tl.tracks.move(iter)
+	tl.queue = nil
+	tl.playingQueue = false
+	return nil
+}
