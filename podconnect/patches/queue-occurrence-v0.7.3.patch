+package tracks
+
+import (
+	"context"
+	librespot "github.com/devgianlu/go-librespot"
+	connectpb "github.com/devgianlu/go-librespot/proto/spotify/connectstate"
+	"reflect"
+	"testing"
+)
+
+func occurrenceFixture(t *testing.T) *List {
+	t.Helper()
+	rows := []*connectpb.ContextTrack{{Uri: "spotify:track:0000000000000000000000", Uid: "current"}, {Uri: "spotify:track:1111111111111111111111", Uid: "duplicate"}, {Uri: "spotify:track:1111111111111111111111", Uid: "duplicate"}, {Uri: "spotify:track:2222222222222222222222", Uid: "last"}}
+	tl, err := NewTrackListFromContext(context.Background(), &librespot.NullLogger{}, nil, &connectpb.Context{Uri: "spotify:playlist:0000000000000000000000", Pages: []*connectpb.ContextPage{{Tracks: rows}}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := tl.Seek(context.Background(), func(track *connectpb.ContextTrack) bool { return track.Uid == "current" }); err != nil {
+		t.Fatal(err)
+	}
+	return tl
+}
+
+func TestUpcomingDuplicateContextOccurrenceAndSingleUseRevision(t *testing.T) {
+	tl := occurrenceFixture(t)
+	o, err := tl.ObserveUpcoming(context.Background())
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(o.Items) != 3 || o.Items[0].URI != o.Items[1].URI {
+		t.Fatal("fixture did not retain duplicate upcoming occurrences")
+	}
+	if err := tl.SelectUpcoming(context.Background(), o.Revision, 1); err != nil {
+		t.Fatal(err)
+	}
+	if tl.Index().Track != 2 {
+		t.Fatal("URI or duplicate UID matched first occurrence rather than exact second position")
+	}
+	if err := tl.SelectUpcoming(context.Background(), o.Revision, 0); err == nil {
+		t.Fatal("replayed observation mutated queue")
+	}
+	if tl.Index().Track != 2 {
+		t.Fatal("replay rewound context")
+	}
+}
+
+func TestUpcomingManualQueueKeepsContextAndFollowingQueue(t *testing.T) {
+	tl := occurrenceFixture(t)
+	first := &connectpb.ContextTrack{Uri: "spotify:track:1111111111111111111111", Uid: "duplicate"}
+	second := &connectpb.ContextTrack{Uri: first.Uri, Uid: first.Uid}
+	last := &connectpb.ContextTrack{Uri: "spotify:track:3333333333333333333333", Uid: "last-manual"}
+	tl.AddToQueue(first)
+	tl.AddToQueue(second)
+	tl.AddToQueue(last)
+	o, err := tl.ObserveUpcoming(context.Background())
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !o.Items[0].Queued || !o.Items[1].Queued || o.Items[3].Queued {
+		t.Fatal("manual/context order changed")
+	}
+	if err := tl.SelectUpcoming(context.Background(), o.Revision, 1); err != nil {
+		t.Fatal(err)
+	}
+	if !tl.playingQueue || len(tl.queue) != 2 || tl.queue[0] != second || tl.queue[1] != last || tl.tracks.pos != 0 {
+		t.Fatal("manual duplicate selection lost cursor or remaining manual queue")
+	}
+	n, err := tl.ObserveUpcoming(context.Background())
+	if err != nil {
+		t.Fatal(err)
+	}
+	if n.Items[0].UID != "last-manual" {
+		t.Fatal("playing manual item was offered as its own next occurrence")
+	}
+}
+
+func TestUpcomingContextJumpPastManualQueueDoesNotReplacePlaylist(t *testing.T) {
+	tl := occurrenceFixture(t)
+	cursor := tl.tracks
+	tl.AddToQueue(&connectpb.ContextTrack{Uri: "spotify:track:3333333333333333333333", Uid: "manual"})
+	o, err := tl.ObserveUpcoming(context.Background())
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := tl.SelectUpcoming(context.Background(), o.Revision, 2); err != nil {
+		t.Fatal(err)
+	}
+	if tl.tracks != cursor || tl.tracks.pos != 2 || tl.playingQueue || len(tl.queue) != 0 {
+		t.Fatal("context occurrence did not move existing cursor once past manual queue")
+	}
+}
+
+func TestUpcomingStaleABACancelAndInvalidNeverFallback(t *testing.T) {
+	for _, kind := range []string{"mutation", "aba", "cancel", "missing", "negative"} {
+		t.Run(kind, func(t *testing.T) {
+			tl := occurrenceFixture(t)
+			o, err := tl.ObserveUpcoming(context.Background())
+			if err != nil {
+				t.Fatal(err)
+			}
+			ctx := context.Background()
+			position := 1
+			switch kind {
+			case "mutation":
+				tl.AddToQueue(&connectpb.ContextTrack{Uri: "spotify:track:3333333333333333333333"})
+			case "aba":
+				tl.SetPlayingQueue(false)
+				tl.SetPlayingQueue(false)
+			case "cancel":
+				var cancel context.CancelFunc
+				ctx, cancel = context.WithCancel(ctx)
+				cancel()
+			case "missing":
+				position = 19
+			case "negative":
+				position = -1
+			}
+			beforePos, beforePlaying, beforeQueue := tl.tracks.pos, tl.playingQueue, append([]*connectpb.ContextTrack(nil), tl.queue...)
+			if err := tl.SelectUpcoming(ctx, o.Revision, position); err == nil {
+				t.Fatal("invalid/stale jump accepted")
+			}
+			if tl.tracks.pos != beforePos || tl.playingQueue != beforePlaying || !reflect.DeepEqual(tl.queue, beforeQueue) {
+				t.Fatal("rejected jump changed queue/cursor")
+			}
+		})
+	}
+}
+
+func TestUpcomingMalformedIdentityRejectsWithoutPanicOrCursorMutation(t *testing.T) {
+	for _, track := range []*connectpb.ContextTrack{nil, {}, {Gid: []byte{1}}, {Gid: make([]byte, 17)}} {
+		tl := occurrenceFixture(t)
+		tl.queue = []*connectpb.ContextTrack{track}
+		before := tl.tracks.pos
+		if _, err := tl.ObserveUpcoming(context.Background()); err == nil {
+			t.Fatal("malformed queue identity accepted")
+		}
+		if tl.tracks.pos != before || len(tl.queue) != 1 || tl.queue[0] != track {
+			t.Fatal("malformed read changed queue/cursor")
+		}
+	}
+}
