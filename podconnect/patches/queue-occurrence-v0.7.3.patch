+package daemon
+
+import (
+	"bytes"
+	"context"
+	"crypto/rand"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"io"
+	"net/http"
+	"reflect"
+	"regexp"
+	"strings"
+	"time"
+
+	"github.com/devgianlu/go-librespot/tracks"
+)
+
+const queueOfferLifetime = 10 * time.Second
+
+var queueIDPattern = regexp.MustCompile(`^[a-f0-9]{32}$`)
+var queueOccurrenceIDPattern = regexp.MustCompile(`^[a-f0-9]{24}$`)
+
+type queueReadRequest struct {
+	AccountUserID string
+	RoomID        string
+	Context       context.Context
+}
+type queueJumpRequest struct {
+	AccountUserID string          `json:"account_user_id"`
+	RoomID        string          `json:"room_id"`
+	ObservationID string          `json:"observation_id"`
+	SessionID     string          `json:"session_id"`
+	QueueRevision uint64          `json:"queue_revision"`
+	OccurrenceID  string          `json:"occurrence_id"`
+	Context       context.Context `json:"-"`
+}
+type nativeQueueItem struct {
+	ID       string `json:"id"`
+	Position int    `json:"position"`
+	URI      string `json:"uri"`
+	Queued   bool   `json:"queued"`
+}
+type nativeQueueSnapshot struct {
+	Schema           string            `json:"schema"`
+	TargetID         string            `json:"target_id"`
+	RoomID           string            `json:"room_id"`
+	AccountUserID    string            `json:"account_user_id"`
+	ConnectionID     string            `json:"connection_id"`
+	SessionID        string            `json:"session_id"`
+	AliasIncarnation string            `json:"alias_incarnation"`
+	ObservationID    string            `json:"observation_id"`
+	QueueRevision    uint64            `json:"queue_revision"`
+	ExpiresAfterMS   int               `json:"expires_after_ms"`
+	Items            []nativeQueueItem `json:"items"`
+	Truncated        bool              `json:"truncated"`
+}
+type nativeQueueOffer struct {
+	Snapshot nativeQueueSnapshot
+	State    *State
+	Tracks   *tracks.List
+	Alias    ApiAliasBinding
+	Expires  time.Time
+}
+
+func randomQueueID(bytes int) (string, error) {
+	raw := make([]byte, bytes)
+	if _, err := rand.Read(raw); err != nil {
+		return "", err
+	}
+	return hex.EncodeToString(raw), nil
+}
+func queueOperationContext(parent, request context.Context) (context.Context, context.CancelFunc) {
+	if request == nil {
+		request = context.Background()
+	}
+	ctx, cancel := context.WithTimeout(request, 3*time.Second)
+	stop := context.AfterFunc(parent, cancel)
+	// HTTP cancellation is the direct parent: cancellation before mutation
+	// cannot wait for an AfterFunc goroutine. Actor shutdown is checked again
+	// synchronously at the native effect admission boundary.
+	if parent.Err() != nil {
+		cancel()
+	}
+	return ctx, func() { stop(); cancel() }
+}
+func (p *AppPlayer) queueBinding(account, room string) (*ApiAliasBinding, error) {
+	if p.sess == nil || p.state == nil || p.state.player == nil || p.state.tracks == nil || !p.state.active || !p.playbackReady() || p.state.player.SessionId == "" || account == "" || len(account) > 160 || p.sess.Username() != account || p.spotConnId == "" {
+		return nil, ErrAliasConflict
+	}
+	binding := p.aliasBinding()
+	if binding == nil || !binding.Ready || binding.RoomID != room || binding.Incarnation == "" || room == "" {
+		return nil, ErrAliasConflict
+	}
+	return binding, nil
+}
+func (p *AppPlayer) observeQueueOccurrences(parent context.Context, request queueReadRequest) (any, error) {
+	ctx, cancel := queueOperationContext(parent, request.Context)
+	defer cancel()
+	binding, err := p.queueBinding(request.AccountUserID, request.RoomID)
+	if err != nil {
+		return nil, err
+	}
+	state, list, connection, session := p.state, p.state.tracks, p.spotConnId, p.state.player.SessionId
+	observed, err := list.ObserveUpcoming(ctx)
+	if err != nil {
+		return nil, ErrAliasConflict
+	}
+	if err := ctx.Err(); err != nil {
+		return nil, err
+	}
+	if err := parent.Err(); err != nil {
+		return nil, err
+	}
+	latest, bindingErr := p.queueBinding(request.AccountUserID, request.RoomID)
+	if bindingErr != nil || latest == nil || *latest != *binding || p.state != state || p.state.tracks != list || p.spotConnId != connection || p.state.player.SessionId != session {
+		return nil, ErrAliasConflict
+	}
+	id, err := randomQueueID(16)
+	if err != nil {
+		return nil, err
+	}
+	result := nativeQueueSnapshot{Schema: "podconnect.native_queue.v1", TargetID: p.app.deviceId, RoomID: request.RoomID, AccountUserID: request.AccountUserID, ConnectionID: p.spotConnId, SessionID: p.state.player.SessionId, AliasIncarnation: binding.Incarnation, ObservationID: id, QueueRevision: observed.Revision, ExpiresAfterMS: 10000, Items: []nativeQueueItem{}, Truncated: observed.Truncated}
+	for _, row := range observed.Items {
+		occurrence, err := randomQueueID(12)
+		if err != nil {
+			return nil, err
+		}
+		result.Items = append(result.Items, nativeQueueItem{occurrence, row.Position, row.URI, row.Queued})
+	}
+	p.queueOccurrenceOffer = &nativeQueueOffer{result, p.state, p.state.tracks, *binding, time.Now().Add(queueOfferLifetime)}
+	return result, nil
+}
+func (p *AppPlayer) commitQueueOccurrence(parent context.Context, request queueJumpRequest) (any, error) {
+	ctx, cancel := queueOperationContext(parent, request.Context)
+	defer cancel()
+	offer := p.queueOccurrenceOffer
+	// Every attempted token consumption retires that exact offer before selection,
+	// including failures/unknown outcomes. Invalid foreign tokens do not erase a new offer.
+	if offer == nil || request.ObservationID != offer.Snapshot.ObservationID {
+		return nil, ErrAliasConflict
+	}
+	p.queueOccurrenceOffer = nil
+	binding, err := p.queueBinding(request.AccountUserID, request.RoomID)
+	if err != nil || ctx.Err() != nil || !time.Now().Before(offer.Expires) || p.state != offer.State || p.state.tracks != offer.Tracks || binding == nil || *binding != offer.Alias || p.spotConnId != offer.Snapshot.ConnectionID || p.state.player.SessionId != offer.Snapshot.SessionID || request.SessionID != offer.Snapshot.SessionID || request.QueueRevision != offer.Snapshot.QueueRevision || request.AccountUserID != offer.Snapshot.AccountUserID || request.RoomID != offer.Snapshot.RoomID {
+		return nil, ErrAliasConflict
+	}
+	position := -1
+	for _, row := range offer.Snapshot.Items {
+		if row.ID == request.OccurrenceID {
+			position = row.Position
+			break
+		}
+	}
+	if position < 0 {
+		return nil, ErrBadRequest
+	}
+	p.aliasMu.Lock()
+	latest := p.aliasBindingLocked()
+	if latest == nil || *latest != offer.Alias || p.aliasRetired || ctx.Err() != nil || parent.Err() != nil {
+		p.aliasMu.Unlock()
+		return nil, ErrAliasConflict
+	}
+	selectionErr := p.state.tracks.SelectUpcoming(ctx, request.QueueRevision, position)
+	p.aliasMu.Unlock()
+	if selectionErr != nil {
+		return nil, ErrAliasConflict
+	}
+	// Selection has crossed its native mutation boundary. Media load failure is
+	// unknown to clients; never fallback, retry, alter volume, or replace context.
+	p.state.player.Track = p.state.tracks.CurrentTrack()
+	p.state.player.PrevTracks = p.state.tracks.PrevTracks()
+	p.state.player.NextTracks = p.state.tracks.NextTracks(ctx, nil)
+	p.state.player.Index = p.state.tracks.Index()
+	p.state.player.Timestamp = time.Now().UnixMilli()
+	p.state.player.PositionAsOfTimestamp = 0
+	if err := p.loadCurrentTrack(ctx, false, true); err != nil {
+		return nil, err
+	}
+	return map[string]any{"ok": true, "schema": "podconnect.native_queue_commit.v1", "observation_id": request.ObservationID, "occurrence_id": request.OccurrenceID, "physical_result_verified": false}, nil
+}
+
+func (s *ConcreteApiServer) serveQueueRequest(w http.ResponseWriter, r *http.Request, typ ApiRequestType, data any, ctx context.Context) {
+	req, wait := NewApiRequest(typ, data)
+	select {
+	case s.requests <- req:
+	case <-ctx.Done():
+		w.WriteHeader(http.StatusGatewayTimeout)
+		return
+	}
+	result, err := wait(ctx)
+	if err != nil {
+		if errors.Is(err, ErrBadRequest) {
+			w.WriteHeader(http.StatusBadRequest)
+		} else if errors.Is(err, ErrAliasConflict) || errors.Is(err, ErrNoSession) {
+			w.WriteHeader(http.StatusConflict)
+		} else {
+			w.WriteHeader(http.StatusGatewayTimeout)
+		}
+		return
+	}
+	raw, err := json.Marshal(result)
+	if err != nil || len(raw) > 65536 {
+		w.WriteHeader(http.StatusInternalServerError)
+		return
+	}
+	w.Header().Set("Content-Type", "application/json")
+	w.Header().Set("Cache-Control", "no-store")
+	_, _ = w.Write(raw)
+}
+func (s *ConcreteApiServer) handleQueueOccurrences(w http.ResponseWriter, r *http.Request) {
+	if r.Method != http.MethodGet {
+		w.WriteHeader(http.StatusMethodNotAllowed)
+		return
+	}
+	q := r.URL.Query()
+	if len(q) != 2 || len(q["account_user_id"]) != 1 || len(q["room_id"]) != 1 || q.Get("account_user_id") == "" || len(q.Get("account_user_id")) > 160 || q.Get("room_id") == "" || len(q.Get("room_id")) > 128 {
+		w.WriteHeader(http.StatusBadRequest)
+		return
+	}
+	ctx, cancel := context.WithTimeout(r.Context(), 3*time.Second)
+	defer cancel()
+	s.serveQueueRequest(w, r, ApiRequestTypeQueueOccurrences, queueReadRequest{q.Get("account_user_id"), q.Get("room_id"), ctx}, ctx)
+}
+func decodeQueueJSON(raw []byte, out any) error {
+	if !queueRequiredJSON(raw, reflect.TypeOf(out).Elem()) {
+		return errors.New("missing or null field")
+	}
+
+	scan := json.NewDecoder(bytes.NewReader(raw))
+	token, err := scan.Token()
+	if err != nil || token != json.Delim('{') {
+		return ErrBadRequest
+	}
+	seen := map[string]bool{}
+	for scan.More() {
+		key, err := scan.Token()
+		name, ok := key.(string)
+		if err != nil || !ok || seen[name] {
+			return ErrBadRequest
+		}
+		seen[name] = true
+		var v json.RawMessage
+		if scan.Decode(&v) != nil {
+			return ErrBadRequest
+		}
+	}
+	if token, err = scan.Token(); err != nil || token != json.Delim('}') {
+		return ErrBadRequest
+	}
+	if scan.Decode(new(any)) != io.EOF {
+		return ErrBadRequest
+	}
+	decode := json.NewDecoder(bytes.NewReader(raw))
+	decode.DisallowUnknownFields()
+	return decode.Decode(out)
+}
+func (s *ConcreteApiServer) handleQueueOccurrence(w http.ResponseWriter, r *http.Request) {
+	if r.Method != http.MethodPost {
+		w.WriteHeader(http.StatusMethodNotAllowed)
+		return
+	}
+	if len(r.URL.RawQuery) > 0 {
+		w.WriteHeader(http.StatusBadRequest)
+		return
+	}
+	raw, err := io.ReadAll(io.LimitReader(r.Body, 2049))
+	if err != nil || len(raw) > 2048 {
+		w.WriteHeader(http.StatusBadRequest)
+		return
+	}
+	defer r.Body.Close()
+	var data queueJumpRequest
+	if decodeQueueJSON(raw, &data) != nil || !queueIDPattern.MatchString(data.ObservationID) || !queueOccurrenceIDPattern.MatchString(data.OccurrenceID) || data.SessionID == "" || len(data.SessionID) > 160 || data.AccountUserID == "" || len(data.AccountUserID) > 160 || data.RoomID == "" || len(data.RoomID) > 128 || data.QueueRevision >= 1<<53 {
+		w.WriteHeader(http.StatusBadRequest)
+		return
+	}
+	ctx, cancel := context.WithTimeout(r.Context(), 3*time.Second)
+	defer cancel()
+	data.Context = ctx
+	s.serveQueueRequest(w, r, ApiRequestTypeQueueOccurrence, data, ctx)
+}
+
+// Presence is part of the protocol: absent/null false, zero or empty collections
+// must not become apparently verified defaults during typed JSON decoding.
+func queueRequiredJSON(raw []byte, typ reflect.Type) bool {
+	if string(raw) == "null" {
+		return false
+	}
+	switch typ.Kind() {
+	case reflect.Struct:
+		var fields map[string]json.RawMessage
+		if json.Unmarshal(raw, &fields) != nil || fields == nil {
+			return false
+		}
+		for i := 0; i < typ.NumField(); i++ {
+			f := typ.Field(i)
+			tag := strings.Split(f.Tag.Get("json"), ",")
+			if len(tag) == 0 || tag[0] == "-" || tag[0] == "" {
+				continue
+			}
+			value, exists := fields[tag[0]]
+			optional := len(tag) > 1 && tag[1] == "omitempty"
+			if !exists {
+				if optional {
+					continue
+				}
+				return false
+			}
+			if !queueRequiredJSON(value, f.Type) {
+				return false
+			}
+		}
+	case reflect.Slice:
+		var items []json.RawMessage
+		if json.Unmarshal(raw, &items) != nil || items == nil {
+			return false
+		}
+		for _, item := range items {
+			if !queueRequiredJSON(item, typ.Elem()) {
+				return false
+			}
+		}
+	}
+	return true
+}
