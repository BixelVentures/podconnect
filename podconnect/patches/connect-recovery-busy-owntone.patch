+/* PC33 reuses the real JSON API and C owner: a typed conflict proves no effect,
+ * while START/journal ownership is terminal and cannot earn retry permission. */
+static void connect_recovery_temporary_busy_contract(void)
+{
+  struct output_device *a=add_device(1);
+  struct evkeyvalq query,headers;
+  struct httpd_request request={0};
+  struct timespec saved=transport_custody_expiry;
+  int volume=a->volume; uint64_t base=a->base_revision,route=a->route_revision;
+  TAILQ_INIT(&query); TAILQ_INIT(&headers);
+  assert(evhttp_parse_query_str("recovery=connect&output_id=1&volume=35",&query)==0);
+  request.query=&query; request.out_headers=&headers;
+  assert(clock_gettime(CLOCK_MONOTONIC,&transport_custody_expiry)==0);
+  transport_custody_expiry.tv_sec+=60; transport_custody_live=true;
+  a->attention_lease=1;
+  assert(outputs_connect_recovery_status(1)==-1);
+  a->attention_lease=0;
+  assert(outputs_connect_recovery_status(1)==-2);
+  assert(jsonapi_reply_player_volume(&request)==409);
+  assert(!strcmp(evhttp_find_header(&headers,"X-PodConnect-Recovery"),"temporary-busy-no-effect-v1"));
+  evhttp_clear_headers(&headers);
+  atomic_store(&start_owned_latch,true);
+  assert(outputs_connect_recovery_status(1)==-1);
+  assert(jsonapi_reply_player_volume(&request)==HTTP_INTERNAL);
+  assert(!evhttp_find_header(&headers,"X-PodConnect-Recovery"));
+  atomic_store(&start_owned_latch,false);
+  start_journal_fault=true;
+  assert(outputs_connect_recovery_status(1)==-1);
+  assert(jsonapi_reply_player_volume(&request)==HTTP_INTERNAL);
+  assert(!evhttp_find_header(&headers,"X-PodConnect-Recovery"));
+  start_journal_fault=false;
+  transport_custody_live=false; transport_custody_expiry=saved;
+  assert(outputs_connect_recovery_status(1)==0);
+  assert(jsonapi_reply_player_volume(&request)==HTTP_NOCONTENT);
+  assert(!evhttp_find_header(&headers,"X-PodConnect-Recovery"));
+  assert(a->volume==volume && a->base_revision==base && a->route_revision==route);
+  assert(!a->selected && !a->session);
+  evhttp_clear_headers(&query); evhttp_clear_headers(&headers); clear_devices();
+  puts("PASS PC33 actual HTTP/C owner: temporary custody typed pre-effect conflict; START/journal terminal; drain returns ready; no mutation");
 }
 
