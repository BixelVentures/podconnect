+int
+outputs_primary_spotify_park(enum output_primary_spotify_park_action action,
+    const struct output_primary_spotify_park_request *request, struct output_primary_spotify_park_result *out)
+{
+  struct output_radio_handoff_result result;
+  struct output_radio_handoff_request command = { 0 };
+  uint64_t id;
+  if (!request || !out || action < OUTPUT_PRIMARY_SPOTIFY_PARK_PREPARE || action > OUTPUT_PRIMARY_SPOTIFY_PARK_RESULT
+      || !radio_handoff_uuid(request->action) || !radio_native_source_owner_valid(&request->owner)
+      || !request->native_revision || request->native_revision == UINT64_MAX
+      || safe_atou64(request->owner.homepod_id, &id) < 0 || !id)
+    return -1;
+
+  struct radio_handoff_slot *slot = radio_handoff_find(id);
+  if (action == OUTPUT_PRIMARY_SPOTIFY_PARK_PREPARE)
+    {
+      if (request->token[0] || request->route.device_id)
+        return -1;
+      if (slot && radio_primary_park_binding_equal(request, &slot->result.command, false))
+        {
+          if (radio_handoff_fault)
+            return -1;
+          result = slot->result; /* A repeated prepare only observes its existing claim. */
+          goto reply;
+        }
+      if (radio_transport_identity_get(id, &command.identity, true) < 0
+          || db_attention_base_get(id, &command.initial_volume_percent) != 0)
+        return -1;
+      command.native_owner = request->owner;
+      command.writer = request->writer;
+      command.generation = request->native_revision;
+      command.native_revision = request->native_revision;
+      command.source_owner_epoch = request->writer.source_epoch;
+      command.radio_owner_epoch = command.identity.session_epoch;
+      memcpy(command.handoff_id, request->action, sizeof(command.handoff_id));
+      memcpy(command.radio_process, command.identity.process, sizeof(command.radio_process));
+      snprintf(command.sender_peer, sizeof(command.sender_peer), "%s", RADIO_PRIMARY_SPOTIFY_PARK_PEER);
+    }
+  else
+    {
+      if (!slot || !transport_hex(request->token, 32)
+          || !radio_primary_park_binding_equal(request, &slot->result.command, true))
+        return -1;
+      command = slot->result.command;
+    }
+
+  if (radio_handoff_execute(action, &command, &result, true) < 0)
+    return -1;
