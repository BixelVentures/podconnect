+  *out = (struct output_primary_spotify_park_result) {
+    .binding = {
+      .owner = result.command.native_owner, .writer = result.command.writer,
+      .route = result.command.identity, .native_revision = result.command.native_revision,
+    },
+    .requires_native_pause = result.requires_native_pause,
+  };
