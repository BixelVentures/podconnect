+    {
+    case OUTPUT_RADIO_PREPARED:
+      out->phase = OUTPUT_PRIMARY_SPOTIFY_PARK_PREPARED;
+      break;
+    case OUTPUT_RADIO_STOPPING:
+      out->phase = OUTPUT_PRIMARY_SPOTIFY_PARK_PENDING;
+      break;
+    case OUTPUT_RADIO_SUSPENDED:
+      out->phase = OUTPUT_PRIMARY_SPOTIFY_PARK_PARKED;
+      out->stop_cseq = result.stop_cseq;
+      break;
+    default:
+      out->phase = OUTPUT_PRIMARY_SPOTIFY_PARK_UNKNOWN;
+      break;
+    }
+  return 0;
+}
