+      && native_owner_equal(&request->owner, &retained->native_owner)
+      && queue_writer_equal(&request->writer, &retained->writer)
+      && !strcmp(request->action, retained->handoff_id)
+      && request->native_revision == retained->native_revision
+      && (!complete || (transport_identity_equal(&request->route, &retained->identity)
+          && !strcmp(request->token, retained->token)));
