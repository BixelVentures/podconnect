diff --git a/daemon/radio_primary_orphan.go b/daemon/radio_primary_orphan.go
new file mode 100644
--- /dev/null
+++ b/daemon/radio_primary_orphan.go
@@ -0,0 +1,61 @@
+package daemon
+
+import (
+	"context"
+	"net/http"
+	"strings"
+	"time"
+)
+
+// C owns primary radio custody. A restored or in-memory unknown primary park in
+// Native is only a cache of it: when C reports that it no longer holds that park
+// (released as orphaned after peer loss or a process restart), Native drops its
+// copy instead of keeping the output locked. A live park is never dropped: C
+// keeps listing its handoff id while a radio session or open writer exists.
+func (app *App) releaseOrphanedPrimaryParks() {
+	if app == nil || app.cfg == nil || app.cfg.RoomTransportOwnToneURL == "" || app.cfg.RadioHandoffControlToken == "" {
+		return
+	}
+	type candidate struct {
+		room    string
+		hold    *radioHold
+		device  string
+		handoff string
+	}
+	var candidates []candidate
+	app.radio.mu.Lock()
+	for room, h := range app.radio.Holds {
+		if h != nil && h.owner == nil && h.primary == nil && h.Phase == "unknown" && h.PrimaryPark != nil &&
+			h.WriterParked && h.Primary != nil && validPrimaryRadioHold(h) && h.Request.TargetID == room {
+			candidates = append(candidates, candidate{room, h, h.Primary.DeviceID, h.Request.HandoffID})
+		}
+	}
+	app.radio.mu.Unlock()
+	for _, c := range candidates {
+		ctx, cancel := context.WithTimeout(context.Background(), 3*time.Second)
+		var capability radioPrimaryCapability
+		endpoint := strings.TrimSuffix(app.cfg.RoomTransportOwnToneURL, "/") + "/api/outputs/" + c.device + "/radio-handoff/primary-readiness"
+		err := radioControlHTTP(ctx, http.MethodGet, endpoint, app.cfg.RadioHandoffControlToken, nil, &capability)
+		cancel()
+		// Only an explicit, current answer that names no park (or another park) releases.
+		if err != nil || !capability.valid(c.device) || capability.ParkHandoff == nil || *capability.ParkHandoff == c.handoff {
+			continue
+		}
+		app.radio.mu.Lock()
+		if !app.radio.failed && app.radio.Holds[c.room] == c.hold && c.hold.Phase == "unknown" && c.hold.WriterParked &&
+			c.hold.Request.HandoffID == c.handoff {
+			delete(app.radio.Holds, c.room)
+			app.radio.Intent++
+			if err := app.persistRadioLocked(); err != nil {
+				app.radio.Holds[c.room] = c.hold
+				app.radio.Intent--
+			} else {
+				app.refreshRadioOutputFenceLocked()
+				if app.log != nil {
+					app.log.Warnf("radio_primary_park_released reason=owner_released_by_c")
+				}
+			}
+		}
+		app.radio.mu.Unlock()
+	}
+}
