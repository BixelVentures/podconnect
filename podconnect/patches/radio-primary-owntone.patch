+            }
+        }
+    }
+
+  out->phase = resume->phase;
+  if (out->phase == OUTPUT_RADIO_REACQUIRE_OPENED)
+    {
+      struct output_transport_identity actual;
+      if (!slot->primary_return_revoked && d
+          && radio_reacquired_current(id, d->incarnation, d->session_epoch, d->session, true)
+          && radio_transport_identity_get(id, &actual, true) == 0
+          && transport_identity_equal(&actual, &resume->route_identity))
