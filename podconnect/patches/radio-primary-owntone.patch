+static int
+jsonapi_reply_primary_radio_stop(struct httpd_request *hreq, json_object *body)
+{
+  struct output_primary_radio_custody expected = { 0 }, actual;
+  char phase[24], action[37];
+  uint64_t path_device;
+  json_object *reply;
+
+  if (outputs_radio_sender_role() || json_object_object_length(body) != 9
+      || !transport_json_string(body, "phase", phase, sizeof(phase))
+      || (strcmp(phase, "claim_stop") && strcmp(phase, "result")
+          && strcmp(phase, "claim_stop_replace") && strcmp(phase, "result_stop_replace"))
+      || !transport_json_string(body, "process", expected.process, sizeof(expected.process))
+      || !transport_json_string(body, "operation", expected.operation, sizeof(expected.operation))
+      || !transport_json_string(body, "action", action, sizeof(action))
+      || transport_native_counter(body, "device_id", &expected.device_id) < 0
+      || transport_native_counter(body, "incarnation", &expected.incarnation) < 0
+      || transport_native_counter(body, "session_epoch", &expected.epoch) < 0
+      || transport_native_counter(body, "route_revision", &expected.route) < 0
+      || safe_atou64(hreq->path_parts[2], &path_device) < 0 || path_device != expected.device_id)
+    return HTTP_BADREQUEST;
+  bool claim = !strcmp(phase, "claim_stop") || !strcmp(phase, "claim_stop_replace");
+  bool replace = !strcmp(phase, "claim_stop_replace") || !strcmp(phase, "result_stop_replace");
+  int outcome = player_radio_primary_stop(claim, replace, &expected, action, &actual);
+  if (outcome < 0)
+    return 409;
+  reply = json_object_new_object();
+  if (!reply)
+    return HTTP_SERVUNAVAIL;
+  json_object_object_add(reply, "schema", json_object_new_string("podconnect.output_radio_primary_stop.v1"));
+  const char *result_phase = outcome > 0 ? "replacement_rejected" : actual.teardown_cseq > 0 ? "released" : "pending";
+  json_object_object_add(reply, "phase", json_object_new_string(result_phase));
+  json_object_object_add(reply, "process", json_object_new_string(actual.process));
+  json_object_object_add(reply, "operation", json_object_new_string(actual.operation));
+  json_object_object_add(reply, "action", json_object_new_string(actual.stop_action));
+  attention_json_u64(reply, "device_id", actual.device_id);
+  attention_json_u64(reply, "incarnation", actual.incarnation);
+  attention_json_u64(reply, "session_epoch", actual.epoch);
+  attention_json_u64(reply, "route_revision", actual.route);
+  json_object_object_add(reply, "teardown_cseq", json_object_new_int(actual.teardown_cseq));
+  return transport_json_reply(hreq, reply);
+}
