+}
+
+bool
+outputs_primary_spotify_park_attach_current(const struct output_primary_radio_start_request *request,
+    const char *token)
+{
+  struct output_device *d = outputs_device_get(request->device_id);
+  struct radio_handoff_slot *slot = radio_handoff_find(request->device_id);
+  if (!primary_spotify_park_attach_allowed(slot, d, token))
+    return false;
+  const struct output_radio_handoff_request *park = &slot->result.command;
+  const struct output_transport_identity *old = &park->identity;
+  return !strcmp(request->process, old->process) && !strcmp(request->action, park->handoff_id)
+      && request->incarnation == old->device_incarnation && request->epoch == old->session_epoch
+      && request->route == old->route_revision && primary_spotify_park_writer_closed(slot);
+}
+
+static bool
+primary_spotify_park_stopped_current(const struct radio_handoff_slot *slot, const struct output_device *d,
+    const struct output_primary_radio_custody *released)
+{
+  if (!primary_spotify_park_scope_current(slot, d) || !slot->primary_session
+      || !outputs_primary_radio_session_equal(released, &slot->primary_route))
+    return false;
+  const struct output_transport_identity *old = &slot->result.command.identity;
+  return d->advertised && !d->selected && !d->session && released->epoch < UINT64_MAX - 2
+      && d->session_epoch == released->epoch + 1 && d->route_revision == old->route_revision + 1
+      && transport_selection_revision == old->selection_revision + 2
+      && slot->result.resume.phase == OUTPUT_RADIO_REACQUIRE_NONE
+      && primary_spotify_park_writer_closed(slot) && outputs_primary_radio_release_current(released);
+}
+
+bool
+outputs_primary_spotify_park_stopped_current(const struct output_primary_radio_custody *released)
+{
+  return released && primary_spotify_park_stopped_current(radio_handoff_find(released->device_id),
+      outputs_device_get(released->device_id), released);
+}
+
+bool
+outputs_primary_spotify_park_replace_current(const struct output_primary_radio_start_request *request,
+    const struct output_primary_radio_custody *released, const char *token)
+{
+  struct output_device *d = outputs_device_get(request->device_id);
+  struct radio_handoff_slot *slot = radio_handoff_find(request->device_id);
+  return token && primary_spotify_park_stopped_current(slot, d, released)
+      && !strcmp(token, slot->result.command.token) && !strcmp(request->process, released->process)
+      && outputs_primary_radio_session_equal(released, &request->predecessor)
+      && request->device_id == released->device_id && request->incarnation == released->incarnation
+      && request->epoch == released->epoch + (request->prior_release.device_id != 0) && request->route == released->route;
+}
+
+bool
+outputs_primary_spotify_park_session_current(uint64_t id, const void *session, uint64_t generation, bool teardown)
+{
+  struct output_device *d = outputs_device_get(id);
+  struct radio_handoff_slot *slot = radio_handoff_find(id);
+  if (!primary_spotify_park_scope_current(slot, d) || !session || slot->primary_session != session
+      || d->session != session || slot->result.effect_generation != generation)
+    return false;
+  const struct output_transport_identity *old = &slot->result.command.identity;
+  return d->session_epoch == slot->primary_route.epoch
+      && (teardown || (d->advertised && !d->selected && d->route_revision == old->route_revision + 1
+          && transport_selection_revision == old->selection_revision + 2));
+}
+
+bool
+outputs_primary_spotify_park_wire_current(uint64_t id, const void *session, uint64_t generation)
+{
+  return outputs_primary_spotify_park_session_current(id, session, generation, false)
+      && primary_spotify_park_writer_closed(radio_handoff_find(id));
+}
