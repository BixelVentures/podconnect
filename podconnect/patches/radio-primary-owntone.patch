+/* Only the retired canonical predecessor in a previous kernel boot can
+ * migrate from the add-on's private, nonpersistent legacy filesystem. */
+static bool
+start_cold_legacy_unreachable(const struct output_start_request *pipe, struct stat *current)
+{
+  struct stat fence, legacy;
+  char boot[37];
+  unsigned char hash[32];
+  char digest[65];
+  static const char hex[] = "0123456789abcdef";
+  if (strcmp(pipe->expected_input_path, START_LEGACY_FIFO))
+    return false;
+  gcry_md_hash_buffer(GCRY_MD_SHA256, hash, START_LEGACY_FIFO, strlen(START_LEGACY_FIFO));
+  for (size_t i = 0; i < sizeof(hash); i++)
+    {
+      digest[2 * i] = hex[hash[i] >> 4];
+      digest[2 * i + 1] = hex[hash[i] & 15];
+    }
+  digest[64] = 0;
+  return !strcmp(pipe->expected_input_path_digest, digest)
+      && start_boot_id(boot) && strcmp(boot, start_journal.boot_id)
