+static int
+jsonapi_reply_primary_radio_start(struct httpd_request *hreq, json_object *body)
+{
+  static const char *const names[] = {
+    "target", "start", "result", "cancel", "preflight_target", "preflight", "activate",
+    "preflight_replace_target", "preflight_replace", "activate_replace", "readiness",
+  };
+  struct output_primary_radio_start_request request = { 0 };
+  struct output_primary_radio_start_result result = { 0 };
+  struct output_primary_radio_custody released = { 0 };
+  char phase[32], park_token[33];
+  uint64_t path_device;
+  int action = -1;
+
+  if (outputs_radio_sender_role()
+      || !transport_json_string(body, "phase", phase, sizeof(phase))
+      || transport_native_counter(body, "device_id", &request.device_id) < 0
+      || safe_atou64(hreq->path_parts[2], &path_device) < 0 || path_device != request.device_id)
+    return HTTP_BADREQUEST;
+  for (size_t i = 0; i < ARRAY_SIZE(names); i++)
+    if (!strcmp(phase, names[i]))
+      action = (int)i;
+  bool read_target = action == 0 || action == 4 || action == 7;
+  bool replace = action >= 7 && action <= 9;
+  json_object *field;
+  bool has_predecessor = json_object_object_get_ex(body, "predecessor", &field);
+  bool has_token = json_object_object_get_ex(body, "park_token", &field);
+  bool has_release = json_object_object_get_ex(body, "predecessor_release", &field);
+  if (action < 0 || (replace && !has_predecessor)
+      || (has_predecessor && !replace && action != 2 && action != 3 && action != 10)
+      || (action == 6 && !has_token) || (has_token && action != 6 && action != 9)
+      || (action == 9 && !has_release)
+      || (has_release && (!has_predecessor || (!replace && action != 2 && action != 3 && action != 10)))
+      || json_object_object_length(body) != (read_target ? 3 : 10) + has_predecessor + has_token + has_release
+      || (has_token && !transport_json_string(body, "park_token", park_token, sizeof(park_token)))
+      || (has_predecessor && primary_radio_station_custody_parse(body, "predecessor", &request.predecessor, false) < 0)
+      || (has_release && primary_radio_station_custody_parse(body, "predecessor_release", &released, true) < 0))
+    return HTTP_BADREQUEST;
+  if (!read_target && (!transport_json_string(body, "process", request.process, sizeof(request.process))
+      || !transport_json_string(body, "action", request.action, sizeof(request.action))
+      || !transport_json_string(body, "station_id", request.station, sizeof(request.station))
+      || transport_native_counter(body, "incarnation", &request.incarnation) < 0
+      || transport_native_counter(body, "session_epoch", &request.epoch) < 0
+      || transport_native_counter(body, "route_revision", &request.route) < 0
+      || transport_native_counter(body, "generation", &request.generation) < 0
+      || !request.generation || request.generation == UINT64_MAX))
+    return HTTP_BADREQUEST;
+  /* Live replacement binds its original live snapshot at activate. A
+   * stopped start binds the distinct idle snapshot one epoch later. */
+  if (has_release && (action != 9 || (request.device_id == request.predecessor.device_id
+      && request.predecessor.epoch < UINT64_MAX && request.epoch == request.predecessor.epoch + 1)))
+    request.prior_release = released;
+  if (player_radio_primary_station(action, &request, &result, has_token ? park_token : NULL,
+      has_release ? &released : NULL) < 0)
+    return 409;
+
+  const char *result_phase = "unknown";
+  if (read_target)
+    result_phase = "target_ready";
+  else if (result.phase == OUTPUT_PRIMARY_RADIO_START_PENDING)
+    result_phase = "pending";
+  else if (result.phase == OUTPUT_PRIMARY_RADIO_START_DECODED)
+    result_phase = "decoded";
+  else if (result.phase == OUTPUT_PRIMARY_RADIO_START_OBSERVED)
+    result_phase = "playing";
+  else if (result.phase == OUTPUT_PRIMARY_RADIO_START_REJECTED)
+    result_phase = "rejected";
+
+  json_object *reply = json_object_new_object();
+  if (!reply)
+    return HTTP_SERVUNAVAIL;
+  json_object_object_add(reply, "schema", json_object_new_string("podconnect.output_radio_primary_start.v1"));
+  json_object_object_add(reply, "phase", json_object_new_string(result_phase));
+  json_object_object_add(reply, "process", json_object_new_string(request.process));
+  attention_json_u64(reply, "device_id", request.device_id);
+  attention_json_u64(reply, "incarnation", request.incarnation);
+  attention_json_u64(reply, "session_epoch", request.epoch);
+  attention_json_u64(reply, "route_revision", request.route);
+  if (!read_target)
+    {
+      json_object_object_add(reply, "action", json_object_new_string(request.action));
+      json_object_object_add(reply, "station_id", json_object_new_string(request.station));
+      attention_json_u64(reply, "generation", request.generation);
+    }
+  if ((has_predecessor && primary_radio_station_custody_reply(reply, "predecessor", &request.predecessor) < 0)
+      || (result.phase == OUTPUT_PRIMARY_RADIO_START_OBSERVED && !read_target
+          && primary_radio_station_custody_reply(reply, "target_session", &result.custody) < 0))
+    {
+      json_object_put(reply);
+      return HTTP_SERVUNAVAIL;
+    }
+  return transport_json_reply(hreq, reply);
+}
