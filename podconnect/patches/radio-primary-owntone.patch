+      if (!primary_spotify_return_fresh_writer(writer, &slot->result.command.writer))
+        return -1;
+      if (resume->phase == OUTPUT_RADIO_REACQUIRE_OPENED || (action == OUTPUT_PRIMARY_SPOTIFY_RETURN_BARRIER
+          && resume->phase == OUTPUT_RADIO_REACQUIRE_BARRIER_READY))
+        {
+          if (!queue_writer_equal(writer, &resume->command.current_writer))
+            return -1;
+        }
+      else
+        {
+          struct output_transport_identity actual;
+          if (!d || !primary_spotify_return_route_current(id, d->session, slot->result.effect_generation)
+              || !outputs_airplay_primary_spotify_session_current(d, d->session)
+              || !outputs[d->type]->device_start_drained || !outputs[d->type]->device_start_drained(d)
+              || radio_transport_identity_get(id, &actual, true) < 0
+              || !transport_identity_equal(&actual, &resume->route_identity))
+            return -1;
+          if (action == OUTPUT_PRIMARY_SPOTIFY_RETURN_BARRIER)
+            {
+              if (resume->phase != OUTPUT_RADIO_REACQUIRE_ROUTE_READY
+                  || !primary_spotify_return_reader_current(start_active, old)
+                  || !radio_reacquire_live_source(slot, writer, true))
+                return -1;
+              resume->command.current_writer = *writer;
+              resume->writer_barrier_verified = true;
+              resume->phase = OUTPUT_RADIO_REACQUIRE_BARRIER_READY;
+              if (radio_handoff_save() < 0)
+                {
+                  radio_reacquire_unknown(slot);
+                  return -1;
+                }
+            }
+          else
+            {
+              if (resume->phase != OUTPUT_RADIO_REACQUIRE_BARRIER_READY || !resume->writer_barrier_verified
+                  || !queue_writer_equal(writer, &resume->command.current_writer)
+                  || !radio_reacquire_live_source(slot, writer, false) || slot->result.effect_generation == UINT64_MAX)
