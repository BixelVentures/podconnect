+bool
+outputs_primary_spotify_return_constructor_current(uint64_t id)
+{
+  return id && primary_spotify_return_scope == id;
+}
+
+static bool
+primary_spotify_return_release_current(const struct output_primary_radio_custody *radio,
+    const struct radio_handoff_slot *slot)
+{
+  const struct output_transport_identity *old = &slot->result.command.identity;
+  return radio->device_id == old->device_id && radio->incarnation == old->device_incarnation
+      && radio->epoch >= old->session_epoch + 2 && (radio->epoch - old->session_epoch) % 2 == 0
+      && radio->route == old->route_revision + 1 && !strcmp(radio->process, old->process)
+      && (!slot->primary_session || outputs_primary_radio_session_equal(radio, &slot->primary_route))
+      && outputs_primary_radio_release_current(radio);
+}
+
+static bool
+primary_spotify_return_reader_current(const struct start_slot *spotify, const struct output_transport_identity *old)
+{
+  struct input_fifo_publication reader;
+  return input_fifo_reader_snapshot(&reader) == 0 && reader.item_id == old->input_item_id
+      && reader.device == spotify->result.pipe_device && reader.inode == spotify->result.pipe_inode
+      && reader.epoch == spotify->result.input_epoch
+      && !strcmp(reader.path, spotify->result.command.expected_input_path)
+      && input_fifo_reader_snapshot_current(&reader);
+}
+
+static bool
+primary_spotify_return_source_current(const struct radio_handoff_slot *slot, const struct output_device *d,
+    const struct output_primary_spotify_return_request *request, bool writer_closed)
+{
+  struct output_transport_identity source;
+  int base_volume;
+  if (!primary_spotify_park_scope_current(slot, d) || !slot->primary_session
+      || d->attention_lease || d->attention_retiring_session || d->attention_restart_pending)
+    return false;
+  const struct output_transport_identity *old = &slot->result.command.identity;
+  return request->radio.epoch < UINT64_MAX - 2 && old->route_revision < UINT64_MAX - 2
+      && old->selection_revision < UINT64_MAX - 3
+      && primary_spotify_return_release_current(&request->radio, slot)
+      && radio_transport_identity_get(d->id, &source, false) == 0 && radio_reacquire_source_equal(old, &source)
+      && d->base_revision && db_attention_base_get(d->id, &base_volume) == 0
+      && base_volume == d->volume && base_volume == slot->result.command.initial_volume_percent
+      && primary_spotify_park_source_retained(slot)
+      && (!writer_closed || (primary_spotify_park_writer_closed(slot)
+          && primary_spotify_return_reader_current(start_active, old)));
+}
+
+static bool
+primary_spotify_return_route_current(uint64_t id, const void *session, uint64_t generation)
+{
+  struct radio_handoff_slot *slot = radio_handoff_find(id);
+  struct output_device *d = outputs_device_get(id);
+  if (!slot || !d || !session || d->session != session || slot->resume_session != session
+      || !slot->primary_return.intent[0] || slot->primary_return_revoked || generation != slot->result.effect_generation
+      || (slot->result.resume.phase != OUTPUT_RADIO_REACQUIRE_CONNECTING
+          && slot->result.resume.phase != OUTPUT_RADIO_REACQUIRE_ROUTE_READY
+          && slot->result.resume.phase != OUTPUT_RADIO_REACQUIRE_BARRIER_READY)
+      || !radio_primary_park_sole_selected(d))
+    return false;
+  const struct output_transport_identity *old = &slot->result.command.identity;
+  return d->session_epoch == slot->primary_return.radio.epoch + 2 && d->route_revision == old->route_revision + 2
+      && transport_selection_revision == old->selection_revision + 3
+      && primary_spotify_return_source_current(slot, d, &slot->primary_return,
+          slot->result.resume.phase == OUTPUT_RADIO_REACQUIRE_CONNECTING);
+}
+
+bool
+outputs_primary_spotify_return_wire_current(uint64_t id, const void *session, uint64_t generation)
+{
+  struct radio_handoff_slot *slot = radio_handoff_find(id);
+  if (!slot || !session || slot->resume_session != session || generation != slot->result.effect_generation
+      || slot->result.resume.phase != OUTPUT_RADIO_REACQUIRE_CONNECTING)
+    return false;
+  if (primary_spotify_return_route_current(id, session, generation))
+    return true;
+  slot->primary_return_revoked = true;
+  return false;
+}
+
+static bool
+primary_spotify_return_fresh_writer(const struct output_queue_writer *writer, const struct output_queue_writer *parked)
+{
+  return radio_handoff_uuid(writer->native_process.boot_id)
+      && strnlen(writer->input_path_digest, sizeof(writer->input_path_digest)) == 64
+      && !strcmp(writer->native_process.boot_id, parked->native_process.boot_id)
+      && writer->native_process.pid == parked->native_process.pid
+      && writer->native_process.proc_start_ticks == parked->native_process.proc_start_ticks
+      && writer->pipe_device == parked->pipe_device && writer->pipe_inode == parked->pipe_inode
+      && writer->source_epoch == parked->source_epoch && writer->open_generation > parked->open_generation
+      && writer->open_generation != UINT64_MAX && !strcmp(writer->input_path_digest, parked->input_path_digest);
+}
+
+static void
+primary_spotify_return_connected(struct output_device *d, enum output_device_state state)
+{
+  struct radio_handoff_slot *slot = d ? radio_handoff_find(d->id) : NULL;
+  if (!slot || slot->result.resume.phase != OUTPUT_RADIO_REACQUIRE_CONNECTING || !slot->primary_return.intent[0])
+    return;
+  struct output_radio_reacquire_result *resume = &slot->result.resume;
+  if (state < OUTPUT_STATE_CONNECTED
+      || !outputs_primary_spotify_return_wire_current(d->id, d->session, slot->result.effect_generation)
+      || !outputs_airplay_primary_spotify_session_current(d, d->session)
+      || !outputs[d->type]->device_start_drained || !outputs[d->type]->device_start_drained(d)
+      || radio_transport_identity_get(d->id, &resume->route_identity, true) < 0)
+    {
+      radio_reacquire_unknown(slot);
+      return;
+    }
+  resume->phase = OUTPUT_RADIO_REACQUIRE_ROUTE_READY;
+  if (radio_handoff_save() < 0)
+    radio_reacquire_unknown(slot);
+}
+
+int
+outputs_primary_spotify_return(enum output_primary_spotify_return_action action,
+    const struct output_primary_spotify_return_request *request, struct output_primary_spotify_return_result *out)
+{
+  uint64_t id;
+  if (!request || !out || action < OUTPUT_PRIMARY_SPOTIFY_RETURN_CONSUME || action > OUTPUT_PRIMARY_SPOTIFY_RETURN_OPEN
+      || !radio_native_source_owner_valid(&request->park.owner)
+      || safe_atou64(request->park.owner.homepod_id, &id) < 0 || !id
+      || !radio_handoff_uuid(request->park.action) || strnlen(request->park.token, sizeof(request->park.token)) != 32
+      || !transport_hex(request->park.token, 32)
+      || !radio_handoff_uuid(request->park.route.process)
+      || strnlen(request->park.route.input_path_digest, sizeof(request->park.route.input_path_digest)) != 64
+      || !transport_hex(request->park.route.input_path_digest, 64)
+      || !radio_handoff_uuid(request->park.writer.native_process.boot_id)
+      || strnlen(request->park.writer.input_path_digest, sizeof(request->park.writer.input_path_digest)) != 64
+      || !transport_hex(request->park.writer.input_path_digest, 64)
+      || !radio_handoff_uuid(request->intent) || request->native_revision == UINT64_MAX
+      || request->native_revision <= request->park.native_revision || !radio_handoff_uuid(request->radio.process)
+      || !radio_handoff_uuid(request->radio.operation) || !radio_handoff_uuid(request->radio.stop_action))
+    return -1;
+  struct radio_handoff_slot *slot = radio_handoff_find(id);
+  if (!slot || !radio_primary_park_binding_equal(&request->park, &slot->result.command, true))
+    return -1;
+  struct output_radio_reacquire_result *resume = &slot->result.resume;
+  struct output_device *d = outputs_device_get(id);
+  const struct output_transport_identity *old = &slot->result.command.identity;
+  *out = (struct output_primary_spotify_return_result) { .binding = *request };
+
+  if (!slot->primary_return.intent[0])
+    {
+      /* A restarted process can establish neither the saved pause nor the
+       * one-time local route. Even its exact historical STOP grants no retry. */
+      if (action == OUTPUT_PRIMARY_SPOTIFY_RETURN_RESULT && slot->result.phase == OUTPUT_RADIO_UNKNOWN
+          && resume->command.native_revision == request->native_revision
+          && !strcmp(resume->command.intent_id, request->intent)
+          && primary_spotify_return_release_current(&request->radio, slot))
+        {
+          out->phase = OUTPUT_RADIO_REACQUIRE_UNKNOWN;
+          return 0;
+        }
+      if (action != OUTPUT_PRIMARY_SPOTIFY_RETURN_CONSUME || resume->phase != OUTPUT_RADIO_REACQUIRE_NONE
+          || !primary_spotify_return_source_current(slot, d, request, true) || d->selected || d->session
+          || d->session_epoch != request->radio.epoch + 1 || d->route_revision != old->route_revision + 1
+          || transport_selection_revision != old->selection_revision + 2 || primary_spotify_return_scope)
+        return -1;
+      if (!start_retirement_reader(start_active, old)
+          || !primary_spotify_return_source_current(slot, d, request, true))
+        return -1;
+      for (struct output_device *other = outputs_device_list; other; other = other->next)
+        if (other->selected)
+          return -1;
+      slot->primary_return = *request;
+      resume->command.hold = slot->result.command;
+      resume->command.current_native_owner = request->park.owner;
+      resume->command.intended_native_owner = request->park.owner;
+      resume->command.current_writer = request->park.writer;
+      resume->command.current_source_identity = *old;
+      memcpy(resume->command.intent_id, request->intent, sizeof(resume->command.intent_id));
+      resume->command.native_revision = request->native_revision;
+      resume->pause_native = true;
+      resume->phase = OUTPUT_RADIO_REACQUIRE_CONSUMED;
+      if (radio_handoff_save() < 0)
+        {
+          radio_reacquire_unknown(slot);
+          return -1;
+        }
+      resume->phase = OUTPUT_RADIO_REACQUIRE_CONNECTING;
+      if (radio_handoff_save() < 0)
+        {
+          radio_reacquire_unknown(slot);
+          return -1;
+        }
+
+      primary_spotify_return_scope = id;
+      outputs_device_select(d, -1);
+      int started = radio_primary_park_sole_selected(d) && d->route_revision == old->route_revision + 2
+          && transport_selection_revision == old->selection_revision + 3
+          && primary_spotify_return_source_current(slot, d, request, true)
+        ? outputs_device_start(d, primary_spotify_return_connected, false) : -1;
+      primary_spotify_return_scope = 0;
+      if (started <= 0)
