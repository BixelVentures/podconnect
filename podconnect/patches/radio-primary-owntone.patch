+outputs_primary_radio_custody_begin(uint64_t id, uint64_t incarnation, uint64_t epoch, uint64_t route,
+    const char *action, const struct output_primary_radio_custody *predecessor)
+{
+  char key[64], operation[37], *previous = NULL, *pending = NULL;
+  json_object *row;
+
+  if (action && !radio_handoff_uuid(action))
+    return NULL;
+  primary_radio_custody_key(key, id);
+  int found = db_radio_handoff_load_key(key, &previous);
+  if (found < 0 || (found && (!previous || !primary_radio_custody_valid(previous, id, true))))
+    goto done;
+  if (predecessor)
+    {
+      struct output_primary_radio_custody released;
+      if (found != 1 || predecessor->teardown_cseq <= 0 || !primary_radio_custody_decode(previous, id, &released)
+          || !primary_radio_receipt_equal(predecessor, &released))
+        goto done;
+    }
+  row = json_object_new_object();
+  if (!row)
+    goto done;
+  if (!action)
+    outputs_attention_uuid(operation);
+  json_object_object_add(row, "schema", json_object_new_string("podconnect.radio-primary-custody.v1"));
+  json_object_object_add(row, "device", json_object_new_uint64(id));
+  json_object_object_add(row, "process", json_object_new_string(outputs_process));
+  json_object_object_add(row, "operation", json_object_new_string(action ? action : operation));
+  json_object_object_add(row, "incarnation", json_object_new_uint64(incarnation));
+  json_object_object_add(row, "epoch", json_object_new_uint64(epoch));
+  json_object_object_add(row, "route", json_object_new_uint64(route));
+  json_object_object_add(row, "stop_action", json_object_new_string(""));
+  json_object_object_add(row, "teardown_cseq", json_object_new_int(0));
+  const char *raw = json_object_to_json_string_ext(row, JSON_C_TO_STRING_PLAIN);
+  pending = raw ? strdup(raw) : NULL;
+  json_object_put(row);
+  if (pending && (!primary_radio_custody_valid(pending, id, false)
+      || db_radio_handoff_save_key(key, previous, pending) < 0))
+    {
+      free(pending);
+      pending = NULL;
+    }
+
+ done:
+  free(previous);
+  return pending;
+}
+
+int
+outputs_primary_radio_custody_read(uint64_t id, struct output_primary_radio_custody *custody)
+{
+  char key[64], *raw = NULL;
+  primary_radio_custody_key(key, id);
+  int found = db_radio_handoff_load_key(key, &raw);
+  if (found == 1 && !primary_radio_custody_decode(raw, id, custody))
+    found = -1;
+  free(raw);
+  return found;
+}
+
+bool
+outputs_primary_radio_release_current(const struct output_primary_radio_custody *expected)
+{
+  struct output_primary_radio_custody released;
+  return expected && expected->teardown_cseq > 0
+      && outputs_primary_radio_custody_read(expected->device_id, &released) == 1
+      && primary_radio_receipt_equal(expected, &released);
+}
+
+char *
+outputs_primary_radio_custody_claim(uint64_t id, const char *pending, const char *action)
+{
+  char key[64], *claimed = NULL;
+  json_object *row, *previous;
+
+  if (!pending || !action || !radio_handoff_uuid(action) || !primary_radio_custody_valid(pending, id, false))
+    return NULL;
+  row = json_tokener_parse(pending);
+  if (!row)
+    return NULL;
+  if (json_object_object_get_ex(row, "stop_action", &previous) && json_object_get_string_len(previous) == 0)
+    {
+      primary_radio_custody_key(key, id);
+      json_object_object_add(row, "stop_action", json_object_new_string(action));
+      const char *raw = json_object_to_json_string_ext(row, JSON_C_TO_STRING_PLAIN);
+      if (raw && primary_radio_custody_valid(raw, id, false))
+        claimed = strdup(raw);
+      if (claimed && db_radio_handoff_save_key(key, pending, claimed) < 0)
+        {
+          free(claimed);
+          claimed = NULL;
+        }
+    }
+  json_object_put(row);
+  return claimed;
+}
+
+int
+outputs_primary_radio_custody_release(uint64_t id, const char *pending, int teardown_cseq)
+{
+  char key[64];
+  json_object *row = json_tokener_parse(pending);
+  if (!row || teardown_cseq <= 0 || !primary_radio_custody_valid(pending, id, false))
+    {
+      if (row) json_object_put(row);
+      return -1;
+    }
+  primary_radio_custody_key(key, id);
+  json_object_object_add(row, "teardown_cseq", json_object_new_int(teardown_cseq));
+  const char *raw = json_object_to_json_string_ext(row, JSON_C_TO_STRING_PLAIN);
+  int status = raw && primary_radio_custody_valid(raw, id, true) ? db_radio_handoff_save_key(key, pending, raw) : -1;
+  json_object_put(row);
+  return status;
+}
+
+void
+outputs_primary_radio_drain_complete(uint64_t id, uint64_t incarnation, uint64_t epoch, bool confirmed)
+{
+  struct output_device *device = outputs_device_get(id);
+
+  if (!device || device->incarnation != incarnation || device->session
+      || epoch == UINT64_MAX || device->session_epoch != epoch + 1)
+    return;
+  if (!confirmed)
+    attention_restart_cancel(device);
+}
