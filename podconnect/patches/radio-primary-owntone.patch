+/* The deployed census encounters processes under other UIDs. Keep one
+ * actually alive while testing the kernel proof, without access to the FIFO. */
+static pid_t
+start_gate_cold_foreign_process(int *release)
+{
+  if (geteuid() != 0)
+    return 0;
+  int ready[2], done[2];
+  assert(pipe(ready) == 0 && pipe(done) == 0);
+  pid_t child = fork();
+  assert(child >= 0);
+  if (!child)
+    {
+      close(ready[0]);
+      close(done[1]);
+      assert(setgid(65534) == 0 && setuid(65534) == 0);
+      int unrelated = open("/dev/null", O_RDONLY | O_CLOEXEC);
+      char marker;
+      assert(unrelated >= 0 && write(ready[1], "x", 1) == 1 && read(done[0], &marker, 1) == 1);
+      _exit(0);
+    }
+  close(ready[1]);
+  close(done[0]);
+  char marker;
+  assert(read(ready[0], &marker, 1) == 1);
+  close(ready[0]);
+  *release = done[1];
+  return child;
+}
