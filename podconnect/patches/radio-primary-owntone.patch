+struct player_radio_primary_station_command
+{
+  int phase;
+  struct output_primary_radio_start_request *request;
+  struct output_primary_radio_start_result *result;
+  const char *park_token;
+  const struct output_primary_radio_custody *released;
+};
+
+static enum command_state
+radio_primary_station_command(void *arg, int *retval)
+{
+  struct player_radio_primary_station_command *c = arg;
+  switch (c->phase)
+    {
+      case 0:
+        *retval = outputs_airplay_primary_station_target(c->request->device_id, c->request);
+        break;
+      case 1:
+        *retval = outputs_airplay_primary_station_start(c->request, c->result);
+        break;
+      case 2:
+        *retval = outputs_airplay_primary_station_result(c->request, c->result);
+        break;
+      case 3:
+        *retval = outputs_airplay_primary_station_cancel(c->request, c->result);
+        break;
+      case 4:
+        *retval = outputs_airplay_primary_station_preflight_target(c->request->device_id, c->request);
+        break;
+      case 5:
+        *retval = outputs_airplay_primary_station_preflight(c->request, c->result);
+        break;
+      case 6:
+        *retval = outputs_airplay_primary_station_activate(c->request, c->park_token, c->result);
+        break;
+      case 7:
+        *retval = c->released
+          ? outputs_airplay_primary_station_stopped_target(c->request->device_id, &c->request->predecessor, c->released, c->request)
+          : outputs_airplay_primary_station_replace_target(c->request->device_id, &c->request->predecessor, c->request);
+        break;
+      case 8:
+        *retval = outputs_airplay_primary_station_replace_preflight(c->request, c->result);
+        break;
+      case 9:
+        *retval = outputs_airplay_primary_station_replace_activate(c->request, c->released, c->park_token, c->result);
+        break;
+      case 10:
+        *retval = outputs_airplay_primary_station_readiness(c->request, c->result);
+        break;
+      default:
+        *retval = -1;
+        break;
+    }
+  return COMMAND_END;
+}
