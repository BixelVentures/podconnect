+static int
+primary_radio_station_custody_reply(json_object *reply, const char *name, const struct output_primary_radio_custody *custody)
+{
+  json_object *object = json_object_new_object();
+  if (!object)
+    return -1;
+  json_object_object_add(object, "process", json_object_new_string(custody->process));
+  json_object_object_add(object, "operation", json_object_new_string(custody->operation));
+  attention_json_u64(object, "device_id", custody->device_id);
+  attention_json_u64(object, "incarnation", custody->incarnation);
+  attention_json_u64(object, "session_epoch", custody->epoch);
+  attention_json_u64(object, "route_revision", custody->route);
+  json_object_object_add(reply, name, object);
+  return 0;
+}
