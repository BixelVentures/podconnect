+
+/* On the exact opened FIFO, the kernel can answer without reading other
+ * processes. tee never consumes source bytes. A zero result means both an
+ * empty FIFO and no connected writers. */
+static const char *
+start_cold_fifo_kernel_denial(int fd)
+{
+  int probe[2];
+  if (pipe2(probe, O_CLOEXEC | O_NONBLOCK) < 0)
+    return "fifo_probe_unavailable";
+  ssize_t result = tee(fd, probe[1], 1, SPLICE_F_NONBLOCK);
+  int error = errno;
+  close(probe[0]);
+  close(probe[1]);
+  if (result == 0)
+    return NULL;
+  if (result > 0)
+    return "fifo_pcm_pending";
+  return error == EAGAIN ? "writer_present" : "fifo_probe_unavailable";
+}
+
+static const char *
+start_cold_fifo_denial(const char *path, const struct stat *current, uint64_t old_device, uint64_t old_inode)
+{
+  struct stat observed;
+  int fd = open(path, O_RDONLY | O_NONBLOCK | O_CLOEXEC | O_NOFOLLOW);
+  if (fd < 0)
+    return "fifo_open";
+  const char *denial;
+  if (fstat(fd, &observed) != 0 || !S_ISFIFO(observed.st_mode)
+      || observed.st_dev != current->st_dev || observed.st_ino != current->st_ino)
+    {
+      denial = "fifo_identity";
+      goto done;
+    }
+  /* A different inode can still have a writer, even after this path names a
+   * replacement. Only the actual opened inode qualifies for the kernel read. */
+  if (((uint64_t)current->st_dev != old_device || (uint64_t)current->st_ino != old_inode)
+      && (denial = release_fifo_writer_denial(old_device, old_inode)))
+    goto done;
+  denial = start_cold_fifo_kernel_denial(fd);
+  if (denial)
+    goto done;
+  if (stat(path, &observed) != 0 || !S_ISFIFO(observed.st_mode)
+      || observed.st_dev != current->st_dev || observed.st_ino != current->st_ino)
+    denial = "fifo_identity";
+  else if (!start_contexts_drained())
+    denial = "scope_busy";
+ done:
+  close(fd);
+  return denial;
+}
