+/* One producer per attached radio route. Only the player event loop can
+ * consume or emit. The producer never touches the output registry or FIFO. */
+#define PRIMARY_RADIO_PACKET_BYTES (AIRPLAY_SAMPLES_PER_PACKET * 4)
+#define PRIMARY_RADIO_QUEUE_PACKETS 8
+#define PRIMARY_RADIO_MAX_WORKERS 2
+#define PRIMARY_RADIO_PACKET_US 7982
+#define PRIMARY_RADIO_START_LIMIT 32
+#define PRIMARY_RADIO_START_SECONDS 8
+#define PRIMARY_RADIO_READY_SECONDS 2
+
+/* This table and its reservation watermark belong to one primary C process
+ * and only the player loop. The watermark survives eviction, not restart. */
+struct primary_radio_station_operation
+{
+  struct output_primary_radio_start_request request;
+  struct output_primary_radio_start_result result;
+  struct timespec deadline, last_fresh_rtp;
+  struct primary_radio_decode *decoder;
+  struct airplay_primary_radio_route admitted_route;
+  struct output_primary_radio_custody predecessor_release;
+  bool decode_only, released, replacement_stop_rejected;
+  char park_token[33];
+};
+static struct primary_radio_station_operation primary_radio_station_operations[PRIMARY_RADIO_START_LIMIT];
+static uint64_t primary_radio_station_generation;
+/* Only the player starts workers. A detached worker retains its place
+ * until its own transcode cleanup finishes. */
+static atomic_uint primary_radio_decoder_workers;
+
+struct primary_radio_decode
+{
+  struct airplay_session *session; /* player-owned, cleared before dropping owner reference */
+  struct airplay_primary_radio_route route;
+  struct primary_radio_station_operation *operation;
+  const char *url; /* immutable station registry storage */
+  struct event *tick;
+  pthread_mutex_t mutex;
+  pthread_cond_t space;
+  struct timespec stop_deadline; /* Player-owned after exact revocation. */
+  atomic_bool cancelled;
+  atomic_uint refs;
+  bool done;
+  size_t head, count;
+  uint8_t pcm[PRIMARY_RADIO_QUEUE_PACKETS][PRIMARY_RADIO_PACKET_BYTES];
+};
+
+static void
+primary_radio_decode_unref(struct primary_radio_decode *decoder)
+{
+  if (atomic_fetch_sub(&decoder->refs, 1) != 1)
+    return;
+  pthread_cond_destroy(&decoder->space);
+  pthread_mutex_destroy(&decoder->mutex);
+  free(decoder);
+}
+
+static bool
+primary_radio_decode_cancelled(void *arg)
+{
+  struct primary_radio_decode *decoder = arg;
+  return atomic_load(&decoder->cancelled);
+}
+
+static void
+primary_radio_decode_cancel(struct primary_radio_decode *decoder)
+{
+  pthread_mutex_lock(&decoder->mutex);
+  atomic_store(&decoder->cancelled, true);
+  decoder->count = 0;
+  pthread_cond_signal(&decoder->space);
+  pthread_mutex_unlock(&decoder->mutex);
+}
+
+static void
+primary_radio_station_finish(struct primary_radio_station_operation *operation,
+    enum output_primary_radio_start_phase phase)
+{
+  operation->result = (struct output_primary_radio_start_result) { .phase = phase };
+}
+
+static void
+primary_radio_decoder_drop(struct primary_radio_decode *decoder)
+{
+  primary_radio_decode_cancel(decoder);
+  if (decoder->tick)
+    event_free(decoder->tick);
+  if (decoder->operation)
+    {
+      struct primary_radio_station_operation *operation = decoder->operation;
+      operation->decoder = NULL;
+      decoder->operation = NULL;
+      if (operation->result.phase == OUTPUT_PRIMARY_RADIO_START_PENDING
+          || operation->result.phase == OUTPUT_PRIMARY_RADIO_START_DECODED
+          || operation->result.phase == OUTPUT_PRIMARY_RADIO_START_OBSERVED)
+        primary_radio_station_finish(operation, decoder->session
+            ? OUTPUT_PRIMARY_RADIO_START_UNKNOWN : OUTPUT_PRIMARY_RADIO_START_REJECTED);
+    }
+  if (decoder->session)
+    decoder->session->primary_radio_decoder = NULL;
+  decoder->session = NULL;
+  primary_radio_decode_unref(decoder);
+}
+
+static void
+primary_radio_decoder_detach(struct airplay_session *session)
+{
+  if (session->primary_radio_decoder)
+    primary_radio_decoder_drop(session->primary_radio_decoder);
+}
+
+static void *
+primary_radio_decode_thread(void *arg)
+{
+  struct primary_radio_decode *decoder = arg;
+  struct media_quality quality = { 44100, 16, 2 };
+  struct transcode_decode_setup_args input = {
+    .profile = XCODE_PCM_NATIVE, .path = decoder->url,
+    .is_http = !strncmp(decoder->url, "https://", 8),
+    .cancelled = primary_radio_decode_cancelled, .cancelled_arg = decoder,
+  };
+  struct transcode_encode_setup_args output = { .profile = XCODE_PCM16, .quality = &quality };
+  struct transcode_ctx *stream = transcode_setup(input, output);
+  struct evbuffer *buffer = evbuffer_new();
+
+  while (stream && buffer && !primary_radio_decode_cancelled(decoder))
+    {
+      if (evbuffer_get_length(buffer) < PRIMARY_RADIO_PACKET_BYTES)
+        {
+          if (transcode(buffer, NULL, stream, 1) <= 0)
+            break;
+          continue;
+        }
+
+      pthread_mutex_lock(&decoder->mutex);
+      while (decoder->count == PRIMARY_RADIO_QUEUE_PACKETS && !primary_radio_decode_cancelled(decoder))
+        pthread_cond_wait(&decoder->space, &decoder->mutex);
+      if (!primary_radio_decode_cancelled(decoder))
+        {
+          size_t tail = (decoder->head + decoder->count) % PRIMARY_RADIO_QUEUE_PACKETS;
+          evbuffer_remove(buffer, decoder->pcm[tail], PRIMARY_RADIO_PACKET_BYTES);
+          decoder->count++;
+        }
+      pthread_mutex_unlock(&decoder->mutex);
+    }
+
+  if (stream) transcode_cleanup(&stream);
+  if (buffer) evbuffer_free(buffer);
+#ifdef PRIMARY_RADIO_DECODER_TEST_BEFORE_DONE
+  PRIMARY_RADIO_DECODER_TEST_BEFORE_DONE();
+#endif
+  pthread_mutex_lock(&decoder->mutex);
+  decoder->done = true;
+  pthread_mutex_unlock(&decoder->mutex);
+  primary_radio_decode_unref(decoder);
+  atomic_fetch_sub(&primary_radio_decoder_workers, 1);
+  return NULL;
+}
+
+static bool
+primary_radio_before_deadline(struct timespec deadline)
+{
+  struct timespec now;
+  return clock_gettime(CLOCK_MONOTONIC, &now) == 0 && timespec_cmp(now, deadline) < 0;
+}
+
+static bool
+primary_radio_station_before_deadline(const struct primary_radio_station_operation *operation)
+{
+  return primary_radio_before_deadline(operation->deadline);
+}
+
+static bool
+primary_radio_station_current(const struct airplay_session *session)
+{
+  const struct primary_radio_decode *decoder = session->primary_radio_decoder;
+  const struct primary_radio_station_operation *operation = decoder ? decoder->operation : NULL;
+  return !operation || operation->result.phase == OUTPUT_PRIMARY_RADIO_START_OBSERVED
+      || (operation->result.phase == OUTPUT_PRIMARY_RADIO_START_PENDING
+          && primary_radio_station_before_deadline(operation)
+          && (!operation->request.predecessor.device_id || session->primary_radio_custody
+              || outputs_primary_radio_release_current(&operation->predecessor_release)));
+}
+
+static const char *
+primary_radio_station_action(const struct airplay_session *session)
+{
+  const struct primary_radio_decode *decoder = session->primary_radio_decoder;
+  return decoder && decoder->operation ? decoder->operation->request.action : NULL;
+}
+
+static const struct output_primary_radio_custody *
+primary_radio_station_release(const struct airplay_session *session)
+{
+  const struct primary_radio_decode *decoder = session->primary_radio_decoder;
+  const struct primary_radio_station_operation *operation = decoder ? decoder->operation : NULL;
+  return operation && operation->predecessor_release.device_id ? &operation->predecessor_release : NULL;
+}
+
+static void
+primary_radio_station_packet_sent(struct airplay_session *session)
+{
+  struct primary_radio_decode *decoder = session->primary_radio_decoder;
+  struct primary_radio_station_operation *operation = decoder ? decoder->operation : NULL;
+  struct output_primary_radio_custody custody;
+  struct timespec sent;
+  if (!operation)
+    return;
+  bool timed = clock_gettime(CLOCK_MONOTONIC, &sent) == 0;
+  if (operation->result.phase == OUTPUT_PRIMARY_RADIO_START_OBSERVED)
+    {
+      if (timed)
+        operation->last_fresh_rtp = sent;
+      return;
+    }
+  if (operation->result.phase != OUTPUT_PRIMARY_RADIO_START_PENDING)
+    return;
+  if (!primary_radio_station_before_deadline(operation)
+      || outputs_primary_radio_custody_read(session->device_id, &custody) != 1
+      || strcmp(custody.process, operation->request.process)
+      || strcmp(custody.operation, operation->request.action) || custody.stop_action[0] || custody.teardown_cseq
+      || custody.device_id != decoder->route.device_id || custody.incarnation != decoder->route.incarnation
+      || custody.epoch != decoder->route.epoch || custody.route != decoder->route.revision)
+    {
+      primary_radio_station_finish(operation, OUTPUT_PRIMARY_RADIO_START_UNKNOWN);
+      deferred_session_failure(session);
+      return;
+    }
+  operation->result.phase = OUTPUT_PRIMARY_RADIO_START_OBSERVED;
+  operation->result.custody = custody;
+  if (timed)
+    operation->last_fresh_rtp = sent;
+}
+
+int
+outputs_airplay_primary_station_target(uint64_t id, struct output_primary_radio_start_request *out)
+{
+  extern struct output_definition output_airplay;
+  struct output_device *device = outputs_device_get(id);
+  struct output_attention_state state;
+  if (!out || !device || device->type != OUTPUT_TYPE_AIRPLAY || !device->advertised
+      || device->selected || device->session || device->busy || device->prevent_playback
+      || device->attention_retiring_session || device->attention_restart_pending
+      || !device->extra_device_info || !((struct airplay_extra *)device->extra_device_info)->supports_encryption
+      || output_airplay.disabled || !outputs_primary_radio_transport_available(id) || outputs_start_gate_closed()
+      || outputs_radio_handoff_blocked(id) || outputs_radio_sender_role()
+      || outputs_attention_state_get(id, &state) < 0 || state.lease || state.restoring || !state.recovery_idle
+      || !outputs_primary_radio_custody_available(id))
+    return -1;
+  *out = (struct output_primary_radio_start_request) {
+    .device_id = id, .incarnation = state.device_incarnation,
+    .epoch = state.session_epoch, .route = state.route_revision,
+  };
+  memcpy(out->process, state.process, sizeof(out->process));
+  return 0;
+}
