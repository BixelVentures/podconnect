+/* Authenticated by the existing /radio-handoff route guard. POST carries
+ * structured exact proof only; this entry cannot dispatch an effect. */
+static int
+jsonapi_reply_primary_radio_owner(struct httpd_request *hreq)
+{
+  static const char schema[] = "podconnect.output_primary_radio_owner_observation.v1";
+  char supplied[sizeof(schema)], kind[8];
+  uint64_t id;
+  int ret = HTTP_BADREQUEST;
+  json_object *body = transport_parse_body_limit(hreq->in_body, 4096), *identity = NULL, *reply = NULL;
+  if (!body || outputs_radio_sender_role() || safe_atou64(hreq->path_parts[2], &id) < 0 || !id || id == UINT64_MAX
+      || !transport_json_string(body, "schema", supplied, sizeof(supplied)) || strcmp(supplied, schema)
+      || !transport_json_string(body, "source_kind", kind, sizeof(kind)))
+    goto done;
+  if (!strcmp(kind, "spotify"))
+    {
+      struct output_native_owner owner = { 0 };
+      struct output_queue_writer writer = { 0 };
+      struct output_transport_identity route = { 0 };
+      if (json_object_object_length(body) != 4 || radio_named_owner_parse(body, "native_owner", &owner) < 0
+          || radio_named_writer_parse(body, "writer_proof", &writer) < 0)
+        goto done;
+      ret = 409;
+      if (player_primary_radio_spotify_owner(id, &owner, &writer, &route) < 0)
+        goto done;
+      ret = HTTP_SERVUNAVAIL;
+      identity = transport_identity_json(&route);
+      reply = json_object_new_object();
+      if (!identity || !reply)
+        goto done;
+      json_object_object_add(reply, "native_owner", transport_native_json(&owner));
+      json_object_object_add(reply, "writer_proof", queue_writer_json(&writer));
+      json_object_object_add(reply, "output_identity", identity);
+    }
+  else if (!strcmp(kind, "none"))
+    {
+      struct radio_absence_source source = { 0 };
+      struct output_primary_radio_start_request target = { 0 };
+      if (json_object_object_length(body) != 3 || radio_absence_source_parse(body, &source) < 0 || source.target_absence)
+        goto done;
+      ret = 409;
+      if (player_primary_radio_absent_owner(id, &source, &target) < 0)
+        goto done;
+      ret = HTTP_SERVUNAVAIL;
+      identity = json_object_new_object();
+      reply = json_object_new_object();
+      if (!identity || !reply)
+        goto done;
+      json_object_object_add(identity, "process", json_object_new_string(target.process));
+      attention_json_u64(identity, "device_id", target.device_id);
+      attention_json_u64(identity, "incarnation", target.incarnation);
+      attention_json_u64(identity, "session_epoch", target.epoch);
+      attention_json_u64(identity, "route_revision", target.route);
+      json_object_object_add(reply, "source_absence", radio_absence_source_json(&source));
+      json_object_object_add(reply, "target_identity", identity);
+    }
+  else
+    goto done;
+  identity = NULL; /* Owned by reply. */
+  json_object_object_add(reply, "schema", json_object_new_string(schema));
+  json_object_object_add(reply, "source_kind", json_object_new_string(kind));
+  json_object_object_add(reply, "physical_result_verified", json_object_new_boolean(false));
+  ret = transport_json_reply(hreq, reply);
+  reply = NULL; /* transport_json_reply consumed it. */
+done:
+  if (identity) json_object_put(identity);
+  if (reply) json_object_put(reply);
+  if (body) json_object_put(body);
+  return ret;
+}
