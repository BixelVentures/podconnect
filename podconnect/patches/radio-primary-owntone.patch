+static bool
+primary_radio_station_same_target(const struct output_primary_radio_start_request *a,
+    const struct output_primary_radio_start_request *b)
+{
+  return a->device_id == b->device_id && a->incarnation == b->incarnation
+      && a->epoch == b->epoch && a->route == b->route && !strcmp(a->process, b->process);
+}
+
+static struct airplay_session *
+primary_radio_station_predecessor(const struct output_primary_radio_custody *predecessor)
+{
+  if (!predecessor->device_id || predecessor->teardown_cseq || predecessor->stop_action[0]
+      || strnlen(predecessor->process, sizeof(predecessor->process)) != 36
+      || strnlen(predecessor->operation, sizeof(predecessor->operation)) != 36
+      || strcmp(predecessor->process, outputs_primary_radio_process()))
+    return NULL;
+  struct airplay_primary_radio_route route = {
+    predecessor->device_id, predecessor->incarnation, predecessor->epoch, predecessor->route,
+  };
+  struct airplay_session *session = airplay_primary_radio_session(&route);
+  if (!primary_radio_live(session) || !session->primary_radio_decoder)
+    return NULL;
+  const struct primary_radio_station_operation *operation = session->primary_radio_decoder->operation;
+  struct output_primary_radio_custody actual;
+  if (!operation || operation->result.phase != OUTPUT_PRIMARY_RADIO_START_OBSERVED
+      || !outputs_primary_radio_session_equal(predecessor, &operation->result.custody)
+      || outputs_primary_radio_custody_read(predecessor->device_id, &actual) != 1
+      || actual.teardown_cseq || actual.stop_action[0] || !outputs_primary_radio_session_equal(predecessor, &actual))
+    return NULL;
+  return session;
+}
+
+int
+outputs_airplay_primary_station_replace_target(uint64_t id, const struct output_primary_radio_custody *predecessor,
+    struct output_primary_radio_start_request *out)
+{
+  if (!out || !predecessor || !id || outputs_start_gate_closed())
+    return -1;
+  struct airplay_session *session = primary_radio_station_predecessor(predecessor);
+  if (!session)
+    return -1;
+  struct output_primary_radio_custody prior = *predecessor;
+  if (id != prior.device_id)
+    {
+      /* A parked Spotify owner has one exact same-target radio chain. */
+      if (session->primary_spotify_park_generation || outputs_airplay_primary_station_target(id, out) < 0)
+        return -1;
+    }
+  else
+    {
+      if (prior.epoch >= UINT64_MAX - 2)
+        return -1;
+      *out = (struct output_primary_radio_start_request) {
+        .device_id = id, .incarnation = prior.incarnation, .epoch = prior.epoch, .route = prior.route,
+      };
+      memcpy(out->process, prior.process, sizeof(out->process));
+    }
+  out->predecessor = prior;
+  return 0;
+}
+
+static bool
+primary_radio_station_release_matches(const struct output_primary_radio_custody *prior,
+    const struct output_primary_radio_custody *released)
+{
+  return prior && released && prior->device_id && !prior->teardown_cseq && !prior->stop_action[0]
+      && strnlen(prior->process, sizeof(prior->process)) == 36
+      && strnlen(prior->operation, sizeof(prior->operation)) == 36
+      && strnlen(released->process, sizeof(released->process)) == 36
+      && strnlen(released->operation, sizeof(released->operation)) == 36
+      && strnlen(released->stop_action, sizeof(released->stop_action)) == 36 && released->teardown_cseq > 0
+      && outputs_primary_radio_session_equal(prior, released);
+}
+
+int
+outputs_airplay_primary_station_stopped_target(uint64_t id, const struct output_primary_radio_custody *prior,
+    const struct output_primary_radio_custody *released, struct output_primary_radio_start_request *out)
+{
+  if (!out || !primary_radio_station_release_matches(prior, released) || id != released->device_id
+      || outputs_start_gate_closed() || !outputs_primary_spotify_park_stopped_current(released))
+    return -1;
+  for (const struct airplay_session *session = airplay_sessions; session; session = session->next)
+    if (session->primary_radio)
+      return -1;
+  struct output_primary_radio_start_request target = {
+    .device_id = id, .incarnation = released->incarnation, .epoch = released->epoch + 1,
+    .route = released->route, .predecessor = *prior, .prior_release = *released,
+  };
+  memcpy(target.process, released->process, sizeof(target.process));
+  *out = target;
+  return 0;
+}
+
+static int
+primary_radio_station_preflight_current(const struct output_primary_radio_start_request *request,
+    struct output_primary_radio_start_request *current)
+{
+  if (request->prior_release.device_id)
+    return outputs_airplay_primary_station_stopped_target(request->device_id, &request->predecessor,
+        &request->prior_release, current);
+  if (request->predecessor.device_id)
+    return outputs_airplay_primary_station_replace_target(request->device_id, &request->predecessor, current);
+  return outputs_airplay_primary_station_preflight_target(request->device_id, current);
+}
+
+static bool
+primary_radio_station_replace_ready(const struct output_primary_radio_start_request *request,
+    const struct output_primary_radio_custody *released, const char *park_token)
+{
+  if (released->epoch >= UINT64_MAX - 2 || outputs_start_gate_closed()
+      || !outputs_primary_radio_session_equal(&request->predecessor, released)
+      || !outputs_primary_radio_release_current(released))
+    return false;
+  struct output_device *previous = outputs_device_get(released->device_id);
+  if (!previous || !previous->advertised || previous->selected || previous->session
+      || previous->incarnation != released->incarnation || previous->session_epoch != released->epoch + 1
+      || previous->route_revision != released->route)
+    return false;
+  for (const struct airplay_session *session = airplay_sessions; session; session = session->next)
+    if (session->primary_radio)
+      return false;
+
+  if (park_token || request->prior_release.device_id)
+    return request->device_id == previous->id && outputs_primary_spotify_park_replace_current(request, released, park_token);
+  struct output_primary_radio_start_request current, expected = *request;
+  if (request->device_id == previous->id)
+    {
+      if (request->epoch != released->epoch || request->route != released->route
+          || request->incarnation != released->incarnation)
+        return false;
+      expected.epoch++;
+    }
+  return outputs_airplay_primary_station_target(request->device_id, &current) == 0
+      && primary_radio_station_same_target(&expected, &current);
+}
+
+static bool
+primary_radio_decode_frame_ready(struct primary_radio_decode *decoder)
+{
+  pthread_mutex_lock(&decoder->mutex);
+  bool ready = decoder->count > 0 && !primary_radio_decode_cancelled(decoder);
+  pthread_mutex_unlock(&decoder->mutex);
+  return ready;
+}
+
+static bool
+primary_radio_station_attach_ready(struct primary_radio_decode *decoder)
+{
+  struct primary_radio_station_operation *operation = decoder->operation;
+  struct output_primary_radio_start_request current;
+  if (operation->result.phase != OUTPUT_PRIMARY_RADIO_START_PENDING
+      && operation->result.phase != OUTPUT_PRIMARY_RADIO_START_DECODED)
+    return false;
+  if (!primary_radio_station_before_deadline(operation))
+    {
+      primary_radio_station_finish(operation, OUTPUT_PRIMARY_RADIO_START_REJECTED);
+      primary_radio_decode_cancel(decoder);
+      return false;
+    }
+
+  if (!primary_radio_decode_frame_ready(decoder))
+    return false;
+  if (operation->decode_only)
+    {
+      if (operation->result.phase == OUTPUT_PRIMARY_RADIO_START_PENDING)
+        {
+          const struct output_primary_radio_start_request *request = &operation->request;
+          if (primary_radio_station_preflight_current(request, &current) < 0
+              || !primary_radio_station_same_target(request, &current))
+            {
+              primary_radio_station_finish(operation, OUTPUT_PRIMARY_RADIO_START_REJECTED);
+              primary_radio_decode_cancel(decoder);
+              return false;
+            }
+          primary_radio_station_finish(operation, OUTPUT_PRIMARY_RADIO_START_DECODED);
+        }
+      return false; /* Keep decoded PCM private until a later exact park admission. */
+    }
+  const char *park_token = operation->park_token[0] ? operation->park_token : NULL;
+  bool replacement = operation->request.predecessor.device_id != 0;
+  bool target_current = replacement
+      ? primary_radio_station_replace_ready(&operation->request, &operation->predecessor_release, park_token)
+      : park_token ? outputs_primary_spotify_park_attach_current(&operation->request, park_token)
+      : outputs_airplay_primary_station_target(operation->request.device_id, &current) == 0
+          && primary_radio_station_same_target(&operation->request, &current);
+  if (!target_current || !primary_radio_station_before_deadline(operation))
+    {
+      primary_radio_station_finish(operation, OUTPUT_PRIMARY_RADIO_START_REJECTED);
+      primary_radio_decode_cancel(decoder);
+      return false;
+    }
+
+  /* No receiver wire precedes one full decoded PCM packet and the final
+   * exact idle-target check. Only the player loop runs this constructor. */
+  struct airplay_session *session = airplay_primary_radio_make(
+      outputs_device_get(operation->request.device_id), &decoder->route, park_token,
+      replacement ? &operation->request : NULL, replacement ? &operation->predecessor_release : NULL);
+  if (!session)
+    {
+      primary_radio_station_finish(operation, OUTPUT_PRIMARY_RADIO_START_REJECTED);
+      primary_radio_decode_cancel(decoder);
+      return false;
+    }
+  decoder->session = session;
+  operation->admitted_route = decoder->route;
+  session->primary_radio_decoder = decoder;
+  if (!primary_radio_station_before_deadline(operation))
+    {
+      primary_radio_station_finish(operation, OUTPUT_PRIMARY_RADIO_START_REJECTED);
+      primary_radio_decode_cancel(decoder);
+      deferred_session_failure(session);
+    }
+  else
+    sequence_start(AIRPLAY_SEQ_START, session, NULL, "primary_radio_station_start");
+  return true;
+}
+
+static void
+primary_radio_station_abort(struct primary_radio_decode *decoder)
+{
+  struct airplay_session *session = decoder->session;
+  primary_radio_station_finish(decoder->operation, session
+      ? OUTPUT_PRIMARY_RADIO_START_UNKNOWN : OUTPUT_PRIMARY_RADIO_START_REJECTED);
+  primary_radio_decode_cancel(decoder);
+  if (session && !session->primary_radio_revoked
+      && airplay_primary_radio_revoke(&decoder->route) < 0)
+    session_failure(session);
+}
+
+static void
+primary_radio_decoder_tick(int fd, short events, void *arg)
+{
+  struct primary_radio_decode *decoder = arg;
+  struct airplay_session *session = decoder->session;
+  uint8_t frame[PRIMARY_RADIO_PACKET_BYTES];
+  bool done, frame_ready = false;
+  struct timeval next = { 0, PRIMARY_RADIO_PACKET_US };
+  (void)fd;
+  (void)events;
+
+  if (!session)
+    {
+      if (primary_radio_station_attach_ready(decoder))
+        {
+          if (evtimer_add(decoder->tick, &next) < 0)
+            session_failure(decoder->session);
+          return;
+        }
+      if (decoder->operation->result.phase == OUTPUT_PRIMARY_RADIO_START_REJECTED)
+        {
+          primary_radio_decoder_drop(decoder);
+          return;
+        }
+      pthread_mutex_lock(&decoder->mutex);
+      done = decoder->done;
+      bool has_frame = decoder->count > 0;
+      pthread_mutex_unlock(&decoder->mutex);
+      if ((done && !has_frame) || evtimer_add(decoder->tick, &next) < 0)
+        primary_radio_decoder_drop(decoder);
+      return;
+    }
+
+  if (session->primary_radio_revoked && !primary_radio_before_deadline(decoder->stop_deadline))
+    {
+      /* Closing the local route cannot stand in for a drained decoder or
+       * an acknowledged receiver STOP. Keep its claimed SQLite row pending. */
+      session_failure(session);
+      return;
+    }
+  if (!session->primary_radio_revoked && decoder->operation
+      && decoder->operation->result.phase == OUTPUT_PRIMARY_RADIO_START_PENDING
+      && (!primary_radio_station_before_deadline(decoder->operation) || !primary_radio_binding_current(session)))
+    {
+      if (evtimer_add(decoder->tick, &next) < 0)
+        session_failure(session);
+      else
+        primary_radio_station_abort(decoder);
+      return;
+    }
+  if (!session->primary_radio_revoked && !(session->state & AIRPLAY_STATE_F_CONNECTED))
+    {
+      if (evtimer_add(decoder->tick, &next) < 0)
+        session_failure(session);
+      return;
+    }
+
+  pthread_mutex_lock(&decoder->mutex);
+  done = decoder->done;
+  if (decoder->count && !primary_radio_decode_cancelled(decoder))
+    {
+      memcpy(frame, decoder->pcm[decoder->head], sizeof(frame));
+      decoder->head = (decoder->head + 1) % PRIMARY_RADIO_QUEUE_PACKETS;
+      decoder->count--;
+      frame_ready = true;
+      pthread_cond_signal(&decoder->space);
+    }
+  pthread_mutex_unlock(&decoder->mutex);
+
+  if (frame_ready)
+    {
+      struct output_buffer buffer = { 0 };
+      buffer.data[0] = (struct output_data) {
+        .quality = { 44100, 16, 2 }, .buffer = frame,
+        .bufsize = sizeof(frame), .samples = AIRPLAY_SAMPLES_PER_PACKET,
+      };
+      if (clock_gettime(CLOCK_MONOTONIC, &buffer.pts)
+          || airplay_primary_radio_write(&decoder->route, &buffer) < 0)
+        {
+          primary_radio_decode_cancel(decoder);
+          if (!session->primary_radio_revoked)
+            {
+              session_failure(session);
+              return;
+            }
+        }
+    }
+
+  if (done && !frame_ready)
+    {
+      struct airplay_primary_radio_route route = decoder->route;
+      primary_radio_decoder_detach(session);
+      if (session->primary_radio_revoked)
+        sequence_start(AIRPLAY_SEQ_STOP, session, NULL, "primary_radio_decoder_drained");
+      else if (airplay_primary_radio_revoke(&route) < 0)
+        session_failure(session);
+      return;
+    }
+  if (evtimer_add(decoder->tick, &next) < 0)
+    session_failure(session);
+}
+
+static struct primary_radio_decode *
+primary_radio_decoder_create(const char *url)
+{
+  struct timeval first = { 0, 0 };
+  pthread_attr_t attr;
+  pthread_t thread;
+  if (atomic_load(&primary_radio_decoder_workers) >= PRIMARY_RADIO_MAX_WORKERS)
+    return NULL;
+  struct primary_radio_decode *decoder = calloc(1, sizeof(*decoder));
+  if (!decoder)
+    return NULL;
+  if (pthread_mutex_init(&decoder->mutex, NULL))
+    {
+      free(decoder);
+      return NULL;
+    }
+  if (pthread_cond_init(&decoder->space, NULL))
+    {
+      pthread_mutex_destroy(&decoder->mutex);
+      free(decoder);
+      return NULL;
+    }
+  atomic_init(&decoder->cancelled, false);
+  atomic_init(&decoder->refs, 1);
+  decoder->url = url;
+  decoder->tick = evtimer_new(evbase_player, primary_radio_decoder_tick, decoder);
+  if (!decoder->tick || evtimer_add(decoder->tick, &first) || pthread_attr_init(&attr))
+    goto fail;
+  if (pthread_attr_setdetachstate(&attr, PTHREAD_CREATE_DETACHED))
+    {
+      pthread_attr_destroy(&attr);
+      goto fail;
+    }
+  atomic_fetch_add(&decoder->refs, 1);
+  atomic_fetch_add(&primary_radio_decoder_workers, 1);
+  int status = pthread_create(&thread, &attr, primary_radio_decode_thread, decoder);
+  pthread_attr_destroy(&attr);
+  if (!status)
+    return decoder;
+  atomic_fetch_sub(&primary_radio_decoder_workers, 1);
+  primary_radio_decode_unref(decoder);
+
+ fail:
+  primary_radio_decoder_drop(decoder);
+  return NULL;
+}
+
+static int
+airplay_primary_radio_decode(const struct airplay_primary_radio_route *route, const char *station)
+{
+  struct airplay_session *session = airplay_primary_radio_session(route);
+  const char *url = outputs_radio_station_url(station);
+  if (!url || !primary_radio_live(session) || session->primary_radio_decoder)
+    return -1;
+  struct primary_radio_decode *decoder = primary_radio_decoder_create(url);
+  if (!decoder)
+    return -1;
+  decoder->session = session;
+  decoder->route = *route;
+  session->primary_radio_decoder = decoder;
+  return 0;
+}
+
+static bool
+primary_radio_station_request_valid(const struct output_primary_radio_start_request *request)
+{
+  if (!request || strnlen(request->process, sizeof(request->process)) != 36
+      || strcmp(request->process, outputs_primary_radio_process()) || !request->generation
+      || request->generation == UINT64_MAX
+      || strnlen(request->action, sizeof(request->action)) != 36
+      || strnlen(request->station, sizeof(request->station)) >= sizeof(request->station))
+    return false;
+  for (size_t i = 0; i < 36; i++)
+    if ((i == 8 || i == 13 || i == 18 || i == 23) ? request->action[i] != '-'
+        : !strchr("0123456789abcdef", request->action[i]))
+      return false;
+  const struct output_primary_radio_custody *prior = &request->predecessor;
+  return (!prior->device_id || (!prior->teardown_cseq && !prior->stop_action[0]
+          && strnlen(prior->process, sizeof(prior->process)) == 36
+          && strnlen(prior->operation, sizeof(prior->operation)) == 36
+          && !strcmp(prior->process, request->process)))
+      && (!request->prior_release.device_id || primary_radio_station_release_matches(prior, &request->prior_release))
+      && outputs_radio_station_url(request->station) != NULL;
+}
+
+static struct primary_radio_station_operation *
+primary_radio_station_find_action(const char *action)
+{
+  for (size_t i = 0; i < ARRAY_SIZE(primary_radio_station_operations); i++)
+    {
+      struct primary_radio_station_operation *operation = &primary_radio_station_operations[i];
+      if (!strcmp(operation->request.action, action))
+        return operation;
+    }
+  return NULL;
+}
+
+static struct primary_radio_station_operation *
+primary_radio_station_find(const struct output_primary_radio_start_request *request)
+{
+  return primary_radio_station_find_action(request->action);
+}
+
+static bool
+primary_radio_station_binding_equal(const struct primary_radio_station_operation *operation,
+    const struct output_primary_radio_start_request *request)
+{
+  const struct output_primary_radio_start_request *retained = &operation->request;
+  return primary_radio_station_same_target(retained, request) && retained->generation == request->generation
+      && !strcmp(retained->station, request->station)
+      && ((!retained->predecessor.device_id && !request->predecessor.device_id)
+          || outputs_primary_radio_session_equal(&retained->predecessor, &request->predecessor))
+      && ((!retained->prior_release.device_id && !request->prior_release.device_id)
+          || (outputs_primary_radio_session_equal(&retained->prior_release, &request->prior_release)
+              && retained->prior_release.teardown_cseq == request->prior_release.teardown_cseq
+              && !strcmp(retained->prior_release.stop_action, request->prior_release.stop_action)));
+}
+
+int
+outputs_airplay_primary_station_result(const struct output_primary_radio_start_request *request,
+    struct output_primary_radio_start_result *out)
+{
+  if (!out || !primary_radio_station_request_valid(request))
+    return -1;
+  struct primary_radio_station_operation *operation = primary_radio_station_find(request);
+  if (!operation || !primary_radio_station_binding_equal(operation, request))
+    return -1;
+  *out = operation->result;
+  if (out->phase == OUTPUT_PRIMARY_RADIO_START_DECODED)
+    {
+      struct output_primary_radio_start_request current;
+      if (!primary_radio_station_before_deadline(operation)
+          || ((!request->predecessor.device_id || request->prior_release.device_id)
+              && (primary_radio_station_preflight_current(request, &current) < 0
+                  || !primary_radio_station_same_target(request, &current))))
+        *out = (struct output_primary_radio_start_result) { .phase = OUTPUT_PRIMARY_RADIO_START_REJECTED };
+    }
+  if (out->phase == OUTPUT_PRIMARY_RADIO_START_OBSERVED
+      && (!operation->decoder || !primary_radio_live(operation->decoder->session)))
+    *out = (struct output_primary_radio_start_result) { .phase = OUTPUT_PRIMARY_RADIO_START_UNKNOWN };
+  return 0;
+}
+
+int
+outputs_airplay_primary_station_readiness(const struct output_primary_radio_start_request *request,
+    struct output_primary_radio_start_result *out)
+{
+  if (outputs_airplay_primary_station_result(request, out) < 0
+      || out->phase != OUTPUT_PRIMARY_RADIO_START_OBSERVED
+      || !primary_radio_station_predecessor(&out->custody))
+    return -1;
+  const struct primary_radio_station_operation *operation = primary_radio_station_find(request);
+  struct timespec now, zero = { 0 }, max_age = { .tv_sec = PRIMARY_RADIO_READY_SECONDS };
+  if (clock_gettime(CLOCK_MONOTONIC, &now) < 0 || timespec_cmp(operation->last_fresh_rtp, zero) <= 0
+      || timespec_cmp(now, operation->last_fresh_rtp) < 0
+      || timespec_cmp(timespec_sub(now, operation->last_fresh_rtp), max_age) > 0)
+    return -1;
+  return 0;
+}
+
+int
+outputs_airplay_primary_station_preflight_target(uint64_t id, struct output_primary_radio_start_request *out)
+{
+  struct output_device *device = outputs_device_get(id);
+  struct output_attention_state state;
+  if (!out || !device || device->type != OUTPUT_TYPE_AIRPLAY || !device->advertised
+      || !device->extra_device_info || !((struct airplay_extra *)device->extra_device_info)->supports_encryption
+      || outputs_radio_sender_role() || outputs_attention_state_get(id, &state) < 0
+      || state.lease || state.restoring || !state.recovery_idle || !outputs_primary_radio_custody_available(id))
+    return -1;
+  *out = (struct output_primary_radio_start_request) {
+    .device_id = id, .incarnation = state.device_incarnation,
+    .epoch = state.session_epoch, .route = state.route_revision,
+  };
+  memcpy(out->process, state.process, sizeof(out->process));
+  return 0;
+}
+
+static bool
+primary_radio_station_reusable(struct primary_radio_station_operation *operation)
+{
+  if (operation->decoder)
+    return false;
+  const struct airplay_primary_radio_route *route = &operation->admitted_route;
+  if (!route->device_id)
+    return operation->result.phase == OUTPUT_PRIMARY_RADIO_START_REJECTED;
+  if (operation->released)
+    return true;
+  /* Decoder detach precedes RTSP STOP. Only a durable positive receipt for
+   * this exact route and action can settle an admitted operation. Remember
+   * it before a new station supersedes the per-device row. */
+  struct output_primary_radio_custody receipt;
+  operation->released = outputs_primary_radio_custody_read(route->device_id, &receipt) == 1
+      && receipt.teardown_cseq > 0 && receipt.incarnation == route->incarnation
+      && receipt.epoch == route->epoch && receipt.route == route->revision
+      && !strcmp(receipt.process, operation->request.process) && !strcmp(receipt.operation, operation->request.action);
+  return operation->released;
+}
+
+static int
+primary_radio_station_begin(const struct output_primary_radio_start_request *request,
+    struct output_primary_radio_start_result *out, bool decode_only)
+{
+  if (!out || !primary_radio_station_request_valid(request))
+    return -1;
+  struct primary_radio_station_operation *existing = primary_radio_station_find(request);
+  if (existing)
+    return existing->decode_only == decode_only ? outputs_airplay_primary_station_result(request, out) : -1;
+  if (request->generation <= primary_radio_station_generation)
+    return -1;
+  struct output_primary_radio_start_request current;
+  const struct output_primary_radio_custody *prior = &request->predecessor;
+  int ready = decode_only ? primary_radio_station_preflight_current(request, &current)
+                          : outputs_airplay_primary_station_target(request->device_id, &current);
+  if (ready < 0 || !primary_radio_station_same_target(request, &current))
+    return -1;
+  bool live_replacement = prior->device_id && !request->prior_release.device_id;
+  struct airplay_session *predecessor = live_replacement ? primary_radio_station_predecessor(prior) : NULL;
+  if (live_replacement && !predecessor)
+    return -1;
