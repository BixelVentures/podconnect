+static int
+primary_radio_station_custody_parse(json_object *body, const char *name,
+    struct output_primary_radio_custody *custody, bool released)
+{
+  json_object *object, *cseq;
+  if (!json_object_object_get_ex(body, name, &object) || !json_object_is_type(object, json_type_object)
+      || json_object_object_length(object) != (released ? 8 : 6)
+      || !transport_json_string(object, "process", custody->process, sizeof(custody->process))
+      || !transport_json_string(object, "operation", custody->operation, sizeof(custody->operation))
+      || transport_native_counter(object, "device_id", &custody->device_id) < 0 || !custody->device_id
+      || transport_native_counter(object, "incarnation", &custody->incarnation) < 0 || !custody->incarnation
+      || transport_native_counter(object, "session_epoch", &custody->epoch) < 0 || !custody->epoch
+      || transport_native_counter(object, "route_revision", &custody->route) < 0)
+    return -1;
+  if (released)
+    {
+      if (!transport_json_string(object, "action", custody->stop_action, sizeof(custody->stop_action))
+          || !json_object_object_get_ex(object, "teardown_cseq", &cseq) || !json_object_is_type(cseq, json_type_int)
+          || json_object_get_int64(cseq) <= 0 || json_object_get_int64(cseq) > INT_MAX)
+        return -1;
+      custody->teardown_cseq = json_object_get_int(cseq);
+    }
+  return 0;
+}
