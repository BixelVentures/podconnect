+struct player_radio_primary_stop_command
+{
+  bool claim, replace;
+  const struct output_primary_radio_custody *expected;
+  const char *action;
+  struct output_primary_radio_custody *out;
+};
+
+static enum command_state
+radio_primary_stop_command(void *arg, int *retval)
+{
+  struct player_radio_primary_stop_command *c = arg;
+  const struct output_primary_radio_custody *expected = c->expected;
+  struct output_primary_radio_custody *actual = c->out;
+
+  *retval = -1;
+  if (c->claim)
+    {
+      int outcome = c->replace ? outputs_airplay_primary_radio_claim_replace_stop(expected, c->action)
+                               : outputs_airplay_primary_radio_claim_stop(expected, c->action);
+      if (outcome < 0)
+        return COMMAND_END;
+    }
+  if (outputs_primary_radio_custody_read(expected->device_id, actual) == 1
+      && outputs_primary_radio_session_equal(expected, actual)
+      && !strcmp(c->action, actual->stop_action))
+    *retval = 0;
+  else if (c->replace && outputs_airplay_primary_radio_replace_stop_rejected(expected, c->action))
+    {
+      *actual = *expected;
+      memcpy(actual->stop_action, c->action, sizeof(actual->stop_action));
+      actual->teardown_cseq = 0;
+      *retval = 1;
+    }
+  return COMMAND_END;
+}
