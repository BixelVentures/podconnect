+static void
+primary_radio_station_replace_wire(struct recovery_wire_fixture *previous, struct recovery_wire_fixture *destination,
+    const struct output_primary_radio_custody *prior, uint64_t generation, const char *station, const char *park_token,
+    struct output_primary_radio_start_result *out, struct output_primary_radio_custody *released, bool expire)
+{
+  const void *previous_session = previous->device->session;
+  int previous_peers = previous->pc70_peer_sessions, destination_peers = destination->pc70_peer_sessions;
+  int teardowns = previous->teardowns;
+  struct output_primary_radio_start_request candidate;
+  uint16_t sequence;
+  assert(outputs_airplay_primary_station_replace_target(destination->device->id, prior, &candidate) == 0);
+  assert(candidate.epoch == destination->device->session_epoch && candidate.route == destination->device->route_revision);
+  candidate.generation = generation;
+  outputs_attention_uuid(candidate.action);
+  snprintf(candidate.station, sizeof(candidate.station), "%s", station);
+  (void)primary_radio_wire_packets(previous, &sequence);
+  assert(outputs_airplay_primary_station_replace_preflight(&candidate, out) == 0);
+  for (int i = 0; i < 1500 && out->phase == OUTPUT_PRIMARY_RADIO_START_PENDING; i++)
+    {
+      event_base_loop(previous->base, EVLOOP_NONBLOCK);
+      assert(outputs_airplay_primary_station_result(&candidate, out) == 0);
+      usleep(1000);
+    }
+  assert(out->phase == OUTPUT_PRIMARY_RADIO_START_DECODED && previous->device->session == previous_session
+      && previous->teardowns == teardowns && destination->pc70_peer_sessions == destination_peers);
+  int prior_packets = 0;
+  for (int i = 0; i < 100 && !prior_packets; i++)
+    {
+      event_base_loop(previous->base, EVLOOP_NONBLOCK);
+      prior_packets += primary_radio_wire_packets(previous, &sequence);
+      usleep(1000);
+    }
+  assert(prior_packets > 0);
+  struct primary_radio_station_operation *operation = primary_radio_station_find(&candidate);
+  struct primary_radio_decode *worker = operation->decoder;
+  struct player_radio_primary_stop_command stop = {
+    .claim = true, .replace = true, .expected = prior, .action = candidate.action, .out = released,
+  };
+  int stop_result;
+  if (expire)
+    {
+      operation->deadline = (struct timespec) { 0 };
+      assert(radio_primary_stop_command(&stop, &stop_result) == COMMAND_END && stop_result == 1
+          && !released->teardown_cseq && !strcmp(released->stop_action, candidate.action)
+          && outputs_primary_radio_session_equal(prior, released));
+      stop.claim = false;
+      assert(radio_primary_stop_command(&stop, &stop_result) == COMMAND_END && stop_result == 1
+          && !released->teardown_cseq && !strcmp(released->stop_action, candidate.action)
+          && outputs_primary_radio_session_equal(prior, released));
+      struct output_primary_radio_custody actual;
+      assert(!operation->decoder && outputs_airplay_primary_station_result(&candidate, out) == 0
+          && out->phase == OUTPUT_PRIMARY_RADIO_START_REJECTED
+          && outputs_primary_radio_custody_read(prior->device_id, &actual) == 1
+          && outputs_primary_radio_session_equal(prior, &actual) && !actual.stop_action[0] && !actual.teardown_cseq);
+      (void)primary_radio_wire_packets(previous, &sequence);
+      prior_packets = 0;
+      for (int i = 0; i < 100 && !prior_packets; i++)
+        {
+          event_base_loop(previous->base, EVLOOP_NONBLOCK);
+          prior_packets += primary_radio_wire_packets(previous, &sequence);
+          usleep(1000);
+        }
+      assert(prior_packets > 0 && previous->device->session == previous_session && previous->teardowns == teardowns
+          && destination->pc70_peer_sessions == destination_peers);
+      puts("PASS expired decoded replacement returns exact passive rejection and predecessor RTP continues");
+      return;
+    }
+  struct output_primary_radio_custody forged = *prior;
+  memcpy(forged.stop_action, candidate.action, sizeof(forged.stop_action));
+  forged.teardown_cseq = 1;
+  assert(outputs_airplay_primary_station_replace_activate(&candidate, &forged, park_token, out) < 0);
+  previous->require_decoder_drain = true;
+  assert(radio_primary_stop_command(&stop, &stop_result) == COMMAND_END && stop_result == 0
+      && !released->teardown_cseq && !strcmp(released->stop_action, candidate.action));
+  primary_radio_wire_wait(previous, false);
+  assert(previous->teardowns == teardowns + 1 && !previous->device->session
+      && outputs_primary_radio_custody_read(prior->device_id, released) == 1
+      && released->teardown_cseq > 0 && !strcmp(released->stop_action, forged.stop_action));
+  forged = *released;
+  forged.teardown_cseq++;
+  assert(outputs_airplay_primary_station_replace_activate(&candidate, &forged, park_token, out) < 0);
+  assert(destination->pc70_peer_sessions == destination_peers && !destination->device->session);
+  if (park_token)
+    assert(outputs_airplay_primary_station_replace_activate(&candidate, released, NULL, out) < 0);
+  (void)primary_radio_wire_packets(destination, &sequence);
+  assert(outputs_airplay_primary_station_replace_activate(&candidate, released, park_token, out) == 0);
+  for (int i = 0; i < 1500 && out->phase == OUTPUT_PRIMARY_RADIO_START_PENDING; i++)
+    {
+      event_base_loop(previous->base, EVLOOP_NONBLOCK);
+      assert(outputs_airplay_primary_station_result(&candidate, out) == 0);
+      usleep(1000);
+    }
+  assert(out->phase == OUTPUT_PRIMARY_RADIO_START_OBSERVED && destination->pc70_peer_sessions == destination_peers + 1
+      && out->custody.epoch == candidate.epoch + (previous == destination ? 2 : 1)
+      && out->custody.route == candidate.route && !strcmp(out->custody.operation, candidate.action)
+      && destination->device->session
+      && ((struct airplay_session *)destination->device->session)->primary_radio_decoder == worker
+      && primary_radio_wire_packets(destination, &sequence) > 0);
+  if (previous != destination)
+    assert(!previous->device->session && previous->pc70_peer_sessions == previous_peers);
+  assert(outputs_airplay_primary_station_replace_activate(&candidate, released, park_token, out) == 0
+      && out->phase == OUTPUT_PRIMARY_RADIO_START_OBSERVED && destination->pc70_peer_sessions == destination_peers + 1);
+}
