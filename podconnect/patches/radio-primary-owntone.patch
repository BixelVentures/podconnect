+/* Read-only owner-thread observations. Selection alone is not Spotify proof;
+ * the exact live FIFO writer and ordinary encrypted route must agree. */
+int
+outputs_primary_radio_spotify_owner(uint64_t id, const struct output_native_owner *owner,
+    const struct output_queue_writer *writer, struct output_transport_identity *route)
+{
+  struct output_device *d = outputs_device_get(id);
+  struct radio_handoff_slot *slot = radio_handoff_find(id);
+  if (!radio_protocols_initialized || outputs_radio_sender_role() || radio_handoff_fault
+      || start_journal_fault || start_startup_quarantine || !owner || !writer || !route
+      || !d || !native_owner_valid(owner, id) || outputs_radio_handoff_blocked(id)
+      || !outputs_airplay_primary_spotify_session_current(d, d->session)
+      || radio_transport_identity_get(id, route, true) < 0
+      || !radio_queue_writer_current(writer, route, NULL))
+    return -1;
+
+  /* A parked/returning writer cannot fall through to the old START proof. */
+  if (slot && slot->primary_return.intent[0])
+    {
+      const struct output_radio_reacquire_result *v = &slot->result.resume;
+      return slot->result.phase == OUTPUT_RADIO_REACQUIRED
+        && v->phase == OUTPUT_RADIO_REACQUIRE_OPENED
+        && native_owner_equal(owner, &v->command.intended_native_owner)
+        && queue_writer_equal(writer, &v->command.current_writer)
+        && transport_identity_equal(route, &v->route_identity)
+        && radio_reacquired_current(id, d->incarnation, d->session_epoch, d->session, false) ? 0 : -1;
+    }
+  const struct start_slot *spotify = start_active;
+  if (!spotify || spotify->cancelled || spotify->result.phase != OUTPUT_START_COMPLETED
+      || !spotify->result.actual_owner_present
+      || !native_owner_equal(owner, &spotify->result.command.committed_native_owner)
+      || writer->source_epoch != spotify->result.writer_source_epoch
+      || writer->writer_fd != spotify->result.command.writer_fd
+      || writer->pipe_device != spotify->result.pipe_device || writer->pipe_inode != spotify->result.pipe_inode
+      || strcmp(writer->native_process.boot_id, spotify->result.command.native_process.boot_id)
+      || writer->native_process.pid != spotify->result.command.native_process.pid
+      || writer->native_process.proc_start_ticks != spotify->result.command.native_process.proc_start_ticks)
+    return -1;
+  return outputs_start_bound_owner_current(owner, route, false) ? 0 : -1;
+}
+
+int
+outputs_primary_radio_absent_owner(uint64_t id, const struct radio_absence_source *source,
+    struct output_primary_radio_start_request *target)
+{
+  int writers;
+  /* Log the first refusal on the existing read-only owner path. Predicates
+   * that inspect changing custody must run only once at their original point. */
+#define PRIMARY_ABSENCE_DENY(condition, reason) do { \
+  if (condition) { \
+    DPRINTF(E_LOG, L_PLAYER, "Primary radio absent owner denied: %s\n", reason); \
+    return -1; \
+  } \
+} while (0)
+  PRIMARY_ABSENCE_DENY(!radio_protocols_initialized, "protocol_uninitialized");
+  PRIMARY_ABSENCE_DENY(!source || !target || source->target_absence || source->route_count
+      || source->writer_fd || source->input_generation || source->input_item_id || source->input_epoch, "invalid_source_shape");
+  PRIMARY_ABSENCE_DENY(radio_absence_fault, "radio_absence_fault");
+  PRIMARY_ABSENCE_DENY(radio_handoff_fault, "radio_handoff_fault");
+  PRIMARY_ABSENCE_DENY(radio_other_fault, "radio_other_fault");
+  PRIMARY_ABSENCE_DENY(start_journal_fault, start_journal_fault_reason());
+  PRIMARY_ABSENCE_DENY(start_startup_quarantine, "startup_quarantine");
+  PRIMARY_ABSENCE_DENY(transport_pin, "transport_pin");
+  PRIMARY_ABSENCE_DENY(room_volume_pin_busy(), "volume_pin");
+  PRIMARY_ABSENCE_DENY(room_volume_undrained(), "volume_undrained");
+  PRIMARY_ABSENCE_DENY(outputs_start_busy(), "start_busy");
+  PRIMARY_ABSENCE_DENY(!start_contexts_drained(), "contexts_undrained");
+  PRIMARY_ABSENCE_DENY(outputs_start_source_owned(), "start_source_owned");
+  if (start_journal.token[0])
+    {
+      PRIMARY_ABSENCE_DENY(start_journal_retirement_outcome != OUTPUT_RETIRE_RETIRED_KNOWN
+          && start_journal_retirement_outcome != OUTPUT_RETIRE_COLD_KNOWN, "retirement_unproven");
+      PRIMARY_ABSENCE_DENY(!start_journal_payload_valid(), "retirement_payload_invalid");
+    }
+  writers = radio_absence_fifo_writers(source);
+  PRIMARY_ABSENCE_DENY(writers != 1, writers == 0 ? "fifo_writer_present" : "fifo_proof_incomplete");
+  PRIMARY_ABSENCE_DENY(outputs_airplay_primary_station_target(id, target) < 0, "idle_target_unavailable");
+  for (struct output_device *d = outputs_device_list; d; d = d->next)
+    PRIMARY_ABSENCE_DENY(d->selected || d->session, "another_output_selected_or_live");
+  /* A writer may change outside this owner thread; recheck the same process
+   * and FIFO after taking the exact receiver snapshot. */
+  writers = radio_absence_fifo_writers(source);
+  PRIMARY_ABSENCE_DENY(writers != 1, writers == 0 ? "fifo_writer_present_on_recheck" : "fifo_proof_incomplete_on_recheck");
+#undef PRIMARY_ABSENCE_DENY
+  return 0;
+}
