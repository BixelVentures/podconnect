+{
+  struct output_transport_request request={.device_id=1,.bound=true,.percent=-1,.native_revision=51};
+  struct output_transport_result prepared,result;
+  struct output_native_owner prior_owner=transport_custody_owner;
+  struct output_transport_identity prior_identity=transport_custody_identity;
+  struct timespec prior_expiry=transport_custody_expiry;
+  uint64_t prior_generation=transport_admission_generation,prior_revision=transport_custody_revision;
+  bool prior_live=transport_custody_live,prior_lost=transport_custody_lost;
+  strcpy(request.action,"pause");memset(request.native_prepare_id,'d',32);
+  memset(request.args_digest,'e',64);request.native_owner=*owner;
+  strcpy(request.expected_input_path_digest,route->input_path_digest);
+  assert(outputs_transport_prepare(&request,&prepared)==0);
+  strcpy(request.token,prepared.command.token);
+  assert(outputs_transport_commit(&request,&result)==0);
+  assert(!transport_pause_retained); /* C commit precedes actual native effect. */
+  assert(outputs_transport_pause_confirm(1,request.token,request.native_prepare_id,52)<0);
+  assert(!transport_pause_retained);
+  request.native_revision=52;request.native_prepare_id[0]='e';
+  assert(outputs_transport_prepare(&request,&prepared)==0);
+  strcpy(request.token,prepared.command.token);
+  assert(outputs_transport_commit(&request,&result)==0);
+  assert(outputs_transport_pause_confirm(1,request.token,request.native_prepare_id,52)==0);
+  assert(transport_pause_owned(1));
+  assert(outputs_transport_pause_confirm(1,request.token,request.native_prepare_id,52)<0);
+  assert(transport_pause_owned(1)); /* Duplicate confirmation cannot mutate custody. */
+  void *session=device->session;uint64_t epoch=device->session_epoch;
+  assert(outputs_device_stop_delayed(device,device_streaming_cb)==1);
+  stop_timer_cb(0,0,device);
+  assert(device->session==session && transport_pause_owned(1)
+    && event_pending(device->stop_timer,EV_TIMEOUT,NULL));
