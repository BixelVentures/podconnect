+  start_active=prior_start;
+  assert(!transport_pause_owned(1)); /* Lost proof cannot revive by ABA. */
+  event_del(device->stop_timer);
+  transport_custody_owner=prior_owner;transport_custody_identity=prior_identity;
+  transport_custody_expiry=prior_expiry;transport_admission_generation=prior_generation;
+  transport_custody_revision=prior_revision;transport_custody_live=prior_live;transport_custody_lost=prior_lost;
