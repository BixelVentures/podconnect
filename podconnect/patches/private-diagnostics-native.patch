@@ -0,0 +1,65 @@
+package daemon
+
+// Failure-only, observational snapshots. No IDs, tokens, account names, media or
+// raw errors leave this helper. It does not query C, verify a writer or admit work.
+type connectOwnershipDiagnostic struct {
+	Start, Move, Unknown, Retirement, WriterOwner bool
+	AliasRetired, Quarantined, Reservation        bool
+	RetainedOwner, RetainedSession, RetainedAlias bool
+}
+
+func (p *AppPlayer) connectOwnershipDiagnostic() connectOwnershipDiagnostic {
+	var d connectOwnershipDiagnostic
+	if p == nil || p.app == nil {
+		return d
+	}
+	p.aliasMu.Lock()
+	d.AliasRetired = p.aliasRetired
+	d.Quarantined = p.roomMoveQuarantined || p.roomContentQuarantined
+	d.Reservation = p.roomMoveReservation != nil
+	incarnation, registry, revision := p.aliasIncarnation, p.aliasFingerprint, p.aliasRevision
+	room, homepod := "", ""
+	if p.state != nil && p.state.device != nil {
+		selected := p.state.device.SelectedAliasId
+		for _, alias := range p.aliasRegistry {
+			if alias.ID == selected {
+				room, homepod = alias.RoomID, alias.HomePodID
+				break
+			}
+		}
+	}
+	p.aliasMu.Unlock()
+	p.app.moveCustodyMu.Lock()
+	start, move := p.app.startCustody, p.app.moveCustody
+	d.Start, d.Move = start != nil, move != nil
+	d.Unknown, d.Retirement = p.app.moveCustodyUnknown, p.app.retirementPending != nil
+	d.WriterOwner = p.app.openedWriterOwner == p
+	p.app.moveCustodyMu.Unlock()
+	matches := func(actual *roomTransportIdentity) bool {
+		return actual != nil && room != "" && homepod != "" && actual.RoomID == room && actual.HomePodID == homepod && actual.AliasIncarnation == incarnation && actual.AliasRegistry == registry && actual.AliasRevision == revision
+	}
+	// Never nest operation and process-custody locks. These flags describe the
+	// sampled retained operation, not an atomic admission or physical witness.
+	if start != nil && move == nil {
+		start.mu.Lock()
+		d.RetainedOwner = start.Owner == p
+		d.RetainedSession = p.sess != nil && start.Capture != nil && start.Capture.Session == p.sess
+		d.RetainedAlias = matches(start.Actual)
+		start.mu.Unlock()
+	} else if move != nil && start == nil {
+		move.mu.Lock()
+		d.RetainedOwner = move.Owner == p
+		d.RetainedSession = p.sess != nil && move.Capture != nil && move.Capture.Session == p.sess
+		d.RetainedAlias = matches(move.Actual)
+		move.mu.Unlock()
+	}
+	return d
+}
+
+func (p *AppPlayer) logConnectOwnershipFailure(stage string) {
+	if p == nil || p.app == nil || p.app.log == nil {
+		return
+	}
+	d := p.connectOwnershipDiagnostic()
+	p.app.log.Infof("connect-recovery native reason=ownership_failure stage=%s retained_start=%t retained_move=%t custody_unknown=%t retirement_pending=%t writer_owner_matches=%t alias_retired=%t quarantined=%t move_reserved=%t retained_owner_matches=%t retained_session_matches=%t retained_alias_matches=%t", stage, d.Start, d.Move, d.Unknown, d.Retirement, d.WriterOwner, d.AliasRetired, d.Quarantined, d.Reservation, d.RetainedOwner, d.RetainedSession, d.RetainedAlias)
+}

