+    return 0; // Desired-only, no native request or fabricated acceptance.
+  if (session->device_incarnation != operation->identity.device_incarnation
+      || session->session_epoch != operation->identity.session_epoch)
+    return -1;
+  context = calloc(1, sizeof(*context));
