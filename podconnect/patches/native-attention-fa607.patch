+/* Actual outputs owner boundaries only. Opaque tokens are not native sessions,
+ * receiver readiness, protocol ACKs or audio acceptance. */
+static int restart_token, old_token, restart_calls, restart_callback, completions;
+static int inert_start(struct output_device *device, int callback_id)
+{
+  assert(device->session == NULL);
+  assert(device->attention_retiring_session == NULL);
+  restart_calls++;
+  restart_callback = callback_id;
+  assert(outputs_device_session_add(device->id, &restart_token) == 0);
+  return 1;
+}
+static int inert_stop(struct output_device *device, int callback_id)
+{
+  (void)device; (void)callback_id;
+  return 1;
+}
+static void completed_start(struct output_device *device, enum output_device_state state)
+{
+  completions++;
+  if (state == OUTPUT_STATE_CONNECTED)
+    assert(device && device->session == &restart_token);
+  else
+    assert(!device && state == OUTPUT_STATE_FAILED);
+}
+static void retiring_start_waits_destroy_and_fences_old_callback(void)
+{
+  struct output_device *a = add_device(1);
+  uint64_t epoch;
+  int owned;
+  a->advertised = true;
+  outputs_device_select(a, -1);
+  assert(outputs_device_session_add(1, &old_token) == 0);
+  epoch = a->session_epoch;
+  a->attention_retiring_session = &old_token; /* owner-only retirement boundary */
+  output_airplay.device_start = inert_start;
+  output_airplay.device_probe = inert_start;
+  output_airplay.device_stop = inert_stop;
+  restart_calls = completions = 0;
+  assert(outputs_device_start(a, completed_start, false) == 1);
+  owned = a->attention_restart_callback;
+  assert(outputs_device_start(a, completed_start, false) == -1);
+  assert(outputs_device_stop(a, completed_start) == -1);
+  assert(restart_calls == 0 && !outputs_cb_register[owned].ready);
+  /* The native caller invokes finish only after its old resources are freed. */
+  outputs_device_session_remove_exact(1, &old_token);
+  outputs_attention_retirement_finished(1, a->incarnation, epoch, &old_token);
+  assert(restart_calls == 1 && restart_callback == owned && !a->attention_restart_pending);
+  assert(a->session == &restart_token && a->session_epoch == epoch + 2);
+  outputs_cb_exact(owned, 1, a->incarnation, epoch, &old_token, OUTPUT_STATE_STOPPED);
+  assert(!outputs_cb_register[owned].ready && completions == 0);
+  outputs_cb_exact(owned, 1, a->incarnation, a->session_epoch, &restart_token, OUTPUT_STATE_CONNECTED);
+  deferred_cb(-1, 0, NULL);
+  assert(completions == 1 && a->state == OUTPUT_STATE_CONNECTED);
+  outputs_device_session_remove_exact(1, &restart_token);
+  clear_devices();
+}
+static void deselect_and_replacement_resolve_pending_without_restart(void)
+{
+  struct output_device *a = add_device(1), *b;
+  uint64_t incarnation, epoch;
+  int owned;
+  a->advertised = true;
+  outputs_device_select(a, -1);
+  assert(outputs_device_session_add(1, &old_token) == 0);
+  incarnation = a->incarnation; epoch = a->session_epoch;
+  a->attention_retiring_session = &old_token;
+  restart_calls = completions = 0;
+  assert(outputs_device_start(a, completed_start, false) == 1);
+  owned = a->attention_restart_callback;
+  outputs_device_deselect(a);
+  assert(!a->attention_restart_pending && outputs_cb_register[owned].ready);
+  outputs_device_session_remove_exact(1, &old_token);
+  outputs_attention_retirement_finished(1, incarnation, epoch, &old_token);
+  assert(restart_calls == 0);
+  outputs_device_remove(a);
+  b = add_device(1); /* same ID, different device incarnation */
+  b->advertised = true;
+  outputs_attention_retirement_finished(1, incarnation, epoch, &old_token);
+  deferred_cb(-1, 0, NULL);
+  assert(restart_calls == 0 && completions == 1 && b->state != OUTPUT_STATE_CONNECTED);
+  clear_devices();
+}
+static void exact_request_id_replays_receipt_without_reapplying(void)
+{
+  struct output_device *a = add_device(1);
+  struct output_attention_request command = { .action = OUTPUT_ATTENTION_BEGIN, .cap_volume = 5, .ttl_ms = 2000 };
+  struct output_attention_result first, repeated;
+  memcpy(command.request_id, "00000000-0000-4000-8000-000000000101", sizeof(command.request_id));
+  assert(outputs_attention_state_get(1, &command.expected) == 0);
+  transport_return = 1;
+  assert(outputs_attention_admit(&command, &first) == 0);
+  assert(transport_calls == 1 && first.outcome == OUTPUT_ATTENTION_PENDING);
+  /* Receipt resolution is observation-only, including pending operations. */
+  assert(outputs_attention_request_get(command.expected.process, 1, command.request_id, &repeated) == 0);
+  assert(repeated.operation == first.operation && repeated.outcome == OUTPUT_ATTENTION_PENDING && transport_calls == 1);
+  assert(outputs_attention_request_get("00000000-0000-4000-8000-000000000999", 1, command.request_id, &repeated) < 0);
+  assert(outputs_attention_request_get(command.expected.process, 2, command.request_id, &repeated) < 0);
+  assert(outputs_attention_request_get(command.expected.process, 1, "00000000-0000-4000-8000-000000000999", &repeated) < 0);
+  assert(transport_calls == 1);
+  assert(outputs_attention_admit(&command, &repeated) == 0);
+  assert(repeated.operation == first.operation && transport_calls == 1);
+  outputs_attention_complete(&first, OUTPUT_ATTENTION_FAILED, 503, 21);
+  assert(outputs_attention_admit(&command, &repeated) == 0);
+  assert(repeated.outcome == OUTPUT_ATTENTION_FAILED && repeated.operation == first.operation && transport_calls == 1);
+  assert(outputs_attention_request_get(command.expected.process, 1, command.request_id, &repeated) == 0);
+  assert(repeated.outcome == OUTPUT_ATTENTION_FAILED && repeated.operation == first.operation && transport_calls == 1);
+  command.cap_volume = 6;
+  assert(outputs_attention_admit(&command, &repeated) < 0 && transport_calls == 1);
+  command.cap_volume = 5;
+  outputs_device_volume_register(a, 30, -1); /* ABA: replay receipt, not apply */
+  assert(outputs_attention_admit(&command, &repeated) == 0 && !repeated.current && transport_calls == 1);
+  transport_return = 0;
+  repeated = request(1, OUTPUT_ATTENTION_RELEASE);
+  assert(a->attention_lease == 0);
+  clear_devices();
+}
