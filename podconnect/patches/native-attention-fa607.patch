+void
+outputs_attention_retirement_finished(uint64_t device_id, uint64_t incarnation, uint64_t epoch, const void *session)
+{
+  struct output_device *device = outputs_device_get(device_id);
+  int id, ret;
+  bool probe;
+  if (!device || device->incarnation != incarnation || device->attention_retiring_session != session)
+    return;
+  device->attention_retiring_session = NULL;
+  if (!device->attention_restart_pending)
+    return;
+  if (device->session || epoch == UINT64_MAX || device->session_epoch != epoch + 1
+      || !device->selected || device->route_revision != device->attention_restart_route
+      || !device->advertised || outputs[device->type]->disabled)
+    {
+      attention_restart_cancel(device);
+      return;
+    }
+  id = device->attention_restart_callback;
+  probe = device->attention_restart_probe;
+  device->attention_restart_pending = false;
+  // The exact old control/master/request owners are gone. Normal start mints
+  // the next native session; reuse only this command's reserved callback slot.
+  ret = probe ? outputs[device->type]->device_probe(device, id)
+              : outputs[device->type]->device_start(device, id);
+  device_state_update(device, ret);
+  if (ret <= 0)
+    {
+      outputs_cb_register[id].canceled = true;
+      outputs_cb_register[id].ready = true;
+      event_active(outputs_deferredev, 0, 0);
+    }
+}
