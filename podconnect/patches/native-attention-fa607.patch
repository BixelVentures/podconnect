+  if(!f.failed && (mode == 0 || mode >= 3) && (f.result.recovery_state!=OUTPUT_RECOVERY_RESTORED || !f.result.current || f.result.response_code!=200
+      || f.result.request_cseq<=0 || strcmp(f.result.recovery_proof.terminal_request_id,f.command.request_id)))recovery_wire_fail(&f,"exact fresh terminal proof");
+  if(!f.failed && (mode == 1 || mode == 2) && f.result.recovery_state!=OUTPUT_RECOVERY_UNKNOWN)recovery_wire_fail(&f,"bad CSeq/non200 got recovery credit");
+  if(!f.failed) {char byte; if(recv(f.udp_fd,&byte,1,MSG_DONTWAIT)>=0)recovery_wire_fail(&f,"unexpected recovery audio/data packet");}
+ cleanup:
+  while(airplay_sessions)session_cleanup(airplay_sessions);
+  if(outputs_device_list)outputs_device_remove(outputs_device_list);
+  for(i=0;i<(int)ARRAY_SIZE(contexts);i++)if(contexts[i])f.failed=1;
+  if (f.peer) bufferevent_free(f.peer);
+  if (f.listener) evconnlistener_free(f.listener);
+  if (f.plain) evbuffer_free(f.plain);
+  pair_cipher_free(f.cipher);pair_setup_free(f.pair);
+  if (f.poll) event_free(f.poll);
+  if (f.deadline) event_free(f.deadline);
+  if (f.udp_fd >= 0) close(f.udp_fd);
+  if (outputs_deferredev) event_free(outputs_deferredev);
+  outputs_deferredev = NULL;
+  if (database_ready) db_perthread_deinit();
+  db_deinit();
+  unlink(database_path);
+  if (cfg) cfg_free(cfg);
+  cfg = NULL;
+  airplay_user_agent = NULL;
+  airplay_client_name = NULL;
+  event_base_free(f.base);evbase_player=NULL;memset(attention_results,0,sizeof(attention_results));memset(attention_result_reserved,0,sizeof(attention_result_reserved));
+  active_recovery_wire = NULL;
+  return f.failed;
+}
+
+#include "player_startup_owner.inc.c"
+
+int main(void)
+{
+  int mode;
+  if (!gcry_check_version(GCRYPT_VERSION)) return 1;
+  actual_player_startup_cases();
+  for (mode = OLD_START_200; mode <= OLD_START_REFUSED; mode++)
+    if (owner_case((enum owner_mode)mode, 0)) return 1;
+  for (mode = 1; mode <= 2; mode++)
+    if (owner_case(OLD_START_200, mode)) return 1;
+  for (mode = RAW_FREE; mode <= RAW_NESTED_FREE; mode++)
+    if (raw_case((enum raw_mode)mode)) return 1;
+  for(mode=0;mode<7;mode++) if(recovery_wire_case(mode)) return 1;
+  puts("PASS: existing AirPlay config/queue owners plus seven actual private AP2 recovery/write/drain cases; no HomePod or physical-volume claim");
+  return 0;
+}
diff --git a/tests/evrtsp_guarded_owner_contract.c b/tests/evrtsp_guarded_owner_contract.c
new file mode 100644
--- /dev/null
+++ b/tests/evrtsp_guarded_owner_contract.c
@@ -0,0 +1,206 @@
+/* Actual candidate evrtsp queue/connection regression. No native session flags,
+ * fake ACK, AirPlay state, audio, LAN or provider. Reuses the established finite
+ * loopback fixture and exact real request ownership, with a five-second bound. */
+#define main original_evrtsp_owner_main
+#include "evrtsp_owner_contract.c"
+#undef main
+
+enum guarded_mode { FIRST_REJECT, QUEUED_REJECT, NESTED_REJECT_FREE };
+struct guarded_fixture;
+struct guarded_op { struct guarded_fixture *owner; int index, calls, null; };
+struct guarded_fixture {
+  enum guarded_mode mode;
+  struct event_base *base;
+  struct evconnlistener *listener;
+  struct bufferevent *peer;
+  struct evrtsp_connection *native;
+  struct event *deadline;
+  struct guarded_op op[3];
+  int wire, failed, retired, cleanup_callback, next_before_prior;
+};
+static void guarded_fail(struct guarded_fixture *s, const char *why)
+{
+  fprintf(stderr, "FAIL guarded=%d: %s\n", s->mode, why);
+  s->failed = 1;
+  event_base_loopbreak(s->base);
+}
+static void guarded_deadline(evutil_socket_t fd, short events, void *arg)
+{
+  (void)fd; (void)events;
+  guarded_fail(arg, "existing five-second fixture bound exhausted");
+}
+static int guarded_current(void *arg)
+{
+  struct guarded_op *op = arg;
+  return op->owner->mode != FIRST_REJECT && (op->index == 0 || !op->owner->retired);
+}
+static void guarded_response(struct evrtsp_request *request, void *arg)
+{
+  struct guarded_op *op = arg;
+  struct guarded_fixture *s = op->owner;
+  op->calls++;
+  op->null = request == NULL;
+  if (op->calls != 1) { guarded_fail(s, "duplicate exact request callback"); return; }
+  if (s->mode == FIRST_REJECT) {
+    if (op->index != 0 || request || s->wire != 0 || queue_count(s->native) != 0)
+      guarded_fail(s, "initial veto emitted wire or lost queue identity");
+    event_base_loopbreak(s->base);
+    return;
+  }
+  if (op->index == 0) {
+    if (!request || request->response_code != 200 || s->wire != 1 || s->op[1].calls)
+      { guarded_fail(s, "queued veto callback ran recursively before prior real response"); return; }
+    /* Real next request remains queue-owned while its rejection event is pending. */
+    s->next_before_prior = queue_count(s->native) == (s->mode == NESTED_REJECT_FREE ? 2 : 1);
+    if (!s->next_before_prior) guarded_fail(s, "next queue stage absent before prior callback");
+    return;
+  }
+  if (request || !s->op[0].calls || s->wire != 1)
+    { guarded_fail(s, "obsolete queued payload escaped serialization veto"); return; }
+  if (s->mode == NESTED_REJECT_FREE) {
+    if (op->index != 1 || s->op[2].calls || queue_count(s->native) != 1)
+      { guarded_fail(s, "nested rejection callback order incorrect"); return; }
+    /* Callback-initiated actual destruction cancels the next existing event and
+     * frees its queued request. No callback into freed connection/session arg. */
+    evrtsp_connection_free(s->native);
+    s->native = NULL;
+    s->cleanup_callback = 1;
+  }
+  event_base_loopbreak(s->base);
+}
+static void guarded_peer_read(struct bufferevent *peer, void *arg)
+{
+  struct guarded_fixture *s = arg;
+  struct evbuffer *input = bufferevent_get_input(peer);
+  struct evbuffer_ptr end = evbuffer_search(input, "\r\n\r\n", 4, NULL);
+  if (end.pos < 0) {
+    if (evbuffer_get_length(input) > 4096) guarded_fail(s, "wire header exceeds original bound");
+    return;
+  }
+  if (++s->wire != 1 || s->mode == FIRST_REJECT)
+    { guarded_fail(s, "unexpected obsolete guarded request on actual wire"); return; }
+  evbuffer_drain(input, (size_t)end.pos + 4);
+  s->retired = 1; /* Test currency changes while A is held, before A's real response. */
+  {
+    const char reply[] = "RTSP/1.0 200 Fixture\r\nCSeq: 1\r\nContent-Length: 0\r\n\r\n";
+    if (bufferevent_write(peer, reply, sizeof(reply) - 1) < 0)
+      guarded_fail(s, "actual inert reply write failed");
+  }
+}
+static void guarded_accept(struct evconnlistener *listener, evutil_socket_t fd,
+    struct sockaddr *remote, int length, void *arg)
+{
+  struct guarded_fixture *s = arg;
+  struct sockaddr_in *address = (struct sockaddr_in *)remote;
+  (void)listener;
+  if (length < (int)sizeof(*address) || address->sin_family != AF_INET
+      || ntohl(address->sin_addr.s_addr) != INADDR_LOOPBACK || s->peer) {
+    evutil_closesocket(fd); guarded_fail(s, "unknown/extra socket admission"); return;
+  }
+  s->peer = bufferevent_socket_new(s->base, fd, BEV_OPT_CLOSE_ON_FREE | BEV_OPT_DEFER_CALLBACKS);
+  if (!s->peer) { evutil_closesocket(fd); guarded_fail(s, "peer allocation failed"); return; }
+  bufferevent_setcb(s->peer, guarded_peer_read, NULL, NULL, s);
+  if (bufferevent_enable(s->peer, EV_READ | EV_WRITE) < 0)
+    guarded_fail(s, "peer enable failed");
+}
+static int guarded_case(enum guarded_mode mode)
+{
+  struct guarded_fixture s = { .mode = mode };
+  struct sockaddr_in address = { .sin_family = AF_INET };
+  socklen_t length = sizeof(address);
+  struct timeval bound = {5, 0};
+  int i, count = mode == FIRST_REJECT ? 1 : mode == QUEUED_REJECT ? 2 : 3;
+  s.base = event_base_new();
+  if (!s.base) return 1;
+  address.sin_addr.s_addr = htonl(INADDR_LOOPBACK);
+  s.listener = evconnlistener_new_bind(s.base, guarded_accept, &s,
+      LEV_OPT_CLOSE_ON_FREE | LEV_OPT_REUSEABLE, 2, (struct sockaddr *)&address, sizeof(address));
+  if (!s.listener || getsockname(evconnlistener_get_fd(s.listener), (struct sockaddr *)&address, &length) < 0)
+    { guarded_fail(&s, "loopback listener setup failed"); goto cleanup; }
+  s.native = evrtsp_connection_new("127.0.0.1", ntohs(address.sin_port));
+  if (!s.native) { guarded_fail(&s, "actual connection allocation failed"); goto cleanup; }
+  evrtsp_connection_set_base(s.native, s.base);
+  s.deadline = evtimer_new(s.base, guarded_deadline, &s);
+  if (!s.deadline || evtimer_add(s.deadline, &bound) < 0)
+    { guarded_fail(&s, "deadline admission failed"); goto cleanup; }
+  for (i = 0; i < count; i++) {
+    struct evrtsp_request *request;
+    s.op[i].owner = &s; s.op[i].index = i;
+    request = evrtsp_request_new(guarded_response, &s.op[i]);
+    if (!request) { guarded_fail(&s, "request allocation failed"); goto cleanup; }
+    if (evrtsp_add_header(request->output_headers, "CSeq", "1") < 0
+        || evrtsp_add_header(request->output_headers, "Content-Length", "0") < 0) {
+      evrtsp_request_free(request); guarded_fail(&s, "header preparation failed"); goto cleanup;
+    }
+    if (evrtsp_make_request_guarded(s.native, request, EVRTSP_REQ_SET_PARAMETER,
+        "rtsp://127.0.0.1/pc9-guarded", guarded_current, &s.op[i]) < 0) {
+      evrtsp_request_free(request); guarded_fail(&s, "guarded admission failed"); goto cleanup;
+    }
+  }
+  if (event_base_dispatch(s.base) != 0) guarded_fail(&s, "loop exited without callback completion");
+  if (s.op[0].calls != 1 || (mode != FIRST_REJECT && s.op[1].calls != 1)
+      || (mode == NESTED_REJECT_FREE && (!s.cleanup_callback || s.op[2].calls)))
+    guarded_fail(&s, "exact terminal callback/cleanup inventory incomplete");
+cleanup:
+  if (s.deadline) event_free(s.deadline);
+  if (s.native) evrtsp_connection_free(s.native);
+  if (s.peer) bufferevent_free(s.peer);
+  if (s.listener) evconnlistener_free(s.listener);
+  event_base_free(s.base);
+  return s.failed;
+}
+static int negative_enqueue_ownership(void)
+{
+  struct event_base *base = event_base_new();
+  struct evrtsp_connection *connection = NULL;
+  struct evrtsp_request *request = NULL;
+  int failed = 1, guarded;
+  evutil_socket_t bound_fd = -1;
+  struct sockaddr_in reserved = { .sin_family = AF_INET };
+  socklen_t reserved_len = sizeof(reserved);
+  if (!base) return 1;
+  reserved.sin_addr.s_addr = htonl(INADDR_LOOPBACK);
+  bound_fd = socket(AF_INET, SOCK_STREAM, 0);
+  if (bound_fd < 0 || bind(bound_fd, (struct sockaddr *)&reserved, sizeof(reserved)) < 0
+      || listen(bound_fd, 1) < 0
+      || getsockname(bound_fd, (struct sockaddr *)&reserved, &reserved_len) < 0)
+    goto cleanup;
+  for (guarded = 0; guarded <= 1; guarded++) {
+    connection = evrtsp_connection_new("127.0.0.1", 9);
+    request = evrtsp_request_new(NULL, NULL);
+    if (!connection || !request) goto cleanup;
+    evrtsp_connection_set_base(connection, base);
+    /* Exact actual socket bind failure, without changing connection state or
+     * claiming native readiness. The library owns this allocated bind string. */
+    connection->bind_address = strdup("127.0.0.1");
+    connection->bind_port = ntohs(reserved.sin_port);
+    if (!connection->bind_address) goto cleanup;
+    if ((guarded ? evrtsp_make_request_guarded(connection, request, EVRTSP_REQ_SET_PARAMETER,
+             "rtsp://127.0.0.1/pc9-bind", NULL, NULL)
+        : evrtsp_make_request(connection, request, EVRTSP_REQ_SET_PARAMETER,
+             "rtsp://127.0.0.1/pc9-bind")) >= 0) goto cleanup;
+    if (guarded) {
+      if (queue_count(connection) != 0 || request->evcon != NULL) goto cleanup;
+      evrtsp_request_free(request); request = NULL;
+    } else {
+      if (queue_count(connection) != 1 || request->evcon != connection) goto cleanup;
+      request = NULL; /* Original RAOP connection ownership preserved on negative. */
+    }
+    evrtsp_connection_free(connection); connection = NULL;
+  }
+  failed = 0;
+cleanup:
+  if (request && (!connection || request->evcon != connection)) evrtsp_request_free(request);
+  if (connection) evrtsp_connection_free(connection);
+  if (bound_fd >= 0) evutil_closesocket(bound_fd);
+  event_base_free(base);
+  return failed;
+}
+int main(void)
+{
+  if (original_evrtsp_owner_main()) return EXIT_FAILURE;
+  if (guarded_case(FIRST_REJECT) || guarded_case(QUEUED_REJECT)
+      || guarded_case(NESTED_REJECT_FREE) || negative_enqueue_ownership()) return EXIT_FAILURE;
+  puts("PASS actual guarded queue ownership; no AirPlay/native acoustic acceptance");
+  return EXIT_SUCCESS;
+}
