+  current_fixture->start_calls++;
+  owner_fail(current_fixture, "old START consumed a current callback slot");
+}
+static void stop_done(struct output_device *device, enum output_device_state state)
+{
+  struct owner_fixture *f = current_fixture;
+  f->stop_calls++; f->terminal = state;
+  if (device != f->device || f->stop_calls != f->generation + 1 || f->start_calls
+      || device->session || airplay_sessions || airplay_master_sessions
+      || context_allocations != context_frees || fail_request_allocation)
+    { owner_fail(f, "terminal callback before actual session/request/master destruction"); return; }
+  if (f->mode == OLD_START_200 || f->mode == OLD_START_VOLUME_200 || f->mode == OLD_STOP_FRESH_START) {
+    if (state != OUTPUT_STATE_STOPPED || f->wire != (f->mode == OLD_START_VOLUME_200 ? 3 : 2))
+      { owner_fail(f, "old success did not preserve exact queued STOP terminal obligation"); return; }
+  } else if ((f->mode == OLD_START_REFUSED && (f->wire || f->peer))
+      || state != OUTPUT_STATE_FAILED || device->requires_auth
+      || device->v6_disabled || !device->auth_key || strcmp(device->auth_key, "fixture-retained-key"))
+    { owner_fail(f, "old failure retried/re-authorized or falsely acknowledged STOP"); return; }
+  if (f->mode == OLD_STOP_FRESH_START && !f->generation) {
+    f->retired_epoch = device->session_epoch;
+    f->generation = 1; f->wire = 0; f->old_peer = f->peer; f->old_peer_eof = f->peer_eof; f->peer_eof = false; f->peer = NULL;
+    outputs_device_select(device, 100); // Actual route transition resets old barrier.
+    if (outputs_device_start(device, start_done, false) != 1 || !device->session
+        || device->session_epoch <= f->retired_epoch)
+      { owner_fail(f, "normal fresh startup did not own a new native epoch"); return; }
+    return;
+  }
+  if (f->generation && !f->old_peer_eof)
+    { owner_fail(f, "old native connection destruction not observed before fresh completion"); return; }
+  event_base_loopbreak(f->base);
+}
+static int request_header(const char *header, const char *name)
+{
+  const char *p = strstr(header, name);
+  int value = -1;
+  if (!p || sscanf(p + strlen(name), "%d", &value) != 1) return -1;
+  return value;
+}
+static void peer_read(struct bufferevent *peer, void *arg)
+{
+  struct owner_fixture *f = arg;
+  struct evbuffer *input = bufferevent_get_input(peer);
+  struct evbuffer_ptr end = evbuffer_search(input, "\r\n\r\n", 4, NULL);
+  char header[4096], reply[256], expected_agent[128];
+  size_t length;
+  int bytes, cseq, code;
+  struct airplay_session *session;
+  if (end.pos < 0) {
+    if (evbuffer_get_length(input) > sizeof(header) - 1) owner_fail(f, "bounded RTSP header exceeded");
+    return;
+  }
+  length = (size_t)end.pos + 4;
+  if (length >= sizeof(header)) { owner_fail(f, "RTSP header too large"); return; }
+  evbuffer_copyout(input, header, length); header[length] = 0;
+  bytes = request_header(header, "Content-Length:");
+  cseq = request_header(header, "CSeq:");
+  if (bytes < 0) bytes = 0;
+  if (bytes > 65536 || cseq <= 0) { owner_fail(f, "RTSP request framing invalid"); return; }
+  if (evbuffer_get_length(input) < length + (size_t)bytes) return;
+  evbuffer_drain(input, length + (size_t)bytes);
+  snprintf(expected_agent, sizeof(expected_agent), "\r\nUser-Agent: %s\r\n", f->expected_user_agent);
+  if (!strstr(header, expected_agent))
+    { owner_fail(f, "actual RTSP User-Agent does not match AirPlay configuration"); return; }
+  f->wire++;
+  session = f->device->session;
+  if (f->wire == 1) {
+    if (strncmp(header, "GET /info RTSP/1.0", 18) || !session
+        || session->state != AIRPLAY_STATE_STOPPED || !session->sequence_requests
+        || session->reqs_in_flight != 1)
+      { owner_fail(f, "first actual START was not held at real GET/info queue owner"); return; }
+    if (f->generation) {
+      int old_fd = bufferevent_getfd(f->old_peer);
+      const char late[] = "RTSP/1.0 200 Retired\r\nCSeq: 1\r\nContent-Length: 0\r\n\r\n";
+      /* Old native fd was destroyed, not adopted by fresh START. This is only
+       * a real late server write attempt; no old client-fold completion claim. */
+      if (old_fd >= 0) (void)send(old_fd, late, sizeof(late) - 1, MSG_NOSIGNAL);
+      if (f->device->session != session || session->session_epoch <= f->retired_epoch
+          || session->callback_revision != 1 || f->stop_calls != 1)
+        { owner_fail(f, "retired wire affected fresh session/callback currency"); return; }
+    }
+    f->old_slot = session->callback_id; f->old_revision = session->callback_revision;
+    /* Actual native route-suspend owner marks the real startup session managed;
+     * it truthfully returns desired_only before connection/SETUP readiness. */
+    outputs_attention_route_barrier(f->device);
+    if (!session->attention_managed || !session->attention_suspended
+        || session->state != AIRPLAY_STATE_STOPPED)
+      { owner_fail(f, "actual route suspension manufactured connection readiness"); return; }
+    if (f->mode == OLD_START_VOLUME_200)
+      sequence_start(AIRPLAY_SEQ_SEND_VOLUME, session, NULL, "lower-sequence-owner-only");
+    if (f->mode == CALLBACK_OVERFLOW) session->callback_revision = UINT64_MAX;
+    if (f->mode == STOP_ALLOCATION_FAILURE) fail_request_allocation = true;
+    if (outputs_device_stop(f->device, stop_done) != 1)
+      { owner_fail(f, "actual STOP was not retained as pending"); return; }
+    if (session->callback_id != f->old_slot
+        || (f->mode != CALLBACK_OVERFLOW && session->callback_revision != f->old_revision + 1))
+      { owner_fail(f, "regression failed to reproduce real same-slot command replacement"); return; }
+    if (f->mode == OLD_START_EOF) {
+      bufferevent_free(f->peer); f->peer = NULL; return;
+    }
+    if (f->mode == STOP_ALLOCATION_FAILURE || f->mode == CALLBACK_OVERFLOW) return;
+    code = f->mode == OLD_START_503 ? 503 : 200;
+  } else {
+    if (!session || session->state != AIRPLAY_STATE_TEARDOWN || f->stop_calls != f->generation
+        || session->callback_id != f->old_slot
+        || session->callback_revision != f->old_revision + 1)
+      { owner_fail(f, "old response changed state/consumed queued STOP before terminal wire"); return; }
+    if (f->mode == OLD_START_VOLUME_200 && f->wire == 2) {
+      if (strncmp(header, "SET_PARAMETER ", 14)) { owner_fail(f, "lower sequence volume absent"); return; }
+    } else if (strncmp(header, "TEARDOWN ", 9)) { owner_fail(f, "exact STOP wire absent"); return; }
+    code = 200;
+  }
+  bytes = snprintf(reply, sizeof(reply), "RTSP/1.0 %d Controlled\r\nCSeq: %d\r\nContent-Length: 0\r\n\r\n", code, cseq);
+  if (bytes <= 0 || (size_t)bytes >= sizeof(reply) || bufferevent_write(peer, reply, bytes) < 0)
+    owner_fail(f, "controlled wire reply failed");
+}
+static void peer_event(struct bufferevent *peer, short what, void *arg)
+{
+  struct owner_fixture *f = arg;
+  if (what & BEV_EVENT_EOF) {
+    if (peer == f->old_peer) f->old_peer_eof = true;
+    else if (peer == f->peer) f->peer_eof = true;
+  }
+  else if (what & BEV_EVENT_ERROR) owner_fail(f, "unexpected controlled peer I/O error");
+}
+static void peer_accept(struct evconnlistener *listener, evutil_socket_t fd,
+    struct sockaddr *remote, int length, void *arg)
+{
+  struct owner_fixture *f = arg;
+  struct sockaddr_in *a = (struct sockaddr_in *)remote;
+  (void)listener;
+  if (length < (int)sizeof(*a) || a->sin_family != AF_INET
+      || ntohl(a->sin_addr.s_addr) != INADDR_LOOPBACK || f->peer) {
+    evutil_closesocket(fd); owner_fail(f, "unknown/extra fixture socket"); return;
+  }
+  f->peer = bufferevent_socket_new(f->base, fd, BEV_OPT_CLOSE_ON_FREE | BEV_OPT_DEFER_CALLBACKS);
+  if (!f->peer) { evutil_closesocket(fd); owner_fail(f, "accepted socket owner allocation"); return; }
+  bufferevent_setcb(f->peer, peer_read, NULL, peer_event, f);
+  if (bufferevent_enable(f->peer, EV_READ | EV_WRITE) < 0) owner_fail(f, "peer enable");
+}
+static int owner_case(enum owner_mode mode, int agent_case)
+{
+  struct owner_fixture f = { .mode = mode, .refused_fd = -1,
+    .expected_user_agent = agent_case == 2 ? "AirPlay/123.4.5" : "AirPlay/999.0.0" };
+  struct sockaddr_in address = { .sin_family = AF_INET };
+  socklen_t length = sizeof(address);
+  struct timeval bound = {5, 0};
+  struct airplay_extra *extra;
+  int i, result;
+  char database_path[]="/tmp/native-airplay-owner-XXXXXX";
+  bool database_ready=false;
+  int database_fd=mkstemp(database_path);
+  if (database_fd < 0) return 1;
+  close(database_fd);
+  current_fixture = &f; context_allocations = context_frees = 0;
+  memset(contexts, 0, sizeof(contexts)); fail_request_allocation = false;
+  f.base = event_base_new(); if (!f.base) return 1;
+  evbase_player = f.base;
+  cfg = cfg_init(toplvl_cfg, CFGF_NONE); if (!cfg) { f.failed = 1; goto cleanup; }
+  if (agent_case && cfg_parse_buf(cfg, agent_case == 1
+      ? "general { user_agent = General/custom }"
+      : "general { user_agent = General/custom } airplay_shared { user_agent = AirPlay/123.4.5 }") != CFG_SUCCESS)
+    { owner_fail(&f, "actual explicit User-Agent configuration rejected"); goto cleanup; }
+  cfg_setstr(cfg_getsec(cfg,"general"),"db_path",database_path);
+  if (db_init(ATTENTION_TEST_SQLEXT_PATH) < 0 || db_perthread_init() < 0)
+    { owner_fail(&f,"actual private native DB startup"); goto cleanup; }
+  database_ready=true;
+  fixture_service_bind_calls = 0;
+  /* Run the actual production selector. Refuse its first service bind, so no
+   * discovery, UDP socket or PTP service starts; the existing failure path
+   * frees the keep-alive timer before the normal loopback START below. */
+  if (airplay_init() != -1 || fixture_service_bind_calls != 1)
+    { owner_fail(&f, "actual AirPlay initialization did not stop at service boundary"); goto cleanup; }
+  keep_alive_timer = NULL;
+  if (!airplay_user_agent || !airplay_client_name
+      || strcmp(cfg_getstr(cfg_getsec(cfg, "general"), "user_agent"),
+          agent_case ? "General/custom" : PACKAGE_NAME "/" PACKAGE_VERSION))
+    { owner_fail(&f, "AirPlay initialization changed general User-Agent"); goto cleanup; }
+  /* Initialize only the existing passive outputs callback event/default buffer,
+   * not outputs_init's discovery/backend sockets, library, bus or daemon. */
+  outputs_deferredev = evtimer_new(f.base, deferred_cb, NULL);
+  outputs_buffer_duration_ms = cfg_getint(cfg_getsec(cfg, "general"), "start_buffer_ms");
+  outputs_attention_uuid(outputs_process);
+  if (outputs_attention_startup() < 0) { owner_fail(&f,"actual durable native process startup"); goto cleanup; }
+  address.sin_addr.s_addr = htonl(INADDR_LOOPBACK);
+  if (mode == OLD_START_REFUSED) {
+    /* Keep the actual ephemeral port bound but never listen. The kernel,
+     * not a fabricated session/response, refuses this owned connection. */
+    f.refused_fd = socket(AF_INET, SOCK_STREAM, 0);
+    if (f.refused_fd < 0 || bind(f.refused_fd, (struct sockaddr *)&address, sizeof(address))
+        || getsockname(f.refused_fd, (struct sockaddr *)&address, &length))
+      { owner_fail(&f, "owned nonlistener setup"); goto cleanup; }
+  } else {
+    f.listener = evconnlistener_new_bind(f.base, peer_accept, &f,
+        LEV_OPT_CLOSE_ON_FREE | LEV_OPT_REUSEABLE, 2, (struct sockaddr *)&address, sizeof(address));
+    if (!f.listener || getsockname(evconnlistener_get_fd(f.listener), (struct sockaddr *)&address, &length))
+      { owner_fail(&f, "owned loopback setup"); goto cleanup; }
+  }
+  if (!outputs_deferredev) { owner_fail(&f, "callback event setup"); goto cleanup; }
+  f.deadline = evtimer_new(f.base, owner_deadline, &f);
+  if (!f.deadline || evtimer_add(f.deadline, &bound)) { owner_fail(&f, "finite owner deadline"); goto cleanup; }
+  f.device = calloc(1, sizeof(*f.device)); extra = calloc(1, sizeof(*extra));
+  if (!f.device || !extra) { free(f.device); free(extra); f.device = NULL; f.failed = 1; goto cleanup; }
+  f.device->id = 1; f.device->name = strdup("private-native-owner");
+  f.device->type = OUTPUT_TYPE_AIRPLAY; f.device->type_name = "AirPlay";
+  f.device->advertised = true; f.device->quality = (struct media_quality){44100,16,2};
+  f.device->v4_address = strdup("127.0.0.1"); f.device->v4_port = ntohs(address.sin_port);
+  f.device->auth_key = strdup("fixture-retained-key");
+  f.device->extra_device_info = extra; extra->mdns_name = strdup("private-native-owner");
+  if (!f.device->name || !f.device->v4_address || !f.device->auth_key || !extra->mdns_name)
+    { f.failed = 1; goto cleanup; }
+  f.device = outputs_device_add(f.device, false);
+  f.registered = f.device != NULL;
+  if (!f.device || outputs_device_start(f.device, start_done, false) != 1)
+    { owner_fail(&f, "real AirPlay session/master/codec startup refused"); goto cleanup; }
+  if (mode == OLD_START_REFUSED) {
+    struct airplay_session *session = f.device->session;
+    if (!session || session->reqs_in_flight != 1 || !session->sequence_requests
+        || session->ctrl->state != EVCON_CONNECTING)
+      { owner_fail(&f, "actual START did not own a pending kernel connect"); goto cleanup; }
+    f.old_slot = session->callback_id; f.old_revision = session->callback_revision;
+    outputs_attention_route_barrier(f.device);
+    if (outputs_device_stop(f.device, stop_done) != 1
+        || session->reqs_in_flight != 2 || session->callback_id != f.old_slot
+        || session->callback_revision != f.old_revision + 1)
+      { owner_fail(&f, "refused START did not retain actual same-slot queued STOP"); goto cleanup; }
+  }
+  if (event_base_dispatch(f.base) != 0) owner_fail(&f, "native loop exited without terminal owner callback");
+  if (f.stop_calls != f.generation + 1 || f.start_calls || context_allocations != context_frees
+      || airplay_sessions || airplay_master_sessions)
+    owner_fail(&f, "test cleanup would mask an unjoined production sequence owner");
+ cleanup:
+  /* Assertions above precede unconditional exact fixture rescue. No guessed
+   * session state, global task sweep, service or application ACK is supplied. */
+  while (airplay_sessions) session_cleanup(airplay_sessions);
+  for (i = 0; i < (int)ARRAY_SIZE(contexts); i++)
+    if (contexts[i]) { fprintf(stderr, "FAIL: stranded exact sequence context\n"); f.failed = 1; }
+  if (outputs_device_list) outputs_device_remove(outputs_device_list);
+  else if (f.device && !f.registered) outputs_device_free(f.device);
+  if (f.peer) bufferevent_free(f.peer);
+  if (f.old_peer) bufferevent_free(f.old_peer);
+  if (f.listener) evconnlistener_free(f.listener);
+  if (f.refused_fd >= 0) evutil_closesocket(f.refused_fd);
+  if (f.deadline) event_free(f.deadline);
+  if (outputs_deferredev) event_free(outputs_deferredev);
+  outputs_deferredev = NULL;
+  airplay_user_agent = NULL; airplay_client_name = NULL;
+  if (database_ready) db_perthread_deinit();
+  db_deinit(); unlink(database_path);
+  if (cfg) cfg_free(cfg);
+  cfg = NULL;
+  result = f.failed; event_base_free(f.base); evbase_player = NULL; current_fixture = NULL;
+  memset(outputs_cb_register, 0, sizeof(outputs_cb_register));
+  memset(attention_results, 0, sizeof(attention_results));
+  memset(attention_result_reserved, 0, sizeof(attention_result_reserved));
+  return result;
+}
+
+/* Actual ordinary queue connect-error callbacks: borrowed nonNULL request,
+ * raw status zero and detached ownership remain unchanged. No request/session
+ * result is substituted. A second actual event base permits a nested native
+ * callback to synchronously free both live connections while A's loop is on
+ * the stack, without invoking a fabricated connection callback. */
+enum raw_mode { RAW_FREE, RAW_NONFREE, RAW_NESTED_FREE };
+struct raw_fixture;
+struct raw_operation { struct raw_fixture *fixture; int index; };
+struct raw_fixture {
+  enum raw_mode mode;
+  struct event_base *base[2];
+  struct event *deadline[2];
+  struct evrtsp_connection *connection[2];
+  void *connection_pointer[2];
+  struct evrtsp_request *request[4];
+  struct raw_operation operation[4];
+  int request_frees[4], connection_frees[2], order[4], callbacks;
+  int refused_fd, failed, nested_returned;
+  unsigned short port;
+};
+static struct raw_fixture *current_raw;
+static void raw_free_observe(void *pointer)
+{
+  int i;
+  if (!current_raw || !pointer) return;
+  for (i = 0; i < 4; i++)
+    if (pointer == current_raw->request[i]) current_raw->request_frees[i]++;
+  for (i = 0; i < 2; i++)
+    if (pointer == current_raw->connection_pointer[i]) current_raw->connection_frees[i]++;
+}
+static void raw_fail(struct raw_fixture *f, const char *why)
+{
+  int i;
+  fprintf(stderr, "FAIL raw-connect-owner=%d: %s\n", f->mode, why);
+  f->failed = 1;
+  for (i = 0; i < 2; i++) if (f->base[i]) event_base_loopbreak(f->base[i]);
+}
+static void raw_deadline(evutil_socket_t fd, short what, void *arg)
+{ (void)fd; (void)what; raw_fail(arg, "five-second native owner bound exhausted"); }
+static int raw_enqueue(struct raw_fixture *f, int which);
+static void raw_response(struct evrtsp_request *request, void *arg)
+{
+  struct raw_operation *operation = arg;
+  struct raw_fixture *f = operation->fixture;
+  int index = operation->index;
+  if (f->callbacks >= 4 || request != f->request[index] || !request
+      || request->evcon || request->response_code != 0)
+    { raw_fail(f, "ordinary raw callback request/status/ownership changed"); return; }
+  f->order[f->callbacks++] = index;
+  if (f->mode == RAW_NONFREE) {
+    if (index == 1) event_base_loopbreak(f->base[0]);
+    return;
+  }
+  if (f->mode == RAW_NESTED_FREE && index == 0) {
+    if (raw_enqueue(f, 1) < 0) return;
+    if (event_base_dispatch(f->base[1]) != 0 || f->failed)
+      { raw_fail(f, "actual nested native event owner did not return"); return; }
+    f->nested_returned = 1;
+    event_base_loopbreak(f->base[0]);
+    return;
+  }
+  if ((f->mode == RAW_FREE && index == 0) || (f->mode == RAW_NESTED_FREE && index == 2)) {
+    /* Both queued successors are still library-owned. Synchronous free cancels
+     * them without invoking their callbacks; local loop observers alone survive. */
+    evrtsp_connection_free(f->connection[0]); f->connection[0] = NULL;
+    if (f->mode == RAW_NESTED_FREE) {
+      evrtsp_connection_free(f->connection[1]); f->connection[1] = NULL;
+      event_base_loopbreak(f->base[1]);
+    } else event_base_loopbreak(f->base[0]);
+    return;
+  }
+  raw_fail(f, "canceled queued successor callback ran after synchronous destruction");
+}
+static int raw_enqueue(struct raw_fixture *f, int which)
+{
+  int i, index;
+  struct timeval bound = {5, 0};
+  f->base[which] = event_base_new();
+  if (!f->base[which]) { raw_fail(f, "event-base allocation"); return -1; }
+  f->deadline[which] = evtimer_new(f->base[which], raw_deadline, f);
+  if (!f->deadline[which] || evtimer_add(f->deadline[which], &bound))
+    { raw_fail(f, "bounded timer owner"); return -1; }
+  f->connection[which] = evrtsp_connection_new("127.0.0.1", f->port);
+  if (!f->connection[which]) { raw_fail(f, "actual connection constructor"); return -1; }
+  f->connection_pointer[which] = f->connection[which];
+  evrtsp_connection_set_base(f->connection[which], f->base[which]);
+  for (i = 0; i < 2; i++) {
+    index = which * 2 + i;
+    f->operation[index] = (struct raw_operation){ f, index };
+    f->request[index] = evrtsp_request_new(raw_response, &f->operation[index]);
+    if (!f->request[index]) { raw_fail(f, "actual request allocation"); return -1; }
+    /* The ordinary producer retains connection ownership even on negative.
+     * Cleanup below therefore never separately frees an enqueued request. */
+    if (evrtsp_make_request(f->connection[which], f->request[index], EVRTSP_REQ_OPTIONS, "*") < 0)
+      { raw_fail(f, "request did not reach actual asynchronous connect owner"); return -1; }
+  }
+  if (f->connection[which]->state != EVCON_CONNECTING)
+    { raw_fail(f, "actual kernel connection attempt was not pending"); return -1; }
+  return 0;
+}
+static int raw_case(enum raw_mode mode)
+{
+  struct raw_fixture f = { .mode = mode, .refused_fd = -1 };
+  struct sockaddr_in address = { .sin_family = AF_INET };
+  socklen_t length = sizeof(address);
+  int i, expected = mode == RAW_NESTED_FREE ? 4 : 2;
+  current_raw = &f;
+  address.sin_addr.s_addr = htonl(INADDR_LOOPBACK);
+  f.refused_fd = socket(AF_INET, SOCK_STREAM, 0);
+  if (f.refused_fd < 0 || bind(f.refused_fd, (struct sockaddr *)&address, sizeof(address))
+      || getsockname(f.refused_fd, (struct sockaddr *)&address, &length))
+    { raw_fail(&f, "retained bound nonlistener socket"); goto cleanup; }
+  f.port = ntohs(address.sin_port);
+  if (raw_enqueue(&f, 0) < 0) goto cleanup;
+  if (event_base_dispatch(f.base[0]) != 0)
+    { raw_fail(&f, "outer actual native callback owner did not finish"); goto cleanup; }
+  if (mode == RAW_NONFREE) {
+    if (f.callbacks != 2 || f.order[0] != 0 || f.order[1] != 1
+        || !TAILQ_EMPTY(&f.connection[0]->requests) || f.connection[0]->free_observer)
+      { raw_fail(&f, "nonfree raw FIFO/local observer restoration changed"); goto cleanup; }
+    evrtsp_connection_free(f.connection[0]); f.connection[0] = NULL;
+  } else if (f.callbacks != (mode == RAW_FREE ? 1 : 2) || f.order[0] != 0
+      || (mode == RAW_NESTED_FREE && (f.order[1] != 2 || !f.nested_returned)))
+    { raw_fail(&f, "free or nested-free callback order/count changed"); goto cleanup; }
+  for (i = 0; i < expected; i++)
+    if (f.request_frees[i] != 1) raw_fail(&f, "actual request was not freed exactly once before rescue");
+  for (i = 0; i < expected / 2; i++)
+    if (f.connection[i] || f.connection_frees[i] != 1)
+      raw_fail(&f, "actual control connection did not synchronously retire exactly once");
+ cleanup:
+  /* Primary assertions precede exact fixture rescue. No unknown sockets/tasks,
+   * manual native state, response ACK or connection callback are injected. */
+  for (i = 0; i < 2; i++) {
+    if (f.connection[i]) evrtsp_connection_free(f.connection[i]);
+    if (f.deadline[i]) event_free(f.deadline[i]);
+    if (f.base[i]) event_base_free(f.base[i]);
+  }
+  if (f.refused_fd >= 0) evutil_closesocket(f.refused_fd);
+  current_raw = NULL;
+  return f.failed;
+}
+
+/* Actual public native RECOVER through file SQLite, real transient pairing,
+ * cipher, existing RAOP startup and strict SET_PARAMETER/TEARDOWN callbacks.
+ * The receiver is one owned loopback fixture, never a HomePod/physical claim. */
+struct recovery_wire_fixture {
+  struct event_base *base;
+  struct evconnlistener *listener;
+  struct bufferevent *peer;
+  struct evbuffer *plain;
+  struct pair_setup_context *pair;
+  struct pair_cipher_context *cipher;
+  struct event *poll,*deadline;
+  struct output_device *device;
+  struct output_attention_request command;
+  struct output_attention_result result;
+  unsigned short udp_port;
+  int udp_fd,mode,phase,failed,wire,volumes,teardowns,pair_messages,start_callbacks,stop_callbacks;
+  struct output_attention_result handoff;
+};
+
+static struct recovery_wire_fixture *active_recovery_wire;
+static void recovery_wire_connected(struct output_device *, enum output_device_state);
+static void recovery_wire_stopped(struct output_device *, enum output_device_state);
