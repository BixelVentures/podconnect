+        replacement->id = old->id; replacement->name = strdup(old->name);
+        replacement->type = old->type; replacement->type_name = old->type_name;
+        replacement->advertised = true; replacement->quality = old->quality;
+        replacement->v4_address = strdup(old->v4_address); replacement->v4_port = old->v4_port;
+        replacement->extra_device_info = extra; extra->mdns_name = strdup(old->name);
