+        outputs_attention_state_get(f->device->id, &release.expected);
+        if (outputs_attention_admit(&release, &f->handoff) < 0
+            || f->handoff.outcome != OUTPUT_ATTENTION_PENDING
+            || outputs_attention_state_get(f->device->id, &state) < 0
+            || state.recovery_idle || !state.lease || !state.restoring)
