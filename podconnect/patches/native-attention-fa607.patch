+  assert(outputs_device_volume_register(a,65,-1)<0 && a->volume==30 && transport_calls==sent);
+  assert(sqlite3_exec(hdl,"PRAGMA query_only=OFF",NULL,NULL,NULL)==SQLITE_OK);
+  transport_return=1; pending=request(1,OUTPUT_ATTENTION_BEGIN); origin=a->attention_origin;
+  outputs_attention_complete(&pending,OUTPUT_ATTENTION_UNKNOWN,0,0);
+  cold_restart_preserving_native_database(); a=add_device(1);
+  recover=recovery_request(1,&origin); assert(outputs_attention_admit(&recover,&pending)==0);
+  outputs_attention_complete(&pending,OUTPUT_ATTENTION_UNKNOWN,200,70); // No matching-CSeq proof.
+  outputs_attention_complete(&pending,OUTPUT_ATTENTION_PROTOCOL_ACCEPTED,200,70); // Late duplicate cannot upgrade UNKNOWN.
+  assert(db_attention_origin_get(1,&origin,&origin_state,&proof)==0 && origin_state==OUTPUT_RECOVERY_PENDING);
+  assert(outputs_attention_result_get(pending.identity.process,pending.operation,&result)==0 && result.recovery_state==OUTPUT_RECOVERY_UNKNOWN);
+  recover=recovery_request(1,&origin); assert(outputs_attention_admit(&recover,&pending)==0);
+  assert(outputs_device_volume_register(a,67,-1)==0);
+  outputs_attention_complete(&pending,OUTPUT_ATTENTION_PROTOCOL_ACCEPTED,200,71);
+  assert(db_attention_origin_get(1,&origin,&origin_state,&proof)==0 && origin_state==OUTPUT_RECOVERY_PENDING);
+  assert(outputs_attention_result_get(pending.identity.process,pending.operation,&result)==0 && !result.current && result.recovery_state==OUTPUT_RECOVERY_UNKNOWN);
+  recover=recovery_request(1,&origin); assert(outputs_attention_admit(&recover,&pending)==0);
+  assert(sqlite3_exec(hdl,"PRAGMA query_only=ON",NULL,NULL,NULL)==SQLITE_OK);
+  outputs_attention_complete(&pending,OUTPUT_ATTENTION_PROTOCOL_ACCEPTED,200,72);
+  assert(outputs_attention_result_get(pending.identity.process,pending.operation,&result)==0 && result.recovery_state==OUTPUT_RECOVERY_UNKNOWN);
+  assert(sqlite3_exec(hdl,"PRAGMA query_only=OFF",NULL,NULL,NULL)==SQLITE_OK);
+  assert(db_attention_origin_get(1,&origin,&origin_state,&proof)==0 && origin_state==OUTPUT_RECOVERY_PENDING);
+  cold_restart_preserving_native_database(); a=add_device(1);
+  recover=recovery_request(1,&origin); assert(outputs_attention_admit(&recover,&result)==0 && result.identity.base_volume==67);
+  outputs_attention_complete(&pending,OUTPUT_ATTENTION_PROTOCOL_ACCEPTED,200,72); // Old process callback is inert.
+  assert(db_attention_origin_get(1,&origin,&origin_state,&proof)==0 && origin_state==OUTPUT_RECOVERY_PENDING);
+  outputs_attention_complete(&result,OUTPUT_ATTENTION_PROTOCOL_ACCEPTED,200,73);
+  assert(db_attention_origin_get(1,&origin,&origin_state,&proof)==0 && origin_state==OUTPUT_RECOVERY_ALREADY_RETIRED && proof.terminal_request_cseq==73);
+  clear_devices();
+}
+
