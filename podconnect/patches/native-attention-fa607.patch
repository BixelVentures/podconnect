+static void recovery_wire_fail(struct recovery_wire_fixture *f,const char *why)
+{ fprintf(stderr,"FAIL native recovery wire mode%d: %s\n",f->mode,why); f->failed=1; event_base_loopbreak(f->base); }
+
+static void recovery_wire_deadline(int fd,short what,void *arg)
+{ (void)fd;(void)what; recovery_wire_fail(arg,"finite existing owner bound"); }
