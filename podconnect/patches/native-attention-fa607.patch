+static json_object *
+attention_result_to_json(const struct output_attention_result *result)
+{
+  const char *names[] = { "pending", "desired_only", "protocol_accepted", "failed", "unknown", "no_effect" };
+  const char *actions[] = { "begin", "update", "release", "flush", "manual", "recover" };
+  json_object *object = json_object_new_object();
+  json_object_object_add(object, "identity", attention_state_to_json(&result->identity));
+  json_object_object_add(object, "request_id", json_object_new_string(result->command.request_id));
+  attention_json_u64(object, "operation", result->operation);
+  json_object_object_add(object, "action", json_object_new_string(actions[result->action]));
+  json_object_object_add(object, "outcome", json_object_new_string(names[result->outcome]));
+  json_object_object_add(object, "response_code", json_object_new_int(result->response_code));
+  json_object_object_add(object, "request_cseq", json_object_new_int(result->request_cseq));
+  json_object_object_add(object, "current", json_object_new_boolean(result->current));
+  if (result->action == OUTPUT_ATTENTION_RECOVER)
+    {
+      const char *states[] = {"none","pending","restored","already_retired","never_admitted","unknown"};
+      json_object *origin = json_object_new_object(), *proof = json_object_new_object();
+      json_object_object_add(origin,"process",json_object_new_string(result->command.origin.process));
+      json_object_object_add(origin,"request_id",json_object_new_string(result->command.origin.request_id));
+      json_object_object_add(object,"origin",origin);
+      json_object_object_add(object,"recovery_state",json_object_new_string(states[result->recovery_state]));
+      json_object_object_add(proof,"database",json_object_new_string(result->recovery_proof.database));
+      json_object_object_add(proof,"ledger_complete",json_object_new_boolean(result->recovery_proof.ledger_complete));
+      if (result->recovery_proof.terminal_operation)
+        {
+          json_object *terminal = json_object_new_object();
+          json_object_object_add(terminal,"identity",attention_state_to_json(&result->recovery_proof.terminal_identity));
+          json_object_object_add(terminal,"request_id",json_object_new_string(result->recovery_proof.terminal_request_id));
+          attention_json_u64(terminal,"operation",result->recovery_proof.terminal_operation);
+          json_object_object_add(terminal,"action",json_object_new_string(actions[result->recovery_proof.terminal_action]));
+          json_object_object_add(terminal,"response_code",json_object_new_int(result->recovery_proof.terminal_response_code));
+          json_object_object_add(terminal,"request_cseq",json_object_new_int(result->recovery_proof.terminal_request_cseq));
+          json_object_object_add(proof,"terminal",terminal);
+        }
+      json_object_object_add(object,"recovery_proof",proof);
+    }
