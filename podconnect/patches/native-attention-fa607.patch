+static void manual_failed_restore_uses_original_uuid_without_clearing_lease(void)
+{
+  struct output_device *a = add_device(1);
+  struct output_attention_request manual = { .action = OUTPUT_ATTENTION_MANUAL, .cap_volume = 65 };
+  struct output_attention_result first, repeated;
+  uint64_t lease;
+  first = request(1, OUTPUT_ATTENTION_BEGIN); lease = a->attention_lease;
+  transport_return = 1;
+  first = request(1, OUTPUT_ATTENTION_RELEASE);
+  outputs_attention_complete(&first, OUTPUT_ATTENTION_FAILED, 503, 11);
+  assert(a->attention_restoring && a->attention_lease == lease);
+  assert(outputs_attention_state_get(1, &manual.expected) == 0);
+  memcpy(manual.request_id, "00000000-0000-4000-8000-000000000203", sizeof(manual.request_id));
+  assert(outputs_attention_admit(&manual, &first) == 0 && first.outcome == OUTPUT_ATTENTION_PENDING);
+  assert(a->volume == 65 && a->attention_restoring && a->attention_lease == lease);
+  outputs_attention_complete(&first, OUTPUT_ATTENTION_UNKNOWN, 0, 12);
+  outputs_attention_complete(&first, OUTPUT_ATTENTION_PROTOCOL_ACCEPTED, 200, 12);
+  assert(outputs_attention_admit(&manual, &repeated) == 0);
+  assert(repeated.operation == first.operation && repeated.outcome == OUTPUT_ATTENTION_UNKNOWN);
+  assert(a->attention_lease == lease && a->attention_restoring); /* no fake release */
+  transport_return = 0;
+  repeated = request(1, OUTPUT_ATTENTION_RELEASE);
+  assert(a->attention_lease == 0 && repeated.identity.effective_volume == 65);
+  clear_devices();
+}
