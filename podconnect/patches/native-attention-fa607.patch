+  if (!state || !device || !outputs_process[0]
+      || device->session_epoch == UINT64_MAX || device->base_revision == UINT64_MAX
+      || device->attention_revision == UINT64_MAX || device->route_revision == UINT64_MAX)
+    return -1;
