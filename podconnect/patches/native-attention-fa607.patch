+void
+outputs_attention_complete(const struct output_attention_result *operation, enum output_attention_outcome outcome, int response_code, int cseq)
+{
+  struct output_attention_result *retained;
+  struct output_attention_state current;
+  struct output_device *device;
+  struct output_attention_result original;
+
+  if (!operation || outcome == OUTPUT_ATTENTION_PENDING)
+    return;
+  original = *operation;
+  operation = &original;
+  retained = attention_result_find(operation->identity.process, operation->operation);
+  if (!retained || retained->outcome != OUTPUT_ATTENTION_PENDING
+      || !attention_identity_equal(&retained->identity, &operation->identity))
+    return;
+  device = outputs_device_get(operation->identity.device_id);
+  if (operation->action != OUTPUT_ATTENTION_FLUSH)
+    {
+      struct output_attention_result durable = *retained;
+      bool current_owner = device && outputs_attention_state_get(device->id, &current) == 0
+        && (attention_identity_equal(&current, &operation->identity)
+            || attention_recovery_terminal_current(operation, &current));
+      bool retired = current_owner && outcome == OUTPUT_ATTENTION_PROTOCOL_ACCEPTED
+        && response_code == 200 && cseq > 0
+        && (operation->action == OUTPUT_ATTENTION_RELEASE || operation->action == OUTPUT_ATTENTION_RECOVER);
+      durable.outcome = outcome;
+      durable.response_code = response_code;
+      durable.request_cseq = cseq;
+      if (operation->action == OUTPUT_ATTENTION_RECOVER)
+        {
+          durable.recovery_state = retired ? OUTPUT_RECOVERY_RESTORED : OUTPUT_RECOVERY_UNKNOWN;
+          if (!retired && outcome == OUTPUT_ATTENTION_PROTOCOL_ACCEPTED)
+            durable.outcome = outcome = OUTPUT_ATTENTION_UNKNOWN;
+        }
+      if (db_attention_receipt_save(&durable, retired) < 0)
+        {
+          outcome = OUTPUT_ATTENTION_UNKNOWN; // A socket ACK is not durable custody retirement.
+          durable.recovery_state = OUTPUT_RECOVERY_UNKNOWN;
+        }
+      retained->recovery_state = durable.recovery_state;
+      if (retired && outcome == OUTPUT_ATTENTION_PROTOCOL_ACCEPTED)
+        {
+          enum output_attention_recovery_state proof_state;
+          db_attention_origin_get(device->id, &durable.command.origin, &proof_state, &retained->recovery_proof);
+        }
+    }
+  // One exact operation has one terminal outcome. No last-callback-wins fold.
+  retained->outcome = outcome;
+  retained->response_code = response_code;
+  retained->request_cseq = cseq;
+  device = outputs_device_get(operation->identity.device_id);
+  if (!device || device->incarnation != operation->identity.device_incarnation)
+    return;
+  if (operation->action == OUTPUT_ATTENTION_RELEASE
+      && (outcome == OUTPUT_ATTENTION_PROTOCOL_ACCEPTED || outcome == OUTPUT_ATTENTION_DESIRED_ONLY)
+      && outputs_attention_state_get(device->id, &current) == 0
+      && (attention_identity_equal(&current, &operation->identity) || attention_recovery_terminal_current(operation,&current)))
+    {
+      device->attention_lease = 0;
+      device->attention_restoring = false;
+      device->attention_expired = false;
+      event_del(device->attention_timer);
+      if (!device->selected && device->session)
+        {
+          // Restoration no longer needs retained A. Re-enter the original
+          // backend STOP/TEARDOWN owner; no shared B stop or invented deadline.
+          outputs_device_stop(device, NULL);
+          return; // STOP may retire the session; no further retained-session work.
+        }
+    }
+  // A pending duck may settle after its native deadline. Reconcile that exact
+  // still-owned lease once; no periodic volume retry or new lease adoption.
+  if (device->attention_lease && !device->selected && !device->route_operation)
+    attention_route_suspend(device);
+  if (device->selected && device->session_epoch == operation->identity.session_epoch
+      && outputs[device->type]->device_attention_resume)
+    outputs[device->type]->device_attention_resume(device);
+  if (device->attention_expired && !device->attention_expiry_attempted)
+    attention_expiry_reconcile(device);
+}
+
+void
+outputs_attention_control_drained(const struct output_attention_result *operation)
+{
+  struct output_device *device=outputs_device_get(operation->identity.device_id);
+  if (device && !strcmp(operation->identity.process,outputs_process) && !device->session
+      && device->incarnation==operation->identity.device_incarnation
+      && operation->identity.session_epoch!=UINT64_MAX
+      && device->session_epoch==operation->identity.session_epoch+1)
+    {
+      device->attention_last_drained_operation=operation->operation;
+      memcpy(device->attention_last_drained_request_id,operation->command.request_id,sizeof(device->attention_last_drained_request_id));
+    }
+}
+
+void
+outputs_attention_handoff_drained(const struct output_attention_result *operation)
+{
+  struct output_attention_state state;
+  struct output_device *device=outputs_device_get(operation->identity.device_id);
+  if (device && operation->action == OUTPUT_ATTENTION_RELEASE
+      && outputs_attention_state_get(device->id,&state)==0
+      && !strcmp(operation->identity.process,outputs_process) && !device->session
+      && device->incarnation==operation->identity.device_incarnation
+      && operation->identity.session_epoch!=UINT64_MAX
+      && device->session_epoch==operation->identity.session_epoch+1
+      && device->attention_lease==operation->identity.lease
+      && device->attention_revision==operation->identity.attention_revision)
+    {
+      // Retire only volatile command/control custody. BASE is still UNKNOWN;
+      // the durable original origin continues to fence every fresh BEGIN.
+      device->attention_lease=0;
+      device->attention_restoring=false;
+      device->attention_expired=false;
+      event_del(device->attention_timer);
+    }
+  outputs_attention_complete(operation,OUTPUT_ATTENTION_UNKNOWN,0,0);
+}
