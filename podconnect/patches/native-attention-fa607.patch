+    if (!f->device->session || ((f->mode < 4 || f->mode == 6) && (f->volumes != 1 || !((struct airplay_session *)f->device->session)->recovery_only)))
+      {recovery_wire_fail(f,"duplicate lax write or missing real recovery owner");goto done;}
+    if ((f->mode < 4 || f->mode == 6 || f->phase == 3) && attention_emission_current(f->device->session,NULL))
+      {recovery_wire_fail(f,"recovery granted native emission");goto done;}
