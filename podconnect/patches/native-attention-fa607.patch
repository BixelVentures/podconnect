+static int
+airplay_attention_set(struct output_device *device, const struct output_attention_result *operation)
+{
+  struct airplay_session *session = device->session;
+  struct airplay_attention_request *context;
+  struct evrtsp_request *request;
+  float mapped;
+  char volume[32];
+
+  if (session && session->recovery_only && session->state == AIRPLAY_STATE_STOPPED
+      && operation->action == OUTPUT_ATTENTION_RELEASE)
+    return airplay_attention_recover(device,operation);
+  if (session && !(session->state & AIRPLAY_STATE_F_CONNECTED)
+      && operation->action == OUTPUT_ATTENTION_RELEASE)
+    {
+      // An already queued START keeps its immutable owner. Drain it first; the
+      // manager must obtain a fresh origin RECOVER, never desired-only credit.
+      session->recovery_handoff=true;
+      session->recovery_operation=*operation;
+      return airplay_device_stop(device,-1);
+    }
+  if (!session || !(session->state & AIRPLAY_STATE_F_CONNECTED))
+    return 0; // Desired-only, no native request or fabricated acceptance.
+  if (session->device_incarnation != operation->identity.device_incarnation
+      || session->session_epoch != operation->identity.session_epoch)
+    return -1;
+  context = calloc(1, sizeof(*context));
+  if (!context)
+    return -1;
+  context->operation = *operation;
+  context->session = session;
+  context->cseq = session->cseq;
+  request = evrtsp_request_new(attention_response_cb, context);
+  if (!request)
+    { free(context); return -1; }
+  if (request_headers_add(request, session,
+      operation->action == OUTPUT_ATTENTION_FLUSH ? EVRTSP_REQ_FLUSH : EVRTSP_REQ_SET_PARAMETER) < 0)
+    goto error;
+  if (operation->action == OUTPUT_ATTENTION_FLUSH)
+    {
+      char info[64];
+      struct rtp_session *rtp = session->master_session->rtp_session;
+      snprintf(info, sizeof(info), "seq=%" PRIu16 ";rtptime=%u", rtp->seqnum, rtp->pos);
+      evrtsp_add_header(request->output_headers, "RTP-Info", info);
+    }
+  else
+    {
+      evrtsp_add_header(request->output_headers, "Content-Type", "text/parameters");
+      mapped = airplay_volume_from_pct(operation->identity.effective_volume, session->devname);
+      snprintf(volume, sizeof(volume), "-%d.%06d", -(int)mapped, -(int)(1000000.0 * (mapped - (int)mapped)));
+      if (evbuffer_add_printf(request->output_buffer, "volume: %s\r\n", volume) < 0)
+        goto error;
+    }
+  session->attention_managed = true;
+
+  // The immutable payload is built before queueing. Existing CSeq/transport,
+  // cipher and request ownership are reused; no alternate session or mixer.
+  // Register before guarded enqueue. Veto completion is deferred on the existing
+  // connection event; connection_free cancels it and the session drains contexts.
+  context->next = session->attention_requests;
+  session->attention_requests = context;
+  evrtsp_connection_set_closecb(session->ctrl, NULL, NULL);
+  session->reqs_in_flight++;
+  if (evrtsp_make_request_guarded(session->ctrl, request,
+      operation->action == OUTPUT_ATTENTION_FLUSH ? EVRTSP_REQ_FLUSH : EVRTSP_REQ_SET_PARAMETER,
+      session->session_url, attention_dispatch_current, context) < 0)
+    {
+      // Guarded negative return detached only this inserted request; no callback.
+      attention_request_remove(context);
+      session->reqs_in_flight--;
+      if (!session->reqs_in_flight)
+        evrtsp_connection_set_closecb(session->ctrl, rtsp_close_cb, session);
+      goto error;
+    }
+  return 1; // The connection now owns the request and its deferred completion.
+
+ error:
+  evrtsp_request_free(request);
+  free(context);
+  return -1;
+}
