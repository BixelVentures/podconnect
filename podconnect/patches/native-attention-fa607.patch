+void
+outputs_attention_uuid(char uuid[37])
+{
+  unsigned char bytes[16];
+  const char hex[]="0123456789abcdef";
+  int i, pos=0;
+  gcry_randomize(bytes,sizeof(bytes),GCRY_STRONG_RANDOM);
+  bytes[6]=(bytes[6]&15)|64; bytes[8]=(bytes[8]&63)|128;
+  for (i=0;i<16;i++)
+    {
+      if (i==4 || i==6 || i==8 || i==10) uuid[pos++]='-';
+      uuid[pos++]=hex[bytes[i]>>4]; uuid[pos++]=hex[bytes[i]&15];
+    }
+  uuid[pos]=0;
+}
