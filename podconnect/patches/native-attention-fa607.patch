+  for (mode = OLD_START_200; mode <= OLD_START_REFUSED; mode++)
+    if (owner_case((enum owner_mode)mode)) return 1;
+  for (mode = RAW_FREE; mode <= RAW_NESTED_FREE; mode++)
+    if (raw_case((enum raw_mode)mode)) return 1;
