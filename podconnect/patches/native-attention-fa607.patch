+}
+static void peer_event(struct bufferevent *peer, short what, void *arg)
+{
+  struct owner_fixture *f = arg;
+  if (what & BEV_EVENT_EOF) {
+    if (peer == f->old_peer) f->old_peer_eof = true;
+    else if (peer == f->peer) f->peer_eof = true;
+  }
+  else if (what & BEV_EVENT_ERROR) owner_fail(f, "unexpected controlled peer I/O error");
+}
+static void peer_accept(struct evconnlistener *listener, evutil_socket_t fd,
+    struct sockaddr *remote, int length, void *arg)
+{
+  struct owner_fixture *f = arg;
+  struct sockaddr_in *a = (struct sockaddr_in *)remote;
+  (void)listener;
+  if (length < (int)sizeof(*a) || a->sin_family != AF_INET
+      || ntohl(a->sin_addr.s_addr) != INADDR_LOOPBACK || f->peer) {
+    evutil_closesocket(fd); owner_fail(f, "unknown/extra fixture socket"); return;
+  }
+  f->peer = bufferevent_socket_new(f->base, fd, BEV_OPT_CLOSE_ON_FREE | BEV_OPT_DEFER_CALLBACKS);
+  if (!f->peer) { evutil_closesocket(fd); owner_fail(f, "accepted socket owner allocation"); return; }
+  bufferevent_setcb(f->peer, peer_read, NULL, peer_event, f);
+  if (bufferevent_enable(f->peer, EV_READ | EV_WRITE) < 0) owner_fail(f, "peer enable");
+}
+static int owner_case(enum owner_mode mode)
+{
