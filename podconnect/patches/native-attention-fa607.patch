+static void manual_cas_preserves_overlay_ttl_and_same_value_aba(void)
+{
+  struct output_device *a = add_device(1);
+  struct output_attention_request manual = { .action = OUTPUT_ATTENTION_MANUAL, .cap_volume = 65 };
+  struct output_attention_result begin, first, repeated;
+  struct timespec deadline;
+  uint64_t lease, revision;
+  begin = request(1, OUTPUT_ATTENTION_BEGIN);
+  assert(begin.outcome == OUTPUT_ATTENTION_DESIRED_ONLY);
+  lease = a->attention_lease; revision = a->attention_revision; deadline = a->attention_deadline;
+  assert(outputs_attention_state_get(1, &manual.expected) == 0);
+  memcpy(manual.request_id, "00000000-0000-4000-8000-000000000201", sizeof(manual.request_id));
+  assert(outputs_attention_admit(&manual, &first) == 0);
+  assert(first.outcome == OUTPUT_ATTENTION_DESIRED_ONLY && first.action == OUTPUT_ATTENTION_MANUAL);
+  assert(a->volume == 65 && outputs_device_effective_volume(a) == 5);
+  assert(a->base_revision == manual.expected.base_revision + 1);
+  assert(a->attention_lease == lease && a->attention_revision == revision);
+  assert(a->attention_deadline.tv_sec == deadline.tv_sec && a->attention_deadline.tv_nsec == deadline.tv_nsec);
+  assert(outputs_attention_admit(&manual, &repeated) == 0);
+  assert(repeated.operation == first.operation && a->base_revision == first.identity.base_revision);
+  assert(outputs_attention_state_get(1, &manual.expected) == 0);
+  manual.request_id[35] = '2';
+  assert(outputs_attention_admit(&manual, &repeated) == 0);
+  assert(repeated.identity.base_revision == first.identity.base_revision + 1); /* equal intent != echo */
+  repeated = request(1, OUTPUT_ATTENTION_RELEASE);
+  assert(repeated.identity.effective_volume == 65 && a->attention_lease == 0);
+  clear_devices();
+}
