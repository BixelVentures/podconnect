+
+static void
+attention_response_cb(struct evrtsp_request *request, void *arg)
+{
+  struct airplay_attention_request *context = arg;
+  struct airplay_session *session = context->session;
+  enum output_attention_outcome outcome;
+  const char *cseq;
+  int observed_cseq = 0;
+  int code = request ? request->response_code : 0;
+
+  attention_request_remove(context);
+  session->reqs_in_flight--;
+  if (!session->reqs_in_flight)
+    evrtsp_connection_set_closecb(session->ctrl, rtsp_close_cb, session);
+
+  cseq = request ? evrtsp_find_header(request->input_headers, "CSeq") : NULL;
+  if (!request || !cseq || safe_atoi32(cseq, &observed_cseq) < 0 || observed_cseq != context->cseq)
+    outcome = OUTPUT_ATTENTION_UNKNOWN;
+  else if (code != RTSP_OK)
+    outcome = OUTPUT_ATTENTION_FAILED;
+  else
+    outcome = OUTPUT_ATTENTION_PROTOCOL_ACCEPTED;
+
+  if ((context->operation.action == OUTPUT_ATTENTION_RECOVER || context->operation.action == OUTPUT_ATTENTION_RELEASE) && session->recovery_only)
+    {
+      session->recovery_base_accepted = outcome == OUTPUT_ATTENTION_PROTOCOL_ACCEPTED;
+      session->recovery_code = code;
+      session->recovery_cseq = context->cseq;
+      free(context);
+      sequence_start(AIRPLAY_SEQ_STOP,session,NULL,"recovery_cleanup");
+      return; // Exact original control lifecycle, never STOP a different output.
+    }
+  outputs_attention_complete(&context->operation, outcome, code, context->cseq);
+  if (context->operation.action == OUTPUT_ATTENTION_RECOVER)
+    {
+      struct output_attention_result retained;
+      if (outputs_attention_result_get(context->operation.identity.process,
+          context->operation.operation, &retained) == 0
+          && retained.current && retained.recovery_state == OUTPUT_RECOVERY_RESTORED
+          && session->recovery_operation.operation == context->operation.operation)
+        memset(&session->recovery_operation, 0, sizeof(session->recovery_operation));
+      // UNKNOWN retains only its eventual drain correlation. It never owns or
+      // vetoes the regular session's immutable START/FLUSH/STOP sequences.
+    }
+  free(context);
+}
+
+static int
+attention_dispatch_current(void *arg)
+{
+  const struct airplay_attention_request *context = arg;
+  struct output_attention_result retained;
+  struct output_device *device = outputs_device_get(context->operation.identity.device_id);
+
+  return device && !context->session->attention_retiring && device->session == context->session
+    && device->incarnation == context->operation.identity.device_incarnation
+    && device->session_epoch == context->operation.identity.session_epoch
+    && outputs_attention_result_get(context->operation.identity.process, context->operation.operation, &retained) == 0
+    && retained.outcome == OUTPUT_ATTENTION_PENDING
+    && (context->operation.action == OUTPUT_ATTENTION_FLUSH
+        ? (device->route_revision == context->operation.identity.route_revision)
+        : retained.current);
+}
