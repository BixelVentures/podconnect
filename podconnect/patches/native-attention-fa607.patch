+  memcpy(state->process, outputs_process, sizeof(state->process));
+  state->device_id = device->id;
+  state->device_incarnation = device->incarnation;
+  state->session_epoch = device->session_epoch;
+  state->base_revision = device->base_revision;
+  state->attention_revision = device->attention_revision;
+  state->route_revision = device->route_revision;
+  state->lease = device->attention_lease;
+  state->base_volume = device->volume;
+  state->effective_volume = outputs_device_effective_volume(device);
+  state->restoring = device->attention_restoring;
+  state->last_release_operation = device->attention_last_release_operation;
+  state->last_drained_operation=device->attention_last_drained_operation;
+  memcpy(state->last_drained_request_id,device->attention_last_drained_request_id,sizeof(state->last_drained_request_id));
