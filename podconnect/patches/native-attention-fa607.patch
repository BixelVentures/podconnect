+/* Real file SQLite commit/reopen + actual admission/custody owner. Transport is
+ * a controlled callback edge here; the AirPlay cohort separately owns RTSP. */
+static void cold_restart_preserving_native_database(void)
+{
+  int i;
+  while (outputs_device_list) outputs_device_remove(outputs_device_list);
+  for (i=0;i<ARRAY_SIZE(attention_results);i++)
+    if (attention_results[i].operation && attention_results[i].outcome == OUTPUT_ATTENTION_PENDING)
+      attention_results[i].outcome=OUTPUT_ATTENTION_UNKNOWN; // Destroyed old process, no receipt fabrication.
+  memset(attention_results,0,sizeof(attention_results));
+  memset(attention_result_reserved,0,sizeof(attention_result_reserved));
+  assert(sqlite3_close(hdl)==SQLITE_OK); hdl=NULL;
+  assert(sqlite3_open(owner_database_path,&hdl)==SQLITE_OK);
+  outputs_attention_uuid(outputs_process);
+  assert(outputs_attention_startup()==0);
+}
