+static int
+jsonapi_reply_output_attention_put(struct httpd_request *hreq)
+{
+  struct output_attention_request request = { 0 };
+  struct output_attention_result result;
+  json_object *body = jparse_obj_from_evbuffer(hreq->in_body), *expected, *field, *reply;
+  uint64_t id;
+  const char *action, *request_id;
+  int i;
