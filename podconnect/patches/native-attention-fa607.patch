diff --git a/tests/player_startup_owner.inc.c b/tests/player_startup_owner.inc.c
new file mode 100644
--- /dev/null
+++ b/tests/player_startup_owner.inc.c
@@ -0,0 +1,217 @@
+/* Included by the existing complete native owner fixture. Faults only wrap
+ * SQLite/pthread admission; player, DB, command consumers and cleanup stay real. */
+#include <sys/wait.h>
+#include <sqlite3.h>
+#include <event2/thread.h>
+#include <dlfcn.h>
+#include "../src/worker.h"
+#include "../src/cache.h"
+#include "../src/library.h"
+
+enum startup_fault { START_HEALTHY, START_LOCKED, START_READONLY, START_NONDURABLE, START_SCHEMA, START_SPAWN };
+static enum startup_fault startup_fault;
+static bool startup_active, startup_spawning, startup_have_player;
+static int startup_creates, startup_player_joins, startup_old_callbacks;
+static pthread_t startup_player_thread;
+static __thread sqlite3 *startup_connection;
+static pthread_mutex_t startup_writer_mutex = PTHREAD_MUTEX_INITIALIZER;
+static pthread_cond_t startup_writer_condition = PTHREAD_COND_INITIALIZER;
+static bool startup_writer_ready, startup_writer_begin, startup_writer_held, startup_writer_release;
+
+int __real_sqlite3_open(const char *, sqlite3 **);
+int __real_sqlite3_unlock_notify(sqlite3 *, void (*)(void **, int), void *);
+int __real_pthread_create(pthread_t *, const pthread_attr_t *, void *(*)(void *), void *);
+int __real_pthread_join(pthread_t, void **);
+int __real_net_bind(struct net_socket *, unsigned short *, int, const char *);
+int __real_mdns_browse(char *, mdns_browse_cb, enum mdns_options);
+
+int __wrap_mdns_browse(char *type, mdns_browse_cb callback, enum mdns_options flags)
+{
+  if (startup_active) return -1;
+  return __real_mdns_browse(type, callback, flags);
+}
+
+int __wrap_net_bind(struct net_socket *socket, unsigned short *port, int type, const char *name)
+{
+  /* Same inert service boundary as the existing AirPlay owner fixture. Never
+   * discover a receiver merely to test database/player command admission. */
+  if (startup_active) return -1;
+  return __real_net_bind(socket, port, type, name);
+}
+
+static void startup_old_callback(evutil_socket_t fd, short flags, void *arg)
+{ (void)fd; (void)flags; (void)arg; startup_old_callbacks++; }
+
+int __wrap_sqlite3_open(const char *path, sqlite3 **connection)
+{
+  char name[32] = {0};
+  int ret = __real_sqlite3_open(path, connection);
+  if (!startup_active || ret != SQLITE_OK) return ret;
+  startup_connection = *connection;
+  assert(pthread_getname_np(pthread_self(), name, sizeof(name)) == 0);
+  if (strcmp(name, "player")) return ret;
+  if (startup_fault == START_LOCKED)
+    {
+      assert(pthread_mutex_lock(&startup_writer_mutex) == 0);
+      startup_writer_begin = true;
+      assert(pthread_cond_signal(&startup_writer_condition) == 0);
+      while (!startup_writer_held)
+        assert(pthread_cond_wait(&startup_writer_condition, &startup_writer_mutex) == 0);
+      assert(pthread_mutex_unlock(&startup_writer_mutex) == 0);
+    }
+  if (startup_fault == START_READONLY || startup_fault == START_NONDURABLE || startup_fault == START_SCHEMA)
+    {
+      const struct timeval immediate = {0, 0};
+      assert(event_base_once(evbase_player, -1, EV_TIMEOUT, startup_old_callback, NULL, &immediate) == 0);
+      assert(sqlite3_exec(*connection, startup_fault == START_READONLY ? "PRAGMA query_only=ON" :
+          startup_fault == START_NONDURABLE ? "PRAGMA synchronous=OFF" :
+          "DROP TABLE native_attention_process_v1", NULL, NULL, NULL) == SQLITE_OK);
+    }
+  return ret;
+}
+
+int __wrap_sqlite3_unlock_notify(sqlite3 *connection, void (*notify)(void **, int), void *arg)
+{
+  if (startup_active && startup_fault == START_LOCKED)
+    {
+      char name[32] = {0};
+      assert(pthread_getname_np(pthread_self(), name, sizeof(name)) == 0);
+      if (!strcmp(name, "player"))
+        {
+          assert(pthread_mutex_lock(&startup_writer_mutex) == 0);
+          startup_writer_release = true;
+          assert(pthread_cond_signal(&startup_writer_condition) == 0);
+          assert(pthread_mutex_unlock(&startup_writer_mutex) == 0);
+        }
+    }
+  return __real_sqlite3_unlock_notify(connection, notify, arg);
+}
+
+int __wrap_pthread_create(pthread_t *thread, const pthread_attr_t *attr, void *(*entry)(void *), void *arg)
+{
+  Dl_info caller = {0};
+  bool player_call = startup_active && startup_spawning &&
+    dladdr(__builtin_return_address(0), &caller) && caller.dli_saddr == (void *)player_init;
+  int ret;
+  if (player_call) startup_creates++;
+  if (player_call && startup_fault == START_SPAWN) return EAGAIN;
+  ret = __real_pthread_create(thread, attr, entry, arg);
+  if (player_call && !ret) { startup_player_thread = *thread; startup_have_player = true; }
+  return ret;
+}
+
+int __wrap_pthread_join(pthread_t thread, void **result)
+{
+  int ret = __real_pthread_join(thread, result);
+  if (!ret && startup_active && startup_have_player && pthread_equal(thread, startup_player_thread))
+    startup_player_joins++;
+  return ret;
+}
+
+static void *startup_library_writer(void *arg)
+{
+  (void)arg;
+  thread_setname("pc29-writer");
+  assert(db_perthread_init() == 0);
+  assert(pthread_mutex_lock(&startup_writer_mutex) == 0);
+  startup_writer_ready = true;
+  assert(pthread_cond_signal(&startup_writer_condition) == 0);
+  while (!startup_writer_begin)
+    assert(pthread_cond_wait(&startup_writer_condition, &startup_writer_mutex) == 0);
+  assert(sqlite3_exec(startup_connection, "BEGIN IMMEDIATE", NULL, NULL, NULL) == SQLITE_OK);
+  assert(db_admin_setint64(DB_ADMIN_DB_UPDATE, 123) == 0);
+  startup_writer_held = true;
+  assert(pthread_cond_signal(&startup_writer_condition) == 0);
+  while (!startup_writer_release)
+    assert(pthread_cond_wait(&startup_writer_condition, &startup_writer_mutex) == 0);
+  assert(pthread_mutex_unlock(&startup_writer_mutex) == 0);
+  assert(sqlite3_exec(startup_connection, "COMMIT", NULL, NULL, NULL) == SQLITE_OK);
+  db_perthread_deinit();
+  return NULL;
+}
+
+static void startup_case(enum startup_fault fault)
+{
+  struct player_status status;
+  struct owner_fixture f = { .refused_fd = -1 };
+  char path[] = "/tmp/pc29-player-owner-XXXXXX";
+  pthread_t writer;
+  int fd = mkstemp(path), ret;
+  assert(fd >= 0); close(fd);
+  alarm(6); // Observer bound, no production deadline change.
+  assert(evthread_use_pthreads() == 0);
+  evbase_main = event_base_new(); assert(evbase_main);
+  current_fixture = &f;
+  cfg = cfg_init(toplvl_cfg, CFGF_NONE); assert(cfg);
+  cfg_setstr(cfg_getsec(cfg, "general"), "db_path", path);
+  cfg_setstr(cfg_getsec(cfg, "audio"), "type", "disabled");
+  assert(db_init(ATTENTION_TEST_SQLEXT_PATH) == 0 && db_perthread_init() == 0);
+  assert(worker_init() == 0 && cache_init() == 0 && library_init() == 0);
+  startup_fault = fault; startup_active = true;
+  if (fault == START_LOCKED)
+    {
+      assert(pthread_create(&writer, NULL, startup_library_writer, NULL) == 0);
+      assert(pthread_mutex_lock(&startup_writer_mutex) == 0);
+      while (!startup_writer_ready)
+        assert(pthread_cond_wait(&startup_writer_condition, &startup_writer_mutex) == 0);
+      assert(pthread_mutex_unlock(&startup_writer_mutex) == 0);
+    }
+  startup_spawning = true;
+  fprintf(stderr, "PC29 mode=%d before actual player_init\n", fault);
+  ret = player_init();
+  fprintf(stderr, "PC29 mode=%d after actual player_init ret=%d\n", fault, ret);
+  startup_spawning = false;
+  assert(startup_creates == 1);
+  if (fault == START_LOCKED) assert(pthread_join(writer, NULL) == 0 && startup_writer_release);
+  if (fault == START_HEALTHY || fault == START_LOCKED)
+    {
+      assert(ret == 0 && startup_player_joins == 0);
+      assert(player_get_status(&status) == 0); // Actual admitted command consumer.
+      fprintf(stderr, "PC29 mode=%d status complete\n", fault);
+      player_deinit(); assert(startup_player_joins == 1);
+      fprintf(stderr, "PC29 mode=%d player cleanup complete\n", fault);
+    }
+  else
+    {
+      assert(ret < 0 && startup_old_callbacks == 0);
+      assert(startup_player_joins == (fault == START_SPAWN ? 0 : 1));
+      /* Actual main exits after failed admission. Do not hot-reinitialize
+       * upstream input/output globals in that failed process. */
+    }
+  startup_active = false;
+  fprintf(stderr, "PC29 mode=%d before library/cache/worker cleanup\n", fault);
+  library_deinit(); cache_deinit(); worker_deinit(); db_perthread_deinit(); db_deinit();
+  event_base_free(evbase_main); cfg_free(cfg); cfg = NULL;
+  assert(startup_old_callbacks == 0);
+  assert(unlink(path) == 0);
+  alarm(0);
+  fprintf(stderr, "PC29 mode=%d all cleanup complete\n", fault);
+}
+
+static void actual_player_startup_cases(void)
+{
+  int mode, status;
+  pid_t child;
+  for (mode = START_HEALTHY; mode <= START_SPAWN; mode++)
+    {
+      fprintf(stderr, "PC29 starting mode=%d\n", mode);
+      child = fork(); assert(child >= 0);
+      if (!child) { startup_case((enum startup_fault)mode); _exit(0); }
+      assert(waitpid(child, &status, 0) == child);
+      fprintf(stderr, "PC29 mode=%d child wait status=%d\n", mode, status);
+      assert(WIFEXITED(status) && WEXITSTATUS(status) == 0);
+      if (mode >= START_READONLY)
+        {
+          /* The untouched parent owns no previous child's event base or task.
+           * This models the manager's new process after main EXIT_FAILURE. */
+          assert(startup_old_callbacks == 0 && !startup_active);
+          child = fork(); assert(child >= 0);
+          if (!child) { startup_case(START_HEALTHY); _exit(0); }
+          assert(waitpid(child, &status, 0) == child);
+          assert(WIFEXITED(status) && WEXITSTATUS(status) == 0);
+          assert(startup_old_callbacks == 0);
+          fprintf(stderr, "PC29 mode=%d fresh process startup/status/join complete\n", mode);
+        }
+    }
+  puts("PASS six actual player admission cases plus four fresh process successors; failed-start callbacks remain inert");
+}
