+    } else {
+      if (queue_count(connection) != 1 || request->evcon != connection) goto cleanup;
+      request = NULL; /* Original RAOP connection ownership preserved on negative. */
+    }
+    evrtsp_connection_free(connection); connection = NULL;
+  }
+  failed = 0;
+cleanup:
+  if (request && (!connection || request->evcon != connection)) evrtsp_request_free(request);
+  if (connection) evrtsp_connection_free(connection);
+  if (bound_fd >= 0) evutil_closesocket(bound_fd);
+  event_base_free(base);
