+int
+outputs_attention_result_get(const char *process, uint64_t operation, struct output_attention_result *result)
+{
+  struct output_attention_state state;
+  struct output_attention_result *retained = attention_result_find(process, operation);
+
+  if (!result || !retained)
+    return -1; // Retired/unknown receipt is never credited to a newer operation.
+  *result = *retained;
+  result->current = outputs_attention_state_get(result->identity.device_id, &state) == 0;
+  // A successful exact release retires its own lease, not its immutable receipt.
+  if (result->current && result->action == OUTPUT_ATTENTION_RELEASE
+      && (result->outcome == OUTPUT_ATTENTION_PROTOCOL_ACCEPTED || result->outcome == OUTPUT_ATTENTION_DESIRED_ONLY)
+      && state.lease == 0 && state.attention_revision == result->identity.attention_revision)
+    {
+      state.lease = result->identity.lease;
+      state.restoring = result->identity.restoring;
+    }
+  result->current = result->current && (attention_identity_equal(&result->identity, &state)
+    || ((result->recovery_state == OUTPUT_RECOVERY_RESTORED || (result->action == OUTPUT_ATTENTION_RELEASE && result->outcome == OUTPUT_ATTENTION_PROTOCOL_ACCEPTED)) && attention_recovery_terminal_current(result, &state)));
+  return 0;
+}
