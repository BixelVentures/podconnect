+}
+
+static int
+attention_parse_u64(json_object *object, const char *key, uint64_t *value)
+{
+  json_object *field;
+  const char *text, *p;
+  if (!json_object_object_get_ex(object, key, &field) || !json_object_is_type(field, json_type_string))
+    return -1;
+  text = json_object_get_string(field);
+  if (!text || !*text || strlen(text) > 20)
+    return -1;
+  for (p = text; *p; p++)
+    if (*p < '0' || *p > '9') return -1;
+  return safe_atou64(text, value);
+}
+
+static int
+attention_parse_state(json_object *object, struct output_attention_state *state)
+{
+  json_object *field;
+  const char *process;
+  int i;
+  if (!object || !json_object_is_type(object, json_type_object) || json_object_object_length(object) != 11
+      || !jparse_contains_key(object, "process", json_type_string))
+    return -1;
+  memset(state, 0, sizeof(*state));
+  process = jparse_str_from_obj(object, "process");
+  if (!process || strlen(process) != 36) return -1;
+  for (i = 0; i < 36; i++)
+    if (i == 8 || i == 13 || i == 18 || i == 23)
+      { if (process[i] != '-') return -1; }
+    else if (!((process[i] >= '0' && process[i] <= '9') || (process[i] >= 'a' && process[i] <= 'f')))
+      return -1;
+  memcpy(state->process, process, 36);
+  if (attention_parse_u64(object, "device_id", &state->device_id) < 0
+      || attention_parse_u64(object, "device_incarnation", &state->device_incarnation) < 0
+      || attention_parse_u64(object, "session_epoch", &state->session_epoch) < 0
+      || attention_parse_u64(object, "base_revision", &state->base_revision) < 0
+      || attention_parse_u64(object, "attention_revision", &state->attention_revision) < 0
+      || attention_parse_u64(object, "route_revision", &state->route_revision) < 0
+      || attention_parse_u64(object, "lease", &state->lease) < 0
+      || !jparse_contains_key(object, "base_volume", json_type_int)
+      || !jparse_contains_key(object, "effective_volume", json_type_int)
+      || !jparse_contains_key(object, "restoring", json_type_boolean))
+    return -1;
+  // Check the int64 before conversion, so oversized JSON numbers cannot wrap.
+  json_object_object_get_ex(object, "base_volume", &field);
+  if (json_object_get_int64(field) < 0 || json_object_get_int64(field) > 100) return -1;
+  state->base_volume = json_object_get_int(field);
+  json_object_object_get_ex(object, "effective_volume", &field);
+  if (json_object_get_int64(field) < 0 || json_object_get_int64(field) > 100) return -1;
+  state->effective_volume = json_object_get_int(field);
+  state->restoring = jparse_bool_from_obj(object, "restoring");
+  return 0;
+}
