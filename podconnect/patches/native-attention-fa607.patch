+/* Actual AirPlay, outputs and evrtsp translation units. Private loopback only.
+ * No discovery, daemon, media input, fabricated connected/session-ready flag,
+ * receiver capability, public-volume acceptance or acoustic proof.
+ * START uses the actual device/session/master/codec constructors. SEND_VOLUME
+ * is explicitly the lower existing sequence owner, not the public connected
+ * setter. Real queued wire responses test command tickets and lifetime.
+ * Root admits compilation/execution separately; these cases have not run. */
+#include <assert.h>
+#include <stdarg.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <event2/listener.h>
+#include <event2/bufferevent.h>
+
+/* Inert speaker persistence only. Every state, request, crypto/codec constructor,
+ * queue/callback and session destruction below is the candidate production body. */
+#define db_speaker_get fixture_speaker_get
+#define db_speaker_save fixture_speaker_save
+#include "../src/conffile.c"
+#include "../src/outputs.c"
+static void *fixture_calloc(size_t n, size_t size);
+static void fixture_free(void *pointer);
+static void raw_free_observe(void *pointer);
+#define calloc fixture_calloc
+#define free fixture_free
+#include "../src/outputs/airplay.c"
+#include "../src/evrtsp/rtsp.c"
+#undef calloc
+#undef free
+#undef db_speaker_get
+#undef db_speaker_save
+
+struct event_base *evbase_main;
+static void *contexts[64];
+static int context_allocations, context_frees;
+static bool fail_request_allocation;
+static void *fixture_calloc(size_t n, size_t size)
+{
+  void *p;
+  size_t i;
+  if (fail_request_allocation && n == 1 && size == sizeof(struct evrtsp_request))
+    { fail_request_allocation = false; return NULL; }
+  p = calloc(n, size);
+  if (p && n == 1 && size == sizeof(struct airplay_seq_ctx))
+    {
+      for (i = 0; i < ARRAY_SIZE(contexts) && contexts[i]; i++);
+      assert(i < ARRAY_SIZE(contexts)); contexts[i] = p; context_allocations++;
+    }
+  return p;
+}
+static void fixture_free(void *p)
+{
+  size_t i;
+  raw_free_observe(p);
+  for (i = 0; i < ARRAY_SIZE(contexts); i++)
+    if (p && contexts[i] == p) { contexts[i] = NULL; context_frees++; break; }
+  free(p);
+}
+int fixture_speaker_get(struct output_device *device, uint64_t id)
+{ (void)id; device->volume = 30; device->selected = false; return 0; }
+int fixture_speaker_save(struct output_device *device)
+{ (void)device; return 0; }
+
+enum owner_mode { OLD_START_200, OLD_START_VOLUME_200, OLD_START_503,
+  OLD_START_EOF, STOP_ALLOCATION_FAILURE, CALLBACK_OVERFLOW, OLD_STOP_FRESH_START, OLD_START_REFUSED };
+struct owner_fixture {
+  enum owner_mode mode;
+  struct event_base *base;
+  struct evconnlistener *listener;
+  struct bufferevent *peer;
+  struct bufferevent *old_peer;
+  bool old_peer_eof;
+  bool peer_eof;
+  bool registered;
+  int generation;
+  uint64_t retired_epoch;
+  struct event *deadline;
+  struct output_device *device;
+  int refused_fd;
+  int failed, wire, start_calls, stop_calls;
+  enum output_device_state terminal;
+  int old_slot;
+  uint64_t old_revision;
+};
+static struct owner_fixture *current_fixture;
+static void owner_fail(struct owner_fixture *f, const char *why)
+{
+  fprintf(stderr, "FAIL airplay-owner=%d: %s\n", f->mode, why);
+  f->failed = 1; event_base_loopbreak(f->base);
+}
+static void owner_deadline(evutil_socket_t fd, short what, void *arg)
+{ (void)fd; (void)what; owner_fail(arg, "existing five-second owner bound exhausted"); }
+static void start_done(struct output_device *device, enum output_device_state state)
+{
+  (void)device; (void)state;
+  current_fixture->start_calls++;
+  owner_fail(current_fixture, "old START consumed a current callback slot");
+}
+static void stop_done(struct output_device *device, enum output_device_state state)
+{
+  struct owner_fixture *f = current_fixture;
+  f->stop_calls++; f->terminal = state;
+  if (device != f->device || f->stop_calls != f->generation + 1 || f->start_calls
+      || device->session || airplay_sessions || airplay_master_sessions
+      || context_allocations != context_frees || fail_request_allocation)
+    { owner_fail(f, "terminal callback before actual session/request/master destruction"); return; }
+  if (f->mode == OLD_START_200 || f->mode == OLD_START_VOLUME_200 || f->mode == OLD_STOP_FRESH_START) {
+    if (state != OUTPUT_STATE_STOPPED || f->wire != (f->mode == OLD_START_VOLUME_200 ? 3 : 2))
+      { owner_fail(f, "old success did not preserve exact queued STOP terminal obligation"); return; }
+  } else if ((f->mode == OLD_START_REFUSED && (f->wire || f->peer))
+      || state != OUTPUT_STATE_FAILED || device->requires_auth
+      || device->v6_disabled || !device->auth_key || strcmp(device->auth_key, "fixture-retained-key"))
+    { owner_fail(f, "old failure retried/re-authorized or falsely acknowledged STOP"); return; }
+  if (f->mode == OLD_STOP_FRESH_START && !f->generation) {
+    f->retired_epoch = device->session_epoch;
+    f->generation = 1; f->wire = 0; f->old_peer = f->peer; f->old_peer_eof = f->peer_eof; f->peer_eof = false; f->peer = NULL;
+    outputs_device_select(device, 100); // Actual route transition resets old barrier.
+    if (outputs_device_start(device, start_done, false) != 1 || !device->session
+        || device->session_epoch <= f->retired_epoch)
+      { owner_fail(f, "normal fresh startup did not own a new native epoch"); return; }
+    return;
+  }
+  if (f->generation && !f->old_peer_eof)
+    { owner_fail(f, "old native connection destruction not observed before fresh completion"); return; }
+  event_base_loopbreak(f->base);
+}
+static int request_header(const char *header, const char *name)
+{
+  const char *p = strstr(header, name);
+  int value = -1;
+  if (!p || sscanf(p + strlen(name), "%d", &value) != 1) return -1;
+  return value;
+}
+static void peer_read(struct bufferevent *peer, void *arg)
+{
+  struct owner_fixture *f = arg;
+  struct evbuffer *input = bufferevent_get_input(peer);
+  struct evbuffer_ptr end = evbuffer_search(input, "\r\n\r\n", 4, NULL);
+  char header[4096], reply[256];
+  size_t length;
