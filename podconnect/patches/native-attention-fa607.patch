+static void manual_old_challenge_never_overrides_newer_native_intent(void)
+{
+  struct output_device *a = add_device(1);
+  struct output_attention_request manual = { .action = OUTPUT_ATTENTION_MANUAL, .cap_volume = 30 };
+  struct output_attention_result result;
+  uint64_t revision;
+  assert(outputs_attention_state_get(1, &manual.expected) == 0);
+  outputs_device_volume_register(a, 65, -1); /* actual existing HA/hardware base owner */
+  revision = a->base_revision;
+  assert(outputs_attention_admit(&manual, &result) < 0);
+  assert(a->volume == 65 && a->base_revision == revision && transport_calls == 0);
+  assert(outputs_attention_state_get(1, &manual.expected) == 0);
+  manual.ttl_ms = 1;
+  assert(outputs_attention_admit(&manual, &result) < 0); /* MANUAL cannot renew TTL */
+  manual.ttl_ms = 0;
+  a->base_revision = UINT64_MAX - 1;
+  assert(outputs_attention_state_get(1, &manual.expected) == 0);
+  assert(outputs_attention_admit(&manual, &result) < 0 && transport_calls == 0);
+  clear_devices();
+}
