+  attention_timer_cb(-1, EV_TIMEOUT, a);
+  assert(a->attention_expired && a->attention_restoring && !a->attention_expiry_attempted);
+  assert(transport_calls == 1 && a->attention_lease == lease);
+  outputs_attention_complete(&first, OUTPUT_ATTENTION_UNKNOWN, 0, 13);
+  expiry = admitted;
+  assert(expiry.action == OUTPUT_ATTENTION_RELEASE && expiry.identity.lease == lease);
+  assert(transport_calls == 2 && a->attention_expiry_attempted);
+  outputs_attention_complete(&expiry, OUTPUT_ATTENTION_UNKNOWN, 0, 14);
+  assert(a->attention_lease == lease && a->attention_restoring && transport_calls == 2);
+  transport_return = 0; /* an explicit exact-owner retry at inactive transport boundary */
