+
+// Attention IDs/revisions are decimal strings, never lossy JSON numbers.
+static void
+attention_json_u64(json_object *object, const char *key, uint64_t value)
+{
+  char text[21];
+  snprintf(text, sizeof(text), "%" PRIu64, value);
+  json_object_object_add(object, key, json_object_new_string(text));
+}
+
+static json_object *
+attention_state_to_json(const struct output_attention_state *state)
+{
+  json_object *object = json_object_new_object();
+  json_object_object_add(object, "process", json_object_new_string(state->process));
+  attention_json_u64(object, "device_id", state->device_id);
+  attention_json_u64(object, "device_incarnation", state->device_incarnation);
+  attention_json_u64(object, "session_epoch", state->session_epoch);
+  attention_json_u64(object, "base_revision", state->base_revision);
+  attention_json_u64(object, "attention_revision", state->attention_revision);
+  attention_json_u64(object, "route_revision", state->route_revision);
+  attention_json_u64(object, "lease", state->lease);
+  json_object_object_add(object, "base_volume", json_object_new_int(state->base_volume));
+  json_object_object_add(object, "effective_volume", json_object_new_int(state->effective_volume));
+  json_object_object_add(object, "restoring", json_object_new_boolean(state->restoring));
+  return object;
+}
+
+static json_object *
+attention_result_to_json(const struct output_attention_result *result)
+{
+  const char *names[] = { "pending", "desired_only", "protocol_accepted", "failed", "unknown" };
+  const char *actions[] = { "begin", "update", "release", "flush", "manual" };
+  json_object *object = json_object_new_object();
+  json_object_object_add(object, "identity", attention_state_to_json(&result->identity));
+  json_object_object_add(object, "request_id", json_object_new_string(result->command.request_id));
+  attention_json_u64(object, "operation", result->operation);
+  json_object_object_add(object, "action", json_object_new_string(actions[result->action]));
+  json_object_object_add(object, "outcome", json_object_new_string(names[result->outcome]));
+  json_object_object_add(object, "response_code", json_object_new_int(result->response_code));
+  json_object_object_add(object, "request_cseq", json_object_new_int(result->request_cseq));
+  json_object_object_add(object, "current", json_object_new_boolean(result->current));
+  return object;
+}
+
+static int
+attention_parse_u64(json_object *object, const char *key, uint64_t *value)
+{
+  json_object *field;
+  const char *text, *p;
+  if (!json_object_object_get_ex(object, key, &field) || !json_object_is_type(field, json_type_string))
+    return -1;
+  text = json_object_get_string(field);
+  if (!text || !*text || strlen(text) > 20)
+    return -1;
+  for (p = text; *p; p++)
+    if (*p < '0' || *p > '9') return -1;
+  return safe_atou64(text, value);
+}
+
+static int
+attention_parse_state(json_object *object, struct output_attention_state *state)
+{
+  json_object *field;
+  const char *process;
+  int i;
+  if (!object || !json_object_is_type(object, json_type_object) || json_object_object_length(object) != 11
+      || !jparse_contains_key(object, "process", json_type_string))
+    return -1;
+  memset(state, 0, sizeof(*state));
+  process = jparse_str_from_obj(object, "process");
+  if (!process || strlen(process) != 36) return -1;
+  for (i = 0; i < 36; i++)
+    if (i == 8 || i == 13 || i == 18 || i == 23)
+      { if (process[i] != '-') return -1; }
+    else if (!((process[i] >= '0' && process[i] <= '9') || (process[i] >= 'a' && process[i] <= 'f')))
+      return -1;
+  memcpy(state->process, process, 36);
+  if (attention_parse_u64(object, "device_id", &state->device_id) < 0
+      || attention_parse_u64(object, "device_incarnation", &state->device_incarnation) < 0
+      || attention_parse_u64(object, "session_epoch", &state->session_epoch) < 0
+      || attention_parse_u64(object, "base_revision", &state->base_revision) < 0
+      || attention_parse_u64(object, "attention_revision", &state->attention_revision) < 0
+      || attention_parse_u64(object, "route_revision", &state->route_revision) < 0
+      || attention_parse_u64(object, "lease", &state->lease) < 0
+      || !jparse_contains_key(object, "base_volume", json_type_int)
+      || !jparse_contains_key(object, "effective_volume", json_type_int)
+      || !jparse_contains_key(object, "restoring", json_type_boolean))
+    return -1;
+  // Check the int64 before conversion, so oversized JSON numbers cannot wrap.
+  json_object_object_get_ex(object, "base_volume", &field);
+  if (json_object_get_int64(field) < 0 || json_object_get_int64(field) > 100) return -1;
+  state->base_volume = json_object_get_int(field);
+  json_object_object_get_ex(object, "effective_volume", &field);
+  if (json_object_get_int64(field) < 0 || json_object_get_int64(field) > 100) return -1;
+  state->effective_volume = json_object_get_int(field);
+  state->restoring = jparse_bool_from_obj(object, "restoring");
+  return 0;
+}
+
+static int
+jsonapi_reply_output_attention_get(struct httpd_request *hreq)
+{
+  uint64_t id;
+  struct output_attention_state state;
+  struct output_attention_result result;
+  const char *request_id = httpd_query_value_find(hreq->query, "request_id");
+  const char *process = httpd_query_value_find(hreq->query, "process");
+  json_object *reply;
+  if (request_id)
+    {
+      if (!process || strlen(process) != 36 || strlen(request_id) != 36
+          || safe_atou64(hreq->path_parts[2], &id) < 0
+          || player_attention_request_get(process, id, request_id, &result) < 0)
+        return HTTP_NOTFOUND;
+      reply = attention_result_to_json(&result);
+      CHECK_ERRNO(L_WEB, evbuffer_add_printf(hreq->out_body, "%s", json_object_to_json_string(reply)));
+      jparse_free(reply);
+      return HTTP_OK; // Receipt observation only, no write/new admission.
+    }
+  if (safe_atou64(hreq->path_parts[2], &id) < 0 || player_attention_state_get(id, &state) < 0)
+    return HTTP_NOTFOUND;
+  reply = attention_state_to_json(&state);
+  attention_json_u64(reply, "last_release_operation", state.last_release_operation);
+  CHECK_ERRNO(L_WEB, evbuffer_add_printf(hreq->out_body, "%s", json_object_to_json_string(reply)));
+  jparse_free(reply);
+  return HTTP_OK;
+}
+
+static int
+jsonapi_reply_output_attention_put(struct httpd_request *hreq)
+{
+  struct output_attention_request request = { 0 };
+  struct output_attention_result result;
+  json_object *body = jparse_obj_from_evbuffer(hreq->in_body), *expected, *field, *reply;
+  uint64_t id;
+  const char *action, *request_id;
+  int i;
+  int ret = HTTP_BADREQUEST;
+  if (!body || !json_object_is_type(body, json_type_object) || json_object_object_length(body) != 5
+      || safe_atou64(hreq->path_parts[2], &id) < 0
+      || !json_object_object_get_ex(body, "expected", &expected)
+      || attention_parse_state(expected, &request.expected) < 0 || request.expected.device_id != id
+      || !jparse_contains_key(body, "request_id", json_type_string)
+      || !jparse_contains_key(body, "action", json_type_string)
+      || !jparse_contains_key(body, "cap_volume", json_type_int)
+      || !jparse_contains_key(body, "ttl_ms", json_type_int))
+    goto out;
+  request_id = jparse_str_from_obj(body, "request_id");
+  if (!request_id || strlen(request_id) != 36) goto out;
+  for (i = 0; i < 36; i++)
+    if (i == 8 || i == 13 || i == 18 || i == 23)
+      { if (request_id[i] != '-') goto out; }
+    else if (!((request_id[i] >= '0' && request_id[i] <= '9') || (request_id[i] >= 'a' && request_id[i] <= 'f')))
+      goto out;
+  memcpy(request.request_id, request_id, 36);
+  action = jparse_str_from_obj(body, "action");
+  if (strcmp(action, "begin") == 0) request.action = OUTPUT_ATTENTION_BEGIN;
+  else if (strcmp(action, "update") == 0) request.action = OUTPUT_ATTENTION_UPDATE;
+  else if (strcmp(action, "release") == 0) request.action = OUTPUT_ATTENTION_RELEASE;
+  else if (strcmp(action, "manual") == 0) request.action = OUTPUT_ATTENTION_MANUAL;
+  else goto out; // FLUSH is admitted only by the native selection owner.
+  json_object_object_get_ex(body, "cap_volume", &field);
+  if (json_object_get_int64(field) < 0 || json_object_get_int64(field) > 100) goto out;
+  request.cap_volume = json_object_get_int(field);
+  json_object_object_get_ex(body, "ttl_ms", &field);
+  if (json_object_get_int64(field) < 0 || json_object_get_int64(field) > 15000) goto out;
+  request.ttl_ms = json_object_get_int(field);
+  if (player_attention_admit(&request, &result) < 0) goto out;
+  reply = attention_result_to_json(&result);
+  CHECK_ERRNO(L_WEB, evbuffer_add_printf(hreq->out_body, "%s", json_object_to_json_string(reply)));
+  jparse_free(reply);
+  ret = HTTP_OK; // Explicit outcome, never an implicit native apply/204 receipt.
+ out:
+  jparse_free(body);
+  return ret;
+}
+
+static int
+jsonapi_reply_output_attention_result(struct httpd_request *hreq)
+{
+  struct output_attention_result result;
+  uint64_t id, operation;
+  const char *process = httpd_query_value_find(hreq->query, "process");
+  json_object *reply;
+  if (!process || strlen(process) != 36 || safe_atou64(hreq->path_parts[2], &id) < 0
+      || safe_atou64(hreq->path_parts[4], &operation) < 0
+      || player_attention_result_get(process, operation, &result) < 0 || result.identity.device_id != id)
+    return HTTP_NOTFOUND;
+  reply = attention_result_to_json(&result);
+  CHECK_ERRNO(L_WEB, evbuffer_add_printf(hreq->out_body, "%s", json_object_to_json_string(reply)));
+  jparse_free(reply);
+  return HTTP_OK;
 }
 
