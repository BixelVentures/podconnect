diff --git a/src/db.c b/src/db.c
--- a/src/db.c
+++ b/src/db.c
@@ -4790,6 +4790,286 @@
 }
 
 /* Speakers */
+/* Crash custody uses the existing player-thread SQLite connection. No record is
+ * evicted: absent admission is proof only for a process registered on this DB. */
+static int
+attention_sql(char *sql)
+{
+  const char *next = sql;
+  sqlite3_stmt *stmt = NULL;
+  int ret = sql ? SQLITE_OK : SQLITE_NOMEM;
+
+  /* sqlite3_exec accepts several statements. Keep every schema statement while
+   * using the same shared-cache unlock owner as ordinary database operations. */
+  while (ret == SQLITE_OK && next && *next)
+    {
+      ret = db_blocking_prepare_v2(next, -1, &stmt, &next);
+      if (ret != SQLITE_OK)
+	break;
+      if (!stmt)
+	continue;
+      while ((ret = db_blocking_step(stmt)) == SQLITE_ROW)
+	; /* EMPTY */
+      sqlite3_finalize(stmt);
+      stmt = NULL;
+      if (ret == SQLITE_DONE)
+	ret = SQLITE_OK;
+    }
+  if (ret != SQLITE_OK)
+    DPRINTF(E_LOG, L_DB, "Native custody SQL failed: %s (%d)\n", sqlite3_errmsg(hdl), ret);
+  sqlite3_free(sql);
+  return ret == SQLITE_OK ? 0 : -1;
+}
+
+static int
+attention_query(char *sql, sqlite3_stmt **stmt)
+{
+  int ret = sql ? db_blocking_prepare_v2(sql, -1, stmt, NULL) : SQLITE_NOMEM;
+  sqlite3_free(sql);
+  return ret == SQLITE_OK ? 0 : -1;
+}
+
+static int
+attention_transaction_begin(void)
+{
+  sqlite3_stmt *stmt = NULL;
+  int sync, ret;
+  const char *journal;
+  /* The product never acknowledges custody committed to a volatile journal.
+   * Respect configured durability; do not silently tune unrelated SQLite use. */
+  if (!hdl || !sqlite3_get_autocommit(hdl)
+      || attention_query(sqlite3_mprintf("PRAGMA synchronous"), &stmt) < 0)
+    return -1;
+  ret = db_blocking_step(stmt);
+  sync = ret == SQLITE_ROW ? sqlite3_column_int(stmt, 0) : 0;
+  sqlite3_finalize(stmt);
+  if (sync < 2 || attention_query(sqlite3_mprintf("PRAGMA journal_mode"), &stmt) < 0)
+    return -1;
+  ret = db_blocking_step(stmt);
+  journal = ret == SQLITE_ROW ? (const char *)sqlite3_column_text(stmt, 0) : NULL;
+  ret = journal && strcmp(journal, "off") && strcmp(journal, "memory") ? 0 : -1;
+  sqlite3_finalize(stmt);
+  return ret < 0 ? -1 : attention_sql(sqlite3_mprintf("BEGIN IMMEDIATE"));
+}
+
+static int
+attention_transaction_end(int ret)
+{
+  if (ret < 0 || attention_sql(sqlite3_mprintf("COMMIT")) < 0)
+    {
+      attention_sql(sqlite3_mprintf("ROLLBACK"));
+      return -1;
+    }
+  return 0;
+}
+
+int
+db_attention_schema_init(void)
+{
+  char provenance[37];
+  int ret;
+  outputs_attention_uuid(provenance);
+  if (attention_transaction_begin() < 0) return -1;
+  ret = attention_sql(sqlite3_mprintf(
+    "CREATE TABLE IF NOT EXISTS native_attention_meta_v1 (singleton INTEGER PRIMARY KEY CHECK(singleton=1), provenance TEXT NOT NULL);"
+    "CREATE TABLE IF NOT EXISTS native_attention_process_v1 (process TEXT PRIMARY KEY, database_id TEXT NOT NULL);"
+    "CREATE TABLE IF NOT EXISTS native_attention_base_v1 (device TEXT PRIMARY KEY, volume INTEGER NOT NULL CHECK(volume BETWEEN 0 AND 100));"
+    "CREATE TABLE IF NOT EXISTS native_attention_origin_v1 (process TEXT NOT NULL, request TEXT NOT NULL, device TEXT NOT NULL, lease TEXT NOT NULL, retired INTEGER NOT NULL DEFAULT 0, terminal_identity TEXT, terminal_request TEXT, terminal_operation TEXT, terminal_action INTEGER, code INTEGER, cseq INTEGER, PRIMARY KEY(process,request));"
+    "CREATE TABLE IF NOT EXISTS native_attention_attempt_v1 (process TEXT NOT NULL, request TEXT NOT NULL, device TEXT NOT NULL, operation TEXT NOT NULL, action INTEGER NOT NULL, outcome INTEGER NOT NULL, code INTEGER NOT NULL, cseq INTEGER NOT NULL, expected TEXT NOT NULL, identity TEXT NOT NULL, cap INTEGER NOT NULL, ttl INTEGER NOT NULL, origin_process TEXT NOT NULL, origin_request TEXT NOT NULL, recovery INTEGER NOT NULL, PRIMARY KEY(process,request));"
+    "INSERT OR IGNORE INTO native_attention_meta_v1 VALUES(1,%Q)", provenance));
+  return attention_transaction_end(ret);
+}
+
+int
+db_attention_process_register(const char *process)
+{
+  int ret;
+  if (!process || strlen(process) != 36 || attention_transaction_begin() < 0) return -1;
+  ret = attention_sql(sqlite3_mprintf("INSERT INTO native_attention_process_v1 SELECT %Q,provenance FROM native_attention_meta_v1 WHERE singleton=1", process));
+  return attention_transaction_end(ret);
+}
+
+int
+db_attention_base_get(uint64_t id, int *volume)
+{
+  sqlite3_stmt *stmt = NULL;
+  int ret;
+  if (attention_query(sqlite3_mprintf("SELECT volume FROM native_attention_base_v1 WHERE device='%" PRIu64 "'", id), &stmt) < 0) return -1;
+  ret = db_blocking_step(stmt);
+  if (ret == SQLITE_ROW) *volume = sqlite3_column_int(stmt, 0);
+  sqlite3_finalize(stmt);
+  return ret == SQLITE_ROW ? 0 : ret == SQLITE_DONE ? 1 : -1;
+}
+
+static int
+attention_base_write(uint64_t id, int volume)
+{
+  return attention_sql(sqlite3_mprintf("INSERT INTO native_attention_base_v1 VALUES('%" PRIu64 "',%d) ON CONFLICT(device) DO UPDATE SET volume=excluded.volume", id, volume));
+}
+
+int
+db_attention_base_save(uint64_t id, int volume)
+{
+  if (volume < 0 || volume > 100 || attention_transaction_begin() < 0) return -1;
+  return attention_transaction_end(attention_base_write(id, volume));
+}
+
+int
+db_attention_begin(uint64_t id, int volume, const struct output_attention_origin *origin, uint64_t lease)
+{
+  int ret;
+  if (attention_transaction_begin() < 0) return -1;
+  ret = attention_base_write(id, volume);
+  if (ret == 0)
+    ret = attention_sql(sqlite3_mprintf("INSERT INTO native_attention_origin_v1(process,request,device,lease) SELECT %Q,%Q,'%" PRIu64 "','%" PRIu64 "' FROM native_attention_process_v1 WHERE process=%Q", origin->process, origin->request_id, id, lease, origin->process));
+  if (ret == 0 && sqlite3_changes(hdl) != 1) ret = -1;
+  return attention_transaction_end(ret);
+}
+
+static void
+attention_state_encode(const struct output_attention_state *s, char text[512])
+{
+  snprintf(text, 512, "%s|%" PRIu64 "|%" PRIu64 "|%" PRIu64 "|%" PRIu64 "|%" PRIu64 "|%" PRIu64 "|%" PRIu64 "|%d|%d|%d|%" PRIu64,
+    s->process,s->device_id,s->device_incarnation,s->session_epoch,s->base_revision,s->attention_revision,s->route_revision,s->lease,s->base_volume,s->effective_volume,s->restoring,s->last_release_operation);
+}
+
+static bool
+attention_uuid_valid(const char *uuid)
+{
+  int i;
+  if (!uuid || strlen(uuid) != 36) return false;
+  for (i = 0; i < 36; i++)
+    if (i == 8 || i == 13 || i == 18 || i == 23)
+      { if (uuid[i] != '-') return false; }
+    else if (!((uuid[i] >= '0' && uuid[i] <= '9') || (uuid[i] >= 'a' && uuid[i] <= 'f')))
+      return false;
+  return true;
+}
+
+static int
+attention_state_decode(const char *text, struct output_attention_state *s)
+{
+  int restoring, n = 0, fields;
+  memset(s, 0, sizeof(*s));
+  if (!text) return -1;
+  fields = sscanf(text, "%36[0-9a-f-]|%" SCNu64 "|%" SCNu64 "|%" SCNu64 "|%" SCNu64 "|%" SCNu64 "|%" SCNu64 "|%" SCNu64 "|%d|%d|%d|%" SCNu64 "%n",
+    s->process,&s->device_id,&s->device_incarnation,&s->session_epoch,&s->base_revision,&s->attention_revision,&s->route_revision,&s->lease,&s->base_volume,&s->effective_volume,&restoring,&s->last_release_operation,&n);
+  if (fields != 12 || text[n] || !attention_uuid_valid(s->process) || restoring < 0 || restoring > 1
+      || s->base_volume < 0 || s->base_volume > 100 || s->effective_volume < 0 || s->effective_volume > 100) return -1;
+  s->restoring = restoring;
+  return 0;
+}
+
+int
+db_attention_origin_get(uint64_t id, const struct output_attention_origin *origin, enum output_attention_recovery_state *state, struct output_attention_proof *proof)
+{
+  sqlite3_stmt *stmt = NULL;
+  int ret;
+  memset(proof, 0, sizeof(*proof));
+  *state = OUTPUT_RECOVERY_UNKNOWN;
+  if (attention_query(sqlite3_mprintf("SELECT p.database_id FROM native_attention_process_v1 p JOIN native_attention_meta_v1 m ON p.database_id=m.provenance WHERE p.process=%Q", origin->process), &stmt) < 0) return -1;
+  ret = db_blocking_step(stmt);
+  if (ret == SQLITE_ROW) snprintf(proof->database,sizeof(proof->database),"%s",sqlite3_column_text(stmt,0));
+  sqlite3_finalize(stmt);
+  if (ret != SQLITE_ROW) return ret == SQLITE_DONE ? 0 : -1;
+  if (!attention_uuid_valid(proof->database)) return -1;
+  proof->ledger_complete = true;
+  if (attention_query(sqlite3_mprintf("SELECT device,retired,terminal_identity,terminal_request,terminal_operation,terminal_action,code,cseq FROM native_attention_origin_v1 WHERE process=%Q AND request=%Q", origin->process,origin->request_id), &stmt) < 0) return -1;
+  ret = db_blocking_step(stmt);
+  if (ret == SQLITE_DONE) *state = OUTPUT_RECOVERY_NEVER_ADMITTED;
+  else if (ret == SQLITE_ROW)
+    {
+      uint64_t device;
+      if (safe_atou64((const char *)sqlite3_column_text(stmt,0),&device) < 0 || device != id) ret = SQLITE_ERROR;
+      else if (!sqlite3_column_int(stmt,1)) *state = OUTPUT_RECOVERY_PENDING;
+      else if (attention_state_decode((const char *)sqlite3_column_text(stmt,2),&proof->terminal_identity) < 0
+          || safe_atou64((const char *)sqlite3_column_text(stmt,4),&proof->terminal_operation) < 0) ret = SQLITE_ERROR;
+      else
+        {
+          snprintf(proof->terminal_request_id,sizeof(proof->terminal_request_id),"%s",sqlite3_column_text(stmt,3));
+          proof->terminal_action = sqlite3_column_int(stmt,5);
+          proof->terminal_response_code = sqlite3_column_int(stmt,6);
+          proof->terminal_request_cseq = sqlite3_column_int(stmt,7);
+          if (!proof->terminal_operation || !attention_uuid_valid(proof->terminal_request_id)
+              || proof->terminal_identity.device_id != id || proof->terminal_response_code != 200 || proof->terminal_request_cseq <= 0
+              || (proof->terminal_action != OUTPUT_ATTENTION_RELEASE && proof->terminal_action != OUTPUT_ATTENTION_RECOVER)) ret = SQLITE_ERROR;
+          else *state = OUTPUT_RECOVERY_ALREADY_RETIRED;
+        }
+    }
+  sqlite3_finalize(stmt);
+  return ret == SQLITE_ROW || ret == SQLITE_DONE ? 0 : -1;
+}
+
+int
+db_attention_origin_pending(uint64_t id)
+{
+  sqlite3_stmt *stmt = NULL;
+  int ret, pending;
+  if (attention_query(sqlite3_mprintf("SELECT 1 FROM native_attention_origin_v1 WHERE device='%" PRIu64 "' AND retired=0 LIMIT 1", id), &stmt) < 0) return -1;
+  ret = db_blocking_step(stmt);
+  pending = ret == SQLITE_ROW ? 1 : ret == SQLITE_DONE ? 0 : -1;
+  sqlite3_finalize(stmt);
+  return pending;
+}
+
+int
+db_attention_receipt_save(const struct output_attention_result *r, bool retired)
+{
+  char expected[512], identity[512];
+  int ret = 0;
+  if (attention_transaction_begin() < 0) return -1;
+  attention_state_encode(&r->identity,identity);
+  attention_state_encode(&r->command.expected,expected);
+  if (r->command.request_id[0])
+    ret = attention_sql(sqlite3_mprintf("INSERT INTO native_attention_attempt_v1 VALUES(%Q,%Q,'%" PRIu64 "','%" PRIu64 "',%d,%d,%d,%d,%Q,%Q,%d,%u,%Q,%Q,%d) ON CONFLICT(process,request) DO UPDATE SET outcome=excluded.outcome,code=excluded.code,cseq=excluded.cseq,recovery=excluded.recovery",r->identity.process,r->command.request_id,r->identity.device_id,r->operation,r->action,r->outcome,r->response_code,r->request_cseq,expected,identity,r->command.cap_volume,r->command.ttl_ms,r->command.origin.process,r->command.origin.request_id,r->recovery_state));
+  if (ret == 0 && retired)
+    {
+      ret = attention_sql(sqlite3_mprintf("UPDATE native_attention_origin_v1 SET retired=1,terminal_identity=%Q,terminal_request=%Q,terminal_operation='%" PRIu64 "',terminal_action=%d,code=%d,cseq=%d WHERE process=%Q AND request=%Q AND device='%" PRIu64 "' AND retired=0",identity,r->command.request_id,r->operation,r->action,r->response_code,r->request_cseq,r->command.origin.process,r->command.origin.request_id,r->identity.device_id));
+      if (ret == 0 && sqlite3_changes(hdl) != 1) ret = -1;
+    }
+  return attention_transaction_end(ret);
+}
+
+int
+db_attention_receipt_get(const char *process, uint64_t id, const char *request_id, struct output_attention_result *r)
+{
+  sqlite3_stmt *stmt = NULL;
+  enum output_attention_recovery_state origin_state;
+  int ret;
+  if (attention_query(sqlite3_mprintf("SELECT operation,action,outcome,code,cseq,expected,identity,cap,ttl,origin_process,origin_request,recovery FROM native_attention_attempt_v1 WHERE process=%Q AND request=%Q AND device='%" PRIu64 "'",process,request_id,id), &stmt) < 0) return -1;
+  ret = db_blocking_step(stmt);
+  if (ret == SQLITE_ROW)
+    {
+      memset(r,0,sizeof(*r));
+      if (safe_atou64((const char *)sqlite3_column_text(stmt,0),&r->operation) < 0
+          || attention_state_decode((const char *)sqlite3_column_text(stmt,5),&r->command.expected) < 0
+          || attention_state_decode((const char *)sqlite3_column_text(stmt,6),&r->identity) < 0) ret = SQLITE_ERROR;
+      r->action = r->command.action = sqlite3_column_int(stmt,1);
+      r->outcome = sqlite3_column_int(stmt,2);
+      r->response_code = sqlite3_column_int(stmt,3);
+      r->request_cseq = sqlite3_column_int(stmt,4);
+      r->command.cap_volume = sqlite3_column_int(stmt,7);
+      r->command.ttl_ms = sqlite3_column_int(stmt,8);
+      snprintf(r->command.request_id,sizeof(r->command.request_id),"%s",request_id);
+      snprintf(r->command.origin.process,sizeof(r->command.origin.process),"%s",sqlite3_column_text(stmt,9));
+      snprintf(r->command.origin.request_id,sizeof(r->command.origin.request_id),"%s",sqlite3_column_text(stmt,10));
+      r->recovery_state = sqlite3_column_int(stmt,11);
+      if (!r->operation || r->action < OUTPUT_ATTENTION_BEGIN || r->action > OUTPUT_ATTENTION_RECOVER
+          || r->outcome < OUTPUT_ATTENTION_PENDING || r->outcome > OUTPUT_ATTENTION_NO_EFFECT
+          || r->recovery_state < OUTPUT_RECOVERY_NONE || r->recovery_state > OUTPUT_RECOVERY_UNKNOWN
+          || r->command.cap_volume < 0 || r->command.cap_volume > 100 || r->command.ttl_ms > 15000
+          || r->identity.device_id != id || strcmp(r->identity.process, process)
+          || !attention_uuid_valid(r->command.request_id)
+          || ((r->action == OUTPUT_ATTENTION_RECOVER || r->command.origin.process[0] || r->command.origin.request_id[0])
+              && (!attention_uuid_valid(r->command.origin.process) || !attention_uuid_valid(r->command.origin.request_id))))
+        ret = SQLITE_ERROR;
+    }
+  sqlite3_finalize(stmt);
+  if (ret == SQLITE_ROW && r->action == OUTPUT_ATTENTION_RECOVER
+      && db_attention_origin_get(id,&r->command.origin,&origin_state,&r->recovery_proof) < 0) return -1;
+  return ret == SQLITE_ROW ? 0 : ret == SQLITE_DONE ? 1 : -1;
+}
