+static bool
+attention_recovery_terminal_current(const struct output_attention_result *result, struct output_attention_state *state)
+{
+  struct output_device *device = outputs_device_get(result->identity.device_id);
+  if ((result->action != OUTPUT_ATTENTION_RECOVER && result->action != OUTPUT_ATTENTION_RELEASE) || !device || device->session
+      || result->identity.session_epoch == UINT64_MAX
+      || state->session_epoch != result->identity.session_epoch + 1)
+    return false;
+  state->session_epoch = result->identity.session_epoch;
+  return attention_identity_equal(&result->identity, state);
+}
