+/* Native attention is an overlay on manual desire, never a replacement base.
+ * All entry points below run on the existing player event loop. A result is a
+ * protocol observation, not an acoustic or hardware readback receipt. */
+enum output_attention_action
+{
+  OUTPUT_ATTENTION_BEGIN,
+  OUTPUT_ATTENTION_UPDATE,
+  OUTPUT_ATTENTION_RELEASE,
+  OUTPUT_ATTENTION_FLUSH, // Internal route handoff only, not a volume request.
+  OUTPUT_ATTENTION_MANUAL, // Explicit manual base CAS; never an attention renewal.
+  OUTPUT_ATTENTION_RECOVER, // Fresh cleanup of one durable original BEGIN; never adoption.
+};
+
+enum output_attention_outcome
+{
+  OUTPUT_ATTENTION_PENDING,
+  OUTPUT_ATTENTION_DESIRED_ONLY,
+  OUTPUT_ATTENTION_PROTOCOL_ACCEPTED,
+  OUTPUT_ATTENTION_FAILED,
+  OUTPUT_ATTENTION_UNKNOWN,
+  OUTPUT_ATTENTION_NO_EFFECT,
+};
+
+struct output_attention_state
+{
+  char process[37];
+  uint64_t device_id;
+  uint64_t device_incarnation;
+  uint64_t session_epoch;
+  uint64_t base_revision;
+  uint64_t attention_revision;
+  uint64_t route_revision;
+  uint64_t lease;
+  int base_volume;
+  int effective_volume;
+  bool restoring;
+  uint64_t last_release_operation; // Observer only; excluded from expected identity.
+  bool recovery_idle; // Observer only, never supplied as CAS authority.
+  uint64_t last_drained_operation;
+  char last_drained_request_id[37];
+};
+
+struct output_attention_origin
+{
+  char process[37];
+  char request_id[37];
+};
+
+struct output_attention_request
+{
+  struct output_attention_state expected;
+  char request_id[37]; // Exact idempotency identity; native expiry also mints its own UUID.
+  enum output_attention_action action;
+  int cap_volume;
+  unsigned ttl_ms; // Same existing attention ceiling: 15000 ms. Zero uses 2000 ms.
+  struct output_attention_origin origin; // RECOVER only; native durable custody is authority.
+};
+
+enum output_attention_recovery_state
+{
+  OUTPUT_RECOVERY_NONE,
+  OUTPUT_RECOVERY_PENDING,
+  OUTPUT_RECOVERY_RESTORED,
+  OUTPUT_RECOVERY_ALREADY_RETIRED,
+  OUTPUT_RECOVERY_NEVER_ADMITTED,
+  OUTPUT_RECOVERY_UNKNOWN,
+};
+
+struct output_attention_proof
+{
+  char database[37]; // Persistent random native DB provenance, never supplied by caller.
+  bool ledger_complete;
+  struct output_attention_state terminal_identity;
+  char terminal_request_id[37];
+  uint64_t terminal_operation;
+  enum output_attention_action terminal_action;
+  int terminal_response_code;
+  int terminal_request_cseq;
+};
+
+struct output_attention_result
+{
+  struct output_attention_state identity;
+  struct output_attention_request command; // Immutable original admission bytes.
+  uint64_t operation;
+  enum output_attention_action action;
+  enum output_attention_outcome outcome;
+  int response_code;
+  int request_cseq;
+  bool current;
+  enum output_attention_recovery_state recovery_state;
+  struct output_attention_proof recovery_proof;
+};
