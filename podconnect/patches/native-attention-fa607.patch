+static int recovery_wire_reply(struct recovery_wire_fixture *f,int code,int cseq,const uint8_t *body,size_t length)
+{
+  struct evbuffer *reply=evbuffer_new();
+  uint8_t *encrypted=NULL;
+  size_t encrypted_length=0;
+  int ret;
+  if (!reply) return -1;
+  evbuffer_add_printf(reply,"RTSP/1.0 %d Controlled\r\nCSeq: %d\r\nContent-Length: %zu\r\n\r\n",code,cseq,length);
+  if (length) evbuffer_add(reply,body,length);
+  if (f->cipher) {
+    ret=pair_encrypt(&encrypted,&encrypted_length,evbuffer_pullup(reply,-1),evbuffer_get_length(reply),f->cipher);
+    if (ret<0) {evbuffer_free(reply);return -1;}
+    ret=bufferevent_write(f->peer,encrypted,encrypted_length); free(encrypted);
+  } else ret=bufferevent_write_buffer(f->peer,reply);
+  evbuffer_free(reply); return ret;
+}
