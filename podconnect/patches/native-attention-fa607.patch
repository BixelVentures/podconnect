+    struct output_attention_request blocked={.action=OUTPUT_ATTENTION_BEGIN,.cap_volume=5};
+    outputs_attention_uuid(blocked.request_id);
+    assert(outputs_attention_state_get(1,&blocked.expected)==0);
+    assert(outputs_attention_admit(&blocked,&result)<0); // Hot reincarnation cannot discard durable old owner.
+    struct output_attention_request cleanup = { .action = OUTPUT_ATTENTION_RECOVER, .origin = old.command.origin };
+    outputs_attention_uuid(cleanup.request_id);
+    cleanup.expected = blocked.expected;
+    assert(outputs_attention_admit(&cleanup,&result)<0); // Old in-flight transport custody still fences fresh cleanup.
+    outputs_attention_complete(&old,OUTPUT_ATTENTION_UNKNOWN,0,0); // Controlled transport owner terminal, not protocol proof.
+    recover_fixture_origin(a,&old.command.origin);
+  }
+  fresh = request(1, OUTPUT_ATTENTION_BEGIN);
+  outputs_attention_complete(&old, OUTPUT_ATTENTION_PROTOCOL_ACCEPTED, 200, 9);
+  assert(outputs_attention_result_get(old.identity.process, old.operation, &result) == 0 && !result.current);
+  assert(outputs_attention_result_get(fresh.identity.process, fresh.operation, &result) == 0);
+  assert(result.current && result.outcome == OUTPUT_ATTENTION_PENDING);
+  assert(outputs_attention_admit(&request_old, &result) < 0);
+  outputs_attention_complete(&fresh, OUTPUT_ATTENTION_UNKNOWN, 0, 10);
+
+  assert(outputs_device_session_add(1, &opaque_a) == 0);
+  assert(outputs_attention_state_get(1, &request_old.expected) == 0);
+  assert(outputs_device_session_add(1, &opaque_b) == 0);
+  outputs_device_session_remove_exact(1, &opaque_a);
+  assert(a->session == &opaque_b); /* old cleanup cannot erase fresh handle */
+  assert(outputs_attention_admit(&request_old, &result) < 0);
+  outputs_device_session_remove_exact(1, &opaque_b);
+  assert(a->session == NULL);
+  clear_devices();
+}
