+      outputs_attention_uuid(f->command.request_id);
+      if (outputs_attention_admit(&f->command, &f->result) < 0 || f->result.outcome != OUTPUT_ATTENTION_PENDING)
+        { recovery_wire_fail(f, "drained connected UNKNOWN could not reconcile original origin"); return; }
+      f->phase = 3;
+      evtimer_add(f->poll, &soon);
+      return;
+    }
+  if (f->mode == 3 && f->phase < 2)
+    {
+      struct output_attention_state state;
+      struct output_attention_request fresh = { .action = OUTPUT_ATTENTION_BEGIN, .cap_volume = 5 };
+      struct output_attention_result blocked;
