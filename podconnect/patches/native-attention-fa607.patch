+        f->command.expected = state;
+        if (outputs_attention_admit(&f->command, &blocked) == 0)
+          { recovery_wire_fail(f, "replacement recovered before actual old-owner drain"); goto done; }
+        f->phase = 1;
+      }
+    if (f->mode == 3 && f->phase == 0)
+      {
