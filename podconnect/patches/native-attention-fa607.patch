+  struct output_attention_request recover,competing,never,begin={.action=OUTPUT_ATTENTION_BEGIN,.cap_volume=5};
+  struct output_attention_result pending,result,prior;
+  enum output_attention_recovery_state origin_state;
+  struct output_attention_proof proof;
+  int sent;
+  output_airplay.device_attention_recovery_prepare=recovery_prepare_edge;
+  output_airplay.device_attention_recover=inert_attention;
+  transport_return=1;
+  prior=request(1,OUTPUT_ATTENTION_BEGIN); origin_a=a->attention_origin;
+  assert(db_attention_origin_get(1,&origin_a,&origin_state,&proof)==0 && origin_state==OUTPUT_RECOVERY_PENDING);
+  outputs_attention_complete(&prior,OUTPUT_ATTENTION_UNKNOWN,0,0);
+  prior=request(2,OUTPUT_ATTENTION_BEGIN); origin_b=b->attention_origin;
+  outputs_attention_complete(&prior,OUTPUT_ATTENTION_UNKNOWN,0,0);
+  assert(outputs_device_volume_register(a,60,-1)==0); // Latest manual BASE, never cap5.
+  cold_restart_preserving_native_database();
+  a=add_device(1); b=add_device(2);
+  assert(a->volume==60 && b->volume==65 && !a->attention_lease && !b->attention_lease);
+  outputs_attention_uuid(begin.request_id);
+  assert(outputs_attention_state_get(1,&begin.expected)==0);
+  sent=transport_calls;
+  assert(outputs_attention_admit(&begin,&result)<0 && transport_calls==sent);
+  recover=recovery_request(1,&origin_a);
+  assert(outputs_attention_admit(&recover,&pending)==0 && pending.outcome==OUTPUT_ATTENTION_PENDING);
+  assert(pending.identity.base_volume==60 && pending.identity.effective_volume==60 && pending.identity.lease==0);
+  sent=transport_calls;
+  assert(outputs_attention_admit(&recover,&result)==0 && result.operation==pending.operation && transport_calls==sent);
+  competing=recovery_request(1,&origin_a);
+  assert(outputs_attention_admit(&competing,&result)<0 && transport_calls==sent);
+  assert(db_attention_origin_get(2,&origin_b,&origin_state,&proof)==0 && origin_state==OUTPUT_RECOVERY_PENDING);
+  outputs_attention_complete(&pending,OUTPUT_ATTENTION_PROTOCOL_ACCEPTED,200,51);
+  assert(outputs_attention_result_get(pending.identity.process,pending.operation,&result)==0);
+  assert(result.current && result.recovery_state==OUTPUT_RECOVERY_RESTORED && result.recovery_proof.ledger_complete);
+  assert(!strcmp(result.recovery_proof.terminal_request_id,recover.request_id));
+  assert(result.recovery_proof.terminal_operation==pending.operation && result.recovery_proof.terminal_request_cseq==51);
+  cold_restart_preserving_native_database();
+  a=add_device(1); b=add_device(2);
+  recover=recovery_request(1,&origin_a); sent=transport_calls;
+  assert(outputs_attention_admit(&recover,&result)==0 && transport_calls==sent);
+  assert(result.current && result.outcome==OUTPUT_ATTENTION_NO_EFFECT && result.recovery_state==OUTPUT_RECOVERY_ALREADY_RETIRED);
+  assert(result.recovery_proof.terminal_response_code==200 && result.recovery_proof.terminal_request_cseq==51);
+  assert(result.recovery_proof.terminal_operation==pending.operation);
+  never=recovery_request(1,&origin_a); outputs_attention_uuid(never.origin.request_id);
+  assert(outputs_attention_admit(&never,&result)==0 && result.recovery_state==OUTPUT_RECOVERY_NEVER_ADMITTED);
+  assert(result.outcome==OUTPUT_ATTENTION_NO_EFFECT && result.recovery_proof.ledger_complete && !result.recovery_proof.terminal_operation);
+  assert(!result.response_code && !result.request_cseq && transport_calls==sent);
+  outputs_attention_uuid(never.request_id); outputs_attention_uuid(never.origin.process);
+  assert(outputs_attention_state_get(1,&never.expected)==0);
+  assert(outputs_attention_admit(&never,&result)<0 && transport_calls==sent); // Foreign DB/process is no absence proof.
+  recover=recovery_request(2,&origin_b);
+  assert(outputs_attention_admit(&recover,&pending)==0);
+  outputs_attention_complete(&pending,OUTPUT_ATTENTION_PROTOCOL_ACCEPTED,200,52);
+  assert(db_attention_origin_get(2,&origin_b,&origin_state,&proof)==0 && origin_state==OUTPUT_RECOVERY_ALREADY_RETIRED);
+  clear_devices();
+}
+
+static void durable_disk_failure_unknown_and_stale_generation(void)
+{
+  struct output_device *a=add_device(1);
+  struct output_attention_origin origin;
+  struct output_attention_request begin={.action=OUTPUT_ATTENTION_BEGIN,.cap_volume=5},recover;
+  struct output_attention_result pending,result;
