--- /dev/null
+++ b/tests/evrtsp_owner_contract.c
@@ -0,0 +1,390 @@
+/*
+ * PC9 TEST-ONLY DRAFT. Links unchanged pinned OwnTone evrtsp/rtsp.c.
+ * No AirPlay/player/HTTP result, user volume, lease or physical claim.
+ * Operation strings are fixture identities, not production operation nonces.
+ */
+#include <sys/types.h>
+#include <sys/socket.h>
+#include <sys/queue.h>
+#include <netinet/in.h>
+#include <arpa/inet.h>
+#include <event2/event.h>
+#include <event2/buffer.h>
+#include <event2/bufferevent.h>
+#include <event2/listener.h>
+#include <event2/util.h>
+#include <event2/keyvalq_struct.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+#include "evrtsp.h"
+#include "rtsp-internal.h"
+
+int debug; /* Same extern required by the actual evrtsp TU; no log stubs. */
+enum mode { RAW_NEGATIVE, READ_ERROR_RECONNECT, QUEUED_FREE, GRACEFUL_EOF_NO_ACK };
+struct fixture;
+struct operation {
+  struct fixture *fixture;
+  const char *identity;
+  int calls;
+  int is_null;
+  int raw_status;
+  int raw_cseq;
+  int saw_next_native_stage;
+};
+struct peer {
+  struct fixture *fixture;
+  struct bufferevent *bev;
+  int incarnation; /* Fixture accept order, never PID/FD/native incarnation. */
+};
+struct fixture {
+  enum mode mode;
+  struct event_base *base;
+  struct evconnlistener *listener;
+  struct event *deadline;
+  struct evrtsp_connection *native;
+  struct evrtsp_request *admitted[2]; /* Compare only while native owns them. */
+  struct operation op[2];
+  struct peer peers[2];
+  int accept_count;
+  int request_count;
+  int close_calls;
+  int queued_at_close;
+  int queued_before_free;
+  int freed;
+  int native_fd_before_peer_close;
+  int eof_no_headers;
+  int eof_same_fd;
+  int rst_requested;
+  int failed;
+};
+
+static int check(struct fixture *s, int condition, const char *why)
+{
+  if (!condition) {
+    fprintf(stderr, "FAIL mode=%d: %s\n", s->mode, why);
+    s->failed = 1;
+    if (s->base) event_base_loopbreak(s->base);
+  }
+  return condition;
+}
+static int queue_count(struct evrtsp_connection *native)
+{
+  struct evrtsp_request *r;
+  int count = 0;
+  TAILQ_FOREACH(r, &native->requests, next) count++;
+  return count;
+}
+static void deadline_cb(evutil_socket_t fd, short events, void *arg)
+{
+  (void)fd; (void)events;
+  check(arg, 0, "fixture event deadline expired; native timeouts unchanged");
+}
+static void native_close_cb(struct evrtsp_connection *native, void *arg)
+{
+  struct fixture *s = arg;
+  s->close_calls++;
+  s->queued_at_close = queue_count(native);
+  check(s, native == s->native && s->close_calls == 1,
+        "unexpected or duplicate native close callback");
+}
+static void response_cb(struct evrtsp_request *req, void *arg)
+{
+  struct operation *op = arg;
+  struct fixture *s = op->fixture;
+  const char *identity, *cseq;
+  op->calls++;
+  op->is_null = req == NULL;
+  op->raw_status = req ? req->response_code : 0;
+  if (!check(s, op->calls == 1, "duplicate caller-owned operation callback"))
+    return;
+  if (s->mode == QUEUED_FREE) {
+    check(s, 0, "connection_free unexpectedly notified queued request");
+    return;
+  }
+  if (s->mode == GRACEFUL_EOF_NO_ACK) {
+    /* Observe only the first callback; later B transport outcome is unknown. */
+    if (!check(s, op == &s->op[0] && req == s->admitted[0] &&
+               !op->is_null && op->raw_status == 0 && req->evcon == NULL,
+               "graceful EOF did not return actual A with raw status zero"))
+      return;
+    s->eof_no_headers = req->input_headers &&
+      TAILQ_EMPTY(req->input_headers) && req->response_code_line == NULL &&
+      evbuffer_get_length(req->input_buffer) == 0;
+    s->eof_same_fd = s->native_fd_before_peer_close >= 0 &&
+      s->native->fd == s->native_fd_before_peer_close;
+    op->saw_next_native_stage =
+      TAILQ_FIRST(&s->native->requests) == s->admitted[1] &&
+      s->native->state == EVCON_WRITING;
+    if (!check(s, s->eof_no_headers && s->eof_same_fd &&
+               op->saw_next_native_stage && s->accept_count == 1 &&
+               s->request_count == 1 && s->op[1].calls == 0,
+               "graceful EOF no-ACK/same-fd B-stage witness incomplete"))
+      return;
+    event_base_loopbreak(s->base);
+    return; /* Actual TU frees A after callback; do not retain/dereference it. */
+  }
+  if (op == &s->op[0]) {
+    op->saw_next_native_stage =
+      TAILQ_FIRST(&s->native->requests) == s->admitted[1] &&
+      s->native->state == (s->mode == READ_ERROR_RECONNECT ?
+                           EVCON_CONNECTING : EVCON_WRITING);
+    if (!check(s, op->saw_next_native_stage,
+               "next native request was not staged before first callback"))
+      return;
+  }
+  if (req) {
+    identity = evrtsp_find_header(req->input_headers,
+                                 "X-PC9-Fixture-Operation");
+    if (!check(s, identity && strcmp(identity, op->identity) == 0,
+               "actual parser response bound to wrong fixture identity"))
+      return;
+    cseq = evrtsp_find_header(req->input_headers, "CSeq");
+    if (!check(s, cseq && strcmp(cseq, op == &s->op[0] ? "999" : "2") == 0,
+               "actual parser lost controlled response CSeq")) return;
+    op->raw_cseq = atoi(cseq); /* Validated literal fixture metadata only. */
+  }
+  /* Do not retain/dereference req after returning: actual TU frees it. */
+  if (s->op[0].calls && s->op[1].calls)
+    event_base_loopbreak(s->base);
+}
+static void peer_event_cb(struct bufferevent *bev, short events, void *arg)
+{
+  struct peer *peer = arg;
+  (void)bev;
+  if (events & (BEV_EVENT_ERROR | BEV_EVENT_EOF | BEV_EVENT_TIMEOUT))
+    check(peer->fixture, 0, "unexpected inert peer event before fixture ended");
+}
+static void peer_read_cb(struct bufferevent *bev, void *arg)
+{
+  struct peer *peer = arg;
+  struct fixture *s = peer->fixture;
+  struct evbuffer *input = bufferevent_get_input(bev);
+  struct evbuffer_ptr end = evbuffer_search(input, "\r\n\r\n", 4, NULL);
+  char header[4097], response[256];
+  const char *identity;
+  int status, cseq, count, n;
+  size_t length;
+  if (end.pos < 0) {
+    check(s, evbuffer_get_length(input) <= 4096, "fixture header exceeded bound");
+    return;
+  }
+  length = (size_t)end.pos + 4;
+  if (!check(s, length < sizeof(header), "fixture request too large")) return;
+  if (!check(s, evbuffer_remove(input, header, length) == (int)length,
+             "fixture header read incomplete")) return;
+  header[length] = '\0';
+  if (!check(s, strncmp(header, "SET_PARAMETER ", 14) == 0,
+             "unexpected actual native request method")) return;
+  count = ++s->request_count;
+  if (!check(s, count <= 2, "duplicate/extra actual native request")) return;
+  identity = s->op[count - 1].identity;
+  if (!check(s, strstr(header, count == 1 ?
+                     "\r\nX-PC9-Fixture-Operation: pc9-A\r\n" :
+                     "\r\nX-PC9-Fixture-Operation: pc9-B\r\n") != NULL,
+             "wire request identity/order differs from admitted fixture"))
+    return;
+  if (!check(s, strstr(header, "\r\nContent-Length: 0\r\n") != NULL,
+             "fixture must carry no audio or volume payload")) return;
+  if (s->mode == QUEUED_FREE) {
+    s->queued_before_free = queue_count(s->native);
+    if (!check(s, count == 1 && s->queued_before_free == 2 &&
+               s->op[0].calls == 0 && s->op[1].calls == 0,
+               "fixture did not hold two admitted native requests")) return;
+    /* Actual destructor on actual live transport, outside request callback. */
+    evrtsp_connection_free(s->native);
+    s->native = NULL;
+    s->freed = 1;
+    check(s, s->op[0].calls == 0 && s->op[1].calls == 0,
+          "queued native requests received callback during free");
+    event_base_loopbreak(s->base);
+    return;
+  }
+  if ((s->mode == READ_ERROR_RECONNECT || s->mode == GRACEFUL_EOF_NO_ACK) &&
+      count == 1) {
+    if (!check(s, peer->incarnation == 1, "first request on wrong peer")) return;
+    s->native_fd_before_peer_close = s->native->fd;
+    if (!check(s, s->native_fd_before_peer_close >= 0,
+               "native first transport descriptor unavailable")) return;
+    if (s->mode == READ_ERROR_RECONNECT) {
+      struct linger reset = {1, 0};
+      evutil_socket_t peer_fd = bufferevent_getfd(peer->bev);
+      /* Actual accepted loopback socket: reset instead of graceful EOF. */
+      if (!check(s, peer_fd >= 0 &&
+                 setsockopt(peer_fd, SOL_SOCKET, SO_LINGER,
+                            &reset, sizeof(reset)) == 0,
+                 "controlled TCP reset setup failed")) return;
+      s->rst_requested = 1;
+    }
+    /* No response bytes; production TU alone handles the transport event. */
+    bufferevent_free(peer->bev);
+    peer->bev = NULL;
+    return;
+  }
+  if (!check(s, peer->incarnation == (s->mode == READ_ERROR_RECONNECT ? 2 : 1),
+             "actual request on wrong fixture accept incarnation")) return;
+  status = s->mode == RAW_NEGATIVE && count == 1 ? 503 : 200;
+  /* Intentional mismatch confirms native parser does not validate CSeq. */
+  cseq = count == 1 ? 999 : 2;
+  n = snprintf(response, sizeof(response),
+               "RTSP/1.0 %d Fixture\r\nCSeq: %d\r\n"
+               "X-PC9-Fixture-Operation: %s\r\nContent-Length: 0\r\n\r\n",
+               status, cseq, identity);
+  if (!check(s, n > 0 && (size_t)n < sizeof(response) &&
+             bufferevent_write(bev, response, (size_t)n) == 0,
+             "inert peer could not queue complete response")) return;
+}
+static void accept_cb(struct evconnlistener *listener, evutil_socket_t fd,
+                      struct sockaddr *address, int length, void *arg)
+{
+  struct fixture *s = arg;
+  struct peer *peer;
+  struct sockaddr_in *remote = (struct sockaddr_in *)address;
+  (void)listener;
+  if (!check(s, length >= (int)sizeof(*remote) && remote->sin_family == AF_INET &&
+             ntohl(remote->sin_addr.s_addr) == INADDR_LOOPBACK &&
+             s->accept_count < 2, "non-loopback or extra peer admission")) {
+    evutil_closesocket(fd);
+    return;
+  }
+  peer = &s->peers[s->accept_count++];
+  peer->fixture = s;
+  peer->incarnation = s->accept_count;
+  peer->bev = bufferevent_socket_new(s->base, fd,
+                      BEV_OPT_CLOSE_ON_FREE | BEV_OPT_DEFER_CALLBACKS);
+  if (!check(s, peer->bev != NULL, "inert peer allocation failed")) {
+    evutil_closesocket(fd);
+    return;
+  }
+  bufferevent_setcb(peer->bev, peer_read_cb, NULL, peer_event_cb, peer);
+  check(s, bufferevent_enable(peer->bev, EV_READ | EV_WRITE) == 0,
+        "inert peer event enable failed");
+}
+static void listener_error_cb(struct evconnlistener *listener, void *arg)
+{
+  (void)listener;
+  check(arg, 0, "inert loopback listener error");
+}
+static int run_case(enum mode mode)
+{
+  struct fixture s = {0};
+  struct sockaddr_in address = {0};
+  socklen_t length = sizeof(address);
+  struct timeval bound = {5, 0};
+  int i, result;
+  s.mode = mode;
+  s.base = event_base_new();
+  if (!check(&s, s.base != NULL, "event base allocation failed")) goto cleanup;
+  address.sin_family = AF_INET;
+  address.sin_addr.s_addr = htonl(INADDR_LOOPBACK);
+  address.sin_port = 0;
+  s.listener = evconnlistener_new_bind(s.base, accept_cb, &s,
+               LEV_OPT_CLOSE_ON_FREE | LEV_OPT_REUSEABLE, 2,
+               (struct sockaddr *)&address, sizeof(address));
+  if (!check(&s, s.listener != NULL, "loopback listener failed")) goto cleanup;
+  evconnlistener_set_error_cb(s.listener, listener_error_cb);
+  if (!check(&s, getsockname(evconnlistener_get_fd(s.listener),
+               (struct sockaddr *)&address, &length) == 0,
+               "loopback ephemeral port unavailable")) goto cleanup;
+  s.native = evrtsp_connection_new("127.0.0.1", ntohs(address.sin_port));
+  if (!check(&s, s.native != NULL, "actual native connection failed"))
+    goto cleanup;
+  evrtsp_connection_set_base(s.native, s.base);
+  if (mode == QUEUED_FREE)
+    evrtsp_connection_set_closecb(s.native, native_close_cb, &s);
+  s.deadline = evtimer_new(s.base, deadline_cb, &s);
+  if (!check(&s, s.deadline && evtimer_add(s.deadline, &bound) == 0,
+             "fixture deadline owner failed")) goto cleanup;
+  for (i = 0; i < 2; i++) {
+    s.op[i].fixture = &s;
+    s.op[i].identity = i == 0 ? "pc9-A" : "pc9-B";
+    s.admitted[i] = evrtsp_request_new(response_cb, &s.op[i]);
+    if (!check(&s, s.admitted[i] != NULL, "actual request allocation failed"))
+      goto cleanup;
+    if (evrtsp_add_header(s.admitted[i]->output_headers,
+          "X-PC9-Fixture-Operation", s.op[i].identity) != 0 ||
+        evrtsp_add_header(s.admitted[i]->output_headers,
+          "CSeq", i == 0 ? "1" : "2") != 0 ||
+        evrtsp_add_header(s.admitted[i]->output_headers,
+          "Content-Length", "0") != 0) {
+      evrtsp_request_free(s.admitted[i]);
+      s.admitted[i] = NULL; /* Not admitted yet; caller still owned it. */
+      check(&s, 0, "fixture header preparation failed");
+      goto cleanup;
+    }
+    /* The pinned API takes ownership; never free an admitted request here. */
+    if (!check(&s, evrtsp_make_request(s.native, s.admitted[i],
+            EVRTSP_REQ_SET_PARAMETER, "rtsp://127.0.0.1/pc9-fixture") == 0,
+            "actual native admission failed")) goto cleanup;
+  }
+  if (!check(&s, queue_count(s.native) == 2,
+             "actual native queue did not admit both requests")) goto cleanup;
+  result = event_base_dispatch(s.base);
+  if (!check(&s, result == 0, "actual event loop ended unexpectedly"))
+    goto cleanup;
+  if (mode == QUEUED_FREE)
+    check(&s, s.freed && s.request_count == 1 && s.accept_count == 1 &&
+          s.queued_before_free == 2 && s.close_calls == 1 &&
+          s.queued_at_close == 2 && s.op[0].calls == 0 && s.op[1].calls == 0,
+          "actual queued-free counterexample not established");
+  else if (mode == GRACEFUL_EOF_NO_ACK)
+    check(&s, s.request_count == 1 && s.accept_count == 1 &&
+          s.op[0].calls == 1 && s.op[1].calls == 0 &&
+          !s.op[0].is_null && s.op[0].raw_status == 0 &&
+          s.op[0].saw_next_native_stage && s.eof_no_headers && s.eof_same_fd &&
+          !s.rst_requested,
+          "actual graceful EOF no-ACK witness incomplete; B outcome unknown");
+  else
+    check(&s, s.request_count == 2 &&
+          s.accept_count == (mode == READ_ERROR_RECONNECT ? 2 : 1) &&
+          s.op[0].calls == 1 && s.op[1].calls == 1 &&
+          s.op[0].is_null == (mode == READ_ERROR_RECONNECT) &&
+          s.op[0].raw_status == (mode == READ_ERROR_RECONNECT ? 0 : 503) &&
+          !s.op[1].is_null && s.op[1].raw_status == 200 &&
+          s.op[0].saw_next_native_stage &&
+          (mode != READ_ERROR_RECONNECT || s.rst_requested),
+          "actual parser/queue/reconnect identity observations incomplete");
+cleanup:
+  if (s.deadline) event_free(s.deadline);
+  if (s.native) {
+    /* Failure cleanup is still actual destructor; suppress test close assertion. */
+    evrtsp_connection_set_closecb(s.native, NULL, NULL);
+    evrtsp_connection_free(s.native);
+  }
+  for (i = 0; i < 2; i++)
+    if (s.peers[i].bev) bufferevent_free(s.peers[i].bev);
+  if (s.listener) evconnlistener_free(s.listener);
+  if (s.base) event_base_free(s.base);
+  if (!s.failed && mode == GRACEFUL_EOF_NO_ACK)
+    printf("{\"facet\":\"evrtsp-only\",\"case\":3,"
+           "\"status\":\"BASELINE_OBSERVED\","
+           "\"observation\":\"GRACEFUL_EOF_NO_ACK\","
+           "\"peer_requests\":%d,\"peer_incarnations\":%d,"
+           "\"callbacks_A\":%d,\"callbacks_B\":%d,"
+           "\"raw_A\":%d,\"A_null\":%d,\"A_response_headers_empty\":%d,"
+           "\"B_staged_WRITING\":%d,\"same_native_fd_at_A\":%d,"
+           "\"B_outcome\":\"UNOBSERVED\"}\n",
+           s.request_count, s.accept_count, s.op[0].calls, s.op[1].calls,
+           s.op[0].raw_status, s.op[0].is_null, s.eof_no_headers,
+           s.op[0].saw_next_native_stage, s.eof_same_fd);
+  else if (!s.failed)
+    printf("{\"facet\":\"evrtsp-only\",\"case\":%d,\"status\":\"BASELINE_OBSERVED\","
+           "\"peer_requests\":%d,\"peer_incarnations\":%d,"
+           "\"callbacks_A\":%d,\"callbacks_B\":%d,"
+           "\"raw_A\":%d,\"raw_B\":%d,\"A_null\":%d,"
+           "\"queued_before_free\":%d,\"close_callbacks\":%d}\n",
+           mode, s.request_count, s.accept_count, s.op[0].calls, s.op[1].calls,
+           s.op[0].raw_status, s.op[1].raw_status, s.op[0].is_null,
+           s.queued_before_free, s.close_calls);
+  return s.failed ? 1 : 0;
+}
+int main(void)
+{
+  /* Separate case owners: no sleeps, device/provider or production state. */
+  if (run_case(RAW_NEGATIVE)) return EXIT_FAILURE;
+  if (run_case(READ_ERROR_RECONNECT)) return EXIT_FAILURE;
+  if (run_case(QUEUED_FREE)) return EXIT_FAILURE;
+  if (run_case(GRACEFUL_EOF_NO_ACK)) return EXIT_FAILURE;
+  return EXIT_SUCCESS;
+}
