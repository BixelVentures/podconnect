+static bool
+attention_identity_equal(const struct output_attention_state *a, const struct output_attention_state *b)
+{
+  return memcmp(a->process, b->process, sizeof(a->process)) == 0
+    && a->device_id == b->device_id
+    && a->device_incarnation == b->device_incarnation
+    && a->session_epoch == b->session_epoch
+    && a->base_revision == b->base_revision
+    && a->attention_revision == b->attention_revision
+    && a->route_revision == b->route_revision
+    && a->lease == b->lease
+    && a->base_volume == b->base_volume
+    && a->effective_volume == b->effective_volume
