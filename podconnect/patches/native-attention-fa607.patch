 };
 
 /**
@@ -167,6 +171,13 @@
     struct evrtsp_request *req,
     enum evrtsp_cmd_type type, const char *uri);
 
+/* Strict producer variant: negative return leaves this request caller-owned.
+ * A nonnegative return transfers ownership even when dispatch is vetoed; that
+ * veto invokes the registered callback with NULL and frees the request. */
+int evrtsp_make_request_guarded(struct evrtsp_connection *evcon,
+    struct evrtsp_request *req, enum evrtsp_cmd_type type, const char *uri,
+    int (*dispatch_current)(void *), void *arg);
+
