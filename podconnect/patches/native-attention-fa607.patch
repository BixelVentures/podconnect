+void
+outputs_attention_complete(const struct output_attention_result *operation, enum output_attention_outcome outcome, int response_code, int cseq)
+{
+  struct output_attention_result *retained;
+  struct output_attention_state current;
+  struct output_device *device;
+  struct output_attention_result original;
+
+  if (!operation || outcome == OUTPUT_ATTENTION_PENDING)
+    return;
+  original = *operation;
+  operation = &original;
+  retained = attention_result_find(operation->identity.process, operation->operation);
+  if (!retained || retained->outcome != OUTPUT_ATTENTION_PENDING
+      || !attention_identity_equal(&retained->identity, &operation->identity))
+    return;
+  // One exact operation has one terminal outcome. No last-callback-wins fold.
+  retained->outcome = outcome;
+  retained->response_code = response_code;
+  retained->request_cseq = cseq;
+  device = outputs_device_get(operation->identity.device_id);
+  if (!device || device->incarnation != operation->identity.device_incarnation)
+    return;
+  if (operation->action == OUTPUT_ATTENTION_RELEASE
+      && (outcome == OUTPUT_ATTENTION_PROTOCOL_ACCEPTED || outcome == OUTPUT_ATTENTION_DESIRED_ONLY)
+      && outputs_attention_state_get(device->id, &current) == 0
+      && attention_identity_equal(&current, &operation->identity))
+    {
+      device->attention_lease = 0;
+      device->attention_restoring = false;
+      device->attention_expired = false;
+      event_del(device->attention_timer);
+      if (!device->selected && device->session)
+        {
+          // Restoration no longer needs retained A. Re-enter the original
+          // backend STOP/TEARDOWN owner; no shared B stop or invented deadline.
+          outputs_device_stop(device, NULL);
+          return; // STOP may retire the session; no further retained-session work.
+        }
+    }
+  // A pending duck may settle after its native deadline. Reconcile that exact
+  // still-owned lease once; no periodic volume retry or new lease adoption.
+  if (device->attention_lease && !device->selected && !device->route_operation)
+    attention_route_suspend(device);
+  if (device->selected && device->session_epoch == operation->identity.session_epoch
+      && outputs[device->type]->device_attention_resume)
+    outputs[device->type]->device_attention_resume(device);
+  if (device->attention_expired && !device->attention_expiry_attempted)
+    attention_expiry_reconcile(device);
+}
+
+int
+outputs_attention_admit(const struct output_attention_request *request, struct output_attention_result *result)
+{
+  struct output_device *device;
+  struct output_attention_state state;
+  struct timespec deadline;
+  struct timeval timeout;
+  struct output_attention_result admitted;
+  struct output_attention_result *slot = NULL;
+  int i;
+  int ret;
+
+  if (!request || !result)
+    return -1;
+  if (request->request_id[0])
+    {
+      // A lost HTTP response is resolved by this exact retained command, never
+      // by adopting whichever lease a later GET happens to observe.
+      for (i = 0; i < ARRAY_SIZE(attention_results); i++)
+        if (attention_results[i].operation
+            && memcmp(attention_results[i].command.request_id, request->request_id, sizeof(request->request_id)) == 0)
+          {
+            const struct output_attention_request *old = &attention_results[i].command;
+            if (old->action != request->action || old->cap_volume != request->cap_volume
+                || old->ttl_ms != request->ttl_ms || !attention_identity_equal(&old->expected, &request->expected))
+              return -1;
+            return outputs_attention_result_get(attention_results[i].identity.process, attention_results[i].operation, result);
+          }
+    }
+  if (!request || !result || outputs_operation == UINT64_MAX
+      || request->action < OUTPUT_ATTENTION_BEGIN || request->action > OUTPUT_ATTENTION_MANUAL
+      || request->action == OUTPUT_ATTENTION_FLUSH
+      || (request->action == OUTPUT_ATTENTION_MANUAL && request->ttl_ms != 0)
+      || request->cap_volume < 0 || request->cap_volume > 100
+      || request->ttl_ms > 15000
+      || outputs_attention_state_get(request->expected.device_id, &state) < 0
+      || !attention_identity_equal(&request->expected, &state))
+    return -1;
+  device = outputs_device_get(state.device_id);
+  if (device->base_revision == UINT64_MAX
+      || (request->action == OUTPUT_ATTENTION_MANUAL && device->base_revision >= UINT64_MAX - 1)
+      || device->attention_revision >= UINT64_MAX - 1
+      || outputs[device->type]->disabled || !outputs[device->type]->device_attention_set
+      || (request->action != OUTPUT_ATTENTION_MANUAL
+          && (request->action == OUTPUT_ATTENTION_BEGIN ? device->attention_lease != 0 : device->attention_lease == 0))
+      || (request->action == OUTPUT_ATTENTION_UPDATE && device->attention_restoring))
+    return -1;
+  for (i = 0; i < ARRAY_SIZE(attention_results); i++)
+    {
+      if (attention_results[i].operation && attention_results[i].outcome == OUTPUT_ATTENTION_PENDING)
+        {
+          if (attention_results[i].identity.device_id == device->id
+              && attention_results[i].identity.device_incarnation == device->incarnation)
+            return -1; // Do not issue a second strict write while outcome is unresolved.
+        }
+      else if (!attention_result_reserved[i] && (!slot || attention_results[i].operation < slot->operation))
+        slot = &attention_results[i];
+    }
+  if (!slot)
+    return -1;
+
+  if (request->action == OUTPUT_ATTENTION_BEGIN || request->action == OUTPUT_ATTENTION_UPDATE)
+    {
+      unsigned ttl_ms = request->ttl_ms ? request->ttl_ms : 2000;
+      if (!device->attention_timer || clock_gettime(CLOCK_MONOTONIC, &deadline) < 0)
+        return -1;
+      deadline.tv_sec += ttl_ms / 1000;
+      deadline.tv_nsec += (ttl_ms % 1000) * 1000000L;
+      if (deadline.tv_nsec >= 1000000000L)
+        { deadline.tv_sec++; deadline.tv_nsec -= 1000000000L; }
+      timeout.tv_sec = ttl_ms / 1000;
+      timeout.tv_usec = (ttl_ms % 1000) * 1000;
+      if (event_add(device->attention_timer, &timeout) < 0)
+        return -1;
+    }
+  if (request->action != OUTPUT_ATTENTION_MANUAL)
+    device->attention_revision++;
+  if (request->action == OUTPUT_ATTENTION_MANUAL)
+    outputs_device_volume_register(device, request->cap_volume, -1);
+  if (request->action == OUTPUT_ATTENTION_BEGIN)
+    device->attention_lease = outputs_operation + 1;
+  if (request->action == OUTPUT_ATTENTION_RELEASE)
+    {
+      // Retain original restoration authority on failed/unknown native replies.
+      device->attention_restoring = true;
+      event_del(device->attention_timer);
+    }
+  else if (request->action != OUTPUT_ATTENTION_MANUAL)
+    {
+      device->attention_cap = request->cap_volume;
+      device->attention_expired = false;
+      device->attention_expiry_attempted = false;
+      device->attention_deadline = deadline;
+    }
+
+  memset(slot, 0, sizeof(*slot));
+  slot->operation = ++outputs_operation;
+  slot->action = request->action;
+  slot->command = *request;
+  slot->outcome = OUTPUT_ATTENTION_PENDING;
+  if (request->action == OUTPUT_ATTENTION_RELEASE) device->attention_last_release_operation = slot->operation;
+  outputs_attention_state_get(device->id, &slot->identity);
+  admitted = *slot;
+  attention_result_reserved[slot - attention_results] = true;
+  ret = outputs[device->type]->device_attention_set(device, &admitted);
+  if (ret == 0)
+    outputs_attention_complete(&admitted, OUTPUT_ATTENTION_DESIRED_ONLY, 0, 0);
+  else if (ret < 0)
+    outputs_attention_complete(&admitted, OUTPUT_ATTENTION_FAILED, 0, 0);
+  attention_result_reserved[slot - attention_results] = false;
+  return outputs_attention_result_get(admitted.identity.process, admitted.operation, result);
+}
+
+void
+outputs_attention_route_barrier(struct output_device *device)
+{
+  struct output_attention_result *slot = NULL;
+  int i, ret;
+
+  if (device->route_operation
+      || outputs_operation == UINT64_MAX || !outputs[device->type]->device_attention_suspend)
+    return;
+  for (i = 0; i < ARRAY_SIZE(attention_results); i++)
+    {
+      if (attention_results[i].operation && attention_results[i].outcome == OUTPUT_ATTENTION_PENDING)
+        {
+          if (attention_results[i].identity.device_id == device->id
+              && attention_results[i].identity.device_incarnation == device->incarnation)
+            return;
+        }
+      else if (!attention_result_reserved[i] && (!slot || attention_results[i].operation < slot->operation))
+        slot = &attention_results[i];
+    }
+  if (!slot || outputs_attention_state_get(device->id, &slot->identity) < 0)
+    return;
+  memset(slot, 0, sizeof(*slot));
+  slot->operation = ++outputs_operation;
+  slot->action = OUTPUT_ATTENTION_FLUSH;
+  slot->outcome = OUTPUT_ATTENTION_PENDING;
+  outputs_attention_state_get(device->id, &slot->identity);
+  device->route_operation = slot->operation;
+  attention_result_reserved[slot - attention_results] = true;
+  ret = outputs[device->type]->device_attention_suspend(device, slot);
+  if (ret == 0)
+    outputs_attention_complete(slot, OUTPUT_ATTENTION_DESIRED_ONLY, 0, 0);
+  else if (ret < 0)
+    outputs_attention_complete(slot, OUTPUT_ATTENTION_FAILED, 0, 0);
+  attention_result_reserved[slot - attention_results] = false;
+}
+
+static void
+attention_route_suspend(struct output_device *device)
+{
+  if (device->attention_lease && !device->selected)
+    outputs_attention_route_barrier(device);
+}
+
+static void
+attention_expiry_reconcile(struct output_device *device)
+{
+  struct output_attention_request request = { 0 };
+  struct output_attention_result result;
+  int i;
+
+  if (!device->attention_lease || !device->attention_expired || device->attention_expiry_attempted)
+    return;
+  for (i = 0; i < ARRAY_SIZE(attention_results); i++)
+    if (attention_results[i].outcome == OUTPUT_ATTENTION_PENDING
+        && attention_results[i].operation && attention_results[i].identity.device_id == device->id
+        && attention_results[i].identity.device_incarnation == device->incarnation)
+      return;
+  if (outputs_attention_state_get(device->id, &request.expected) < 0)
+    return;
+  request.action = OUTPUT_ATTENTION_RELEASE;
+  // Set before admission: an immediate desired-only completion cannot recurse.
+  device->attention_expiry_attempted = true;
+  if (outputs_attention_admit(&request, &result) < 0)
+    device->attention_expiry_attempted = false;
+}
+
+static void
+attention_timer_cb(int fd, short what, void *arg)
+{
+  struct output_device *device = arg;
+  struct timespec now;
+  struct timeval remaining;
+  int64_t ns;
+
+  if (!device->attention_lease || device->attention_restoring)
+    return;
+  if (clock_gettime(CLOCK_MONOTONIC, &now) < 0)
+    return; // No guessed deadline or volume write on a failed clock.
+  ns = (int64_t)(device->attention_deadline.tv_sec - now.tv_sec) * 1000000000L
+    + device->attention_deadline.tv_nsec - now.tv_nsec;
+  if (ns > 0)
+    {
+      // A superseded timer cannot expire a refreshed/new lease early.
+      remaining.tv_sec = ns / 1000000000L;
+      remaining.tv_usec = (ns % 1000000000L + 999) / 1000;
+      if (remaining.tv_usec >= 1000000) { remaining.tv_sec++; remaining.tv_usec -= 1000000; }
+      event_add(device->attention_timer, &remaining);
+      return;
+    }
+  device->attention_restoring = true;
+  device->attention_expired = true;
+  if (device->attention_revision != UINT64_MAX)
+    device->attention_revision++;
+  attention_expiry_reconcile(device);
+}
