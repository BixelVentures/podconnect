+int
+outputs_attention_request_get(const char *process, uint64_t device_id, const char *request_id, struct output_attention_result *result)
+{
+  int i;
+  if (!process || !request_id || strlen(request_id) != 36 || !result)
+    return -1;
+  for (i = 0; i < ARRAY_SIZE(attention_results); i++)
+    if (attention_results[i].operation && attention_results[i].identity.device_id == device_id
+        && strncmp(attention_results[i].identity.process, process, sizeof(outputs_process)) == 0
+        && strcmp(attention_results[i].command.request_id, request_id) == 0)
+      return outputs_attention_result_get(process, attention_results[i].operation, result);
+  if (db_attention_receipt_get(process, device_id, request_id, result) != 0) return -1;
+  {
+    struct output_attention_state state;
+    result->current = outputs_attention_state_get(device_id,&state) == 0;
+    if (result->current && result->action == OUTPUT_ATTENTION_RELEASE
+        && result->outcome == OUTPUT_ATTENTION_PROTOCOL_ACCEPTED && state.lease == 0
+        && state.attention_revision == result->identity.attention_revision)
+      { state.lease=result->identity.lease; state.restoring=result->identity.restoring; }
+    result->current = result->current && (attention_identity_equal(&result->identity,&state)
+      || ((result->recovery_state == OUTPUT_RECOVERY_RESTORED || (result->action == OUTPUT_ATTENTION_RELEASE && result->outcome == OUTPUT_ATTENTION_PROTOCOL_ACCEPTED))
+          && attention_recovery_terminal_current(result,&state)));
+  }
+  return 0;
+}
