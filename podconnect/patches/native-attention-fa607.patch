+static void
+attention_request_remove(struct airplay_attention_request *context)
+{
+  struct airplay_attention_request **link = &context->session->attention_requests;
+
+  while (*link && *link != context)
+    link = &(*link)->next;
+  if (*link)
+    *link = context->next;
