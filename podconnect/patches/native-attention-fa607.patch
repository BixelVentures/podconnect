diff --git a/src/evrtsp/evrtsp.h b/src/evrtsp/evrtsp.h
--- a/src/evrtsp/evrtsp.h
+++ b/src/evrtsp/evrtsp.h
@@ -108,6 +108,10 @@
 	/* Callback */
 	void (*cb)(struct evrtsp_request *, void *);
