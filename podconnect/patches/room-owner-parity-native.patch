+	if request.OptionsRoute.InputPathDigest != hex.EncodeToString(digest[:]) {
+		return ErrAliasConflict
+	}
+	before := proto.Clone(p.state.player.Options).(*connectpb.ContextPlayerOptions)
+	after := proto.Clone(before).(*connectpb.ContextPlayerOptions)
+	if request.Action == "shuffle" {
+		after.ShufflingContext = *request.ShuffleEnabled
+	} else {
+		after.RepeatingContext = request.RepeatMode != "off"
+		after.RepeatingTrack = request.RepeatMode == "track"
+	}
+	if !p.optionsAllowed(before, after) {
+		return ErrAliasConflict
+	}
