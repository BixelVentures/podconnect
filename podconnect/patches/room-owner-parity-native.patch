+package daemon
+
+// Options mutate the retained actor/list only. They never invoke a player
+// Pause/Resume, route selection, C transport mutation or a new decoder.
+import (
+	"context"
+	"crypto/sha256"
+	"encoding/hex"
+	"net/http"
+	"strings"
+
+	connectpb "github.com/devgianlu/go-librespot/proto/spotify/connectstate"
+	"google.golang.org/protobuf/proto"
+)
+
+const apiRoomOptionsCurrent ApiRequestType = "room_options_current"
+
+func optionAction(action string) bool { return action == "shuffle" || action == "repeat" }
+func validOptionArguments(action string, shuffle *bool, repeat string) bool {
+	if action == "shuffle" {
+		return shuffle != nil && repeat == ""
+	}
+	if action == "repeat" {
+		return shuffle == nil && (repeat == "off" || repeat == "context" || repeat == "track")
+	}
+	return shuffle == nil && repeat == ""
+}
+func (p *AppPlayer) optionsAllowed(before, after *connectpb.ContextPlayerOptions) bool {
+	if before == nil || after == nil || p.state == nil || p.state.player == nil {
+		return false
+	}
+	for _, r := range []*connectpb.Restrictions{p.state.player.Restrictions, p.state.player.ContextRestrictions} {
+		if r == nil {
+			continue
+		}
+		if before.ShufflingContext != after.ShufflingContext && len(r.DisallowTogglingShuffleReasons) > 0 || before.RepeatingContext != after.RepeatingContext && len(r.DisallowTogglingRepeatContextReasons) > 0 || before.RepeatingTrack != after.RepeatingTrack && len(r.DisallowTogglingRepeatTrackReasons) > 0 {
+			return false
+		}
+	}
+	return true
+}
+func (p *AppPlayer) prepareRoomOptions(ctx context.Context, offer *nativeTransportOffer, request *roomTransportPrepareRequest) error {
+	if !offer.Bound || request.OptionsRoute == nil || !request.OptionsRoute.valid() || request.OptionsRoute.DeviceID != request.HomePodID || p.state.player.Options == nil || !validOptionArguments(request.Action, request.ShuffleEnabled, request.RepeatMode) {
+		return ErrBadRequest
+	}
