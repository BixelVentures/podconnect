+	offer.PreparedState = proto.Clone(p.state.player).(*connectpb.PlayerState)
+	if staged != p.state.tracks {
+		offer.PreparedState.Track = staged.CurrentTrack()
+		offer.PreparedState.PrevTracks = staged.PrevTracks()
+		offer.PreparedState.NextTracks = staged.NextTracks(ctx, nil)
+		offer.PreparedState.Index = staged.Index()
+	}
