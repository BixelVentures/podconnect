 }
+
+// PrepareShuffle isolates fetch/shuffle failures from the retained cursor/queue.
+func (tl *List) PrepareShuffle(ctx context.Context, enabled bool) (*List, error) {
+	clone, err := tl.cloneForPreparation()
+	if err != nil {
+		return nil, err
+	}
+	if err = clone.ToggleShuffle(ctx, enabled); err != nil {
+		return nil, err
+	}
+	if ctx.Err() != nil {
+		return nil, ctx.Err()
+	}
+	return clone, nil
+}
