+}
+func (p *AppPlayer) optionsCaptured(offer *nativeTransportOffer) bool {
+	return !optionAction(offer.Snapshot.Action) || offer.OptionsBefore != nil && offer.OptionsAfter != nil && p.primaryStream.Source == offer.SeekSource && p.state.player.IsPaused == offer.OptionsPaused && proto.Equal(p.state.player.Options, offer.OptionsBefore) && p.optionsAllowed(offer.OptionsBefore, offer.OptionsAfter)
+}
+func (p *AppPlayer) effectRoomOptions(parent context.Context, request roomTransportEffectRequest) (any, error) {
+	offer := request.Offer
+	p.aliasMu.Lock()
+	if !p.transportOfferCurrentLocked(offer, parent, request.Context) || !p.optionsCaptured(offer) {
+		p.aliasMu.Unlock()
+		return nil, ErrAliasConflict
+	}
+	p.state.player.Options = offer.OptionsAfter
+	if offer.PreparedTracks != offer.Tracks {
+		p.state.tracks = offer.PreparedTracks
+		p.state.player.Track = offer.PreparedState.Track
+		p.state.player.PrevTracks = offer.PreparedState.PrevTracks
+		p.state.player.NextTracks = offer.PreparedState.NextTracks
+		p.state.player.Index = offer.PreparedState.Index
+	}
