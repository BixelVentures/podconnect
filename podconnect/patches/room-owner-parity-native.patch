+	}
+	return nil
+}
+func (p *AppPlayer) publishOptions(ctx context.Context, before, after *connectpb.ContextPlayerOptions) {
+	if before.RepeatingContext != after.RepeatingContext {
+		p.app.server.Emit(&ApiEvent{Type: ApiEventTypeRepeatContext, Data: ApiEventDataRepeatContext{Value: after.RepeatingContext}})
+	}
+	if before.RepeatingTrack != after.RepeatingTrack {
+		p.app.server.Emit(&ApiEvent{Type: ApiEventTypeRepeatTrack, Data: ApiEventDataRepeatTrack{Value: after.RepeatingTrack}})
+	}
+	if before.ShufflingContext != after.ShufflingContext {
+		p.app.server.Emit(&ApiEvent{Type: ApiEventTypeShuffleContext, Data: ApiEventDataShuffleContext{Value: after.ShufflingContext}})
+	}
+	if !proto.Equal(before, after) {
+		p.invalidateRoomTransportGeneration()
+		p.updateState(ctx)
+		p.schedulePrefetchNext()
+	}
+}
+
+// Rejoin the completed options effect to the exact actor after the final C read.
+// Only this final private rejoin publishes the exact settlement witness; it
+// never reapplies the option or requests a C mutation.
+func (p *AppPlayer) optionsEffectCurrent(ctx context.Context, offer *nativeTransportOffer) (any, error) {
+	if offer == nil || !offer.Published || !optionAction(offer.Snapshot.Action) {
+		return nil, ErrAliasConflict
+	}
+	expected := *offer
+	expected.Tracks = offer.PreparedTracks
+	expected.QueueRevision = offer.PreparedTracks.TransportRevision()
+	expected.OptionsBefore = offer.OptionsAfter
+	if !proto.Equal(offer.OptionsBefore, offer.OptionsAfter) {
+		expected.Generation++
+	}
+	p.aliasMu.Lock()
+	defer p.aliasMu.Unlock()
+	if !p.transportOfferCurrentLocked(&expected, ctx, ctx) {
+		return nil, ErrAliasConflict
+	}
+	p.recordRoomEffectLocked(offer)
+	return true, nil
+}
