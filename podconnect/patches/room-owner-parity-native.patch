+	if before.ShufflingContext != after.ShufflingContext {
+		var err error
+		staged, err = staged.PrepareShuffle(ctx, after.ShufflingContext)
+		if err != nil {
+			return err
+		}
+	}
+	if ctx.Err() != nil {
+		return ctx.Err()
+	}
+	offer.OptionsBefore, offer.OptionsAfter = before, after
+	offer.OptionsPaused = p.state.player.IsPaused
+	offer.SeekSource = p.primaryStream.Source
