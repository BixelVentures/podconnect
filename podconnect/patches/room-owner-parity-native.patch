+// WithGuardedSourceChange retains the existing control/output lock order, but
+// lets the owner reject before discarding the current unwritten PCM suffix.
+func (out *pipeOutput) WithGuardedSourceChange(ctx context.Context, apply func(MovePipeIdentity, bool, func()) error) (err error) {
+	if err = LockTransport(ctx, &out.control); err != nil {
+		return err
+	}
+	out.controlPending.Store(true)
+	if !out.fileClosed {
+		if err = out.file.SetWriteDeadline(time.Now()); err != nil && !errors.Is(err, os.ErrClosed) {
+			out.controlPending.Store(false)
+			out.control.Unlock()
+			return err
+		}
+	}
+	if !out.lock.TryLock() {
+		acquired := make(chan struct{})
+		go func() {
+			out.lock.Lock()
+			select {
+			case acquired <- struct{}{}:
+			case <-ctx.Done():
+				_ = out.unlockControl()
+			}
+		}()
+		select {
+		case <-acquired:
+		case <-ctx.Done():
+			return ctx.Err()
+		}
+	}
+	defer func() { err = errors.Join(err, out.unlockControl()) }()
+	if err = ctx.Err(); err != nil {
+		return err
+	}
+	if out.closed || out.fileClosed || out.startFenced.Load() {
+		return fmt.Errorf("seek pipe unavailable")
+	}
+	info, err := out.file.Stat()
+	if err != nil {
+		return err
+	}
+	stat, ok := info.Sys().(*syscall.Stat_t)
+	if !ok || info.Mode()&os.ModeNamedPipe == 0 {
+		return fmt.Errorf("seek writer not FIFO")
+	}
+	actual := MovePipeIdentity{PipeIdentity: PipeIdentity{strconv.FormatUint(uint64(stat.Dev), 10), strconv.FormatUint(uint64(stat.Ino), 10), "fifo"}, FD: strconv.FormatUint(uint64(out.file.Fd()), 10)}
+	if actual != out.openedWriter {
+		return fmt.Errorf("seek writer changed")
+	}
+	return apply(actual, out.paused, func() { out.pendingPCM = nil; out.pendingErr = nil })
+}
