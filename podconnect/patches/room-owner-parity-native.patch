+		Schema    string `json:"schema"`
+		Accepted  bool   `json:"accepted_native"`
+		PrepareID string `json:"prepare_id"`
+		Physical  bool   `json:"physical_result_verified"`
+	}{boundSchema("podconnect.native_room_transport_commit.v1", offer.Bound), true, offer.Snapshot.PrepareID, false}, nil
+}
+func verifyOptionsRoute(ctx context.Context, offer *nativeTransportOffer) error {
+	if !offer.Bound || offer.OptionsRoute == nil {
+		return ErrAliasConflict
+	}
+	endpoint := strings.TrimSuffix(offer.OwnToneURL, "/") + "/api/outputs/" + offer.Snapshot.HomePodID + "/transport/bound-state"
+	var state directPauseOutputState
+	if err := roomVolumeHTTP(ctx, http.MethodPost, endpoint, struct {
+		Owner roomTransportIdentity `json:"native_owner"`
+	}{offer.Snapshot.roomTransportIdentity}, &state); err != nil {
+		return err
+	}
