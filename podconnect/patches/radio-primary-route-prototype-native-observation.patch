+package daemon
+
+import (
+	"context"
+	"strconv"
+	"strings"
+	"time"
+)
+
+const (
+	apiRadioPrimaryActorState ApiRequestType = "radio_primary_actor_state"
+	cPrimaryOwnerSchema                      = "podconnect.output_primary_radio_owner_observation.v1"
+)
+
+type radioPrimaryOwnerRequest struct {
+	Schema  string                 `json:"schema"`
+	Source  string                 `json:"source_kind"`
+	Owner   *roomTransportIdentity `json:"native_owner,omitempty"`
+	Writer  *queueWriterWire       `json:"writer_proof,omitempty"`
+	Absence *radioAbsenceSource    `json:"source_absence,omitempty"`
+}
+
+type radioPrimaryOwnerReceipt struct {
+	radioPrimaryOwnerRequest
+	Output   *roomVolumeRoute    `json:"output_identity,omitempty"`
+	Target   *radioPrimaryTarget `json:"target_identity,omitempty"`
+	Physical *bool               `json:"physical_result_verified"`
+}
+
+type radioPrimaryActorStateRequest struct {
+	State     radioPrimaryReadinessState
+	CProcess  string
+	Receivers map[string]string
+}
+
+func (app *App) primaryRadioActorAsk(ctx context.Context, kind ApiRequestType, call any) (any, error) {
+	app.ownerMu.Lock()
+	ch, done := app.currentAPI, app.currentDone
+	app.ownerMu.Unlock()
+	if ch == nil || done == nil {
+		return nil, ErrAliasConflict
+	}
+	request, wait := NewApiRequest(kind, call)
+	select {
+	case ch <- request:
+		return wait(ctx)
+	case <-done:
+		return nil, ErrAliasConflict
+	case <-ctx.Done():
+		return nil, ctx.Err()
+	}
+}
+
+func (p *AppPlayer) primaryRadioReadOwner(ctx context.Context, device string, query radioPrimaryOwnerRequest) (radioPrimaryOwnerReceipt, error) {
+	var ack radioPrimaryOwnerReceipt
+	endpoint := strings.TrimSuffix(p.app.cfg.RoomTransportOwnToneURL, "/") + "/api/outputs/" + device + "/radio-handoff/primary-owner"
+	if err := radioAuthenticatedHTTP(ctx, endpoint, p.app.cfg.RadioHandoffControlToken, query, &ack); err != nil {
+		return ack, err
+	}
+	if ack.Schema != query.Schema || ack.Source != query.Source || ack.Physical == nil || *ack.Physical {
+		return ack, ErrAliasConflict
+	}
+	switch query.Source {
+	case "spotify":
+		if ack.Owner == nil || ack.Writer == nil || ack.Absence != nil || ack.Target != nil || ack.Output == nil ||
+			!ack.Output.valid() || ack.Output.DeviceID != device || *ack.Owner != *query.Owner || *ack.Writer != *query.Writer ||
+			ack.Output.InputPathDigest != query.Writer.InputDigest {
+			return ack, ErrAliasConflict
+		}
+	case "none":
+		if ack.Owner != nil || ack.Writer != nil || ack.Absence == nil || ack.Absence.Live != nil || ack.Output != nil ||
+			ack.Target == nil || !ack.Target.valid() || ack.Target.Device != device || *ack.Absence != *query.Absence {
+			return ack, ErrAliasConflict
+		}
+	default:
+		return ack, ErrAliasConflict
+	}
+	return ack, nil
+}
+
+// The same Native actor owns source observation and effects. No persisted hold
+// becomes a new authority after restart, and a paused writer remains Spotify.
+func (p *AppPlayer) radioPrimaryActorState(ctx context.Context, request radioPrimaryActorStateRequest) (any, error) {
+	app, state := p.app, request.State
+	if ctx.Err() != nil || p.state == nil || p.state.player == nil || app.manualReleasePending() {
+		return nil, ErrAliasConflict
+	}
+	app.radio.mu.Lock()
+	generation := app.radio.Generation
+	if app.radio.failed || state.Revision != strconv.FormatUint(app.radio.Intent, 10) {
+		app.radio.mu.Unlock()
+		return nil, ErrAliasConflict
+	}
+	var held *radioHold
+	var releaseBinding *radioPrimaryBinding
+	var releaseAction string
+	var releaseCSeq int
+	var releaseGeneration uint64
+	for _, h := range app.radio.Holds {
+		if primaryRadioReleased(h) {
+			if h.Request.ProcessID != state.Process {
+				continue
+			}
+			candidateGeneration, _ := strconv.ParseUint(h.Request.Generation, 10, 64)
+			if candidateGeneration > releaseGeneration {
+				releaseGeneration = candidateGeneration
+				binding := *h.Primary
+				releaseBinding, releaseCSeq = &binding, h.PrimaryPending.Released
+				releaseAction = h.PrimaryAction
+				if releaseAction == "" && h.PrimaryPending.Stopped != nil {
+					releaseAction = h.PrimaryPending.Stopped.Action
+				}
+			}
+			continue
+		}
+		if primaryRadioRetired(h) {
+			continue
+		}
+		if h == nil || h.owner != p || h.PrimaryStatus == nil || h.Primary == nil || h.Phase != "primary_active" || held != nil {
+			app.radio.mu.Unlock()
+			return nil, ErrAliasConflict
+		}
+		held = h
+	}
+	app.radio.mu.Unlock()
+
+	source, playbackState, sourceRoom := "none", "idle", ""
+	var session *radioPrimaryBinding
+	if held != nil {
+		proof := held.PrimaryStatus
+		query := proof.Request
+		query.Phase = "readiness"
+		ack, err := p.primaryRadioCStart(ctx, query, proof.SameTarget)
+		if err != nil || ack.Phase != "playing" || ack.Session == nil || *ack.Session != *held.Primary ||
+			ack.Session.Process != request.CProcess || request.Receivers[ack.Session.DeviceID] != ack.Session.Incarnation {
+			return nil, ErrAliasConflict
+		}
+		source, playbackState, sourceRoom, session = "radio", "playing", held.Request.TargetID, ack.Session
+		generation, _ = strconv.ParseUint(proof.OwnerGeneration, 10, 64)
+	} else if p.primaryStream != nil {
+		owner, err := p.radioSourceOwner()
+		if err != nil {
+			return nil, err
+		}
+		writer, err := p.captureQueueWriter(ctx, owner, nil)
+		if err != nil {
+			return nil, err
+		}
+		ack, err := p.primaryRadioReadOwner(ctx, owner.HomePodID, radioPrimaryOwnerRequest{
+			Schema: cPrimaryOwnerSchema, Source: "spotify", Owner: &owner, Writer: &writer.Wire,
+		})
+		if err != nil || ack.Output.Process != request.CProcess || request.Receivers[ack.Output.DeviceID] != ack.Output.DeviceIncarnation {
+			return nil, ErrAliasConflict
+		}
+		source, playbackState, sourceRoom = "spotify", "playing", owner.RoomID
+		if p.state.player.IsPaused {
+			playbackState = "stopped"
+		}
+	} else {
+		proof, err := app.radioAbsenceSource()
+		if err != nil {
+			return nil, err
+		}
+		valid := false
+		for _, target := range state.Targets {
+			if request.Receivers[target.HomePodID] == "" {
+				continue
+			}
+			ack, err := p.primaryRadioReadOwner(ctx, target.HomePodID, radioPrimaryOwnerRequest{Schema: cPrimaryOwnerSchema, Source: "none", Absence: &proof})
+			if err == nil && ack.Target.Process == request.CProcess && request.Receivers[target.HomePodID] == ack.Target.Incarnation {
+				valid = true
+				break
+			}
+		}
+		if !valid {
+			return nil, ErrAliasConflict
+		}
+	}
+	for i, target := range state.Targets {
+		incarnation := request.Receivers[target.HomePodID]
+		if incarnation == "" || p.primaryRadioRoom(target.ID) != target.HomePodID {
+			continue
+		}
+		query := radioPrimaryStartWire{Schema: cPrimaryStartSchema, Phase: "target", radioPrimaryTarget: radioPrimaryTarget{Device: target.HomePodID}}
+		if session != nil {
+			query.Phase, query.Predecessor = "preflight_replace_target", session
+		} else if source == "spotify" && target.ID == sourceRoom {
+			query.Phase = "preflight_target"
+		}
+		ack, err := p.primaryRadioCStart(ctx, query, false)
+		if err == nil && ack.Process == request.CProcess && ack.Incarnation == incarnation {
+			state.Targets[i].Availability, state.Targets[i].Selectable = "available", true
+		}
+	}
+	if ctx.Err() != nil {
+		return nil, ctx.Err()
+	}
+	app.radio.mu.Lock()
+	stable := !app.radio.failed && state.Revision == strconv.FormatUint(app.radio.Intent, 10) &&
+		(held == nil || app.radio.Holds[sourceRoom] == held && held.Phase == "primary_active" && held.Primary != nil && *held.Primary == *session)
+	app.radio.mu.Unlock()
+	if !stable {
+		return nil, ErrAliasConflict
+	}
+	now := time.Now().Unix()
+	state.Session = session
+	state.Observation = &radioPrimaryObservation{State: playbackState, Source: source, Target: sourceRoom, OwnerGeneration: generation, ObservedAt: now, ValidUntil: now + 3}
+	if held != nil {
+		state.Observation.Station = held.PrimaryStatus.Request.Station
+	}
+	if releaseBinding != nil && source != "radio" && volumeUUID.MatchString(releaseAction) && releaseCSeq > 0 {
+		state.ReleasedSession, state.ReleaseActionID, state.TeardownCSeq = releaseBinding, &releaseAction, &releaseCSeq
+	}
+	return state, nil
+}
