+type roomTransportPauseConfirmation struct {
+	Schema          string `json:"schema"`
+	OK              bool   `json:"ok"`
+	Token           string `json:"token"`
+	NativePrepareID string `json:"native_prepare_id"`
+	NativeRevision  string `json:"native_revision"`
+	Physical        *bool  `json:"physical_result_verified"`
+}
+
+func confirmBoundPause(ctx context.Context, client *http.Client, offer *nativeTransportOffer, token string) error {
+	confirmation := struct {
+		Token           string `json:"token"`
+		NativePrepareID string `json:"native_prepare_id"`
+		NativeRevision  string `json:"native_revision"`
+	}{token, offer.Snapshot.PrepareID, offer.NativeRevision}
+	body, _ := json.Marshal(confirmation)
+	endpoint := strings.TrimSuffix(offer.OwnToneURL, "/") + "/api/outputs/" + offer.Snapshot.HomePodID + "/transport/bound-pause-confirm"
+	call, err := http.NewRequestWithContext(ctx, http.MethodPost, endpoint, bytes.NewReader(body))
+	if err != nil {
+		return err
+	}
+	call.Header.Set("Content-Type", "application/json")
+	response, err := client.Do(call)
+	if err != nil {
+		return err
+	}
+	defer response.Body.Close()
+	raw, err := io.ReadAll(io.LimitReader(response.Body, 2049))
+	if err != nil || len(raw) > 2048 || response.StatusCode != http.StatusOK {
+		return ErrAliasConflict
+	}
+	var ack roomTransportPauseConfirmation
+	if strictVolumeJSON(raw, &ack) != nil || ack.Schema != "podconnect.output_transport_pause_confirmation.v1" || !ack.OK || ack.Token != token || ack.NativePrepareID != offer.Snapshot.PrepareID || ack.NativeRevision != offer.NativeRevision || ack.Physical == nil || *ack.Physical {
+		return ErrAliasConflict
+	}
+	return nil
 }
 
