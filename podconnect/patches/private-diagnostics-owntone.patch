+/* Return the first blocking owner from the original short-circuit evaluation.
+ * Some predicates retire expired leases: diagnostics must not evaluate them twice. */
+static const char *
+outputs_transport_busy_reason(void)
+{
+  if (transport_pin && !transport_remaining(&transport_pin_expiry)) transport_pin = NULL;
+  if (transport_pin != NULL) return "transport_pin";
+  if (room_volume_pin_busy()) return "volume_pin";
+  if (transport_custody_busy()) return "transport_custody";
+  if (room_volume_undrained()) return "volume_undrained";
+  if (outputs_start_busy()) return "start_gate_or_writer";
+  if (outputs_start_source_owned()) return "retained_source";
+  return NULL;
+}
