+func TestPrepareQueueStaleInvalidAndRevisionSaturationAreClosed(t *testing.T) {
+	for _, mode := range []string{"stale", "negative", "missing", "overflow-position", "max-revision", "exhausted"} {
+		t.Run(mode, func(t *testing.T) {
+			list := occurrenceFixture(t)
+			revision, position := list.queueRevision, 1
+			switch mode {
+			case "stale":
+				list.SetPlayingQueue(false)
+			case "negative":
+				position = -1
+			case "missing":
+				position = 19
+			case "overflow-position":
+				position = MaxQueueOccurrences
+			case "max-revision":
+				list.queueRevision = math.MaxUint64
+				revision = list.queueRevision
+			case "exhausted":
+				list.queueRevisionExhausted = true
+			}
+			before := prepareState(list)
+			if staged, err := list.PrepareQueueOccurrence(context.Background(), revision, position); err == nil || staged != nil {
+				t.Fatal("invalid occurrence produced detached candidate")
+			}
+			assertPrepareState(t, list, before)
+		})
+	}
+	var list *List
+	if staged, err := list.PrepareQueueOccurrence(context.Background(), 0, 0); err == nil || staged != nil {
+		t.Fatal("nil list accepted")
+	}
+}
