+func TestRepeatedQueuePreparationDoesNotNestPageResolvers(t *testing.T) {
+	list := occurrenceFixture(t)
+	for i := 0; i < 12; i++ {
+		list.AddToQueue(&connectpb.ContextTrack{Uri: "spotify:track:3333333333333333333333", Uid: "manual"})
+	}
+	for i := 0; i < 10; i++ {
+		prepared, err := list.PrepareQueueOccurrence(context.Background(), list.queueRevision, 0)
+		if err != nil {
+			t.Fatal(err)
+		}
+		isolated, ok := prepared.tracks.pages.(preparationPages)
+		if !ok {
+			t.Fatal("prepared resolver no longer isolates fetched rows")
+		}
+		if _, nested := isolated.source.(preparationPages); nested {
+			t.Fatal("repeated queue selections accumulate resolver wrappers")
+		}
+		list = prepared // The real owner adopts the prepared list after commit.
+	}
+}
+
+func TestPrepareQueueFetchedRowsAreDetachedFromResolverCache(t *testing.T) {
+	list := occurrenceFixture(t)
+	row := &connectpb.ContextTrack{Uri: "spotify:track:4444444444444444444444", Uid: "cached", Metadata: map[string]string{"source": "cached"}}
+	list.tracks.pages = queuePreparePages(func(ctx context.Context, index int) ([]*connectpb.ContextTrack, error) {
+		if index == 1 {
+			return []*connectpb.ContextTrack{row}, nil
+		}
+		return nil, io.EOF
+	})
+	before := prepareState(list)
+	prepared, err := list.PrepareQueueOccurrence(context.Background(), list.queueRevision, 3)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if prepared.tracks.pos != 4 || len(prepared.tracks.list) != 5 || prepared.CurrentTrack().Uri != row.Uri {
+		t.Fatal("missing detached paginated occurrence")
+	}
+	prepared.tracks.list[4].item.Metadata["source"] = "staged"
+	if row.Metadata["source"] != "cached" {
+		t.Fatal("staged row aliases resolver cache")
+	}
+	assertPrepareState(t, list, before)
+}
