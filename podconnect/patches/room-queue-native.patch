+type queuePrepareState struct {
+	position                     int
+	revision                     uint64
+	exhausted, playing, shuffled bool
+	seed                         uint64
+	shuffleLen, shuffleKeep      int
+	rows                         []pagedListItem[*connectpb.ContextTrack]
+	queue                        []*connectpb.ContextTrack
+}
+
+func prepareState(list *List) queuePrepareState {
+	state := queuePrepareState{position: list.tracks.pos, revision: list.queueRevision, exhausted: list.queueRevisionExhausted, playing: list.playingQueue, shuffled: list.shuffled, seed: list.shuffleSeed, shuffleLen: list.shuffleLen, shuffleKeep: list.shuffleKeep}
+	for _, row := range list.tracks.list {
+		copied := row
+		copied.item = proto.Clone(row.item).(*connectpb.ContextTrack)
+		state.rows = append(state.rows, copied)
+	}
+	for _, row := range list.queue {
+		state.queue = append(state.queue, proto.Clone(row).(*connectpb.ContextTrack))
+	}
+	return state
+}
+func assertPrepareState(t *testing.T, list *List, before queuePrepareState) {
+	t.Helper()
+	if !reflect.DeepEqual(prepareState(list), before) {
+		t.Fatal("preparation mutated retained cursor, rows, manual queue, revision or shuffle state")
+	}
+}
+func addDuplicateManual(list *List) {
+	for _, which := range []string{"first", "second", "last"} {
+		list.AddToQueue(&connectpb.ContextTrack{Uri: "spotify:track:3333333333333333333333", Uid: "duplicate", Metadata: map[string]string{"which": which}})
+	}
+}
+
+func TestPrepareQueueExactDetachedOccurrencePreservesLiveState(t *testing.T) {
+	for _, mode := range []string{"duplicate-context", "manual-duplicate", "context-after-manual", "playing-queue", "shuffle"} {
+		t.Run(mode, func(t *testing.T) {
+			list := occurrenceFixture(t)
+			position := 1
+			switch mode {
+			case "manual-duplicate", "context-after-manual", "playing-queue":
+				addDuplicateManual(list)
+				if mode == "context-after-manual" {
+					position = 4
+				}
+				if mode == "playing-queue" {
+					list.SetPlayingQueue(true)
+					position = 0
+				}
+			case "shuffle":
+				if err := list.ToggleShuffle(context.Background(), true); err != nil {
+					t.Fatal(err)
+				}
+				// Existing shuffled order is the authority; no re-shuffle or URI search.
+				position = 0
+			}
+			observed, err := list.ObserveUpcoming(context.Background())
+			if err != nil {
+				t.Fatal(err)
+			}
+			before := prepareState(list)
+			prepared, err := list.PrepareQueueOccurrence(context.Background(), observed.Revision, position)
+			if err != nil {
+				t.Fatal(err)
+			}
+			assertPrepareState(t, list, before)
+			if prepared == list || prepared.tracks == list.tracks || prepared.queueRevision != observed.Revision+1 || prepared.ctx != list.ctx {
+				t.Fatal("detached staging lost context or revision")
+			}
+			if prepared.CurrentTrack().Uri != observed.Items[position].URI {
+				t.Fatal("wrong occurrence")
+			}
+			switch mode {
+			case "duplicate-context", "context-after-manual":
+				if prepared.tracks.pos != 2 || prepared.playingQueue || len(prepared.queue) != 0 {
+					t.Fatal("wrong duplicate context position")
+				}
+			case "manual-duplicate", "playing-queue":
+				if !prepared.playingQueue || len(prepared.queue) != 2 || prepared.queue[0].Metadata["which"] != "second" || prepared.tracks.pos != list.tracks.pos {
+					t.Fatal("wrong manual occurrence or following queue")
+				}
+			case "shuffle":
+				if prepared.shuffled != list.shuffled || prepared.shuffleSeed != list.shuffleSeed || prepared.shuffleLen != list.shuffleLen || prepared.shuffleKeep != list.shuffleKeep {
+					t.Fatal("shuffle configuration changed")
+				}
+			}
+			// Both resident page rows and queued protobuf metadata must be detached.
+			prepared.tracks.list[0].item.Uid = "staged-only"
+			if len(prepared.queue) > 0 {
+				prepared.queue[0].Metadata["which"] = "staged-only"
+			}
+			assertPrepareState(t, list, before)
+		})
+	}
+}
