+package daemon
+
+// Queue is a distinct same-writer transport purpose. Preparation never changes
+// the live cursor/source; only the existing guarded worker may publish it.
+import (
+	"context"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"net/http"
+	"path/filepath"
+	"strconv"
+	"time"
+
+	librespot "github.com/devgianlu/go-librespot"
+	"github.com/devgianlu/go-librespot/output"
+	"github.com/devgianlu/go-librespot/player"
+	connectpb "github.com/devgianlu/go-librespot/proto/spotify/connectstate"
+	"google.golang.org/protobuf/proto"
+)
+
+const apiRoomBoundQueue ApiRequestType = "room_bound_queue"
+const queuePurpose = "queue_occurrence_v1"
+
+type queueSelection struct {
+	ObservationID string `json:"observation_id"`
+	SessionID     string `json:"session_id"`
+	QueueRevision uint64 `json:"queue_revision"`
+	OccurrenceID  string `json:"occurrence_id"`
+}
+type queueWriterWire struct {
+	Process     contentProcess      `json:"native_process"`
+	FD          string              `json:"writer_fd"`
+	Pipe        output.PipeIdentity `json:"pipe_identity"`
+	Epoch       string              `json:"source_epoch"`
+	Generation  string              `json:"open_generation"`
+	InputDigest string              `json:"input_path_digest"`
+}
+type queueWriterProof struct {
+	Wire      queueWriterWire
+	Completed *completedWriter
+}
+type queueTransportProof struct {
+	Selection      queueSelection
+	Position       int
+	Observation    *nativeQueueOffer
+	Owner          *AppPlayer
+	EffectEnqueued bool
+	EffectJoined   bool
+}
+type queueWriterFence struct {
+	Owner      *AppPlayer
+	Writer     output.MovePipeIdentity
+	Generation uint64
+	Until      time.Time
+}
+type queueStateResponse struct {
+	Schema        string                `json:"schema"`
+	Ready         bool                  `json:"ready"`
+	Purpose       string                `json:"purpose"`
+	Owner         roomTransportIdentity `json:"native_owner"`
+	ObservationID string                `json:"observation_id"`
+	Revision      uint64                `json:"queue_revision"`
+	Expires       int                   `json:"expires_after_ms"`
+	Items         []nativeQueueItem     `json:"items"`
+	Truncated     bool                  `json:"truncated"`
+	Writer        queueWriterWire       `json:"writer_proof"`
+	Physical      bool                  `json:"physical_result_verified"`
+}
+type queuePrepareResponse struct {
+	Schema    string                `json:"schema"`
+	Purpose   string                `json:"purpose"`
+	PrepareID string                `json:"prepare_id"`
+	Owner     roomTransportIdentity `json:"native_owner"`
+	Revision  string                `json:"native_revision"`
+	Action    string                `json:"action"`
+	Percent   int                   `json:"volume_percent"`
+	Digest    string                `json:"args_digest"`
+	Expires   int                   `json:"expires_after_ms"`
+	Queue     queueSelection        `json:"queue"`
+	Writer    queueWriterWire       `json:"writer_proof"`
+}
+type queueCommitResponse struct {
+	Schema        string                `json:"schema"`
+	Accepted      bool                  `json:"accepted_native"`
+	Purpose       string                `json:"purpose"`
+	PrepareID     string                `json:"prepare_id"`
+	ObservationID string                `json:"observation_id"`
+	OccurrenceID  string                `json:"occurrence_id"`
+	QueueRevision uint64                `json:"queue_revision"`
+	Owner         roomTransportIdentity `json:"native_owner"`
+	Revision      string                `json:"native_revision"`
+	Digest        string                `json:"args_digest"`
+	Physical      bool                  `json:"physical_result_verified"`
+}
+type queueCCommit struct {
+	Token       string                `json:"token"`
+	PrepareID   string                `json:"native_prepare_id"`
+	Action      string                `json:"action"`
+	Digest      string                `json:"args_digest"`
+	InputDigest string                `json:"expected_input_path_digest"`
+	Owner       roomTransportIdentity `json:"native_owner"`
