+func TestPrepareQueuePaginationCancellationAndFailureNeverMutateRetainedList(t *testing.T) {
+	for _, mode := range []string{"cancel-before", "cancel-page", "page-error", "owner-revision-change"} {
+		t.Run(mode, func(t *testing.T) {
+			list := occurrenceFixture(t)
+			addDuplicateManual(list)
+			ctx, cancel := context.WithCancel(context.Background())
+			defer cancel()
+			if mode == "cancel-before" {
+				cancel()
+			}
+			calls := 0
+			list.tracks.pages = queuePreparePages(func(ctx context.Context, index int) ([]*connectpb.ContextTrack, error) {
+				calls++
+				if index > 1 {
+					return nil, io.EOF
+				}
+				if mode == "cancel-page" {
+					cancel()
+				}
+				if mode == "page-error" {
+					return nil, errors.New("inert page failure")
+				}
+				if mode == "owner-revision-change" {
+					list.SetPlayingQueue(false)
+				}
+				return []*connectpb.ContextTrack{{Uri: "spotify:track:4444444444444444444444", Uid: "next-page"}}, nil
+			})
+			before := prepareState(list)
+			prepared, err := list.PrepareQueueOccurrence(ctx, list.queueRevision, 1)
+			if err == nil || prepared != nil {
+				t.Fatal("cancelled/failed/stale preparation returned a list")
+			}
+			if mode == "owner-revision-change" {
+				before.revision++
+			}
+			assertPrepareState(t, list, before)
+			expectedCalls := 1
+			if mode == "cancel-before" {
+				expectedCalls = 0
+			}
+			if mode == "owner-revision-change" {
+				expectedCalls = 2
+			}
+			if calls != expectedCalls {
+				t.Fatal("unexpected page admission count")
+			}
+		})
+	}
+}
