+	owned = false
+	return queuePrepareResponse{"podconnect.native_room_queue_prepare.v1", queuePurpose, id, identity, revision, "queue", 0, offer.Snapshot.ArgsDigest, remaining, *request.Queue, writer.Wire}, nil
+}
+func minTime(a, b time.Time) time.Time {
+	if a.Before(b) {
+		return a
+	}
+	return b
+}
+func (p *AppPlayer) queuePreparedStream(ctx context.Context, uri string) (*player.Stream, error) {
+	// Keep the same metadata/decoder implementation used by guarded Next.
+	if !contentTrackURI.MatchString(uri) {
+		return nil, ErrBadRequest
+	}
+	id, err := librespot.SpotifyIdFromUri(uri)
+	if err != nil {
+		return nil, err
+	}
+	return p.player.NewStream(ctx, p.app.client, *id, p.app.cfg.Bitrate, 0)
+}
+func queueCommitPayload(offer *nativeTransportOffer, token string) queueCCommit {
+	return queueCCommit{token, offer.Snapshot.PrepareID, "queue", offer.Snapshot.ArgsDigest, offer.Writer.Wire.InputDigest, offer.Snapshot.roomTransportIdentity, offer.NativeRevision, offer.Queue.Selection, offer.Writer.Wire}
+}
+func validQueueACK(raw []byte, offer *nativeTransportOffer, token string) bool {
+	var ack queueCACK
+	if strictContentJSON(raw, &ack) != nil {
+		return false
+	}
+	return ack.Schema == "podconnect.output_queue_commit.v1" && ack.OK && ack.Purpose == queuePurpose && ack.Token == token && ack.PrepareID == offer.Snapshot.PrepareID && ack.Digest == offer.Snapshot.ArgsDigest && ack.Remaining > 0 && ack.Remaining <= 10000 && ack.Outcome == "accepted" && ack.Owner == offer.Snapshot.roomTransportIdentity && ack.Revision == offer.NativeRevision && ack.Queue == offer.Queue.Selection && ack.Writer == offer.Writer.Wire && !ack.Physical
+}
+func queueAccepted(offer *nativeTransportOffer) queueCommitResponse {
+	q := offer.Queue.Selection
+	return queueCommitResponse{"podconnect.native_room_queue_commit.v1", true, queuePurpose, offer.Snapshot.PrepareID, q.ObservationID, q.OccurrenceID, q.QueueRevision, offer.Snapshot.roomTransportIdentity, offer.NativeRevision, offer.Snapshot.ArgsDigest, false}
+}
+func (s *ConcreteApiServer) handleRoomQueue(w http.ResponseWriter, r *http.Request) {
+	if r.Method != http.MethodGet {
+		w.WriteHeader(405)
+		return
+	}
+	q := r.URL.Query()
+	if len(q) != 4 {
+		w.WriteHeader(400)
+		return
+	}
+	for _, key := range []string{"account_user_id", "target_id", "room_id", "homepod_id"} {
+		if len(q[key]) != 1 || !nativeOwnerASCII(q.Get(key), 160) {
+			w.WriteHeader(400)
+			return
+		}
+	}
+	if !homePodIDPattern.MatchString(q.Get("homepod_id")) {
+		w.WriteHeader(400)
+		return
+	}
+	ctx, cancel := context.WithTimeout(r.Context(), 3*time.Second)
+	defer cancel()
+	data, err := s.roomTransportAsk(ctx, apiRoomBoundQueue, roomTransportStateRequest{q.Get("account_user_id"), q.Get("target_id"), q.Get("room_id"), q.Get("homepod_id"), ctx})
+	roomTransportResponse(w, data, err)
+}
