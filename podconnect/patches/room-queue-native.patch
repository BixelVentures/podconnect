+package player
+
+import (
+	"context"
+	librespot "github.com/devgianlu/go-librespot"
+	"github.com/devgianlu/go-librespot/output"
+	"io"
+	"os"
+	"path/filepath"
+	"syscall"
+	"testing"
+	"time"
+)
+
+type queueEOFSource struct{ identity int }
+
+func (*queueEOFSource) Read([]float32) (int, error) { return 0, io.EOF }
+func (*queueEOFSource) PositionMs() int64           { return 0 }
+func (*queueEOFSource) SetPositionMs(int64) error   { return nil }
+
+func queueFIFO(t *testing.T) string {
+	t.Helper()
+	path := filepath.Join(t.TempDir(), "queue.fifo")
+	if err := syscall.Mkfifo(path, 0600); err != nil {
+		t.Fatal(err)
+	}
+	reader, err := os.OpenFile(path, os.O_RDONLY|syscall.O_NONBLOCK, 0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { reader.Close() })
+	return path
+}
+func TestQueueRealWorkerOrdinaryEpochZeroPublishesExactSameWriter(t *testing.T) {
+	path := queueFIFO(t)
+	var actual output.MovePipeOutput
+	p, err := NewPlayer(&Options{Log: &librespot.NullLogger{}, AudioBackend: "pipe", AudioOutputPipe: path, AudioOutputPipeFormat: "s16le", WithNewOutput: func(create func() (output.Output, error)) (output.Output, error) {
+		out, err := create()
+		if err == nil {
+			actual = out.(output.MovePipeOutput)
+		}
+		return out, err
+	}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer p.Close()
+	old, next := &queueEOFSource{1}, &queueEOFSource{2}
+	if err = p.SetPrimaryStream(old, true, false); err != nil {
+		t.Fatal(err)
+	}
+	before, epoch, err := p.RoomMove(context.Background(), "inspect", old, output.MovePipeIdentity{}, "", false, func(mutate func()) error { mutate(); return nil })
+	if err != nil || epoch != "0" || before.Type != "fifo" {
+		t.Fatal("normal phone writer inspection needs no START/MOVE", before, epoch, err)
+	}
+	cursor := 0
+	err = p.GuardedQueueTransport(context.Background(), next, old, before, epoch, func(mutate func()) error { mutate(); cursor = 2; return nil })
+	if err != nil || cursor != 2 {
+		t.Fatal("exact queue publication failed", err, cursor)
+	}
+	snapshot := make(chan librespot.AudioSource, 1)
+	// Existing actual worker snapshot joins its selected source; no legacy load is used.
+	reply := make(chan any, 1)
+	p.cmd <- playerCmd{start: &start35Command{ctx: context.Background(), phase: "snapshot"}, resp: reply}
+	result := (<-reply).(start35Result)
+	snapshot <- result.Source
+	if <-snapshot != librespot.AudioSource(next) {
+		t.Fatal("queue source not published")
+	}
+	var after output.MovePipeIdentity
+	if err = actual.WithStartLock(context.Background(), func(pipe output.PipeIdentity, _ func(bool)) error {
+		after = output.MovePipeIdentity{PipeIdentity: pipe, FD: actual.WriterFDUnderStartLock()}
+		return nil
+	}); err != nil || after != before {
+		t.Fatal("queue replaced FIFO/descriptor", before, after, err)
+	}
+	if p.startEpoch != 0 || p.movePhase != "" {
+		t.Fatal("queue fabricated source transition or MOVE")
+	}
+}
+func TestQueueActualWriterAndDeadlineGuardBeforeCursorOrSource(t *testing.T) {
+	for _, mode := range []string{"fd", "inode", "epoch", "source", "owner", "deadline-after-output-lock", "deadline-after-source-lock"} {
