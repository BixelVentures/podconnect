+type queuePreparePages func(context.Context, int) ([]*connectpb.ContextTrack, error)
+
+func (p queuePreparePages) Page(ctx context.Context, index int) ([]*connectpb.ContextTrack, error) {
+	return p(ctx, index)
+}
