+// preparationPages isolates newly fetched protobuf rows too. The resolver may
+// cache pages, but no prepared row may alias those retained resolver rows.
+type preparationPages struct {
+	source librespot.PageResolver[*connectpb.ContextTrack]
+}
+
+func (p preparationPages) Page(ctx context.Context, index int) ([]*connectpb.ContextTrack, error) {
+	if err := ctx.Err(); err != nil {
+		return nil, err
+	}
+	rows, err := p.source.Page(ctx, index)
+	if err != nil {
+		return nil, err
+	}
+	if err := ctx.Err(); err != nil {
+		return nil, err
+	}
+	copied := make([]*connectpb.ContextTrack, len(rows))
