+
+func (app *App) queueWriterBusyLocked() bool {
+	now := time.Now()
+	for op, fence := range app.queueWriterFences {
+		if !now.Before(fence.Until) {
+			delete(app.queueWriterFences, op)
+		}
+	}
+	return len(app.queueWriterFences) > 0
+}
+func (app *App) releaseQueueWriter(op *nativeTransportOffer) {
+	app.moveCustodyMu.Lock()
+	defer app.moveCustodyMu.Unlock()
+	delete(app.queueWriterFences, op)
+}
+func (p *AppPlayer) queueWriterCurrentLocked(proof *queueWriterProof, offer *nativeTransportOffer) bool {
+	if proof == nil || p.app == nil {
+		return false
+	}
+	process, ok := nativeContentProcess()
+	if !ok || process != proof.Wire.Process {
+		return false
+	}
+	generation, err := strconv.ParseUint(proof.Wire.Generation, 10, 64)
+	if err != nil || generation == 0 {
+		return false
+	}
+	current, err := p.app.completedWriterCurrent(p, offer.Snapshot.roomTransportIdentity)
+	if err != nil || (current == nil) != (proof.Completed == nil) || current != nil && *current != *proof.Completed {
+		return false
+	}
+	p.app.moveCustodyMu.Lock()
+	defer p.app.moveCustodyMu.Unlock()
+	app := p.app
+	writer := output.MovePipeIdentity{PipeIdentity: proof.Wire.Pipe, FD: proof.Wire.FD}
+	if app.moveCustodyUnknown || app.retirementPending != nil || app.openedWriterOwner != p || app.openedWriter != writer || app.openedWriterGeneration != generation {
+		return false
+	}
+	fence, ok := app.queueWriterFences[offer]
+	return ok && fence.Owner == p && fence.Writer == writer && fence.Generation == generation && time.Now().Before(fence.Until)
+}
+func (p *AppPlayer) captureQueueWriter(ctx context.Context, identity roomTransportIdentity, reserve *nativeTransportOffer) (*queueWriterProof, error) {
+	if p.primaryStream == nil || p.primaryStream.Source == nil || p.player == nil || p.state == nil || p.state.player == nil || p.app == nil || !filepath.IsAbs(p.app.cfg.AudioOutputPipe) {
+		return nil, ErrAliasConflict
+	}
+	process, ok := nativeContentProcess()
+	if !ok {
+		return nil, ErrAliasConflict
+	}
+	completed, err := p.app.completedWriterCurrent(p, identity)
+	if err != nil {
+		return nil, err
+	}
+	p.app.moveCustodyMu.Lock()
+	writer, generation, owner := p.app.openedWriter, p.app.openedWriterGeneration, p.app.openedWriterOwner
+	invalid := p.app.moveCustodyUnknown || p.app.retirementPending != nil
+	p.app.moveCustodyMu.Unlock()
+	if invalid || owner != p || generation == 0 || writer.Type != "fifo" || !volumeCounter(writer.FD) {
+		return nil, ErrAliasConflict
+	}
+	primary, paused := p.primaryStream, p.state.player.IsPaused
+	actual, epoch, err := p.player.RoomMove(ctx, "inspect", primary.Source, output.MovePipeIdentity{}, "", !paused, func(mutate func()) error {
+		p.aliasMu.Lock()
+		defer p.aliasMu.Unlock()
+		current, err := p.app.completedWriterCurrent(p, identity)
+		if err != nil || (current == nil) != (completed == nil) || current != nil && *current != *completed {
+			return ErrAliasConflict
+		}
+		binding := p.aliasBindingLocked()
+		if ctx.Err() != nil || p.primaryStream != primary || p.state == nil || p.state.player == nil || p.state.player.IsPaused != paused || p.aliasRetired || p.roomVolumeClosing || p.roomVolumeReservedLocked() || !p.hasInitialConnectState || p.spotConnId != identity.ConnectionID || p.state.player.SessionId != identity.SessionID || p.aliasIncarnation != identity.AliasIncarnation || p.aliasFingerprint != identity.AliasRegistry || p.aliasRevision != identity.AliasRevision || binding == nil || !binding.Ready || binding.RoomID != identity.RoomID || !p.transportMappingCurrentLocked() {
+			return ErrAliasConflict
+		}
+		p.app.moveCustodyMu.Lock()
+		defer p.app.moveCustodyMu.Unlock()
+		app := p.app
+		if app.moveCustodyUnknown || app.retirementPending != nil || app.openedWriterOwner != p || app.openedWriter != writer || app.openedWriterGeneration != generation {
+			return ErrAliasConflict
+		}
+		if reserve != nil {
+			if !time.Now().Before(reserve.Expires) {
+				return ErrAliasConflict
+			}
+			app.queueWriterBusyLocked()
+			if app.queueWriterFences == nil {
+				app.queueWriterFences = make(map[*nativeTransportOffer]queueWriterFence)
+			}
+			if len(app.queueWriterFences) >= 128 {
+				return ErrAliasConflict
+			}
+			app.queueWriterFences[reserve] = queueWriterFence{p, writer, generation, reserve.Expires}
+		}
+		mutate()
+		return nil
+	})
+	if err != nil || actual != writer || !volumeCounter(epoch) || completed != nil && (completed.writer != actual || completed.epoch != epoch) {
+		if reserve != nil {
+			p.app.releaseQueueWriter(reserve)
+		}
+		return nil, ErrAliasConflict
+	}
+	digest := sha256.Sum256([]byte(p.app.cfg.AudioOutputPipe))
+	return &queueWriterProof{queueWriterWire{process, actual.FD, actual.PipeIdentity, epoch, strconv.FormatUint(generation, 10), hex.EncodeToString(digest[:])}, completed}, nil
+}
+func (p *AppPlayer) strongQueueCurrent(offer *nativeQueueOffer, identity roomTransportIdentity) bool {
+	if offer == nil || offer.BoundOwner == nil || *offer.BoundOwner != identity || !time.Now().Before(offer.Expires) || p.state != offer.State || p.state == nil || p.state.player != offer.PlayerState || p.state.tracks != offer.Tracks || p.state.tracks.TransportRevision() != offer.Snapshot.QueueRevision || p.sess != offer.Session || p.player != offer.Player || p.primaryStream != offer.Primary || p.roomTransportGeneration != offer.Generation {
+		return false
+	}
+	latest, err := p.roomTransportIdentity(identity.AccountUserID, identity.TargetID, identity.RoomID, identity.HomePodID)
+	return err == nil && latest == identity && nativeBoundOwnerValid(latest)
+}
+func (p *AppPlayer) observeRoomQueue(parent context.Context, request roomTransportStateRequest) (any, error) {
+	ctx, cancel := queueOperationContext(parent, request.Context)
+	defer cancel()
+	identity, err := p.roomTransportIdentity(request.AccountUserID, request.TargetID, request.RoomID, request.HomePodID)
+	if err != nil || !nativeBoundOwnerValid(identity) {
+		return nil, ErrAliasConflict
+	}
+	offer, err := p.newQueueObservation(parent, queueReadRequest{request.AccountUserID, request.RoomID, ctx})
+	if err != nil {
+		return nil, err
+	}
+	if !validRoomQueueObservation(offer) {
+		return nil, ErrAliasConflict
+	}
+	offer.BoundOwner = &identity
+	offer.PlayerState = p.state.player
+	offer.Session = p.sess
+	offer.Player = p.player
+	offer.Primary = p.primaryStream
+	offer.Generation = p.roomTransportGeneration
+	writer, err := p.captureQueueWriter(ctx, identity, nil)
+	if err != nil || ctx.Err() != nil || parent.Err() != nil || !p.strongQueueCurrent(offer, identity) {
+		return nil, ErrAliasConflict
+	}
+	offer.Writer = writer
+	remaining := int(time.Until(offer.Expires).Milliseconds())
+	if remaining < 1 {
+		return nil, ErrAliasConflict
+	}
+	p.queueOccurrenceOffer = offer
+	return queueStateResponse{"podconnect.native_room_queue_state.v1", true, queuePurpose, identity, offer.Snapshot.ObservationID, offer.Snapshot.QueueRevision, min(remaining, 10000), offer.Snapshot.Items, offer.Snapshot.Truncated, writer.Wire, false}, nil
+}
+func validRoomQueueObservation(offer *nativeQueueOffer) bool {
+	if offer == nil || offer.Snapshot.QueueRevision >= 1<<53 || len(offer.Snapshot.Items) > 20 {
+		return false
+	}
+	for _, row := range offer.Snapshot.Items {
+		if !contentTrackURI.MatchString(row.URI) {
+			return false
+		}
+	}
+	return true
+}
+func validQueueSelection(q *queueSelection) bool {
+	return q != nil && queueIDPattern.MatchString(q.ObservationID) && queueOccurrenceIDPattern.MatchString(q.OccurrenceID) && nativeOwnerASCII(q.SessionID, 255) && q.QueueRevision < 1<<53
+}
+func (p *AppPlayer) prepareBoundQueue(parent context.Context, request roomTransportPrepareRequest) (any, error) {
+	ctx, cancel := queueOperationContext(parent, request.Context)
