+// PrepareQueueOccurrence stages an internally resolved occurrence position on a
+// detached list. It grants no queue, session, output or commit authority: the
+// serialized player owner must still bind and revalidate that authority at effect.
+func (tl *List) PrepareQueueOccurrence(ctx context.Context, revision uint64, position int) (*List, error) {
+	if err := ctx.Err(); err != nil {
+		return nil, err
+	}
+	if tl == nil || tl.queueRevisionExhausted || revision != tl.queueRevision || revision == math.MaxUint64 {
+		return nil, fmt.Errorf("stale or exhausted queue occurrence")
+	}
+	clone, err := tl.cloneForPreparation()
+	if err != nil {
+		return nil, err
+	}
+	if _, isolated := clone.tracks.pages.(preparationPages); !isolated {
+		clone.tracks.pages = preparationPages{source: clone.tracks.pages}
+	}
+	if err = clone.SelectUpcoming(ctx, revision, position); err != nil {
+		return nil, err
+	}
+	if err = ctx.Err(); err != nil {
+		return nil, err
+	}
+	if tl.queueRevisionExhausted || tl.queueRevision != revision {
+		return nil, fmt.Errorf("queue occurrence owner changed during preparation")
+	}
+	return clone, nil
+}
