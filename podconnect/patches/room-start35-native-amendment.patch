+func (r *HttpChunkedReader) DetachPreparation() error {
+	r.preparationMu.Lock()
+	stop, done, prepared := r.preparationStop, r.preparationDone, r.preparationContext
+	// Keep done immutable because an already executing cancellation callback owns it.
+	r.preparationStop = nil
+	r.preparationMu.Unlock()
+	if stop != nil && !stop() {
+		<-done
+	}
+	if prepared != nil && prepared.Err() != nil {
+		return prepared.Err()
+	}
+	return r.ctx.Err()
+}
 func (r *HttpChunkedReader) Close() error {
 	r.CancelRead()
+	_ = r.DetachPreparation()
 	r.prefetchWg.Wait()
 	return nil
 }
