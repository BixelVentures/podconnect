+package player
+
+import (
+	"context"
+	"fmt"
+	librespot "github.com/devgianlu/go-librespot"
+	downloadpb "github.com/devgianlu/go-librespot/proto/spotify/download"
+	"net/http"
+	"net/http/httptest"
+	"sync/atomic"
+	"testing"
+	"time"
+)
+
+// Uses the actual detached loader's storage->raw construction seam, not a
+// fabricated provider login or decoder payload. HTTP and body cancellation must
+// join construction before any stream can be staged.
+func TestStart35PreparationCancelsActualHeldCDNConstruction(t *testing.T) {
+	for _, mode := range []string{"headers", "body"} {
+		t.Run(mode, func(t *testing.T) {
+			entered, drained := make(chan struct{}), make(chan struct{})
+			release := make(chan struct{})
+			var requests atomic.Int32
+			owner := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				requests.Add(1)
+				if mode == "body" {
+					w.Header().Set("Content-Range", "bytes 0-15/16")
+					w.WriteHeader(206)
+					w.(http.Flusher).Flush()
+				}
+				close(entered)
+				select {
+				case <-r.Context().Done():
+				case <-release:
+				}
+				close(drained)
+			}))
+			defer func() { close(release); owner.Close() }()
+			ctx, cancel := context.WithCancel(context.Background())
+			defer cancel()
+			loader := &Player{preparationContext: ctx, cdnQuarantine: map[string]time.Time{}}
+			done := make(chan error, 1)
+			go func() {
+				raw, err := loader.httpChunkedReaderFromStorageResolve(&librespot.NullLogger{}, owner.Client(), &downloadpb.StorageResolveResponse{Result: downloadpb.StorageResolveResponse_CDN, Cdnurl: []string{owner.URL, owner.URL + "/never-fallback"}})
+				if raw != nil {
+					_ = raw.Close()
+					done <- fmt.Errorf("cancelled construction returned raw owner")
+					return
+				}
+				done <- err
+			}()
+			<-entered
+			cancel()
+			select {
+			case err := <-done:
+				if err == nil {
+					t.Fatal("cancelled construction succeeded")
+				}
+			case <-time.After(time.Second):
+				t.Fatal("held CDN construction ignored stage cancellation")
+			}
+			select {
+			case <-drained:
+			case <-time.After(time.Second):
+				t.Fatal("actual HTTP worker not drained")
+			}
+			if requests.Load() != 1 {
+				t.Fatal("cancel attempted later CDN/retry", requests.Load())
+			}
+		})
+	}
+}
