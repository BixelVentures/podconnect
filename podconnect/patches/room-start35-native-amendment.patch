+func TestStart35PreparedRawDetachSurvivesStageCancellation(t *testing.T) {
+	owner := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		var start, end int
+		if _, err := fmt.Sscanf(r.Header.Get("Range"), "bytes=%d-%d", &start, &end); err != nil {
+			t.Error(err)
+			return
+		}
+		w.Header().Set("Content-Range", fmt.Sprintf("bytes %d-%d/%d", start, end, 2*DefaultChunkSize))
+		w.WriteHeader(206)
+		_, _ = w.Write(bytes.Repeat([]byte{7}, int(DefaultChunkSize)))
+	}))
+	defer owner.Close()
+	ctx, cancel := context.WithCancel(context.Background())
+	raw, err := NewHttpChunkedReaderForPreparation(&librespot.NullLogger{}, owner.Client(), owner.URL, ctx)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer raw.Close()
+	if err = raw.DetachPreparation(); err != nil {
+		t.Fatal(err)
+	}
+	cancel()
+	b := make([]byte, 1)
+	if n, err := raw.ReadAt(b, DefaultChunkSize); err != nil || n != 1 || b[0] != 7 {
+		t.Fatal("stage defercancel killed adopted playback reader", n, err)
+	}
+}
+func TestStart35CancelledDecoderReadsJoinBeforeAdoption(t *testing.T) {
+	entered, drained := make(chan struct{}), make(chan struct{})
+	owner := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if strings.HasPrefix(r.Header.Get("Range"), "bytes=0-") {
+			w.Header().Set("Content-Range", fmt.Sprintf("bytes 0-%d/%d", DefaultChunkSize-1, 2*DefaultChunkSize))
+			w.WriteHeader(206)
+			_, _ = w.Write(bytes.Repeat([]byte{1}, int(DefaultChunkSize)))
+		} else {
+			close(entered)
+			<-r.Context().Done()
+			close(drained)
+		}
+	}))
+	defer owner.Close()
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	raw, err := NewHttpChunkedReaderForPreparation(&librespot.NullLogger{}, owner.Client(), owner.URL, ctx)
+	if err != nil {
+		t.Fatal(err)
+	}
+	done := make(chan error, 1)
+	go func() { b := make([]byte, 1); _, err := raw.ReadAt(b, DefaultChunkSize); done <- err }()
+	<-entered
+	cancel()
+	select {
+	case err = <-done:
+		if err == nil {
+			t.Fatal("cancelled decoder read succeeded")
+		}
+	case <-time.After(time.Second):
+		t.Fatal("decoder raw read did not join cancellation")
+	}
+	if err = raw.DetachPreparation(); err == nil {
+		t.Fatal("cancelled decoder adopted")
+	}
+	if err = raw.Close(); err != nil {
+		t.Fatal(err)
+	}
+	select {
+	case <-drained:
+	case <-time.After(time.Second):
+		t.Fatal("raw HTTP worker not drained")
+	}
+}
