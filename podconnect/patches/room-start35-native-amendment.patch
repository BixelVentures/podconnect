+type pinnedStartRead struct {
+	tid    chan int
+	pinned bool
+}
+
+func (r *pinnedStartRead) Read(samples []float32) (int, error) {
+	if !r.pinned {
+		runtime.LockOSThread()
+		r.pinned = true
+		r.tid <- syscall.Gettid()
+	}
+	for i := range samples {
+		samples[i] = 0.25
+	}
+	return len(samples), nil
+}
+func TestStart35FullFIFOQuiescenceRequiresActualWriterJoin(t *testing.T) {
+	reader := &pinnedStartRead{tid: make(chan int, 1)}
+	out, read, path := startPipeFixture(t, reader)
+	// Failure cleanup must itself drain the owned FIFO before fixture Close joins.
+	t.Cleanup(func() {
+		out.FenceStart()
+		until := time.Now().Add(time.Second)
+		buffer := make([]byte, 65536)
+		for time.Now().Before(until) {
+			_, _ = syscall.Read(int(read.Fd()), buffer)
+			if out.lock.TryLock() {
+				out.lock.Unlock()
+				return
+			}
+			time.Sleep(time.Millisecond)
+		}
+	})
+	writer, err := syscall.Open(path, syscall.O_WRONLY|syscall.O_NONBLOCK, 0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	fill := make([]byte, 4096)
+	binary.LittleEndian.PutUint32(fill, 123)
+	for {
+		_, err = syscall.Write(writer, fill)
+		if err == syscall.EAGAIN {
+			break
+		}
+		if err != nil {
+			t.Fatal(err)
+		}
+	}
+	syscall.Close(writer)
+	if err = out.Resume(); err != nil {
+		t.Fatal(err)
+	}
+	tid := <-reader.tid
+	// Kernel-visible syscall admission proves the writer passed Read and the
+	// post-Read fence. A reader-entered notification alone does not prove Write.
+	syscallPath := fmt.Sprintf("/proc/self/task/%d/syscall", tid)
+	deadline := time.Now().Add(time.Second)
+	blocked := false
+	for time.Now().Before(deadline) {
+		raw, e := os.ReadFile(syscallPath)
+		if e != nil {
+			t.Fatal(e)
+		}
+		fields := strings.Fields(string(raw))
+		if len(fields) > 1 && fields[0] == strconv.Itoa(syscall.SYS_WRITE) {
+			fd, e := strconv.ParseUint(fields[1], 0, 64)
+			if e == nil && fd == uint64(out.file.Fd()) {
+				blocked = true
+				break
+			}
+		}
+		time.Sleep(time.Millisecond)
+	}
+	if !blocked {
+		t.Fatal("actual native writer was not observed blocked inside kernel Write on exact FIFO fd")
+	}
+	out.FenceStart()
+	ctx, cancel := context.WithTimeout(context.Background(), time.Second)
+	defer cancel()
+	joined := make(chan error, 1)
+	go func() {
+		joined <- out.WithStartLock(ctx, func(_ PipeIdentity, pause func(bool)) error { pause(true); return nil })
+	}()
+	select {
+	case err = <-joined:
+		t.Fatal("quiescence certificate preceded actual blocked Write drain", err)
+	case <-time.After(20 * time.Millisecond):
+	}
+	buffer := make([]byte, 65536)
+	deadline = time.Now().Add(time.Second)
+	for time.Now().Before(deadline) {
+		select {
+		case err = <-joined:
+			if err != nil {
+				t.Fatal(err)
+			}
+			return
+		default:
+		}
+		_, err = syscall.Read(int(read.Fd()), buffer)
+		if err != nil && err != syscall.EAGAIN && err != io.EOF {
+			t.Fatal(err)
+		}
+		time.Sleep(time.Millisecond)
+	}
+	t.Fatal("full FIFO writer was not joined after actual controlled drain")
+}
