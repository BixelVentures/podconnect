diff --git a/player/output_failure_test.go b/player/output_failure_test.go
new file mode 100644
index 0000000..ee9bffe
--- /dev/null
+++ b/player/output_failure_test.go
@@ -0,0 +1,175 @@
+package player
+
+import (
+	"os"
+	"path/filepath"
+	"sync"
+	"sync/atomic"
+	"syscall"
+	"testing"
+	"time"
+
+	librespot "github.com/devgianlu/go-librespot"
+	"github.com/devgianlu/go-librespot/output"
+)
+
+type heldFailurePCM struct {
+	entered chan struct{}
+	release chan struct{}
+	once    sync.Once
+	reads   atomic.Int32
+}
+
+func (s *heldFailurePCM) Read(samples []float32) (int, error) {
+	s.reads.Add(1)
+	s.once.Do(func() { close(s.entered) })
+	<-s.release
+	samples[0] = 0.25
+	return 1, nil
+}
+func (*heldFailurePCM) PositionMs() int64         { return 0 }
+func (*heldFailurePCM) SetPositionMs(int64) error { return nil }
+
+type emptyFailurePCM struct{}
+
+func (*emptyFailurePCM) Read([]float32) (int, error) { return 0, nil }
+func (*emptyFailurePCM) PositionMs() int64           { return 0 }
+func (*emptyFailurePCM) SetPositionMs(int64) error   { return nil }
+
+func failureOutputEvent(t *testing.T, p *Player) Event {
+	t.Helper()
+	deadline := time.After(2 * time.Second)
+	for {
+		select {
+		case ev := <-p.Receive():
+			if ev.Type == EventTypeOutputFailed {
+				if ev.OutputEpoch == 0 {
+					t.Fatal("real output error lacked its worker epoch")
+				}
+				return ev
+			}
+		case <-deadline:
+			t.Fatal("closed FIFO reader did not produce a worker output failure")
+		}
+	}
+}
+
+func TestPipeEPIPEFailureClaimFencesOldOwnerAndRejectsStaleEvent(t *testing.T) {
+	for _, tc := range []struct {
+		name      string
+		newOutput bool
+		burst     bool
+	}{
+		{name: "current_failure"},
+		{name: "new_output_precedes_failure_dispatch", newOutput: true},
+		{name: "queued_eofs_cannot_block_failure_claim", burst: true},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			path := filepath.Join(t.TempDir(), "output.fifo")
+			if err := syscall.Mkfifo(path, 0600); err != nil {
+				t.Fatal(err)
+			}
+			reader, err := os.OpenFile(path, os.O_RDONLY|syscall.O_NONBLOCK, 0)
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer reader.Close()
+			var creates atomic.Int32
+			p, err := NewPlayer(&Options{Log: &librespot.NullLogger{}, AudioBackend: "pipe",
+				AudioOutputPipe: path, AudioOutputPipeFormat: "s16le",
+				WithNewOutput: func(create func() (output.Output, error)) (output.Output, error) {
+					out, err := create()
+					if creates.Add(1) == 2 {
+						// If replacement starts unpaused, this interval lets its
+						// goroutine read the failed old primary before SetPrimary.
+						time.Sleep(20 * time.Millisecond)
+					}
+					return out, err
+				}})
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer p.Close()
+			source := &heldFailurePCM{entered: make(chan struct{}), release: make(chan struct{})}
+			if err := p.SetPrimaryStream(source, true, false); err != nil {
+				t.Fatal(err)
+			}
+			if err := p.Play(); err != nil {
+				t.Fatal(err)
+			}
+			select {
+			case <-source.entered:
+			case <-time.After(time.Second):
+				t.Fatal("output did not read the held PCM source")
+			}
+			if err := reader.Close(); err != nil {
+				t.Fatal(err)
+			}
+			close(source.release)
+			failed := failureOutputEvent(t, p)
+			if got := source.reads.Load(); got != 1 {
+				t.Fatalf("failed output unexpectedly reread its source: %d", got)
+			}
+			if tc.newOutput {
+				replacementReader, err := os.OpenFile(path, os.O_RDONLY|syscall.O_NONBLOCK, 0)
+				if err != nil {
+					t.Fatal(err)
+				}
+				defer replacementReader.Close()
+				if err := p.SetPrimaryStream(&emptyFailurePCM{}, true, false); err != nil {
+					t.Fatal("fresh output could not open before stale event dispatch", err)
+				}
+				if got := source.reads.Load(); got != 1 {
+					t.Fatalf("replacement read the failed old primary before source switch: %d", got)
+				}
+				if p.ClaimOutputFailure(failed.OutputEpoch, nil) {
+					t.Fatal("stale error claimed a newer output")
+				}
+				p.Stop()
+				if p.ClaimOutputFailure(failed.OutputEpoch, nil) {
+					t.Fatal("stale error claimed a later manual Stop")
+				}
+				return
+			}
+			if tc.burst {
+				// A coalesced source wake can represent more EOFs than the
+				// event buffer. The daemon is waiting on Claim while this worker
+				// must never block fanning out obsolete NotPlaying events.
+				p.source.pendingDone.Store(256)
+				p.source.done <- struct{}{}
+				processed := time.After(time.Second)
+				for p.source.pendingDone.Load() != 0 {
+					select {
+					case <-processed:
+						t.Fatal("worker did not take the queued EOF burst")
+					default:
+						time.Sleep(time.Millisecond)
+					}
+				}
+				claimed := make(chan bool, 1)
+				go func() { claimed <- p.ClaimOutputFailure(failed.OutputEpoch, nil) }()
+				select {
+				case ok := <-claimed:
+					if !ok {
+						t.Fatal("current failure claim was rejected after EOF burst")
+					}
+				case <-time.After(time.Second):
+					t.Fatal("EOF fanout blocked the output worker before failure claim")
+				}
+				p.Stop()
+				return
+			}
+			claims := 0
+			if !p.ClaimOutputFailure(failed.OutputEpoch, func() { claims++ }) || claims != 1 {
+				t.Fatal("current real EPIPE was not claimed exactly once")
+			}
+			if p.ClaimOutputFailure(failed.OutputEpoch, nil) {
+				t.Fatal("failure owner was claimed twice")
+			}
+			if err := p.SetPrimaryStream(&emptyFailurePCM{}, true, false); err == nil {
+				t.Fatal("sealed failed owner opened another output")
+			}
+			p.Stop()
+		})
+	}
+}
