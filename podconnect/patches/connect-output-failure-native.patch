+	}
+	if err := fresh.player.SetPrimaryStream(&contentInertSource{}, true, false); err != nil {
+		t.Fatal("fresh authenticated owner did not open its real FIFO", err)
+	}
+	if closed != 1 || app.openedWriterOwner != fresh || app.openedWriterGeneration < 2 || app.startCustody != nil || app.moveCustodyUnknown {
+		t.Fatal("closed-prior terminal did not admit exactly one fresh writer")
+	}
+}
