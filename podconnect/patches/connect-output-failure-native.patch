 func (p *AppPlayer) handlePlayerEvent(ctx context.Context, ev *player.Event) {
+	if ev.Type == player.EventTypeOutputFailed {
+		// The worker serializes this claim with every new output install. A late
+		// failure from an older output cannot retire a newer stream or alias.
+		if p.player == nil || !p.player.ClaimOutputFailure(ev.OutputEpoch, func() {
+			p.aliasMu.Lock()
+			p.roomVolumeClosing = true
+			p.aliasRetired = true
+			p.aliasMu.Unlock()
+		}) {
+			return
+		}
+		p.invalidateRoomTransportGeneration()
+		ctx, cancel := context.WithTimeout(ctx, 30*time.Second)
+		defer cancel()
+		if err := p.stopPlayback(ctx); err != nil {
+			p.app.log.WithError(err).Error("failed stopping after output loss")
+		}
+		if !p.app.cfg.ZeroconfEnabled {
+			p.Close() // No logout owner exists; join teardown before Run returns.
+		}
+		return
+	}
 	p.aliasMu.Lock()
 	quarantined := p.roomContentQuarantined
 	p.aliasMu.Unlock()
