+func TestStaleOutputFailureDoesNotRetireFreshOutput(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "output.fifo")
+	if err := syscall.Mkfifo(path, 0600); err != nil {
+		t.Fatal(err)
+	}
+	reader, err := os.OpenFile(path, os.O_RDONLY|syscall.O_NONBLOCK, 0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer reader.Close()
+	worker, err := player.NewPlayer(&player.Options{Log: &librespot.NullLogger{}, AudioBackend: "pipe",
+		AudioOutputPipe: path, AudioOutputPipeFormat: "s16le"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer worker.Close()
+	if err := worker.SetPrimaryStream(&failedOutputSource{}, false, false); err != nil {
+		t.Fatal(err)
+	}
+	var failed player.Event
+	select {
+	case failed = <-worker.Receive():
+	case <-time.After(2 * time.Second):
+		t.Fatal("missing player event")
+	}
+	for failed.Type != player.EventTypeOutputFailed {
+		select {
+		case failed = <-worker.Receive():
+		case <-time.After(2 * time.Second):
+			t.Fatal("missing actual output failure")
+		}
+	}
+	replacementReader, err := os.OpenFile(path, os.O_RDONLY|syscall.O_NONBLOCK, 0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer replacementReader.Close()
+	if err := worker.SetPrimaryStream(&contentInertSource{}, true, false); err != nil {
+		t.Fatal("fresh output rejected before stale event dispatch", err)
+	}
+	owner := &AppPlayer{player: worker}
+	owner.handlePlayerEvent(context.Background(), &failed)
+	if owner.aliasRetired || owner.roomVolumeClosing || owner.roomTransportGeneration != 0 || worker.Closed() {
+		t.Fatal("late error retired a newer output or touched its owner generation")
+	}
+}
+func (*failedOutputSource) PositionMs() int64         { return 0 }
+func (*failedOutputSource) SetPositionMs(int64) error { return nil }
+
+type failureSessionEvents struct{ player.EventManager }
+
+func (*failureSessionEvents) Close() {}
+
+func TestCurrentOutputFailureRetiresOwnerBeforeFreshExplicitTransfer(t *testing.T) {
+	var writer output.MovePipeIdentity
+	var normal, closed, inactive int
+	retirement := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		var body map[string]json.RawMessage
+		if err := json.NewDecoder(r.Body).Decode(&body); err != nil {
+			t.Error(err)
+			http.Error(w, "bad body", http.StatusBadRequest)
+			return
+		}
+		if len(body) == 8 {
+			normal++
+			http.Error(w, "old writer is already closed", http.StatusConflict)
+			return
+		}
+		if len(body) != 9 || string(body["writer_already_closed"]) != "true" {
+			t.Errorf("unexpected retirement body: %#v", body)
+			http.Error(w, "bad body", http.StatusConflict)
+			return
+		}
+		closed++
+		var reservation string
+		_ = json.Unmarshal(body["native_reservation_id"], &reservation)
+		reply := retirementReply("start", "prepare", reservation, writer)
+		reply.Outcome, reply.InputEpoch, reply.ContextsDrained, reply.DurableTerminal, reply.RetiredWitness = "retired", "2", true, true, true
+		_ = json.NewEncoder(w).Encode(reply)
+	}))
+	defer retirement.Close()
+	app, old, _ := retirementOwnerFixture(t, retirement.URL, "start")
+	writer = app.openedWriter
+	pipePath, err := os.Readlink("/proc/self/fd/" + writer.FD)
+	if err != nil {
+		t.Fatal(err)
+	}
+	log := &librespot.NullLogger{}
+	app.log, app.cfg, app.server = log, &Config{ZeroconfEnabled: true}, &aliasTestServer{}
+	old.state = pc13ExistingPlayer(t, true).state
+	old.sess = &session.Session{}
+	nextSessionField(old.sess, "sp", pc13Spclient(t, pc13RoundTrip(func(r *http.Request) (*http.Response, error) {
+		if r.Method != http.MethodPut || !strings.HasSuffix(r.URL.Path, "/inactive") || r.Header.Get("X-Spotify-Connection-Id") != "failure-owner" {
+			t.Errorf("unexpected inactive request %s %s", r.Method, r.URL)
+		}
+		inactive++
+		return &http.Response{StatusCode: http.StatusNoContent, Body: http.NoBody, Header: make(http.Header), Request: r}, nil
+	})))
+	nextSessionField(old.sess, "events", &failureSessionEvents{})
+	nextSessionField(old.sess, "dealer", dealer.NewDealer(log, &http.Client{}, nil, nil))
+	nextSessionField(old.sess, "ap", ap.NewAccesspoint(log, nil, "fixture"))
+	old.spotConnId = "failure-owner"
+	old.logout = make(chan *AppPlayer, 1)
+	old.prefetchTimer = time.NewTimer(time.Hour)
+	defer old.prefetchTimer.Stop()
+	app.startCustody.Capture.Player = old.player
+	app.startCustody.Capture.Session = old.sess
+	currentSource, err := old.player.Start35CurrentSource(context.Background())
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, _, err := old.player.Start35(context.Background(), "resume", nil, currentSource, output.PipeIdentity{}, "1", func(mutate func()) error { mutate(); return nil }); err != nil {
+		t.Fatal(err)
+	}
+	if err := old.player.SetPrimaryStream(&failedOutputSource{}, false, false); err != nil {
+		t.Fatal(err)
+	}
+	var failed player.Event
+	deadline := time.After(2 * time.Second)
+waitFailure:
+	for {
+		select {
+		case ev := <-old.player.Receive():
+			if ev.Type == player.EventTypeOutputFailed {
+				failed = ev
+				break waitFailure
+			}
+		case <-deadline:
+			t.Fatal("actual player output error did not reach daemon event channel")
+		}
+	}
+	before := old.roomTransportGeneration
+	old.roomContentQuarantined = true // A genuine output failure must pass this older early return.
+	old.handlePlayerEvent(context.Background(), &failed)
+	if !old.aliasRetired || !old.roomVolumeClosing || old.roomTransportGeneration != before+1 || old.state.active || inactive != 1 {
+		t.Fatal("current output failure did not retire the alias and publish inactive once")
+	}
+	select {
+	case got := <-old.logout:
+		if got != old {
+			t.Fatal("logout selected a different owner")
+		}
+	default:
+		t.Fatal("failed owner was not handed to existing logout path")
+	}
+	old.Close() // The existing Zeroconf supervisor joins this exact owner.
+	if !old.player.Closed() || old.roomCloseDone == nil || normal == 0 || !app.moveCustodyUnknown || app.startCustody == nil {
