+// ClaimOutputFailure runs on the output worker after all earlier commands.
+// A newer output or manual Stop invalidates the queued failure; an accepted
+// claim seals this worker before the owner begins its normal teardown.
+func (p *Player) ClaimOutputFailure(epoch uint64, seal func()) bool {
+	resp := make(chan any, 1)
+	if !p.sendCommand(playerCmd{claim: &outputFailureClaim{epoch: epoch, seal: seal}, resp: resp}) {
+		return false
+	}
+	result, ok := p.commandResult(resp)
+	return ok && result.(bool)
+}
