+		AudioOutputPipeFormat: "s16le", WithNewOutput: func(create func() (output.Output, error)) (output.Output, error) {
+			return app.withNewOutput(fresh, create)
+		}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer newWorker.Close()
+	fresh.player = newWorker
