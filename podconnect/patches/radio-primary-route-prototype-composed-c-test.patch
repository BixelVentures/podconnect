+
+/* Real private OwnTone HTTP server for the external Native actor test. The
+ * controlled edges are discovery (one transient receiver) and the MP3 URI. */
+struct primary_radio_http_fixture
+{
+  struct recovery_wire_fixture receiver;
+  struct event *poll;
+  const char *done_path;
+  unsigned packets;
+  bool completed;
+};
+
+static void
+primary_radio_http_poll(evutil_socket_t fd, short events, void *arg)
+{
+  struct primary_radio_http_fixture *f = arg;
+  struct timeval soon = {0, 10000};
+  uint16_t sequence;
+  (void)fd;
+  (void)events;
+
+  f->packets += primary_radio_wire_packets(&f->receiver, &sequence);
+  if (access(f->done_path, F_OK) == 0)
+    {
+      struct output_primary_radio_custody custody = {0};
+      assert(f->packets > 0 && f->receiver.pc70_peer_sessions == 1 && f->receiver.teardowns == 1);
+      assert(!f->receiver.failed && !f->receiver.device->session);
+      assert(outputs_primary_radio_custody_read(202, &custody) == 1 && custody.teardown_cseq > 0);
+      assert(!strcmp(custody.operation, "b3919fea-955b-4d4c-a581-c71cb92712b2"));
+      assert(!strcmp(custody.stop_action, "87f6f7dd-2a03-4d75-9a62-6a7a2e089705"));
+      f->completed = true;
+      printf("PASS production C HTTP primary owner: RTP packets=%u receiver_sessions=%d teardowns=%d\n",
+          f->packets, f->receiver.pc70_peer_sessions, f->receiver.teardowns);
+      fflush(stdout);
+      event_base_loopbreak(f->receiver.base);
+      return;
+    }
+  assert(evtimer_add(f->poll, &soon) == 0);
+}
+
+static int
+primary_radio_http_owner_case(void)
+{
+  const char *config = getenv("PC_RADIO_HTTP_CONFIG");
+  const char *ready_path = getenv("PC_PRIMARY_HTTP_READY");
+  struct primary_radio_http_fixture fixture = { .receiver.udp_fd = -1, .done_path = getenv("PC_PRIMARY_HTTP_DONE") };
+  struct timeval bound = {20, 0}, soon = {0, 10000};
+
+  assert(config && config[0] == '/' && ready_path && fixture.done_path);
+  assert(!getenv("PODCONNECT_RADIO_SENDER") && access("/tmp/radio-sender-fixture.mp3", R_OK) == 0);
+  assert(evthread_use_pthreads() == 0 && sodium_init() >= 0 && conffile_load((char *)config) == 0);
+  assert(!strcmp(cfg_getstr(cfg_getsec(cfg, "general"), "bind_address"), "127.0.0.1"));
+  assert(!cfg_getbool(cfg_getsec(cfg, "general"), "ipv6") && radio_http_uid() == 0);
+  assert(logger_init(cfg_getstr(cfg_getsec(cfg, "general"), "logfile"), NULL, E_LOG, "default") == 0);
+  assert(db_init(ATTENTION_TEST_SQLEXT_PATH) == 0 && db_perthread_init() == 0);
+
+  struct event_base *base = event_base_new();
+  assert(base);
+  evbase_main = evbase_player = base;
+  outputs_attention_uuid(outputs_process);
+  assert(outputs_attention_startup() == 0);
+  outputs_radio_protocols_startup();
+  assert(airplay_init() == -1); /* Retain this fixture's discovery fence. */
+  keep_alive_timer = evtimer_new(base, airplay_keep_alive_timer_cb, NULL);
+  outputs_deferredev = evtimer_new(base, deferred_cb, NULL);
+  assert(keep_alive_timer && outputs_deferredev);
+  radio_wire_private_service(&airplay_timing_svc, timing_svc_cb, base);
+  radio_wire_private_service(&airplay_control_svc, control_svc_cb, base);
+  for (size_t i = 0; outputs[i]; i++)
+    outputs[i]->disabled = outputs[i]->type != OUTPUT_TYPE_AIRPLAY;
+  outputs_buffer_duration_ms = cfg_getint(cfg_getsec(cfg, "general"), "start_buffer_ms");
+  primary_radio_wire_receiver(&fixture.receiver, base, 202, "127.0.0.1");
+  cmdbase = commands_base_new(base, NULL);
+  assert(cmdbase && worker_init() == 0 && input_init() == 0);
+  assert(httpd_init("/tmp") == 0); /* Real JSON API dispatch and authorization. */
+
+  struct event *deadline = evtimer_new(base, radio_http_timeout, base);
+  fixture.poll = evtimer_new(base, primary_radio_http_poll, &fixture);
+  assert(deadline && fixture.poll && evtimer_add(deadline, &bound) == 0 && evtimer_add(fixture.poll, &soon) == 0);
+
+  FILE *ready = fopen(ready_path, "w");
+  assert(ready);
+  fprintf(ready, "http://127.0.0.1:%d\n", cfg_getint(cfg_getsec(cfg, "library"), "port"));
+  assert(fclose(ready) == 0);
+  event_base_dispatch(base);
+
+  httpd_deinit();
+  input_deinit();
+  worker_deinit();
+  event_free(deadline);
+  event_free(fixture.poll);
+  return fixture.completed ? 0 : 1;
 }
 
