+func TestQueueWriterInspectionWhileKeeperFIFOIsFull(t *testing.T) {
+	path := queueFIFO(t)
+	p, err := NewPlayer(&Options{Log: &librespot.NullLogger{}, AudioBackend: "pipe", AudioOutputPipe: path,
+		AudioOutputPipeFormat: "s16le", ExternalVolume: true})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer p.Close()
+	old := &queueEOFSource{1}
+	if err = p.SetPrimaryStream(old, true, false); err != nil {
+		t.Fatal(err)
+	}
+	guard := func(mutate func()) error { mutate(); return nil }
+	writer, epoch, err := p.RoomMove(context.Background(), "inspect", old, output.MovePipeIdentity{}, "", false, guard)
+	if err != nil {
+		t.Fatal(err)
+	}
+	filler, err := syscall.Open(path, syscall.O_WRONLY|syscall.O_NONBLOCK, 0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	filled := 0
+	zero := make([]byte, 4096)
+	for {
+		n, e := syscall.Write(filler, zero)
+		if e == syscall.EAGAIN {
+			break
+		}
+		if e != nil {
+			syscall.Close(filler)
+			t.Fatal(e)
+		}
+		filled += n
+	}
+	syscall.Close(filler)
+	if filled == 0 {
+		t.Fatal("keeper FIFO was not filled")
+	}
+	next := &replacementPCM{entered: make(chan struct{})}
+	if err = p.GuardedQueueTransport(context.Background(), next, old, writer, epoch, guard); err != nil {
+		t.Fatal(err)
+	}
+	select {
+	case <-next.entered:
+	case <-time.After(time.Second):
+		t.Fatal("accepted queue successor did not begin PCM")
+	}
+	// Witness the real kernel write before asking the serialized worker for ownership.
+	blocked := false
+	dump := make([]byte, 1<<16)
+	for deadline := time.Now().Add(time.Second); time.Now().Before(deadline) && !blocked; {
+		n := runtime.Stack(dump, true)
+		for _, goroutine := range bytes.Split(dump[:n], []byte("\n\n")) {
+			if bytes.Contains(goroutine, []byte("(*pipeOutput).outputLoop")) &&
+				bytes.Contains(goroutine, []byte("(*File).Write")) {
+				blocked = true
+				break
+			}
+		}
+		if !blocked {
+			time.Sleep(time.Millisecond)
+		}
+	}
+	if !blocked {
+		t.Fatal("queue writer never reached the blocked kernel write")
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), 300*time.Millisecond)
+	defer cancel()
+	gotWriter, gotEpoch, err := p.RoomMove(ctx, "inspect", next, output.MovePipeIdentity{}, "", true, guard)
+	if err != nil || gotWriter != writer || gotEpoch != epoch {
+		t.Fatalf("passive queue writer inspection did not join the exact full FIFO: %v", err)
+	}
+
+	wrongGuard := func(func()) error {
+		t.Error("changed source reached ownership callback")
+		return nil
+	}
+	if _, _, err = p.RoomMove(ctx, "inspect", old, output.MovePipeIdentity{}, "", true, wrongGuard); err == nil {
+		t.Fatal("full FIFO admitted a displaced source")
+	}
+
+	reader, err := syscall.Open(path, syscall.O_RDONLY|syscall.O_NONBLOCK, 0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer syscall.Close(reader)
+	// The read must observe every prefill byte followed by the complete original
+	// successor chunk. Inspection cannot flush, replay, or replace pending PCM.
+	got := make([]byte, 0, filled+8192)
+	buffer := make([]byte, 8192)
+	for deadline := time.Now().Add(time.Second); time.Now().Before(deadline) && len(got) < filled+8192; {
+		n, e := syscall.Read(reader, buffer)
+		if n > 0 {
+			got = append(got, buffer[:n]...)
+		}
+		if e != nil && e != syscall.EAGAIN {
+			t.Fatal(e)
+		}
+		if n <= 0 {
+			time.Sleep(time.Millisecond)
+		}
+	}
+	if len(got) != filled+8192 || !bytes.Equal(got[:filled], make([]byte, filled)) {
+		t.Fatalf("inspection changed pending FIFO length or prefill: got %d bytes", len(got))
+	}
+	for i := filled; i < len(got); i += 2 {
+		if got[i] != 0 || got[i+1] != 64 {
+			t.Fatal("inspection changed successor PCM")
+		}
+	}
+}
