+/* Only the synchronous original attention recovery constructor may attach a
+ * control-only session through unrelated START custody. Never an audio grant. */
+struct attention_restore_constructor {
+  struct output_device *device;
+  struct output_attention_state expected;
+  struct start_slot *start;
+  char start_token[33];
+  enum output_start_phase start_phase;
+  uint64_t metadata_epoch;
+  bool source_owned, gate_closed;
+};
+static __thread const struct attention_restore_constructor *attention_restore_scope;
+
+static bool
+attention_restore_constructor_current(uint64_t device_id)
+{
+  const struct attention_restore_constructor *scope = attention_restore_scope;
+  struct output_attention_state state;
+  struct output_device *device = outputs_device_get(device_id);
+  return scope && device && device == scope->device && !device->session
+    && outputs_attention_state_get(device_id, &state) == 0
+    && attention_identity_equal(&state, &scope->expected)
+    && start_active == scope->start
+    && (!start_active || (!strcmp(start_active->result.command.token, scope->start_token)
+        && start_active->result.phase == scope->start_phase))
+    && outputs_start_metadata_generation() == scope->metadata_epoch
+    && outputs_start_source_owned() == scope->source_owned
+    && outputs_start_gate_closed() == scope->gate_closed;
+}
+
+static int
+attention_recovery_prepare_exact(struct output_device *device,
+    const struct output_attention_request *request, enum output_attention_recovery_state recovery_state)
+{
+  struct attention_restore_constructor scope = { .device = device, .expected = request->expected };
+  struct output_attention_proof proof;
+  enum output_attention_recovery_state original_state;
+  bool original;
+  int ret;
+
+  if (attention_restore_scope) return -1; /* No nested constructor authority. */
+  if (device->session) return outputs[device->type]->device_attention_recovery_prepare(device);
+  original = request->action == OUTPUT_ATTENTION_RECOVER
+    ? recovery_state == OUTPUT_RECOVERY_PENDING
+    : request->action == OUTPUT_ATTENTION_RELEASE && request->expected.lease
+      && db_attention_origin_get(device->id, &device->attention_origin, &original_state, &proof) == 0
+      && original_state == OUTPUT_RECOVERY_PENDING;
+  if (!original) return outputs[device->type]->device_attention_recovery_prepare(device);
+  scope.start = start_active;
+  if (start_active) {
+    memcpy(scope.start_token, start_active->result.command.token, sizeof(scope.start_token));
+    scope.start_phase = start_active->result.phase;
+  }
+  scope.metadata_epoch = outputs_start_metadata_generation();
+  scope.source_owned = outputs_start_source_owned();
+  scope.gate_closed = outputs_start_gate_closed();
+  attention_restore_scope = &scope;
+  if (!attention_restore_constructor_current(device->id))
+    {
+      DPRINTF(E_LOG, L_PLAYER, "Attention restore constructor denied: stale_scope\n");
+      ret = -1;
+    }
+  else
+    {
+      ret = outputs[device->type]->device_attention_recovery_prepare(device);
+      if (ret < 0) DPRINTF(E_LOG, L_PLAYER, "Attention restore constructor denied: backend_prepare\n");
+    }
+  attention_restore_scope = NULL; /* Before durable admission, I/O, or callbacks. */
+  return ret;
+}
