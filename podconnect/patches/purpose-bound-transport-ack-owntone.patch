diff --git a/src/outputs.c b/src/outputs.c
index 1f995c3..4c23e81 100644
--- a/src/outputs.c
+++ b/src/outputs.c
@@ -394,7 +394,7 @@ outputs_transport_commit(const struct output_transport_request *request, struct
     if (!strcmp(request->action,"queue") && (!queue_writer_current(&request->writer,&identity,&queue_reader_epoch)
