+// Use bounded calls so a vanished advertiser cannot wedge teardown or recovery.
+func avahiCall(obj dbus.BusObject, method string, flags dbus.Flags, args ...interface{}) *dbus.Call {
+	ctx, cancel := context.WithTimeout(context.Background(), 2*time.Second)
+	defer cancel()
+	return obj.CallWithContext(ctx, method, flags, args...)
+}
+
+func (a *AvahiRegistrar) maintain() {
+	tick := time.NewTicker(5 * time.Second)
+	defer tick.Stop()
+	for {
+		select {
+		case <-a.stop:
+			return
+		case <-tick.C:
+			a.refreshRegistration()
+		}
+	}
+}
+
+func (a *AvahiRegistrar) refreshRegistration() {
+	a.mu.Lock()
+	defer a.mu.Unlock()
+	if a.stopped || a.name == "" {
+		return
+	}
+	// A private connection can be replaced after the system bus itself restarts.
+	if !a.conn.Connected() {
+		conn, err := connectAvahiBus()
+		if err != nil {
+			return
+		}
+		a.conn = conn
+		a.entryGroup = nil
+	}
+	if a.entryGroup != nil {
+		var state int32
+		err := avahiCall(a.entryGroup, avahiEntryGroupIface+".GetState", 0).Store(&state)
+		// REGISTERING and ESTABLISHED are legitimate states. Do not churn a healthy
+		// announcement or interrupt playback during a transient registration.
+		if err == nil && (state == 1 || state == 2) {
+			return
+		}
+		_ = avahiCall(a.entryGroup, avahiEntryGroupIface+".Free", 0).Err
+		a.entryGroup = nil
+	}
+	// Retain current identity/port/TXT. Retry next tick on daemon absence/failure;
+	// this restores discovery only and never invokes a playback command.
+	_ = a.register()
+}
+
+// The bus can accept a socket yet stop answering authentication/Hello. Cancel
+// that connection after the same bounded interval as individual DBus calls.
+func connectAvahiBus() (avahiConnection, error) {
+	ctx, cancel := context.WithCancel(context.Background())
+	timer := time.AfterFunc(2*time.Second, cancel)
+	conn, err := dbus.ConnectSystemBus(dbus.WithContext(ctx))
+	if !timer.Stop() || err != nil {
+		cancel()
+		if conn != nil {
+			_ = conn.Close()
+		}
+		if err != nil {
+			return nil, err
+		}
+		return nil, fmt.Errorf("system bus connection timed out")
+	}
+	// The successful connection retains cancellation until its owner closes it.
+	return &ownedAvahiBus{Conn: conn, cancel: cancel}, nil
+}
+
+type ownedAvahiBus struct {
+	*dbus.Conn
+	cancel context.CancelFunc
+}
+
+func (b *ownedAvahiBus) Close() error {
+	b.cancel()
+	return b.Conn.Close()
+}
diff --git a/daemon/transport_recovery_test.go b/daemon/transport_recovery_test.go
new file mode 100644
--- /dev/null
+++ b/daemon/transport_recovery_test.go
@@ -0,0 +1,48 @@
+package daemon
+
+import (
+	"context"
+	librespot "github.com/devgianlu/go-librespot"
+	"net/http/httptest"
+	"testing"
+	"time"
+)
+
+func TestFailedTransportRejectsCommandsAndAcceptsTeardown(t *testing.T) {
+	p := &AppPlayer{stop: make(chan struct{})}
+	requests := make(chan ApiRequest)
+	done := make(chan struct{})
+	go func() { p.runFailedTransport(requests, nil); close(done) }()
+	for _, kind := range []ApiRequestType{ApiRequestTypeStatus, ApiRequestTypePlay, ApiRequestTypeResume, ApiRequestTypeStop} {
+		req, wait := NewApiRequest(kind, nil)
+		requests <- req
+		ctx, cancel := context.WithTimeout(context.Background(), time.Second)
+		data, err := wait(ctx)
+		cancel()
+		if err == nil || data != nil {
+			t.Fatalf("%s must fail without executing: %v %v", kind, data, err)
+		}
+	}
+	close(requests) // A closed API channel must not prevent teardown or spin.
+	p.stop <- struct{}{}
+	select {
+	case <-done:
+	case <-time.After(time.Second):
+		t.Fatal("teardown blocked")
+	}
+}
+
+func TestFailedTransportStatusIsHTTPFailure(t *testing.T) {
+	requests := make(chan ApiRequest)
+	p := &AppPlayer{stop: make(chan struct{})}
+	done := make(chan struct{})
+	go func() { p.runFailedTransport(requests, nil); close(done) }()
+	server := &ConcreteApiServer{requests: requests, log: &librespot.NullLogger{}}
+	response := httptest.NewRecorder()
+	server.handleRequest(ApiRequest{Type: ApiRequestTypeStatus}, response)
+	if response.Code != 500 {
+		t.Fatalf("failed session reported HTTP %d", response.Code)
+	}
+	p.stop <- struct{}{}
+	<-done
+}
diff --git a/zeroconf/backend_avahi_recovery_test.go b/zeroconf/backend_avahi_recovery_test.go
new file mode 100644
--- /dev/null
+++ b/zeroconf/backend_avahi_recovery_test.go
@@ -0,0 +1,105 @@
+package zeroconf
+
+import (
+	"context"
+	"fmt"
+	"github.com/godbus/dbus/v5"
+	"testing"
+)
+
+type recoveryObject struct {
+	dbus.BusObject
+	call func(string, []interface{}) *dbus.Call
+}
+
+func (o recoveryObject) CallWithContext(ctx context.Context, method string, flags dbus.Flags, args ...interface{}) *dbus.Call {
+	if _, ok := ctx.Deadline(); !ok {
+		panic("unbounded DBus call")
+	}
+	return o.call(method, args)
+}
+
+type recoveryBus struct {
+	object dbus.BusObject
+	closed bool
+}
+
+func (b *recoveryBus) Object(string, dbus.ObjectPath) dbus.BusObject { return b.object }
+func (b *recoveryBus) Connected() bool                               { return !b.closed }
+func (b *recoveryBus) Close() error                                  { b.closed = true; return nil }
+
+func TestAvahiRecovery(t *testing.T) {
+	for _, state := range []int32{0, 1, 2, 3, 4, -1} {
+		t.Run(fmt.Sprint(state), func(t *testing.T) {
+			registrations := 0
+			obj := recoveryObject{call: func(method string, args []interface{}) *dbus.Call {
+				switch method {
+				case avahiEntryGroupIface + ".GetState":
+					if state == -1 {
+						return &dbus.Call{Err: fmt.Errorf("old Avahi owner disappeared")}
+					}
+					return &dbus.Call{Body: []interface{}{state}}
+				case avahiServerIface + ".EntryGroupNew":
+					return &dbus.Call{Body: []interface{}{dbus.ObjectPath("/fresh")}}
+				case avahiEntryGroupIface + ".AddService":
+					registrations++
+					if args[3] != "Kitchen" || args[7] != uint16(1234) {
+						t.Fatalf("identity changed: %v", args)
+					}
+				}
+				return &dbus.Call{}
+			}}
+			bus := &recoveryBus{object: obj}
+			a := &AvahiRegistrar{conn: bus, entryGroup: obj, stop: make(chan struct{}), name: "Kitchen", serviceType: "_spotify-connect._tcp", domain: "local.", port: 1234, txt: []string{"VERSION=1.0"}}
+			a.refreshRegistration()
+			want := 1
+			if state == 1 || state == 2 {
+				want = 0
+			}
+			if registrations != want {
+				t.Fatalf("registrations=%d want=%d", registrations, want)
+			}
+			a.Shutdown()
+			a.refreshRegistration()
+			a.Shutdown()
+			if registrations != want {
+				t.Fatal("registration after shutdown")
+			}
+		})
+	}
+}
+
+func TestAvahiRecoveryRetriesFailedRegistrationAndKeepsRenamedIdentity(t *testing.T) {
+	fail := true
+	adds := 0
+	obj := recoveryObject{call: func(method string, args []interface{}) *dbus.Call {
+		switch method {
+		case avahiEntryGroupIface + ".GetState":
+			return &dbus.Call{Err: fmt.Errorf("lost group")}
+		case avahiServerIface + ".EntryGroupNew":
+			if fail {
+				return &dbus.Call{Err: fmt.Errorf("daemon absent")}
+			}
+			return &dbus.Call{Body: []interface{}{dbus.ObjectPath("/new")}}
+		case avahiEntryGroupIface + ".AddService":
+			adds++
+			if args[3] != "Renamed" {
+				t.Fatal("stale name restored")
+			}
+		}
+		return &dbus.Call{}
+	}}
+	a := &AvahiRegistrar{conn: &recoveryBus{object: obj}, stop: make(chan struct{}), name: "Old", serviceType: "_spotify-connect._tcp", port: 1234}
+	if err := a.UpdateName("Renamed"); err == nil {
+		t.Fatal("expected unavailable daemon")
+	}
+	a.refreshRegistration()
+	if adds != 0 {
+		t.Fatal("published while unavailable")
+	}
+	fail = false
+	a.refreshRegistration()
+	if adds != 1 {
+		t.Fatal("did not recover")
+	}
+}
