+// Keep the failed generation responsive to teardown and truthful to the watchdog.
+// Closed transport channels mean upstream has exhausted reconnection, not a brief
+// disconnect. Never execute or replay commands against this stranded session.
+func (p *AppPlayer) runFailedTransport(apiRecv <-chan ApiRequest, mprisRecv <-chan mpris.MediaPlayer2PlayerCommand) {
+	for {
+		select {
+		case <-p.stop:
+			return
+		case req, ok := <-apiRecv:
+			if !ok {
+				apiRecv = nil
+				continue
+			}
+			req.Reply(nil, fmt.Errorf("Spotify transport exhausted; session recovery required"))
+		case req, ok := <-mprisRecv:
+			if !ok {
+				mprisRecv = nil
+				continue
+			}
+			req.Reply(mpris.MediaPlayer2PlayerCommandResponse{Err: &dbus.Error{Name: "org.mpris.MediaPlayer2.Error.Failed", Body: []interface{}{"Spotify transport exhausted"}}})
+		}
+	}
+}
