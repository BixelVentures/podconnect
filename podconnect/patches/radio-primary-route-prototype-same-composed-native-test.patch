@@ -0,0 +1,193 @@
+package daemon
+
+import (
+	"context"
+	"encoding/json"
+	"net/http"
+	"os"
+	"path/filepath"
+	"strconv"
+	"testing"
+	"time"
+
+	evtimpl "github.com/devgianlu/go-librespot/events/impl"
+	"github.com/devgianlu/go-librespot/mpris"
+	"github.com/devgianlu/go-librespot/player"
+	connectpb "github.com/devgianlu/go-librespot/proto/spotify/connectstate"
+)
+
+func testPrimarySameTargetWithActualSTART(t *testing.T, p *AppPlayer, worker *player.Player, stream *player.Stream) {
+	t.Helper()
+	endpoint, token := os.Getenv("PC_NATIVE_PRIMARY_HTTP_URL"), os.Getenv("PC_PRIMARY_HTTP_TOKEN")
+	if !radioWireLoopbackURL(endpoint) || !volumeHex64.MatchString(token) {
+		t.Fatal("missing isolated production OwnTone radio HTTP")
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), 13*time.Second)
+	defer cancel()
+	unauthorized, err := http.NewRequestWithContext(ctx, http.MethodPost, endpoint+"/api/outputs/1/radio-handoff/reacquire", nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	response, err := http.DefaultClient.Do(unauthorized)
+	if err != nil {
+		t.Fatal(err)
+	}
+	response.Body.Close()
+	if response.StatusCode != http.StatusForbidden {
+		t.Fatalf("production primary route token gate returned HTTP %d", response.StatusCode)
+	}
+	type counts struct {
+		Before int `json:"primary_before"`
+		Radio  int `json:"primary_radio"`
+		After  int `json:"primary_after"`
+	}
+	poll := func(check func(counts) bool) counts {
+		t.Helper()
+		client := &http.Client{Timeout: time.Second}
+		tick := time.NewTicker(20 * time.Millisecond)
+		defer tick.Stop()
+		for {
+			request, err := http.NewRequestWithContext(ctx, http.MethodGet, os.Getenv("PC_NATIVE_START_URL")+"/fixture/rtp", nil)
+			if err != nil {
+				t.Fatal(err)
+			}
+			response, err := client.Do(request)
+			if err != nil {
+				t.Fatal(err)
+			}
+			var observed counts
+			err = json.NewDecoder(response.Body).Decode(&observed)
+			response.Body.Close()
+			if err != nil || response.StatusCode != http.StatusOK {
+				t.Fatalf("RTP observation returned HTTP %d (%v)", response.StatusCode, err)
+			}
+			if check(observed) {
+				return observed
+			}
+			select {
+			case <-ctx.Done():
+				t.Fatalf("RTP window never observed: %#v", observed)
+			case <-tick.C:
+			}
+		}
+	}
+	poll(func(c counts) bool { return c.Before > 0 && c.Radio == 0 && c.After == 0 })
+
+	app := p.app
+	app.cfg.RoomTransportOwnToneURL = endpoint
+	app.cfg.RadioHandoffOwnerURL = endpoint
+	app.cfg.RadioHandoffControlToken = token
+	app.cfg.RadioHandoffStatePath = filepath.Join(t.TempDir(), "primary-radio.json")
+	if err := app.initRadio(); err != nil {
+		t.Fatal(err)
+	}
+	owner, err := p.radioSourceOwner()
+	process, ok := nativeContentProcess()
+	if err != nil || !ok || owner.HomePodID != "1" {
+		t.Fatal("initial START35 did not retain the expected bound receiver", err)
+	}
+	originalTracks, originalSession, originalClient := p.state.tracks, p.state.player.SessionId, p.sess
+	originalGeneration := app.openedWriterGeneration
+	assertSource := func(paused bool) {
+		t.Helper()
+		source, err := worker.Start35CurrentSource(ctx)
+		if err != nil || source != stream.Source || p.primaryStream != stream ||
+			p.state.tracks != originalTracks || p.state.player.SessionId != originalSession || p.sess != originalClient ||
+			p.state.player.IsPaused != paused {
+			t.Fatalf("retained Native source, queue, session or pause state changed (want paused=%t): %v", paused, err)
+		}
+	}
+	ask := func(q radioPrimaryCommand) radioPrimaryReply {
+		t.Helper()
+		reply, err := p.radioPrimaryActor(ctx, q)
+		ack, ok := reply.(radioPrimaryReply)
+		if err != nil || !ok {
+			t.Fatalf("Native %s/%s failed: %v", q.Phase, q.ForPhase, err)
+		}
+		return ack
+	}
+	wait := func(q radioPrimaryCommand, expected string) radioPrimaryReply {
+		t.Helper()
+		ack := ask(q)
+		q.ForPhase, q.Phase = q.Phase, "result"
+		tick := time.NewTicker(20 * time.Millisecond)
+		defer tick.Stop()
+		for ack.Phase == "pending" {
+			select {
+			case <-ctx.Done():
+				t.Fatalf("Native %s did not settle", q.ForPhase)
+			case <-tick.C:
+				ack = ask(q)
+			}
+		}
+		if ack.Phase != expected {
+			t.Fatalf("Native %s expected %s, got %s", q.ForPhase, expected, ack.Phase)
+		}
+		return ack
+	}
+	const startAction = "b3919fea-955b-4d4c-a581-c71cb92712b2"
+	q := radioPrimaryCommand{Schema: nativePrimarySchema, Phase: "reserve", Process: radioProcessID(process),
+		Handoff: "a411aa42-8b70-4bf4-a37d-81b0519db7df", Generation: "1", Action: startAction,
+		Target: owner.RoomID, Intent: strconv.FormatUint(app.radio.Intent, 10), From: owner.RoomID}
+	q.Owner = wait(q, "reserved").Owner
+	q.Phase, q.Station = "prepare_start", "p3"
+	wait(q, "prepared")
+	assertSource(false)
+
+	q.Phase = "start"
+	playing := wait(q, "playing")
+	if playing.Session == nil || !playing.Session.valid() || playing.Session.Operation != startAction ||
+		playing.Session.DeviceID != owner.HomePodID {
+		t.Fatal("missing exact same-target C radio session")
+	}
+	if _, err = p.radioPrimaryActor(ctx, q); err == nil {
+		t.Fatal("duplicate start crossed the parked-writer fence")
+	}
+	assertSource(true)
+	parked, err := worker.InspectRadio(ctx)
+	if err != nil || !parked.Suspended || !parked.WriterClosed || !app.radioOutputFence.Load() {
+		t.Fatalf("same-target radio played without exact Native writer closure: %v", err)
+	}
+	poll(func(c counts) bool { return c.Radio > 0 && c.After == 0 })
+
+	if os.Getenv("PC_NATIVE_PRIMARY_EXPECT_RESUME") == "" {
+		const stopAction = "87f6f7dd-2a03-4d75-9a62-6a7a2e089705"
+		q.Phase, q.Station, q.Owner = "reserve", "", ""
+		q.Handoff, q.Generation, q.Action = "bdb0c4c5-df0e-4f42-a88e-44a8736ca5b8", "2", stopAction
+		q.Owner = wait(q, "reserved").Owner
+		q.Phase, q.Session = "stop", playing.Session
+		stopped := wait(q, "released")
+		if stopped.CSeq <= 0 || stopped.Session == nil || *stopped.Session != *playing.Session {
+			t.Fatal("missing exact teardown of the observed radio session")
+		}
+		assertSource(true)
+		return
+	}
+
+	app.mpris = mpris.DummyServer{}
+	server, err := NewApiServer(app.log, "127.0.0.1", 0, "", "", "")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer server.Close()
+	app.server = server
+	p.state.player.Track = &connectpb.ProvidedTrack{Uri: "spotify:track:0000000000000000000003"}
+	p.state.player.PlayOrigin = &connectpb.PlayOrigin{}
+	p.state.player.Options = &connectpb.ContextPlayerOptions{}
+	p.prefetchTimer = time.NewTimer(time.Hour)
+	defer p.prefetchTimer.Stop()
+	events, _ := (evtimpl.Impl{}).NewEventManager(app.log, nil, nil, nil, "")
+	nextSessionField(p.sess, "events", events)
+	nextSessionField(p.sess, "sp", pc13Spclient(t, pc13RoundTrip(func(r *http.Request) (*http.Response, error) {
+		return &http.Response{StatusCode: http.StatusNoContent, Body: http.NoBody, Header: make(http.Header), Request: r}, nil
+	})))
+
+	if _, err = p.handleApiRequest(ctx, ApiRequest{Type: ApiRequestTypeResume}); err != nil {
+		t.Fatal("explicit Native Resume failed", err)
+	}
+	assertSource(false)
+	if app.openedWriterOwner != p || app.openedWriterGeneration != originalGeneration+1 || app.radioOutputFence.Load() {
+		t.Fatal("explicit Resume did not reopen exact retained writer custody")
+	}
+	poll(func(c counts) bool { return c.After > 0 })
+}
