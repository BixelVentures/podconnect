+{
+  struct airplay_session *session = device->session;
+
+  if (!session || !session->primary_radio || session->primary_radio_revoked
+      || !session->control_cipher_ctx || !(session->state & AIRPLAY_STATE_F_CONNECTED)
+      || device->incarnation != session->device_incarnation
+      || device->session_epoch != session->session_epoch
+      || !device->advertised || !device->selected || device->route_revision == UINT64_MAX
+      || device->route_revision != session->primary_radio_route_revision + 1)
+    return -1;
+
+  session->primary_radio_revoked = true;
+  session->attention_retiring = true;
+  device->attention_retiring_session = session;
