+// MoveControlPipeOutput adds the existing pipe control interruption only for an
+// admitted MOVE quiesce. Read-only transport observations keep WithStartLock.
+type MoveControlPipeOutput interface {
+	MovePipeOutput
+	OpenedWriterIdentity() MovePipeIdentity
+	WithMoveControlLock(context.Context, func(PipeIdentity, func(bool)) error) error
+	WithMoveLock(context.Context, func(PipeIdentity, func(bool)) error) error
+}
+
+func (out *pipeOutput) WithMoveControlLock(ctx context.Context, apply func(PipeIdentity, func(bool)) error) (err error) {
+	if err = ctx.Err(); err != nil {
+		return err
+	}
+	if err = LockTransport(ctx, &out.control); err != nil {
+		return err
+	}
+	if err = ctx.Err(); err != nil {
+		out.control.Unlock()
+		return err
+	}
+	out.controlPending.Store(true)
+	var announcementErr error
+	if !out.fileClosed {
+		if e := out.file.SetWriteDeadline(time.Now()); e != nil && !errors.Is(e, os.ErrClosed) {
+			announcementErr = e
+		}
+	}
+
+	// This is the same single waiter/ownership transfer as LockTransport.
+	// Cancellation returns to the caller; the waiter joins the interrupted
+	// write before restoring its deadline and broadcasting under the lock.
+	if !out.lock.TryLock() {
+		acquired := make(chan struct{})
+		go func() {
+			out.lock.Lock()
+			select {
+			case acquired <- struct{}{}:
+			case <-ctx.Done():
+				_ = out.unlockControl()
+			}
+		}()
+		select {
+		case <-acquired:
+		case <-ctx.Done():
+			return errors.Join(announcementErr, ctx.Err())
+		}
+	}
+	defer func() { err = errors.Join(err, out.unlockControl()) }()
+	if err = ctx.Err(); err != nil {
+		return errors.Join(announcementErr, err)
+	}
+	if announcementErr != nil {
+		return announcementErr
+	}
+	return out.withStartLockLocked(apply, true)
+}
+
+// WithMoveLock retains the already quiesced writer's unread PCM through its
+// alias switch, resume or abort. It does not announce a control interruption.
+func (out *pipeOutput) WithMoveLock(ctx context.Context, apply func(PipeIdentity, func(bool)) error) error {
+	if err := LockTransport(ctx, &out.lock); err != nil {
+		return err
+	}
+	defer out.lock.Unlock()
+	if err := ctx.Err(); err != nil {
+		return err
+	}
+	return out.withStartLockLocked(apply, true)
+}
