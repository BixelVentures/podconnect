+      resume->command.current_source_identity = *old;
+      memcpy(resume->command.intent_id, request->intent, sizeof(resume->command.intent_id));
+      resume->command.native_revision = request->native_revision;
+      resume->pause_native = true;
+      resume->phase = OUTPUT_RADIO_REACQUIRE_CONSUMED;
+      if (radio_handoff_save() < 0)
+        {
+          radio_reacquire_unknown(slot);
+          return -1;
+        }
+      resume->phase = OUTPUT_RADIO_REACQUIRE_CONNECTING;
+      if (radio_handoff_save() < 0)
+        {
+          radio_reacquire_unknown(slot);
+          return -1;
+        }
+
+      primary_spotify_return_scope = id;
+      outputs_device_select(d, -1);
+      int started = radio_primary_park_sole_selected(d) && d->route_revision == old->route_revision + 2
+          && transport_selection_revision == old->selection_revision + 3
+          && primary_spotify_return_source_current(slot, d, request)
+        ? outputs_device_start(d, primary_spotify_return_connected, false) : -1;
+      primary_spotify_return_scope = 0;
+      if (started <= 0)
+        radio_reacquire_unknown(slot);
+    }
+  else if (request->native_revision != slot->primary_return.native_revision
+      || strcmp(request->intent, slot->primary_return.intent)
+      || !primary_spotify_return_receipt_equal(&request->radio, &slot->primary_return.radio))
+    return -1;
+
+  out->phase = resume->phase;
+  if (out->phase == OUTPUT_RADIO_REACQUIRE_CONNECTING || out->phase == OUTPUT_RADIO_REACQUIRE_ROUTE_READY)
+    {
+      if (!d || !primary_spotify_return_route_current(id, d->session, slot->result.effect_generation))
+        out->phase = OUTPUT_RADIO_REACQUIRE_UNKNOWN;
+      else if (out->phase == OUTPUT_RADIO_REACQUIRE_ROUTE_READY)
+        {
+          struct output_transport_identity actual;
+          if (!outputs_airplay_primary_spotify_session_current(d, d->session)
+              || radio_transport_identity_get(id, &actual, true) < 0
+              || !transport_identity_equal(&actual, &resume->route_identity))
+            out->phase = OUTPUT_RADIO_REACQUIRE_UNKNOWN;
+          else
+            out->route = actual;
+        }
+    }
+  if (out->phase == OUTPUT_RADIO_REACQUIRE_UNKNOWN)
+    slot->primary_return_revoked = true;
+  return 0;
+}
