+// Only the authenticated dealer command path calls this method. An absent/zero
+// request alias means the proved current binding, never a positional fallback.
+// Generic REST/MPRIS/worker observations continue through play(ctx) without credit.
+func (p *AppPlayer) handleExplicitConnectResume(ctx context.Context, req dealer.RequestPayload) error {
+	p.app.log.Infof("connect-recovery native reason=resume_received")
+	if req.MessageId == 0 {
+		p.app.log.Infof("connect-recovery native reason=resume_no_credit_zero_id")
+	}
+	if !req.Command.Options.SystemInitiated && !req.Command.PlayOptions.SystemInitiated &&
+		req.SentByDeviceId != "" && len(req.SentByDeviceId) <= 160 && req.MessageId != 0 {
+		key := sha256.Sum256([]byte(fmt.Sprintf("%s\x00%d", req.SentByDeviceId, req.MessageId)))
+		p.aliasMu.Lock()
+		duplicate := p.connectRecoverySeen[key]
+		p.aliasMu.Unlock()
+		if duplicate {
+			return ErrAliasConflict
+		}
+	}
+	if req.Command.Options.SystemInitiated || req.Command.PlayOptions.SystemInitiated ||
+		req.SentByDeviceId == "" || len(req.SentByDeviceId) > 160 || req.MessageId == 0 ||
+		p.state == nil || p.state.player == nil || p.state.device == nil ||
+		!p.state.active || !p.state.player.IsPaused || p.primaryStream == nil ||
+		p.primaryLoadOrdinal == 0 || !p.playbackReady() {
+		p.commitPlayerCommand(req)
+		return p.play(ctx)
+	}
+	state, playerState, deviceState := p.state, p.state.player, p.state.device
+	worker, session, stream := p.player, p.sess, p.primaryStream
+	load, connection := p.primaryLoadOrdinal, p.spotConnId
+	selected, sessionID, contextURI := deviceState.SelectedAliasId, playerState.SessionId, playerState.ContextUri
+	if selected == 0 || connection == "" || sessionID == "" || contextURI == "" || worker == nil || worker.Closed() || session == nil {
+		return ErrAliasConflict
+	}
+	for _, alias := range []*uint32{req.TargetAliasId, req.Command.TargetAliasId} {
+		if alias != nil && *alias != 0 && *alias != selected {
+			return ErrAliasConflict
+		}
+	}
+	for _, requested := range []string{req.Command.SessionId, req.Command.Options.SessionId} {
+		if requested != "" && requested != sessionID {
+			return ErrAliasConflict
+		}
+	}
+	p.aliasMu.Lock()
+	binding := p.aliasBindingLocked()
+	revision := p.aliasRevision
+	key := sha256.Sum256([]byte(fmt.Sprintf("%s\x00%d", req.SentByDeviceId, req.MessageId)))
+	if p.aliasRetired || p.aliasRevisionExhausted || p.roomTransportGenerationExhausted ||
+		p.roomMoveQuarantined || p.roomContentQuarantined || binding == nil || !binding.Ready || binding.RoomID == "" ||
+		int(selected) > len(p.app.cfg.DeviceAliases) || p.connectRecoveryOrdinal >= 9007199254740991 ||
+		p.connectRecoverySeen[key] || len(p.connectRecoverySeen) >= 1024 {
+		p.aliasMu.Unlock()
+		return ErrAliasConflict
+	}
+	if p.connectRecoverySeen == nil {
+		p.connectRecoverySeen = make(map[[32]byte]bool)
+	}
+	// Reserve before dispatch. Failure/duplicate can never reuse this operation
+	// receipt, but reservation alone publishes no route authority.
+	p.connectRecoverySeen[key] = true
+	p.connectRecoveryOrdinal++
+	ordinal := p.connectRecoveryOrdinal
+	p.aliasMu.Unlock()
+	current := func() bool {
+		if ctx.Err() != nil || !p.playbackReady() || p.state != state || p.state.player != playerState ||
+			p.state.device != deviceState || p.player != worker || worker.Closed() || p.sess != session ||
+			p.primaryStream != stream || p.primaryLoadOrdinal != load || p.spotConnId != connection ||
+			playerState.SessionId != sessionID || playerState.ContextUri != contextURI {
+			return false
+		}
+		p.aliasMu.Lock()
+		defer p.aliasMu.Unlock()
+		now := p.aliasBindingLocked()
+		return !p.aliasRetired && !p.aliasRevisionExhausted && !p.roomTransportGenerationExhausted &&
+			!p.roomMoveQuarantined && !p.roomContentQuarantined && p.aliasRevision == revision && deviceState.SelectedAliasId == selected &&
+			now != nil && *now == *binding
+	}
+	if !current() {
+		return ErrAliasConflict
+	}
+	p.commitPlayerCommand(req)
+	if !current() {
+		return ErrAliasConflict
+	}
+	if err := p.playObserved(ctx, ordinal); err != nil {
+		return err
+	}
+	if !current() || playerState.IsPaused {
+		return ErrAliasConflict
+	}
+	p.app.log.Infof("connect-recovery native reason=resume_accepted")
+	p.app.server.Emit(&ApiEvent{Type: "connect_transfer", Data: map[string]any{
+		"kind": "resume", "id": selected, "alias_binding": binding, "ordinal": ordinal,
+		"resume_ordinal": ordinal, "primary_load_ordinal": load,
+	}})
+	return nil
+}
