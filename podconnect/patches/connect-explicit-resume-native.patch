+// Same actual dealer/worker/FIFO adapter as the paused transfer regression.
+// The resume operation receipt is distinct from its primary-load receipt.
+func TestExplicitConnectResumeAuthorityUsesActualWorkerReceipt(t *testing.T) {
+	for _, mode := range []string{"accepted", "zero_alias", "duplicate", "system", "wrong_alias", "wrong_session", "cancelled", "unready", "queued_initial", "genuine_pause", "zero_message", "missing_sender", "generic_play", "conflicting_aliases", "quarantined", "retired_after_ack", "source_changed_after_ack"} {
+		t.Run(mode, func(t *testing.T) {
+			ctx := context.Background()
+			log := &librespot.NullLogger{}
+			events, _ := (evtimpl.Impl{}).NewEventManager(log, nil, nil, nil, "")
+			var afterACK func()
+			sp := pc13Spclient(t, pc13RoundTrip(func(r *http.Request) (*http.Response, error) {
+				if afterACK != nil {
+					afterACK()
+				}
+				return &http.Response{StatusCode: 200, Body: http.NoBody, Header: make(http.Header), Request: r}, nil
+			}))
+			path := filepath.Join(t.TempDir(), "pcm.fifo")
+			if err := syscall.Mkfifo(path, 0600); err != nil {
+				t.Fatal(err)
+			}
+			reader, err := os.OpenFile(path, os.O_RDONLY|syscall.O_NONBLOCK, 0)
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer reader.Close()
+			worker, err := player.NewPlayer(&player.Options{Log: log, Spclient: sp, Events: events, AudioBackend: "pipe", AudioOutputPipe: path, AudioOutputPipeFormat: "s16le"})
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer worker.Close()
+			p := pc13ExistingPlayer(t, false)
+			p.player = worker
+			p.prodInfo = &ProductInfo{}
+			p.app.mpris = mpris.DummyServer{}
+			p.state.reset()
+			p.state.device.SelectedAliasId = 1
+			p.app.cfg.DeviceAliases = []string{"Kitchen"}
+			p.app.cfg.DeviceAliasRoomIDs = []string{"r0"}
+			p.app.cfg.DeviceAliasHomePodIDs = []string{"42"}
+			p.app.cfg.ZeroconfEnabled = true
+			p.initAliasRegistry()
+			p.sess = &session.Session{}
+			nextSessionField(p.sess, "sp", sp)
+			nextSessionField(p.sess, "events", events)
+			p.spotConnId = "fixture-owner"
+			p.hasInitialConnectState = true
+			p.prefetchTimer = time.NewTimer(time.Hour)
+			defer p.prefetchTimer.Stop()
+			track := "spotify:track:0000000000000000000003"
+			id, _ := librespot.SpotifyIdFromUri(track)
+			p.secondaryStream = &player.Stream{Source: &contentInertSource{}, Media: librespot.NewMediaFromTrack(&metadatapb.Track{Gid: id.Id(), Name: proto.String("fixture-track"), Duration: proto.Int32(300000), Number: proto.Int32(1), DiscNumber: proto.Int32(1), Album: &metadatapb.Album{Name: proto.String("fixture-album"), Date: &metadatapb.Date{}}})}
+			state := pc13TransferState()
+			state.Playback.CurrentTrack = &connectpb.ContextTrack{Uri: track}
+			state.Playback.IsPaused = true
+			state.CurrentSession.Context.Pages = []*connectpb.ContextPage{{Tracks: []*connectpb.ContextTrack{{Uri: track}}}}
+			req := recoveryRequest()
+			req.Command.Data, err = proto.Marshal(state)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if err = p.handlePlayerCommandWithSpclient(ctx, req, sp); err != nil {
+				t.Fatal(err)
+			}
+
+			p.hasSpotConnId, p.hasInitialConnectState = true, true
+			p.playbackReadyCh = make(chan struct{})
+			close(p.playbackReadyCh)
+			server := p.app.server.(*aliasTestServer)
+			binding := p.aliasBinding()
+			initialStatus := map[string]any{"active": true, "paused": true, "stopped": false, "selected_alias_id": 1, "alias_binding": binding}
+			var resume dealer.RequestPayload
+			resume.MessageId = 8
+			resume.SentByDeviceId = "controller"
+			resume.Command.Endpoint = "resume"
+			resume.Command.SessionId = p.state.player.SessionId
+			commandCtx := ctx
+			shouldGrant := true
+			switch mode {
+			case "zero_message":
+				resume.MessageId = 0
+				shouldGrant = false
+			case "missing_sender":
+				resume.SentByDeviceId = ""
+				shouldGrant = false
+			case "generic_play":
+				shouldGrant = false
+			case "conflicting_aliases":
+				one, two := uint32(1), uint32(2)
+				resume.TargetAliasId, resume.Command.TargetAliasId = &one, &two
+				shouldGrant = false
+			case "quarantined":
+				p.roomContentQuarantined = true
+				shouldGrant = false
+			case "retired_after_ack":
+				afterACK = func() { p.aliasMu.Lock(); p.aliasRetired = true; p.aliasMu.Unlock() }
+				shouldGrant = false
+			case "source_changed_after_ack":
+				afterACK = func() { p.primaryLoadOrdinal++ }
+				shouldGrant = false
+			case "zero_alias":
+				zero := uint32(0)
+				resume.TargetAliasId = &zero
+			case "system":
+				resume.Command.Options.SystemInitiated = true
+				shouldGrant = false
+			case "wrong_alias":
+				other := uint32(2)
+				resume.TargetAliasId = &other
+				shouldGrant = false
+			case "wrong_session":
+				resume.Command.Options.SessionId = "not-current"
+				shouldGrant = false
+			case "cancelled":
+				var cancel context.CancelFunc
+				commandCtx, cancel = context.WithCancel(ctx)
+				cancel()
+				shouldGrant = false
+			case "unready":
+				p.hasInitialConnectState = false
+				shouldGrant = false
+			}
+			if mode != "queued_initial" {
+				select {
+				case event := <-worker.Receive():
+					p.handlePlayerEvent(ctx, &event)
+				case <-time.After(time.Second):
+					t.Fatal("missing initial observation")
+				}
+			}
+			before := len(server.events)
+			if mode == "generic_play" {
+				err = p.play(ctx)
+			} else {
+				err = p.handlePlayerCommandWithSpclient(commandCtx, resume, sp)
+			}
+			grants := 0
+			var ordinal uint64
+			for _, event := range server.events[before:] {
+				if data, ok := event.Data.(map[string]any); ok && event.Type == "connect_transfer" && data["kind"] == "resume" {
+					grants++
+					ordinal, _ = data["resume_ordinal"].(uint64)
+					if data["primary_load_ordinal"] != p.primaryLoadOrdinal || data["ordinal"] != ordinal || ordinal == 0 {
+						t.Fatal("uncorrelated Resume grant", data)
+					}
+				}
+			}
+			if shouldGrant && (err != nil || grants != 1) {
+				t.Fatal("fresh authenticated Resume missing", err, grants)
+			}
+			if !shouldGrant && grants != 0 {
+				t.Fatal("invalid/non-user Resume minted authority")
+			}
+			if !shouldGrant {
+				return
+			}
+			if mode == "duplicate" {
+				// The same command is refused even though playback has already resumed.
+				if err = p.handlePlayerCommandWithSpclient(ctx, resume, sp); err == nil {
+					t.Fatal("duplicate command accepted")
+				}
+				if len(server.events) != before+1 {
+					t.Fatal("duplicate emitted authority")
+				}
+			}
+			if mode == "genuine_pause" {
+				var pause dealer.RequestPayload
+				pause.Command.Endpoint = "pause"
+				if err = p.handlePlayerCommandWithSpclient(ctx, pause, sp); err != nil {
+					t.Fatal(err)
+				}
+			}
+			if mode == "queued_initial" {
+				select {
+				case event := <-worker.Receive():
+					if event.InitialLoadOrdinal != p.primaryLoadOrdinal || event.ResumeOrdinal != 0 {
+						t.Fatal("old initial receipt changed", event)
+					}
+					p.handlePlayerEvent(ctx, &event)
+				case <-time.After(time.Second):
+					t.Fatal("missing queued old initial")
+				}
+			}
+			select {
+			case event := <-worker.Receive():
+				if event.Type != player.EventTypeResume || event.ResumeOrdinal != ordinal || event.InitialLoadOrdinal != 0 {
+					t.Fatal("wrong Resume operation receipt", event)
+				}
+				p.handlePlayerEvent(ctx, &event)
+			case <-time.After(time.Second):
+				t.Fatal("missing exact Resume observation")
+			}
+			if mode == "genuine_pause" {
+				select {
+				case event := <-worker.Receive():
+					if event.Type != player.EventTypePause || event.ResumeOrdinal != 0 {
+						t.Fatal("Pause impersonated Resume")
+					}
+					p.handlePlayerEvent(ctx, &event)
+				case <-time.After(time.Second):
+					t.Fatal("missing genuine Pause")
+				}
+			}
+			if dir := os.Getenv("PC58_RESUME_TRACE_DIR"); dir != "" {
+				if err = os.MkdirAll(dir, 0700); err != nil {
+					t.Fatal(err)
+				}
+				raw, marshalErr := json.MarshalIndent(map[string]any{"initial_status": initialStatus, "events": server.events}, "", "  ")
+				if marshalErr != nil {
+					t.Fatal(marshalErr)
+				}
+				if err = os.WriteFile(filepath.Join(dir, mode+".json"), raw, 0600); err != nil {
+					t.Fatal(err)
+				}
+			}
+		})
+	}
+}
