     {
       // TODO raop/airplay ntp uses CLOCK_MONOTONIC, so this is just for testing PTP
       clock_gettime_with_res(CLOCK_MONOTONIC, &pb_session.start_ts, &player_timer_res);
@@ -1268,6 +1271,14 @@
 
