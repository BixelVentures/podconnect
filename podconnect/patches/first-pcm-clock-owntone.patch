--- a/src/player.c
+++ b/src/player.c
@@ -261,6 +261,9 @@
   // It will be equal to:
   // pts = start_ts + ticks_elapsed * player_tick_interval
   struct timespec pts;
+
+  // Fresh selected START alone waits for its first admitted PCM to anchor PTS.
+  bool start_clock_pending;
 
   // Equals current number of samples written to outputs
   uint32_t pos;
@@ -872,7 +875,7 @@
   uint32_t step_ms;
 
