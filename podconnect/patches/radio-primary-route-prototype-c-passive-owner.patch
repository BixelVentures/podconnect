+/* Read-only owner-thread observations. Selection alone is not Spotify proof;
+ * the exact live FIFO writer and ordinary encrypted route must agree. */
+int
+outputs_primary_radio_spotify_owner(uint64_t id, const struct output_native_owner *owner,
+    const struct output_queue_writer *writer, struct output_transport_identity *route)
+{
+  struct output_device *d = outputs_device_get(id);
+  struct radio_handoff_slot *slot = radio_handoff_find(id);
+  if (!radio_protocols_initialized || outputs_radio_sender_role() || radio_handoff_fault
+      || start_journal_fault || start_startup_quarantine || !owner || !writer || !route
+      || !d || !native_owner_valid(owner, id) || outputs_radio_handoff_blocked(id)
+      || !outputs_airplay_primary_spotify_session_current(d, d->session)
+      || radio_transport_identity_get(id, route, true) < 0
+      || !radio_queue_writer_current(writer, route, NULL))
+    return -1;
+
+  /* A parked/returning writer cannot fall through to the old START proof. */
+  if (slot && slot->primary_return.intent[0])
+    {
+      const struct output_radio_reacquire_result *v = &slot->result.resume;
+      return slot->result.phase == OUTPUT_RADIO_REACQUIRED
+        && v->phase == OUTPUT_RADIO_REACQUIRE_OPENED
+        && native_owner_equal(owner, &v->command.intended_native_owner)
+        && queue_writer_equal(writer, &v->command.current_writer)
+        && transport_identity_equal(route, &v->route_identity)
+        && radio_reacquired_current(id, d->incarnation, d->session_epoch, d->session, false) ? 0 : -1;
+    }
+  const struct start_slot *spotify = start_active;
+  if (!spotify || spotify->cancelled || spotify->result.phase != OUTPUT_START_COMPLETED
+      || !spotify->result.actual_owner_present
+      || !native_owner_equal(owner, &spotify->result.command.committed_native_owner)
+      || writer->source_epoch != spotify->result.writer_source_epoch
+      || writer->writer_fd != spotify->result.command.writer_fd
+      || writer->pipe_device != spotify->result.pipe_device || writer->pipe_inode != spotify->result.pipe_inode
+      || strcmp(writer->native_process.boot_id, spotify->result.command.native_process.boot_id)
+      || writer->native_process.pid != spotify->result.command.native_process.pid
+      || writer->native_process.proc_start_ticks != spotify->result.command.native_process.proc_start_ticks)
+    return -1;
+  return outputs_start_bound_owner_current(owner, route, false) ? 0 : -1;
+}
