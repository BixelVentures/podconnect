+      assert(outputs_transport_prepare(&foreign,&prepared)<0 && transport_pause_owned(device->id));
+    }
+    assert(outputs_transport_prepare(&request,&prepared)==0);request=prepared.command;
+    if(mode==2){device->session_epoch++;assert(!transport_pause_owned(device->id));}
+    if(mode==3)request.args_digest[0]='b';
+    int accepted=outputs_transport_commit(&request,&result);
+    if(mode==2 || mode==3)assert(accepted<0);else assert(accepted==0);
+    if(mode==3) {
+      assert(transport_pause_owned(device->id)); /* Rejected altered arguments cannot clear an older proven pause. */
+      assert(outputs_transport_commit(&request,&result)<0);
+      assert(outputs_transport_pause_confirm(device->id,request.token,request.native_prepare_id,request.native_revision)<0);
+      continue;
+    }
+    if(mode==0 || mode==4 || mode==5) {
