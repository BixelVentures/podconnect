+    assert(transport_pause_owned(device->id));
+    request.native_owner=*owner;request.native_revision=++revision;request.token[0]=0;
+    strcpy(request.action,"seek");snprintf(request.native_prepare_id,sizeof(request.native_prepare_id),"%032" PRIx64,request.native_revision);memset(request.args_digest,'a',64);
+    strcpy(request.expected_input_path_digest,route.input_path_digest);
