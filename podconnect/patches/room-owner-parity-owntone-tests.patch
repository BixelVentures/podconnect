+/* Seek must keep the exact paused START/MOVE owner while Native changes only
+ * its timeline. Its C ACK admits the command; the later exact Native completion
+ * confirms actual worker pause. UNKNOWN produces no completion at this private
+ * boundary; C cannot infer Native semantic state from admission alone. */
+static void seek_pause_carry_case(struct output_device *device,const struct output_native_owner *owner)
