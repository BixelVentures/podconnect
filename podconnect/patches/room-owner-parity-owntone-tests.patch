+        assert(outputs_transport_pause_confirm(device->id,request.token,request.native_prepare_id,request.native_revision)<0);
+        assert(transport_pause_owned(device->id));continue;
+      }
+      if(mode==4) {
+        struct output_transport_request newer=request;newer.token[0]=0;newer.native_revision=++revision;
+        snprintf(newer.native_prepare_id,sizeof(newer.native_prepare_id),"%032" PRIx64,newer.native_revision);
+        assert(outputs_transport_prepare(&newer,&prepared)==0);newer=prepared.command;
+        assert(outputs_transport_commit(&newer,&result)==0);
+        assert(outputs_transport_pause_confirm(device->id,request.token,request.native_prepare_id,request.native_revision)<0);
+        assert(outputs_transport_pause_confirm(device->id,newer.token,newer.native_prepare_id,newer.native_revision)==0);
+        assert(transport_pause_owned(device->id));continue;
+      }
+      /* UNKNOWN/failed worker supplies no private effect confirmation. Actual
+       * PCM restart consumes retained custody; a C admission is not a pause ACK. */
