+bool
+outputs_primary_radio_custody_available(uint64_t id)
+{
+  char key[64], *raw = NULL;
+  primary_radio_custody_key(key, id);
+  int found = db_radio_handoff_load_key(key, &raw);
+  bool available = found == 0 || (found == 1 && raw && primary_radio_custody_valid(raw, id, true));
+  free(raw);
+  return available;
+}
