+			return app.withNewOutput(fresh, create)
+		}}
+		configureSelectedStage(t, fresh, options)
+		var e error
+		fresh.player, e = player.NewPlayer(options)
+		if e != nil {
+			return nil, e
+		}
+		return fresh, nil
+	})
+	if err != nil || fresh == nil || app.currentPlayer != fresh || fresh == old || fresh.sess == old.sess || fresh.player == old.player {
+		t.Fatal("actualmanagedreplacement", err)
+	}
+	forwardDone := make(chan struct{})
+	go func() { defer close(forwardDone); app.forwardAPI(ctx) }()
+	defer func() {
+		fresh.Close()
+		if runDone != nil {
+			<-runDone
+		}
+		cancel()
+		<-forwardDone
+	}()
+	// The next START is a new admission, never old release or old START custody.
+	if app.manualRelease != nil || app.startCustody != nil || app.moveCustody != nil || fresh.roomManualRelease != nil {
+		t.Fatal("replacement inherited released custody")
+	}
+	previous := os.Getenv("PC70_RELEASE_COMPOSE")
+	os.Setenv("PC70_RELEASE_COMPOSE", "")
+	defer os.Setenv("PC70_RELEASE_COMPOSE", previous)
+	testSelectedContentCommitActualCOnServer(t, fresh, fresh.player, &player.Stream{Source: &contentInertSource{}}, "actual-c-selected-rtp", api)
+	if app.openedWriterOwner != fresh || app.startCustody == nil || app.startCustody.Owner != fresh || fresh.player.Closed() {
+		t.Fatal("fresh START didnotown newwriter")
+	}
+	t.Log("PASS managedsamechannel logout -> actualreplaceAppPlayer -> freshRun/APIforwarder -> publicfreshSTART/actualC completed withoutrestart oroldcustody")
+}
