+func TestManualReleaseConsumedHandoffDeadlineReadRecoveryAndStaleOwner(t *testing.T) {
+	p, offer := manualReleaseFixture(t)
+	op := offer.ReleaseOperation
+	terminal := releaseOutcome(offer, "retired")
+	op.TerminalC = &terminal
+	op.HandoffPending = true
+	op.CommitAttempted = true
+	op.Token = strings.Repeat("e", 32)
+	// This component fixture seeds known C retirement; only incumbent channel
+	// delivery/recovery is exercised here, never a physical retirement claim.
+	p.app.manualReleaseReceipt = offer
+	p.app.logoutCh = make(chan *AppPlayer)
+	p.logout = p.app.logoutCh
+	op.Logout = p.logout
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	server := &ConcreteApiServer{}
+	unknown := server.finishReleaseHandoff(ctx, offer)
+	if unknown.Outcome != "unknown" || !unknown.Drained || op.Receipt != nil || !op.HandoffPending || p.player.Closed() {
+		t.Fatal("deadline discarded unfinished handoff or repeated Close")
+	}
+	received := make(chan *AppPlayer, 1)
+	go func() { received <- <-p.logout }()
+	value, err := server.runRoomRelease(offer, "", false)
+	if err != nil || value.(releaseResult).Outcome != "retired" || op.HandoffPending {
+		t.Fatal("same read didnotfinish captured handoff", err, value)
+	}
+	select {
+	case target := <-received:
+		if target != p {
+			t.Fatal("wrong logoutowner")
+		}
+	case <-time.After(time.Second):
+		t.Fatal("no capturedlogout")
+	}
+	// A second observation cannot enqueue another packet or repeat effects.
+	value, err = server.runRoomRelease(offer, "", false)
+	if err != nil || value.(releaseResult).Outcome != "retired" || p.player.Closed() {
+		t.Fatal("terminal read changed worker")
+	}
+	op.Receipt = nil
+	op.HandoffPending = true
+	p.app.currentPlayer = &AppPlayer{}
+	value, err = server.runRoomRelease(offer, "", false)
+	if err != nil || value.(releaseResult).Outcome != "unknown" || !op.HandoffPending {
+		t.Fatal("unverified foreignowner inherited retirement authority")
+	}
+	op.Mu.Lock()
+	inflight, err := server.runRoomRelease(offer, "", false)
+	op.Mu.Unlock()
+	if err != nil || inflight.(releaseResult).Outcome != "unknown" {
+		t.Fatal("inflight read waited or claimed completion")
+	}
+}
