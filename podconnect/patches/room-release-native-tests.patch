+	if _, err := releaseHTTP(ctx, client, http.MethodPost, base+"/api/outputs/"+pod+"/transport/bound-prepare", body, &cprepared); err != nil || cprepared.Schema != "podconnect.output_transport_prepare.v2" || !cprepared.OK || cprepared.Owner != snapshot.roomTransportIdentity || cprepared.Revision != snapshot.NativeRevision {
