+func TestContentCaptureNamesMissingInitialReadinessWithoutChangingConflict(t *testing.T) {
+	p, _ := contentFixture(t)
+	access := ap.NewAccesspoint(&librespot.NullLogger{}, nil, "fixture")
+	left, right := net.Pipe()
+	defer left.Close()
+	defer right.Close()
+	fields := reflect.ValueOf(access).Elem()
+	set := func(name string, v reflect.Value) {
+		f := fields.FieldByName(name)
+		reflect.NewAt(f.Type(), unsafe.Pointer(f.UnsafeAddr())).Elem().Set(v)
+	}
+	set("conn", reflect.ValueOf(left))
+	set("encConn", reflect.New(fields.FieldByName("encConn").Type().Elem()))
+	set("welcome", reflect.ValueOf(&pb.APWelcome{CanonicalUsername: proto.String("private-account-marker")}))
+	nextSessionField(p.sess, "ap", access)
+	if p.player == nil {
+		p.player = &player.Player{}
+	}
+	p.hasSpotConnId = true
+	p.hasInitialConnectState = false
+	p.playbackReadyCh = make(chan struct{})
+	capture, err := p.captureContent(roomVolumeScope{"private-account-marker", "private-target-marker", "r0", "987654"})
+	if capture != nil || !errors.Is(err, errContentPlaybackNotReady) || !errors.Is(err, ErrAliasConflict) || err.Error() != ErrAliasConflict.Error() {
+		t.Fatalf("readiness classification changed: %v", err)
+	}
+}
