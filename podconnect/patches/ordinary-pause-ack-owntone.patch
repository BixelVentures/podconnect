+/* A volume result, even UNKNOWN, never changes the paused transport timeline.
+ * Join only its already-admitted current custody, never a prepared/old owner. */
+static bool room_volume_pause_custody_current(const struct output_native_owner *owner,
+    const struct output_transport_identity *identity,uint64_t revision)
+{
+  if (!revision || revision!=transport_custody_revision
+      || !native_owner_equal(owner,&transport_custody_owner)
+      || !transport_identity_equal(identity,&transport_custody_identity)) return false;
+  for (size_t i=0;i<ARRAY_SIZE(room_volume_slots);i++) {
+    const struct room_volume_slot *s=&room_volume_slots[i];
+    if (s->used && !s->result.contexts_drained && s->result.command.bound && s->result.command.native_revision==revision
+        && native_owner_equal(owner,&s->result.command.native_owner)
+        && transport_identity_equal(identity,&s->result.identity)) return true;
+  }
+  return false;
+}
