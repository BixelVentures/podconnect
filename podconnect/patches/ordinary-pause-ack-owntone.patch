+    && transport_identity_equal(&s->result.identity,&transport_pause_identity)
+    && transport_pause_owned(r->device_id);
   memcpy(s->result.command.native_reservation_id,r->native_reservation_id,33);
   if (r->bound && !transport_custody_admit(r->device_id,&r->native_owner,r->native_revision,s->admission_generation,&s->result.identity)) {
