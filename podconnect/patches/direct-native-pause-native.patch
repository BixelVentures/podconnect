+func commitRoomTransportOwner(ctx context.Context, client *http.Client, offer *nativeTransportOffer, token string) error {
+	inputDigest := sha256.Sum256([]byte(offer.InputPath))
+	payload := struct {
+		Token                   string `json:"token"`
+		NativePrepareID         string `json:"native_prepare_id"`
+		Action                  string `json:"action"`
+		ArgsDigest              string `json:"args_digest"`
+		ExpectedInputPathDigest string `json:"expected_input_path_digest"`
+	}{token, offer.Snapshot.PrepareID, offer.Snapshot.Action, offer.Snapshot.ArgsDigest, hex.EncodeToString(inputDigest[:])}
+	var envelope any = payload
+	if offer.Bound {
+		envelope = boundOwnerPayload(payload, offer.Snapshot.roomTransportIdentity, offer.NativeRevision)
+	}
+	if offer.Queue != nil {
+		envelope = queueCommitPayload(offer, token)
+	}
+	body, _ := json.Marshal(envelope)
+	suffix := "commit"
+	if offer.Bound {
+		suffix = "bound-commit"
+	}
+	endpoint := strings.TrimSuffix(offer.OwnToneURL, "/") + "/api/outputs/" + offer.Snapshot.HomePodID + "/transport/" + suffix
+	call, err := http.NewRequestWithContext(ctx, http.MethodPost, endpoint, bytes.NewReader(body))
+	if err != nil {
+		return err
+	}
+	call.Header.Set("Content-Type", "application/json")
+	response, err := client.Do(call)
+	if err != nil {
+		return err
+	}
+	limit := int64(2048)
+	if offer.Bound {
+		limit = 8192
+	}
+	raw, readErr := io.ReadAll(io.LimitReader(response.Body, limit+1))
+	_ = response.Body.Close()
+	var ack roomTransportOutputACK
+	decodeErr := decodeQueueJSON(raw, &ack)
+	if offer.Bound {
+		decodeErr = decodeBoundOwner(raw, &ack, offer.Snapshot.roomTransportIdentity, offer.NativeRevision)
+	}
+	valid := decodeErr == nil && ack.Schema == boundSchema("podconnect.output_transport_commit.v1", offer.Bound) && ack.OK && ack.Token == token && ack.NativePrepareID == offer.Snapshot.PrepareID && ack.ArgsDigest == offer.Snapshot.ArgsDigest && ack.PinRemainingMS >= 1 && ack.PinRemainingMS <= 10000 && ack.Outcome == "accepted" && !ack.Physical
+	if offer.Queue != nil {
+		valid = validQueueACK(raw, offer, token)
+	}
+	if response.StatusCode != 200 || readErr != nil || int64(len(raw)) > limit || !valid {
+		return ErrAliasConflict
+	}
+	return nil
+}
