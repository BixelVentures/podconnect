+func TestRoomTransportDirectPauseWriterGenerationFinalGuard(t *testing.T) {
+	p, offer := roomTransportAdmittedFixture(t)
+	p.app.openedWriterOwner = p
+	p.app.openedWriterGeneration = 7
+	offer.WriterGeneration = 7
+	ctx := context.Background()
+	if got, err := p.consumeRoomTransport(ctx, roomTransportConsumeRequest{offer.Snapshot.PrepareID, ctx}); err != nil || got != offer {
+		t.Fatal("current exact writer offer not consumed", err)
+	}
+	// Same actor and identical saved FIFO/FD values cannot hide replacement.
+	p.app.moveCustodyMu.Lock()
+	p.app.openedWriterGeneration++
+	p.app.moveCustodyMu.Unlock()
+	p.aliasMu.Lock()
+	current := p.transportOfferCurrentLocked(offer, ctx, ctx)
+	p.aliasMu.Unlock()
+	if current {
+		t.Fatal("final worker mutation guard accepted a successor writer generation")
+	}
+}
