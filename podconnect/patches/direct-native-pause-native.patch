+	digest := sha256.Sum256([]byte(offer.InputPath))
+	route := roomVolumeRoute{"00000000-0000-0000-0000-000000000001", "202", "1", "1", "1", "1", "1", "1", hex.EncodeToString(digest[:])}
+	token := strings.Repeat("f", 32)
