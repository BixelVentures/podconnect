+	case "bound-state":
+		if mode == "direct-pause-unknown-state" {
+			w.WriteHeader(409)
+			return
+		}
+		if mode == "direct-pause-route" {
+			route.InputPathDigest = strings.Repeat("a", 64)
+		}
+		_ = json.NewEncoder(w).Encode(directPauseOutputState{"podconnect.output_transport_state.v2", true, route, false, true, false, roomTransportActions, false})
+	case "bound-prepare":
+		owner := offer.Snapshot.roomTransportIdentity
+		if mode == "direct-pause-foreign-prepare" {
+			owner.SessionID = "foreign"
+		}
+		if mode == "direct-pause-late-generation" {
+			p.app.moveCustodyMu.Lock()
+			p.app.openedWriterGeneration++
+			p.app.moveCustodyMu.Unlock()
