+++ b/daemon/room_transport_pause.go
@@ -0,0 +1,153 @@
+package daemon
+
+import (
+	"context"
+	"crypto/sha256"
+	"encoding/hex"
+	"net/http"
+	"slices"
+	"strings"
+	"time"
+)
+
+type directPauseOutputState struct {
+	Schema      string          `json:"schema"`
+	OK          bool            `json:"ok"`
+	Identity    roomVolumeRoute `json:"identity"`
+	Busy        bool            `json:"busy"`
+	StartOwned  bool            `json:"start_owned"`
+	CleanAbsent bool            `json:"clean_absent"`
+	Actions     []string        `json:"actions"`
+	Physical    bool            `json:"physical_result_verified"`
+}
+type directPauseOutputPrepare struct {
+	Schema   string          `json:"schema"`
+	OK       bool            `json:"ok"`
+	Token    string          `json:"token"`
+	Identity roomVolumeRoute `json:"identity"`
+	Expires  int             `json:"expires_after_ms"`
+}
+
+// pauseBoundRoom runs on the current AppPlayer actor. Reusing the existing
+// prepare/consume/effect methods directly avoids enqueueing onto that same actor.
+// A configured bound route never falls back to an uncorrelated local Pause.
+func (p *AppPlayer) pauseBoundRoom(ctx context.Context) (bool, error) {
+	if p.app == nil || p.app.cfg == nil || p.app.cfg.AudioBackend != "pipe" || !p.app.cfg.ExternalVolume || p.app.cfg.RoomTransportOwnToneURL == "" {
+		return false, nil
+	}
+	ctx, cancel := context.WithTimeout(ctx, roomTransportLifetime)
+	defer cancel()
+	if p.sess == nil || p.state == nil || p.state.device == nil {
+		return true, ErrAliasConflict
+	}
+	account, authenticated := p.sess.BoundUsername()
+	if !authenticated {
+		return true, ErrAliasConflict
+	}
+	scope := roomVolumeScope{AccountUserID: account, TargetID: p.app.deviceId}
+	p.aliasMu.Lock()
+	binding := p.aliasBindingLocked()
+	if binding != nil && binding.Ready {
+		for _, alias := range p.aliasRegistry {
+			if alias.ID == p.state.device.SelectedAliasId && alias.RoomID == binding.RoomID {
+				scope.RoomID, scope.HomePodID = alias.RoomID, alias.HomePodID
+			}
+		}
+	}
+	p.aliasMu.Unlock()
+	if scope.RoomID == "" || scope.HomePodID == "" {
+		return true, ErrAliasConflict
+	}
+	_, err := p.prepareRoomTransportVersion(ctx, roomTransportPrepareRequest{AccountUserID: scope.AccountUserID, TargetID: scope.TargetID, RoomID: scope.RoomID, HomePodID: scope.HomePodID, Action: "pause", Context: ctx}, true)
+	if err != nil {
+		return true, err
+	}
+	offer := p.roomTransportOffer
+	if offer == nil {
+		return true, ErrAliasConflict
+	}
+	p.app.moveCustodyMu.Lock()
+	if p.app.openedWriterOwner == p && p.app.openedWriterGeneration != 0 && p.app.openedWriter.Type == "fifo" {
+		offer.WriterGeneration = p.app.openedWriterGeneration
+	}
+	p.app.moveCustodyMu.Unlock()
+	if offer.WriterGeneration == 0 {
+		p.roomTransportOffer = nil
+		offer.discardPrepared()
+		return true, ErrAliasConflict
+	}
+	defer func() {
+		if p.roomTransportOffer == offer {
+			p.roomTransportOffer = nil
+		}
+		p.abortRoomTransport(offer)
+		offer.discardPrepared()
+	}()
+	expectedGeneration := offer.Generation
+	current := func() bool {
+		p.aliasMu.Lock()
+		defer p.aliasMu.Unlock()
+		expected := *offer
+		expected.Generation = expectedGeneration
+		return p.transportOfferCurrentLocked(&expected, ctx, ctx)
+	}
+	endpoint := strings.TrimSuffix(offer.OwnToneURL, "/") + "/api/outputs/" + scope.HomePodID + "/transport/"
+	var state directPauseOutputState
+	if err = roomVolumeHTTP(ctx, http.MethodPost, endpoint+"bound-state", struct {
+		Owner roomTransportIdentity `json:"native_owner"`
+	}{offer.Snapshot.roomTransportIdentity}, &state); err != nil {
+		return true, err
+	}
+	digest := sha256.Sum256([]byte(offer.InputPath))
+	seen := map[string]bool{}
+	for _, action := range state.Actions {
+		if seen[action] || !slices.Contains(roomTransportActions, action) {
+			return true, ErrAliasConflict
+		}
+		seen[action] = true
+	}
+	if !current() || state.Schema != "podconnect.output_transport_state.v2" || !state.OK || state.Physical || state.Busy || state.StartOwned && state.CleanAbsent || !state.Identity.valid() || state.Identity.DeviceID != scope.HomePodID || state.Identity.InputPathDigest != hex.EncodeToString(digest[:]) || !slices.Contains(state.Actions, "pause") {
+		return true, ErrAliasConflict
+	}
+	payload := struct {
+		Prepare string `json:"native_prepare_id"`
+		Action  string `json:"action"`
+		Digest  string `json:"args_digest"`
+	}{offer.Snapshot.PrepareID, "pause", offer.Snapshot.ArgsDigest}
+	var prepared directPauseOutputPrepare
+	if err = roomBoundHTTP(ctx, http.MethodPost, endpoint+"bound-prepare", boundOwnerPayload(payload, offer.Snapshot.roomTransportIdentity, offer.NativeRevision), &prepared, offer.Snapshot.roomTransportIdentity, offer.NativeRevision); err != nil {
+		return true, err
+	}
+	if !current() || prepared.Schema != "podconnect.output_transport_prepare.v2" || !prepared.OK || !volumeHex32.MatchString(prepared.Token) || prepared.Identity != state.Identity || prepared.Expires != 10000 {
+		return true, ErrAliasConflict
+	}
+	if _, err = p.consumeRoomTransportVersion(ctx, roomTransportConsumeRequest{offer.Snapshot.PrepareID, ctx}, true); err != nil {
+		return true, err
+	}
+	client := &http.Client{Timeout: 3 * time.Second, CheckRedirect: func(*http.Request, []*http.Request) error { return ErrAliasConflict }}
+	if err = commitRoomTransportOwner(ctx, client, offer, prepared.Token); err != nil {
+		return true, err
+	}
+	if !current() {
+		return true, ErrAliasConflict
+	}
+	if _, err = p.effectRoomTransport(ctx, roomTransportEffectRequest{offer, ctx}); err != nil {
+		return true, err
+	}
+	// effectRoomTransport synchronously publishes exactly its own Pause event,
+	// which advances the existing transport generation once. A separate event
+	// or successor must not be adopted by sampling the latest generation.
+	expectedGeneration++
+	if !current() {
+		return true, ErrAliasConflict
+	}
+	if err = confirmBoundPause(ctx, client, offer, prepared.Token); err != nil {
+		// The actual Pause may already have happened. Never retry this token or
+		// replace an unknown confirmation with an unbound success response.
+		return true, err
+	}
+	if !current() {
+		return true, ErrAliasConflict
+	}
+	return true, nil
+}
