+// Keeps real public commit dispatch/actor park/worker and actual C. Provider
+// decoding is deliberately seeded here so this case isolates the next boundary.
+func testSelectedContentCommitActualC(t *testing.T, p *AppPlayer, worker *player.Player, stream *player.Stream, mode string) {
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	p.primaryStream = nil
+	p.app.mpris = mpris.DummyServer{}
+	p.app.server = &StubApiServer{log: p.app.log}
+	if mode == "actual-c-selected-successor" {
+		p.primaryStream = stream
+		if _, e := p.startPreparedDealerTransfer(ctx, false, 0); e != nil {
+			t.Fatal("initial authenticated prepared current writer", e)
+		}
+		t.Log("initial real prepared current writer completed before selected replacement")
+	} else {
+		p.state.player.SessionId = ""
+	}
+
+	p.state.player.Options = &connectpb.ContextPlayerOptions{}
+	p.state.player.PlayOrigin = &connectpb.PlayOrigin{}
+	p.state.player.Track = &connectpb.ProvidedTrack{Uri: "spotify:track:0000000000000000000003"}
+	if mode == "actual-c-selected" {
+		events, _ := (evtimpl.Impl{}).NewEventManager(p.app.log, nil, nil, nil, "")
+		nextSessionField(p.sess, "events", events)
+		sp := pc13Spclient(t, pc13RoundTrip(func(r *http.Request) (*http.Response, error) {
+			return &http.Response{StatusCode: 204, Body: http.NoBody, Header: make(http.Header), Request: r}, nil
+		}))
+		nextSessionField(p.sess, "sp", sp)
+		list, e := tracks.NewTrackListFromContext(ctx, p.app.log, sp, &connectpb.Context{Uri: "spotify:track:0000000000000000000003", Pages: []*connectpb.ContextPage{{Tracks: []*connectpb.ContextTrack{{Uri: "spotify:track:0000000000000000000003"}}}}})
+		if e != nil {
+			t.Fatal(e)
+		}
+		if e = list.TrySeek(ctx, func(*connectpb.ContextTrack) bool { return true }); e != nil {
+			t.Fatal(e)
+		}
+		p.state.tracks = list
+	}
+	p.prefetchTimer = time.NewTimer(time.Hour)
+	defer p.prefetchTimer.Stop()
+	server := &ConcreteApiServer{requests: make(chan ApiRequest)}
+	actorDone := make(chan struct{})
+	go func() {
+		defer close(actorDone)
+		for req := range server.requests {
+			if !p.dispatchAPIAndPark(ctx, req) {
+				return
+			}
+		}
+	}()
+	defer func() { close(server.requests); <-actorDone }()
+	capture, err := p.captureContent(roomVolumeScope{"account", "engine", "r1", "1"})
+	if err != nil {
+		t.Fatal("capture", err)
+	}
+	state, err := capture.readCState(ctx)
+	if err != nil {
+		t.Fatal("actual C state", err)
+	}
+	offered, err := p.offerContent(contentOfferActorRequest{capture, state.Target, ctx})
+	if err != nil {
+		t.Fatal("offer", err)
+	}
+	op := offered.(*contentOperation)
+	if !server.roomContents.put(op) {
+		t.Fatal("store")
+	}
+	request := contentPrepareRequest{capture.Scope, op.Offer, "play_track", contentArgs{TrackURI: "spotify:track:0000000000000000000004", MaxVolume: 35}}
+	if mode == "actual-c-selected" {
+		_, err = server.roomTransportAsk(ctx, apiContentClaim, contentActorRequest{Operation: op, Context: ctx, Request: request})
+		if err != nil {
+			t.Fatal("claim", err)
+		}
+		op.mu.Lock()
+		op.Stream, op.Tracks = stream, p.state.tracks
+		op.Prepared.SessionId = op.Intended.SessionID
+		op.Prepared.IsPlaying, op.Prepared.IsPaused = true, true
+		op.ContentDigest = strings.Repeat("d", 64)
+		op.State = "staged"
+		op.StagedUntil = time.Now().Add(5 * time.Second)
+		op.mu.Unlock()
+	} else {
+		raw, _ := json.Marshal(request)
+		rec := httptest.NewRecorder()
+		server.handleContentPrepare(rec, httptest.NewRequest("POST", "/player/room_content/prepare", bytes.NewReader(raw)))
+		if rec.Code != 200 {
+			t.Fatal("public prepare", rec.Code, rec.Body.String())
+		}
+		until := time.Now().Add(3 * time.Second)
+		for {
+			op.mu.Lock()
+			phase, stagedStream := op.State, op.Stream
+			op.mu.Unlock()
+			if phase == "staged" && stagedStream != nil {
+				stream = stagedStream
+				break
+			}
+			if (phase != "staging" && phase != "staged") || time.Now().After(until) {
+				t.Fatal("actual stage did not produce stream", phase)
+			}
+			time.Sleep(time.Millisecond)
+		}
+		t.Log("public prepare -> actual ContextResolve/metadata/key/storage/AES/FLAC/NewStream staged")
+	}
+	body, _ := json.Marshal(contentIDRequest{op.Offer.OfferID, op.Offer.BindingID})
+	rec := httptest.NewRecorder()
+	server.handleContentCommit(rec, httptest.NewRequest("POST", "/player/room_content/commit", strings.NewReader(string(body))))
+	var receipt contentReceipt
+	if err = json.Unmarshal(rec.Body.Bytes(), &receipt); err != nil {
+		t.Fatal(err, rec.Code, rec.Body.String())
+	}
+	if !receipt.Accepted {
+		t.Fatal("selected-content actual commit rejected", rec.Code, receipt)
+	}
+	// Join the existing actor's terminal publication before observing state.
+	_, err = server.roomTransportAsk(ctx, ApiRequestType("fixture_noop"), nil)
+	if err == nil {
+		t.Fatal("expected unsupported noop")
+	}
+	selected, err := worker.Start35CurrentSource(ctx)
+	if err != nil || selected != stream.Source || p.primaryStream != stream || p.state.player.IsPaused || !p.state.player.IsPlaying || p.roomContentReservation != nil {
+		t.Fatal("selected state not observed", err)
+	}
+	if mode == "actual-c-native-pause" {
+		owner, e := p.roomTransportIdentity("account", "engine", "r1", "1")
+		if e != nil {
+			t.Fatal(e)
+		}
+		var actual directPauseOutputState
+		readBound := func() int {
+			body, _ := json.Marshal(struct {
+				Owner roomTransportIdentity `json:"native_owner"`
+			}{owner})
+			response, e := http.Post(os.Getenv("PC_NATIVE_START_URL")+"/api/outputs/1/transport/bound-state", "application/json", bytes.NewReader(body))
+			if e != nil {
+				t.Fatal(e)
+			}
+			defer response.Body.Close()
+			raw, _ := io.ReadAll(response.Body)
+			if response.StatusCode == 200 && json.Unmarshal(raw, &actual) != nil {
+				t.Fatal("invalid actual bound state")
+			}
+			t.Logf("actual C paused owner read status=%d", response.StatusCode)
+			return response.StatusCode
+		}
+		if status := readBound(); status != 200 {
+			t.Fatal("before pause bound state", status)
+		}
+		originalRoute := actual.Identity
+		originalWriter, e := p.app.completedWriterCurrent(p, owner)
+		if e != nil || originalWriter == nil {
+			t.Fatal("current writer", e)
+		}
+		pause := httptest.NewRecorder()
+		server.handleRequest(ApiRequest{Type: ApiRequestTypePause}, pause)
+		if pause.Code != 200 || !p.state.player.IsPaused {
+			t.Fatal("actual REST actor pause", pause.Code, p.state.player.IsPaused)
+		}
+		t.Log("actual REST /player/pause -> same actor -> real player.Pause, no C command from fixture")
+		// The production timer is used unchanged. Observe only its existing bound
+		// read; never manufacture a Pause confirmation or adopt a lost session.
+		until := time.Now().Add(15 * time.Second)
+		status := 200
+		for status == 200 && time.Now().Before(until) {
+			time.Sleep(500 * time.Millisecond)
+			status = readBound()
+		}
+		if status != 200 {
+			t.Errorf("product regression: actual Native Pause must retain exact C session/controls, got HTTP%d", status)
+		}
+		if status == 200 {
+			if actual.Identity != originalRoute || !p.state.player.IsPaused {
+				t.Fatal("pause changed actual route or semantic state")
+			}
+			resume := httptest.NewRecorder()
+			server.handleRequest(ApiRequest{Type: ApiRequestTypeResume}, resume)
+			if resume.Code != 200 || p.state.player.IsPaused {
+				t.Fatal("actual explicit Resume", resume.Code)
+			}
+			// Join real worker processing and allow its same FIFO bytes to reach
+			// the independent C player; C's terminal observer requires STREAMING.
+			selected, e := worker.Start35CurrentSource(ctx)
+			latestWriter, werr := p.app.completedWriterCurrent(p, owner)
+			if e != nil || werr != nil || selected != stream.Source || latestWriter == nil || *latestWriter != *originalWriter {
+				t.Fatal("Resume replaced current worker/source/writer", e, werr)
+			}
+			time.Sleep(250 * time.Millisecond)
+			if readBound() != 200 || actual.Identity != originalRoute {
+				t.Fatal("Resume changed exact C route")
+			}
+			t.Log("PASS actual Native Pause retained same writer/source/C route beyond real10sSTOP; explicit Native Resume keeps same owner and controls")
