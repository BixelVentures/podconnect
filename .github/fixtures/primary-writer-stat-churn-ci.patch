+
+static int fixture_primary_churn_fd = -1;
+static unsigned int fixture_primary_churn_count;
+static unsigned int fixture_primary_scan_errors;
+static int fixture_primary_scan_errno;
+static char fixture_primary_churn_path[96];
+
+static void
+fixture_primary_writer_churn_arm(void)
+{
+  int descriptor = open("/dev/null", O_RDONLY | O_CLOEXEC);
+  assert(descriptor >= 0 && fixture_primary_churn_fd < 0 && !fixture_primary_churn_count);
+  fixture_primary_churn_fd = fcntl(descriptor, F_DUPFD_CLOEXEC, 128);
+  assert(fixture_primary_churn_fd >= 128 && close(descriptor) == 0);
+  int length = snprintf(fixture_primary_churn_path, sizeof(fixture_primary_churn_path),
+      "/proc/%ld/fd/%d", (long)getpid(), fixture_primary_churn_fd);
+  assert(length > 0 && (size_t)length < sizeof(fixture_primary_churn_path));
+}
+
+static int fixture_primary_finalize_churn_fd = -1;
+static unsigned int fixture_primary_finalize_churn_count;
+static uint64_t fixture_primary_finalize_churn_device;
+static char fixture_primary_finalize_churn_path[96];
+
+static void
+fixture_primary_finalize_churn_arm(uint64_t device_id)
+{
+  int descriptor = open("/dev/null", O_RDONLY | O_CLOEXEC);
+  assert(descriptor >= 0 && fixture_primary_finalize_churn_fd < 0 && !fixture_primary_finalize_churn_count);
+  fixture_primary_finalize_churn_fd = fcntl(descriptor, F_DUPFD_CLOEXEC, 160);
+  assert(fixture_primary_finalize_churn_fd >= 160 && close(descriptor) == 0);
+  int length = snprintf(fixture_primary_finalize_churn_path, sizeof(fixture_primary_finalize_churn_path),
+      "/proc/%ld/fd/%d", (long)getpid(), fixture_primary_finalize_churn_fd);
+  assert(length > 0 && (size_t)length < sizeof(fixture_primary_finalize_churn_path));
+  fixture_primary_finalize_churn_device = device_id;
+}
+
+static void
+fixture_primary_writer_scan_fail_closed(const struct output_queue_writer *writer, const char *fifo)
+{
+  const struct output_native_process *process = &writer->native_process;
+  uint64_t device = writer->pipe_device, inode = writer->pipe_inode;
+  fixture_primary_writer_churn_arm();
+
+  fixture_primary_scan_errno = EACCES;
+  fixture_primary_scan_errors = 2;
+  assert(start_all_writers_closed_scan(process, device, inode, true) == -1
+      && fixture_primary_scan_errors == 1);
+
+  fixture_primary_scan_errno = ENOENT;
+  fixture_primary_scan_errors = 2;
+  assert(start_all_writers_closed_scan(process, device, inode, true) == -1
+      && !fixture_primary_scan_errors);
+
+  /* The retry must census the same FIFO and see a real writable descriptor.
+   * Linux enumerates numeric fd entries in order. Put the writer after the fault. */
+  int opened = open(fifo, O_RDWR | O_NONBLOCK | O_CLOEXEC);
+  assert(opened >= 0);
+  int fifo_writer = fcntl(opened, F_DUPFD_CLOEXEC, fixture_primary_churn_fd + 1);
+  assert(fifo_writer > fixture_primary_churn_fd && close(opened) == 0);
+  fixture_primary_scan_errors = 1;
+  assert(start_all_writers_closed_scan(process, device, inode, true) == 0
+      && !fixture_primary_scan_errors && close(fifo_writer) == 0);
+
+  struct output_native_process stale = *process;
+  stale.proc_start_ticks++;
+  fixture_primary_scan_errors = 1;
+  assert(start_all_writers_closed_scan(&stale, device, inode, true) == -1
+      && fixture_primary_scan_errors == 1);
+
+  fixture_primary_scan_errors = 0;
+  fixture_primary_scan_errno = 0;
+  assert(close(fixture_primary_churn_fd) == 0);
+  fixture_primary_churn_fd = -1;
+  puts("PASS parked writer rescan refuses permission, repeated disappearance, real FIFO writer and stale Native incarnation");
+}
+
+static int
+fixture_primary_writer_stat(const char *path, struct stat *result)
+{
+  if (fixture_primary_finalize_churn_fd >= 0 && !strcmp(path, fixture_primary_finalize_churn_path))
+    {
+      const struct radio_handoff_slot *slot = radio_handoff_find(fixture_primary_finalize_churn_device);
+      /* Only the park finalize census: STOP accepted and every session context drained. */
+      if (slot && slot->result.phase == OUTPUT_RADIO_STOPPING && slot->stop_accepted && slot->drained)
+        {
+          assert(close(fixture_primary_finalize_churn_fd) == 0);
+          fixture_primary_finalize_churn_fd = -1;
+          int status = stat(path, result);
+          assert(status < 0 && errno == ENOENT);
+          fixture_primary_finalize_churn_count++;
+          fputs("FORCED primary park finalize writer scan saw a vanished unrelated FD\n", stderr);
+          errno = ENOENT;
+          return status;
+        }
+    }
+  if (fixture_primary_churn_fd >= 0 && fixture_primary_scan_errno
+      && !strcmp(path, fixture_primary_churn_path))
+    {
+      if (!fixture_primary_scan_errors)
+        return stat(path, result);
+      fixture_primary_scan_errors--;
+      errno = fixture_primary_scan_errno;
+      return -1;
+    }
+  if (fixture_primary_churn_fd >= 0 && !strcmp(path, fixture_primary_churn_path)
+      && airplay_sessions && airplay_sessions->primary_radio)
+    {
+      struct output_device *device = outputs_device_get(airplay_sessions->device_id);
+      /* Constructor has linked its local session but has not attached or emitted. */
+      assert(device && !device->session);
+      assert(close(fixture_primary_churn_fd) == 0);
+      fixture_primary_churn_fd = -1;
+      int status = stat(path, result);
+      assert(status < 0 && errno == ENOENT);
+      fixture_primary_churn_count++;
+      fputs("FORCED primary constructor writer scan saw a vanished unrelated FD\n", stderr);
+      errno = ENOENT;
+      return status;
+    }
+  return stat(path, result);
+}
 #undef net_bind
 #undef evrtsp_request_new
