+  }
+  if(!atomic_load(&wire->done)){evtimer_add(f->poll,&soon);return;}
+  if(getenv("PC_NATIVE_START_EXPECT_PAUSE_RETAINED")){
+    struct airplay_session *session=f->device->session;
+    if(!atomic_load(&wire->completed) || !start_active || start_active->result.phase!=OUTPUT_START_COMPLETED
+        || !session || session!=start_active->session || session->state!=AIRPLAY_STATE_STREAMING
+        || f->teardowns || f->volumes!=1){recovery_wire_fail(f,"Native Pause/Resume did not preserve exact live streaming START route");return;}
+    fprintf(stderr,"PASS actual Native purpose-bound Pause -> real10sSTOP rearm -> explicit Native Resume -> same AP2session STREAMING and bound controls\n");
+    event_base_loopbreak(f->base);return;
+  }
+  if(getenv("PC_NATIVE_START_EXPECT_PAUSE_LOSS")){
+    if(!atomic_load(&wire->completed) || !start_active || f->device->session || f->teardowns!=1){recovery_wire_fail(f,"Native Pause loss did not follow actual completed START and real STOP");return;}
+    fprintf(stderr,"CAUSAL RED actual Native Pause -> ordinary underrun -> real delayed STOP -> exact START AP2 session lost and bound-state409\n");
+    event_base_loopbreak(f->base);return;
+  }
+  if(atomic_load(&wire->retired)){
+    if(!atomic_load(&wire->completed) || start_active || outputs_start_source_owned()
+        || start_journal_retirement_outcome!=OUTPUT_RETIRE_RETIRED_KNOWN
+        || !outputs_start_gate_closed() || !start_retired_stage_ready
+        || f->device->selected || f->device->session || f->volumes!=1){
+      recovery_wire_fail(f,"failed Native START did not retire exact C source and stage fresh reader");return;
+    }
+    puts("PASS actual Native UNKNOWN teardown -> C pending -> exact writer joined -> FULL terminal; next paused writer and proper START state admitted");
+  }else if(!atomic_load(&wire->completed) || !start_active
+      || start_active->result.phase!=OUTPUT_START_COMPLETED || !f->device->selected
+      || !f->device->session || f->device->volume!=35 || f->volumes!=(getenv("PC_NATIVE_START_EXPECT_TWO")?2:1)){
+    recovery_wire_fail(f,"actual Native did not finish after real C COMPLETED/route35");return;
+  }
+  if(f->mode==29 && getenv("PC_EXPECT_PAUSED_CLOCK")
+      && (!pb_session.start_clock_pending || pb_session.start_ts.tv_sec || !outputs_start_source_owned()
+          || outputs_start_gate_closed() || atomic_load(&wire->audio_packets))){
+    recovery_wire_fail(f,"paused completed START consumed first-PCM clock");return;
+  }
+  if(f->mode==29 && getenv("PC_REQUIRE_RTP_AUDIO")
+      && (atomic_load(&wire->audio_packets)<1 || !wire->decoded_audio_packet || !wire->nonzero_pcm_input)){
+    recovery_wire_fail(f,"no authenticated RTP from nonzero PCM reached private peer");return;
+  }
+  if(f->mode==29 && getenv("PC_REQUIRE_RTP_AUDIO"))
+    fprintf(stderr,"PASS private AP2 authenticated ALAC RTP packets=%d from nonzero PCM after completed/volume/open gate\n",
+      atomic_load(&wire->audio_packets));
+  fprintf(stderr,"PASS actual Native HTTP→C player owner→FIFO barrier→private AP2→FULL COMPLETED; Native final verdict asserted by driver\n");
+  event_base_loopbreak(f->base);
+}
+static void native_start_wire_run(struct recovery_wire_fixture *f,const char *fifo)
+{
+  struct native_start_wire wire={.fixture=f};struct sockaddr_in address={0};
+  struct timeval soon={0,1000},bound={25,0};socklen_t length=sizeof(address);pthread_t thread;
+  const char *ready_path=getenv("PC_NATIVE_START_READY_FILE");assert(ready_path);
+  wire.http_base=event_base_new();assert(wire.http_base);
+  wire.http=evhttp_new(wire.http_base);assert(wire.http);
+  evhttp_set_gencb(wire.http,native_start_http,&wire);
+  struct evhttp_bound_socket *socket=evhttp_bind_socket_with_handle(wire.http,"127.0.0.1",0);
+  assert(socket && !getsockname(evhttp_bound_socket_get_fd(socket),(struct sockaddr *)&address,&length));
+  cmdbase=commands_base_new(f->base,NULL);assert(cmdbase);
+  assert(!pthread_create(&thread,NULL,native_start_http_thread,&wire));
+  FILE *ready=fopen(ready_path,"w");assert(ready);
+  fprintf(ready,"{\"url\":\"http://127.0.0.1:%u\",\"pipe\":\"%s\",\"homepod_id\":\"1\"}\n",ntohs(address.sin_port),fifo);
+  assert(!fclose(ready));
+  f->poll=evtimer_new(f->base,native_start_done_poll,&wire);
+  f->deadline=evtimer_new(f->base,recovery_wire_deadline,f);
+  assert(f->poll && f->deadline && !evtimer_add(f->poll,&soon) && !evtimer_add(f->deadline,&bound));
+  event_base_dispatch(f->base);
+  event_base_loopbreak(wire.http_base);assert(!pthread_join(thread,NULL));
+  evhttp_free(wire.http);event_base_free(wire.http_base);
+  commands_base_free(cmdbase);cmdbase=NULL;
+}
