+  while((length=recv(f->udp_fd,packet,sizeof(packet),MSG_DONTWAIT))>0){
+    if(!native_start_audio_rtp(packet,length))continue;
+    if(!atomic_load(&wire->completed) || f->volumes<1 || outputs_start_gate_closed() || !start_active
+        || start_active->result.phase!=OUTPUT_START_COMPLETED){
+      recovery_wire_fail(f,"audio RTP crossed closed START gate");return;
+    }
+    struct airplay_session *session=f->device ? f->device->session : NULL;
+    struct airplay_master_session *master=session ? session->master_session : NULL;
+    uint16_t seq;uint32_t timestamp;size_t payload_len;
+    uint8_t nonce[12]={0},decoded[4096];gcry_cipher_hd_t cipher;
+    struct rtp_packet *source;
+    if(!session || !session->supports_encryption || !master || !master->rtp_session || length<36){
+      recovery_wire_fail(f,"audio RTP lacks negotiated encrypted session");return;
+    }
+    memcpy(&seq,packet+2,sizeof(seq));seq=ntohs(seq);
+    memcpy(&timestamp,packet+4,sizeof(timestamp));timestamp=ntohl(timestamp);
+    if(wire->decoded_audio_packet && (uint16_t)(seq-wire->last_audio_seq)!=1){
+      recovery_wire_fail(f,"audio RTP sequence did not advance by one");return;
+    }
+    if(wire->decoded_audio_packet && timestamp<=wire->last_audio_timestamp){
+      recovery_wire_fail(f,"audio RTP timestamp did not advance");return;
+    }
+    payload_len=(size_t)length-12-16-8;
+    source=rtp_packet_get(master->rtp_session,seq);
+    if(!source || source->payload_len!=payload_len || source->header[0]!=packet[0]
+        || (source->header[1]&0x7f)!=(packet[1]&0x7f) || memcmp(source->header+2,packet+2,10)){
+      recovery_wire_fail(f,"audio RTP has no matching encoded packet");return;
+    }
+    memcpy(nonce+4,packet+length-8,8);
+    cipher=chacha_open(session->shared_secret,AIRPLAY_AUDIO_KEY_LEN);
+    if(!cipher || gcry_cipher_setiv(cipher,nonce,sizeof(nonce))
+        || gcry_cipher_authenticate(cipher,packet+4,8)
+        || gcry_cipher_decrypt(cipher,decoded,payload_len,packet+12,payload_len)
+        || gcry_cipher_checktag(cipher,packet+length-8-16,16)
+        || memcmp(decoded,source->payload,payload_len)){
+      chacha_close(cipher);recovery_wire_fail(f,"audio RTP authentication/decode failed");return;
+    }
+    chacha_close(cipher);
+    for(size_t i=0;i<master->rawbuf_size;i++)
+      if(master->rawbuf[i]){wire->nonzero_pcm_input=true;break;}
+    wire->decoded_audio_packet=true;wire->last_audio_seq=seq;wire->last_audio_timestamp=timestamp;
+    atomic_fetch_add(&wire->audio_packets,1);
+  }
+  if(length<0 && errno!=EAGAIN && errno!=EWOULDBLOCK)
+    recovery_wire_fail(f,"private RTP receive failed");
+}
+static void native_start_http(struct evhttp_request *request,void *arg)
+{
+  struct native_start_wire *wire=arg;
+  const char *uri=evhttp_request_get_uri(request);
+  struct evbuffer *response=evbuffer_new();
+  assert(response);
+  /* Done seals test admission before the player event loop is stopped. A late
+   * Native cancellation must not synchronously wait on that stopped owner. */
+  if(atomic_load(&wire->done)){
+    evhttp_send_reply(request,409,"Fixture completed",response);
+    evbuffer_free(response);return;
+  }
+  if(!strcmp(uri,"/fixture/rtp") && wire->fixture->mode==29 && getenv("PC_REQUIRE_RTP_AUDIO")){
+    evbuffer_add_printf(response,"{\"audio_packets\":%d}",atomic_load(&wire->audio_packets));
+    evhttp_send_reply(request,200,"OK",response);
+  }else if(!strcmp(uri,"/fixture/done")){
+    evbuffer_add_printf(response,"{}");
+    evhttp_send_reply(request,200,"OK",response);
+    atomic_store(&wire->done,true);
+  }else{
+    char *path=strdup(uri),*rest=path,*part;
+    struct httpd_request actual={.in_body=evhttp_request_get_input_buffer(request),.out_body=response};
+    unsigned count=0;int status=404;
+    assert(path);
+    while((part=strsep(&rest,"/")) && count<ARRAY_SIZE(actual.path_parts)-1)
+      if(*part)actual.path_parts[count++]=part;
+    bool retirement=count>=6 && !strcmp(actual.path_parts[4],"retire");
+    bool result=retirement ? count==7 && !strcmp(actual.path_parts[5],"result")
+      : count==6 && !strcmp(actual.path_parts[4],"result");
+    if((count==5 || result || (retirement && count==6)) && !strcmp(actual.path_parts[0],"api")
+        && !strcmp(actual.path_parts[1],"outputs") && !strcmp(actual.path_parts[2],"1")
+        && !strcmp(actual.path_parts[3],"start")
+        && evhttp_request_get_command(request)==(result?EVHTTP_REQ_GET:EVHTTP_REQ_POST)){
+      const char *pattern=retirement ? (result?"/retire/result/":"/retire/(prepare|")
+        : (result?"/start/result/":"/start/(state|");
+      for(struct httpd_uri_map *route=httpd_jsonapi.handlers;route->regexp;route++){
+        if(strstr(route->regexp,pattern)){
+          status=route->handler(&actual);break;
+        }
+      }
+    }
+    if(count==5 && !strcmp(actual.path_parts[0],"api") && !strcmp(actual.path_parts[1],"outputs")
+        && !strcmp(actual.path_parts[2],"1") && !strcmp(actual.path_parts[3],"transport")
+        && evhttp_request_get_command(request)==EVHTTP_REQ_POST){
+      const char *pattern=!strcmp(actual.path_parts[4],"bound-state") ? "/transport/bound-state$"
+        : !strcmp(actual.path_parts[4],"bound-pause-confirm") ? "/transport/bound-pause-confirm$"
+        : (!strcmp(actual.path_parts[4],"bound-prepare") || !strcmp(actual.path_parts[4],"bound-commit"))
+          ? "/transport/bound-(prepare|commit)$" : NULL;
+      for(struct httpd_uri_map *route=httpd_jsonapi.handlers;pattern && route->regexp;route++){
+        if(strstr(route->regexp,pattern)){status=route->handler(&actual);break;}
+      }
+    }
+    if(status==200 && count==5 && !strcmp(actual.path_parts[4],"complete"))
+      atomic_store(&wire->completed,true);
+    if(status==200 && retirement && count==6 && !strcmp(actual.path_parts[5],"complete"))
+      atomic_store(&wire->retired,true);
+    fprintf(stderr,"ACTUAL Native→C %s status=%d body=%.*s\n",uri,status,
+      (int)evbuffer_get_length(response),(char *)evbuffer_pullup(response,-1));
+    evhttp_send_reply(request,status,status==200?"OK":"Rejected",response);
+    free(path);
+  }
+  evbuffer_free(response);
+}
+static void *native_start_http_thread(void *arg)
+{
+  struct native_start_wire *wire=arg;
+  event_base_dispatch(wire->http_base);
+  return NULL;
+}
+static void native_start_done_poll(int fd,short events,void *arg)
+{
+  struct native_start_wire *wire=arg;struct recovery_wire_fixture *f=wire->fixture;
+  struct timeval soon={0,1000};(void)fd;(void)events;
+  if(f->mode==29 && getenv("PC_REQUIRE_RTP_AUDIO")){
+    native_start_audio_poll(wire);
