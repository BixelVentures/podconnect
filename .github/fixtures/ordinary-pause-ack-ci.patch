+    if(mode==2)start_startup_quarantine=false;
+    assert(outputs_transport_pause_confirm(device->id,request.token,request.native_prepare_id,request.native_revision)<0);
+    assert(!transport_pause_retained && !transport_pause_owned(device->id));
+  }
+  puts("PASS ordinary exact effect ACK without START retention; duplicate, successor custody, changed route, expired and unknown START confirmations cannot revive");
