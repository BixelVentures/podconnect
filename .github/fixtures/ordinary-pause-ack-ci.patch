+/* Ordinary Connect has a real current route/reader but no START retention. */
+static void ordinary_pause_confirmation_case(struct output_device *device,
+    const struct output_native_owner *owner)
+{
+  struct output_transport_identity route;bool busy,start_owned,clean_absent;
+  struct output_transport_request request={.device_id=device->id,.bound=true,.percent=-1,.native_revision=41};
+  struct output_transport_result prepared,result;
+  assert(outputs_transport_bound_state_get(device->id,owner,&route,&busy,&start_owned,&clean_absent)==0
+    && !busy && !start_owned && clean_absent);
+  strcpy(request.action,"pause");memset(request.native_prepare_id,'7',32);
+  memset(request.args_digest,'8',64);request.native_owner=*owner;
+  strcpy(request.expected_input_path_digest,route.input_path_digest);
+  assert(outputs_transport_prepare(&request,&prepared)==0);strcpy(request.token,prepared.command.token);
+  assert(outputs_transport_commit(&request,&result)==0 && result.outcome==0);
+  assert(outputs_transport_pause_confirm(device->id,request.token,request.native_prepare_id,41)==0);
+  assert(!transport_pause_retained && !transport_pause_owned(device->id));
+  assert(outputs_transport_pause_confirm(device->id,request.token,request.native_prepare_id,41)<0);
+  assert(!transport_pause_retained);
+  /* A later accepted command owns custody; the old completion cannot retain it. */
+  request.native_revision=42;request.native_prepare_id[0]='8';request.token[0]=0;
+  assert(outputs_transport_prepare(&request,&prepared)==0);request=prepared.command;
+  assert(outputs_transport_commit(&request,&result)==0);
+  struct output_transport_request successor=request;
+  successor.native_revision=43;successor.native_prepare_id[0]='9';successor.token[0]=0;
+  strcpy(successor.action,"resume");
+  assert(outputs_transport_prepare(&successor,&prepared)==0);successor=prepared.command;
+  assert(outputs_transport_commit(&successor,&result)==0);
+  assert(outputs_transport_pause_confirm(device->id,request.token,request.native_prepare_id,42)<0);
+  assert(transport_custody_current(owner,&route,43) && !transport_pause_retained);
+  /* No delayed completion can cross route replacement, expiry or unknown START. */
