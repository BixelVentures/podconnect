+func TestAutoplayPreviewStagesOnlyOnceAndLeavesPlaybackUntouched(t *testing.T) {
+	p := nextFixture(t)
+	p.sess = &session.Session{}
+	calls := 0
+	entered := make(chan struct{})
+	release := make(chan struct{})
+	nextSessionField(p.sess, "sp", nextSpclient(t, &calls, nextTrack, func() {
+		close(entered)
+		<-release
+	}))
+	before := proto.Clone(p.state.player)
+	ctx := context.Background()
+	snapshot, err := p.state.tracks.ObserveUpcoming(ctx)
+	if err != nil || len(snapshot.Items) != 0 {
+		t.Fatal("expected a complete empty queue", err)
+	}
+	offer := &nativeQueueOffer{Tracks: p.state.tracks}
+	p.warmAutoplayPreview(ctx, offer)
+	<-entered
+	if p.autoplayPreview == nil || !proto.Equal(before, p.state.player) ||
+		p.state.tracks.TransportRevision() != snapshot.Revision || p.primaryStream != nil {
+		t.Fatal("preview changed current playback while resolving")
+	}
+	preview := p.autoplayPreview
+	close(release)
+	station := <-preview.pending
+	if calls != 1 || station == nil || station.context.GetUri() != nextStation ||
+		len(station.occurrences.Items) != 1 || station.occurrences.Items[0].URI != nextTrack {
+		t.Fatal("did not prepare exact provider station")
+	}
+	if !proto.Equal(before, p.state.player) || p.state.tracks != offer.Tracks {
+		t.Fatal("resolved preview published playback")
+	}
+}
