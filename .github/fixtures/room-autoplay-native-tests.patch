+func TestDetachedStationProjectionTruncatesWithoutDeduplicating(t *testing.T) {
+	ctx := context.Background()
+	id, err := librespot.SpotifyIdFromUri(nextTrack)
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, count := range []int{tracks.MaxQueueOccurrences, tracks.MaxQueueOccurrences + 1} {
+		rows := make([]*connectpb.ContextTrack, count)
+		for i := range rows {
+			rows[i] = &connectpb.ContextTrack{Gid: id.Id(), Uid: "duplicate-provider-uid"}
+		}
+		list, err := tracks.NewTrackListFromContext(ctx, &librespot.NullLogger{}, nil, &connectpb.Context{
+			Uri: nextStation, Pages: []*connectpb.ContextPage{{Tracks: rows}},
+		})
+		if err != nil || !list.GoStart(ctx) {
+			t.Fatal("station fixture", err)
+		}
+		ordinary, err := list.ObserveUpcoming(ctx)
+		if err != nil {
+			t.Fatal(err)
+		}
+		prospective, err := list.ObserveStation(ctx)
+		if err != nil || len(prospective.Items) != tracks.MaxQueueOccurrences ||
+			prospective.Truncated != (count > tracks.MaxQueueOccurrences) ||
+			len(ordinary.Items) != count-1 || ordinary.Truncated {
+			t.Fatalf("wrong occurrence limits at %d: %v", count, err)
+		}
+		for i, row := range prospective.Items {
+			if row.Position != i || row.URI != nextTrack || row.UID != "duplicate-provider-uid" || row.Queued {
+				t.Fatalf("lost original occurrence at %d: %+v", i, row)
+			}
+		}
+	}
+}
