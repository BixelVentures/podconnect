+// Runs only in the existing actual Linux FIFO and private receiver fixture.
+func testAutoplayPreviewActualC(t *testing.T, ctx context.Context, p *AppPlayer, worker *player.Player, server *ConcreteApiServer) {
+	t.Helper()
+	owner, err := p.radioSourceOwner()
+	if err != nil {
+		t.Fatal(err)
+	}
+	before := proto.Clone(p.state.player)
+	oldSource, err := worker.Start35CurrentSource(ctx)
+	if err != nil {
+		t.Fatal(err)
+	}
+	scope := url.Values{"account_user_id": {owner.AccountUserID}, "target_id": {owner.TargetID}, "room_id": {owner.RoomID}, "homepod_id": {owner.HomePodID}}
+	read := func(count int) queueStateResponse {
+		t.Helper()
+		response := httptest.NewRecorder()
+		server.handleRoomQueue(response, httptest.NewRequest(http.MethodGet, "/player/room_transport/bound-queue?"+scope.Encode(), nil).WithContext(ctx))
+		var observed queueStateResponse
+		var fields map[string]json.RawMessage
+		if response.Code != http.StatusOK || json.Unmarshal(response.Body.Bytes(), &observed) != nil ||
+			json.Unmarshal(response.Body.Bytes(), &fields) != nil || (count == 0 && len(fields) != 11) ||
+			observed.Schema != "podconnect.native_room_queue_state.v1" ||
+			observed.Owner != owner || len(observed.Items) != count {
+			t.Fatalf("bound empty queue read %d", response.Code)
+		}
+		return observed
+	}
+	initial := read(0)
+	if p.autoplayPreview != nil {
+		t.Fatal("ordinary HTTP read initiated autoplay work")
+	}
+	pendingMode := os.Getenv("PC_NATIVE_AUTOPLAY_PREVIEW") == "pending"
+	completionMode := os.Getenv("PC_NATIVE_AUTOPLAY_PREVIEW") == "complete"
+	if pendingMode || completionMode {
+		holdPreviewResolver = make(chan struct{})
+		previewResolverEntered = make(chan struct{})
+		defer func() {
+			select {
+			case <-holdPreviewResolver:
+			default:
+				close(holdPreviewResolver)
+			}
+		}()
+	}
+	warmCtx := ctx
+	if pendingMode {
+		var cancel context.CancelFunc
+		warmCtx, cancel = context.WithTimeout(ctx, 400*time.Millisecond)
+		defer cancel()
+	}
+	var pendingObserved chan bool
+	if completionMode {
+		pendingObserved = make(chan bool, 1)
+		go func() {
+			select {
+			case <-previewResolverEntered:
+			case <-ctx.Done():
+				pendingObserved <- false
+				return
+			}
+			// The resolver is held while the same actor answers this second
+			// request. This proves the initial HTTP wait did not block the actor.
+			value, err := server.roomTransportAsk(ctx, apiRoomAutoplayPreview, owner)
+			view, ok := value.(prospectiveQueueView)
+			pendingObserved <- err == nil && ok && len(view.Rows) == 0
+			close(holdPreviewResolver)
+		}()
+	}
+	warmRequest := httptest.NewRequest(http.MethodGet, "/player/room_transport/bound-queue?"+scope.Encode(), nil).WithContext(warmCtx)
+	warmRequest.Header.Set(queueAutoplayHeader, "1")
+	warmReply := httptest.NewRecorder()
+	server.handleRoomQueue(warmReply, warmRequest)
+	if warmReply.Code != http.StatusOK {
+		t.Fatal("opt-in read could not warm autoplay", warmReply.Code)
+	}
+	if completionMode {
+		if !<-pendingObserved {
+			t.Fatal("player actor did not answer while the resolver was held")
+		}
+		var envelope struct {
+			Autoplay queueAutoplayPreviewResponse `json:"autoplay"`
+		}
+		if json.Unmarshal(warmReply.Body.Bytes(), &envelope) != nil || envelope.Autoplay.Kind != "preview" ||
+			len(envelope.Autoplay.Items) != 3 || previewResolves.Load() != 1 {
+			t.Fatal("first HTTP read did not complete from the one in-flight resolver")
+		}
+		t.Log("PASS first opt-in HTTP GET waited off actor and returned ready after one resolver")
+	}
+	if pendingMode {
+		var envelope struct {
+			Autoplay map[string]json.RawMessage `json:"autoplay"`
+			Items    []nativeQueueItem          `json:"items"`
+		}
+		if json.Unmarshal(warmReply.Body.Bytes(), &envelope) != nil || len(envelope.Items) != 0 ||
+			len(envelope.Autoplay) != 1 || string(envelope.Autoplay["kind"]) != `"pending"` {
+			t.Fatal("held first HTTP read did not return exact pending sidecar")
+		}
+		read(0) // Ordinary clients still see only v1 during the held read.
+		close(holdPreviewResolver)
+	}
+	currentOffer := p.queueOccurrenceOffer
+	preview := p.autoplayPreview
+	if preview == nil {
+		t.Fatal("bound read did not warm a detached station")
+	}
+	readProspective := func() prospectiveQueueView {
+		t.Helper()
+		result, err := server.roomTransportAsk(ctx, apiRoomAutoplayPreview, owner)
+		if err != nil {
+			t.Fatal("internal prospective read", err)
+		}
+		return result.(prospectiveQueueView)
+	}
+	projected := readProspective()
+	for limit := time.Now().Add(time.Second); (len(projected.Rows) == 0 || projected.Rows[0].Metadata.Name == "") && time.Now().Before(limit); {
+		time.Sleep(5 * time.Millisecond)
+		projected = readProspective()
+	}
+	if len(projected.Rows) != 3 || projected.Truncated || projected.Rows[0].Metadata.Artist != "station fixture artist" {
+		t.Fatal("expected three complete provider occurrences")
+	}
+	for i, uid := range []string{"first", "second", "third"} {
+		item := projected.Rows[i]
+		if item.Position != i || item.UID != uid || item.URI != p.state.player.GetTrack().GetUri() || item.Queued {
+			t.Fatalf("wrong detached occurrence at position %d: %+v", i, item)
+		}
+	}
+	projected.Rows[1].UID = "caller-mutated"
+	if next := readProspective(); next.Rows[1].UID != "second" || next.Rows[1].Selection != projected.Rows[1].Selection || next.Rows[1].DisplayID != projected.Rows[1].DisplayID {
+		t.Fatal("caller mutated actor-owned projection")
+	}
+	stale := owner
+	stale.SessionID += "-superseded"
+	if _, err := server.roomTransportAsk(ctx, apiRoomAutoplayPreview, stale); !errors.Is(err, ErrAliasConflict) {
+		t.Fatal("stale scope could read detached occurrences", err)
+	}
+	if p.queueOccurrenceOffer != currentOffer {
+		t.Fatal("opt-in read renewed ordinary queue authority")
+	}
+	if latest := read(0); latest.Writer != initial.Writer || latest.Revision != initial.Revision {
+		t.Fatal("opt-in read changed writer or actual queue revision")
+	}
+
+	current, err := worker.Start35CurrentSource(ctx)
+	if err != nil || current != oldSource || !proto.Equal(before, p.state.player) ||
+		preview.station == nil || len(preview.station.occurrences.Items) != 3 || preview.station.occurrences.Items[1].UID != "second" ||
+		previewResolves.Load() != 1 {
+		t.Fatalf("preview mismatch source=%t state=%t same_offer=%t ready=%t calls=%d err=%v", current == oldSource, proto.Equal(before, p.state.player), p.autoplayPreview == preview, preview.station != nil, previewResolves.Load(), err)
+	}
+	if pendingMode {
+		var ready queueAutoplayPreviewResponse
+		readAutoplayHTTP(t, ctx, server, owner, &ready)
+		if ready.Kind != "preview" || len(ready.Items) != 3 || previewResolves.Load() != 1 {
+			t.Fatal("next explicit read did not publish exact ready rows")
+		}
+		t.Log("PASS first opt-in HTTP read reports pending without authority, next explicit read publishes ready from one resolve")
+	}
+	mode := os.Getenv("PC_NATIVE_AUTOPLAY_PREVIEW")
+	if mode == "choose" || mode == "manual-commit" || mode == "stale-commit" {
+		testAutoplayChoiceActualC(t, ctx, p, worker, server, owner, projected.Rows, initial.Writer, mode)
+		return
+	}
+	if mode == "manual" {
+		if _, err := server.roomTransportAsk(ctx, ApiRequestTypeAddToQueue, p.state.player.GetTrack().GetUri()); err != nil {
+			t.Fatal("manual queue insert", err)
+		}
+		if _, err := server.roomTransportAsk(ctx, apiRoomAutoplayPreview, owner); !errors.Is(err, ErrAliasConflict) {
+			t.Fatal("manual insertion retained stale prospective projection", err)
+		}
+		ordinary := read(1)
+		if !ordinary.Items[0].Queued || previewResolves.Load() != 1 || ordinary.Writer != initial.Writer {
+			t.Fatal("manual queue did not supersede prospective without another resolve or writer change")
+		}
+		t.Log("PASS manual insertion withdrew prospective projection and ordinary v1 kept the exact queued item and writer")
+		return
+	}
+	// Invoke the same natural exhaustion path used by the worker EOS event.
+	// C still holds the exact live writer; the fixture does not wait for a
+	// full-length test recording to end.
+	advanced, err := p.advanceNext(ctx, false, false)
+	if err != nil || !advanced || previewResolves.Load() != 1 || p.autoplayPreview != nil ||
+		p.state.tracks != preview.station.tracks || p.state.player.ContextUri != nextStation ||
+		p.state.player.Track.Uid != "first" {
+		t.Fatal("natural EOS did not reuse the exact detached station", err)
+	}
+	if _, err := server.roomTransportAsk(ctx, apiRoomAutoplayPreview, owner); !errors.Is(err, ErrAliasConflict) {
+		t.Fatal("prior scope remained readable after EOS adoption", err)
+	}
+	promotedOwner, err := p.radioSourceOwner()
+	if err != nil || promotedOwner.SessionID == owner.SessionID {
+		t.Fatal("expected natural EOS to publish new playback session", err)
+	}
+	proveAutoplayPromotion(t, ctx, p, server, promotedOwner, projected.Rows[1:])
+	t.Log("PASS natural EOS reused one resolve and reconciled both exact display survivors across the new session")
+}
