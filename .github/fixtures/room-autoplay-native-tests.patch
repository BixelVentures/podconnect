+// Crosses actual C through the existing prepared bound queue transaction.
+func testAutoplayChoiceActualC(t *testing.T, ctx context.Context, p *AppPlayer, worker *player.Player, server *ConcreteApiServer, owner roomTransportIdentity, projected []prospectiveQueueRow, writer queueWriterWire, mode string) {
+	t.Helper()
+	endpoint := p.app.cfg.RoomTransportOwnToneURL + "/api/outputs/" + owner.HomePodID
+	post := func(path string, value any, out any) {
+		t.Helper()
+		body, _ := json.Marshal(value)
+		req, err := http.NewRequestWithContext(ctx, http.MethodPost, endpoint+path, bytes.NewReader(body))
+		if err != nil {
+			t.Fatal(err)
+		}
+		req.Header.Set("Content-Type", "application/json")
+		reply, err := http.DefaultClient.Do(req)
+		if err != nil {
+			t.Fatal(err)
+		}
+		defer reply.Body.Close()
+		if reply.StatusCode != http.StatusOK || json.NewDecoder(reply.Body).Decode(out) != nil {
+			t.Fatalf("actual C %s status=%d", path, reply.StatusCode)
+		}
+	}
+	readRoute := func() roomVolumeRoute {
+		t.Helper()
+		var state directPauseOutputState
+		post("/transport/bound-state", map[string]any{"native_owner": owner}, &state)
+		if !state.OK {
+			t.Fatal("actual C owner no longer bound")
+		}
+		return state.Identity
+	}
+	route := readRoute()
+	oldVolume, oldPrimary, preview := p.state.device.Volume, p.primaryStream, p.autoplayPreview
+	first := queueAutoplayPreviewResponse{}
+	firstQueue := readAutoplayHTTP(t, ctx, server, owner, &first)
+	renewed := queueAutoplayPreviewResponse{}
+	renewedQueue := readAutoplayHTTP(t, ctx, server, owner, &renewed)
+	if first.Kind != "preview" || renewed.Kind != "preview" || len(renewed.Items) != 3 || len(first.Items) != 3 ||
+		first.ObservationID == renewed.ObservationID || firstQueue.ObservationID == renewedQueue.ObservationID ||
+		first.Revision != renewed.Revision || first.Items[1] != renewed.Items[1] ||
+		renewed.DisplayIDs[renewed.Items[1].ID] != projected[1].DisplayID || renewed.Items[1].ID != projected[1].Selection.OccurrenceID ||
+		len(renewedQueue.Items) != 0 || renewed.Truncated || renewed.Expires <= 0 ||
+		renewed.Metadata[renewed.Items[1].URI] != projected[1].Metadata {
+		t.Fatal("HTTP preview renewal changed the exact occurrence or display identity")
+	}
+	selection := queueSelection{renewed.ObservationID, owner.SessionID, renewed.Revision, renewed.Items[1].ID}
+	prepareHTTP := func(selection queueSelection, header string) *httptest.ResponseRecorder {
+		t.Helper()
+		request := roomTransportPrepareRequest{AccountUserID: owner.AccountUserID, TargetID: owner.TargetID,
+			RoomID: owner.RoomID, HomePodID: owner.HomePodID, Action: "queue", Queue: &selection}
+		body, _ := json.Marshal(request)
+		httpRequest := httptest.NewRequest(http.MethodPost, "/player/room_transport/bound-prepare", bytes.NewReader(body)).WithContext(ctx)
+		if header != "" {
+			httpRequest.Header.Set(queueAutoplayHeader, header)
+		}
+		recorder := httptest.NewRecorder()
+		server.handleRoomTransportPrepare(recorder, httpRequest)
+		return recorder
+	}
+	stale := selection
+	stale.SessionID += "-superseded"
+	if response := prepareHTTP(stale, "1"); response.Code != http.StatusConflict {
+		t.Fatal("wrong owner obtained prospective prepare", response.Code)
+	}
+	stale = selection
+	stale.ObservationID = first.ObservationID
+	if response := prepareHTTP(stale, "1"); response.Code != http.StatusConflict {
+		t.Fatal("previous preview observation remained actionable", response.Code)
+	}
+	if response := prepareHTTP(selection, ""); response.Code != http.StatusConflict {
+		t.Fatal("legacy prepare admitted prospective ID", response.Code)
+	}
+	if response := prepareHTTP(selection, "0"); response.Code != http.StatusBadRequest {
+		t.Fatal("bad version reached prospective prepare", response.Code)
+	}
+	response := prepareHTTP(selection, "1")
+	var prepared queuePrepareResponse
+	if response.Code != http.StatusOK || json.Unmarshal(response.Body.Bytes(), &prepared) != nil {
+		t.Fatal("exact projected occurrence HTTP prepare", response.Code)
+	}
+	if p.primaryStream != oldPrimary || preview.station.tracks.CurrentTrack().Uid != "first" ||
+		prepared.Queue != selection || prepared.Writer != writer {
+		t.Fatal("prepare advanced the natural station or live writer")
+	}
+	if response := prepareHTTP(selection, "1"); response.Code != http.StatusConflict {
+		t.Fatal("prospective prepare replay was accepted", response.Code)
+	}
+	prepareC := func(id, digest, action, revision string, selection *queueSelection) string {
+		t.Helper()
+		body := map[string]any{"native_prepare_id": id, "args_digest": digest,
+			"action": action, "native_revision": revision, "native_owner": owner}
+		if selection != nil {
+			body["queue"], body["writer_proof"] = *selection, writer
+		}
+		var result directPauseOutputPrepare
+		post("/transport/bound-prepare", body, &result)
+		if result.Token == "" || result.Identity != route {
+			t.Fatal("actual C lost exact route at prepare")
+		}
+		return result.Token
+	}
+	commit := func(id, token string) int {
+		t.Helper()
+		raw, _ := json.Marshal(roomTransportCommitRequest{id, token})
+		response := httptest.NewRecorder()
+		server.handleRoomTransportCommit(response, httptest.NewRequest(http.MethodPost,
+			"/player/room_transport/bound-commit", bytes.NewReader(raw)).WithContext(ctx))
+		return response.Code
+	}
+	token := prepareC(prepared.PrepareID, prepared.Digest, "queue", prepared.Revision, &selection)
+	if mode == "stale-commit" {
+		p.aliasMu.Lock()
+		p.advanceAliasRevisionLocked()
+		p.aliasMu.Unlock()
+		if commit(prepared.PrepareID, token) == http.StatusOK || p.primaryStream != oldPrimary || preview.station.tracks.CurrentTrack().Uid != "first" {
+			t.Fatal("changed alias owner reached stale commit")
+		}
+		t.Log("PASS changed alias owner fenced already C-prepared prospective queue before C commit")
+		return
+	}
+	if mode == "manual-commit" {
+		if _, err := server.roomTransportAsk(ctx, ApiRequestTypeAddToQueue, p.state.player.GetTrack().GetUri()); err != nil {
+			t.Fatal("manual insertion before commit", err)
+		}
+		if commit(prepared.PrepareID, token) == http.StatusOK || p.primaryStream != oldPrimary ||
+			preview.station.tracks.CurrentTrack().Uid != "first" || readRoute() != route {
+			t.Fatal("stale prospective commit after manual insertion changed live owner")
+		}
+		t.Log("PASS actual manual insertion fenced already C-prepared prospective queue before C commit")
+		return
+	}
+	if code := commit(prepared.PrepareID, token); code != http.StatusOK {
+		t.Fatal("prospective commit", code)
+	}
+	if commit(prepared.PrepareID, token) == http.StatusOK || p.state.player.SessionId != owner.SessionID ||
+		p.state.player.ContextUri != nextStation || p.state.player.Track.Uid != "second" ||
+		p.state.device.Volume != oldVolume || readRoute() != route || preview.station.tracks.CurrentTrack().Uid != "first" {
+		t.Fatal("selection lost exact UID/route/session/volume or advanced the detached natural list")
+	}
+	source, err := worker.Start35CurrentSource(ctx)
+	exactWriter, writerErr := p.app.completedWriterCurrent(p, owner)
+	if err != nil || writerErr != nil || source != p.primaryStream.Source || p.primaryStream == oldPrimary ||
+		exactWriter == nil || exactWriter.writer.FD != writer.FD || exactWriter.writer.PipeIdentity != writer.Pipe ||
+		exactWriter.epoch != writer.Epoch {
+		t.Fatal("selection did not install a new decoder on the exact prior writer", err, writerErr)
+	}
+	proveAutoplayPromotion(t, ctx, p, server, owner, projected[2:])
+	if _, err := server.roomTransportAsk(ctx, ApiRequestTypePause, nil); err != nil || !p.state.player.IsPaused || readRoute() != route {
+		t.Fatal("subsequent bound Pause", err)
+	}
+	value, err := server.roomTransportAsk(ctx, apiRoomBoundPrepare, roomTransportPrepareRequest{
+		AccountUserID: owner.AccountUserID, TargetID: owner.TargetID, RoomID: owner.RoomID, HomePodID: owner.HomePodID, Action: "next"})
+	if err != nil {
+		t.Fatal("subsequent bound Next prepare", err)
+	}
+	next := value.(roomTransportSnapshot)
+	nextToken := prepareC(next.PrepareID, next.ArgsDigest, "next", next.NativeRevision, nil)
+	if commit(next.PrepareID, nextToken) != http.StatusOK || p.state.player.Track.Uid != "third" ||
+		p.state.player.SessionId != owner.SessionID || p.state.player.ContextUri != nextStation ||
+		readRoute() != route || previewResolves.Load() != 1 {
+		t.Fatal("subsequent bound Next lost provider occurrence or owner")
+	}
+	t.Log("PASS one projected duplicate committed in place, replay rejected, then bound Pause/Next selected the third occurrence")
+}
+
+func proveAutoplayPromotion(t *testing.T, ctx context.Context, p *AppPlayer, server *ConcreteApiServer, owner roomTransportIdentity, expected []prospectiveQueueRow) {
+	t.Helper()
+	scope := url.Values{"account_user_id": {owner.AccountUserID}, "target_id": {owner.TargetID}, "room_id": {owner.RoomID}, "homepod_id": {owner.HomePodID}}
+	read := func() queueStateResponse {
+		t.Helper()
+		response := httptest.NewRecorder()
+		server.handleRoomQueue(response, httptest.NewRequest(http.MethodGet, "/player/room_transport/bound-queue?"+scope.Encode(), nil).WithContext(ctx))
+		var observed queueStateResponse
+		if response.Code != http.StatusOK || json.Unmarshal(response.Body.Bytes(), &observed) != nil ||
+			observed.Schema != "podconnect.native_room_queue_state.v1" || observed.Owner != owner || len(observed.Items) != len(expected) {
+			t.Fatalf("ordinary queue missing promoted provider suffix: %d", response.Code)
+		}
+		for _, row := range expected {
+			if strings.Contains(response.Body.String(), row.DisplayID) || strings.Contains(response.Body.String(), row.Selection.OccurrenceID) {
+				t.Fatal("display or prospective authority leaked into ordinary v1")
+			}
+		}
+		return observed
+	}
+	readMap := func(ordinary queueStateResponse) []autoplayPromotedRow {
+		t.Helper()
+		currentOffer := p.queueOccurrenceOffer
+		value, err := server.roomTransportAsk(ctx, apiRoomAutoplayPromoted, autoplayPromotionRead{owner, ordinary.ObservationID})
+		if err != nil || p.queueOccurrenceOffer != currentOffer {
+			t.Fatal("exact display reconciliation failed or renewed action authority", err)
+		}
+		mapping := value.([]autoplayPromotedRow)
+		if len(mapping) != len(expected) {
+			t.Fatal("wrong number of reconciled rows")
+		}
+		for i, row := range mapping {
+			if row.QueueID != ordinary.Items[i].ID || row.DisplayID != expected[i].DisplayID ||
+				row.Metadata != expected[i].Metadata || row.Metadata.Artist != "station fixture artist" {
+				t.Fatalf("wrong reconciled row at %d: %+v", i, row)
+			}
+		}
+		return mapping
+	}
+	ordinary := read()
+	uri := expected[0].URI
+	for limit := time.Now().Add(time.Second); ordinary.Metadata[uri].Name == "" && time.Now().Before(limit); {
+		time.Sleep(5 * time.Millisecond)
+		ordinary = read()
+	}
+	if ordinary.Metadata[uri] != expected[0].Metadata {
+		t.Fatal("ordinary v1 metadata did not match the provider label from the preview")
+	}
+	rows := readMap(ordinary)
+	rows[0].DisplayID = "caller-mutated"
+	renewed := read()
+	readMap(renewed)
+	if _, err := server.roomTransportAsk(ctx, apiRoomAutoplayPromoted, autoplayPromotionRead{owner, ordinary.ObservationID}); !errors.Is(err, ErrAliasConflict) {
+		t.Fatal("stale ordinary observation could reconcile", err)
+	}
+	for _, id := range []string{expected[0].DisplayID, expected[0].Selection.OccurrenceID} {
+		ordinary = read()
+		selection := queueSelection{ordinary.ObservationID, owner.SessionID, ordinary.Revision, id}
+		body, _ := json.Marshal(roomTransportPrepareRequest{AccountUserID: owner.AccountUserID, TargetID: owner.TargetID,
+			RoomID: owner.RoomID, HomePodID: owner.HomePodID, Action: "queue", Queue: &selection})
+		reply := httptest.NewRecorder()
+		server.handleRoomTransportPrepare(reply, httptest.NewRequest(http.MethodPost, "/player/room_transport/bound-prepare", bytes.NewReader(body)).WithContext(ctx))
+		if reply.Code == http.StatusOK {
+			t.Fatal("non-v1 ID gained ordinary action authority")
+		}
+	}
+	promotion := queueAutoplayPromotionResponse{}
+	promoted := readAutoplayHTTP(t, ctx, server, owner, &promotion)
+	if promotion.Kind != "promotion" || len(promotion.DisplayIDs) != len(expected) {
+		t.Fatal("HTTP promotion omitted exact display mappings")
+	}
+	for i, item := range promoted.Items {
+		if promotion.DisplayIDs[item.ID] != expected[i].DisplayID || promotion.Metadata[item.URI] != expected[i].Metadata {
+			t.Fatal("HTTP promotion changed survivor display identity or metadata")
+		}
+	}
+	t.Log("PASS opt-in HTTP promotion joined exact provider UID/position and label to fresh v1 IDs, retaining separate display IDs")
+}
+
+func TestAutoplayPromotionCannotMatchDuplicateURIAtWrongUID(t *testing.T) {
+	const uid = "provider-occurrence"
+	expected := []autoplayDisplayRow{{Occurrence: tracks.QueueOccurrence{URI: nextTrack, UID: uid}, ID: "display-one"}}
+	ordinary := &nativeQueueOffer{
+		Snapshot:    nativeQueueSnapshot{Items: []nativeQueueItem{{URI: nextTrack, ID: "ordinary-action"}}},
+		Occurrences: []tracks.QueueOccurrence{{URI: nextTrack, UID: "same-uri-different-occurrence"}},
+	}
+	if rows, err := reconcileAutoplayRows(expected, ordinary); !errors.Is(err, ErrAliasConflict) || rows != nil {
+		t.Fatal("another occurrence borrowed the label or display identity", err)
+	}
+}
+
+func readAutoplayHTTP(t *testing.T, ctx context.Context, server *ConcreteApiServer, owner roomTransportIdentity, extension any) queueStateResponse {
+	t.Helper()
+	scope := url.Values{"account_user_id": {owner.AccountUserID}, "target_id": {owner.TargetID}, "room_id": {owner.RoomID}, "homepod_id": {owner.HomePodID}}
+	request := httptest.NewRequest(http.MethodGet, "/player/room_transport/bound-queue?"+scope.Encode(), nil).WithContext(ctx)
+	request.Header.Set(queueAutoplayHeader, "1")
+	recorder := httptest.NewRecorder()
+	server.handleRoomQueue(recorder, request)
+	var ordinary queueStateResponse
+	var envelope struct {
+		Autoplay json.RawMessage `json:"autoplay"`
+	}
+	if recorder.Code != http.StatusOK || json.Unmarshal(recorder.Body.Bytes(), &ordinary) != nil ||
+		json.Unmarshal(recorder.Body.Bytes(), &envelope) != nil || json.Unmarshal(envelope.Autoplay, extension) != nil ||
+		ordinary.Schema != "podconnect.native_room_queue_state.v1" || ordinary.Owner != owner {
+		t.Fatal("opt-in HTTP queue omitted exact ordinary/extended response", recorder.Code)
+	}
+	return ordinary
+}
