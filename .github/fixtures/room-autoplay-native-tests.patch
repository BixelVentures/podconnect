+func TestAutoplayPreviewRejectsChangedStateBeforeWriterInspection(t *testing.T) {
+	for _, mode := range []string{"manual", "owner", "context", "options", "expired"} {
+		t.Run(mode, func(t *testing.T) {
+			p := nextFixture(t)
+			offer := &nativeQueueOffer{
+				State: p.state, PlayerState: p.state.player, Tracks: p.state.tracks, Generation: p.roomTransportGeneration,
+			}
+			offer.Snapshot.QueueRevision = p.state.tracks.TransportRevision()
+			_, cancel := context.WithCancel(context.Background())
+			defer cancel()
+			preview := &autoplayPreview{
+				owner: offer, options: proto.Clone(p.state.player.Options).(*connectpb.ContextPlayerOptions),
+				uri: pContext, played: oldTrack, until: time.Now().Add(autoplayPreviewLifetime),
+				cancel: cancel, station: &autoplayStation{},
+			}
+			p.autoplayPreview = preview
+			switch mode {
+			case "manual":
+				p.state.tracks.AddToQueue(&connectpb.ContextTrack{Uri: nextTrack})
+			case "owner":
+				p.roomTransportGeneration++
+			case "context":
+				p.state.player.ContextUri = "spotify:playlist:0000000000000000000006"
+			case "options":
+				p.state.player.Options.ShufflingContext = true
+			case "expired":
+				preview.until = time.Time{}
+			}
+			if p.takeAutoplayPreview(context.Background()) != nil || p.autoplayPreview != nil {
+				t.Fatal("stale preview survived an ownership change")
+			}
+		})
+	}
+}
