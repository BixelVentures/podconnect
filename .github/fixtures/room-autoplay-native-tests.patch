+func TestAutoplayPreviewHistoryIsBoundedAndOrdered(t *testing.T) {
+	ctx := context.Background()
+	log := &librespot.NullLogger{}
+	rows := []*connectpb.ContextTrack{{Uri: oldTrack}, {Uri: nextTrack}}
+	list, err := tracks.NewTrackListFromContext(ctx, log, nil, &connectpb.Context{
+		Uri: pContext, Pages: []*connectpb.ContextPage{{Tracks: rows}},
+	})
+	if err != nil || !list.GoStart(ctx) || !list.GoNext(ctx) {
+		t.Fatal("resident fixture", err)
+	}
+	if got := list.ResidentAutoplayHistory(1); got != nil {
+		t.Fatal("preview changed the existing resolver seed by truncating")
+	}
+	if got := list.ResidentAutoplayHistory(2); len(got) != 2 || got[0] != oldTrack || got[1] != nextTrack {
+		t.Fatal("preview changed the existing resolver seed order", got)
+	}
+}
